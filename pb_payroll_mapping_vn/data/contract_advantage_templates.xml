<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      The four steady amounts that live ON the contract.

      They are shipped as data rather than created by the mapping applier so
      that they exist BEFORE the first contract does: `hr.contract.create` gives
      every new contract one line per template, so a template that arrives later
      leaves every existing contract without a line to fill in.

      `upper_bound` is a guard rail, not a policy — it is what stops a mistyped
      figure passing silently. `default_value` stays 0.0 on all four: a default
      here is applied to EVERYBODY, and a non-zero one is how a single leaver's
      payout once became a company-wide allowance.
    -->
    <record id="advantage_template_uniform" model="hr.contract.advantage.template">
        <field name="name">Uniform allowance</field>
        <field name="code">UNIFORM</field>
        <field name="lower_bound">0.0</field>
        <field name="upper_bound">50000000.0</field>
        <field name="default_value">0.0</field>
        <field name="value_type">amount</field>
    </record>

    <record id="advantage_template_privinsamt" model="hr.contract.advantage.template">
        <field name="name">Private insurance allowance approved</field>
        <field name="code">PRIVINSAMT</field>
        <field name="lower_bound">0.0</field>
        <field name="upper_bound">500000000.0</field>
        <field name="default_value">0.0</field>
        <field name="value_type">amount</field>
    </record>

    <record id="advantage_template_hltheeamt" model="hr.contract.advantage.template">
        <field name="name">Private health premium — employee</field>
        <field name="code">HLTHEEAMT</field>
        <field name="lower_bound">0.0</field>
        <field name="upper_bound">100000000.0</field>
        <field name="default_value">0.0</field>
        <field name="value_type">amount</field>
    </record>

    <record id="advantage_template_hlthdepamt" model="hr.contract.advantage.template">
        <field name="name">Private health premium — dependants</field>
        <field name="code">HLTHDEPAMT</field>
        <field name="lower_bound">0.0</field>
        <field name="upper_bound">100000000.0</field>
        <field name="default_value">0.0</field>
        <field name="value_type">amount</field>
    </record>
</odoo>
