<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Declared as a RECORD rather than reached by a bare tag: a bare tag is
         synthesised with no action NAME, so anything returning through a
         breadcrumb lands on a crumb labelled "Unnamed" (ledger GR8).

         The RETURN DOOR is on the action itself, so every way in — a ⌘K row,
         a chip on somebody's card, a bookmark — arrives with the same way out.

         Test URL: /odoo/action-pb_assignments -->

    <record id="action_pb_assignments" model="ir.actions.client">
        <field name="name">Where people work</field>
        <field name="tag">pb_assignments</field>
        <field name="context">{'pb_back': {'label': 'People', 'tag': '', 'xmlid': 'pb_people_hub.action_pb_people_hub', 'lens': '', 'context': {}}}</field>
    </record>

    <record id="action_pb_same_person" model="ir.actions.client">
        <field name="name">Same person?</field>
        <field name="tag">pb_assignments</field>
        <field name="context">{'pb_focus': 'merge', 'pb_back': {'label': 'People', 'tag': '', 'xmlid': 'pb_people_hub.action_pb_people_hub', 'lens': '', 'context': {}}}</field>
    </record>

    <record id="action_pb_cost_transfers" model="ir.actions.act_window">
        <field name="name">Charged between entities</field>
        <field name="res_model">pb.cost.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Nothing has been charged between entities yet</p>
            <p>When a person's home entity pays their whole month and another entity used some of their days, the share appears here.</p>
        </field>
    </record>

</odoo>
