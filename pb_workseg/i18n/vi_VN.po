"%(month)s: %(days)s of %(total)s working days were worked in %(company)s. "
"%(pattern)s."
msgstr ""
"%(month)s: %(days)s trong %(total)s ngày làm việc được làm tại %(company)s. "
"%(pattern)s."

#. module: pb_workseg
#. odoo-python
#: code:addons/pb_workseg/models/pb_work_segment.py:0
msgid ""
"%(name)s already has days in %(company)s between %(start)s and %(end)s. "
"Change those days instead of adding a second stretch over the top."
msgstr ""
"%(name)s đã có ngày làm việc tại %(company)s từ %(start)s đến %(end)s. Hãy "
"sửa khoảng ngày đó thay vì thêm một khoảng chồng lên."

