#. module: pb_workseg
#. odoo-python
#: code:addons/pb_workseg/models/pb_work_segment.py:0
msgid ""
"%(days)s of %(total)s working days in %(month)s were worked here, so this "
"payslip covers that share of the month."
msgstr ""
"%(days)s trong %(total)s ngày làm việc của %(month)s được làm ở đây, nên "
"phiếu lương này chỉ tính phần đó của tháng."

#. module: pb_workseg
#. odoo-python
#: code:addons/pb_workseg/models/pb_work_segment.py:0
msgid ""
"%(kept)s of %(total)s working days in %(month)s were worked here; the rest "
"were worked in %(where)s."
msgstr ""
"%(kept)s trong %(total)s ngày làm việc của %(month)s được làm ở đây; số còn "
"lại được làm tại %(where)s."

#. module: pb_workseg
#. odoo-python
#: code:addons/pb_workseg/models/pb_work_segment.py:0
msgid ""
"%(month)s is already paid for %(name)s. Add the change in %(next_month)s "
"instead, as a correction."
msgstr ""
"%(month)s đã trả lương cho %(name)s. Hãy thêm thay đổi này vào "
"%(next_month)s như một khoản điều chỉnh."

#. module: pb_workseg
#. odoo-python
#: code:addons/pb_workseg/models/pb_assignments.py:0
