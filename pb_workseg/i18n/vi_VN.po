#. odoo-javascript
#: code:addons/pb_workseg/static/src/xml/workseg.xml:0
msgid ""
"A month is thirty days. Draw the ones somebody spent somewhere else and see "
"both payslips before anything is saved."
msgstr ""
"Một tháng có ba mươi ngày. Hãy vẽ những ngày ai đó làm việc ở nơi khác và "
"xem cả hai phiếu lương trước khi lưu bất cứ điều gì."

#. module: pb_workseg
#. odoo-python
#: code:addons/pb_workseg/models/pb_work_segment.py:0
msgid ""
"A stretch of days belongs to one month. Split it into one for each month and"
" each pay run will find its own."
msgstr ""
"Một khoảng ngày chỉ thuộc về một tháng. Hãy tách thành mỗi tháng một khoảng,"
" khi đó mỗi kỳ lương sẽ tự tìm được phần của mình."

