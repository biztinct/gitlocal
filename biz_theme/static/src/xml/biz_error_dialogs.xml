<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="biz_theme.BizErrorDialog">
        <Dialog size="'md'" header="false" contentClass="'biz-err-modal'">
            <div t-attf-class="biz-err biz-err--{{ variant }}" role="alert">
                <button class="biz-err__x" t-on-click="props.close" title="Close" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
                <div class="biz-err__icon">
                    <svg t-if="meta.icon === 'shield'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                        <circle cx="12" cy="11" r="1.6"/><path d="M12 12.6V15"/>
                    </svg>
                    <svg t-elif="meta.icon === 'alert'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/>
                        <path d="M12 9v4"/><path d="M12 17h.01"/>
                    </svg>
                    <svg t-elif="meta.icon === 'ghost'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 10h.01"/><path d="M15 10h.01"/>
                        <path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"/>
                    </svg>
                    <svg t-elif="meta.icon === 'clock'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                    </svg>
                    <svg t-elif="meta.icon === 'moon'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                    </svg>
                    <svg t-else="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                    </svg>
                </div>

                <h3 class="biz-err__title" t-esc="meta.title"/>
                <p t-if="bodyMessage" class="biz-err__message" t-esc="bodyMessage"/>
                <p t-if="meta.hint" class="biz-err__hint" t-esc="meta.hint"/>

                <div t-if="groups.length" class="biz-err__groups">
                    <div class="biz-err__groups-label">Roles with access</div>
                    <div class="biz-err__chips">
                        <span t-foreach="groups" t-as="g" t-key="g_index" class="biz-err__chip" t-esc="g"/>
                    </div>
                </div>

                <!-- raw payload is debug-mode only; end users never see it -->
                <div t-if="showTechnicalDetails" class="biz-err__details">
                    <button class="biz-err__details-toggle" t-on-click="toggleDetails">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" t-attf-style="transform: rotate({{ state.showDetails ? 90 : 0 }}deg)">
                            <path d="m9 18 6-6-6-6"/>
                        </svg>
                        Technical details
                    </button>
                    <pre t-if="state.showDetails" class="biz-err__details-body" t-esc="technicalDetails"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button t-if="hasDetails" class="btn biz-err__copy" t-on-click="copyDetails">
                    <t t-esc="state.copied ? 'Copied ✓' : 'Copy details'"/>
                </button>
                <button class="btn btn-primary biz-err__primary" t-on-click="onPrimaryClick" t-esc="primaryLabel"/>
            </t>
        </Dialog>
    </t>

</templates>
