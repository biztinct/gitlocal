<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="pb_statutory.PbStatutory">
    <div class="pbs">
      <div t-if="!state.loaded" class="pbs-loading"><div class="pbs-spinner"/><span>Loading statutory…</span></div>

      <div t-else="" class="pbs-wrap">
        <div class="pbs-head">
          <div>
            <h1>Statutory</h1>
            <p class="pbs-sub">Insurance rates, tax brackets and contribution actuals.</p>
          </div>
        </div>

        <!-- contribution actuals KPI -->
        <div t-if="state.actuals" class="pbs-kpis">
          <div class="pbs-kpi hero">
            <span class="l">Total contributions <t t-if="state.actuals.run_name">· <t t-esc="state.actuals.run_name"/></t></span>
            <span class="v" t-esc="money(state.actuals.grand_total)"/>
            <span class="m"><t t-esc="state.actuals.covered"/> employees covered</span>
          </div>
          <div class="pbs-kpi">
            <span class="l">Employee leg</span>
            <span class="v indigo" t-esc="money(state.actuals.emp_total)"/>
            <span class="m">withheld from pay</span>
          </div>
          <div class="pbs-kpi">
            <span class="l">Employer leg</span>
            <span class="v cyan" t-esc="money(state.actuals.comp_total)"/>
            <span class="m">company cost</span>
          </div>
        </div>

        <div class="pbs-cols">
          <!-- insurance policy -->
          <div class="pbs-panel">
            <div class="pbs-panel-h">
              <h2>Insurance rates</h2>
              <span t-if="state.policy" class="pbs-tag" t-esc="state.policy.code"/>
            </div>
            <t t-if="state.policy">
              <div class="pbs-policyname"><t t-esc="state.policy.name"/><span t-if="state.policy.effective"> · from <t t-esc="state.policy.effective"/></span></div>
              <div class="pbs-rate-table">
                <div class="pbs-rate head">
                  <span class="c-ins">Scheme</span><span class="c-ee">Employee</span><span class="c-er">Employer</span><span class="c-cl">Ceiling</span>
                </div>
                <div t-foreach="state.policy.rows" t-as="r" t-key="r.key" class="pbs-rate">
                  <span class="c-ins"><span t-attf-class="pbs-dot {{ r.key }}"/><t t-esc="r.label"/></span>
                  <span class="c-ee" t-esc="rate(r.employee)"/>
                  <span class="c-er" t-esc="rate(r.employer)"/>
                  <span class="c-cl" t-esc="money(r.ceiling)"/>
                </div>
                <div class="pbs-rate total">
                  <span class="c-ins">Combined</span>
                  <span class="c-ee" t-esc="rate(state.policy.total_employee)"/>
                  <span class="c-er" t-esc="rate(state.policy.total_employer)"/>
                  <span class="c-cl"><t t-esc="rate(state.policy.total_combined)"/> total</span>
                </div>
              </div>
            </t>
            <div t-else="" class="pbs-empty">No active insurance policy configured.</div>
          </div>

          <!-- contribution actuals breakdown -->
          <div class="pbs-panel">
            <div class="pbs-panel-h"><h2>Contributions by scheme</h2><span class="pbs-tag">latest run</span></div>
            <t t-if="state.actuals">
              <div class="pbs-contrib">
                <div t-foreach="state.actuals.rows" t-as="r" t-key="r.key" class="pbs-contrib-row">
                  <div class="pbs-contrib-top">
                    <span class="nm"><span t-attf-class="pbs-dot {{ r.key }}"/><t t-esc="r.label"/></span>
                    <span class="amt" t-esc="money(r.total)"/>
                  </div>
                  <div class="pbs-contrib-track">
                    <div class="pbs-contrib-emp" t-attf-style="width:{{ pct(r.emp, state.actuals.grand_total) }}%"/>
                    <div class="pbs-contrib-comp" t-attf-style="width:{{ pct(r.comp, state.actuals.grand_total) }}%"/>
                  </div>
                </div>
              </div>
              <div class="pbs-legend">
                <span class="lg"><span class="sw emp"/>Employee</span>
                <span class="lg"><span class="sw comp"/>Employer</span>
              </div>
            </t>
            <div t-else="" class="pbs-empty">No payslip run to summarise yet.</div>
          </div>
        </div>

        <!-- tax table -->
        <div class="pbs-panel">
          <div class="pbs-panel-h">
            <h2>Income tax brackets</h2>
            <span t-if="state.tax" class="pbs-tag"><t t-esc="state.tax.name"/> · <t t-esc="state.tax.year"/></span>
          </div>
          <t t-if="state.tax">
            <div class="pbs-deductions">
              <div class="pbs-ded"><span class="l">Personal deduction</span><span class="v" t-esc="full(state.tax.personal_deduction)"/><span class="u">/ month</span></div>
              <div class="pbs-ded"><span class="l">Dependent deduction</span><span class="v" t-esc="full(state.tax.dependent_deduction)"/><span class="u">/ person / month</span></div>
            </div>
            <div t-if="state.tax.slabs.length" class="pbs-slabs">
              <div class="pbs-slab head">
                <span class="c-br">Taxable income (monthly)</span><span class="c-rt">Rate</span><span class="c-fx">Fixed base</span>
              </div>
              <div t-foreach="state.tax.slabs" t-as="s" t-key="s_index" class="pbs-slab">
                <span class="c-br" t-esc="bracket(s)"/>
                <span class="c-rt"><span class="pbs-pill" t-esc="rate(s.rate)"/></span>
                <span class="c-fx" t-esc="s.fixed ? full(s.fixed) : '—'"/>
              </div>
            </div>
            <div t-else="" class="pbs-empty">No tax brackets defined on this table.</div>
          </t>
          <div t-else="" class="pbs-empty">No active tax table configured.</div>
        </div>

        <!-- manage launches -->
        <div class="pbs-panel" t-if="state.launches.length">
          <div class="pbs-panel-h"><h2>Manage</h2></div>
          <div class="pbs-launches">
            <button t-foreach="state.launches" t-as="l" t-key="l.xmlid" class="pbs-launch" t-on-click="() => this.open(l.xmlid)">
              <span class="tx">
                <span class="lb" t-esc="l.label"/>
                <span class="ds" t-esc="l.desc"/>
              </span>
              <span class="ar">→</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </t>

</templates>
