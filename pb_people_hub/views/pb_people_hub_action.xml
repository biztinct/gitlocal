<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The People hub.

         Test URL: /odoo/action-pb_people_hub
                   (/bizapp/action-pb_people_hub on the live server, biz_deroute)

         Declared as a RECORD rather than reached by bare tag, so anything that
         returns through a breadcrumb sees a named action instead of "Unnamed"
         (W98) — which matters more here than in any other hub, because the Plan
         lens opens six NATIVE list views and the breadcrumb is their only way
         back. -->
    <record id="action_pb_people_hub" model="ir.actions.client">
        <field name="name">People</field>
        <field name="tag">pb_people_hub</field>
    </record>

    <!-- The Contracts board, opened from the Employees lens.

         Contracts used to be this hub's second lens. A contract belongs to a
         person, so the board is now a door INSIDE Employees rather than a tab
         beside it, and it opens as its own page. The return door rides in the
         action's own context (the pb_pay / pb_workseg precedent), so the ⌘K
         row and the Employees button both land on a board with a way back to
         Employees. The tag is pb_contracts' own cockpit, unforked. -->
    <record id="action_pb_people_contracts" model="ir.actions.client">
        <field name="name">Contracts</field>
        <field name="tag">pb_contracts</field>
        <field name="context">{'pb_back': {'label': 'People', 'tag': '', 'xmlid': 'pb_people_hub.action_pb_people_hub', 'lens': 'employees', 'context': {}}}</field>
    </record>
</odoo>
