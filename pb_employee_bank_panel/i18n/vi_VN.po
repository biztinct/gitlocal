#. module: pb_employee_bank_panel
#. odoo-javascript
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/bank_panel.py:0
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Account holder"
msgstr "Chủ tài khoản"

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/bank_panel.py:0
msgid "Account number"
msgstr "Số tài khoản"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Account number, last four digits"
msgstr "Số tài khoản, bốn chữ số cuối"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid ""
"Account numbers show the last four digits only. To change where this person "
"is paid, use a bank change request."
msgstr "Số tài khoản chỉ hiện bốn chữ số cuối. Để đổi nơi nhận lương của người này, hãy gửi yêu cầu thay đổi ngân hàng."

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/bank_panel.py:0
msgid "Approved"
msgstr "Đã duyệt"

#. module: pb_employee_bank_panel
#. odoo-javascript
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/bank_panel.py:0
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Bank"
msgstr "Ngân hàng"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Bank files cannot pay this person until an account is approved."
msgstr "Tệp ngân hàng không thể trả lương cho người này cho đến khi có tài khoản được duyệt."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Bank not named"
msgstr "Chưa ghi tên ngân hàng"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Change waiting for approval"
msgstr "Thay đổi đang chờ duyệt"

#. module: pb_employee_bank_panel
#: model:ir.model.fields,help:pb_employee_bank_panel.field_hr_employee__pb_profile_waiting
msgid "Details this person has sent that are waiting for HR to approve."
msgstr "Thông tin người này đã gửi và đang chờ HR duyệt."

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/bank_panel.py:0
msgid "Employee not found."
msgstr "Không tìm thấy nhân viên."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "In another person's name:"
msgstr "Đứng tên người khác:"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Mark as seen"
msgstr "Đánh dấu đã xem"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/js/bank_panel.js:0
msgid "Marked as seen by %(who)s on %(date)s. Payment is not changed by this."
msgstr "%(who)s đã đánh dấu đã xem ngày %(date)s. Việc này không thay đổi cách trả lương."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/js/bank_panel.js:0
msgid "Marked as seen. Payment is not changed by this."
msgstr "Đã đánh dấu đã xem. Việc này không thay đổi cách trả lương."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid ""
"Marking it as seen only hides this notice. Whether this person is paid by "
"bank file is decided by the company setting on Settings › Payroll › Bank "
"layouts."
msgstr "Đánh dấu đã xem chỉ ẩn thông báo này. Việc người này có được trả qua tệp ngân hàng hay không do cài đặt của công ty tại Cài đặt › Tiền lương › Mẫu tệp ngân hàng quyết định."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "New account:"
msgstr "Tài khoản mới:"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "No approved bank account on record."
msgstr "Chưa có tài khoản ngân hàng nào được duyệt."

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/mapping_retired.py:0
msgid "No longer shown — use Bank account"
msgstr "Không còn hiển thị — hãy dùng Tài khoản ngân hàng"

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/bank_panel.py:0
msgid "None"
msgstr "Chưa có"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Not recorded"
msgstr "Chưa ghi nhận"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Nothing is paid by bank file until it is approved."
msgstr "Chưa trả qua tệp ngân hàng cho đến khi thay đổi được duyệt."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Open Bank Verification"
msgstr "Mở Xác minh ngân hàng"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Open the request"
msgstr "Mở yêu cầu"

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/mapping_retired.py:0
msgid "Send bank details to the Bank lane instead."
msgstr "Hãy chuyển thông tin ngân hàng sang làn Ngân hàng."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/onboarding_board.xml:0
#: model:ir.model.fields,field_description:pb_employee_bank_panel.field_hr_employee__pb_profile_waiting
#: model_terms:ir.ui.view,arch_db:pb_employee_bank_panel.portal_my_journey_waiting
msgid "Sent, waiting for HR"
msgstr "Đã gửi, chờ HR duyệt"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/onboarding_board.xml:0
msgid "Sent, waiting for HR:"
msgstr "Đã gửi, chờ HR duyệt:"

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/bank_panel.py:0
msgid "Status"
msgstr "Trạng thái"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "The Vietnamese bank file has a different account:"
msgstr "Tệp ngân hàng Việt Nam đang có tài khoản khác:"

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid ""
"The payment list pays the account above; the Vietnamese bank file pays this "
"one."
msgstr "Danh sách chi trả trả vào tài khoản ở trên; tệp ngân hàng Việt Nam trả vào tài khoản này."

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/mapping_retired.py:0
msgid ""
"This box is no longer on any screen and nothing is paid from it. The mapping"
" saved here keeps working; for bank details, send the column to the Bank "
"lane (the employee's bank account) instead."
msgstr "Ô này không còn trên màn hình nào và không dùng để trả lương. Liên kết đã lưu ở đây vẫn hoạt động; với thông tin ngân hàng, hãy chuyển cột sang làn Ngân hàng (tài khoản ngân hàng của nhân viên)."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/js/bank_panel.js:0
msgid "This could not be marked as seen."
msgstr "Không thể đánh dấu đã xem."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Until it is approved, pay goes to the account above."
msgstr "Cho đến khi được duyệt, lương vẫn trả vào tài khoản ở trên."

#. module: pb_employee_bank_panel
#. odoo-javascript
#: code:addons/pb_employee_bank_panel/static/src/xml/bank_panel.xml:0
msgid "Vietnamese bank file"
msgstr "Tệp ngân hàng Việt Nam"

#. module: pb_employee_bank_panel
#. odoo-python
#: code:addons/pb_employee_bank_panel/models/bank_panel.py:0
msgid "Waiting for approval"
msgstr "Đang chờ duyệt"
