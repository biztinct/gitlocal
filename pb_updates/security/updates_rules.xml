<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ==================================================================
         Multi-company. A named update and a remembered column matching
         belong to the company they were made in, and are never seen from
         another one. Global rules (no groups), so they AND with everything.
         ================================================================== -->

    <record id="rule_pb_updates_batch_company" model="ir.rule">
        <field name="name">Updates: named updates of my companies</field>
        <field name="model_id" ref="model_pb_updates_batch"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- UPDATES P3b — a draft is private to the person who made it. Global
         (ANDs with the company rule above); a sent update is unaffected. -->
    <record id="rule_pb_updates_batch_draft_owner" model="ir.rule">
        <field name="name">Updates: a draft is seen only by its owner</field>
        <field name="model_id" ref="model_pb_updates_batch"/>
        <field name="domain_force">['|', ('state', '!=', 'draft'), ('user_id', '=', user.id)]</field>
    </record>

    <!-- UPDATES P3b — a new employee row follows its update's company. -->
    <record id="rule_pb_updates_joiner_company" model="ir.rule">
        <field name="name">Updates: new employees from a sheet, of my companies</field>
        <field name="model_id" ref="model_pb_updates_joiner"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- UPDATES P2d — a one-off pay item belongs to the person's company. -->
    <record id="rule_pb_updates_oneoff_company" model="ir.rule">
        <field name="name">Updates: one-off pay items of my companies</field>
        <field name="model_id" ref="model_pb_updates_oneoff"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- UPDATES P4 — a leave opening balance belongs to the person's company. -->
    <record id="rule_pb_updates_leave_line_company" model="ir.rule">
        <field name="name">Updates: leave opening balances of my companies</field>
        <field name="model_id" ref="model_pb_updates_leave_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_pb_updates_layout_company" model="ir.rule">
        <field name="name">Updates: column matchings of my companies</field>
        <field name="model_id" ref="model_pb_updates_layout"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
