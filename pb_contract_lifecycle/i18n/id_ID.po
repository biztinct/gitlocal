#. module: pb_contract_lifecycle
#. odoo-python
#: code:addons/pb_contract_lifecycle/models/workflow_timetable.py:0
msgid "Contracts"
msgstr "Kontrak"

#. module: pb_contract_lifecycle
#. odoo-python
#: code:addons/pb_contract_lifecycle/models/workflow_timetable.py:0
msgid ""
"%s days before a contract ends, its manager is asked to decide what happens next."
msgstr ""
"%s hari sebelum kontrak berakhir, atasannya diminta memutuskan apa yang terjadi selanjutnya."

#. module: pb_contract_lifecycle
#. odoo-python
#: code:addons/pb_contract_lifecycle/models/workflow_timetable.py:0
msgid ""
"%s days before a contract ends, its manager can be asked to decide what happens next (raising these by itself is switched off here)."
msgstr ""
"%s hari sebelum kontrak berakhir, atasannya dapat diminta memutuskan apa yang terjadi selanjutnya (pembuatan otomatis permintaan ini nonaktif di sini)."

#. module: pb_contract_lifecycle
#. odoo-python
#: code:addons/pb_contract_lifecycle/models/workflow_timetable.py:0
msgid ""
"While a contract decision is still open, HR is told halfway to the end date, and every day in the last %s days."
msgstr ""
"Selama keputusan kontrak masih terbuka, HR diberi tahu saat sudah setengah jalan menuju tanggal berakhir, dan setiap hari dalam %s hari terakhir."
