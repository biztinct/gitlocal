<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Admin CONFIG + off-menu fallback only. The demo surface is the Employee
         360 drawer in People — documents never surface a native form to an HR
         user. Categories are pure config (F–J WOW-rule exemption). -->

    <!-- ================= document category (config) ================= -->
    <record id="view_document_category_list" model="ir.ui.view">
        <field name="name">pb.employee.document.category.list</field>
        <field name="model">pb.employee.document.category</field>
        <field name="arch" type="xml">
            <list string="Document Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="requires_expiry"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_document_category_form" model="ir.ui.view">
        <field name="name">pb.employee.document.category.form</field>
        <field name="model">pb.employee.document.category</field>
        <field name="arch" type="xml">
            <form string="Document Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="requires_expiry"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_document_category" model="ir.actions.act_window">
        <field name="name">Document Categories</field>
        <field name="res_model">pb.employee.document.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ================= document (off-menu admin fallback) ================= -->
    <record id="view_employee_document_list" model="ir.ui.view">
        <field name="name">pb.employee.document.list</field>
        <field name="model">pb.employee.document</field>
        <field name="arch" type="xml">
            <list string="Employee Documents" create="false">
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="name"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="expiry_state"/>
                <field name="verified"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_employee_document_form" model="ir.ui.view">
        <field name="name">pb.employee.document.form</field>
        <field name="model">pb.employee.document</field>
        <field name="arch" type="xml">
            <form string="Employee Document">
                <header>
                    <button name="action_verify" type="object" string="Verify"
                            class="btn-primary" invisible="verified"/>
                    <button name="action_unverify" type="object"
                            string="Revoke verification" invisible="not verified"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="category_id"/>
                            <field name="name"/>
                            <field name="attachment_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="expiry_state"/>
                            <field name="verified"/>
                            <field name="verified_by"/>
                            <field name="verified_at"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note…"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- menus: Settings › Technical (admin). Categories only; documents stay
         off-menu (the drawer is their surface). -->
    <menuitem id="menu_employee_vault_root" name="Employee Vault"
              parent="base.menu_custom" groups="base.group_system" sequence="92"/>
    <menuitem id="menu_document_category" name="Document Categories"
              parent="menu_employee_vault_root" action="action_document_category"
              groups="base.group_system" sequence="10"/>
</odoo>
