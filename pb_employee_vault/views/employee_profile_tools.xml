<odoo>
    <record id="view_employee_profile_tools" model="ir.ui.view">
        <field name="name">hr.employee.profile.pay.resume</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group groups="om_hr_payroll.group_hr_payroll_manager,base.group_system">
                    <field name="pb_profile_contract_pay" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='resume']" position="inside">
                <group string="Résumé file" groups="hr.group_hr_user,om_hr_payroll.group_hr_payroll_user">
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <button name="action_upload_resume" type="object" string="Upload résumé" class="btn-primary"/>
                        <button name="action_view_resumes" type="object" string="View résumés" class="btn-secondary"/>
                        <span class="text-muted">PDF, up to 10 MB. Files are saved in the employee’s Documents.</span>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_employee_resume_upload" model="ir.ui.view">
        <field name="name">pb.employee.resume.upload.form</field>
        <field name="model">pb.employee.resume.upload</field>
        <field name="arch" type="xml">
            <form string="Upload résumé">
                <group><field name="employee_id" options="{'no_open':True}"/>
                    <field name="filename" invisible="1"/>
                    <field name="file_data" filename="filename" options="{'accepted_file_extensions':'.pdf'}"/>
                </group>
                <footer><button name="action_upload" type="object" string="Upload" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
