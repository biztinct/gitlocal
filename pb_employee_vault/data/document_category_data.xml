<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default document categories. noupdate=1 so a deployment may rename /
         re-sequence / add its own without a -u reverting the edits. -->
    <record id="cat_labor_contract" model="pb.employee.document.category">
        <field name="name">Labor Contract</field>
        <field name="code">LABOR</field>
        <field name="requires_expiry" eval="False"/>
        <field name="sequence">10</field>
    </record>
    <record id="cat_id_document" model="pb.employee.document.category">
        <field name="name">ID Document</field>
        <field name="code">ID</field>
        <field name="requires_expiry" eval="True"/>
        <field name="sequence">20</field>
    </record>
    <record id="cat_certificate" model="pb.employee.document.category">
        <field name="name">Degree / Certificate</field>
        <field name="code">CERT</field>
        <field name="requires_expiry" eval="False"/>
        <field name="sequence">30</field>
    </record>
    <record id="cat_health_check" model="pb.employee.document.category">
        <field name="name">Health Check</field>
        <field name="code">HEALTH</field>
        <field name="requires_expiry" eval="True"/>
        <field name="sequence">40</field>
    </record>
    <record id="cat_work_permit" model="pb.employee.document.category">
        <field name="name">Work Permit</field>
        <field name="code">PERMIT</field>
        <field name="requires_expiry" eval="True"/>
        <field name="sequence">50</field>
    </record>
    <record id="cat_other" model="pb.employee.document.category">
        <field name="name">Other</field>
        <field name="code">OTHER</field>
        <field name="requires_expiry" eval="False"/>
        <field name="sequence">99</field>
    </record>
</odoo>
