<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- `numbercall` and `doall` were REMOVED from ir.cron in Odoo 19 —
         including either aborts the whole module load — and `nextcall` takes
         no eval expression in a data file, so the first run is simply the
         next tick after installation.

         TWO JOBS, AND THEY ARE NOT THE SAME JOB. One tells somebody that a
         contract is about to run out; the other TAKES SOMETHING AWAY. They
         run at the same interval and are deliberately separate records, so
         that switching the reminder mails off can never switch off the
         thing that closes a security hole.

         `pb.vendor.alerts` is ABSTRACT, and an ir.cron pointing at an
         abstract model is a trap the framework gives no warning for — so
         the first job is anchored on the agreement (a concrete model) and
         calls the service by name, the shape `pb_budget`'s own actuals cron
         uses. The second is anchored on its own model, which is concrete.

         BOTH ARE IDEMPOTENT BY CONSTRUCTION, not by a stamp. The reminder
         job searches for an already-open activity before raising one and
         only stamps a date once it has; the revert job only ever finds rows
         in `active` and the first thing it does is move the state. -->

    <record id="cron_vendor_alerts" model="ir.cron">
        <field name="name">Vendors: which agreements are running out</field>
        <field name="model_id" ref="model_pb_vendor_agreement"/>
        <field name="state">code</field>
        <field name="code">env['pb.vendor.alerts'].cron_alerts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_access_auto_revert" model="ir.cron">
        <field name="name">Access: take back the hand-overs that have ended</field>
        <field name="model_id" ref="model_pb_access_delegation"/>
        <field name="state">code</field>
        <field name="code">env['pb.access.delegation'].cron_auto_revert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
