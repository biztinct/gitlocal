<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <!-- Loop vars are deliberately short non-word-operator names: OWL's
       expression compiler maps `lt`/`gt`/`and`/`or`/`in` to JS operators
       (C18.71). -->
  <t t-name="pb_workforce_insights.PbWorkforceInsights">
    <div class="pbwi pbim">

      <div t-if="!state.loaded" class="pbwi-loading">
        <div class="pbwi-spin"/><span>Reading the workforce…</span>
      </div>

      <div t-else="" class="pbwi-wrap">

        <!-- ============================ header ========================== -->
        <div class="pbwi-head">
          <div>
            <div class="eyebrow"><t t-out="ic('users', 13)"/><span>Workforce</span></div>
            <h1>Workforce Insights</h1>
            <p class="sub">
              Attendance, overtime, leave and cost per head — on real payroll
              and attendance data, filterable, and every figure opens the people behind it.
            </p>
          </div>
          <div class="pbwi-tools">
            <div class="pbwi-chips">
              <button t-foreach="[1, 3, 6, 12]" t-as="win" t-key="win" class="chip"
                      t-att-class="state.months === win ? 'on' : ''"
                      t-on-click="() => this.setMonths(win)">
                <t t-esc="win"/>M
              </button>
            </div>
            <button class="pbwi-icobtn" title="Refresh" t-on-click="() => this.load()">
              <t t-out="ic('refresh', 15)"/>
            </button>
          </div>
        </div>

        <div t-if="state.error" class="pbwi-alert danger">
          <t t-out="ic('alert', 16)"/><span t-esc="state.error"/>
        </div>

        <!-- =========================== filters ========================== -->
        <div class="pbwi-filters">
          <div class="pbwi-picker" t-if="d.options and d.options.division.length">
            <button class="pbwi-fchip" t-att-class="{ on: state.division }"
                    t-on-click="() => this.togglePicker('division')">
              <t t-out="ic('layers', 13)"/><span t-esc="divisionLabel"/>
              <t t-out="ic('chevronDown', 13)"/>
            </button>
            <div t-if="state.openPicker === 'division'" class="pbwi-menu">
              <button t-foreach="d.options.division" t-as="opt" t-key="opt.value"
                      class="pbwi-mi" t-att-class="{ active: opt.value === state.division }"
                      t-on-click="() => this.setFilter('division', opt.value)"
                      t-esc="opt.label"/>
            </div>
          </div>
          <div class="pbwi-picker" t-if="d.options and d.options.department_id.length">
            <button class="pbwi-fchip" t-att-class="{ on: state.departmentId }"
                    t-on-click="() => this.togglePicker('dept')">
              <t t-out="ic('users', 13)"/><span t-esc="departmentLabel"/>
              <t t-out="ic('chevronDown', 13)"/>
            </button>
            <div t-if="state.openPicker === 'dept'" class="pbwi-menu scroll">
              <button t-foreach="d.options.department_id" t-as="opt" t-key="opt.value"
                      class="pbwi-mi" t-att-class="{ active: opt.value === state.departmentId }"
                      t-on-click="() => this.setFilter('dept', opt.value)"
                      t-esc="opt.label"/>
            </div>
          </div>
          <button t-if="hasFilters" class="pbwi-clear"
                  t-on-click="() => this.clearFilters()">Clear filters</button>
          <span class="pbwi-since">since <t t-esc="d.date_from"/></span>
        </div>

        <!-- ============================ hero ============================ -->
        <div class="pbwi-kpis">
          <div class="pbwi-kpi">
            <span class="ico blue"><t t-out="ic('users', 18)"/></span>
            <span class="tx"><b t-esc="num(headcount.latest)"/><i>employees paid</i></span>
          </div>
          <button class="pbwi-kpi door" t-if="headcount.movement"
                  t-on-click="() => this.openMovement('joiners')">
            <span class="ico green"><t t-out="ic('trending', 18)"/></span>
            <span class="tx"><b t-esc="num(headcount.movement.joiners)"/><i>joined</i></span>
          </button>
          <button class="pbwi-kpi door" t-if="headcount.movement"
                  t-att-class="{ muted: headcount.movement.partial }"
                  t-on-click="() => this.openMovement('leavers')">
            <span class="ico rose"><t t-out="ic('trendingDn', 18)"/></span>
            <span class="tx"><b t-esc="num(headcount.movement.leavers)"/>
              <i t-if="headcount.movement.partial">not yet paid this month</i>
              <i t-else="">left</i>
            </span>
          </button>
          <div class="pbwi-kpi">
            <span class="ico amber"><t t-out="ic('wallet', 18)"/></span>
            <span class="tx"><b t-esc="money(cost.company_per_head)"/><i>cost per head</i></span>
          </div>
        </div>
        <p t-if="headcount.movement and headcount.movement.from" class="pbwi-note"
           t-att-class="{ warn: headcount.movement.partial }">
          <t t-if="headcount.movement.partial">
            <t t-out="ic('alert', 13)"/>
            <b t-esc="headcount.movement.to"/> is still in progress — pay runs
            for the rest of the month have not happened yet, so everyone not
            yet paid counts as a leaver. Switch to a finished month before
            reading these two figures.
          </t>
          <t t-else="">
            Movement compares <b t-esc="headcount.movement.from"/> with
            <b t-esc="headcount.movement.to"/> on a payroll basis — who was
            actually paid, not who has a contract end date.
          </t>
        </p>

        <!-- ========================== headcount ========================= -->
        <div class="pbwi-panel">
          <div class="pbwi-ph"><h2>Headcount paid</h2>
            <span class="hint">month by month</span></div>
          <div class="pbwi-canvas"><canvas t-ref="hcChart"/></div>
        </div>

        <div class="pbwi-duo">
          <!-- ======================== attendance ======================== -->
          <div class="pbwi-panel">
            <div class="pbwi-ph"><h2>Attendance exceptions</h2>
              <span class="hint" t-if="attendance">
                <t t-esc="num(attendance.total)"/> in the last weeks
                <t t-if="attendance.capped"> · sampled</t>
              </span>
            </div>
            <t t-if="attendance">
              <div class="pbwi-canvas sm"><canvas t-ref="attChart"/></div>
              <div class="pbwi-rows">
                <button t-foreach="attendance.by_kind" t-as="krow" t-key="krow.key"
                        class="pbwi-row door"
                        t-att-title="'Show the ' + krow.count + ' affected employees'"
                        t-on-click="() => this.openExceptionKind(krow)">
                  <span class="nm" t-esc="krow.label"/>
                  <span class="tr"><span class="fl"
                        t-attf-style="width:{{ bar(krow.count, attendance.by_kind, 'count') }}%"/></span>
                  <span class="vl" t-esc="num(krow.count)"/>
                </button>
              </div>
            </t>
            <div t-else="" class="pbwi-ghost">
              <t t-out="ic('alert', 20)"/>
              <span>The attendance workflow is not installed on this database.</span>
            </div>
          </div>

          <!-- ========================= overtime ========================= -->
          <div class="pbwi-panel">
            <div class="pbwi-ph"><h2>Overtime load</h2>
              <span class="hint" t-if="overtime"><t t-esc="hours(overtime.total)"/> approved</span>
            </div>
            <t t-if="overtime">
              <div class="pbwi-gauge" t-if="gauge">
                <svg viewBox="0 0 130 130">
                  <circle class="bg" cx="65" cy="65" t-att-r="gauge.r"/>
                  <circle class="fg" cx="65" cy="65" t-att-r="gauge.r"
                          t-att-stroke-dasharray="gauge.dash"
                          transform="rotate(-90 65 65)"/>
                </svg>
                <div class="mid">
                  <b><t t-esc="gauge.pct"/>%</b>
                  <i>avg of the ceiling, across
                     <t t-esc="gauge.people"/> people doing OT</i>
                </div>
              </div>
              <div class="pbwi-canvas sm"><canvas t-ref="otChart"/></div>
              <div class="pbwi-rows">
                <div t-foreach="overtime.by_type" t-as="otrow" t-key="otrow.key"
                     class="pbwi-row">
                  <span class="nm" t-esc="otrow.label"/>
                  <span class="tr"><span class="fl"
                        t-attf-style="width:{{ bar(otrow.hours, overtime.by_type, 'hours') }}%"/></span>
                  <span class="vl" t-esc="hours(otrow.hours)"/>
                </div>
              </div>
              <button t-if="overtime.near_cap" class="pbwi-warn door"
                      t-on-click="() => this.openNearCeiling()">
                <t t-out="ic('alert', 14)"/>
                <span><b t-esc="overtime.near_cap"/> employee(s) at 90% of the
                  <t t-esc="hours(overtime.cap)"/> monthly ceiling</span>
                <t t-out="ic('arrowRight', 13)"/>
              </button>
            </t>
            <div t-else="" class="pbwi-ghost">
              <t t-out="ic('clock', 20)"/>
              <span>Overtime is not installed on this database.</span>
            </div>
          </div>
        </div>

        <div class="pbwi-duo">
          <!-- =========================== leave ========================== -->
          <div class="pbwi-panel">
            <div class="pbwi-ph"><h2>Time off</h2>
              <span class="hint" t-if="leave"><t t-esc="leave.total_days"/> days taken</span>
            </div>
            <t t-if="leave">
              <div class="pbwi-leadrow">
                <button class="pbwi-lead door" t-on-click="() => this.openOutToday()">
                  <b t-esc="num(leave.out_today)"/><i>away today</i>
                </button>
                <div class="pbwi-lead"><b t-esc="num(leave.pending)"/><i>awaiting approval</i></div>
              </div>
              <div class="pbwi-rows">
                <div t-foreach="leave.by_type" t-as="lrow" t-key="lrow.label"
                     class="pbwi-row">
                  <span class="nm" t-esc="lrow.label"/>
                  <span class="tr"><span class="fl teal"
                        t-attf-style="width:{{ bar(lrow.days, leave.by_type, 'days') }}%"/></span>
                  <span class="vl"><t t-esc="lrow.days"/>d</span>
                </div>
              </div>
              <div t-if="!leave.by_type.length" class="pbwi-empty">
                No leave taken in this window.
              </div>
            </t>
            <div t-else="" class="pbwi-ghost">
              <t t-out="ic('calendar', 20)"/>
              <span>Time Off is not installed on this database.</span>
            </div>
          </div>

          <!-- ======================== cost per head ===================== -->
          <div class="pbwi-panel">
            <div class="pbwi-ph"><h2>Cost per head</h2>
              <span class="hint">by department · click to open in the Explorer</span></div>
            <div class="pbwi-rows" t-if="cost.rows and cost.rows.length">
              <button t-foreach="cost.rows" t-as="crow" t-key="crow.id"
                      class="pbwi-row door" t-att-class="{ inert: !crow.drillable }"
                      t-on-click="() => this.openCostRow(crow)">
                <span class="nm" t-esc="crow.name"/>
                <span class="tr"><span class="fl indigo"
                      t-attf-style="width:{{ bar(crow.per_head, cost.rows, 'per_head') }}%"/></span>
                <span class="vl" t-esc="money(crow.per_head)"/>
                <span class="hc" t-esc="num(crow.heads)"/>
              </button>
              <p t-if="cost.hidden" class="pbwi-more">
                +<t t-esc="cost.hidden"/> more departments not shown
              </p>
            </div>
            <div t-else="" class="pbwi-empty">No payroll cost in this window.</div>
          </div>
        </div>

        <p class="pbwi-foot">
          Board built in <t t-esc="d.timings and d.timings.total"/> ms ·
          cost figures read from the derived payroll fact tables, so they match
          the Analytics Explorer exactly.
        </p>
      </div>
    </div>
  </t>

</templates>
