<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pb_workforce_capability_tree" model="ir.ui.view">
            <field name="name">pb.workforce.capability.tree</field>
            <field name="model">pb.workforce.capability</field>
            <field name="arch" type="xml">
                <list default_order="sequence,name" create="true" editable="bottom">
                    <field name="name"/>
                    <field name="code" optional="show"/>
                    <field name="capability_type" widget="selection"/>
                    <field name="owner_id"/>
                    <field name="maturity" widget="selection" optional="hide"/>
                    <field name="primary_role_count" string="# Roles"/>
                    <field name="critical_role_count" string="Critical Roles" optional="hide"/>
                    <field name="planned_fte" optional="hide"/>
                    <field name="approved_budget" widget="monetary" optional="hide"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_pb_workforce_capability_kanban" model="ir.ui.view">
            <field name="name">pb.workforce.capability.kanban</field>
            <field name="model">pb.workforce.capability</field>
            <field name="arch" type="xml">
                <kanban default_order="sequence" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="capability_type"/>
                    <field name="primary_role_count"/>
                    <field name="critical_role_count"/>
                    <field name="planned_fte"/>
                    <field name="approved_budget"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_global_click pb-capability-card o_kanban_card oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}">
                                <div class="pb-capability-card__header">
                                    <div class="pb-capability-card__name">
                                        <strong t-esc="record.name.value"/>
                                    </div>
                                    <span class="badge badge-secondary" t-esc="record.capability_type.value"/>
                                </div>
                                <div class="pb-capability-card__stats">
                                    <div class="pb-capability-card__stat">
                                        <span class="pb-capability-card__stat-label">Roles</span>
                                        <span class="pb-capability-card__stat-value" t-esc="record.primary_role_count.value or 0"/>
                                    </div>
                                    <div class="pb-capability-card__stat">
                                        <span class="pb-capability-card__stat-label">Critical</span>
                                        <span class="pb-capability-card__stat-value" t-esc="record.critical_role_count.value or 0"/>
                                    </div>
                                    <div class="pb-capability-card__stat">
                                        <span class="pb-capability-card__stat-label">Planned FTE</span>
                                        <span class="pb-capability-card__stat-value" t-esc="record.planned_fte.value or 0"/>
                                    </div>
                                </div>
                                <t t-if="record.approved_budget.value">
                                    <div class="pb-capability-card__budget">
                                        <span class="pb-capability-card__stat-label">Budget</span>
                                        <field name="approved_budget" widget="monetary" options="{'currency_field': 'company_currency_id'}" class="pb-capability-card__stat-value"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_pb_workforce_capability_form" model="ir.ui.view">
            <field name="name">pb.workforce.capability.form</field>
            <field name="model">pb.workforce.capability</field>
            <field name="arch" type="xml">
                <form string="Capability" class="pb_form">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_open_roles" class="oe_stat_button" icon="fa-briefcase">
                                <field name="primary_role_count" widget="statinfo" string="Roles"/>
                            </button>
                            <button class="oe_stat_button" type="object" name="action_open_roles" icon="fa-bullseye">
                                <field name="critical_role_count" widget="statinfo" string="Critical"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="capability_type"/>
                                <field name="owner_id"/>
                                <field name="maturity"/>
                                <field name="vision_statement"/>
                            </group>
                            <group>
                            <field name="sequence"/>
                            <field name="color" widget="colorpicker"/>
                            <field name="last_review_date"/>
                            <field name="next_review_date" readonly="1"/>
                            <field name="planned_fte" readonly="1"/>
                            <field name="approved_budget" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" widget="html" class="oe_inline"/>
                                <field name="note" widget="html" class="oe_inline" string="Strategic Notes"/>
                            </page>
                            <page string="Subactivities">
                                <field name="subactivity_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="focus_level"/>
                                        <field name="sequence"/>
                                        <field name="is_automation_candidate"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Skills">
                                <field name="skill_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </page>
                            <page string="Analytics">
                                <group>
                                    <field name="primary_role_count" readonly="1"/>
                                    <field name="critical_role_count" readonly="1"/>
                                    <field name="planned_fte" readonly="1"/>
                                    <field name="approved_budget" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pb_workforce_capability_search" model="ir.ui.view">
            <field name="name">pb.workforce.capability.search</field>
            <field name="model">pb.workforce.capability</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <filter name="filter_primary" string="Primary" domain="[('capability_type', '=', 'primary')]"/>
                    <filter name="filter_secondary" string="Secondary" domain="[('capability_type', '=', 'secondary')]"/>
                    <filter name="filter_enabler" string="Enabler" domain="[('capability_type', '=', 'enabler')]"/>
                    <filter name="filter_mature" string="Mature" domain="[('maturity', '=', 'mature')]"/>
                    <filter name="filter_needs_review" string="Needs Review" domain="[('next_review_date', '&lt;', context_today())]"/>
                    <group name="group_by">
                        <filter name="group_type" string="Type" context="{'group_by': 'capability_type'}"/>
                        <filter name="group_maturity" string="Maturity" context="{'group_by': 'maturity'}"/>
                        <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
