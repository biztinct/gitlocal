<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_pb_workforce_capability" model="ir.actions.act_window">
            <field name="name">Capabilities</field>
            <field name="res_model">pb.workforce.capability</field>
            <field name="view_mode">kanban,list,form,pivot,graph</field>
            <field name="context">{'default_capability_type': 'primary'}</field>
            <field name="domain">[]</field>
        </record>

        <record id="action_pb_workforce_role" model="ir.actions.act_window">
            <field name="name">Roles</field>
            <field name="res_model">pb.workforce.role</field>
            <field name="view_mode">kanban,list,form,pivot,graph</field>
            <field name="context">{}</field>
        </record>

        <record id="action_pb_workforce_demand_plan" model="ir.actions.act_window">
            <field name="name">Demand Plans</field>
            <field name="res_model">pb.workforce.demand.plan</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="context">{'search_default_group_by_year': 1}</field>
        </record>

        <!-- Root menu: renamed to avoid collision with WFP app -->
        <menuitem id="menu_pb_workforce_root"
                  name="Demand Planning"
                  parent="om_hr_payroll.menu_hr_payroll_root"
                  sequence="45"
                  groups="pb_hr_payroll_demand.group_pb_workforce_user"/>

        <!-- Capability Catalog -->
        <menuitem id="menu_pb_workforce_catalog"
                  name="Capability Catalog"
                  parent="menu_pb_workforce_root"
                  sequence="10"
                  groups="pb_hr_payroll_demand.group_pb_workforce_user"/>

        <menuitem id="menu_pb_workforce_capabilities"
                  name="Capabilities"
                  parent="menu_pb_workforce_catalog"
                  action="action_pb_workforce_capability"
                  sequence="10"
                  groups="pb_hr_payroll_demand.group_pb_workforce_user"/>

        <!-- Roles -->
        <menuitem id="menu_pb_workforce_roles"
                  name="Roles"
                  parent="menu_pb_workforce_root"
                  action="action_pb_workforce_role"
                  sequence="20"
                  groups="pb_hr_payroll_demand.group_pb_workforce_user"/>

        <!-- Demand Planning -->
        <menuitem id="menu_pb_workforce_demand"
                  name="Demand Plans"
                  parent="menu_pb_workforce_root"
                  sequence="30"
                  groups="pb_hr_payroll_demand.group_pb_workforce_user"/>

        <menuitem id="menu_pb_workforce_demand_plans"
                  name="All Plans"
                  parent="menu_pb_workforce_demand"
                  action="action_pb_workforce_demand_plan"
                  sequence="10"
                  groups="pb_hr_payroll_demand.group_pb_workforce_user"/>
    </data>
</odoo>
