        <!-- Skills -->
        <record id="pb_workforce_skill_employee_relations" model="pb.workforce.skill">
            <field name="name">Employee Relations Strategy</field>
            <field name="category">business</field>
            <field name="description">Structured approach for coaching, investigations, and risk mitigation.</field>
        </record>
        <record id="pb_workforce_skill_change_enablement" model="pb.workforce.skill">
            <field name="name">Change Enablement</field>
            <field name="category">leadership</field>
            <field name="description">Supports adoption of new people processes and tooling.</field>
        </record>
        <record id="pb_workforce_skill_data_storytelling" model="pb.workforce.skill">
            <field name="name">Data Storytelling</field>
            <field name="category">digital</field>
            <field name="description">Translate workforce trends into business-ready insights.</field>
        </record>
        <record id="pb_workforce_skill_workforce_planning" model="pb.workforce.skill">
            <field name="name">Strategic Workforce Planning</field>
            <field name="category">business</field>
            <field name="description">Scenario modelling, demand translation, and portfolio prioritisation.</field>
        </record>
        <record id="pb_workforce_skill_compensation_design" model="pb.workforce.skill">
            <field name="name">Compensation Design</field>
            <field name="category">compliance</field>
            <field name="description">Design and audit reward frameworks for multi-country footprint.</field>
        </record>

