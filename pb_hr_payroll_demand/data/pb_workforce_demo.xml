        <record id="pb_workforce_capability_people_ops" model="pb.workforce.capability">
            <field name="name">People Operations Excellence</field>
            <field name="code">POX</field>
            <field name="capability_type">primary</field>
            <field name="maturity">developing</field>
            <field name="vision_statement">Deliver proactive people support across the organisation</field>
            <field name="last_review_date">2024-09-01</field>
            <field name="note">Focus on harmonising onboarding, lifecycle and policy compliance for hybrid workforce.</field>
            <field name="skill_ids" eval="[(6, 0, [ref('pb_workforce_skill_employee_relations'), ref('pb_workforce_skill_change_enablement')])]"/>
        </record>
        <record id="pb_workforce_capability_digital_hr" model="pb.workforce.capability">
            <field name="name">Digital HR Insights</field>
            <field name="code">DHI</field>
            <field name="capability_type">primary</field>
            <field name="maturity">emerging</field>
            <field name="vision_statement">Unlock data-driven workforce decisions with modern analytics</field>
            <field name="last_review_date">2024-10-15</field>
            <field name="note">Standing up dashboards, adoption support, and predictive analytics pilots.</field>
            <field name="skill_ids" eval="[(6, 0, [ref('pb_workforce_skill_data_storytelling'), ref('pb_workforce_skill_workforce_planning')])]"/>
        </record>
        <record id="pb_workforce_capability_total_rewards" model="pb.workforce.capability">
            <field name="name">Total Rewards &amp; Mobility</field>
            <field name="code">TRM</field>
            <field name="capability_type">secondary</field>
            <field name="maturity">mature</field>
            <field name="vision_statement">Competitive, equitable compensation experiences</field>
            <field name="last_review_date">2024-07-01</field>
            <field name="note">Maintain regional parity, support internal mobility and quarterly benchmarking.</field>
            <field name="skill_ids" eval="[(6, 0, [ref('pb_workforce_skill_compensation_design'), ref('pb_workforce_skill_workforce_planning')])]"/>
        </record>

