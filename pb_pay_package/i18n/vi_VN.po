#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "% a month"
msgstr "% một tháng"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"%(basic)s at %(basic_value)s and what the scheme adds to it already cost "
"%(now)s a month, more than %(month)s. Lower the share for basic pay."
msgstr "%(basic)s ở mức %(basic_value)s cùng những khoản chế độ tính thêm đã tốn %(now)s một tháng, nhiều hơn %(month)s. Hãy giảm tỷ lệ lương cơ bản."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"%(items)s is not kept on the contract in this pay scheme, so these figures "
"cannot be filled in from here."
msgstr "%(items)s không được lưu trên hợp đồng trong chế độ lương này, nên không thể điền các con số này từ đây."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"%(month)s a month cannot be reached exactly: the scheme's rounding jumps "
"over it. Closest: %(item)s %(v1)s gives %(n1)s; %(item)s %(v2)s gives "
"%(n2)s."
msgstr "Không thể đạt đúng %(month)s một tháng: cách làm tròn của chế độ nhảy qua con số này. Gần nhất: %(item)s %(v1)s cho %(n1)s; %(item)s %(v2)s cho %(n2)s."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "A fixed amount"
msgstr "Một số tiền cố định"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "A month"
msgstr "Một tháng"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"A total of %(year)s a year (%(month)s a month) needs %(item)s of %(value)s, "
"with %(basic)s at %(basic_value)s."
msgstr "Tổng %(year)s một năm (%(month)s một tháng) cần %(item)s là %(value)s, với %(basic)s ở mức %(basic_value)s."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "A year"
msgstr "Một năm"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Basic pay"
msgstr "Lương cơ bản"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"Basic pay and the item that takes the rest must be two different pay items."
msgstr "Lương cơ bản và khoản nhận phần còn lại phải là hai khoản lương khác nhau."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid "Basic pay is a share of the total from 1% to 100%."
msgstr "Lương cơ bản là một tỷ lệ của tổng, từ 1% đến 100%."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Build from a total"
msgstr "Lập từ tổng thu nhập"

#. module: pb_pay_package
#: model:ir.model,name:pb_pay_package.model_pb_pay_package
msgid "Build pay from a total package"
msgstr "Lập lương từ tổng gói thu nhập"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Choose a pay item…"
msgstr "Chọn một khoản lương…"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Close"
msgstr "Đóng"

#. module: pb_pay_package
#: model:ir.model.fields,field_description:pb_pay_package.field_pb_pay_package__display_name
msgid "Display Name"
msgstr ""

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid "Employee"
msgstr "Nhân viên"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Employer contributions"
msgstr "Phần doanh nghiệp đóng"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"Even with %(item)s at %(value)s the total is %(now)s a month, below "
"%(month)s."
msgstr "Ngay cả khi %(item)s là %(value)s, tổng chỉ là %(now)s một tháng, thấp hơn %(month)s."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Gross pay"
msgstr "Tổng thu nhập"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid ""
"Gross pay plus the employer's contributions, as the scheme works them out."
msgstr "Tổng thu nhập cộng phần doanh nghiệp đóng, theo cách chế độ lương tính."

#. module: pb_pay_package
#: model:ir.model.fields,field_description:pb_pay_package.field_pb_pay_package__id
msgid "ID"
msgstr ""

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "New"
msgstr "Mới"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"No pay scheme pays this person yet, so there is nothing to build the total "
"with. Put their team on a pay scheme first."
msgstr "Chưa có chế độ lương nào trả lương cho người này, nên chưa có gì để lập tổng. Hãy gắn nhóm của họ vào một chế độ lương trước."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Nothing is saved. This only works the figures out."
msgstr "Không có gì được lưu. Đây chỉ là phép tính."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Now"
msgstr "Hiện tại"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Only what changed"
msgstr "Chỉ phần thay đổi"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Pay item"
msgstr "Khoản lương"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Pay scheme"
msgstr "Chế độ lương"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid "Pick the pay item that is basic pay."
msgstr "Chọn khoản lương là lương cơ bản."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid "Pick the pay item that takes the rest."
msgstr "Chọn khoản lương nhận phần còn lại."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Reading this person's pay…"
msgstr "Đang đọc lương của người này…"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Share of the total"
msgstr "Tỷ lệ của tổng"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Show every line"
msgstr "Hiện mọi dòng"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid "Stopped after %(n)s tries without settling on a figure."
msgstr "Đã dừng sau %(n)s lần thử mà chưa ra con số."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Take-home"
msgstr "Thực nhận"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Takes the rest"
msgstr "Nhận phần còn lại"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "The payslip at these figures"
msgstr "Phiếu lương với các con số này"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"The total cannot be worked out: the formula for “%(name)s” has an error at "
"%(value)s (%(why)s). Fix it in Formula Studio first."
msgstr "Không tính được tổng: công thức “%(name)s” bị lỗi ở %(value)s (%(why)s). Hãy sửa trong Formula Studio trước."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"The total cannot be worked out: the formula for “%(name)s” has an error for "
"this person (%(why)s). Fix it in Formula Studio first."
msgstr "Không tính được tổng: công thức “%(name)s” bị lỗi với người này (%(why)s). Hãy sửa trong Formula Studio trước."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"The total does not change when %(item)s changes, so it cannot take the rest."
" Pick another pay item."
msgstr "Tổng không đổi khi %(item)s thay đổi, nên khoản này không nhận được phần còn lại. Hãy chọn khoản khác."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"The total goes down when %(item)s goes up, so it cannot take the rest. Pick "
"a pay item that adds to pay."
msgstr "Tổng giảm khi %(item)s tăng, nên khoản này không nhận được phần còn lại. Hãy chọn khoản cộng vào lương."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid ""
"They go into the contract form. Nothing is saved until you press Save there,"
" and the change then goes for approval like any other pay change."
msgstr "Các con số được đưa vào hợp đồng. Chưa có gì được lưu cho tới khi bạn bấm Lưu ở đó, rồi thay đổi được gửi duyệt như mọi thay đổi lương khác."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/js/build_total.js:0
msgid "This could not be worked out just now. Try again in a moment."
msgstr "Chưa tính được lúc này. Hãy thử lại sau giây lát."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"This pay scheme does not have the pay items a total can be split into (it "
"needs at least a basic pay and one item that takes the rest)."
msgstr "Chế độ lương này không có đủ khoản lương để chia tổng (cần ít nhất lương cơ bản và một khoản nhận phần còn lại)."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"This pay scheme has no gross pay line, so a total package cannot be worked "
"out on it."
msgstr "Chế độ lương này không có dòng tổng thu nhập, nên không tính được tổng gói."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"This scheme does not give a total that is a number for this person, so "
"nothing can be worked out."
msgstr "Chế độ này không cho ra tổng là một con số với người này, nên không tính được."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Total"
msgstr "Tổng"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Total a month"
msgstr "Tổng một tháng"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Total package"
msgstr "Tổng gói thu nhập"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid ""
"Type a total, then work it out. Every pay item the scheme works out from "
"basic pay follows by itself."
msgstr "Nhập một tổng rồi bấm tính. Mọi khoản chế độ tính từ lương cơ bản sẽ tự theo."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid "Type basic pay as an amount above zero."
msgstr "Nhập lương cơ bản là số lớn hơn 0."

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid "Type the total package, as an amount above zero."
msgstr "Nhập tổng gói thu nhập là số lớn hơn 0."

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Use these figures"
msgstr "Dùng các con số này"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Work it out"
msgstr "Tính"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "Worked out in"
msgstr "Đã tính trong"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/js/build_total.js:0
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "a month"
msgstr "một tháng"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "a month ·"
msgstr "một tháng ·"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/js/build_total.js:0
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "a year"
msgstr "một năm"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "tries"
msgstr "lần thử"

#. module: pb_pay_package
#. odoo-javascript
#: code:addons/pb_pay_package/static/src/xml/build_total.xml:0
msgid "was"
msgstr "trước đây"

#. module: pb_pay_package
#. odoo-python
#: code:addons/pb_pay_package/models/package.py:0
msgid ""
"“%(names)s” already adds gross pay, so it is a total of its own and is not "
"counted again."
msgstr "“%(names)s” đã cộng cả tổng thu nhập, nên đó là một dòng tổng riêng và không tính lại."
