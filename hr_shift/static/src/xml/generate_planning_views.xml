<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Generate Planning button -->
    <t t-name="ShiftPlanning.generate_planning_button">
        <button type="button" class="btn btn-secondary o_button_generate_planning">
            Generate Planning
        </button>
    </t>

    <!-- List View buttons for Shift Planning (standalone template) -->
    <t t-name="ShiftPlanningtListView.buttons">
        <div class="o_list_buttons d-flex gap-1 d-empty-none" role="toolbar" aria-label="Main actions">
            <button type="button" class="btn btn-primary o_list_button_add" accesskey="c">New</button>
            <t t-call="ShiftPlanning.generate_planning_button"/>
        </div>
    </t>

    <!-- Kanban View buttons for Shift Planning (standalone template) -->
    <t t-name="ShiftPlanningtKanbanView.buttons">
        <div class="o_kanban_buttons d-flex gap-1 d-empty-none" role="toolbar" aria-label="Main actions">
            <button type="button" class="btn btn-primary o-kanban-button-new" accesskey="c">New</button>
            <t t-call="ShiftPlanning.generate_planning_button"/>
        </div>
    </t>
</templates>
