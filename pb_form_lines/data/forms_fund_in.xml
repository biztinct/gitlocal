    <record id="form_in_esi" model="pb.gov.form">
        <field name="code">IN_ESI</field>
        <field name="country_code">IN</field>
        <field name="sequence">31</field>
        <field name="name">ESI monthly contribution sheet (ESIC)</field>
        <field name="official_name">ESIC — Monthly Contribution (MC) upload</field>
        <field name="authority">ESIC</field>
        <field name="period_kind">month</field>
        <field name="quarter_allowed" eval="False"/>
        <field name="output_kinds">xlsx</field>
        <field name="total_line_code">TOTAL</field>
        <field name="filing_section">fund</field>
        <field name="tile_group">fund_file</field>
        <field name="adviser_wording">fund</field>
        <field name="employer_label">ESIC employer code</field>
        <field name="compare_line_codes">ESI_EE,ESI_ER</field>
        <field name="source_url">https://www.esic.gov.in/</field>
        <field name="source_note">ESIC employer portal, "Monthly Contribution" upload: the MC Excel template is downloaded on the portal after login. Columns: IP number (10 digits), IP name, days for which wages were paid, total monthly wages, reason code for zero working days, last working day (DD/MM/YYYY), as described in published guides (treelife.in, "ESI Returns and Challan Filing"; docs.pockethrms.com, "ESI Return File"). Read on 18 November 2026.</field>
        <field name="inferred" eval="True"/>
        <field name="inferred_note">The ESIC template is not published: the column heads are written as the portal's template is described in published guides. Days are whole days (a part day counts as a day). The reason code for zero working days and the last working day are left for the portal.</field>
    </record>
