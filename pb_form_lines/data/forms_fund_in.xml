    <record id="form_in_epf_ecr" model="pb.gov.form">
        <field name="code">IN_EPF_ECR</field>
        <field name="country_code">IN</field>
        <field name="sequence">30</field>
        <field name="name">Provident fund monthly return — ECR file (EPFO)</field>
        <field name="official_name">Electronic Challan cum Return (ECR 2.0)</field>
        <field name="authority">EPFO</field>
        <field name="period_kind">month</field>
        <field name="quarter_allowed" eval="False"/>
        <field name="output_kinds">txt,xlsx</field>
        <field name="total_line_code">TOTAL</field>
        <field name="filing_section">fund</field>
        <field name="tile_group">fund_file</field>
        <field name="adviser_wording">fund</field>
        <field name="employer_label">EPFO establishment code</field>
        <field name="compare_line_codes">EPF_EE,EPS_ER,DIFF_ER</field>
        <field name="source_url">https://www.epfindia.gov.in/site_docs/PDFs/EPFOUnifiedPortal/Introduction_ECR2.0.pdf</field>
        <field name="source_note">EPFO, "Introduction ECR 2.0" (EPFO Unified Portal) — the ECR text file: one line per member, no header line, 11 fields separated by #~#: UAN, member name, gross wages, EPF wages, EPS wages, EDLI wages, EPF contribution remitted, EPS contribution remitted, EPF-EPS difference remitted, NCP days, refund of advances; whole rupees. The EPFO page answered 403 from here; the same layout is published by laabam.one ("How to File PF Return (ECR 2.0)") and fundraksha.com ("PF ECR Format Explained"). Read on 18 November 2026.</field>
        <field name="inferred" eval="True"/>
        <field name="inferred_note">EPFO's own document could not be opened (403), so the field list, its order and the whole-rupee rule come from published guides that all agree. Rounding is half up to the rupee. The adviser note is on the summary workbook, not in the text file (the file has no place for a note).</field>
    </record>
