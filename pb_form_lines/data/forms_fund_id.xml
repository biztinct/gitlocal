<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- WDGAP S2-B2 — Indonesia: the two BPJS monthly sheets. See pb_form_lines/models/fund_id.py. -->

    <record id="form_id_bpjs_tk" model="pb.gov.form">
        <field name="code">ID_BPJS_TK</field>
        <field name="country_code">ID</field>
        <field name="sequence">30</field>
        <field name="name">BPJS Ketenagakerjaan — monthly wage report (SIPP)</field>
        <field name="official_name">SIPP BPJS Ketenagakerjaan — Upload Upah tenaga kerja</field>
        <field name="authority">BPJS Ketenagakerjaan</field>
        <field name="period_kind">month</field>
        <field name="quarter_allowed" eval="False"/>
        <field name="output_kinds">xlsx</field>
        <field name="total_line_code">TOTAL</field>
        <field name="filing_section">fund</field>
        <field name="tile_group">fund_file</field>
        <field name="adviser_wording">fund</field>
        <field name="employer_label">BPJS Ketenagakerjaan company number (NPP)</field>
        <field name="compare_line_codes">JHT_EE,JHT_ER,JKK_ER,JKM_ER,JP_EE,JP_ER</field>
        <field name="source_url">https://sipp.bpjsketenagakerjaan.go.id/</field>
        <field name="source_note">BPJS Ketenagakerjaan, SIPP (Sistem Informasi Pelaporan Peserta), menu Mutasi Data, "Upload Upah": the Excel template is downloaded inside SIPP after login and is not published. Columns as listed in the published SIPP guide by Gadjian (gadjian.com, "5 Fitur SIPP BPJS Ketenagakerjaan untuk Pelaporan Data Online", 24 August 2022): NIK, KPJ number, full name, date of birth, wage, month. Read on 18 November 2026.</field>
        <field name="inferred" eval="True"/>
        <field name="inferred_note">The SIPP template itself is not published: the column order, the sheet name and the date format are taken from a published guide. Check them against the template you download from SIPP before the first upload. The contributions are not columns of the upload (SIPP works them out from the wage); they are on the summary for checking.</field>
    </record>
    <record id="form_id_bpjs_tk_wage" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpjs_tk"/>
        <field name="code">WAGE</field>
        <field name="sequence">10</field>
        <field name="kind">money</field>
        <field name="scope">employee</field>
        <field name="label">Wage reported to BPJS</field>
        <field name="official_label">Upah</field>
        <field name="required" eval="True"/>
        <field name="suggest_words">upah bpjs,dasar upah bpjs,dasar bpjs,gaji bpjs,upah tk,bpjs wage,bpjs base,bpjs tk wage</field>
        <field name="suggest_roles">earning,info</field>
        <field name="inferred" eval="True"/>
    </record>
    <record id="form_id_bpjs_tk_jht_ee" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpjs_tk"/>
