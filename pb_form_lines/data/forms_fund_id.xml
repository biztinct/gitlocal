        <field name="sequence">20</field>
        <field name="kind">money</field>
        <field name="scope">employee</field>
        <field name="label">Old-age savings (JHT) — employee</field>
        <field name="official_label">Iuran JHT tenaga kerja (2%)</field>
        <field name="required" eval="True"/>
        <field name="suggest_words">jht,jaminan hari tua,old age</field>
        <field name="suggest_roles">deduction</field>
        <field name="suggest_parts" eval="True"/>
        <field name="inferred" eval="True"/>
    </record>
    <record id="form_id_bpjs_tk_jht_er" model="pb.gov.form.line">
