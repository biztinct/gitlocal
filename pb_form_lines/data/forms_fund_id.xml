    <record id="form_id_bpjs_kes" model="pb.gov.form">
        <field name="code">ID_BPJS_KES</field>
        <field name="country_code">ID</field>
        <field name="sequence">31</field>
        <field name="name">BPJS Kesehatan — monthly member and contribution sheet (e-Dabu)</field>
        <field name="official_name">e-Dabu BPJS Kesehatan — Data peserta dan iuran</field>
        <field name="authority">BPJS Kesehatan</field>
        <field name="period_kind">month</field>
        <field name="quarter_allowed" eval="False"/>
        <field name="output_kinds">xlsx</field>
        <field name="total_line_code">TOTAL</field>
        <field name="filing_section">fund</field>
        <field name="tile_group">fund_file</field>
        <field name="adviser_wording">fund</field>
        <field name="employer_label">BPJS Kesehatan company code</field>
        <field name="compare_line_codes">KES_EE,KES_ER</field>
        <field name="source_url">https://edabu.bpjs-kesehatan.go.id/</field>
        <field name="source_note">BPJS Kesehatan, e-Dabu (Elektronik Data Badan Usaha): the member and contribution data of a company are kept in e-Dabu after login; the upload template is not published. Columns follow what e-Dabu asks for (NIK, card number, name, date of birth, wage, employee 1% and employer 4% contribution) as described in published guides (detik.com, "Edabu BPJS Kesehatan", 2021). Read on 18 November 2026.</field>
        <field name="inferred" eval="True"/>
        <field name="inferred_note">The e-Dabu template is not published: every column of this sheet is taken from published guides. Check it against what e-Dabu shows before the first upload.</field>
    </record>
