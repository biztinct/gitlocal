<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- WDGAP S2-B2 — Singapore: CPF EZPay file. See pb_form_lines/models/fund_sg.py. -->

    <record id="form_sg_cpf_ezpay" model="pb.gov.form">
        <field name="code">SG_CPF_EZPAY</field>
        <field name="country_code">SG</field>
        <field name="sequence">30</field>
        <field name="name">CPF contributions, SDL and self-help funds — CPF EZPay file</field>
        <field name="official_name">CPF EZPay (FTP) — payment advice</field>
        <field name="authority">CPF Board</field>
        <field name="period_kind">month</field>
        <field name="quarter_allowed" eval="False"/>
        <field name="output_kinds">dtl,xlsx</field>
        <field name="total_line_code">TOTAL</field>
        <field name="filing_section">fund</field>
        <field name="tile_group">fund_file</field>
        <field name="adviser_wording">fund</field>
        <field name="employer_label">CPF submission number (CSN), for example 201912345APTE01</field>
        <field name="compare_line_codes">CPF_EE,CPF_ER,SDL,MBMF,SINDA,CDAC,ECF</field>
        <field name="source_url">https://www.cpf.gov.sg/content/dam/web/employer/making-cpf-contributions/documents/CPFEZPayFTPSpecifications.pdf</field>
        <field name="source_note">CPF Board, "CPF EZPay (FTP) File Specifications (effective from 16 January 2025)", FTPSPEC/FILESPEC, last updated January 2025: fixed length 150-byte records — employer header, contribution summary (payment codes 01 CPF, 02 MBMF, 03 SINDA, 04 CDAC, 05 ECF, 10 Community Chest, 11 SDL), contribution detail per person, employer trailer; file name &lt;CSN&gt;&lt;Month Paid&gt;&lt;Advice Code&gt;.DTL. Read on 18 November 2026.</field>
        <field name="inferred" eval="True"/>
        <field name="inferred_note">The record layout is the published one. Not stated by the specification and chosen here: records end with CR LF; "Month Paid" in the file name is the contribution month; advice code 01; employment status (existing, joiner, leaver) from the person's contracts; the CPF amount is the employee and employer CPF as the payslips carry it (the scheme keeps the rounding rules). The adviser note is on the summary workbook, not in the file.</field>
    </record>
