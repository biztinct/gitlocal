<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- WDGAP S2-B — Singapore: Form IR8A for the Auto-Inclusion Scheme (the AIS-API 2.0
         submission payload, the myTax Portal import workbook, a summary and a per-person
         IR8A). Line codes are the form's item letters. Generated from the tables in
         WDGAP_S2B1_REPORT.md; see pb_form_lines/models/render_sg.py. -->

    <record id="form_sg_ir8a" model="pb.gov.form">
        <field name="code">SG_IR8A</field>
        <field name="country_code">SG</field>
        <field name="sequence">140</field>
        <field name="tile_group">year_end</field>
        <field name="year_start_month">1</field>
        <field name="name">Employee income for the year — Form IR8A (Auto-Inclusion Scheme)</field>
        <field name="official_name">Form IR8A — Return of Employee's Remuneration (AIS)</field>
        <field name="authority">IRAS</field>
        <field name="period_kind">tax_year</field>
        <field name="output_kinds">json,xlsx,pdf</field>
        <field name="total_line_code">TOTAL</field>
        <field name="screen_note">The submission payload for AIS software, the IR8A import workbook for the myTax Portal, a summary, and an IR8A for each person.</field>
        <field name="source_url">https://www.iras.gov.sg/taxes/individual-income-tax/employers/auto-inclusion-scheme-(ais)-for-employment-income/technical-format-specifications</field>
        <field name="source_note">IRAS, "AIS-API 2.0" interface specification v2.6 (11 September 2026, https://file.go.gov.sg/aisapi2-specs.pdf) and "Data Items and Validation Rules" v2.5 (30 January 2026, https://go.gov.sg/aisapi2-dataitems) for the submission payload; IRAS "IR8A Import Template" version 1.0 (https://go.gov.sg/ir8a-import-template) for the myTax Portal upload; Form IR8A for YA 2027 and its explanatory notes for the item letters. The older fixed-length text and XML files are no longer accepted by IRAS. Read on 18 November 2026.</field>
        <field name="inferred_note">softwareCompanyName (the payroll software's APEX organisation name) is left empty for the person who sends the file to fill in. The authorised person is the person who prepared the filing. Commencement and cessation dates come from the employment contracts. Appendix 8A (benefits in kind) and Appendix 8B (share gains) are not made: when such items are on the form the check step says so. The import workbook repeats the official template's sheet and columns but is not the template file itself.</field>
        <field name="employee_certificates" eval="True"/>
        <field name="inferred" eval="True"/>
    </record>
    <record id="form_sg_ir8a_la" model="pb.gov.form.line">
        <field name="form_id" ref="form_sg_ir8a"/>
