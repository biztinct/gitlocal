        <field name="kind">money</field>
        <field name="label">Gross salary, fees, leave pay, wages and overtime pay</field>
        <field name="official_label">a) Gross Salary</field>
        <field name="required" eval="True"/>
        <field name="suggest_words">basic salary,salary,wages,overtime,gross salary</field>
        <field name="suggest_roles">earning</field>
    </record>
