<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- WDGAP S2-B — Indonesia: year-end income-tax slip for permanent
         employees (BPA1, form 1721-A1), the bulk import of the tax office's
         system, and one PDF per person. Layout from the tax office's own
         published converter and template; see
         pb_form_lines/models/render_id_bpa1.py. Line codes are the slip's own
         line numbers. -->
    <record id="form_id_bpa1" model="pb.gov.form">
        <field name="code">ID_BPA1</field>
        <field name="country_code">ID</field>
        <field name="sequence">110</field>
        <field name="tile_group">year_end</field>
        <field name="year_start_month">1</field>
        <field name="employee_certificates" eval="True"/>
        <field name="name">Year-end income tax slips — permanent employees (BPA1)</field>
        <field name="official_name">Bukti Pemotongan PPh Pasal 21 bagi Pegawai Tetap atau Pensiunan (BPA1) — Formulir 1721-A1</field>
        <field name="authority">Tax office (DJP)</field>
        <field name="period_kind">tax_year</field>
        <field name="output_kinds">xml,xlsx,pdf</field>
        <field name="total_line_code">22</field>
        <field name="screen_note">One slip per person for the tax year: the tax office's import file, a summary, and a certificate for each person that a payroll manager can release to employees.</field>
        <field name="source_url">https://www.pajak.go.id/reformdjp/coretax/template-xml-dan-converter-excel-ke-xml</field>
        <field name="source_note">Direktorat Jenderal Pajak, "Template XML dan Converter Excel ke XML" (Coretax), row BPA1: "BPA1 Excel to XML.xlsx" (dated 7 November 2024; https://pajak.go.id/sites/default/files/2024-12/BPA1%20Excel%20to%20XML.xlsx) with its XML map A1Bulk, and the XML template "bpa1.zip" (7 November 2024). Line words from the tax office's Coretax guide "Pembuatan Bukti Pemotongan PPh Pasal 21 Tahunan A1" (version 20251223). Read on 18 November 2026.</field>
        <field name="inferred" eval="False"/>
        <field name="inferred_note">A person paid from January to December is a full year, anyone else part of the year (the "annualised" choice for a foreigner who leaves is never made). Gross-up "No", tax facility "N/A", tax object code 21-100-01. The withholding date is the last day the person was paid for. Tax status K/I is not in the import file's list: such a person is left out with the reason.</field>
    </record>

    <record id="form_id_bpa1_l1" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">1</field>
        <field name="sequence">10</field>
        <field name="kind">money</field>
        <field name="label">Salary or regular pension</field>
        <field name="official_label">Gaji atau uang pensiun berkala</field>
        <field name="required" eval="True"/>
        <field name="suggest_words">gaji pokok,gaji,basic salary,salary,upah pokok,pensiun berkala</field>
        <field name="suggest_roles">earning</field>
    </record>
    <record id="form_id_bpa1_l2" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">2</field>
        <field name="sequence">20</field>
        <field name="kind">money</field>
        <field name="label">Tax allowance</field>
        <field name="official_label">Tunjangan PPh</field>
        <field name="suggest_words">tunjangan pph,tunjangan pajak,tax allowance</field>
        <field name="suggest_roles">earning</field>
    </record>
    <record id="form_id_bpa1_l3" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">3</field>
        <field name="sequence">30</field>
        <field name="kind">money</field>
        <field name="label">Other allowances, overtime and the like</field>
        <field name="official_label">Tunjangan lainnya, uang lembur dan sebagainya</field>
        <field name="suggest_words">tunjangan,lembur,overtime,allowance</field>
        <field name="suggest_roles">earning</field>
    </record>
    <record id="form_id_bpa1_l4" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">4</field>
        <field name="sequence">40</field>
        <field name="kind">money</field>
        <field name="label">Honorarium and similar payments</field>
        <field name="official_label">Honorarium dan imbalan lain sejenisnya</field>
        <field name="suggest_words">honorarium,imbalan</field>
        <field name="suggest_roles">earning</field>
    </record>
    <record id="form_id_bpa1_l5" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">5</field>
        <field name="sequence">50</field>
        <field name="kind">money</field>
        <field name="label">Insurance premiums paid by the employer</field>
        <field name="official_label">Premi asuransi yang dibayar pemberi kerja</field>
        <field name="suggest_words">premi asuransi,asuransi perusahaan,jkk,jkm,bpjs kesehatan perusahaan,employer insurance</field>
        <field name="suggest_roles">employer_cost,earning,info</field>
    </record>
    <record id="form_id_bpa1_l6" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">6</field>
        <field name="sequence">60</field>
        <field name="kind">money</field>
        <field name="label">Benefits in kind taxed through pay</field>
        <field name="official_label">Penerimaan dalam bentuk natura dan kenikmatan lainnya yang dikenakan pemotongan PPh Pasal 21</field>
        <field name="suggest_words">natura,kenikmatan,benefit in kind</field>
        <field name="suggest_roles">earning,info</field>
    </record>
    <record id="form_id_bpa1_l7" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">7</field>
        <field name="sequence">70</field>
        <field name="kind">money</field>
        <field name="label">Bonus, holiday allowance (THR) and similar</field>
        <field name="official_label">Tantiem, bonus, gratifikasi, jasa produksi dan THR</field>
        <field name="suggest_words">thr,bonus,tantiem,gratifikasi,jasa produksi</field>
        <field name="suggest_roles">earning</field>
    </record>
    <record id="form_id_bpa1_l8" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">8</field>
        <field name="sequence">80</field>
        <field name="kind">computed</field>
        <field name="compute_op">sum</field>
        <field name="operand_codes">1,2,3,4,5,6,7</field>
        <field name="label">Gross income (1 to 7)</field>
        <field name="official_label">Jumlah penghasilan bruto (1 s.d. 7)</field>
    </record>
    <record id="form_id_bpa1_l10" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">10</field>
        <field name="sequence">100</field>
        <field name="kind">money</field>
        <field name="label">Pension and old-age contributions paid by the employee</field>
        <field name="official_label">Iuran terkait pensiun atau hari tua</field>
        <field name="suggest_words">jht karyawan,jp karyawan,iuran pensiun,jht,jaminan pensiun,pension contribution</field>
        <field name="suggest_roles">deduction</field>
    </record>
    <record id="form_id_bpa1_l11" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">11</field>
        <field name="sequence">110</field>
        <field name="kind">money</field>
        <field name="label">Zakat or required religious gifts paid through the employer</field>
        <field name="official_label">Zakat/sumbangan keagamaan yang bersifat wajib yang dibayarkan melalui pemberi kerja</field>
        <field name="suggest_words">zakat,sumbangan keagamaan</field>
        <field name="suggest_roles">deduction</field>
    </record>
    <record id="form_id_bpa1_l22" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">22</field>
        <field name="sequence">220</field>
        <field name="kind">money</field>
        <field name="label">Income tax withheld in the year (PPh 21)</field>
        <field name="official_label">PPh Pasal 21 yang telah dipotong</field>
        <field name="required" eval="True"/>
        <field name="note">For the summary and the person's certificate. The import file carries 0 here: the tax office's system adds up the monthly slips itself.</field>
        <field name="suggest_words">pph 21,pph21,pph pasal 21,pajak penghasilan,income tax</field>
        <field name="suggest_roles">deduction</field>
    </record>
    <record id="form_id_bpa1_ptkp" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">PTKP</field>
        <field name="sequence">300</field>
        <field name="kind">text</field>
        <field name="label">Tax status (TK / K / HB)</field>
        <field name="official_label">Status PTKP</field>
        <field name="note">Read from the pay item put here; when none, from the employee record.</field>
        <field name="suggest_words">status ptkp,ptkp,tax status,status pajak</field>
    </record>
    <record id="form_id_bpa1_people" model="pb.gov.form.line">
        <field name="form_id" ref="form_id_bpa1"/>
        <field name="code">PEOPLE</field>
        <field name="sequence">310</field>
        <field name="kind">count</field>
        <field name="scope">total</field>
        <field name="mappable" eval="False"/>
        <field name="label">People</field>
        <field name="official_label">Jumlah pegawai</field>
    </record>
</odoo>
