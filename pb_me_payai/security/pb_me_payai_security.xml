<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company rules: HR of one company never reads another company's
         policies or question counts. Employees hold no access at all; their
         page reads under sudo after the session check. -->
    <record id="rule_policy_document_company" model="ir.rule">
        <field name="name">Policy files: own companies</field>
        <field name="model_id" ref="model_pb_policy_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_policy_section_company" model="ir.rule">
        <field name="name">Policy sections: own companies</field>
        <field name="model_id" ref="model_pb_policy_section"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_policy_question_company" model="ir.rule">
        <field name="name">Policy questions: own companies</field>
        <field name="model_id" ref="model_pb_policy_question"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
