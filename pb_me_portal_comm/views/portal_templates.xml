<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- TIERS T3b — the notice board on My Payobook. The pages reuse
       pb_me_portal's .pbme kit (tokens, buttons, empty state, ess_icon);
       `.pbnb-*` is this module's thin layer (static/src/scss/notices.scss).
       Every word a person sees is here; the controller and the facade pass
       facts only. The body of a notice is pb_hr_comm's own Html field value,
       already sanitized when HR saved it — nothing else is printed raw. -->

  <!-- ============================================================= -->
  <!--  Breadcrumbs                                                   -->
  <!-- ============================================================= -->
  <template id="portal_breadcrumbs_notices" name="Notices breadcrumbs"
            inherit_id="portal.portal_breadcrumbs" priority="38">
    <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
      <li t-if="page_name == 'notices'" class="breadcrumb-item active">Notices</li>
      <li t-if="page_name == 'notice'" class="breadcrumb-item"><a href="/my/notices">Notices</a></li>
      <li t-if="page_name == 'notice' and notice" class="breadcrumb-item active" t-out="notice['subject']"/>
    </xpath>
  </template>

  <!-- ============================================================= -->
  <!--  The tile on the employee home                                 -->
  <!-- ============================================================= -->
  <!-- Always drawn for an employee (config_card): the board says what will
       appear when it is empty. The count is the unread notices.
       pb_me_portal's registry (`/my/notices`) gives it the People section
       and its badge. -->
  <template id="portal_my_home_notices" name="Notices home tile"
            inherit_id="portal.portal_my_home" customize_show="True" priority="26">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
      <t t-if="pbme_home" t-call="portal.portal_docs_entry">
        <t t-set="title">Notices</t>
        <t t-set="text">What the company announced</t>
        <t t-set="url" t-value="'/my/notices'"/>
        <t t-set="config_card" t-value="True"/>
        <t t-set="placeholder_count" t-value="'notice_count'"/>
      </t>
    </xpath>
  </template>

  <!-- ============================================================= -->
  <!--  Small parts                                                   -->
  <!-- ============================================================= -->
  <!-- "2 h ago" from the facade's {unit, n, date}. -->
  <template id="pbnb_ago" name="Notices: how long ago">
    <t t-if="ago['unit'] == 'now'">just now</t>
    <t t-elif="ago['unit'] == 'min'"><t t-out="ago['n']"/> min ago</t>
    <t t-elif="ago['unit'] == 'h'"><t t-out="ago['n']"/> h ago</t>
    <t t-elif="ago['unit'] == 'd' and ago['n'] == 1">yesterday</t>
    <t t-elif="ago['unit'] == 'd'"><t t-out="ago['n']"/> d ago</t>
    <t t-else="" t-out="ago['date']" t-options="{'widget': 'date', 'format': 'd MMM'}"/>
  </template>

  <!-- ============================================================= -->
  <!--  The "Notices" card on the home (pb_me_portal's extra cards)   -->
  <!-- ============================================================= -->
  <!-- Full width under Needs you: the latest three side by side (a poster
       thumbnail when there is one), an unread dot on what is new, the door
       to the board. Empty, it says what will appear. `card` is in scope
       (pbme_bento's loop). -->
  <template id="pbme_card_notices" name="Employee home: announcement feed">
    <t t-set="nb" t-value="card['data']"/>
    <section class="pbme-b-extra pbme-b-notices" data-pbme-slot="notices" aria-labelledby="pbme-notices-h">
      <header class="pbnb-feed-heading">
        <div><span class="pbme-eyebrow">Together at work</span><h2 id="pbme-notices-h">Company feed <span t-if="nb['unread']" class="pbnb-new"><t t-out="nb['unread']"/> new</span></h2><p>Announcements, conversations and the moments that connect us.</p></div>
        <a class="pbme-btn pbme-btn--ghost" t-att-href="nb['url']">All notices</a>
      </header>
      <div class="pbnb-feed-guide"><span class="pbnb-avatar" aria-hidden="true">✦</span><div><b>Your company, in the loop</b><span>Read the latest updates, add a comment or show your support.</span></div></div>
      <div t-if="nb['rows']" class="pbnb-feed">
        <t t-foreach="nb['rows']" t-as="r"><t t-call="pb_me_portal_comm.feed_post"/></t>
      </div>
      <div t-else="" class="pbnb-feed-empty">
        <span class="pbnb-empty-mark" aria-hidden="true">✦</span>
        <h3>A place to stay connected</h3>
        <p>Company announcements will appear here when they are shared with you. Join the conversation with likes and comments.</p>
        <div class="pbnb-topics"><span>Company news</span><span>Team celebrations</span><span>Events and reminders</span></div>
        <a class="pbme-btn pbme-btn--ghost" href="/my/notices">Open notice board</a>
      </div>
    </section>
  </template>

  <template id="feed_post" name="Announcement feed post">
    <article class="pbnb-feed-post" t-att-id="'notice-%s' % r['post_id']">
      <header><span class="pbnb-avatar" aria-hidden="true" t-out="(r['author'] or r['company'])[:1]"/><div><b t-out="r['author']"/><span><t t-out="r['company']"/> · <t t-if="r['ago']" t-call="pb_me_portal_comm.pbnb_ago"><t t-set="ago" t-value="r['ago']"/></t></span></div><span class="pbnb-post-tag">Announcement</span></header>
      <div class="pbnb-feed-content"><h3><a t-att-href="r['url']" t-out="r['subject']"/></h3><p t-out="r['excerpt']"/><a t-att-href="r['url']" class="pbme-lab-link">Read full announcement <span t-if="not r['read']" class="pbnb-dot" aria-label="Unread"/></a></div>
      <a t-if="r['poster_url']" t-att-href="r['url']" class="pbnb-feed-media"><img t-att-src="r['poster_url']" t-att-alt="r['subject']" loading="lazy"/></a>
      <t t-call="pb_me_portal_comm.social_thread"><t t-set="return_home" t-value="True"/></t>
    </article>
  </template>

  <template id="social_thread" name="Announcement reactions and comments">
    <div class="pbnb-social">
      <div class="pbnb-social-counts"><span><t t-out="r['like_count']"/> likes</span><a t-att-href="r['url'] + '#comments'" ><t t-out="r['comment_count']"/> comments</a></div>
      <div class="pbnb-social-actions">
        <form method="post" t-att-action="r['url'] + '/interact'">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <input type="hidden" name="return_home" t-att-value="'1' if return_home else ''"/>
          <input type="hidden" name="action" t-att-value="'unlike' if r['liked'] else 'like'"/>
          <button type="submit" t-att-class="'pbnb-action is-liked' if r['liked'] else 'pbnb-action'" t-att-aria-pressed="'true' if r['liked'] else 'false'"><span aria-hidden="true">♡</span> <t t-if="r['liked']">Liked</t><t t-else="">Like</t></button>
        </form>
        <a class="pbnb-action" t-att-href="'#comment-input-%s' % r['post_id']">Comment</a>
      </div>
      <p class="pbnb-audience-note">Comments are visible to people who received this announcement.</p>
      <ol t-if="r['comments']" class="pbnb-comments">
        <li t-foreach="r['comments']" t-as="comment">
          <span class="pbnb-avatar pbnb-avatar--small" aria-hidden="true" t-out="comment['author'][:1]"/>
          <div class="pbnb-comment"><b t-out="comment['author']"/><p t-out="comment['body']"/><div class="pbnb-comment-meta"><span><t t-call="pb_me_portal_comm.pbnb_ago"><t t-set="ago" t-value="comment['ago']"/></t></span>
            <form t-if="comment['can_remove']" method="post" t-att-action="r['url'] + '/interact'">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="remove_comment"/><input type="hidden" name="comment_id" t-att-value="comment['id']"/><input type="hidden" name="return_home" t-att-value="'1' if return_home else ''"/>
              <button class="pbnb-remove" type="submit" aria-label="Remove comment">Remove</button>
            </form>
          </div></div>
        </li>
      </ol>
      <a t-if="r.get('comments_more_url') or (return_home and r['comment_count'] &gt; len(r['comments']))" class="pbme-lab-link" t-att-href="r.get('comments_more_url') or (r['url'] + '#comments')">View more comments</a>
      <form class="pbnb-composer" method="post" t-att-action="r['url'] + '/interact'">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="comment"/><input type="hidden" name="return_home" t-att-value="'1' if return_home else ''"/>
        <label class="visually-hidden" t-att-for="'comment-input-%s' % r['post_id']">Write a comment</label>
        <textarea t-att-id="'comment-input-%s' % r['post_id']" name="body" rows="2" maxlength="2000" required="required" placeholder="Add to the conversation…"/>
        <button class="pbme-btn pbme-btn--primary" type="submit">Post comment</button>
      </form>
    </div>
  </template>

  <template id="portal_notice_action_error" name="Announcement action error">
    <t t-call="portal.portal_layout"><div class="pbme pbnb"><div class="pbme-empty"><h2>Comment could not be saved</h2><p role="alert" t-out="error"/><a class="pbme-btn pbme-btn--ghost" t-att-href="'/my/notices/%s' % post_id">Back to announcement</a></div></div></t>
  </template>

  <!-- ============================================================= -->
  <!--  The board                                                     -->
  <!-- ============================================================= -->
  <!-- The newest notice is a full-width card with its poster; the rest are
       a quiet list, newest first, an unread dot on each one not opened yet
       (it is gone once the notice has been read). Arrow keys / j / k move
       between rows. -->
  <template id="portal_my_notices" name="Notices (ESS)">
    <t t-call="portal.portal_layout">
      <div class="pbme pbnb">
        <t t-call="pb_me_portal.ess_hero">
          <t t-set="hero_title">Notices</t>
          <t t-set="hero_sub">What the company announced, newest first.</t>
        </t>

        <div t-if="not first" class="pbme-empty">
          <div class="pbme-empty-ic"><t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'megaphone'"/><t t-set="isz" t-value="26"/></t></div>
          <h3>No notices yet</h3>
          <p>When HR posts one, it lands here. You will also see it on your home page.</p>
          <a class="pbme-btn pbme-btn--ghost" href="/my">Back to my home</a>
        </div>

        <t t-else="">
          <p class="pbnb-strip" aria-live="polite">
            <span t-att-class="'pbnb-stat is-new' if counts['unread'] else 'pbnb-stat'"><b t-out="counts['unread']"/> unread</span>
            <span class="pbnb-stat"><b t-out="counts['total']"/> in all</span>
          </p>

          <div data-pbnb-rows="">
            <a t-att-class="'pbnb-hero%s%s' % ('' if first['read'] else ' is-unread', ' has-img' if first['poster_url'] else '')" t-att-href="first['url']">
              <span t-if="first['poster_url']" class="pbnb-hero-img"><img t-att-src="first['poster_url']" alt="" loading="lazy"/></span>
              <span class="pbnb-hero-body">
                <span class="pbnb-hero-meta">
                  <span t-if="not first['read']" class="pbnb-newtag"><i class="pbnb-dot" aria-hidden="true"/>New</span>
                  <span class="pbnb-hero-when"><t t-if="first['ago']" t-call="pb_me_portal_comm.pbnb_ago"><t t-set="ago" t-value="first['ago']"/></t></span>
                </span>
                <b class="pbnb-hero-t" t-out="first['subject']"/>
                <span t-if="first['excerpt']" class="pbnb-hero-x" t-out="first['excerpt']"/>
                <span class="pbnb-hero-go">Read the notice<t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'arrow-right'"/><t t-set="isz" t-value="15"/></t></span>
              </span>
            </a>

            <ol t-if="rest" class="pbnb-list">
              <li t-foreach="rest" t-as="r" class="pbnb-li">
                <a t-att-class="'pbnb-row%s' % ('' if r['read'] else ' is-unread')" t-att-href="r['url']">
                  <span class="pbnb-row-dot" aria-hidden="true"><i class="pbnb-dot"/></span>
                  <span t-if="not r['read']" class="visually-hidden">Unread</span>
                  <span class="pbnb-row-body">
                    <b class="pbnb-row-t" t-out="r['subject']"/>
                    <span t-if="r['excerpt']" class="pbnb-row-x" t-out="r['excerpt']"/>
                  </span>
                  <span t-if="r['has_poster']" class="pbnb-row-clip" aria-hidden="true"><t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'paperclip'"/><t t-set="isz" t-value="14"/></t></span>
                  <span class="pbnb-row-when"><t t-if="r['ago']" t-call="pb_me_portal_comm.pbnb_ago"><t t-set="ago" t-value="r['ago']"/></t></span>
                  <span class="pbnb-row-go" aria-hidden="true"><t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'chevron-right'"/><t t-set="isz" t-value="16"/></t></span>
                </a>
              </li>
            </ol>
          </div>
          <div t-if="more_url" class="pbnb-more">
            <a class="pbme-btn pbme-btn--ghost" t-att-href="more_url">Show earlier</a>
          </div>
          <p t-if="rest" class="pbnb-keys" aria-hidden="true">Tip: use the arrow keys to move between notices, and Enter to open one.</p>
        </t>
      </div>
    </t>
  </template>

  <!-- ============================================================= -->
  <!--  One notice                                                    -->
  <!-- ============================================================= -->
  <!-- As HR wrote it: the subject, when it was sent, the words, and the
       posters (pictures drawn, files to open). If it was unread, its dot is
       drawn once and fades — the page says "read" without a word. Newer /
       Older walk the person's own board (also the left / right arrow
       keys). -->
  <template id="portal_my_notice" name="One notice (ESS)">
    <t t-call="portal.portal_layout">
      <div class="pbme pbnb pbnb-one">
        <a class="pbnb-back" href="/my/notices"><t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'arrow-left'"/><t t-set="isz" t-value="15"/></t>All notices</a>
        <article class="pbnb-article" aria-labelledby="pbnb-title" t-att-id="'notice-%s' % notice['post_id']">
          <header class="pbnb-article-h">
            <div class="pbnb-article-meta">
              <i t-if="was_unread" class="pbnb-dot is-fading" aria-hidden="true"/>
              <span class="pbme-eyebrow">Notice</span>
              <span class="pbnb-article-when" t-if="notice['sent_on']">Sent <t t-out="notice['sent_on']" t-options="{'widget': 'date', 'format': 'EEEE d MMMM yyyy'}"/></span>
            </div>
            <h1 class="pbnb-article-t" id="pbnb-title" t-out="notice['subject']"/>
          </header>
          <div t-if="notice['body_html']" class="pbnb-article-body" t-out="notice['body_html']"/>
          <p t-else="" class="pbnb-article-empty">This notice has no words, only what is attached below.</p>

          <t t-set="pics" t-value="[p for p in notice['posters'] if p['is_image']]"/>
          <t t-set="files" t-value="[p for p in notice['posters'] if not p['is_image']]"/>
          <div t-if="pics" class="pbnb-posters">
            <a t-foreach="pics" t-as="p" class="pbnb-poster" t-att-href="p['url']" target="_blank" rel="noopener">
              <img t-att-src="p['url']" t-att-alt="p['name']" loading="lazy"/>
            </a>
          </div>
          <ul t-if="files" class="pbnb-files">
            <li t-foreach="files" t-as="p">
              <a class="pbnb-file" t-att-href="p['download_url']">
                <span class="pbnb-file-ic" aria-hidden="true"><t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'paperclip'"/><t t-set="isz" t-value="15"/></t></span>
                <span class="pbnb-file-n" t-out="p['name']"/>
                <span class="pbnb-file-go" aria-hidden="true"><t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'download'"/><t t-set="isz" t-value="15"/></t></span>
              </a>
            </li>
          </ul>
        </article>

        <section class="pbnb-feed-post" id="comments" aria-label="Comments">
          <t t-call="pb_me_portal_comm.social_thread"><t t-set="r" t-value="notice"/><t t-set="return_home" t-value="False"/></t>
        </section>
        <nav class="pbnb-nav" aria-label="More notices" data-pbnb-nav="">
          <a t-if="notice['newer_url']" class="pbme-btn pbme-btn--ghost" t-att-href="notice['newer_url']" data-pbnb-newer=""><t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'arrow-left'"/><t t-set="isz" t-value="15"/></t>Newer</a>
          <span t-else=""/>
          <a class="pbme-btn pbme-btn--ghost" href="/my/notices">All notices</a>
          <a t-if="notice['older_url']" class="pbme-btn pbme-btn--ghost" t-att-href="notice['older_url']" data-pbnb-older="">Older<t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'arrow-right'"/><t t-set="isz" t-value="15"/></t></a>
          <span t-else=""/>
        </nav>
      </div>
    </t>
  </template>

  <!-- A notice that is not the person's (never sent to them, not sent yet,
       or gone): a styled 404 with the way back. -->
  <template id="portal_notice_missing" name="Notice not found (ESS)">
    <t t-call="portal.portal_layout">
      <div class="pbme pbnb">
        <div class="pbme-empty">
          <div class="pbme-empty-ic"><t t-call="pb_me_portal.ess_icon"><t t-set="icon" t-value="'megaphone'"/><t t-set="isz" t-value="26"/></t></div>
          <h3>We could not find that notice</h3>
          <p>It may have been taken down, or it was not sent to you. Your notices are all on the board.</p>
          <a class="pbme-btn pbme-btn--primary" href="/my/notices">Open my notices</a>
        </div>
      </div>
    </t>
  </template>

</odoo>
