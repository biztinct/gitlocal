        <!-- =============================================
             NON-RESIDENT TAX TABLE - Flat 20%
             ============================================= -->
        
        <record id="vietnam_tax_table_nonresident" model="vietnam.tax.table">
            <field name="name">Vietnam PIT Non-Resident</field>
            <field name="code">VN-PIT-NR</field>
            <field name="tax_year">2024</field>
            <field name="active" eval="True"/>
            <field name="personal_deduction">0</field>
            <field name="dependent_deduction">0</field>
            <field name="insurance_exemption" eval="False"/>
            <field name="notes">Flat 20% tax rate for non-resident individuals in Vietnam.

Non-residents are not eligible for personal deduction or dependent deductions.
Income is taxed at a flat rate of 20% on gross employment income.</field>
        </record>

        <!-- Single slab for non-resident: 20% flat rate -->
        <record id="vietnam_tax_slab_nr_1" model="vietnam.tax.slab">
            <field name="table_id" ref="vietnam_tax_table_nonresident"/>
            <field name="income_from">0</field>
            <field name="income_to">0</field>
            <field name="tax_rate">20</field>
            <field name="fixed_amount">0</field>
            <field name="sequence">10</field>
        </record>

        <!-- =============================================
             INSURANCE ADJUSTMENTS - Sample Data
             ============================================= -->
        
        <!-- Sample adjustment for Nguyen Huu Tho - Backdated collection -->
        <record id="vietnam_insurance_adj_01" model="vietnam.insurance.adjustment">
            <field name="employee_id" search="[('name', 'ilike', 'Nguyen Huu Tho')]"/>
            <field name="adjustment_date" eval="'2026-01-28'"/>
            <field name="period_from" eval="'2025-10-01'"/>
            <field name="period_to" eval="'2025-12-31'"/>
            <field name="adjustment_type">backdated</field>
            <field name="insurance_type">all</field>
            <field name="old_contribution">3150000</field>
            <field name="new_contribution">4200000</field>
            <field name="employer_amount">735000</field>
            <field name="employee_amount">315000</field>
            <field name="reason">salary_correction</field>
            <field name="state">draft</field>
            <field name="notes">Backdated insurance adjustment for Q4 2025.
Salary base was corrected from 15,000,000 VND to 20,000,000 VND.
This adjustment covers the difference in contributions for:
- BHXH: Oct-Dec 2025
- BHYT: Oct-Dec 2025  
- BHTN: Oct-Dec 2025</field>
        </record>

        <!-- Sample adjustment - Rate correction -->
        <record id="vietnam_insurance_adj_02" model="vietnam.insurance.adjustment">
            <field name="employee_id" search="[('name', 'ilike', 'Nguyen Huu Tho')]"/>
            <field name="adjustment_date" eval="'2026-01-15'"/>
            <field name="period_from" eval="'2025-07-01'"/>
            <field name="period_to" eval="'2025-09-30'"/>
            <field name="adjustment_type">correction</field>
            <field name="insurance_type">si</field>
            <field name="old_contribution">1575000</field>
            <field name="new_contribution">1680000</field>
            <field name="employer_amount">73500</field>
            <field name="employee_amount">31500</field>
            <field name="reason">rate_change</field>
            <field name="state">confirmed</field>
            <field name="notes">Social Insurance rate correction for Q3 2025.
Applied new SI rates as per government circular effective July 2025.</field>
        </record>

        <!-- =============================================
             NOTE: Employee Insurance/Tax data cannot be loaded via XML
             because Odoo doesn't support updating existing records via search.
             
             To populate the Insurance (BH) and Tax tabs for Nguyen Huu Tho,
             manually set these values in the employee form:
             
             Insurance Policy: BHXH Vietnam 2024
             SI Number: 0123456789 | SI Salary Base: 18,000,000
             HI Number: DN4012345678901 | HI Salary Base: 18,000,000
             UI Number: TN0123456789 | UI Salary Base: 18,000,000
             Tax Table: Vietnam PIT 2024
             Tax Regime: New | Residency: Resident
             Tax Code: 8012345678
             ============================================= -->

