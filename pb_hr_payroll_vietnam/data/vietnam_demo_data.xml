<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- =============================================
             VIETNAM INSURANCE POLICY - 2024 RATES
             Based on official Vietnam social insurance regulations
             ============================================= -->
        
        <record id="vietnam_insurance_policy_2024" model="vietnam.insurance.policy">
            <field name="name">BHXH Vietnam 2024</field>
            <field name="code">VN-INS-2024</field>
            <field name="effective_date" eval="'2024-01-01'"/>
            <field name="active" eval="True"/>
            
            <!-- Social Insurance (BHXH) - 17.5% employer, 8% employee -->
            <field name="si_employer_rate">17.5</field>
            <field name="si_employee_rate">8.0</field>
            <field name="si_max_salary_ceiling">46800000</field>
            <field name="si_applicable_salary_type">basic_allowances</field>
            <field name="si_include_in_employee_cost" eval="True"/>
            
            <!-- Health Insurance (BHYT) - 3% employer, 1.5% employee -->
            <field name="hi_employer_rate">3.0</field>
            <field name="hi_employee_rate">1.5</field>
            <field name="hi_max_salary_ceiling">46800000</field>
            <field name="hi_include_in_employee_cost" eval="True"/>
            
            <!-- Unemployment Insurance (BHTN) - 1% employer, 1% employee -->
            <field name="ui_employer_rate">1.0</field>
            <field name="ui_employee_rate">1.0</field>
            <field name="ui_max_salary_ceiling">93600000</field>
            <field name="ui_include_in_employee_cost" eval="True"/>
            
            <!-- Occupational Accident/Disease (TNLĐ-BNN) - 0.5% employer only -->
            <field name="oa_employer_rate">0.5</field>
            <field name="od_employer_rate">0.0</field>
            
            <!-- Notes -->
            <field name="notes">Vietnam Social Insurance rates effective from January 2024.

Salary Ceiling: 46,800,000 VND (36 x Regional Minimum Wage of 1,300,000 VND)

Rates breakdown:
- BHXH (Social Insurance): Employer 17.5%, Employee 8%
- BHYT (Health Insurance): Employer 3%, Employee 1.5%
- BHTN (Unemployment Insurance): Employer 1%, Employee 1%
- TNLĐ-BNN (OA/OD): Employer 0.5%, Employee 0%

Total: Employer 22%, Employee 10.5%</field>
        </record>

        <!-- =============================================
             ALTERNATIVE POLICY - THACO Style 
             ============================================= -->
        
        <record id="vietnam_insurance_policy_thaco_2024" model="vietnam.insurance.policy">
            <field name="name">BHXH THACO 2024</field>
            <field name="code">THACO-INS-2024</field>
            <field name="effective_date" eval="'2024-01-01'"/>
            <field name="active" eval="True"/>
            
            <!-- Social Insurance (BHXH) -->
            <field name="si_employer_rate">17.5</field>
            <field name="si_employee_rate">8.0</field>
            <field name="si_max_salary_ceiling">20000000</field>
            <field name="si_applicable_salary_type">basic_allowances</field>
            <field name="si_include_in_employee_cost" eval="True"/>
            
            <!-- Health Insurance (BHYT) -->
            <field name="hi_employer_rate">3.0</field>
            <field name="hi_employee_rate">1.5</field>
            <field name="hi_max_salary_ceiling">20000000</field>
            <field name="hi_include_in_employee_cost" eval="True"/>
            
            <!-- Unemployment Insurance (BHTN) -->
            <field name="ui_employer_rate">1.0</field>
            <field name="ui_employee_rate">1.0</field>
            <field name="ui_max_salary_ceiling">20000000</field>
            <field name="ui_include_in_employee_cost" eval="True"/>
            
            <!-- Occupational Accident/Disease (TNLĐ-BNN) -->
            <field name="oa_employer_rate">0.5</field>
            <field name="od_employer_rate">0.0</field>
            
            <field name="notes">THACO Group specific insurance policy with company-defined salary ceiling of 20,000,000 VND.</field>
        </record>

        <!-- =============================================
             VIETNAM TAX TABLE - Progressive PIT 2024
             Based on Circular 111/2013/TT-BTC
             ============================================= -->
        
        <record id="vietnam_tax_table_2024" model="vietnam.tax.table">
            <field name="name">Vietnam PIT 2024</field>
            <field name="code">VN-PIT-2024</field>
            <field name="tax_year">2024</field>
            <field name="active" eval="True"/>
            <field name="personal_deduction">11000000</field>
            <field name="dependent_deduction">4400000</field>
            <field name="insurance_exemption" eval="True"/>
            <field name="include_basic_income_tax" eval="True"/>
            <field name="include_defense_fund" eval="True"/>
            <field name="notes">Vietnam Personal Income Tax (Thuế TNCN) progressive rates per Circular 111/2013/TT-BTC.

Personal Deduction: 11,000,000 VND/month
Dependent Deduction: 4,400,000 VND/month per registered dependent

Tax calculation is based on taxable income after deductions.
Taxable Income = Gross Income - Social Insurance - Personal Deduction - (Dependents × Dependent Deduction)</field>
        </record>
        
        <!-- Tax Slabs for Progressive PIT -->
        <record id="vietnam_tax_slab_1" model="vietnam.tax.slab">
            <field name="table_id" ref="vietnam_tax_table_2024"/>
