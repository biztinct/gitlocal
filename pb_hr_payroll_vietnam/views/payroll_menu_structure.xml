<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Security Group for Vietnam Payroll -->
    <record id="group_vietnam_payroll_user" model="res.groups">
        <field name="name">Vietnam Payroll User</field>
        <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    
    <!-- Actions for Vietnam Dashboard -->
    <record id="action_vietnam_dashboard_window" model="ir.actions.act_window">
        <field name="name">Open Vietnam Payroll Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_vietnam"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'VN'}</field>
        <field name="domain">[('country', '=', 'VN')]</field>
    </record>
    
    <!-- Country Selector Expected Action for Vietnam -->
    <record id="action_payroll_dashboard_vietnam" model="ir.actions.act_window">
        <field name="name">Vietnam Payroll Dashboard Professional</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_vietnam"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'VN', 'force_view': True}</field>
        <field name="domain">[('country', '=', 'VN')]</field>
    </record>
    
    <!-- Main Menu Structure -->
    <menuitem id="menu_payroll_management_root"
              name="Payroll Management"
              sequence="85"
              groups="om_hr_payroll.group_hr_payroll_user"/>
    
    <!-- Vietnam Payroll Menu Structure -->
    <menuitem id="menu_vietnam_payroll_root"
              name="Vietnam Payroll"
              parent="menu_payroll_management_root"
              sequence="10"
              groups="group_vietnam_payroll_user"/>
    
    <!-- Vietnam Dashboard Menu -->
    <menuitem id="menu_vietnam_dashboard"
              name="Dashboard"
              parent="menu_vietnam_payroll_root"
              action="action_payroll_dashboard_vietnam"
              sequence="0"/>
    
    <!-- Vietnam Submenus -->
    <menuitem id="menu_vietnam_employees"
              name="Employees"
              parent="menu_vietnam_payroll_root"
              sequence="10"
              groups="group_vietnam_payroll_user"/>
    
    <menuitem id="menu_vietnam_payslips"
              name="Payslips"
              parent="menu_vietnam_payroll_root"
              sequence="20"
              groups="group_vietnam_payroll_user"/>
    
    <menuitem id="menu_vietnam_reports"
              name="Reports"
              parent="menu_vietnam_payroll_root"
              sequence="30"
              groups="group_vietnam_payroll_user"/>
    
    <!-- Social Insurance Menu -->
    <menuitem id="menu_vietnam_social_insurance"
              name="Social Insurance"
              parent="menu_vietnam_payroll_root"
              sequence="25"
              groups="group_vietnam_payroll_user"/>
    
    <!-- Vietnam Staging Data Menu -->
    <menuitem id="menu_vietnam_staging_data"
              name="📊 Vietnam Staging Data"
              parent="menu_vietnam_payroll_root"
              sequence="35"
              groups="group_vietnam_payroll_user"/>
    
    <!-- Vietnam Employee Data Menu -->
    <menuitem id="menu_vietnam_employee_data"
              name="📈 Vietnam Employee Data"
              parent="menu_vietnam_payroll_root"
              sequence="40"
              groups="group_vietnam_payroll_user"/>
    
    <!-- Additional Vietnam Reports Menu -->
    <menuitem id="menu_vietnam_reports_root"
              name="📋 Reports"
              parent="menu_vietnam_payroll_root"
              sequence="50"
              groups="group_vietnam_payroll_user"/>
    
    <menuitem id="menu_vietnam_staging_reports"
              name="Staging Data Analysis"
              parent="menu_vietnam_reports_root"
              sequence="10"/>
    
    <menuitem id="menu_vietnam_payroll_reports"
              name="Payroll Data Analysis"
              parent="menu_vietnam_reports_root"
              sequence="20"/>
    
</odoo>