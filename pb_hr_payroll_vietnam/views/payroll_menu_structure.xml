<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Security Group for Vietnam Payroll -->
    <record id="group_vietnam_payroll_user" model="res.groups">
        <field name="name">Vietnam Payroll User</field>
        <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    
    <!-- Actions for Vietnam Dashboard -->
    <record id="action_vietnam_dashboard_window" model="ir.actions.act_window">
        <field name="name">Open Vietnam Payroll Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_vietnam"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'VN'}</field>
        <field name="domain">[('country', '=', 'VN')]</field>
    </record>
    
    <!-- Country Selector Expected Action for Vietnam -->
    <record id="action_payroll_dashboard_vietnam" model="ir.actions.act_window">
        <field name="name">Vietnam Payroll Dashboard Professional</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_vietnam"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'VN', 'force_view': True}</field>
        <field name="domain">[('country', '=', 'VN')]</field>
    </record>
    
    <!-- Vietnam Dashboard Menu under base dashboard section -->
    <menuitem id="menu_vietnam_dashboard"
              name="Vietnam Dashboard"
              parent="pb_hr_payroll_base.menu_payroll_dashboard_section"
              action="action_payroll_dashboard_vietnam"
              sequence="10"
              groups="pb_hr_payroll_base.group_payroll_vietnam"/>
    

    <!-- Vietnam Social Insurance Menu - moved to PayrollBackup -->
    <menuitem id="menu_vietnam_social_insurance"
              name="Vietnam Social Insurance"
              parent="pb_hr_payroll_base.menu_payroll_backup_root"
              sequence="25"
              groups="pb_hr_payroll_base.group_payroll_vietnam"/>
    
</odoo>