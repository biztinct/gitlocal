<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payslip_form_vietnam" model="ir.ui.view">
        <field name="name">hr.payslip.form.vietnam.override</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(om_hr_payroll.action_report_payslip)d']" position="replace">
                <button name="action_print_payslip" type="object" string="Print Payslip"
                        class="oe_highlight" invisible="state not in ('done', 'verify')"/>
            </xpath>
        </field>
    </record>

</odoo>
