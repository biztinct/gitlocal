<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =============================================
         EMPLOYEE FORM EXTENSION - INS02 / TAX02 / TAX03 TABS
         ============================================= -->
    
    <!-- Extend Employee Form with Insurance Tab (INS02) -->
    <record id="view_employee_form_vietnam_insurance" model="ir.ui.view">
        <field name="name">hr.employee.form.vietnam.insurance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- Insurance (BH) Tab -->
                <page string="Insurance (BH)" name="vietnam_insurance">
                    <field name="vn_uses_payroll_profile" invisible="1"/>
                    <field name="vn_payroll_insurance_summary" nolabel="1" readonly="1"
                           invisible="not vn_uses_payroll_profile"/>
                    <group invisible="vn_uses_payroll_profile">
                        <group string="Insurance Policy">
                            <field name="vn_insurance_policy_id"/>
                        </group>
                        <group string="Work Info">
                            <field name="vn_work_region"/>
                            <field name="vn_exempt_oa_od"/>
                        </group>
                    </group>
                    
                    <group string="Social Insurance (BHXH)" invisible="vn_uses_payroll_profile">
                        <group>
                            <field name="vn_si_enrolled"/>
                            <field name="vn_si_enrollment_status"/>
                        </group>
                        <group>
                            <field name="vn_si_salary_base"/>
                        </group>
                    </group>
                    
                    <group string="Health Insurance (BHYT)" invisible="vn_uses_payroll_profile">
                        <group>
                            <field name="vn_hi_enrolled"/>
                        </group>
                        <group>
                            <field name="vn_hi_salary_base"/>
                        </group>
                    </group>
                    
                    <group string="Unemployment Insurance (BHTN)" invisible="vn_uses_payroll_profile">
                        <group>
                            <field name="vn_ui_enrolled"/>
                        </group>
                        <group>
                            <field name="vn_ui_salary_base"/>
                        </group>
                    </group>

                </page>
                
                <!-- Tax / Dependents Tab -->
                <page string="Tax &amp; Dependents" name="vietnam_tax">
                    <field name="vn_payroll_tax_summary" nolabel="1" readonly="1"
                           invisible="not vn_uses_payroll_profile"/>
                    <group string="Tax Configuration" invisible="vn_uses_payroll_profile">
                        <group>
                            <field name="vn_tax_regime"/>
                        </group>
                        <group>
                            <field name="vn_residency_status"/>
                        </group>
                    </group>
                    
                    <group string="Dependents (Người phụ thuộc)">
                        <div class="col-12">
                            <p class="text-muted" invisible="not vn_uses_payroll_profile">
                                These are supporting dependent records. They do not automatically change the
                                registered payroll count shown above. Confirm registration and dates for pending records.
                            </p>
                            <div class="d-flex justify-content-between mb-2" invisible="vn_uses_payroll_profile">
                                <div>
                                    <strong>All Dependent Records:</strong>
                                    <field name="vn_dependent_record_count" class="oe_inline"/>
                                </div>
                                <div>
                                    <strong>Eligible Dependents:</strong> 
                                    <field name="vn_eligible_dependent_count" class="oe_inline"/>
                                </div>
                            </div>
                            <field name="vn_dependent_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="relationship"/>
                                    <field name="date_of_birth"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'eligible'"
                                           decoration-warning="status == 'pending'"
                                           decoration-danger="status == 'ineligible'"/>
                                    <field name="tax_allowance" column_invisible="parent.vn_uses_payroll_profile"/>
                                </list>
                            </field>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
