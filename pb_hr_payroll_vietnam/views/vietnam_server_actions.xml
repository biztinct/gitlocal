<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Server action to open payslip batches without active_id parameter -->
    <record id="action_vietnam_view_payslip_batches_clean" model="ir.actions.server">
        <field name="name">View Payslip Batches</field>
        <field name="model_id" ref="om_hr_payroll.model_hr_payslip_run"/>
        <field name="state">code</field>
        <field name="code">
# Clear active_id context and open payslip batch view
action = {
    'type': 'ir.actions.act_window',
    'name': 'Batch Payslips',
    'res_model': 'hr.payslip.run',
    'view_mode': 'kanban,tree,form',
    'domain': [],
    'context': {
        'default_country': 'VN',
        'create': True,
        'group_by': ['state']
    }
}
        </field>
    </record>

    <!-- Actions for Vietnam Dashboard Navigation Tiles -->
    <record id="action_vietnam_employees_kanban" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="hr.hr_kanban_view_employees"/>
        <field name="domain">[]</field>
        <field name="context">{'default_country': 'VN'}</field>
    </record>

    <record id="action_vietnam_contracts_kanban" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="hr_contract.hr_contract_view_kanban"/>
        <field name="domain">[]</field>
        <field name="context">{'default_country': 'VN'}</field>
    </record>

    <record id="action_vietnam_payslip_batch_kanban" model="ir.actions.act_window">
        <field name="name">Batch Payslips</field>
        <field name="res_model">hr.payslip.run</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="om_hr_payroll.hr_payslip_run_view_kanban"/>
        <field name="search_view_id" ref="om_hr_payroll.hr_payslip_run_filter"/>
        <field name="domain">[]</field>
        <field name="context">{
            'default_country': 'VN',
            'create': True,
            'group_by': ['state']
        }</field>
    </record>

</odoo>