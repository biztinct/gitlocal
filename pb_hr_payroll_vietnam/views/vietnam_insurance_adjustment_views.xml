<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =============================================
         INSURANCE ADJUSTMENT VIEWS (INS04)
         ============================================= -->
    
    <!-- Tree View -->
    <record id="view_vietnam_insurance_adjustment_tree" model="ir.ui.view">
        <field name="name">vietnam.insurance.adjustment.tree</field>
        <field name="model">vietnam.insurance.adjustment</field>
        <field name="arch" type="xml">
            <tree string="Insurance Adjustments" decoration-info="state == 'draft'" 
                  decoration-success="state == 'applied'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="adjustment_date"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="adjustment_type"/>
                <field name="insurance_type"/>
                <field name="difference"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'applied'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_vietnam_insurance_adjustment_form" model="ir.ui.view">
        <field name="name">vietnam.insurance.adjustment.form</field>
        <field name="model">vietnam.insurance.adjustment</field>
        <field name="arch" type="xml">
            <form string="Insurance Adjustment">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            attrs="{'invisible': [('state', '!=', 'draft')]}" class="btn-primary"/>
                    <button name="action_apply" string="Apply to Payroll" type="object"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            attrs="{'invisible': [('state', 'in', ('applied', 'cancelled'))]}"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,applied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee">
                            <field name="employee_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Period">
                            <field name="adjustment_date"/>
                            <field name="period_from"/>
                            <field name="period_to"/>
                        </group>
                    </group>
                    <group>
                        <group string="Adjustment Details">
                            <field name="adjustment_type"/>
                            <field name="insurance_type"/>
                            <field name="reason"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_id" invisible="1"/>
                            <field name="old_contribution"/>
                            <field name="new_contribution"/>
                            <field name="difference"/>
                        </group>
                    </group>
                    <group>
                        <group string="Breakdown">
                            <field name="employer_amount"/>
                            <field name="employee_amount"/>
                        </group>
                        <group string="Application">
                            <field name="applied_payslip_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_vietnam_insurance_adjustment_search" model="ir.ui.view">
        <field name="name">vietnam.insurance.adjustment.search</field>
        <field name="model">vietnam.insurance.adjustment</field>
        <field name="arch" type="xml">
            <search string="Insurance Adjustments">
                <field name="name"/>
                <field name="employee_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Applied" name="applied" domain="[('state', '=', 'applied')]"/>
                <separator/>
                <filter string="Backdated" name="backdated" domain="[('adjustment_type', '=', 'backdated')]"/>
                <filter string="Refunds" name="refunds" domain="[('adjustment_type', '=', 'refund')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Type" name="type" context="{'group_by': 'adjustment_type'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                    <filter string="Month" name="month" context="{'group_by': 'adjustment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vietnam_insurance_adjustment" model="ir.actions.act_window">
        <field name="name">Insurance Adjustments</field>
        <field name="res_model">vietnam.insurance.adjustment</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_vietnam_insurance_adjustment_search"/>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an Insurance Adjustment
            </p>
            <p>
                Record backdated corrections, refunds, or additional collections for insurance contributions.
            </p>
        </field>
    </record>

</odoo>
