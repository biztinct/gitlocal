#: field:hr.payslip,vietnam_net_pay:0
msgid "Net Pay (Vietnam)"
msgstr "លម្អិតលម្អិតសុទ្ធ (វៀតណាម)"

#: field:hr.payslip,vietnam_gross_salary:0
msgid "Gross Salary (Vietnam)"
