#: view:hr.payslip:0
msgid "Health Insurance Calculation"
msgstr "ការគណនាការធានារ៉ាប់រងសុខភាព"

#: view:hr.payslip:0
msgid "Unemployment Insurance Calculation"
msgstr "ការគណនាការធានារ៉ាប់រងបាត់ការងារ"

#: view:hr.payslip:0
msgid "Personal Income Tax Calculation"
msgstr "ការគណនាពន្ធលម្អិតលម្អិតផ្ទាល់ខ្លួន"

#: code:addons/pb_hr_payroll_vietnam/models/hr_payslip_vietnam.py:50
msgid "Vietnam tax computed successfully"
msgstr "ពន្ធវៀតណាមបានគណនាដោយជោគជ័យ"

#: code:addons/pb_hr_payroll_vietnam/models/hr_payslip_vietnam.py:60
msgid "Error computing Vietnam tax: %s"
msgstr "កំហុសក្នុងការគណនាពន្ធវៀតណាម៖ %s"

#: help:hr.payslip,vietnam_si_employee:0
msgid "8% deducted from employee salary for social insurance"
msgstr "8% ត្រូវបានកាត់ចេញពីលម្អិតលម្អិតនិយោជកសម្រាប់ការធានារ៉ាប់រងសង្គម"

#: help:hr.payslip,vietnam_si_company:0
msgid "17.5% paid by company for social insurance"
msgstr "17.5% ត្រូវបានបង់ដោយក្រុមហ៊ុនសម្រាប់ការធានារ៉ាប់រងសង្គម"

#: help:hr.payslip,vietnam_hi_employee:0
msgid "1.5% deducted from employee salary for health insurance"
msgstr "1.5% ត្រូវបានកាត់ចេញពីលម្អិតលម្អិតនិយោជកសម្រាប់ការធានារ៉ាប់រងសុខភាព"

#: help:hr.payslip,vietnam_hi_company:0
msgid "3% paid by company for health insurance"
msgstr "3% ត្រូវបានបង់ដោយក្រុមហ៊ុនសម្រាប់ការធានារ៉ាប់រងសុខភាព"

#: help:hr.payslip,vietnam_ui_employee:0
msgid "1% deducted from employee salary for unemployment insurance"
msgstr "1% ត្រូវបានកាត់ចេញពីលម្អិតលម្អិតនិយោជកសម្រាប់ការធានារ៉ាប់រងបាត់ការងារ"

#: help:hr.payslip,vietnam_ui_company:0
msgid "1% paid by company for unemployment insurance"
msgstr "1% ត្រូវបានបង់ដោយក្រុមហ៊ុនសម្រាប់ការធានារ៉ាប់រងបាត់ការងារ"

#: help:hr.payslip,vietnam_pit:0
msgid "Progressive personal income tax based on Vietnamese regulations"
msgstr "ពន្ធលម្អិតលម្អិតផ្ទាល់ខ្លួនលម្អិតលម្អិតដែលផ្អែកលើលក្ខណៈលម្អិតវៀតណាម"

#: res.groups,name:pb_hr_payroll_vietnam.group_vietnam_payroll_officer
