#: field:hr.payslip,vietnam_hi_company:0
msgid "Health Insurance - Company"
msgstr "ការធានារ៉ាប់រងសុខភាព - ក្រុមហ៊ុន"

#: field:hr.payslip,vietnam_ui_employee:0
msgid "Unemployment Insurance - Employee"
msgstr "ការធានារ៉ាប់រងបាត់ការងារ - និយោជក"

#: field:hr.payslip,vietnam_ui_company:0
msgid "Unemployment Insurance - Company"
