#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "An extra run works out everything this scheme contains for the people you pick. To pay only a bonus, pick a scheme that only contains the bonus."
msgstr "Đợt lương thêm tính mọi khoản có trong phương án lương này cho những người bạn chọn. Để chỉ trả tiền thưởng, hãy chọn một phương án lương chỉ gồm khoản thưởng đó."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Who is this extra run for?"
msgstr "Đợt lương thêm này dành cho ai?"

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Remove"
msgstr "Bỏ"

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Nobody picked yet. Find the people this run pays below."
msgstr "Chưa chọn ai. Hãy tìm những người đợt này trả lương ở bên dưới."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "picked — only they will be paid."
msgstr "người đã chọn — chỉ họ được trả lương."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Nobody this scheme pays matches that search."
msgstr "Không có ai do phương án lương này trả khớp với tìm kiếm đó."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "A draft extra run will be created and computed — fully reversible. Only the people you picked are paid; no other run changes."
msgstr "Một đợt lương thêm nháp sẽ được tạo và tính — có thể hoàn tác hoàn toàn. Chỉ những người bạn đã chọn được trả lương; không đợt lương nào khác thay đổi."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Compute the extra payslips"
msgstr "Tính các phiếu lương thêm"
