#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid ", paid days and overtime come from the clocks and the late and overtime rules. Leave those columns empty in the pay data file — a number typed there is shown beside the clock value and not used."
msgstr ", hari dibayar dan lembur berasal dari mesin absensi serta aturan terlambat dan lembur. Biarkan kolom itu kosong di file data gaji — angka yang diketik di sana ditampilkan di samping nilai mesin absensi dan tidak dipakai."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Check again"
msgstr "Periksa lagi"

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Do not put lateness into any money column of the file — the late rules already take it off."
msgstr "Jangan masukkan keterlambatan ke kolom uang mana pun di file — aturan terlambat sudah memotongnya."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Everyone's hours are ready."
msgstr "Jam semua orang sudah siap."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "Hours from the clocks"
msgstr "Jam dari mesin absensi"

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "people need attention before this run can be worked out."
msgstr "orang perlu diperiksa sebelum penggajian ini bisa dihitung."

#. module: pb_payrun_wizard
#. odoo-javascript
#: code:addons/pb_payrun_wizard/static/src/xml/payrun_wizard.xml:0
msgid "people ready"
msgstr "orang siap"
