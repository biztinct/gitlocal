<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="pb_payrun_wizard.PayrollReviewDialog">
<Dialog title="'Review pay data'" size="state.maximized ? 'fullscreen' : 'xl'" fullscreen="state.maximized" contentClass="'pr-review-dialog'" withBodyPadding="false">
<div t-att-class="{'pr-review':true,'pr-max':state.maximized}" t-on-keydown="keydown">
    <header class="pr-header"><div><span class="pr-eyebrow">PAYROLL WORKSHEET</span><h2 t-esc="state.data?.name || 'Loading your records…'"/>
        <p t-if="state.data"><t t-esc="state.data.period[0]"/> — <t t-esc="state.data.period[1]"/> · <t t-esc="state.data.currency"/> · <t t-esc="state.data.people.length"/> employees</p></div>
        <div class="pr-header-actions"><span role="status" t-att-class="{'pr-saved':!state.pending,'pr-unsaved':state.pending}"><t t-esc="state.saving ? 'Saving…' : state.pending ? 'Correction not saved' : 'Saved on server'"/></span>
            <button class="pr-btn" t-on-click="() => state.maximized = !state.maximized" t-esc="state.maximized ? 'Restore size' : 'Maximize'"/></div></header>
    <div class="pr-error" role="alert" t-if="state.error"><span t-esc="state.error"/><button class="pr-link" t-on-click="load" t-att-disabled="state.pending || state.saving">Reload saved data</button></div>
    <div class="pr-loading" t-if="state.loading">Reading the selected employees’ source records…</div>
    <t t-elif="state.data">
    <div class="pr-summary"><div><b t-esc="state.data.issues"/><span>cells need attention</span></div><div><b t-esc="state.data.affected"/><span>employees affected</span></div><div><b t-esc="state.data.changes"/><span>saved corrections</span></div><p>Optional monthly items can stay empty.<br/><b><t t-esc="state.data.optional"/> blank cells</b> use zero after your period review.</p><button class="pr-btn" t-on-click="nextIssue" t-att-disabled="!state.data.issues">Next issue →</button></div>
    <div class="pr-global" t-if="state.data.global_issues.length"><b>Period setup needs attention</b><p t-foreach="state.data.global_issues" t-as="issue" t-key="issue.reason" t-esc="issue.reason"/></div>
    <nav class="pr-tools"><input type="search" placeholder="Find an employee…" aria-label="Find an employee" t-model="state.query"/>
        <select aria-label="Worksheet columns" t-model="state.group"><option value="all">All payroll inputs</option><option value="records">Salary &amp; records</option><option value="time">Time &amp; leave</option><option value="adjustments">Monthly adjustments</option><option value="results">Calculated pay &amp; contributions</option></select>
        <select aria-label="Worksheet rows" t-model="state.filter"><option value="all">All employees</option><option value="issues">Needs attention</option><option value="changes">With corrections</option></select>
        <button class="pr-btn" t-on-click="() => state.history = !state.history">Change history</button></nav>
    <div class="pr-layout"><div class="pr-grid" t-ref="grid"><table aria-label="Payroll review worksheet"><thead><tr><th class="pr-person">Employee</th><th t-foreach="columns" t-as="col" t-key="col.id"><span t-esc="col.name"/><small t-esc="col.group === 'results' ? 'Calculation preview' : col.optional ? 'Optional monthly amount' : col.group === 'time' ? 'Time &amp; leave' : col.group === 'records' ? 'Saved record' : 'Monthly amount'"/></th></tr></thead>
        <tbody><tr t-foreach="people" t-as="person" t-key="person.employee_id"><th class="pr-person"><b t-esc="person.name"/><small t-esc="person.issues.length ? person.issues.length + ' cells to review' : 'Source values loaded'"/></th>
        <td t-foreach="columns" t-as="col" t-key="col.id" t-att-data-cell="person.employee_id + ':' + col.id" t-attf-class="pr-cell pr-{{person.cells[col.code]?.tone || 'normal'}} {{selected?.employee_id === person.employee_id &amp;&amp; selected?.code === col.code ? 'pr-selected' : ''}}">
            <t t-set="cell" t-value="person.cells[col.code]"/><t t-if="cell">
            <input t-if="cell.editable" t-att-value="cellValue(person,col)" t-att-aria-label="person.name + ' · ' + col.name" t-att-title="cell.reason || status(cell)" t-att-disabled="state.saving" t-on-focus="() => this.select(person,col)" t-on-input="(ev) => this.inputCell(person,col,ev)" t-on-blur="(ev) => this.editCell(person,col,ev)" t-on-paste="(ev) => this.paste(person,col,ev)"/>
            <button t-else="" class="pr-cell-value" t-on-click="() => this.select(person,col)" t-att-title="cell.reason || status(cell)"><t t-esc="display(cell) || 'View source'"/></button>
            <small t-esc="status(cell)"/></t></td></tr></tbody></table><div class="pr-empty" t-if="!people.length">No employees match this view.</div></div>
        <aside class="pr-inspector" t-if="selected"><span class="pr-eyebrow">VALUE &amp; SOURCE</span><h3 t-esc="selected.label"/><p class="pr-person-name" t-esc="selected.person"/><span class="pr-owner" t-esc="selected.source_owner"/>
            <p t-if="selected.issue" class="pr-cell-reason" t-esc="selected.reason"/>
            <p t-if="state.detail" t-esc="state.detail.explanation"/>
            <button t-if="selected.edit?.proposal_id" class="pr-btn" t-on-click="openRecordProposal">Review saved-record change ↗</button>
            <div t-if="selected.editable" class="pr-edit-form"><label>Value for this run<input aria-label="Correction value" t-model="state.value" t-on-input="changed" t-on-blur="() => state.pending &amp;&amp; this.saveSelected()"/></label>
                <label>Why are you changing it?<input aria-label="Correction reason" placeholder="e.g. Approved bonus for this month" t-model="state.reason"/></label>
                <label>Apply this change<select aria-label="Correction scope" t-model="state.scope" t-on-change="changed"><option value="run">This payroll run only</option><option t-if="selected.future" value="future">This run + saved record</option></select></label>
                <p class="pr-hint" t-if="state.scope === 'future'">Saved records change through Records Desk approval, effective when approved. Submit the proposal below before completing the period review.</p>
                <button class="pr-btn pr-primary" t-on-click="saveSelected" t-att-disabled="state.saving">Save correction</button>
                <button class="pr-link" t-on-click="restore" t-if="selected.edit || state.pending" t-att-disabled="state.saving">Restore source value</button>
            </div>
            <p class="pr-hint" t-else="">This value is controlled by its source. Open the relevant record to correct it or complete its approval.</p>
            <details t-if="state.detail?.formula"><summary>Calculation formula</summary><code t-esc="state.detail.formula"/></details><div class="pr-source-actions" t-if="state.detail"><button class="pr-btn" t-foreach="state.detail.actions" t-as="dest" t-key="dest.model" t-on-click="() => this.openSource(dest.model)">Open <t t-esc="dest.label"/> ↗</button>
                <details><summary>Used in payroll calculations</summary><p t-if="!state.detail.consumers.length">This input has no formula consumers.</p><p t-foreach="state.detail.consumers" t-as="consumer" t-key="consumer.id" t-esc="consumer.name"/></details></div>
        </aside><aside class="pr-inspector pr-guide" t-else=""><span class="pr-eyebrow">A CLEAR VIEW OF EVERY VALUE</span><h3>Review by cell.</h3><p>Select a value to see where it comes from, correct it for this run, or open its source record.</p><p><span class="pr-dot pr-red"/> Missing required value</p><p><span class="pr-dot pr-amber"/> Source needs review</p><p><span class="pr-dot pr-edited"/> Your saved correction</p><p>— Optional amount: no entry needed</p><p class="pr-hint">Tab moves between cells. Enter finishes entry. Edits save when you leave a cell. Add a reason before pasting a rectangular range.</p></aside>
    </div>
    <section class="pr-history" t-if="state.history"><h3>Preparation history</h3><div t-foreach="state.data.history" t-as="event" t-key="event.revision + ':' + event.kind + ':' + event.at"><b t-esc="event.kind.replaceAll('_',' ')"/> · <t t-esc="event.user"/> · <t t-esc="event.at"/> · revision <t t-esc="event.revision"/><p t-foreach="historyChanges(event)" t-as="change" t-key="change_index"><b t-esc="change.person"/> · <t t-esc="change.item"/>: <t t-esc="change.before"/> → <t t-esc="change.after"/><span t-if="change.reason"> · <t t-esc="change.reason"/></span></p></div></section>
    <section class="pr-confirm" t-if="state.review"><h3>One review for this period</h3><p>Confirm that the records below are complete. The <b t-esc="state.data.optional"/> eligible empty monthly amounts will be recorded as reviewed zero values. Pending approvals and source conflicts cannot be waived.</p>
        <t t-foreach="['leave','overtime','adjustments','timesheets']" t-as="channel" t-key="channel"><label t-if="channel !== 'timesheets' || state.data.timesheets"><input type="checkbox" t-model="state.channels[channel]"/><t t-esc="({leave:'Time off',overtime:'Overtime',adjustments:'Monthly adjustments',timesheets:'Timesheets and attendance'})[channel]"/> records are complete for this period</label></t>
        <label t-if="state.data.settlement_zeros"><input type="checkbox" t-model="state.channels.settlements"/>I reviewed the eligible empty settlement amounts and confirm there was no settlement activity for them in this period.</label>
        <input aria-label="Period review note" placeholder="Review note or approval reference" t-model="state.note"/><button class="pr-btn pr-primary" t-on-click="finish" t-att-disabled="state.saving">Confirm review &amp; return to Pay Run</button>
    </section>
    <footer class="pr-footer"><p>Saved preparation #<t t-esc="state.data.id"/> · Revision <t t-esc="state.data.revision"/><br/><small>Saving or reviewing this worksheet does not compute or post payroll.</small></p><div><button t-if="pendingFuture" class="pr-btn" t-on-click="submitFuture" t-att-disabled="state.saving">Submit <t t-esc="pendingFuture"/> record changes</button><button class="pr-btn" t-on-click="closeSaved">Save &amp; close</button><button class="pr-btn pr-primary" t-on-click="() => state.review = !state.review" t-att-disabled="!canReview">Review &amp; continue</button></div></footer>
    </t>
</div>
<t t-set-slot="footer"><span class="pr-dialog-footnote">Your acknowledged edits are saved securely on the server.</span></t>
</Dialog>
</t>
</templates>
