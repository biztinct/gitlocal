<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="pb_payrun_wizard.PayrunWizard">
    <div class="pw-root">
        <div class="pw-card">
            <!-- Header -->
            <div class="pw-head">
                <div>
                    <div class="pw-eyebrow">Payobook · Pay run</div>
                    <h2>Run Payroll</h2>
                </div>
                <button class="pw-x" t-on-click="cancel">✕</button>
            </div>

            <!-- Stepper -->
            <div class="pw-rail">
                <t t-foreach="steps" t-as="s" t-key="s_index">
                    <div t-attf-class="pw-step #{state.step > s_index+1 ? 'done' : ''} #{state.step === s_index+1 ? 'cur' : ''}">
                        <div class="pw-dot"><t t-if="state.step > s_index+1"><t t-out="ic('check',14)"/></t><t t-else=""><t t-esc="s_index+1"/></t></div>
                        <div class="pw-lab" t-esc="s"/>
                    </div>
                    <div t-if="s_index &lt; steps.length - 1" t-attf-class="pw-bar #{state.step > s_index+1 ? 'done' : ''}"/>
                </t>
            </div>

            <div class="pw-body">
                <t t-if="state.loading">
                    <div class="pw-busy"><div class="pw-spin"></div><div t-esc="state.busyMsg"/></div>
                </t>

                <!-- Step 1 -->
                <t t-elif="state.step === 1">
                    <div class="pw-grid2">
                        <div class="pw-sec">
                            <h4>Period</h4>
                            <t t-if="(state.defaults.divisions || []).length">
                                <label>Configuration</label>
                                <select class="pw-in" data-coach="pw-division" t-on-change="(ev)=>this.onDivision(ev)">
                                    <t t-foreach="state.defaults.divisions" t-as="d" t-key="d.key">
                                        <option t-att-value="d.key" t-att-selected="d.key === state.form.division" t-esc="d.name"/>
                                    </t>
                                </select>
                            </t>
                            <label>Batch name</label>
                            <input t-attf-class="pw-in{{ state.defaults and state.defaults.is_demo ? ' pw-locked' : '' }}" t-att-value="state.form.name" t-att-readonly="state.defaults and state.defaults.is_demo" t-on-change="(ev)=>this.onField('name',ev)"/>
                            <div class="pw-row2">
                                <div><label>From</label><input type="date" t-attf-class="pw-in{{ state.defaults and state.defaults.is_demo ? ' pw-locked' : '' }}" t-att-value="state.form.date_start" t-att-disabled="state.defaults and state.defaults.is_demo" t-on-change="(ev)=>this.onField('date_start',ev)"/></div>
                                <div><label>To</label><input type="date" t-attf-class="pw-in{{ state.defaults and state.defaults.is_demo ? ' pw-locked' : '' }}" t-att-value="state.form.date_end" t-att-disabled="state.defaults and state.defaults.is_demo" t-on-change="(ev)=>this.onField('date_end',ev)"/></div>
                            </div>
                        </div>
                        <div class="pw-sec">
                            <h4>Scope</h4>
                            <div class="pw-kv"><span>Company</span><b t-esc="state.defaults.company"/></div>
                            <div class="pw-kv"><span>Currency</span><b t-esc="state.defaults.currency"/></div>
                            <div class="pw-kv" t-if="divInfo"><span>Configuration</span><b t-esc="divInfo.config"/></div>
                            <div class="pw-kv"><span>Eligible employees</span><b t-esc="eligibleCount"/></div>
                            <div class="pw-note">A draft run will be created and computed — fully reversible. Only the selected division is affected.</div>
                        </div>
                    </div>
                </t>

                <!-- Step 2 (after compute) -->
                <t t-elif="state.step === 2 and state.summary">
                    <div class="pw-result">
                        <div class="pw-result-ic"><t t-out="ic('zap',30)"/></div>
                        <h3>Computed <t t-esc="state.summary.computed"/> of <t t-esc="state.summary.count"/> payslips</h3>
                        <p class="pw-muted"><t t-esc="state.summary.name"/> · net total <b t-esc="vnd(state.summary.total_net)"/></p>
                        <div class="pw-statpills">
                            <div class="pw-statpill"><div class="n" t-esc="state.summary.count"/><div class="l">Payslips</div></div>
                            <div class="pw-statpill"><div class="n" t-esc="state.summary.computed"/><div class="l">Computed</div></div>
                            <div class="pw-statpill"><div class="n" t-esc="state.summary.flagged + (state.summary.exceptions ? state.summary.exceptions.length : 0)"/><div class="l">Need review</div></div>
                        </div>
                    </div>
                </t>

                <!-- Step 3 -->
                <t t-elif="state.step === 3 and state.summary">
                    <t t-set="exc" t-value="state.summary.exceptions || []"/>
                    <t t-if="exc.length or state.summary.flagged">
                        <p class="pw-muted mb">These items need a look before approval:</p>
                        <div class="pw-list">
                            <t t-foreach="exc" t-as="e" t-key="e_index">
                                <div class="pw-li"><span class="pw-flag"><t t-out="ic('alert',13)"/> <t t-esc="e.why"/></span><span t-esc="e.emp"/></div>
                            </t>
                            <t t-foreach="state.summary.rows" t-as="r" t-key="r.id">
                                <div t-if="r.flag" class="pw-li"><span class="pw-flag"><t t-out="ic('alert',13)"/> Net is zero</span><span t-esc="r.emp"/></div>
                            </t>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="pw-result"><div class="pw-result-ic ok"><t t-out="ic('check',30)"/></div><h3>No exceptions</h3><p class="pw-muted">All <t t-esc="state.summary.count"/> payslips look clean.</p></div>
                    </t>
                </t>
            </div>

            <!-- Footer -->
            <div class="pw-foot" t-if="!state.loading">
                <button class="pw-btn ghost" t-if="state.step > 1" t-on-click="() => this.goto(state.step-1)">← Back</button>
                <button class="pw-btn ghost" t-if="state.step === 1" t-on-click="cancel">Cancel</button>
                <div class="pw-spacer"></div>
                <button class="pw-btn primary" data-coach="pw-compute" t-if="state.step === 1" t-on-click="toCompute">Compute payslips <t t-out="ic('arrow',14)"/></button>
                <button class="pw-btn primary" t-if="state.step === 2" t-on-click="() => this.goto(3)">Review exceptions <t t-out="ic('arrow',14)"/></button>
                <button class="pw-btn primary" t-if="state.step === 3" t-on-click="openRun">Open Payroll <t t-out="ic('arrow',14)"/></button>
            </div>
        </div>
    </div>
</t>

</templates>
