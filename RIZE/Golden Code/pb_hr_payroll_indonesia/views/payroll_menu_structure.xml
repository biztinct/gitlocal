<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Security Groups for Each Country -->
    <record id="group_vietnam_payroll_user" model="res.groups">
        <field name="name">Vietnam Payroll User</field>
        <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    
    <record id="group_indonesia_payroll_user" model="res.groups">
        <field name="name">Indonesia Payroll User</field>
        <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    
    <record id="group_india_payroll_user" model="res.groups">
        <field name="name">India Payroll User</field>
        <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    
    <!-- Actions Definition First (before menu items that reference them) -->
    
    <!-- Action for Country Selector -->
    <record id="action_open_country_selector" model="ir.actions.act_url">
        <field name="name">Select Payroll Country</field>
        <field name="url">/payroll/country-selector</field>
        <field name="target">self</field>
    </record>
    
    <!-- Server Actions for Dashboard (must be defined before menu items reference them) -->
    <record id="action_open_vietnam_dashboard" model="ir.actions.server">
        <field name="name">Open Vietnam Payroll Dashboard</field>
        <field name="model_id" ref="model_payroll_dashboard"/>
        <field name="state">code</field>
        <field name="code">
# Ensure Vietnam dashboard record exists
dashboard = env['payroll.dashboard'].search([('country', '=', 'VN')], limit=1)
if not dashboard:
    dashboard = env['payroll.dashboard'].create({'country': 'VN'})

# Open the specific dashboard record
action = {
    'type': 'ir.actions.act_window',
    'name': 'Vietnam Payroll Dashboard',
    'res_model': 'payroll.dashboard',
    'view_mode': 'form',
    'view_id': env.ref('pb_hr_payroll_indonesia.view_payroll_dashboard_vietnam').id,
    'res_id': dashboard.id,
    'target': 'current',
    'context': {'create': False, 'edit': False, 'delete': False}
}
        </field>
    </record>
    
    <record id="action_open_indonesia_dashboard" model="ir.actions.server">
        <field name="name">Open Indonesia Payroll Dashboard</field>
        <field name="model_id" ref="model_payroll_dashboard"/>
        <field name="state">code</field>
        <field name="code">
# Ensure Indonesia dashboard record exists
dashboard = env['payroll.dashboard'].search([('country', '=', 'ID')], limit=1)
if not dashboard:
    dashboard = env['payroll.dashboard'].create({'country': 'ID'})

# Open the specific dashboard record
action = {
    'type': 'ir.actions.act_window',
    'name': 'Indonesia Payroll Dashboard',
    'res_model': 'payroll.dashboard',
    'view_mode': 'form',
    'view_id': env.ref('pb_hr_payroll_indonesia.view_payroll_dashboard_indonesia').id,
    'res_id': dashboard.id,
    'target': 'current',
    'context': {'create': False, 'edit': False, 'delete': False}
}
        </field>
    </record>

    <!-- Vietnam Specific Actions -->
    <record id="action_zoho_staging_importer_vietnam" model="ir.actions.act_window">
        <field name="name">Get Employee Data - Vietnam</field>
        <field name="res_model">zoho.staging.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_payroll_country': 'VN'}</field>
    </record>
    
    <!-- Vietnam spreadsheet actions using existing server actions -->
    <record id="action_vietnam_edit_spreadsheet" model="ir.actions.server">
        <field name="name">Edit Vietnam Payroll Spreadsheet</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
# This will be configured after spreadsheet is created
action = {
    'type': 'ir.actions.client',
    'tag': 'action_spreadsheet_oca',
    'params': {
        'spreadsheet_id': env.ref('__custom__.payrollstaging', raise_if_not_found=False).id if env.ref('__custom__.payrollstaging', raise_if_not_found=False) else False,
    },
    'context': {'payroll_country': 'VN'}
}
        </field>
    </record>
    
    <record id="action_vietnam_import_spreadsheet" model="ir.actions.server">
        <field name="name">Import Vietnam Spreadsheet</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
spreadsheet = env.ref('__custom__.payrollstaging', raise_if_not_found=False)
if spreadsheet:
    action = spreadsheet.with_context(payroll_country='VN').import_json_data()
else:
    raise UserError('Vietnam payroll spreadsheet not found. Please create it with external ID __custom__.payrollstaging')
        </field>
    </record>
    
    <!-- Indonesia Specific Actions -->
    <record id="action_zoho_staging_importer_indonesia" model="ir.actions.act_window">
        <field name="name">Get Employee Data - Indonesia</field>
        <field name="res_model">zoho.staging.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_payroll_country': 'ID'}</field>
    </record>
    
    <!-- Indonesia spreadsheet actions -->
    <record id="action_indonesia_edit_spreadsheet" model="ir.actions.server">
        <field name="name">Edit Indonesia Payroll Spreadsheet</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
# This will be configured after spreadsheet is created
action = {
    'type': 'ir.actions.client',
    'tag': 'action_spreadsheet_oca',
    'params': {
        'spreadsheet_id': env.ref('__custom__.payrollstaging_indonesia', raise_if_not_found=False).id if env.ref('__custom__.payrollstaging_indonesia', raise_if_not_found=False) else False,
    },
    'context': {'payroll_country': 'ID'}
}
        </field>
    </record>
    
    <record id="action_indonesia_import_spreadsheet" model="ir.actions.server">
        <field name="name">Import Indonesia Spreadsheet</field>
        <field name="model_id" ref="model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
spreadsheet = env.ref('__custom__.payrollstaging_indonesia', raise_if_not_found=False)
if spreadsheet:
    action = spreadsheet.with_context(payroll_country='ID').import_json_data()
else:
    raise UserError('Indonesia payroll spreadsheet not found. Please create it with external ID __custom__.payrollstaging_indonesia')
        </field>
    </record>
    
    <!-- THR Payment Action for Indonesia -->
    <record id="action_thr_payment_wizard" model="ir.actions.act_window">
        <field name="name">THR Payment Wizard</field>
        <field name="res_model">thr.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_payroll_country': 'ID'}</field>
    </record>
    
    <!-- Main Menu Structure -->
    <menuitem id="menu_payroll_management_root"
              name="Payroll Management"
              sequence="85"
              groups="om_hr_payroll.group_hr_payroll_user"/>
    
    <!-- Country Selection Menu -->
    <menuitem id="menu_payroll_country_selector"
              name="Select Country"
              parent="menu_payroll_management_root"
              action="action_open_country_selector"
              sequence="0"/>
    
    <!-- Vietnam Payroll Menu Structure -->
    <menuitem id="menu_vietnam_payroll_root"
              name="Vietnam Payroll"
              parent="menu_payroll_management_root"
              sequence="10"
              groups="group_vietnam_payroll_user"/>
    
    <!-- Add Dashboard menu items with server actions -->
    <menuitem id="menu_vietnam_dashboard"
              name="Dashboard"
              parent="menu_vietnam_payroll_root"
              action="action_open_vietnam_dashboard"
              sequence="0"/>
    
    <!-- Indonesia Payroll Menu Structure -->
    <menuitem id="menu_indonesia_payroll_root"
              name="Indonesia Payroll" 
              parent="menu_payroll_management_root"
              sequence="20"
              groups="group_indonesia_payroll_user"/>
    
    <menuitem id="menu_indonesia_dashboard"
              name="Dashboard"
              parent="menu_indonesia_payroll_root"
              action="action_open_indonesia_dashboard"
              sequence="0"/>
    
    <!-- India Payroll Menu Structure -->
    <menuitem id="menu_india_payroll_root"
              name="India Payroll"
              parent="menu_payroll_management_root"
              sequence="30"
              groups="group_india_payroll_user"/>
    
    <!-- Vietnam Submenus -->
    <menuitem id="menu_vietnam_employees"
              name="Employees"
              parent="menu_vietnam_payroll_root"
              sequence="10"
              groups="group_vietnam_payroll_user"/>
    
    <menuitem id="menu_vietnam_payslips"
              name="Payslips"
              parent="menu_vietnam_payroll_root"
              sequence="20"
              groups="group_vietnam_payroll_user"/>
    
    <menuitem id="menu_vietnam_reports"
              name="Reports"
              parent="menu_vietnam_payroll_root"
              sequence="30"
              groups="group_vietnam_payroll_user"/>
    
    <!-- Indonesia Submenus -->
    <menuitem id="menu_indonesia_employees"
              name="Employees"
              parent="menu_indonesia_payroll_root"
              sequence="10"
              groups="group_indonesia_payroll_user"/>
    
    <menuitem id="menu_indonesia_payslips"
              name="Payslips"
              parent="menu_indonesia_payroll_root"
              sequence="20"
              groups="group_indonesia_payroll_user"/>
    
    <menuitem id="menu_indonesia_thr"
              name="THR Payments"
              parent="menu_indonesia_payroll_root"
              action="action_thr_payment_wizard"
              sequence="25"
              groups="group_indonesia_payroll_user"/>
    
    <menuitem id="menu_indonesia_reports"
              name="Reports"
              parent="menu_indonesia_payroll_root"
              sequence="30"
              groups="group_indonesia_payroll_user"/>
    
    <!-- India Submenus -->
    <menuitem id="menu_india_employees"
              name="Employees"
              parent="menu_india_payroll_root"
              sequence="10"
              groups="group_india_payroll_user"/>
    
    <menuitem id="menu_india_payslips"
              name="Payslips"
              parent="menu_india_payroll_root"
              sequence="20"
              groups="group_india_payroll_user"/>
    
    <menuitem id="menu_india_reports"
              name="Reports"
              parent="menu_india_payroll_root"
              sequence="30"
              groups="group_india_payroll_user"/>
    
</odoo>