<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Corrected Bank Export Wizard Form View -->
    <record id="view_payroll_bank_export_wizard_form" model="ir.ui.view">
        <field name="name">payroll.bank.export.wizard.form</field>
        <field name="model">payroll.bank.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Bank Export Wizard">
                <header>
                    <button name="action_generate_export" 
                            type="object" 
                            string="Generate Export" 
                            class="oe_highlight"
                            states="draft"/>
                    <button name="action_download" 
                            type="object" 
                            string="Download File" 
                            class="oe_highlight"
                            states="done"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" attrs="{'invisible': [('name', '=', False)]}"/>
                        </h1>
                    </div>
                    
                    <!-- Configuration Section -->
                    <group string="Export Configuration">
                        <group>
                            <field name="country" readonly="1"/>
                            <field name="analytics_id" readonly="1" attrs="{'invisible': [('analytics_id', '=', False)]}"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="export_format" widget="radio"/>
                            <field name="include_header" attrs="{'invisible': [('export_format', '=', 'txt')]}"/>
                            <field name="separator" attrs="{'invisible': [('export_format', 'not in', ['csv'])]}"/>
                        </group>
                    </group>
                    
                    <!-- Data Preview Section - Full Width -->
                    <div class="preview-section" states="draft" attrs="{'invisible': [('preview_data', '=', False)]}">
                        <h3>
                            <i class="fa fa-eye"/> Data Preview
                        </h3>
                        <p class="text-muted">
                            Preview of the export data that will be generated. This shows the first few records.
                        </p>
                        
                        <!-- Full-width container for preview data -->
                        <div class="preview-container">
                            <field name="preview_data" 
                                   widget="text" 
                                   readonly="1"
                                   nolabel="1"
                                   options="{'resizable': true}"
                                   class="preview-data-field"/>
                        </div>
                    </div>
                    
                    <!-- Export Result Section -->
                    <group string="Export Result" states="done">
                        <field name="export_filename" readonly="1"/>
                        <field name="export_file" filename="export_filename" readonly="1"/>
                    </group>
                    
                    <!-- Information Alerts -->
                    <div class="alert alert-info" role="alert" states="draft">
                        <strong><i class="fa fa-info-circle"/> Export Information</strong><br/>
                        This will generate a bank disbursement file containing employee payment details.
                        Only approved payroll data will be included in the export.
                    </div>
                    
                    <div class="alert alert-success" role="alert" states="done">
                        <strong><i class="fa fa-check-circle"/> Export Completed!</strong><br/>
                        Your bank export file has been generated successfully. 
                        Click "Download File" to save it to your computer.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Custom CSS for Bank Export Wizard -->
    <template id="bank_export_wizard_styles" name="Bank Export Wizard Styles">
        <style>
            /* Preview Section Styling */
            .preview-section {
                margin: 20px 0;
                padding: 20px;
                background: #f8f9fa;
                border-radius: 8px;
                border-left: 4px solid #007bff;
            }
            
            .preview-section h3 {
                color: #495057;
                margin-bottom: 10px;
                font-weight: 600;
            }
            
            .preview-section .text-muted {
                margin-bottom: 15px;
                font-size: 14px;
            }
            
            /* Full-width container for preview data */
            .preview-container {
                width: 100%;
                margin: 0;
                padding: 0;
            }
            
            /* Enhanced preview data field styling */
            .preview-data-field {
                width: 100% !important;
                min-height: 300px !important;
                max-height: 500px !important;
                font-family: 'Courier New', monospace !important;
                font-size: 12px !important;
                line-height: 1.4 !important;
                background: white !important;
                border: 1px solid #ced4da !important;
                border-radius: 4px !important;
                padding: 15px !important;
                overflow: auto !important;
                white-space: pre !important;
                resize: vertical !important;
            }
            
            /* Override Odoo's default field width constraints */
            .preview-container .o_field_widget {
                width: 100% !important;
                max-width: none !important;
            }
            
            .preview-container .o_field_text {
                width: 100% !important;
                min-width: 800px !important;
            }
            
            /* Enhanced wizard dialog width */
            .o_dialog.modal {
                max-width: 95% !important;
            }
            
            .o_dialog .modal-content {
                min-width: 800px;
                width: 100%;
            }
            
            .o_dialog .modal-body {
                padding: 20px;
            }
            
            /* Status bar styling */
            .o_form_statusbar {
                background: #f8f9fa;
                border-bottom: 1px solid #dee2e6;
            }
            
            /* Alert styling */
            .alert {
                margin: 15px 0;
                border-radius: 6px;
                padding: 15px;
            }
            
            .alert-info {
                background-color: #e7f3ff;
                border-color: #b8daff;
                color: #004085;
                border-left: 4px solid #007bff;
            }
            
            .alert-success {
                background-color: #e8f5e8;
                border-color: #c3e6cb;
                color: #155724;
                border-left: 4px solid #28a745;
            }
            
            /* Radio button styling */
            .o_radio_item {
                margin-right: 15px;
            }
            
            /* Responsive design for smaller screens */
            @media (max-width: 768px) {
                .preview-data-field {
                    min-height: 200px !important;
                    font-size: 10px !important;
                }
                
                .preview-container .o_field_text {
                    min-width: 100% !important;
                }
                
                .o_dialog .modal-content {
                    min-width: 95vw;
                }
            }
        </style>
    </template>

</odoo>