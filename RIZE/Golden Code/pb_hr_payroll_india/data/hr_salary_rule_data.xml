</odoo> calculation - simplified
income_tax_adv = contract.advantage_ids.filtered(lambda a: a.advantage_template_id.code == 'INCOME_TAX')
result = -abs(income_tax_adv[0].amount) if income_tax_adv else 0
            </field>
