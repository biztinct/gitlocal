        <!-- NET PAY -->
        <record id="rule_india_net" model="hr.salary.rule">
            <field name="name">Net Pay</field>
            <field name="code">NETPAY</field>
            <field name="sequence">400</field>
            <field name="category_id" ref="om_hr_payroll.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# Net Pay = Gross - Deductions
gross = categories.IND_GROSS if categories.IND_GROSS else 0
deductions = categories.IND_DED if categories.IND_DED else 0
pf_deductions = categories.IND_PF if categories.IND_PF else 0
tax_deductions = categories.IND_TAX if categories.IND_TAX else 0
result = gross + deductions + pf_deductions + tax_deductions
            </field>
            <field name="struct_id" ref="structure_india_employee"/>
        </record>
        
        <!-- Employer Contributions -->
        
        <!-- PF Employer Contribution -->
        <record id="rule_india_pf_employer" model="hr.salary.rule">
            <field name="name">PF - Employer Contribution</field>
            <field name="code">PF_EMPLOYER</field>
            <field name="sequence">500</field>
            <field name="category_id" ref="categ_india_employer"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# PF Employer contribution - 12% of Basic salary
basic_salary = categories.IND_BASIC if categories.IND_BASIC else 0
pf_rate = contract.pf_employer_rate / 100.0 if hasattr(contract, 'pf_employer_rate') and contract.pf_employer_rate else 0.12
result = basic_salary * pf_rate
            </field>
            <field name="struct_id" ref="structure_india_employee"/>
        </record>
        
        <!-- ESI Employer Contribution -->
        <record id="rule_india_esi_employer" model="hr.salary.rule">
            <field name="name">ESI - Employer Contribution</field>
            <field name="code">ESI_EMPLOYER</field>
            <field name="sequence">510</field>
            <field name="category_id" ref="categ_india_employer"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
# ESI Employer contribution - 3.25% of gross (if applicable)
gross_salary = categories.IND_GROSS if categories.IND_GROSS else 0
esi_limit = 25000  # ESI is applicable only if gross is below this limit
if gross_salary <= esi_limit:
    esi_rate = contract.esi_employer_rate / 100.0 if hasattr(contract, 'esi_employer_rate') and contract.esi_employer_rate else 0.0325
    result = gross_salary * esi_rate
else:
    result = 0
            </field>
