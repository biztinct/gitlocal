<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Extend Zoho Staging Data Form View for India Components -->
        <record id="view_zoho_staging_data_form_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.form.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="inherit_id" ref="om_hr_payroll.view_zoho_staging_data_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[last()]" position="after">
                    <group string="India Salary Components" attrs="{'invisible': [('country', '!=', 'IN')]}">
                        <group string="Allowances">
                            <field name="basic_salary"/>
                            <field name="hra"/>
                            <field name="special_allowance"/>
                            <field name="books_periodicals"/>
                            <field name="telephone_internet"/>
                            <field name="leave_travel_allowance"/>
                        </group>
                        <group string="Deductions & Details">
                            <field name="pf"/>
                            <field name="prof_tax"/>
                            <field name="income_tax"/>
                            <field name="uan_number"/>
                            <field name="esi_number"/>
                            <field name="ifsc_code"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
        
        <!-- Extend Zoho Employee Data Form View for India Components -->
        <record id="view_zoho_employee_data_form_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.form.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="inherit_id" ref="om_hr_payroll.view_zoho_employee_data_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[last()]" position="after">
                    <group string="India Payroll Calculations" attrs="{'invisible': [('country', '!=', 'IN')]}">
                        <group string="Salary Components (Calculated)">
                            <field name="actual_basic_salary"/>
                            <field name="actual_hra"/>
                            <field name="actual_special_allowance"/>
                            <field name="actual_books_periodicals"/>
                            <field name="actual_telephone_internet"/>
                            <field name="actual_lta"/>
                        </group>
                        <group string="Deductions & Contributions (Calculated)">
                            <field name="actual_pf"/>
                            <field name="actual_prof_tax"/>
                            <field name="actual_income_tax"/>
                            <field name="pf_employer"/>
                            <field name="esi_employer"/>
                        </group>
                        <group string="Totals" colspan="2">
                            <group>
                                <field name="india_gross_pay"/>
                                <field name="india_total_deductions"/>
                                <field name="india_net_pay"/>
                            </group>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
        
        <!-- Extend Zoho Staging Data Tree View for India Components -->
        <record id="view_zoho_staging_data_tree_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.tree.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="inherit_id" ref="om_hr_payroll.view_zoho_staging_data_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='base_salary']" position="after">
                    <!-- India Salary Components -->
                    <field name="basic_salary" optional="hide" string="Basic"/>
                    <field name="hra" optional="hide" string="HRA"/>
                    <field name="special_allowance" optional="hide" string="Special Allow"/>
                    <field name="books_periodicals" optional="hide" string="Books"/>
                    <field name="telephone_internet" optional="hide" string="Tel/Internet"/>
                    <field name="leave_travel_allowance" optional="hide" string="LTA"/>
                    <field name="pf" optional="hide" string="PF"/>
                    <field name="prof_tax" optional="hide" string="Prof Tax"/>
                    <field name="income_tax" optional="hide" string="Income Tax"/>
                    <field name="uan_number" optional="hide" string="UAN"/>
                </xpath>
            </field>
        </record>
        
        <!-- Extend Zoho Employee Data Tree View for India Components -->
        <record id="view_zoho_employee_data_tree_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.tree.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="inherit_id" ref="om_hr_payroll.view_zoho_employee_data_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='net_pay']" position="after">
                    <!-- India Calculated Components -->
                    <field name="actual_basic_salary" optional="hide" string="Act Basic"/>
                    <field name="actual_hra" optional="hide" string="Act HRA"/>
                    <field name="actual_pf" optional="hide" string="Act PF"/>
                    <field name="actual_prof_tax" optional="hide" string="Act Prof Tax"/>
                    <field name="india_gross_pay" optional="hide" string="IN Gross"/>
                    <field name="india_total_deductions" optional="hide" string="IN Deductions"/>
                    <field name="india_net_pay" optional="hide" string="IN Net Pay"/>
                </xpath>
            </field>
        </record>
        
        <!-- India Staging Data Pivot View -->
        <record id="view_zoho_staging_data_pivot_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.pivot.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="arch" type="xml">
                <pivot string="India Payroll Staging Data Analysis">
                    <field name="department" type="row"/>
                    <field name="designation" type="row"/>
                    <field name="employee_type" type="col"/>
                    <field name="employee_status" type="col"/>
                    <!-- India Salary Components as Measures -->
                    <field name="basic_salary" type="measure"/>
                    <field name="hra" type="measure"/>
                    <field name="special_allowance" type="measure"/>
                    <field name="books_periodicals" type="measure"/>
                    <field name="telephone_internet" type="measure"/>
                    <field name="leave_travel_allowance" type="measure"/>
                    <field name="pf" type="measure"/>
                    <field name="prof_tax" type="measure"/>
                    <field name="income_tax" type="measure"/>
                    <field name="base_salary" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <!-- India Employee Data Pivot View -->
        <record id="view_zoho_employee_data_pivot_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.pivot.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="arch" type="xml">
                <pivot string="India Employee Payroll Data Analysis">
                    <field name="department" type="row"/>
                    <field name="designation" type="row"/>
                    <field name="employee_type" type="col"/>
                    <!-- India Calculated Components as Measures -->
                    <field name="actual_basic_salary" type="measure"/>
                    <field name="actual_hra" type="measure"/>
                    <field name="actual_special_allowance" type="measure"/>
                    <field name="actual_books_periodicals" type="measure"/>
                    <field name="actual_telephone_internet" type="measure"/>
                    <field name="actual_lta" type="measure"/>
                    <field name="actual_pf" type="measure"/>
                    <field name="actual_prof_tax" type="measure"/>
                    <field name="actual_income_tax" type="measure"/>
                    <field name="pf_employer" type="measure"/>
                    <field name="esi_employer" type="measure"/>
                    <field name="india_gross_pay" type="measure"/>
                    <field name="india_total_deductions" type="measure"/>
                    <field name="india_net_pay" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <!-- India Staging Data Search View -->
        <record id="view_zoho_staging_data_search_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.search.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="inherit_id" ref="om_hr_payroll.view_zoho_staging_data_search"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@string='Group By']" position="inside">
                    <filter string="UAN Number" name="group_uan" domain="[]" context="{'group_by': 'uan_number'}"/>
                </xpath>
                <xpath expr="//field[@name='department']" position="after">
                    <field name="basic_salary"/>
                    <field name="hra"/>
                    <field name="pf"/>
                    <field name="uan_number"/>
                </xpath>
            </field>
        </record>
        
        <!-- India Employee Data Search View -->
        <record id="view_zoho_employee_data_search_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.search.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="inherit_id" ref="om_hr_payroll.view_zoho_employee_data_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='department']" position="after">
                    <field name="actual_basic_salary"/>
                    <field name="india_gross_pay"/>
                    <field name="india_net_pay"/>
                </xpath>
            </field>
        </record>
        
        <!-- India Staging Data Action -->
        <record id="action_zoho_staging_data_india" model="ir.actions.act_window">
            <field name="name">India Staging Data</field>
            <field name="res_model">zoho.staging.data</field>
            <field name="view_mode">tree,form,pivot</field>
            <field name="domain">['|', ('country', '=', 'IN'), ('country', '=', False)]</field>
            <field name="context">{'default_country': 'IN', 'search_default_country': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No India staging data found!
                </p>
                <p>
                    Import employee data from Zoho to see India payroll staging information.
                </p>
            </field>
        </record>
        
        <!-- India Employee Data Action -->
        <record id="action_zoho_employee_data_india" model="ir.actions.act_window">
            <field name="name">India Employee Payroll Data</field>
            <field name="res_model">zoho.employee.data</field>
            <field name="view_mode">tree,form,pivot</field>
            <field name="domain">['|', ('country', '=', 'IN'), ('country', '=', False)]</field>
            <field name="context">{'default_country': 'IN', 'search_default_country': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No India employee payroll data found!
                </p>
                <p>
                    Process payroll calculations in the spreadsheet to see India employee data.
                </p>
            </field>
        </record>
        
        <!-- India Staging Data Kanban View -->
        <record id="view_zoho_staging_data_kanban_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.kanban.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="full_name_en"/>
                    <field name="department"/>
                    <field name="designation"/>
                    <field name="basic_salary"/>
                    <field name="hra"/>
                    <field name="pf"/>
                    <field name="uan_number"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img alt="Avatar" t-att-src="kanban_image('zoho.staging.data', 'image_128', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="full_name_en"/>
                                    </strong>
                                    <div class="o_kanban_tags_section">
                                        <span class="o_kanban_tag">
                                            <i class="fa fa-building-o"/> <field name="department"/>
                                        </span>
                                        <span class="o_kanban_tag">
                                            <i class="fa fa-user"/> <field name="designation"/>
                                        </span>
                                    </div>
                                    <ul>
                                        <li><strong>Basic:</strong> ₹<field name="basic_salary"/></li>
                                        <li><strong>HRA:</strong> ₹<field name="hra"/></li>
                                        <li><strong>PF:</strong> ₹<field name="pf"/></li>
                                        <li><strong>UAN:</strong> <field name="uan_number"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- India Employee Data Kanban View -->
        <record id="view_zoho_employee_data_kanban_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.kanban.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="full_name_en"/>
                    <field name="department"/>
                    <field name="india_gross_pay"/>
                    <field name="india_net_pay"/>
                    <field name="actual_basic_salary"/>
                    <field name="actual_pf"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img alt="Avatar" t-att-src="kanban_image('zoho.employee.data', 'image_128', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="full_name_en"/>
                                    </strong>
                                    <div class="o_kanban_tags_section">
                                        <span class="o_kanban_tag">
                                            <i class="fa fa-building-o"/> <field name="department"/>
                                        </span>
                                    </div>
                                    <ul>
                                        <li><strong>Gross Pay:</strong> ₹<field name="india_gross_pay"/></li>
                                        <li><strong>Net Pay:</strong> ₹<field name="india_net_pay"/></li>
                                        <li><strong>Basic:</strong> ₹<field name="actual_basic_salary"/></li>
                                        <li><strong>PF:</strong> ₹<field name="actual_pf"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Update India Staging Data Action to include Kanban -->
        <record id="action_zoho_staging_data_india" model="ir.actions.act_window">
            <field name="view_mode">kanban,tree,form,pivot</field>
        </record>
        
        <!-- Update India Employee Data Action to include Kanban -->
        <record id="action_zoho_employee_data_india" model="ir.actions.act_window">
            <field name="view_mode">kanban,tree,form,pivot</field>
        </record>
        
        <!-- Menu Items for India -->
        <menuitem id="menu_india_staging_data"
                  name="📊 India Staging Data"
                  parent="pb_hr_payroll_indonesia.menu_india_payroll_root"
                  action="action_zoho_staging_data_india"
                  sequence="35"
                  groups="pb_hr_payroll_indonesia.group_india_payroll_user"/>
        
        <menuitem id="menu_india_employee_data"
                  name="📈 India Employee Data"
                  parent="pb_hr_payroll_indonesia.menu_india_payroll_root"
                  action="action_zoho_employee_data_india"
                  sequence="40"
                  groups="pb_hr_payroll_indonesia.group_india_payroll_user"/>
        
        <!-- Additional India Reports Menu -->
        <menuitem id="menu_india_reports_root"
                  name="📋 Reports"
                  parent="pb_hr_payroll_indonesia.menu_india_payroll_root"
                  sequence="50"
                  groups="pb_hr_payroll_indonesia.group_india_payroll_user"/>
        
        <menuitem id="menu_india_staging_reports"
                  name="Staging Data Analysis"
                  parent="menu_india_reports_root"
                  action="action_zoho_staging_data_india"
                  sequence="10"/>
        
        <menuitem id="menu_india_payroll_reports"
                  name="Payroll Data Analysis"
                  parent="menu_india_reports_root"
                  action="action_zoho_employee_data_india"
                  sequence="20"/>
        
    </data>
</odoo>