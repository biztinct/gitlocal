    def run_js_function(self, js_file_path, input_path, output_path):
        process = Popen(['node', js_file_path, input_path, output_path], stdin=PIPE, stdout=PIPE, stderr=PIPE)
        stdout, stderr = process.communicate()
        if stderr:
            self.env.user.notify_warning(message=f"JavaScript error: {stderr.decode('utf-8')}")
            raise Exception(f"JavaScript error: {stderr.decode('utf-8')}")
        if not stdout:
            raise Exception(f"No output from JavaScript function.")
        
        output = stdout.decode('utf-8')
        self.env.user.notify_info(message=f"JavaScript output: {output}")

    def col2num(self,col):
        num = 0
        for c in col:
            if c.isalpha():
                num = num * 26 + ord(c.upper()) - ord('A') + 1
        return num - 1  # Convert to zero-based index



    def export_spreadsheet_to_csv_then_xlsx(self, data):
        # Convert the Odoo spreadsheet data to an Excel file and save it to /tmp directory
        input_path = tempfile.NamedTemporaryFile(delete=False, suffix=".xlsx").name

        # Create a workbook and worksheet using openpyxl
        wb = openpyxl.Workbook()
        ws = wb.active
        ws.title = 'Staging'

        # Write data to the worksheet
        for sheet in data.get('sheets', []):
            if sheet['name'] == 'Staging':
                for cell, content in sheet.get('cells', {}).items():
                    col = ''.join(filter(str.isalpha, cell))  # Extract column letters
                    row = int(''.join(filter(str.isdigit, cell)))  # Extract row numbers
                    value = content.get('content', '')  # Safely get the 'content' or use an empty string if missing

                    # Write the value or formula to the worksheet
                    ws[f'{col}{row}'] = value

        # Save the workbook to the temporary path using openpyxl
        wb.save(input_path)

        # Define the output CSV file path
        csv_path = input_path.replace(".xlsx", ".csv")

        # Use LibreOffice to convert the Excel file to a CSV file
        call(f"libreoffice --headless --convert-to csv {input_path} --outdir {os.path.dirname(input_path)}", shell=True)

        # Set read permission for all users
        os.chmod(csv_path, 0o644)

        # Read the CSV file and convert it back to an Excel file using pandas
        df = pd.read_csv(csv_path)
        output_xlsx_path = tempfile.NamedTemporaryFile(delete=False, suffix=".xlsx").name
        df.to_excel(output_xlsx_path, index=False)

        # Set read permission for all users
        os.chmod(output_xlsx_path, 0o644)
        print (" Output file is : " + output_xlsx_path)
        return output_xlsx_path






