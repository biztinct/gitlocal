    def paste_as_values(self, file_path):
        # Open the workbook without data_only first to ensure formulas are calculated
        wb = openpyxl.load_workbook(file_path, data_only=False)
        
        # Save the workbook to ensure all formulas are calculated
        wb.save(file_path)
        
        # Reopen the workbook with data_only to get the values of the formulas
        wb = openpyxl.load_workbook(file_path, data_only=True)
        
        # Save the workbook again with values only
        wb.save(file_path)
        
        return wb




    def save_staging_to_final(self, data, wb, source_sheet_name, target_sheet_name):
        # Open the source and target sheets
        source_sheet = wb[source_sheet_name]
        
        # Get the Odoo Spreadsheet Final
        target_sheet = None
        for sheet in data.get('sheets', []):
            if sheet['name'] == target_sheet_name:
                target_sheet = sheet
                break

        if target_sheet is None:
            raise ValueError(f"Target sheet {target_sheet_name} not found in Odoo spreadsheet data.")

        # Copy values from source sheet (Staging) to target sheet (Final)
        for row_idx, row in enumerate(source_sheet.iter_rows(values_only=True), start=1):
            for col_idx, value in enumerate(row, start=1):
                cell_name = openpyxl.utils.get_column_letter(col_idx) + str(row_idx)
                target_sheet['cells'][cell_name] = {'content': str(value) if value is not None else ''}

