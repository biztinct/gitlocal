    def _default_from_date(self):
        today = date.today()
        # Get the 21st day of the previous month
        return (today.replace(day=1) - relativedelta(months=1)).replace(day=21)

    def _default_to_date(self):
        today = date.today()
        # Get the 20th day of the current month
        return today.replace(day=20)

    from_date = fields.Date(string="From Date", required=True, default=_default_from_date)
    to_date = fields.Date(string="To Date", required=True, default=_default_to_date)

