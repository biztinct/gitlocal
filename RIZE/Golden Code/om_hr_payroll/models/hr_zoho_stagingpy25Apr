    def import_timesheets(self):


        # 1. Get Zoho API Credentials (using refresh token)
        zoho_refresh_token = self.env['ir.config_parameter'].sudo().get_param('zoho.refresh_token')
        if not zoho_refresh_token:
            raise UserError("Zoho Refresh Token not configured. Please configure it in Settings.")
        zoho_client_id = self.env['ir.config_parameter'].sudo().get_param('zoho.client_id')
        if not zoho_client_id:
            raise UserError("Zoho Client Id not configured. Please configure it in Settings.")
        zoho_client_secret = self.env['ir.config_parameter'].sudo().get_param('zoho.client_secret')
        if not zoho_client_secret:
            raise UserError("Zoho Client Secret not configured. Please configure it in Settings.")

        # 2. Get Access Token using Refresh Token
        try:
            #set_trace()
            zoho_access_token = self._get_access_token(zoho_refresh_token, zoho_client_id , zoho_client_secret )
        except Exception as e:
            raise UserError(f"Error getting Zoho Access Token: {e}")

        try:
            # 3. Get Employee details from Zoho
            self._get_employee_details(zoho_access_token)

            # 4. Get Employee Attendance Data from Zoho
            self.import_attendance_data(zoho_access_token)


        except requests.exceptions.RequestException as e:
            raise UserError(f"Error connecting to Zoho API: {e}")

        return

