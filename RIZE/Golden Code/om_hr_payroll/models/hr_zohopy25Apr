    def _get_employee_details(self, access_token):
        """
        Fetches employee details from Zoho People and stores them in the zoho.employee.data model.
        """
        try:
            # 1. Clear existing data in zoho.employee.data
            self.env['zoho.employee.data'].search([]).unlink()

            # 2. Make the API call to get employee records
            url = "https://people.zoho.com/people/api/forms/employee/getRecords"
            headers = {
                "Authorization": f"Zoho-oauthtoken {access_token}"
            }
            params = {
                "sIndex": 1,
                "limit": 100,
                "dateFormat": "yyyy-MM-dd"  # Specify the desired date format
            }
            
            response = requests.get(url, headers=headers, params=params)
            response.raise_for_status()
            result = response.json()  # Assuming JSON response
            finalresult = result.get("response", {}).get("result", [])

            for record in finalresult:
                for key in record.keys():
                    details = record.get(key)
                    for employee_data in details:
                        # Extract all employee details
                        first_name = employee_data.get("FirstName")
                        last_name = employee_data.get("LastName")
                        email = employee_data.get("EmailID")
