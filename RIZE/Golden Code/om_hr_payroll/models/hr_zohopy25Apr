    def import_attendance_data(self, access_token):
        """
        Fetches attendance summary and overtime data from Zoho People and updates related records.
        """
        try:
            # --- Calculate Start and End Dates ---
            today = datetime.date.today()
            start_date = today.replace(day=1) - relativedelta(months=1)
            end_date = start_date + relativedelta(months=1, days=-1)

            # --- Format Dates ---
            formatted_start_date = start_date.strftime("%d-%m-%Y")
            formatted_end_date = end_date.strftime("%d-%m-%Y")

            # --- Fetch Attendance Summary Report ---
            url = f"https://people.zoho.com/people/api/attendance/getSummaryReport?dateFormat=dd-MM-yyyy&startDate={formatted_start_date}&endDate={formatted_end_date}"
            headers = {"Authorization": f"Zoho-oauthtoken {access_token}"}
            response = requests.get(url, headers=headers)
            response.raise_for_status()
            summary_report = response.json().get("summaryReport", [])
            for atten in summary_report:
                email_id = atten.get("emailId")
                employee_record = self.env['zoho.employee.data'].search([('email', '=', email_id)], limit=1)

                if employee_record:
                    # --- Fetch Overtime Data ---
                   
                    overtime_url = f"https://people.zoho.com/people/api/forms/overtime_request/getRecords"
                    params = {
                        "sIndex": 1,
                        "limit": 100,
                        "searchColumn": "EMPLOYEEMAILALIAS",
                        "searchValue": email_id,
                        #"searchValue": "chi.doan@abmauri.vn",
                        "dateFormat": "dd-MM-yyyy",  # Assuming this is the required date format
                        "fromDate": formatted_start_date,  # Use the calculated start_date
                        "toDate": formatted_end_date,    # Use the calculated end_date
                    }


                    #overtime_response = requests.get(overtime_url, headers=headers)
                    overtime_response = requests.get(overtime_url, headers=headers, params=params)
                    overtime_response.raise_for_status()
                    overtime_result = overtime_response.json().get("response", {}).get("result", [])

                    sum_of_ot_hours_150 = 0
                    sum_of_ot_hours_200 = 0
                    sum_of_ot_hours_n200 = 0
                    sum_of_ot_hours_210 = 0
                    sum_of_ot_hours_270 = 0
                    sum_of_ot_hours_390 = 0
                    sum_of_ot_hours_300 = 0

                    for overtime_record in overtime_result:
                        for key in overtime_record.keys():
                            details = overtime_record.get(key)
                            for overtime_data in details:
                                ot_type = overtime_data.get("OT_Type")
                                approval_status = overtime_data.get("ApprovalStatus")
                                ot_date_str = overtime_data.get("OT_Date")

                                if ot_type == "150%" and approval_status == "Approved" and ot_date_str:
                                    
                                    try:
                                        ot_date = datetime.datetime.strptime(ot_date_str, "%d-%m-%Y").date()
                                        if ot_date > start_date:
                                            sum_of_ot_hours_150 += float(overtime_data.get("Actual_OT_Hour", 0))
                                    except ValueError:
                                        _logger.warning(f"Failed to parse overtime date for employee: {email_id}")

                                if ot_type == "200%" and approval_status == "Approved" and ot_date_str:
                                    
                                    try:
                                        ot_date = datetime.datetime.strptime(ot_date_str, "%d-%m-%Y").date()
                                        if ot_date > start_date:
                                            sum_of_ot_hours_200 += float(overtime_data.get("Actual_OT_Hour", 0))
                                    except ValueError:
                                        _logger.warning(f"Failed to parse overtime date for employee: {email_id}")

                                if ot_type == "300%" and approval_status == "Approved" and ot_date_str:
                                    
                                    try:
                                        ot_date = datetime.datetime.strptime(ot_date_str, "%d-%m-%Y").date()
                                        if ot_date > start_date:
                                            sum_of_ot_hours_300 += float(overtime_data.get("Actual_OT_Hour", 0))
                                    except ValueError:
                                        _logger.warning(f"Failed to parse overtime date for employee: {email_id}")


                    # --- Calculate Attendance Data ---
                    expected_working_hours = atten.get("expectedWorkingHours", 0)
                    original_expected_hrs = expected_working_hours / 3600
                    total_worked_hours = atten.get("totalWorkedHours", 0)
                    original_total_worked_hours = total_worked_hours / 3600
                    paid_leave_hours_str = atten.get("paidLeaveHours")

                    if paid_leave_hours_str:
                        try:
                            hours, minutes = map(int, paid_leave_hours_str.split(':'))
                            paid_leave_seconds = hours * 3600 + minutes * 60
                        except ValueError:
                            paid_leave_seconds = 0
                            _logger.warning(f"Failed to parse paid leave hours for employee: {email_id}")
                    else:
                        paid_leave_seconds = 0

                    actual_worked_hours = paid_leave_seconds + total_worked_hours
                    original_actual_worked_hours = actual_worked_hours / 3600

                    # --- Update zoho.employee.data record ---
                    employee_record.write({
                        'standard_whr': original_expected_hrs,
                        'actual_working_hours_incl_paid_leave': original_actual_worked_hours,
                        'actual_working_hours_excl_paid_leave': original_total_worked_hours,
                        'overtime_normal_150_hour': sum_of_ot_hours_150,
                        'overtime_weekend_200_hour': sum_of_ot_hours_200,
                        'overtime_holiday_300_hour': sum_of_ot_hours_300,
                        'start_date': start_date,
                        'end_date': end_date,

                    })
        except requests.exceptions.RequestException as e:
            raise UserError(f"Error fetching data from Zoho People: {e}")

        return

