<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ==================================================================
         WHO MAY SEE A BATCH OF ARRIVALS.

         The engine re-checks `check_access('read')` before it lets anybody
         decide, and the HR lead a route names typically holds no integration
         role at all (ledger AM60). The narrow rule gives a person who has been
         ASKED to decide the read that seat needs, and nothing else.

         The wide rule ships WITH it and never without: rules are OR-ed over
         the groups a person is in, and an integration user is also a plain
         internal user — the narrow rule alone would take the batches away
         from the people whose job they are.
         ================================================================== -->

    <record id="rule_arrival_batch_company" model="ir.rule">
        <field name="name">Arrivals: company</field>
        <field name="model_id" ref="model_pb_zoho_arrival_batch"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_arrival_batch_seat" model="ir.rule">
        <field name="name">Arrivals: the ones I was asked to decide</field>
        <field name="model_id" ref="model_pb_zoho_arrival_batch"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('seat_user_ids', 'in', [user.id])]</field>
    </record>

    <record id="rule_arrival_batch_team" model="ir.rule">
        <field name="name">Arrivals: the people who look after them</field>
        <field name="model_id" ref="model_pb_zoho_arrival_batch"/>
        <field name="groups" eval="[
            (4, ref('pb_hr_payroll_base.group_payroll_integration_user')),
            (4, ref('pb_lifecycle.group_lifecycle_user')),
            (4, ref('pb_lifecycle.group_lifecycle_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
