<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- The welcome email, sent on joining day and not a minute before
             (ruling D6). It is OUR wording rather than the platform's standard
             invitation, because the standard one force-sends inside the request
             and deletes itself afterwards — a joining-day batch would either
             block on the mail server or leave no trace it ever ran.

             `email_to` is filled in here as documentation only. The recipient is
             passed explicitly at send time in `email_values`: a template's own
             rendered `email_to` can reach `mail.mail` EMPTY, and the message is
             then created, queued and addressed to nobody with no error anywhere
             (R6).

             The sign-in link is a computed field on the employee, never a
             stored one — a live credential does not belong in a column that
             every export can reach. -->
        <record id="mail_template_portal_credentials" model="mail.template">
            <field name="name">Welcome — your Payobook account is ready</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="subject">Welcome to {{ object.company_id.name }} — your Payobook account is ready</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin:0; padding:0; font-family:Inter, Arial, sans-serif; color:#1f2430;">
                    <p>Hello <t t-out="object.name or ''"/>,</p>
                    <p>Welcome to <t t-out="object.company_id.name or ''"/>. Your Payobook
                        account is ready — Payobook is where you will find your payslips,
                        your details and anything your team needs you to do.</p>
                    <p>Use the link below to choose your own password. It works once, and
                        only for you.</p>
                    <p style="margin:24px 0;">
                        <a t-att-href="object.pb_portal_signup_url"
                           style="background:#4338ca; color:#ffffff; padding:12px 22px;
                                  border-radius:8px; text-decoration:none;
                                  display:inline-block; font-weight:600;">
                            Set my password
                        </a>
                    </p>
                    <p style="font-size:13px; color:#5b6478;">If the button does not work,
                        copy this address into your browser:<br/>
                        <t t-out="object.pb_portal_signup_url or ''"/></p>
                    <p>If anything looks wrong, reply to this email and your HR team will
                        sort it out.</p>
                    <p>See you soon,<br/>
                        The <t t-out="object.company_id.name or ''"/> HR team</p>
                </div>
            </field>
        </record>

    </data>
</odoo>
