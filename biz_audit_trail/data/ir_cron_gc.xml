<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retention vacuum: purge audit entries past the configured window
         (biz_audit_trail.retention_days, default 730). Weekly is ample — the
         trail only grows, never spikes. Clock runs from write_date (C18.40). -->
    <record id="cron_biz_audit_gc" model="ir.cron">
        <field name="name">Audit Trail: retention vacuum</field>
        <field name="model_id" ref="model_biz_audit_entry"/>
        <field name="state">code</field>
        <field name="code">model.cron_gc()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
