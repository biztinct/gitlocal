<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company: a level with no company is offered everywhere; cost
         centres and their dated changes belong to one company. -->
    <record id="rule_pb_job_level_company" model="ir.rule">
        <field name="name">Job levels: own companies or every company</field>
        <field name="model_id" ref="model_pb_job_level"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pb_cost_centre_company" model="ir.rule">
        <field name="name">Cost centres: own companies</field>
        <field name="model_id" ref="model_pb_cost_centre"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pb_cost_centre_move_company" model="ir.rule">
        <field name="name">Cost centre changes: own companies</field>
        <field name="model_id" ref="model_pb_cost_centre_move"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
