#. module: pb_org_structure
#. odoo-python
#: code:addons/pb_org_structure/models/cost_centre.py:0
msgid ""
"\"%s\" is on contracts. Archive it instead, or move the people to another "
"cost centre first."
msgstr ""
"\"%s\" đang có trên hợp đồng. Hãy lưu trữ, hoặc chuyển mọi người sang trung "
"tâm chi phí khác trước."

#. module: pb_org_structure
#. odoo-python
#: code:addons/pb_org_structure/models/job_level.py:0
msgid ""
"\"%s\" is used by a job. Move the job to another level first, or archive the"
" level instead."
msgstr ""
"\"%s\" đang được một vị trí công việc dùng. Hãy chuyển vị trí đó sang cấp "
"bậc khác trước, hoặc lưu trữ cấp bậc."

#. module: pb_org_structure
#. odoo-python
#: code:addons/pb_org_structure/models/cost_centre.py:0
msgid ""
"%(n)s contracts carry the code \"%(code)s\", so it cannot be changed here — "
"that would rewrite what they say. Add a new cost centre and move people to "
"it from a date instead."
msgstr ""
"%(n)s hợp đồng đang mang mã \"%(code)s\", nên không thể đổi mã ở đây — làm "
"vậy sẽ viết lại nội dung các hợp đồng đó. Hãy thêm trung tâm chi phí mới và "
"chuyển mọi người sang từ một ngày."

#. module: pb_org_structure
#. odoo-python
#: code:addons/pb_org_structure/models/org_board.py:0
msgid "%(n)s jobs are at \"%(level)s\". Move them to another level first."
msgstr ""
"%(n)s vị trí đang ở cấp \"%(level)s\". Hãy chuyển chúng sang cấp khác trước."

#. module: pb_org_structure
#. odoo-javascript
#: code:addons/pb_org_structure/static/src/js/org_board.js:0
msgid "%(n)s people move to %(code)s from %(date)s."
msgstr "%(n)s người chuyển sang %(code)s từ %(date)s."

