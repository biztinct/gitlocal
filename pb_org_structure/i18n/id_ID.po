#. module: pb_org_structure
#. odoo-python
#: code:addons/pb_org_structure/models/cost_centre.py:0
msgid ""
"\"%s\" is on contracts. Archive it instead, or move the people to another "
"cost centre first."
msgstr ""
"\"%s\" ada di kontrak. Arsipkan saja, atau pindahkan orang-orangnya ke pusat"
" biaya lain terlebih dahulu."

#. module: pb_org_structure
#. odoo-python
#: code:addons/pb_org_structure/models/job_level.py:0
msgid ""
"\"%s\" is used by a job. Move the job to another level first, or archive the"
" level instead."
msgstr ""
"\"%s\" dipakai oleh sebuah jabatan. Pindahkan jabatan itu ke level lain "
"dulu, atau arsipkan level ini."

#. module: pb_org_structure
#. odoo-python
#: code:addons/pb_org_structure/models/cost_centre.py:0
msgid ""
"%(n)s contracts carry the code \"%(code)s\", so it cannot be changed here — "
"that would rewrite what they say. Add a new cost centre and move people to "
"it from a date instead."
msgstr ""
"%(n)s kontrak memakai kode \"%(code)s\", jadi kode ini tidak bisa diubah di "
"sini — itu akan mengubah isi kontrak tersebut. Tambahkan pusat biaya baru "
"dan pindahkan orang ke sana mulai suatu tanggal."

#. module: pb_org_structure
#. odoo-python
#: code:addons/pb_org_structure/models/org_board.py:0
msgid "%(n)s jobs are at \"%(level)s\". Move them to another level first."
msgstr ""
"%(n)s jabatan berada di level \"%(level)s\". Pindahkan dulu ke level lain."

