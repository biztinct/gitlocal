<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Government Reports privilege under PAYROLL category -->
    <record id="res_groups_privilege_govt_reports" model="res.groups.privilege">
        <field name="name">Government Reports</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="om_hr_payroll.module_category_payroll"/>
    </record>

    <record id="group_pb_hr_govt_user" model="res.groups">
        <field name="name">Government Reports User</field>
        <field name="privilege_id" ref="res_groups_privilege_govt_reports"/>
        <!-- Imply payroll user so wage-related models remain accessible -->
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
</odoo>
