        <field name="report_name">pb_hr_govt.bhxh630_xlsx</field>
        <field name="report_file">BHXH630</field>
        <field name="groups_id" eval="[(4, ref('pb_hr_govt.group_pb_hr_govt_user'))]"/>
        <field name="binding_model_id" ref="model_pb_govt_report_wizard"/>
        <field name="binding_type">report</field>
