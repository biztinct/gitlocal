        <field name="sequence">114</field>
        <field name="target">certificate</field>
        <field name="document_category_id" ref="pb_employee_vault.cat_certificate"/>
        <field name="name_pattern">First aid|sơ cứu</field>
        <field name="hours_required">16</field>
        <field name="validity_months">12</field>
        <field name="ratio_people">150</field>
        <field name="ratio_holders">1</field>
        <field name="note">Confirm before switching on. Circular 19/2016 Art 7 (secondary sources): at least one trained first-aider per 150 workers (per 100 on strict-safety sites), 16 hours, retrained yearly; every worker gets 4 hours. Confirm the ratio and the yearly hours.</field>
