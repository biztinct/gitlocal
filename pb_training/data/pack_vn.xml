        <field name="validity_months">24</field>
        <field name="refresher_hours">2</field>
        <field name="grace_days">30</field>
        <field name="note">Decree 44/2016: 4 hours on top of the person's own group, renewed every two years.</field>
    </record>

    <record id="req_vn_osh_retrain" model="pb.training.requirement">
        <field name="name">Safety retraining after a job change or a long absence</field>
        <field name="code">vn_osh_retrain</field>
        <field name="pack_key">vn_osh</field>
        <field name="kind">statutory</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="False"/>
        <field name="unverified" eval="True"/>
        <field name="needs_audience" eval="True"/>
        <field name="sequence">107</field>
        <field name="target">course</field>
        <field name="validity_months">12</field>
        <field name="note">Confirm before switching on. Decree 44/2016 Art 21.3: retrain before a new job, equipment or technology (unless trained in the last 12 months), and at half the hours after more than six months away. The system does not spot a job change or a long absence by itself yet: pick the people this applies to.</field>
    </record>

    <record id="req_vn_fire_g1" model="pb.training.requirement">
        <field name="name">Fire training — group 1</field>
        <field name="code">vn_fire_g1</field>
        <field name="pack_key">vn_osh</field>
        <field name="kind">statutory</field>
        <field name="company_id" eval="False"/>
        <field name="active" eval="False"/>
        <field name="unverified" eval="True"/>
        <field name="needs_audience" eval="True"/>
        <field name="sequence">111</field>
        <field name="target">certificate</field>
        <field name="document_category_id" ref="pb_employee_vault.cat_certificate"/>
        <field name="name_pattern">Fire training group 1|PCCC</field>
        <field name="hours_required">8</field>
        <field name="validity_months">60</field>
        <field name="refresher_hours">4</field>
        <field name="note">Confirm before switching on. Decree 105/2025 (secondary sources): facility heads, people in fire or explosion-risk areas and vehicle operators; 8 to 12 hours, a five-year cycle with a yearly refresher of 4 to 8 hours. Certificate from the fire police.</field>
    </record>

