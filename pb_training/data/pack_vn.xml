        <field name="document_category_id" ref="pb_employee_vault.cat_certificate"/>
        <field name="name_pattern">OSH group 5|nhóm 5</field>
        <field name="hours_required">16</field>
        <field name="validity_months">24</field>
        <field name="refresher_hours">8</field>
        <field name="grace_days">30</field>
        <field name="note">Decree 140/2018: occupational-health staff, 16 hours, renewed every two years at half the hours.</field>
    </record>

    <record id="req_vn_osh_g6" model="pb.training.requirement">
        <field name="name">Safety training — group 6 (safety-hygiene officers)</field>
        <field name="code">vn_osh_g6</field>
