<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <!-- ==================================================================
         LEARNING L1: the certificate ladder. Declared on the vault document
         (a certificate IS a vault document), sent by the morning job with an
         explicit `email_to` (R6) through `document._pb_training_mail`.
         noupdate="1" like every template here. Button colour is the brand
         purple #5A4BB0, never the retired bright indigo. The words come from
         the document's own `valid_words` ("Expires in 30 days") so a template
         never assembles a number into a frame (R117).
         ================================================================== -->

    <!-- ============ the person: 60 / 30 / 7 days, and the day ============ -->
    <record id="mail_template_certificate_expiring" model="mail.template">
        <field name="name">Training: a certificate of yours is running out</field>
        <field name="model_id" ref="pb_employee_vault.model_pb_employee_document"/>
        <field name="email_from">{{ (user.email_formatted) }}</field>
        <field name="email_to">{{ object.employee_id.work_email or '' }}</field>
        <field name="subject">{{ object.name }} — {{ object.valid_words }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;">
                <p>Hello <t t-out="object.employee_id.name or ''"/>,</p>
                <p>
                    Your <strong><t t-out="object.name or ''"/></strong> —
                    <strong><t t-out="object.valid_words or ''"/></strong>.
                </p>
                <p t-if="object.renewal_assignment_id">
                    The refresher course is already on your training page, to be
                    finished by <strong><t t-out="object.renewal_assignment_id.due_date or ''"/></strong>.
                    Finish it and pass the test, and a new certificate is filed for
                    you by itself.
                </p>
                <p t-elif="object.training_source == 'test' and object.channel_id">
                    The refresher course will be put on your training page before
                    it runs out. Nothing is needed from you today.
                </p>
                <p t-else="">
                    When you have the new one, add it from your certificates page
                    so your record stays up to date.
                </p>
                <p>
                    <a href="/my/training/certificates"
                       style="display:inline-block; padding:10px 18px; background:#5A4BB0; color:#ffffff; border-radius:8px; text-decoration:none;">
                        My certificates
                    </a>
                </p>
                <br/>
                The training team
            </div>
        </field>
    </record>

    <!-- ============ their manager: 14 days out ============ -->
    <record id="mail_template_certificate_expiring_manager" model="mail.template">
        <field name="name">Training: a certificate in your team is running out</field>
        <field name="model_id" ref="pb_employee_vault.model_pb_employee_document"/>
        <field name="email_from">{{ (user.email_formatted) }}</field>
        <field name="email_to">{{ object.employee_id.parent_id.work_email or '' }}</field>
        <field name="subject">{{ object.employee_id.name }}: {{ object.name }} — {{ object.valid_words }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;">
                <p>Hello,</p>
                <p>
                    <strong><t t-out="object.employee_id.name or ''"/></strong>'s
                    <strong><t t-out="object.name or ''"/></strong> —
                    <strong><t t-out="object.valid_words or ''"/></strong>.
                </p>
                <p t-if="object.renewal_assignment_id">
                    They are already on the refresher course, to be finished by
                    <strong><t t-out="object.renewal_assignment_id.due_date or ''"/></strong>.
                    A word from you that it matters would help.
                </p>
                <p t-else="">
                    If their work needs it, make sure they have time to renew it
                    before the date.
                </p>
                <br/>
                The training team
            </div>
        </field>
    </record>

    <!-- ============ the HR lead: on the day ============ -->
    <record id="mail_template_certificate_expired_hr" model="mail.template">
        <field name="name">Training: a certificate runs out today</field>
        <field name="model_id" ref="pb_employee_vault.model_pb_employee_document"/>
        <field name="email_from">{{ (user.email_formatted) }}</field>
        <field name="subject">{{ object.employee_id.name }}: {{ object.name }} runs out today</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;">
                <p>Hello,</p>
                <p>
                    <strong><t t-out="object.employee_id.name or ''"/></strong>'s
                    <strong><t t-out="object.name or ''"/></strong> runs out today
                    and no newer one is on their record.
                </p>
                <p>
                    Open Learning, then Certificates, to see who else is close, add
                    a new certificate for them, or put them on the refresher course.
                </p>
                <br/>
                The training team
            </div>
        </field>
    </record>
</data>
</odoo>
