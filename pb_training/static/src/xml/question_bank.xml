<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pb_training.QuestionBankWidget">
    <div class="pb-bank-entry">
      <div><strong>Bring in a question you already trust</strong><span>Find, preview and reuse approved questions. Each addition keeps its own copy.</span></div>
      <button type="button" class="btn btn-primary" t-on-click="open" t-att-disabled="state.busy or props.readonly"><i class="fa fa-book me-2" aria-hidden="true"/><t t-if="needsSave">Save draft &amp; browse question bank</t><t t-else="">Add from question bank</t></button>
    </div>
  </t>
  <t t-name="pb_training.QuestionBankRefresh">
    <button type="button" class="btn btn-secondary" t-on-click="refresh" t-att-disabled="state.busy or props.readonly" title="Replace this draft question with the latest approved library version. Available only before publication or learner attempts.">Update draft from library</button>
  </t>
  <t t-name="pb_training.QuestionBankPicker">
    <Dialog title="'Add from question bank'" size="'xl'" contentClass="'pb-bank-dialog'" bodyClass="'pb-bank-body'">
      <div class="pb-bank-picker">
        <div class="pb-bank-banner"><div><span class="pb-bank-eyebrow">YOUR SHARED QUESTION LIBRARY</span><h3>Good questions deserve to be reused.</h3><p t-if="lesson">Choose text-based choice questions for this lesson’s knowledge check.</p><p t-else="">Choose individual questions or build a balanced pool for each attempt.</p></div><span class="pb-bank-count"><t t-out="state.total"/> matching</span></div>
        <div class="pb-bank-error" role="alert" t-if="state.error" t-out="state.error"/>
        <div class="pb-bank-layout">
          <aside class="pb-bank-filters" aria-label="Question filters">
            <div class="pb-bank-filter-heading"><strong>Find the right fit</strong><button type="button" class="btn btn-link" t-on-click="reset">Reset</button></div>
            <label for="pb-bank-search">Search questions or QB reference</label><input id="pb-bank-search" type="search" class="form-control" placeholder="e.g. soil texture" t-att-value="state.filters.query" t-on-input="queryChanged"/>
            <t t-foreach="lookups.slice(0, 1)" t-as="item" t-key="item.key"><label t-att-for="'pb-bank-' + item.key" t-out="item.label"/><Many2XAutocomplete id="'pb-bank-' + item.key" fieldString="item.label" resModel="item.model" value="state.labels[item.key] || ''" activeActions="lookupActions" getDomain.bind="domain" update="(records) => this.lookupChanged(item.key, records)" placeholder="'Search all topics…'"/></t>
            <label for="pb-bank-difficulty">Difficulty</label><select id="pb-bank-difficulty" class="form-select" t-att-value="state.filters.difficulty || ''" t-on-change="(ev) => this.filterChanged('difficulty', ev)"><option value="">All difficulties</option><option value="basic">Basic</option><option value="intermediate">Intermediate</option><option value="advanced">Advanced</option></select>
            <label for="pb-bank-type">Question type</label><select id="pb-bank-type" class="form-select" t-att-value="state.filters.type || ''" t-on-change="(ev) => this.filterChanged('type', ev)"><option value="">All compatible types</option><option t-foreach="types" t-as="type" t-key="type[0]" t-att-value="type[0]" t-out="type[1]"/></select>
            <button class="btn btn-link pb-bank-more" type="button" t-on-click="() => state.advancedFilters = !state.advancedFilters" t-att-aria-expanded="state.advancedFilters">More filters <i class="fa fa-angle-down"/></button>
            <div t-if="state.advancedFilters">
              <t t-foreach="lookups.slice(1)" t-as="item" t-key="item.key"><label t-att-for="'pb-bank-' + item.key" t-out="item.label"/><Many2XAutocomplete id="'pb-bank-' + item.key" fieldString="item.label" resModel="item.model" value="state.labels[item.key] || ''" activeActions="lookupActions" getDomain.bind="domain" update="(records) => this.lookupChanged(item.key, records)" placeholder="'Search…'"/></t>
              <label for="pb-bank-state">Review status</label><select id="pb-bank-state" class="form-select" t-att-value="state.filters.state" t-on-change="(ev) => this.filterChanged('state', ev)"><option value="approved">Approved</option><option value="draft">Needs review</option><option value="archived">Archived</option><option value="">All statuses</option></select>
              <label class="pb-bank-check"><input type="checkbox" t-att-checked="state.filters.scored" t-on-change="(ev) => this.filterChanged('scored', ev)"/> Scored questions only</label>
            </div>
            <label class="pb-bank-check"><input type="checkbox" t-att-checked="state.filters.unused" t-on-change="(ev) => this.filterChanged('unused', ev)"/> Hide questions already included</label>
          </aside>
          <main class="pb-bank-results" aria-label="Matching questions" t-att-aria-busy="state.loading">
            <div class="pb-bank-results-toolbar"><button class="btn btn-link" type="button" t-on-click="selectPage" t-att-disabled="state.loading">Select this page</button><select aria-label="Sort questions" class="form-select" t-on-change="(ev) => this.filterChanged('sort', ev)"><option value="recent">Recently updated</option><option value="title">Question title</option><option value="oldest">Oldest updated</option></select></div>
            <p t-if="state.loading" role="status" class="pb-bank-empty">Finding questions…</p>
            <div t-elif="!state.rows.length" class="pb-bank-empty"><i class="fa fa-search"/><strong>No questions match yet</strong><p>Try fewer filters. Existing questions start in Needs review; approve them in the Question bank before reuse.</p></div>
            <div t-else="" class="pb-bank-question-list">
              <article t-foreach="state.rows" t-as="q" t-key="q.id" t-att-class="'pb-bank-question ' + (state.selected[q.id] ? 'is-selected' : '')">
                <input type="checkbox" t-att-aria-label="'Select ' + q.title" t-att-checked="!!state.selected[q.id]" t-att-disabled="q.used || !!q.problem || q.state !== 'approved'" t-on-change="() => this.toggle(q)"/>
                <button type="button" class="pb-bank-preview-button" t-on-click="() => this.preview(q)"><span class="pb-bank-reference"><t t-out="q.code"/> · v<t t-out="q.version"/></span><strong t-out="q.title"/><span class="pb-bank-chips"><span t-out="typeLabel(q.type)"/><span t-out="q.difficulty"/><span t-out="q.topic"/></span><small t-if="q.used">Already included</small><small t-elif="q.state !== 'approved'">Review required before reuse</small><small t-elif="q.problem" t-out="q.problem"/></button>
              </article>
            </div>
            <div class="pb-bank-pagination"><button type="button" class="btn btn-secondary" t-att-disabled="state.offset === 0 || state.loading" t-on-click="() => this.page(-1)">Previous</button><span><t t-out="state.total ? state.offset + 1 : 0"/>–<t t-out="end"/> of <t t-out="state.total"/></span><button type="button" class="btn btn-secondary" t-att-disabled="end >= state.total || state.loading" t-on-click="() => this.page(1)">Next</button></div>
          </main>
          <aside class="pb-bank-preview" aria-label="Question preview">
            <t t-if="state.preview"><div class="pb-bank-filter-heading"><strong>Question preview</strong><span t-out="state.preview.code"/></div><h4 t-out="state.preview.title"/><div class="pb-bank-description" t-out="html(state.preview.description)"/>
              <ul class="pb-bank-answers"><li t-foreach="state.preview.answers" t-as="a" t-key="a.id" t-att-class="a.correct ? 'is-correct' : ''"><i t-att-class="a.correct ? 'fa fa-check-circle' : 'fa fa-circle-o'"/><span><t t-out="a.text"/><img t-if="a.image" t-att-src="'/web/image/survey.question.answer/' + a.id + '/value_image'" alt="Answer illustration"/></span><small><t t-out="a.points"/> pts</small></li></ul>
              <p t-if="state.preview.correct_answer"><strong>Correct answer: </strong><t t-out="state.preview.correct_answer"/> · <t t-out="state.preview.score"/> pts</p><p t-if="state.preview.scale">Scale: <t t-out="state.preview.scale"/></p>
              <div t-if="state.preview.matrix_rows.length"><strong>Matrix rows</strong><p t-foreach="state.preview.matrix_rows" t-as="row" t-key="row_index" t-out="row"/></div>
              <div t-if="state.preview.explanation" class="pb-bank-explanation"><strong>Why this answer?</strong><p t-out="state.preview.explanation"/></div><p class="pb-bank-provenance"><t t-out="state.preview.source"/><br/>Used in <t t-out="state.preview.usage"/> question copies</p>
            </t><div t-else="" class="pb-bank-empty"><i class="fa fa-eye"/><strong>Look before you add</strong><p>Select a question title to inspect its answers, points and explanation.</p></div>
          </aside>
        </div>
        <section class="pb-bank-selection" aria-label="Selected questions">
          <div class="pb-bank-filter-heading"><strong><t t-out="selectedCount"/> selected across all pages</strong><button type="button" class="btn btn-link" t-on-click="clearSelection" t-att-disabled="!selectedCount">Clear selection</button></div>
          <div class="pb-bank-selected-chips"><button t-foreach="selection" t-as="q" t-key="q.id" type="button" t-on-click="() => this.toggle(q)" t-att-title="'Remove ' + q.title"><span t-out="q.title"/><i class="fa fa-times"/></button></div>
          <div t-if="!lesson" class="pb-bank-destination"><label>Add as<select class="form-select" t-model="state.mode"><option value="specific">Specific questions</option><option value="pool">Random question pool</option></select></label><label t-if="state.mode === 'specific'">Destination section<select class="form-select" t-model="state.section"><option value="">Before sections / always asked</option><option t-foreach="state.sections" t-as="section" t-key="section.id" t-att-value="section.id" t-out="section.name"/></select></label></div>
          <div t-if="state.mode === 'pool'" class="pb-bank-pool"><p>Each attempt draws from these fixed question copies. Future library additions will not change this pool.</p><label class="pb-bank-check"><input type="checkbox" t-model="state.balanced"/> Balance by difficulty</label><div t-if="state.balanced" class="pb-bank-pool-counts"><label t-foreach="['basic','intermediate','advanced']" t-as="difficulty" t-key="difficulty"><t t-out="difficulty"/> · <t t-out="poolCounts[difficulty]"/> selected<input type="number" min="0" t-att-max="poolCounts[difficulty]" class="form-control" t-model="state[difficulty]"/></label></div><div t-else="" class="pb-bank-destination"><label>Pool name<input class="form-control" t-model="state.poolName"/></label><label>Questions per attempt<input type="number" min="1" t-att-max="selectedCount" class="form-control" t-model="state.draw"/></label></div><p t-if="poolError" class="pb-bank-validation" role="status" t-out="poolError"/></div>
        </section>
      </div>
      <t t-set-slot="footer"><span class="pb-bank-footer-note">Copies are saved to this draft. Learner results stay unchanged.</span><button type="button" class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.adding">Cancel</button><button type="button" class="btn btn-primary" t-on-click="add" t-att-disabled="!canAdd"><t t-if="state.adding">Adding…</t><t t-elif="state.mode === 'pool'">Create question pool</t><t t-else="">Add <t t-out="selectedCount"/> questions</t></button></t>
    </Dialog>
  </t>
</templates>
