<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ====================================================================
       Learning › Courses › OUTSIDE (LEARNING L5). The Sessions tab's look
       (`.pbss-*`) plus a few `.pbcl-*` pieces. Section comments use `=`
       rules (R35); every translatable text node on one line (LN13); every
       scrim is a direct child of the root (R114).
       ==================================================================== -->
  <t t-name="pb_training.PbOutsideLens">
    <div class="pbim pbss pbss-vars pbcl" t-att-class="{ 'pbss--embedded': props.embedded }">
      <div class="pbss-wrap">

        <div t-if="!state.loaded" class="pbss-hero pbss-skel" aria-busy="true">
          <div class="pbss-skel-line pbss-skel-line--s"/>
          <div class="pbss-skel-line"/>
        </div>

        <div t-elif="state.failed" class="pbss-panel pbss-empty">
          <div class="pbss-empty-ic"><t t-out="ic('alert',26)"/></div>
          <h2>The outside courses could not be read just now</h2>
          <p>Nothing was changed. Try again in a moment.</p>
          <button class="pbim-btn primary" t-on-click="retry"><t t-out="ic('refresh',15)"/> Try again</button>
        </div>

        <div t-elif="!allowed" class="pbss-panel pbss-empty">
          <div class="pbss-empty-ic"><t t-out="ic('lock',26)"/></div>
          <h2>The outside list is kept by the training team</h2>
          <p>To ask for a course, open My learning and press Ask to take a course.</p>
        </div>

        <!-- ================= one outside course ================= -->
        <t t-elif="page">
          <button class="pbim-btn ghost pbss-back" t-on-click="closePage"><t t-out="ic('back',15)"/> Every outside course</button>
          <div t-if="page.loading" class="pbss-hero pbss-skel"><div class="pbss-skel-line"/></div>
          <t t-else="">
            <section class="pbss-hero">
              <div class="pbss-hero-top">
                <div class="pbss-hero-id">
                  <div class="pbss-eyebrow"><t t-out="ic('graduationCap',13)"/> <t t-esc="page.kind_word"/></div>
                  <h1 class="pbss-title" t-esc="page.name"/>
                  <div class="pbss-meta">
                    <span t-if="page.provider"><t t-out="ic('building',14)"/> <t t-esc="page.provider"/></span>
                    <span><t t-out="ic('banknote',14)"/> <t t-esc="page.cost_words"/></span>
                    <span t-if="page.hours_words"><t t-out="ic('clock',14)"/> <t t-esc="page.hours_words"/></span>
                    <span t-if="page.certificate_words"><t t-out="ic('award',14)"/> <t t-esc="page.certificate_words"/></span>
                    <span t-if="page.rating_words"><t t-out="ic('star',14)"/> <t t-esc="page.rating_words"/></span>
                    <a t-if="page.url" t-att-href="page.url" target="_blank" rel="noopener"><t t-out="ic('external',14)"/> The provider's page</a>
                  </div>
                  <p t-if="page.blurb" class="pbcl-blurb" t-esc="page.blurb"/>
                  <div t-if="page.jobs.length" class="pbss-chips"><span t-foreach="page.jobs" t-as="jb" t-key="jb_index" class="pbss-chip"><t t-out="ic('briefcase',12)"/> <t t-esc="jb"/></span></div>
                </div>
                <span t-if="!page.active" class="pbss-state is-bad">Archived</span>
              </div>
              <div t-if="page.can_write" class="pbss-actions">
                <button t-if="page.active" class="pbim-btn primary" t-on-click="() => this.openPut(page)"><t t-out="ic('userPlus',15)"/> Put someone on it</button>
                <button class="pbim-btn ghost" t-on-click="editCourse"><t t-out="ic('pencil',15)"/> Edit</button>
                <button t-if="page.active" class="pbim-btn ghost" t-on-click="() => this.archive(false)"><t t-out="ic('archive',15)"/> Archive</button>
                <button t-else="" class="pbim-btn ghost" t-on-click="() => this.archive(true)"><t t-out="ic('undo',15)"/> Bring it back</button>
              </div>
              <p class="pbss-next"><t t-out="ic('info',14)"/> People ask for it from My learning. Their manager decides, then the HR lead when it costs money; the cost is set aside from their allowance and claimed back with the receipt and the certificate.</p>
            </section>

            <section class="pbss-panel">
              <div class="pbss-sec-h"><h3>Who asked <span class="pbss-n" t-esc="page.people.length"/></h3></div>
              <div t-if="!page.people.length" class="pbss-calm"><t t-out="ic('info',14)"/> Nobody has asked for it yet.</div>
              <div t-else="" class="pbss-scroll">
                <table class="pbss-table">
                  <thead><tr><th>Name</th><th>Where it is</th><th>What it costs</th><th>When</th><th>Why</th></tr></thead>
                  <tbody>
                    <tr t-foreach="page.people" t-as="req" t-key="req.id">
                      <td><b class="pbss-who" t-esc="req.who"/><span class="pbss-dim" t-esc="req.department"/></td>
                      <td><span class="pbss-state" t-att-class="stateClass(req)" t-esc="req.state_word"/></td>
                      <td t-esc="req.amount_words"/>
                      <td t-esc="req.when_words"/>
                      <td class="pbcl-why" t-esc="req.why"/>
                    </tr>
                  </tbody>
                </table>
              </div>
            </section>

            <div class="pbcl-two">
              <section class="pbss-panel">
                <div class="pbss-sec-h"><h3>What people said</h3></div>
                <div t-if="!page.ratings.ratings_count" class="pbss-calm"><t t-out="ic('info',14)"/> No ratings yet. Everybody who takes it is asked two ratings and one line.</div>
                <t t-else="">
                  <div class="pbcl-score">
                    <span class="pbcl-score-n" t-esc="page.ratings.avg_rating"/>
                    <span class="pbcl-score-l"><t t-out="ic('star',14)"/> <t t-esc="pageScoreWords"/></span>
                  </div>
                  <ul class="pbcl-comments"><li t-foreach="page.ratings.comments" t-as="cm" t-key="cm_index" t-esc="cm.text"/></ul>
                </t>
              </section>
              <section class="pbss-panel">
                <div class="pbss-sec-h">
                  <h3>Skills it gives <span class="pbss-n" t-esc="page.grants.length"/></h3>
                  <button t-if="page.can_write" class="pbim-btn ghost" t-on-click="openGrant"><t t-out="ic('plus',14)"/> Add a skill</button>
                </div>
                <div t-if="!page.grants.length" class="pbss-calm"><t t-out="ic('info',14)"/> None yet. A skill added here goes on a person's record when the training team marks the course taken or the claim is agreed.</div>
                <div t-else="" class="pbss-chips">
                  <span t-foreach="page.grants" t-as="gr" t-key="gr.id" class="pbss-chip is-go"><t t-out="ic('sparkles',12)"/> <t t-esc="gr.words"/><button t-if="page.can_write" class="pbss-x" t-on-click="() => this.dropGrant(gr.id)" title="This course no longer gives it"><t t-out="ic('x',12)"/></button></span>
                </div>
              </section>
            </div>

            <section t-if="page.claims.length" class="pbss-panel">
              <div class="pbss-sec-h"><h3>Claims against it <span class="pbss-n" t-esc="page.claims.length"/></h3></div>
              <div class="pbss-scroll">
                <table class="pbss-table">
                  <thead><tr><th>Name</th><th>Amount</th><th>Where it is</th></tr></thead>
                  <tbody>
                    <tr t-foreach="page.claims" t-as="clm" t-key="clm.id"><td t-esc="clm.who"/><td t-esc="clm.amount_words"/><td t-esc="clm.state_word"/></tr>
                  </tbody>
                </table>
              </div>
            </section>
          </t>
        </t>

        <!-- ================= the catalogue ================= -->
        <t t-else="">
          <section class="pbss-hero">
            <div class="pbss-hero-top">
              <div class="pbss-hero-id">
                <div class="pbss-eyebrow"><t t-out="ic('graduationCap',13)"/> Outside courses</div>
                <p class="pbss-headline" t-esc="data.headline"/>
                <p t-if="kpis.spend" class="pbss-note" t-esc="spendWords"/>
              </div>
              <div t-if="data.can_write" class="pbss-hero-act">
                <button class="pbim-btn primary" t-on-click="newCourse"><t t-out="ic('plus',15)"/> New outside course</button>
              </div>
            </div>
          </section>

          <t t-call="pb_import_kit.QuietGlance">
            <t t-set="qGlance" t-value="glance"/>
            <t t-set="qGlanceOn" t-value="state.f.archived ? 'archived' : ''"/>
          </t>

          <div class="pbss-bar">
            <label class="pbss-search"><t t-out="ic('search',14)"/><input type="search" placeholder="Find a course or a provider" t-att-value="state.f.q" t-on-input="onSearch"/></label>
            <div class="pbss-modes" role="group">
              <button t-foreach="state.lists.kinds" t-as="kd" t-key="kd.key" class="pbss-filter" t-att-class="{ 'is-on': state.f.kind === kd.key }" t-on-click="() => this.setKind(kd.key)" t-esc="kd.label"/>
            </div>
            <select t-if="state.lists.jobs.length" class="pbss-in pbcl-select" t-on-change="onJob" aria-label="Good for this job">
              <option value="0">Any job</option>
              <t t-foreach="state.lists.jobs" t-as="jb" t-key="jb.id"><option t-att-value="jb.id" t-att-selected="state.f.job_id === jb.id" t-esc="jb.name"/></t>
            </select>
            <button t-if="anyFilter" class="pbim-btn ghost" t-on-click="clearFilters"><t t-out="ic('x',14)"/> Show everything</button>
          </div>

          <div t-if="!rows.length and !anyFilter" class="pbss-panel pbss-empty">
            <div class="pbss-empty-ic"><t t-out="ic('graduationCap',26)"/></div>
            <h2>No outside courses yet</h2>
            <p>An outside course is one somebody else runs — a college, a licensing body, an online school. Put the ones you are willing to pay for on this list with the link, the cost and the hours. People ask for them from My learning; their manager decides.</p>
            <div t-if="data.can_write" class="pbss-empty-act"><button class="pbim-btn primary" t-on-click="newCourse"><t t-out="ic('plus',15)"/> Add the first one</button></div>
          </div>
          <div t-elif="!rows.length" class="pbss-panel pbss-empty">
            <div class="pbss-empty-ic"><t t-out="ic('search',26)"/></div>
            <h2>No outside course matches that</h2>
            <button class="pbim-btn ghost" t-on-click="clearFilters">Show everything</button>
          </div>

          <div t-else="" class="pbss-grid">
            <div t-foreach="rows" t-as="oc" t-key="oc.id" class="pbss-card pbcl-card" t-att-class="{ 'is-amber': oc.waiting, 'is-rose': !oc.active }" role="button" tabindex="0" t-on-click="() => this.openPage(oc.id)" t-on-keydown="(ev) => ev.key === 'Enter' and this.openPage(oc.id)">
              <div class="pbss-card-top">
                <div>
                  <div class="pbss-card-name" t-esc="oc.name"/>
                  <span class="pbss-dim" t-esc="oc.provider"/>
                </div>
                <span class="pbss-state is-go">Outside</span>
              </div>
              <div class="pbss-chips">
                <span class="pbss-chip" t-esc="oc.kind_word"/>
                <span class="pbss-chip"><t t-out="ic('banknote',12)"/> <t t-esc="oc.cost_words"/></span>
                <span t-if="oc.hours_words" class="pbss-chip"><t t-out="ic('clock',12)"/> <t t-esc="oc.hours_words"/></span>
                <span t-if="oc.issues_certificate" class="pbss-chip"><t t-out="ic('award',12)"/> Certificate</span>
                <span t-if="oc.rating_words" class="pbss-chip"><t t-out="ic('star',12)"/> <t t-esc="oc.rating_words"/></span>
              </div>
              <p t-if="oc.blurb" class="pbcl-card-blurb" t-esc="oc.blurb"/>
              <div class="pbcl-card-foot">
                <span t-if="oc.waiting" class="pbss-chip is-warn"><t t-out="ic('hourglass',12)"/> <t t-esc="waitingWords(oc.waiting)"/></span>
                <span class="pbss-dim-i" t-esc="takenWords(oc)"/>
                <button t-if="data.can_write and oc.active" class="pbim-btn ghost" t-on-click.stop="() => this.openPut(oc)"><t t-out="ic('userPlus',14)"/> Put someone on it</button>
              </div>
            </div>
          </div>
        </t>
      </div>

      <!-- ================= the course drawer ================= -->
      <div t-if="state.drawer === 'course'" class="pbim-modal-scrim pbss-scrim" t-on-click="closeDrawer">
        <div class="pbss-drawer" t-on-click.stop="() => {}">
          <div class="pbss-drawer-head">
            <div>
              <div class="pbss-eyebrow"><t t-if="state.form.id">Edit the outside course</t><t t-else="">New outside course</t></div>
              <h2 class="pbss-drawer-title">What it is, who runs it, what it costs</h2>
            </div>
            <button class="pbim-btn ghost" t-on-click="closeDrawer" title="Close"><t t-out="ic('x',16)"/></button>
          </div>
          <div class="pbss-drawer-body">
            <label class="pbss-f pbss-f--wide"><span class="pbss-f-l">Course</span><input class="pbss-in" type="text" placeholder="What the provider calls it" t-att-value="state.form.name" t-on-input="(ev) => this.setField('name', ev)"/></label>
            <label class="pbss-f"><span class="pbss-f-l">Who runs it</span><input class="pbss-in" type="text" t-att-value="state.form.provider" t-on-input="(ev) => this.setField('provider', ev)"/></label>
            <label class="pbss-f"><span class="pbss-f-l">How it is taught</span>
              <select class="pbss-in" t-on-change="(ev) => this.setField('kind', ev)">
                <t t-foreach="state.lists.kinds" t-as="kd" t-key="kd.key"><option t-att-value="kd.key" t-att-selected="state.form.kind === kd.key" t-esc="kd.label"/></t>
              </select>
            </label>
            <label class="pbss-f pbss-f--wide"><span class="pbss-f-l">Link</span><input class="pbss-in" type="text" placeholder="https://" t-att-value="state.form.url" t-on-input="(ev) => this.setField('url', ev)"/></label>
            <label class="pbss-f"><span class="pbss-f-l">What it costs (<t t-esc="state.lists.currency"/>, 0 if free)</span><input class="pbss-in" type="number" min="0" t-att-value="state.form.cost" t-on-change="(ev) => this.setField('cost', ev, 'num')"/></label>
            <label class="pbss-f"><span class="pbss-f-l">Hours</span><input class="pbss-in pbss-in--s" type="number" min="0" step="0.5" t-att-value="state.form.hours" t-on-change="(ev) => this.setField('hours', ev, 'num')"/></label>
            <label class="pbss-f pbss-f--wide"><span class="pbss-f-l">What it is, in a sentence or two</span><textarea class="pbss-in" rows="3" t-att-value="state.form.blurb" t-on-input="(ev) => this.setField('blurb', ev)"/></label>
            <label class="pbss-f pbcl-check"><input type="checkbox" t-att-checked="state.form.issues_certificate" t-on-change="(ev) => this.setField('issues_certificate', ev)"/> Ends with a certificate</label>
            <label t-if="state.form.issues_certificate" class="pbss-f"><span class="pbss-f-l">Valid for (months, 0 = does not run out)</span><input class="pbss-in pbss-in--s" type="number" min="0" t-att-value="state.form.validity_months" t-on-change="(ev) => this.setField('validity_months', ev, 'num')"/></label>
            <div t-if="state.lists.jobs.length" class="pbss-f pbss-f--wide">
              <span class="pbss-f-l">Good for these jobs</span>
              <div class="pbss-modes"><button t-foreach="state.lists.jobs" t-as="jb" t-key="jb.id" class="pbss-filter" t-att-class="{ 'is-on': state.form.job_ids.includes(jb.id) }" t-on-click="() => this.toggleJob(jb.id)" t-esc="jb.name"/></div>
            </div>
          </div>
          <div class="pbss-drawer-foot">
            <span t-if="courseHint" class="pbss-hint" t-esc="courseHint"/>
            <button class="pbim-btn ghost" t-on-click="closeDrawer">Cancel</button>
            <button class="pbim-btn primary" t-att-disabled="!!courseHint or state.busy" t-on-click="saveCourse"><t t-out="ic('check',15)"/> Save</button>
          </div>
        </div>
      </div>

      <!-- ================= put someone on it ================= -->
      <div t-if="state.drawer === 'put'" class="pbim-modal-scrim pbss-scrim" t-on-click="closeDrawer">
        <div class="pbss-drawer" t-on-click.stop="() => {}">
          <div class="pbss-drawer-head">
            <div>
              <div class="pbss-eyebrow">Put someone on it</div>
              <h2 class="pbss-drawer-title" t-esc="state.put.course.name"/>
              <p class="pbss-note" t-esc="putNote"/>
            </div>
            <button class="pbim-btn ghost" t-on-click="closeDrawer" title="Close"><t t-out="ic('x',16)"/></button>
          </div>
          <div class="pbss-drawer-body">
            <div class="pbss-f pbss-f--wide">
              <span class="pbss-f-l">Who</span>
              <input class="pbss-in" type="search" placeholder="Find somebody by name — accents and all" t-att-value="state.put.term" t-on-input="onPutTerm"/>
              <div t-if="state.put.rows.length" class="pbss-picklist">
                <label t-foreach="state.put.rows" t-as="emp" t-key="emp.id" class="pbss-pick" t-att-class="{ 'is-on': state.put.picked.includes(emp.id) }">
                  <input type="checkbox" class="pbss-pick-box" t-att-checked="state.put.picked.includes(emp.id)" t-on-change="() => this.togglePick(emp.id)"/>
                  <b t-esc="emp.name"/><span class="pbss-dim-i" t-esc="emp.email"/>
                </label>
              </div>
              <p t-else="" class="pbss-note">Nobody matches that.</p>
            </div>
            <label class="pbss-f pbss-f--wide"><span class="pbss-f-l">Why (they read it in the email)</span><textarea class="pbss-in" rows="2" t-att-value="state.put.why" t-on-input="onWhy"/></label>
          </div>
          <div class="pbss-drawer-foot">
            <span class="pbss-hint" t-esc="pickedWord"/>
            <button class="pbim-btn ghost" t-on-click="closeDrawer">Cancel</button>
            <button class="pbim-btn primary" t-att-disabled="!state.put.picked.length or state.busy" t-on-click="confirmPut"><t t-out="ic('userPlus',15)"/> Put them on it</button>
          </div>
        </div>
      </div>

      <!-- ================= a skill it gives ================= -->
      <div t-if="state.drawer === 'grant'" class="pbim-modal-scrim pbss-scrim" t-on-click="closeDrawer">
        <div class="pbss-drawer pbcl-drawer-s" t-on-click.stop="() => {}">
          <div class="pbss-drawer-head">
            <div>
              <div class="pbss-eyebrow">Skills it gives</div>
              <h2 class="pbss-drawer-title">Finishing it gives this skill, at this level</h2>
            </div>
            <button class="pbim-btn ghost" t-on-click="closeDrawer" title="Close"><t t-out="ic('x',16)"/></button>
          </div>
          <div class="pbss-drawer-body">
            <p t-if="!state.skillTypes.length" class="pbss-note pbss-f--wide">No skills are set up yet. Add them under Employees › Skills first.</p>
            <t t-else="">
              <label class="pbss-f pbss-f--wide"><span class="pbss-f-l">Kind of skill</span>
                <select class="pbss-in" t-on-change="(ev) => this.onGrant('type_id', ev)"><t t-foreach="state.skillTypes" t-as="st" t-key="st.id"><option t-att-value="st.id" t-att-selected="state.grant.type_id === st.id" t-esc="st.name"/></t></select>
              </label>
              <label class="pbss-f"><span class="pbss-f-l">Skill</span>
                <select class="pbss-in" t-on-change="(ev) => this.onGrant('skill_id', ev)"><option value="0">Pick one</option><t t-foreach="grantType.skills" t-as="sk" t-key="sk.id"><option t-att-value="sk.id" t-att-selected="state.grant.skill_id === sk.id" t-esc="sk.name"/></t></select>
              </label>
              <label class="pbss-f"><span class="pbss-f-l">Level</span>
                <select class="pbss-in" t-on-change="(ev) => this.onGrant('level_id', ev)"><option value="0">Pick one</option><t t-foreach="grantType.levels" t-as="lv" t-key="lv.id"><option t-att-value="lv.id" t-att-selected="state.grant.level_id === lv.id" t-esc="lv.name"/></t></select>
              </label>
              <p class="pbss-note pbss-f--wide">Nobody is ever moved down: a person already at this level or higher keeps theirs.</p>
            </t>
          </div>
          <div class="pbss-drawer-foot">
            <button class="pbim-btn ghost" t-on-click="closeDrawer">Cancel</button>
            <button class="pbim-btn primary" t-att-disabled="!state.grant.skill_id or !state.grant.level_id or state.busy" t-on-click="saveGrant"><t t-out="ic('check',15)"/> Save</button>
          </div>
        </div>
      </div>
    </div>
  </t>

</templates>
