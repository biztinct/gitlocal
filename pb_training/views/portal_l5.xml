<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ==================================================================
       LEARNING L5 — the employee's side: /my/training/requests ("Ask to
       take a course" and "My requests") and /my/training/feedback/<token>
       (the course feedback and the manager's follow-up, worded for the
       course). Server-rendered, no JavaScript needed (the claim page's
       rule: a form that needs a script does not open on a weak phone
       connection). `t-attf-class`, never a dict `t-att-class` (R42); no
       `t-key` (R5). Every text node on one line (LN13).
       ================================================================== -->

  <!-- ============ /my/training: the door and the feedback asks ============ -->
  <template id="portal_my_training_l5" inherit_id="pb_training.portal_my_training" name="My training — course requests and feedback">
    <xpath expr="//p[hasclass('pbtr-teamline')]" position="inside">
      <a href="/my/training/requests" class="pbme-btn">
        <t t-call="pb_training.tr_icon">
          <t t-set="icon" t-value="'send'"/>
          <t t-set="isz" t-value="15"/>
        </t>
        Ask to take a course
      </a>
    </xpath>
    <xpath expr="//p[hasclass('pbtr-teamline')]" position="after">
      <div t-if="me.get('feedback')" class="pbme-card pbtr-feedback-ask">
        <div class="pbtr-feedback-ask-h">
          <t t-call="pb_training.tr_icon">
            <t t-set="icon" t-value="'star'"/>
            <t t-set="isz" t-value="16"/>
          </t>
          <b>Tell us how it went</b>
        </div>
        <p t-foreach="me['feedback']" t-as="fb" class="pbtr-feedback-line">
          <a t-att-href="fb['url']" class="pbme-btn" t-esc="fb['words']"/>
        </p>
      </div>
    </xpath>
  </template>

  <!-- ============ /my/training/requests ============ -->
  <template id="portal_training_requests" name="Ask to take a course">
    <t t-call="portal.portal_layout">
      <t t-set="additional_title">Ask to take a course</t>
      <div class="pbme pbtr">

        <t t-call="pb_training.tr_notices"/>

        <a href="/my/training" class="pbtr-back">
          <t t-call="pb_training.tr_icon">
            <t t-set="icon" t-value="'arrowLeft'"/>
            <t t-set="isz" t-value="15"/>
          </t>
          My own training
        </a>

        <t t-call="pb_me_portal.ess_hero">
          <t t-set="hero_title">Ask to take a course</t>
          <t t-set="hero_sub">One of ours, one from the outside list, or one you found. Your manager decides, and the HR lead too when it costs money.</t>
        </t>

        <div t-if="not options['has_employee']" class="pbme-card pbme-empty">
          <h3>There is no employee record against your login yet</h3>
          <p class="pbme-muted">A request goes to your manager, so it needs an employee record. Tell your HR team and this page fills in by itself.</p>
        </div>

        <t t-else="">
          <p class="pbtr-teamnote" t-esc="options['allowance']['words']"/>

          <!-- ======== one of ours ======== -->
          <details class="pbtr-ask pbtr-claim-form" t-att-open="'open' if form.get('kind', 'ours') == 'ours' else None">
            <summary class="pbme-btn pbtr-btn--primary pbtr-ask-open">
              <t t-call="pb_training.tr_icon">
                <t t-set="icon" t-value="'bookOpen'"/>
                <t t-set="isz" t-value="15"/>
              </t>
              One of our courses
            </summary>
            <form action="/my/training/requests/new" method="post" class="pbtr-ask-form">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <input type="hidden" name="kind" value="ours"/>
              <p t-if="not options['ours']" class="pbtr-ask-note">There is no course of ours to ask for right now — you may already be on all of them.</p>
              <t t-else="">
                <label class="pbtr-f pbtr-f--wide">
                  <span>Which course</span>
                  <select name="channel_id" required="required">
                    <option t-foreach="options['ours']" t-as="crs" t-att-value="crs['id']" t-att-selected="'selected' if form.get('channel_id') == crs['id'] else None"><t t-esc="crs['name']"/><t t-if="crs['duration']"> · <t t-esc="crs['duration']"/></t></option>
                  </select>
                </label>
                <label class="pbtr-f">
                  <span>When would you take it</span>
                  <input type="text" name="when_words" maxlength="200" placeholder="Next month, after the harvest"/>
                </label>
                <label class="pbtr-f pbtr-f--wide">
                  <span>Why — what it will help you do</span>
                  <textarea name="why" rows="2" required="required"/>
                </label>
                <button type="submit" class="pbme-btn pbtr-btn--primary">Ask my manager</button>
                <p class="pbtr-ask-note">If your manager agrees, the course is on your training page straight away.</p>
              </t>
            </form>
          </details>

          <!-- ======== an outside course ======== -->
          <details class="pbtr-ask pbtr-claim-form" t-att-open="'open' if form.get('kind') == 'outside' else None">
            <summary class="pbme-btn pbtr-ask-open">
              <t t-call="pb_training.tr_icon">
                <t t-set="icon" t-value="'graduationCap'"/>
                <t t-set="isz" t-value="15"/>
              </t>
              An outside course
            </summary>
            <form action="/my/training/requests/new" method="post" class="pbtr-ask-form">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <input type="hidden" name="kind" value="outside"/>
              <p t-if="not options['outside']" class="pbtr-ask-note">The training team has not put any outside courses on the list yet. Use "Something else" for a course you found.</p>
              <t t-else="">
                <div class="pbtr-outside-list">
                  <label t-foreach="options['outside']" t-as="ocs" class="pbtr-outside">
                    <input type="radio" name="outside_course_id" t-att-value="ocs['id']" required="required" t-att-checked="'checked' if form.get('outside_course_id') == ocs['id'] else None"/>
                    <span class="pbtr-outside-main">
                      <b t-esc="ocs['name']"/>
                      <span class="pbtr-muted"><t t-esc="ocs['provider']"/><t t-if="ocs['provider']"> · </t><t t-esc="ocs['kind_word']"/><t t-if="ocs['hours_words']"> · <t t-esc="ocs['hours_words']"/></t></span>
                      <span t-if="ocs['blurb']" class="pbtr-muted" t-esc="ocs['blurb']"/>
                    </span>
                    <span class="pbtr-outside-cost" t-esc="ocs['cost_words']"/>
                  </label>
                </div>
                <label class="pbtr-f">
                  <span>When would you take it</span>
                  <input type="text" name="when_words" maxlength="200" placeholder="The March intake"/>
                </label>
                <label class="pbtr-f pbtr-f--wide">
                  <span>Why — what it will help you do</span>
                  <textarea name="why" rows="2" required="required"/>
                </label>
                <button type="submit" class="pbme-btn pbtr-btn--primary">Ask my manager</button>
                <p class="pbtr-ask-note">When it costs money, the HR lead decides after your manager. If it is agreed, the cost is set aside from your allowance and you claim it back with the receipt and the certificate.</p>
              </t>
            </form>
          </details>

          <!-- ======== something else ======== -->
          <details class="pbtr-ask pbtr-claim-form" t-att-open="'open' if form.get('kind') == 'other' else None">
            <summary class="pbme-btn pbtr-ask-open">
              <t t-call="pb_training.tr_icon">
                <t t-set="icon" t-value="'link'"/>
                <t t-set="isz" t-value="15"/>
              </t>
              Something else
            </summary>
            <form action="/my/training/requests/new" method="post" class="pbtr-ask-form">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <input type="hidden" name="kind" value="other"/>
              <label class="pbtr-f pbtr-f--wide">
                <span>What the course is called</span>
                <input type="text" name="course_name" required="required" maxlength="200" t-att-value="form.get('course_name')" placeholder="Advanced Excel for finance teams"/>
              </label>
              <label class="pbtr-f">
                <span>Who runs it</span>
                <input type="text" name="provider" maxlength="200" t-att-value="form.get('provider')"/>
              </label>
              <label class="pbtr-f">
                <span>Link</span>
                <input type="text" name="url" maxlength="500" t-att-value="form.get('url')" placeholder="https://"/>
              </label>
              <label class="pbtr-f">
                <span>What it costs (0 if free)</span>
                <input type="text" name="amount" inputmode="decimal" placeholder="2,500,000"/>
              </label>
              <label class="pbtr-f">
                <span>When would you take it</span>
                <input type="text" name="when_words" maxlength="200"/>
              </label>
              <label class="pbtr-f pbtr-f--wide">
                <span>Why — what it will help you do</span>
                <textarea name="why" rows="2" required="required"/>
              </label>
              <button type="submit" class="pbme-btn pbtr-btn--primary">Ask my manager</button>
            </form>
          </details>

          <!-- ======== my requests ======== -->
          <div t-if="not mine['rows']" class="pbme-card pbme-empty">
            <h3>You have not asked for a course yet</h3>
            <p class="pbme-muted">Pick one above. Your manager sees it in their inbox, and you get an email either way.</p>
          </div>
          <div t-else="" class="pbtr-grid">
            <div t-foreach="mine['rows']" t-as="req" class="pbme-card pbtr-claim">
              <div class="pbtr-course-top">
                <div class="pbtr-course-id">
                  <h3 class="pbtr-course-name" t-esc="req['course']"/>
                  <p class="pbtr-course-blurb"><t t-esc="req['kind_word']"/><t t-if="req['provider']"> · <t t-esc="req['provider']"/></t></p>
                </div>
                <div class="pbtr-claim-amount" t-esc="req['amount_words']"/>
              </div>
              <div class="pbtr-due">
                <span t-attf-class="pbtr-chip #{req['state'] == 'refused' and 'pbtr-chip--bad' or (req['state'] in ('approved', 'taken', 'claimed') and 'pbtr-chip--ok' or 'pbtr-chip--wait')}"><t t-esc="req['state_word']"/></span>
                <span t-if="req['when_words']" class="pbtr-chip"><t t-esc="req['when_words']"/></span>
              </div>
              <div t-if="req['state'] == 'refused' and req['refuse_note']" class="pbtr-notice pbtr-notice--bad">
                <t t-call="pb_training.tr_icon"><t t-set="icon" t-value="'alert'"/></t>
                <span t-esc="req['refuse_note']"/>
              </div>
              <div class="pbtr-claim-files">
                <a t-if="req['can_claim']" t-attf-href="/my/training/claims?request=#{req['id']}" class="pbme-btn pbtr-btn--primary">Claim this course back</a>
                <a t-if="req['channel_id'] and req['state'] in ('approved', 'taken')" t-attf-href="/my/training/#{req['channel_id']}" class="pbme-btn">Open the course</a>
                <a t-if="req['url'] and req['state'] == 'approved'" t-att-href="req['url']" target="_blank" rel="noopener" class="pbme-btn">The link</a>
                <form t-if="req['can_cancel']" t-attf-action="/my/training/requests/#{req['id']}/cancel" method="post" class="pbtr-inline-form">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                  <button type="submit" class="pbme-btn">Cancel the request</button>
                </form>
              </div>
            </div>
          </div>
        </t>
      </div>
    </t>
  </template>

  <!-- ============ /my/training/feedback/<token> ============ -->
  <template id="portal_training_feedback" name="Course feedback">
    <t t-call="website.layout">
      <t t-set="additional_title">A few questions</t>
      <div class="pbme pbtr pbtr-fb">
        <div class="pbme-card pbtr-fb-card">
          <t t-if="status == 'ok'">
            <div class="pbtr-fb-eyebrow">
              <t t-call="pb_training.tr_icon">
                <t t-set="icon" t-value="'star'"/>
                <t t-set="isz" t-value="14"/>
              </t>
              <t t-if="kind == 'training'">Course feedback</t><t t-else="">A month on</t>
            </div>
            <h1 t-esc="heading"/>
            <p class="pbme-muted" t-if="kind == 'training'">Two ratings and one line. The training team reads them to make the course better for the next person.</p>
            <p class="pbme-muted" t-else="">Three short questions. The training team uses them to spend on the courses that work.</p>
            <form t-attf-action="/my/training/feedback/#{token}/submit" method="post" class="pbtr-fb-form">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <t t-foreach="questions" t-as="qst">
                <fieldset class="pbtr-fb-q">
                  <legend>
                    <t t-if="qst['key'] == 'useful'">Was it useful?</t>
                    <t t-elif="qst['key'] == 'recommend'">Would you recommend it?</t>
                    <t t-elif="qst['key'] == 'change'">What would you change?</t>
                    <t t-elif="qst['key'] == 'effect'">Has their work changed since the course?</t>
                    <t t-elif="qst['key'] == 'used'">Did they use what they learned?</t>
                    <t t-elif="qst['key'] == 'note'">Anything to add?</t>
                    <t t-else=""><t t-esc="qst['label']"/></t>
                  </legend>
                  <div t-if="qst['type'] == 'rating'" class="pbtr-fb-stars">
                    <t t-foreach="[1, 2, 3, 4, 5]" t-as="n">
                      <label class="pbtr-fb-star">
                        <input type="radio" t-att-name="'q_%s' % qst['key']" t-att-value="n" required="required"/>
                        <span t-esc="n"/>
                      </label>
                    </t>
                    <span class="pbtr-fb-scale"><span>1 = not at all</span><span>5 = very much</span></span>
                  </div>
                  <div t-elif="qst['type'] == 'choice'" class="pbtr-fb-choices">
                    <t t-foreach="qst['options']" t-as="opt">
                      <label class="pbtr-fb-choice">
                        <input type="radio" t-att-name="'q_%s' % qst['key']" t-att-value="opt" required="required"/>
                        <span>
                          <t t-if="opt == 'Yes'">Yes</t>
                          <t t-elif="opt == 'Partly'">Partly</t>
                          <t t-elif="opt == 'No'">No</t>
                          <t t-else=""><t t-esc="opt"/></t>
                        </span>
                      </label>
                    </t>
                  </div>
                  <textarea t-else="" t-att-name="'q_%s' % qst['key']" rows="3" maxlength="2000"/>
                </fieldset>
              </t>
              <button type="submit" class="pbme-btn pbtr-btn--primary">Send</button>
              <p t-if="window_words" class="pbtr-ask-note" t-esc="window_words"/>
            </form>
          </t>
          <t t-elif="status == 'thanks'">
            <h1>Thank you</h1>
            <p class="pbme-muted">Your answers are with the training team. There is nothing left to do here.</p>
          </t>
          <t t-elif="status == 'used'">
            <h1>Already answered</h1>
            <p class="pbme-muted">These questions have been answered, so the link has closed itself.</p>
          </t>
          <t t-elif="status == 'closed'">
            <h1>This link has closed</h1>
            <p class="pbme-muted">The time to answer has passed. Thank you all the same.</p>
          </t>
          <t t-else="">
            <h1>This link does not work</h1>
            <p class="pbme-muted">It may have been typed wrongly or already used. Nothing else is needed from you.</p>
          </t>
        </div>
      </div>
    </t>
  </template>

</odoo>
