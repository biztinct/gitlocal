<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         RECORDS OPEN NATIVELY, SKINNED (Option B: skin, do not rebuild).
         The board is the screen; these are what a drill-down from it lands
         on, and what somebody in HR types a claim up on from a pile of
         receipts.

         Two rules every form here carries:
           * `nolabel="1"` inside a `<group>` needs `colspan="2"` or the field
             renders ONE LABEL WIDE (R128) — an inner group is a two-column
             grid and a label-less field takes the narrow cell;
           * a search `<group>` takes NO `string` and NO `expand` on Odoo 19 —
             it fails RNG validation and aborts the whole module load (R129).

         These are `ir.actions.act_window` RECORDS, so the ORM computes their
         `views` field and R125 does not apply; that rule is about a dict a
         facade hands to `doAction`, and every one of those in this module
         goes through `_door()`.
         ================================================================== -->

    <!-- ================================================================= -->
    <!--  claims                                                           -->
    <!-- ================================================================= -->
    <record id="view_pb_training_claim_list" model="ir.ui.view">
        <field name="name">pb.training.claim.list</field>
        <field name="model">pb.training.claim</field>
        <field name="arch" type="xml">
            <list string="Training claims">
                <field name="employee_id" width="200px"/>
                <field name="course_name" width="240px"/>
                <field name="provider" optional="show"/>
                <field name="paid_on"/>
                <field name="year" optional="hide"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="over_allowance" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
                <field name="fulfilment" widget="badge" optional="show"
                       decoration-success="fulfilment == 'paid'"
                       decoration-info="fulfilment == 'queued'"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="view_pb_training_claim_form" model="ir.ui.view">
        <field name="name">pb.training.claim.form</field>
        <field name="model">pb.training.claim</field>
        <field name="arch" type="xml">
            <form string="Training claim">
                <header>
                    <button name="action_submit" type="object"
                            string="Send it to be agreed" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Agree and pay it back" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_refuse" type="object"
                            string="Turn it down"
                            invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-success" role="status"
                         invisible="state != 'approved'">
                        <strong>Agreed.</strong>
                        It is now a one-off amount waiting for a pay run. The
                        pay team puts it into one from the Awards screen —
                        nothing here pays anybody.
                    </div>
                    <div class="alert alert-warning" role="status"
                         invisible="not over_allowance">
                        <strong>This was agreed over the allowance.</strong>
                        The person had less than this left for the year. Who
                        allowed it, and by how much, is in the message history
                        below.
                    </div>
                    <div class="alert alert-danger" role="status"
                         invisible="state != 'refused'">
                        <strong>Turned down.</strong>
                        <field name="refuse_note" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <group string="Who and what">
                            <field name="employee_id"/>
                            <field name="course_name"/>
                            <field name="provider"/>
                            <field name="assignment_id"
                                   invisible="not assignment_id"/>
                        </group>
                        <group string="What it cost">
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="paid_on"/>
                            <field name="year" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="The paperwork">
                            <field name="invoice_filename" invisible="1"/>
                            <field name="invoice_file" widget="binary"
                                   filename="invoice_filename"/>
                            <field name="certificate_filename" invisible="1"/>
                            <field name="certificate_file" widget="binary"
                                   filename="certificate_filename"/>
                            <field name="invoice_attachment_id" readonly="1"
                                   groups="base.group_no_one"/>
                            <field name="certificate_attachment_id"
                                   readonly="1" groups="base.group_no_one"/>
                        </group>
                        <group string="Where the money has got to">
                            <field name="fulfilment" readonly="1"
                                   invisible="not fulfilment"/>
                            <field name="incentive_id" readonly="1"
                                   invisible="not incentive_id"/>
                            <field name="submitted_on" readonly="1"
                                   invisible="not submitted_on"/>
                            <field name="decided_on" readonly="1"
                                   invisible="not decided_on"/>
                        </group>
                    </group>
                    <group string="Anything they wanted to add">
                        <!-- R128: a label-less field inside a group takes the
                             NARROW cell of a two-column grid unless it is told
                             to span both. -->
                        <field name="note" nolabel="1" colspan="2"
                               placeholder="A line about the course and why it was worth doing."/>
                    </group>
                    <group string="Why it was turned down"
                           invisible="state == 'approved'">
                        <field name="refuse_note" nolabel="1" colspan="2"
                               placeholder="Say why. They are being told no about money they have already spent."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pb_training_claim_search" model="ir.ui.view">
        <field name="name">pb.training.claim.search</field>
        <field name="model">pb.training.claim</field>
        <field name="arch" type="xml">
            <search string="Training claims">
                <field name="employee_id"/>
                <field name="course_name"/>
                <field name="provider"/>
                <filter name="f_waiting" string="Waiting on somebody"
                        domain="[('state', '=', 'submitted')]"/>
                <filter name="f_agreed" string="Agreed"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="f_unpaid" string="Agreed, not paid yet"
                        domain="[('state', '=', 'approved'), ('fulfilment', '!=', 'paid')]"/>
                <filter name="f_refused" string="Turned down"
                        domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter name="f_over" string="Over the allowance"
                        domain="[('over_allowance', '=', True)]"/>
                <!-- A search `<group>` takes NO `string` and NO `expand` on
                     Odoo 19 (R129) — either one fails RNG validation and
                     aborts the whole module load. -->
                <group name="group_by">
                    <filter name="g_state" string="How far it has got"
                            context="{'group_by': 'state'}"/>
                    <filter name="g_year" string="Year"
                            context="{'group_by': 'year'}"/>
                    <filter name="g_employee" string="Who"
                            context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_training_claims" model="ir.actions.act_window">
        <field name="name">Training claims</field>
        <field name="res_model">pb.training.claim</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody has claimed a course back yet</p>
            <p>A claim is somebody asking to be paid back for a course they
               paid for themselves. They raise it on their own training page
               with the receipt and the certificate; the HR lead agrees it, and
               it becomes a one-off amount for the pay team to put into a pay
               run. Set a training allowance first, so there is a figure to
               claim against.</p>
        </field>
    </record>

    <!-- ================================================================= -->
    <!--  allowances                                                       -->
    <!-- ================================================================= -->
    <record id="view_pb_training_allowance_list" model="ir.ui.view">
        <field name="name">pb.training.allowance.list</field>
        <field name="model">pb.training.allowance</field>
        <field name="arch" type="xml">
            <list string="Training allowances" editable="bottom">
                <field name="year"/>
                <field name="company_id" width="220px"/>
                <field name="employee_id" width="220px"
                       placeholder="Everybody"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pb_training_allowance_form" model="ir.ui.view">
        <field name="name">pb.training.allowance.form</field>
        <field name="model">pb.training.allowance</field>
        <field name="arch" type="xml">
            <form string="Training allowance">
                <sheet>
                    <div class="alert alert-info" role="status">
                        <strong>Leave "Just for" empty and this is the figure
                        for everybody in the company.</strong>
                        Name somebody and it is theirs alone, and it wins over
                        the company figure. A claim counts against the year the
                        course was paid for.
                    </div>
                    <group>
                        <group string="What it covers">
                            <field name="year"/>
                            <field name="company_id"/>
                            <field name="employee_id"
                                   placeholder="Everybody in the company"/>
                        </group>
                        <group string="How much">
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Why this figure">
                        <field name="note" nolabel="1" colspan="2"
                               placeholder="A line for whoever reads this next year."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pb_training_allowance_search" model="ir.ui.view">
        <field name="name">pb.training.allowance.search</field>
        <field name="model">pb.training.allowance</field>
        <field name="arch" type="xml">
            <search string="Training allowances">
                <field name="employee_id"/>
                <field name="company_id"/>
                <filter name="f_company_wide" string="The company figure"
                        domain="[('employee_id', '=', False)]"/>
                <filter name="f_people" string="Just for one person"
                        domain="[('employee_id', '!=', False)]"/>
                <group name="group_by">
                    <filter name="g_year" string="Year"
                            context="{'group_by': 'year'}"/>
                    <filter name="g_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_training_allowances" model="ir.actions.act_window">
        <field name="name">Training allowances</field>
        <field name="res_model">pb.training.allowance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set what a company will spend on training one person</p>
            <p>One figure per company per year covers everybody. Add a row with
               a name on it for anyone who has their own figure — theirs wins.
               Until a figure is set, nobody can claim a course back.</p>
        </field>
    </record>

    <!-- ================================================================= -->
    <!--  the Insights lens                                                -->
    <!-- ================================================================= -->
    <!-- A RECORD and never a bare tag: a bare tag reaches the shell with no
         action NAME, and anything returning through a breadcrumb then reads
         "Unnamed" (W98). -->
    <record id="action_pb_training_numbers" model="ir.actions.client">
        <field name="name">Training numbers</field>
        <field name="tag">pb_training_numbers</field>
        <field name="target">current</field>
    </record>

    <record id="action_my_training_claims" model="ir.actions.act_url">
        <field name="name">My training allowance</field>
        <field name="url">/my/training/claims</field>
        <field name="target">self</field>
    </record>

</odoo>
