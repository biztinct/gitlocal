<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         FIVE TIERS, and they are deliberately not one.

         Publishing a workflow and approving a request are different powers
         (design §8): somebody who decides who signs off pay must not thereby
         become a person who signs off pay. So `group_approval_publish` never
         implies a seat, and holding a seat comes from the responsibility
         record, not from a group.

         Odoo 19 shape: `name` + `implied_ids` (+ a privilege record for the
         Settings page), never `category_id`, which no longer exists on
         res.groups.
         ================================================================== -->

    <record id="module_category_approval" model="ir.module.category">
        <field name="name">Approvals</field>
        <field name="sequence">55</field>
    </record>

    <record id="res_groups_privilege_approval" model="res.groups.privilege">
        <field name="name">Approvals</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_approval"/>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">Take part in approvals</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_approval"/>
        <field name="comment">Send things in for approval, decide the steps that are yours, and see the requests you are part of.</field>
    </record>

    <record id="group_approval_config" model="res.groups">
        <field name="name">Set up approvals</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
        <field name="comment">Write draft workflows, name who holds each responsibility, and choose where a workflow applies.</field>
    </record>

    <record id="group_approval_publish" model="res.groups">
        <field name="name">Publish approvals</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_config'))]"/>
        <field name="comment">Make a draft the one that future requests follow. This does not make you an approver.</field>
    </record>

    <record id="group_approval_admin" model="res.groups">
        <field name="name">Look after approvals</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_publish'))]"/>
        <field name="comment">Arrange exceptions and other people's hand-overs, move a waiting step to someone else, and withdraw any request.</field>
    </record>

    <record id="group_approval_audit" model="res.groups">
        <field name="name">Read the approval trail</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="res_groups_privilege_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
        <field name="comment">Read every approval event, for compliance.</field>
    </record>

    <!-- Additive only: everyone inside the business may take part in
         approvals (they still only see their own), and an administrator may
         look after them. Neither record restates a group somebody else owns. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('biz_approval_workflow.group_approval_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('biz_approval_workflow.group_approval_admin')), (4, ref('biz_approval_workflow.group_approval_audit'))]"/>
    </record>

</odoo>
