#. module: biz_approval_workflow
msgid "%(backup)s holds this one because %(holder)s %(why)s"
msgstr "%(backup)s phụ trách mục này vì %(holder)s %(why)s"

#. module: biz_approval_workflow
msgid "%(backup)s was asked instead of %(holder)s, because %(holder)s %(why)s."
msgstr "%(backup)s được hỏi thay cho %(holder)s, vì %(holder)s %(why)s."

#. module: biz_approval_workflow
msgid "%(holder)s %(why)s and is the only person named for this step, so nobody can approve it yet. Name a backup for them in People & backups, or move this one to somebody else."
msgstr "%(holder)s %(why)s và là người duy nhất được nêu cho bước này, nên chưa ai có thể duyệt. Hãy chỉ định người dự phòng cho họ trong Người & người dự phòng, hoặc chuyển việc này cho người khác."

#. module: biz_approval_workflow
msgid "%(what)s was approved but could not be carried out: %(why)s"
msgstr "%(what)s đã được duyệt nhưng không thực hiện được: %(why)s"

#. module: biz_approval_workflow
msgid "%s — done."
msgstr "%s — đã xong."

