#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/workflow_contract.py:0
msgid "Other request"
msgstr "Permintaan lain"

#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/workflow_contract.py:0
msgid "Approvals"
msgstr "Persetujuan"

#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/workflow_contract.py:0
msgid "Someone writes down what they are asking for"
msgstr "Seseorang menuliskan apa yang mereka minta"

#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/workflow_contract.py:0
msgid "An approver sends it back to be changed"
msgstr "Pemberi persetujuan mengembalikannya untuk diubah"

#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/workflow_contract.py:0
msgid "Someone sends it for a sign-off"
msgstr "Seseorang mengirimkannya untuk disetujui"

#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/workflow_contract.py:0
msgid "The last approver says yes"
msgstr "Pemberi persetujuan terakhir menyetujui"

#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/workflow_contract.py:0
msgid "An approver says no"
msgstr "Pemberi persetujuan menolak"

#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/workflow_contract.py:0
msgid "The person who asked takes it back"
msgstr "Orang yang meminta menariknya kembali"

# ===================================================================
#  WORKFLOW-2 P6a — "Other request" status words
# ===================================================================
#. module: biz_approval_workflow
#: model:ir.model.fields.selection,name:biz_approval_workflow.selection__biz_approval_generic_request__state__draft
msgid "Draft"
msgstr "Draf"

#. module: biz_approval_workflow
#: model:ir.model.fields.selection,name:biz_approval_workflow.selection__biz_approval_generic_request__state__pending
msgid "Waiting for approval"
msgstr "Menunggu persetujuan"

#. module: biz_approval_workflow
#: model:ir.model.fields.selection,name:biz_approval_workflow.selection__biz_approval_generic_request__state__done
msgid "Approved and done"
msgstr "Disetujui dan selesai"

#. module: biz_approval_workflow
#: model:ir.model.fields.selection,name:biz_approval_workflow.selection__biz_approval_generic_request__state__returned
msgid "Sent back"
msgstr "Dikembalikan"

#. module: biz_approval_workflow
#: model:ir.model.fields.selection,name:biz_approval_workflow.selection__biz_approval_generic_request__state__rejected
msgid "Turned down"
msgstr "Ditolak"

#. module: biz_approval_workflow
#: model:ir.model.fields.selection,name:biz_approval_workflow.selection__biz_approval_generic_request__state__cancelled
msgid "Withdrawn"
msgstr "Ditarik"

#. module: biz_approval_workflow
#. odoo-python
#: code:addons/biz_approval_workflow/models/process.py:0
msgid ""
"\"%s\" moves money out of the company, so each one is approved on its own. "
"It cannot be approved several at once."
msgstr ""
"\"%s\" mengeluarkan uang dari perusahaan, jadi setiap permintaan disetujui "
"sendiri-sendiri. Tidak dapat disetujui beberapa sekaligus."

#. module: biz_approval_workflow
#: model:ir.model.fields,help:biz_approval_workflow.field_biz_approval_process__bulk_ok
msgid ""
"A manager may tick several of these in the Approvals inbox and approve them "
"together. Never allowed where money leaves the company."
msgstr ""
"Manajer dapat mencentang beberapa permintaan jenis ini di kotak Persetujuan "
"dan menyetujuinya sekaligus. Tidak pernah diizinkan jika uang keluar dari "
"perusahaan."

#. module: biz_approval_workflow
#: model:ir.model.fields,field_description:biz_approval_workflow.field_biz_approval_process__bulk_ok
msgid "Can be approved several at once"
msgstr "Dapat disetujui beberapa sekaligus"
