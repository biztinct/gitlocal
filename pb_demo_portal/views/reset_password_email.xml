<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fully replaces Odoo's default auth_signup reset/set-password email with a
         branded Payobook template (no "Powered by Odoo"). Rendered via qweb_view
         with `object` = res.users, `user` = env user. -->
    <template id="auth_signup.reset_password_email" name="Payobook Reset Password Email">
        <div style="margin:0; padding:0; background:#F5F6FA;">
            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"
                   style="background:#F5F6FA; margin:0; padding:0; width:100%;">
                <tr><td align="center" style="padding:28px 12px;">

                    <!-- ============ CARD ============ -->
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600"
                           style="width:600px; max-width:600px; background:#ffffff; border:1px solid #E7E5F2; border-radius:18px; overflow:hidden; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">

                        <!-- header band -->
                        <tr><td style="background:#5A4BB0; padding:22px 32px;">
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%"><tr>
                                <td align="left" style="font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#ffffff; font-size:22px; font-weight:800; letter-spacing:.3px;">Payobook</td>
                                <td align="right" style="font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#CBC2EE; font-size:12px; font-weight:600;">Payroll for all of Asia</td>
                            </tr></table>
                        </td></tr>

                        <!-- body -->
                        <tr><td style="padding:36px 32px 10px 32px;">
                            <div style="text-transform:uppercase; letter-spacing:.09em; font-size:11px; font-weight:700; color:#5A4BB0;">Account access</div>
                            <h1 style="margin:8px 0 8px 0; font-size:24px; line-height:1.25; color:#1B1733; font-weight:800;">Set your password</h1>
                            <p style="margin:0 0 20px 0; font-size:15px; line-height:1.6; color:#4B5168;">
                                Hi <t t-out="object.name or ''">there</t>, you're almost in. Tap the button below to set your Payobook password and open your workspace. This secure link stays valid for
                                <t t-out="user.env['ir.config_parameter'].sudo().get_param('auth_signup.reset_password.validity.hours', 4)">4</t> hours.
                            </p>

                            <!-- bulletproof button -->
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" style="margin:4px 0 24px 0;">
                                <tr><td align="center" bgcolor="#5A4BB0" style="border-radius:12px; box-shadow:0 6px 16px rgba(90,75,176,0.30);">
                                    <a t-att-href="object.partner_id._get_signup_url()"
                                       style="display:inline-block; padding:15px 32px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:15px; font-weight:700; color:#ffffff; text-decoration:none; border-radius:12px;">
                                        Set my password &#8594;
                                    </a>
                                </td></tr>
                            </table>

                            <p style="margin:0 0 6px 0; font-size:12px; color:#6E6A85;">Or paste this link into your browser:</p>
                            <p style="margin:0 0 22px 0; font-size:12px; line-height:1.5; word-break:break-all;">
                                <a t-att-href="object.partner_id._get_signup_url()" t-out="object.partner_id._get_signup_url()"
                                   style="color:#5A4BB0; text-decoration:underline;">https://payobook.com/</a>
                            </p>

                            <!-- security note -->
                            <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background:#EDEAF8; border-radius:12px;">
                                <tr><td style="padding:14px 16px; font-size:13px; line-height:1.55; color:#4B5168;">
                                    <b style="color:#1B1733;">Didn't request this?</b> You can safely ignore this email — no changes are made and your account stays secure.
                                </td></tr>
                            </table>
                        </td></tr>

                        <!-- footer -->
                        <tr><td style="padding:24px 32px 30px 32px; border-top:1px solid #EEF0F8;">
                            <div style="font-size:15px; font-weight:800; color:#5A4BB0;">Payobook</div>
                            <div style="margin-top:5px; font-size:12px; line-height:1.6; color:#8A87A0;">
                                <t t-out="object.company_id.name or 'Payobook'">Payobook</t><br/>
                                <t t-if="object.company_id.website">
                                    <a t-att-href="object.company_id.website" style="color:#8A87A0; text-decoration:none;" t-out="object.company_id.website">payobook.com</a>
                                </t>
                                <t t-else="">
                                    <a href="https://www.payobook.com" style="color:#8A87A0; text-decoration:none;">www.payobook.com</a>
                                </t>
                                <t t-if="object.company_id.email">
                                    &#8226; <a t-att-href="'mailto:%s' % object.company_id.email" style="color:#8A87A0; text-decoration:none;" t-out="object.company_id.email">hello@payobook.com</a>
                                </t>
                            </div>
                            <div style="margin-top:12px; font-size:11px; color:#B4B1C4;">Payroll, unified across Asia — with an AI copilot.</div>
                        </td></tr>
                    </table>

                    <!-- sub-footer -->
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" style="width:600px; max-width:600px;">
                        <tr><td align="center" style="padding:14px 8px; font-size:11px; color:#B4B1C4; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
                            You received this email because a password set/reset was requested for your Payobook account.
                        </td></tr>
                    </table>

                </td></tr>
            </table>
        </div>
    </template>
</odoo>
