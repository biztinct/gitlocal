<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Security Group for India Payroll -->
    <record id="group_india_payroll_user" model="res.groups">
        <field name="name">India Payroll User</field>
        <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    
    <!-- Actions for India Dashboard -->
    <record id="action_india_dashboard_window" model="ir.actions.act_window">
        <field name="name">Open India Payroll Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_india"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'IN'}</field>
        <field name="domain">[('country', '=', 'IN')]</field>
    </record>
    
    <!-- Country Selector Expected Action -->
    <record id="action_payroll_dashboard_india" model="ir.actions.act_window">
        <field name="name">India Payroll Dashboard Professional</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_india"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'IN', 'force_view': True}</field>
        <field name="domain">[('country', '=', 'IN')]</field>
    </record>
    
    <!-- India Dashboard Menu under base dashboard section -->
    <menuitem id="menu_india_dashboard"
              name="India Dashboard"
              parent="pb_hr_payroll_base.menu_payroll_dashboard_section"
              action="action_payroll_dashboard_india"
              sequence="30"
              groups="pb_hr_payroll_base.group_payroll_india"/>
    
    <!-- India spreadsheet actions - removed duplicate, now defined in server actions file -->
    
    <record id="action_india_import_spreadsheet" model="ir.actions.server">
        <field name="name">Import India Spreadsheet</field>
        <field name="model_id" ref="spreadsheet_oca.model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
# India spreadsheet import logic
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'payroll.import.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'default_country': 'IN', 'default_spreadsheet_ref': '__custom__.payrollstaging_india'}
}
        </field>
    </record>

    <!-- India Gratuity Menu under original Payroll menu -->
    <menuitem id="menu_india_gratuity"
              name="India Gratuity Payments"
              parent="pb_hr_payroll_base.menu_payroll_backup_root"
              action="action_gratuity_payment_wizard"
              sequence="25"
              groups="pb_hr_payroll_base.group_payroll_india"/>
    
</odoo>