<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Security Group for India Payroll -->
    <record id="group_india_payroll_user" model="res.groups">
        <field name="name">India Payroll User</field>
        <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
    
    <!-- Actions for India Dashboard -->
    <record id="action_india_dashboard_window" model="ir.actions.act_window">
        <field name="name">Open India Payroll Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_india"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'IN'}</field>
        <field name="domain">[('country', '=', 'IN')]</field>
    </record>
    
    <!-- Country Selector Expected Action -->
    <record id="action_payroll_dashboard_india" model="ir.actions.act_window">
        <field name="name">India Payroll Dashboard Professional</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_india"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'IN', 'force_view': True}</field>
        <field name="domain">[('country', '=', 'IN')]</field>
    </record>
    
    <!-- Main Menu Structure -->
    <menuitem id="menu_payroll_management_root"
              name="Payroll Management"
              sequence="85"
              groups="om_hr_payroll.group_hr_payroll_user"/>
    
    <!-- India Payroll Menu Structure -->
    <menuitem id="menu_india_payroll_root"
              name="India Payroll"
              parent="menu_payroll_management_root"
              sequence="30"
              groups="group_india_payroll_user"/>
    
    <!-- India Dashboard Menu -->
    <menuitem id="menu_india_dashboard"
              name="Dashboard"
              parent="menu_india_payroll_root"
              action="action_payroll_dashboard_india"
              sequence="0"/>
    
    <!-- India Submenus -->
    <menuitem id="menu_india_employees"
              name="Employees"
              parent="menu_india_payroll_root"
              sequence="10"
              groups="group_india_payroll_user"/>
    
    <menuitem id="menu_india_payslips"
              name="Payslips"
              parent="menu_india_payroll_root"
              sequence="20"
              groups="group_india_payroll_user"/>
    
    <menuitem id="menu_india_reports"
              name="Reports"
              parent="menu_india_payroll_root"
              sequence="30"
              groups="group_india_payroll_user"/>
    
    <!-- Gratuity Payment Menu -->
    <menuitem id="menu_india_gratuity"
              name="Gratuity Payments"
              parent="menu_india_payroll_root"
              action="action_gratuity_payment_wizard"
              sequence="25"
              groups="group_india_payroll_user"/>
    
    <!-- India Staging Data Menu -->
    <menuitem id="menu_india_staging_data"
              name="📊 India Staging Data"
              parent="menu_india_payroll_root"
              action="action_zoho_staging_data_india"
              sequence="35"
              groups="group_india_payroll_user"/>
    
    <!-- India Employee Data Menu -->
    <menuitem id="menu_india_employee_data"
              name="📈 India Employee Data"
              parent="menu_india_payroll_root"
              action="action_zoho_employee_data_india"
              sequence="40"
              groups="group_india_payroll_user"/>
    
    <!-- Additional India Reports Menu -->
    <menuitem id="menu_india_reports_root"
              name="📋 Reports"
              parent="menu_india_payroll_root"
              sequence="50"
              groups="group_india_payroll_user"/>
    
    <menuitem id="menu_india_staging_reports"
              name="Staging Data Analysis"
              parent="menu_india_reports_root"
              action="action_zoho_staging_data_india"
              sequence="10"/>
    
    <menuitem id="menu_india_payroll_reports"
              name="Payroll Data Analysis"
              parent="menu_india_reports_root"
              action="action_zoho_employee_data_india"
              sequence="20"/>
    
</odoo>