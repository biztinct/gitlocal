<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Standalone Zoho Staging Data Form View for India -->
        <record id="view_zoho_staging_data_form_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.form.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="arch" type="xml">
                <form string="Zoho Staging Data - India">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="first_name"/>
                                <field name="last_name"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="department"/>
                                <field name="processing_status"/>
                                <field name="created_employee_id"/>
                            </group>
                        </group>
                        
                        <group string="India Salary Components">
                            <group string="Allowances">
                                <field name="base_salary" string="Basic Salary"/>
                                <field name="hra"/>
                                <field name="special_allowance"/>
                                <field name="books_allowance"/>
                                <field name="phone_allowance" string="Phone Allowance"/>
                                <field name="lta"/>
                            </group>
                            <group string="Deductions &amp; Details">
                                <field name="pf_employee"/>
                                <field name="professional_tax"/>
                                <field name="income_tax"/>
                                <field name="uan_number"/>
                                <field name="esi_number"/>
                                <field name="pf_number"/>
                            </group>
                        </group>
                        
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Standalone Zoho Employee Data Form View for India -->
        <record id="view_zoho_employee_data_form_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.form.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="arch" type="xml">
                <form string="Zoho Employee Data - India">
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="first_name"/>
                                <field name="last_name"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="department"/>
                                <field name="location_name"/>
                                <field name="date_of_joining"/>
                            </group>
                        </group>
                        
                        <group string="India Payroll Components">
                            <group string="Salary Components">
                                <field name="base_salary" string="Basic Salary"/>
                                <field name="hra"/>
                                <field name="special_allowance"/>
                                <field name="books_allowance"/>
                                <field name="lta"/>
                                <field name="medical_allowance"/>
                            </group>
                            <group string="Deductions &amp; Contributions">
                                <field name="pf_employee"/>
                                <field name="esi_employee"/>
                                <field name="professional_tax"/>
                                <field name="income_tax"/>
                                <field name="pf_employer"/>
                                <field name="esi_employer"/>
                            </group>
                        </group>
                        
                        <group string="India Compliance">
                            <group>
                                <field name="gratuity"/>
                                <field name="pan_number"/>
                                <field name="aadhaar_number"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Standalone Zoho Staging Data Tree View for India -->
        <record id="view_zoho_staging_data_tree_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.tree.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="arch" type="xml">
                <tree string="Zoho Staging Data - India">
                    <field name="employee_id"/>
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="department"/>
                    <field name="base_salary" optional="hide" string="Basic"/>
                    <field name="hra" optional="hide" string="HRA"/>
                    <field name="special_allowance" optional="hide" string="Special Allow"/>
                    <field name="books_allowance" optional="hide" string="Books"/>
                    <field name="phone_allowance" optional="hide" string="Phone"/>
                    <field name="lta" optional="hide" string="LTA"/>
                    <field name="pf_employee" optional="hide" string="PF"/>
                    <field name="professional_tax" optional="hide" string="Prof Tax"/>
                    <field name="income_tax" optional="hide" string="Income Tax"/>
                    <field name="uan_number" optional="hide" string="UAN"/>
                </tree>
            </field>
        </record>
        
        <!-- Standalone Zoho Employee Data Tree View for India -->
        <record id="view_zoho_employee_data_tree_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.tree.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="arch" type="xml">
                <tree string="Zoho Employee Data - India">
                    <field name="employee_id"/>
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="department"/>
                    <field name="designation"/>
                    <field name="date_of_joining"/>
                    <field name="base_salary" optional="hide" string="Base Salary"/>
                    <field name="net_pay" optional="hide" string="Net Pay"/>
                    <!-- India Components -->
                    <field name="hra" optional="hide" string="HRA"/>
                    <field name="special_allowance" optional="hide" string="Special Allow"/>
                    <field name="pf_employee" optional="hide" string="PF Employee"/>
                    <field name="professional_tax" optional="hide" string="Prof Tax"/>
                    <field name="gross_salary" optional="hide" string="Gross"/>
                    <field name="total_deductions" optional="hide" string="Deductions"/>
                    <field name="net_pay" optional="hide" string="Net Pay"/>
                </tree>
            </field>
        </record>
        
        <!-- India Staging Data Pivot View -->
        <record id="view_zoho_staging_data_pivot_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.pivot.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="arch" type="xml">
                <pivot string="India Payroll Staging Data Analysis">
                    <field name="department" type="row"/>
                    <field name="designation" type="row"/>
                    <field name="employee_type" type="col"/>
                    <field name="employee_status" type="col"/>
                    <!-- India Salary Components as Measures -->
                    <field name="base_salary" type="measure"/>
                    <field name="hra" type="measure"/>
                    <field name="special_allowance" type="measure"/>
                    <field name="books_allowance" type="measure"/>
                    <field name="phone_allowance" type="measure"/>
                    <field name="lta" type="measure"/>
                    <field name="pf_employee" type="measure"/>
                    <field name="professional_tax" type="measure"/>
                    <field name="income_tax" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <!-- India Employee Data Pivot View -->
        <record id="view_zoho_employee_data_pivot_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.pivot.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="arch" type="xml">
                <pivot string="India Employee Payroll Data Analysis">
                    <field name="department" type="row"/>
                    <field name="designation" type="row"/>
                    <field name="employee_type" type="col"/>
                    <!-- India Components as Measures -->
                    <field name="base_salary" type="measure"/>
                    <field name="hra" type="measure"/>
                    <field name="special_allowance" type="measure"/>
                    <field name="books_allowance" type="measure"/>
                    <field name="lta" type="measure"/>
                    <field name="medical_allowance" type="measure"/>
                    <field name="pf_employee" type="measure"/>
                    <field name="professional_tax" type="measure"/>
                    <field name="income_tax" type="measure"/>
                    <field name="pf_employer" type="measure"/>
                    <field name="esi_employer" type="measure"/>
                    <field name="gross_salary" type="measure"/>
                    <field name="total_deductions" type="measure"/>
                    <field name="net_pay" type="measure"/>
                </pivot>
            </field>
        </record>
        
        <!-- India Staging Data Search View -->
        <record id="view_zoho_staging_data_search_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.search.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="arch" type="xml">
                <search string="Search India Staging Data">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="employee_id"/>
                    <field name="department"/>
                    <field name="designation"/>
                    <field name="base_salary"/>
                    <field name="hra"/>
                    <field name="pf_employee"/>
                    <field name="uan_number"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('employee_status', '=', 'Active')]"/>
                    <filter string="Inactive" name="inactive" domain="[('employee_status', '=', 'Inactive')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Department" name="group_department" domain="[]" context="{'group_by': 'department'}"/>
                        <filter string="Designation" name="group_designation" domain="[]" context="{'group_by': 'designation'}"/>
                        <filter string="Employee Status" name="group_status" domain="[]" context="{'group_by': 'employee_status'}"/>
                        <filter string="UAN Number" name="group_uan" domain="[]" context="{'group_by': 'uan_number'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- India Employee Data Search View -->
        <record id="view_zoho_employee_data_search_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.search.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="arch" type="xml">
                <search string="Search India Employee Data">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="employee_id"/>
                    <field name="department"/>
                    <field name="designation"/>
                    <field name="base_salary"/>
                    <field name="gross_salary"/>
                    <field name="net_pay"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('employee_status', '=', 'Active')]"/>
                    <filter string="Inactive" name="inactive" domain="[('employee_status', '=', 'Inactive')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Department" name="group_department" domain="[]" context="{'group_by': 'department'}"/>
                        <filter string="Designation" name="group_designation" domain="[]" context="{'group_by': 'designation'}"/>
                        <filter string="Employee Status" name="group_status" domain="[]" context="{'group_by': 'employee_status'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- India Staging Data Action -->
        <record id="action_zoho_staging_data_india" model="ir.actions.act_window">
            <field name="name">India Staging Data</field>
            <field name="res_model">zoho.staging.data</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="domain">['|', ('country', '=', 'IN'), ('country', '=', False)]</field>
            <field name="context">{'default_country': 'IN', 'search_default_country': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No India staging data found!
                </p>
                <p>
                    Import employee data from Zoho to see India payroll staging information.
                </p>
            </field>
        </record>
        
        <!-- India Employee Data Action -->
        <record id="action_zoho_employee_data_india" model="ir.actions.act_window">
            <field name="name">India Employee Payroll Data</field>
            <field name="res_model">zoho.employee.data</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="domain">['|', ('country', '=', 'IN'), ('country', '=', False)]</field>
            <field name="context">{'default_country': 'IN', 'search_default_country': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No India employee payroll data found!
                </p>
                <p>
                    Process payroll calculations in the spreadsheet to see India employee data.
                </p>
            </field>
        </record>
        
        <!-- India Staging Data Kanban View -->
        <record id="view_zoho_staging_data_kanban_india" model="ir.ui.view">
            <field name="name">zoho.staging.data.kanban.india</field>
            <field name="model">zoho.staging.data</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="full_name_en"/>
                    <field name="department"/>
                    <field name="designation"/>
                    <field name="base_salary"/>
                    <field name="hra"/>
                    <field name="pf_employee"/>
                    <field name="uan_number"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img alt="Avatar" t-att-src="kanban_image('zoho.staging.data', 'image_128', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="full_name_en"/>
                                    </strong>
                                    <div class="o_kanban_tags_section">
                                        <span class="o_kanban_tag">
                                            <i class="fa fa-building-o"/> <field name="department"/>
                                        </span>
                                        <span class="o_kanban_tag">
                                            <i class="fa fa-user"/> <field name="designation"/>
                                        </span>
                                    </div>
                                    <ul>
                                        <li><strong>Basic:</strong> ₹<field name="base_salary"/></li>
                                        <li><strong>HRA:</strong> ₹<field name="hra"/></li>
                                        <li><strong>PF:</strong> ₹<field name="pf_employee"/></li>
                                        <li><strong>UAN:</strong> <field name="uan_number"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- India Employee Data Kanban View -->
        <record id="view_zoho_employee_data_kanban_india" model="ir.ui.view">
            <field name="name">zoho.employee.data.kanban.india</field>
            <field name="model">zoho.employee.data</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="full_name_en"/>
                    <field name="department"/>
                    <field name="gross_salary"/>
                    <field name="net_pay"/>
                    <field name="base_salary"/>
                    <field name="pf_employee"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img alt="Avatar" t-att-src="kanban_image('zoho.employee.data', 'image_128', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="full_name_en"/>
                                    </strong>
                                    <div class="o_kanban_tags_section">
                                        <span class="o_kanban_tag">
                                            <i class="fa fa-building-o"/> <field name="department"/>
                                        </span>
                                    </div>
                                    <ul>
                                        <li><strong>Gross Pay:</strong> ₹<field name="gross_salary"/></li>
                                        <li><strong>Net Pay:</strong> ₹<field name="net_pay"/></li>
                                        <li><strong>Basic:</strong> ₹<field name="base_salary"/></li>
                                        <li><strong>PF:</strong> ₹<field name="pf_employee"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Update India Staging Data Action to include Kanban -->
        <record id="action_zoho_staging_data_india" model="ir.actions.act_window">
            <field name="view_mode">kanban,list,form,pivot</field>
        </record>
        
        <!-- Update India Employee Data Action to include Kanban -->
        <record id="action_zoho_employee_data_india" model="ir.actions.act_window">
            <field name="view_mode">kanban,list,form,pivot</field>
        </record>
        
    </data>
</odoo>