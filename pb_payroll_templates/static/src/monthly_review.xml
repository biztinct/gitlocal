<templates xml:space="preserve">
  <t t-name="pb_payroll_templates.MonthlyReview">
    <Dialog title="'Review monthly inputs'" size="'xl'" fullscreen="state.expanded" contentClass="'pt-sheet-dialog'" bodyClass="'pt-sheet-body'" withBodyPadding="false">
      <t t-set-slot="header"><div class="pt-sheet-title"><span class="pt-sheet-emblem">▦</span><div><h4>Review monthly inputs</h4><small><t t-esc="period(data.period)"/> · <t t-esc="data.config_name"/></small></div></div><button class="pt-icon-btn" t-att-aria-label="state.expanded ? 'Collapse review' : 'Expand review'" t-att-title="state.expanded ? 'Collapse review' : 'Expand to full screen'" t-on-click="()=>state.expanded=!state.expanded"><i t-att-class="state.expanded ? 'fa fa-compress' : 'fa fa-expand'"/></button><button class="pt-icon-btn" aria-label="Close review" t-on-click="close" t-att-disabled="state.busy"><i class="fa fa-times"/></button></t>
      <div class="pt-input-sheet">
        <div class="pt-sheet-intro"><div><div class="pt-sheet-eyebrow">YOUR PAYROLL, BEFORE YOU RUN IT</div><h2>Every input. Every source. Every change.</h2><p>Edit any input below. Corrections apply to <b t-esc="period(data.period)"/> only.</p></div><span class="pt-sheet-file"><i class="fa fa-file-excel-o"/><span t-esc="data.filename"/></span></div>
        <div class="pt-sheet-metrics">
          <button t-att-class="state.filter==='changed' ? 'active' : ''" t-on-click="()=>this.setFilter(state.filter==='changed'?'all':'changed')"><span class="pt-metric-icon amber">↗</span><div><strong t-esc="stats.changed"/><span>changed since <t t-esc="period(data.previous_period)"/></span><small><t t-esc="stats.people"/> employees affected</small></div></button>
          <button t-on-click="()=>this.setFilter('all')"><span class="pt-metric-icon blue">▦</span><div><strong t-esc="stats.excel"/><span>from your Excel workbook</span><small>Blank cells keep saved values</small></div></button>
          <button t-on-click="()=>this.setFilter('all')"><span class="pt-metric-icon teal"><i class="fa fa-database"/></span><div><strong t-esc="stats.system"/><span>from system &amp; defaults</span><small>Employee, contract and monthly records</small></div></button>
          <button t-att-class="state.filter==='issues' ? 'active' : ''" t-on-click="()=>this.setFilter(state.filter==='issues'?'all':'issues')"><span t-att-class="'pt-metric-icon '+(stats.issues+stats.missing?'rose':'teal')"><t t-esc="stats.issues+stats.missing?'!':'✓'"/></span><div><strong t-esc="stats.issues+stats.missing"/><span>inputs need attention</span><small t-esc="stats.issues+stats.missing ? 'Fix directly in the grid' : 'Ready for your final review'"/></div></button>
        </div>
        <div class="pt-baseline-note"><i class="fa fa-history"/><div><b>Compared with <t t-esc="period(data.previous_period)"/></b><span>Finalized payroll is preferred; computed payroll or saved inputs are labelled per cell. Same-month reruns never become the comparison.</span></div><span class="pt-baseline-coverage"><t t-esc="stats.compared"/> / <t t-esc="data.grid.rows.length*data.grid.columns.length"/> comparable cells</span></div>
        <div class="pt-sheet-errors" role="alert" t-if="data.structural_issues.length"><b>Workbook structure needs attention. Correct the file and upload again.</b><ul><li t-foreach="data.structural_issues" t-as="issue" t-key="issue_index" t-esc="issue"/></ul></div>
        <details class="pt-sheet-warnings" t-if="data.warnings.length"><summary><t t-esc="data.warnings.length"/> saved record values refreshed</summary><ul><li t-foreach="data.warnings" t-as="w" t-key="w_index" t-esc="w"/></ul></details>
        <div class="pt-sheet-toolbar"><div class="pt-sheet-search"><i class="fa fa-search"/><input aria-label="Search employees" placeholder="Find employee or ID…" t-att-value="state.query" t-on-input="ev=>this.search('query',ev)"/></div><div class="pt-sheet-search fields"><i class="fa fa-columns"/><input aria-label="Search input fields" placeholder="Find an input field…" t-att-value="state.fieldQuery" t-on-input="ev=>this.search('fieldQuery',ev)"/></div><div class="pt-sheet-filters"><button t-att-class="state.filter==='all'?'active':''" t-on-click="()=>this.setFilter('all')">All inputs</button><button t-att-class="state.filter==='changed'?'active':''" t-on-click="()=>this.setFilter('changed')">Changed</button><button t-att-class="state.filter==='issues'?'active':''" t-on-click="()=>this.setFilter('issues')">Needs attention</button><button t-att-class="state.filter==='edited'?'active':''" t-on-click="()=>this.setFilter('edited')">Edited <t t-if="stats.edited" t-esc="stats.edited"/></button></div></div>
        <div class="pt-sheet-legend"><span><i class="source-excel"/> Excel</span><span><i class="source-system"/> System record</span><span><i class="source-default"/> Default</span><span><i class="source-edited"/> Edited here</span><span><i class="legend-changed"/> Changed since last month</span><span><i class="legend-issue"/> Needs attention</span><small>Click a cell for its source and previous value · Tab to move · Paste from Excel</small></div>
        <div class="pt-grid-wrap" t-ref="grid"><table class="pt-input-grid" aria-label="Monthly payroll input spreadsheet"><thead><tr class="pt-grid-letters"><th class="pt-row-number">#</th><th class="pt-employee-col">A · B</th><th t-foreach="columns" t-as="c" t-key="c.id" t-esc="letter(data.grid.columns.indexOf(c))"/></tr><tr class="pt-grid-head"><th class="pt-row-number"/><th class="pt-employee-col">Employee <small>Employee ID · Name</small></th><th t-foreach="columns" t-as="c" t-key="c.id" t-att-title="c.code"><b t-esc="c.label"/><small><t t-esc="unit(c)"/><span t-if="c.required"> · Required</span><span t-if="c.readonly"> · Saved record</span></small></th></tr></thead><tbody><tr t-foreach="rows" t-as="row" t-key="row.emp_id"><td class="pt-row-number" t-esc="state.page*40+row_index+1"/><th class="pt-employee-col"><b t-esc="row.name"/><small t-esc="row.code"/></th><td t-foreach="columns" t-as="c" t-key="c.id" t-att-class="cellClass(row.cells[c.id])" t-att-title="cellTitle(c,row.cells[c.id])"><div class="pt-cell-top"><span class="pt-cell-source" t-esc="sourceLabel(row.cells[c.id])"/><span class="pt-cell-change" t-if="row.cells[c.id].changed">↗ changed</span><span class="pt-cell-alert" t-if="row.cells[c.id].issue or row.cells[c.id].missing">!</span></div><input t-att-type="c.kind==='date'?'date':'text'" t-att-inputmode="['money','quantity','decimal','integer','rate'].includes(c.kind)?'decimal':'text'" t-att-aria-label="row.name+' · '+c.label" t-att-aria-invalid="!!(row.cells[c.id].issue or row.cells[c.id].missing)" t-att-data-row="row_index" t-att-data-col="c_index" t-att-value="inputValue(row.cells[c.id].value)" t-att-placeholder="row.cells[c.id].missing?'Required':'Not entered'" t-att-disabled="state.busy" t-on-focus="()=>this.focus(row,c)" t-on-input="ev=>this.onInput(row,c,ev)" t-on-paste="ev=>this.paste(row_index,c_index,ev)" t-on-keydown="ev=>this.keydown(row_index,c_index,ev)"/><div class="pt-cell-prior"><t t-if="row.cells[c.id].issue"><span class="pt-cell-error" t-esc="row.cells[c.id].issue"/></t><t t-elif="row.cells[c.id].has_prior">Prior: <t t-esc="format(row.cells[c.id].prior)"/></t><t t-else="">No prior value</t></div></td></tr></tbody></table><div t-if="!rows.length or !columns.length" class="pt-grid-empty"><i class="fa fa-search"/><b>No inputs match this view</b><span>Try another employee, field or filter.</span></div></div>
        <div class="pt-grid-bottom"><div class="pt-sheet-tabs"><button t-att-class="state.tab==='all'?'active':''" t-on-click="()=>this.setTab('all')">All inputs <span t-esc="data.grid.columns.length"/></button><button t-foreach="['Time','Monthly adjustments','Other inputs']" t-as="tab" t-key="tab" t-att-class="state.tab===tab?'active':''" t-on-click="()=>this.setTab(tab)" t-esc="tab"/></div><div class="pt-grid-pagination"><span><t t-esc="filteredRows.length"/> employees</span><button aria-label="Previous employees" t-att-disabled="state.page===0" t-on-click="()=>state.page--">‹</button><span><t t-esc="state.page+1"/> / <t t-esc="pages"/></span><button aria-label="Next employees" t-att-disabled="state.page+1>=pages" t-on-click="()=>state.page++">›</button></div></div>
        <div class="pt-cell-inspector" t-if="active"><span class="pt-inspector-icon"><i class="fa fa-info"/></span><div><b><t t-esc="active.row.name"/> · <t t-esc="active.column.label"/></b><span><t t-esc="sourceLabel(activeCell)"/> · <t t-esc="activeCell.detail"/><t t-if="active.column.readonly"> · Editing creates an override for this month only</t></span></div><div class="pt-inspector-prior"><small t-esc="baselineLabel(activeCell)"/><b><t t-esc="format(activeCell.prior)"/> <span>→</span> <t t-esc="format(activeCell.value)"/></b></div><button t-if="state.edits[active.row.emp_id+':'+active.column.id]" class="pt-reset-cell" t-on-click="restoreActive">Undo cell edit</button></div>
        <div class="pt-cell-inspector empty" t-else=""><i class="fa fa-mouse-pointer"/> Select a cell to inspect its source and previous-month value. Employee identity and calculated fields stay protected.</div>
        <div class="pt-sheet-errors" t-if="state.error" role="alert" t-esc="state.error"/>
      </div>
      <t t-set-slot="footer"><button class="btn btn-secondary" t-on-click="close" t-att-disabled="state.busy">Cancel</button><button class="pt-reset-all" t-if="editCount" t-on-click="reset" t-att-disabled="state.busy">Undo all edits</button><div class="pt-sheet-footer-note"><b t-esc="editCount ? editCount+' edits made here' : 'Review before applying'"/><span>Selected month only · Employee and contract records stay unchanged</span></div><button class="btn btn-primary pt-use-inputs" t-on-click="confirm" t-att-disabled="!canConfirm"><t t-esc="state.busy?'Applying inputs…':'Use reviewed inputs'"/> <i class="fa fa-arrow-right"/></button></t>
    </Dialog>
  </t>
</templates>
