<templates xml:space="preserve">
  <t t-name="pb_payroll_templates.Workspace">
    <div class="pt-workspace">
      <div class="pt-top"><button t-if="fromPayRun" class="pt-back" t-on-click="returnToPayRun" t-att-disabled="state.busy"><t t-esc="state.dirty ? '← Save &amp; return to Pay Run' : '← Pay Run · Pay data'"/></button><button t-else="" class="pt-back" t-on-click="openConfigurations">← Payroll configurations</button><span aria-hidden="true">/</span><span>Configure Templates</span></div>
      <div class="pt-content">
        <header class="pt-heading"><div><div class="pt-eyebrow"><t t-esc="fromPayRun ? 'Pay Run · Pay data' : 'Payroll configuration'"/></div><h1>Configure Templates</h1><p>Keep employee records current. Configure reusable monthly input templates.</p></div>
          <div class="pt-config" t-if="state.data"><span class="pt-country" t-esc="config.country"/><div><select aria-label="Payroll configuration" t-on-change="changeConfig" t-att-disabled="state.busy or state.dirty" title="Save the monthly layout before switching configurations."><option t-foreach="state.data.configs" t-as="c" t-key="c.id" t-att-value="c.id" t-att-selected="c.id === state.configId" t-esc="c.name"/></select><small><t t-esc="state.data.currency"/> · <t t-esc="state.data.people"/> employees</small></div></div>
        </header>
        <div t-if="state.error" class="pt-error" role="alert" t-esc="state.error"/>
        <div t-if="state.data and state.data.roster_note" class="pt-note" t-esc="state.data.roster_note"/>
        <div t-if="state.data and state.data.selection_notice" class="pt-note" t-esc="state.data.selection_notice"/>
        <div t-if="state.busy" class="pt-progress" role="status">Preparing your workbook…</div>
        <t t-if="state.data and state.data.config_id">
          <nav class="pt-nav"><button t-att-class="state.screen === 'downloads' ? 'active' : ''" t-on-click="() => this.show('downloads')">Downloads</button><button t-att-class="state.screen === 'layout' ? 'active' : ''" t-on-click="() => this.show('layout')">Monthly layout <i t-if="state.dirty">Unsaved</i></button><button t-att-class="state.screen === 'history' ? 'active' : ''" t-on-click="() => this.show('history')">Import history</button><span>Two workbooks. One place.</span></nav>
          <input type="file" accept=".xlsx" t-ref="file" t-on-change="onFile" class="d-none"/>
          <t t-if="state.screen === 'downloads'">
            <div class="pt-cards">
              <section class="pt-card"><div class="pt-eyebrow">1 · Monthly pay inputs</div><h2>Your monthly input template</h2><p>Time and Monthly adjustments come filled from connected records for your chosen month and remain editable. Employee records is a locked reference sheet.</p>
                <div class="pt-book monthly"><span class="pt-sheet-icon">▤</span><small>Time + Monthly adjustments + <t t-esc="'Employee records (locked)'"/></small><h3>Three tabs.<br/>Ready for your pay month.</h3><p><t t-esc="state.data.people"/> employees · <t t-esc="monthlyCount"/> column<t t-if="monthlyCount !== 1">s</t><br/>Connected values included · Employee records is locked</p><div class="pt-mini-lines"><span/><span/><span/><span/></div></div>
                <label class="pt-month">Pay month <input type="month" aria-label="Template pay month" t-att-value="state.period" t-on-change="changeMonth" t-att-disabled="state.busy"/></label><div class="pt-pills"><span>Connected records included</span><span>Editable Time &amp; Monthly adjustments</span></div>
                <div class="pt-actions"><button class="pt-button primary" t-on-click="() => this.download('template')" t-att-disabled="state.busy or !state.data.can_export">↓ Download template</button></div><p>Review the populated values, fill any gaps and upload it for the same pay month. Pending approvals and unavailable values remain blank.</p>
                <footer><button class="pt-link" t-on-click="() => this.show('layout')">Configure columns →</button><button class="pt-link" t-on-click="openPayRun" t-att-disabled="state.busy or (!fromPayRun and (state.data.state !== 'active' or !state.data.people))"><t t-esc="fromPayRun ? 'Return to Pay Run →' : 'Use in Pay Run →'"/></button></footer>
              </section>
              <section class="pt-card"><div class="pt-eyebrow">2 · Employee &amp; contract records</div><h2>Make a lasting change</h2><p>Employee details, contracted salary and fixed recurring allowances. Pre-filled with the latest saved records.</p>
                <div class="pt-book"><span class="pt-sheet-icon">▦</span><small>Employee records</small><h3>Your people.<br/>Their current records.</h3><p><t t-esc="state.data.people"/> employees · <t t-esc="state.data.record_columns"/> fields<br/>Identity columns are read-only</p><div class="pt-mini-lines"><span/><span/><span/><span/></div></div>
                <div class="pt-pills"><span>Latest saved records</span><span>Identity protected</span></div>
                <div class="pt-actions"><button class="pt-button primary" t-on-click="() => this.download('records')" t-att-disabled="state.busy or !state.data.can_export">↓ Download records</button><button class="pt-button" t-on-click="() => this.choose('records')" t-att-disabled="state.busy">↑ Import changes</button></div>
                <footer><small>Includes saved-record fields selected in Employee records or Monthly adjustments. Record changes require a separate reviewed import.</small><button class="pt-link" t-on-click="() => this.show('layout')">Configure fields →</button></footer>
              </section>
            </div>
            <div class="pt-rules"><div><b>Blank means keep</b><span>Leave cells blank to keep current values.</span></div><div><b>Zero means update</b><span>Enter 0 to set an amount to zero.</span></div><div><b>Review before applying</b><span>See exactly what will change.</span></div></div>
            <div class="pt-note">The download uses the selected month’s connected records and saved inputs. Previous months’ bonuses and deductions never carry forward. Missing or unapproved source values remain blank. To edit a mapped record for payroll, move it into Monthly adjustments; the Employee records worksheet stays locked.</div>
            <div class="pt-note" t-if="state.data.state !== 'active' or !state.data.people">Activate this configuration and assign employees before starting a pay run. You can prepare its templates now.</div>
          </t>
          <t t-elif="state.screen === 'layout'">
            <div class="pt-section-head"><div><h2>A workbook that fits your payroll</h2><p>Drag fields between tabs, or use each field’s menu. Arrange them in the order your team works.</p></div><div class="pt-actions"><span t-att-class="state.dirty ? 'pt-draft' : 'pt-saved'" t-esc="state.dirty ? 'Unsaved changes' : 'Layout saved'"/><button class="pt-button primary" t-on-click="save" t-att-disabled="!state.dirty or state.busy or !state.data.can_layout">Save layout</button><button t-if="fromPayRun" class="pt-button" t-on-click="returnToPayRun" t-att-disabled="state.busy"><t t-esc="state.dirty ? 'Save &amp; return to Pay Run' : 'Return to Pay Run'"/></button></div></div>
            <div class="pt-layout-tools"><input class="pt-search" placeholder="Find a field…" aria-label="Find a field" t-model="state.query"/><button class="pt-button" t-att-aria-expanded="state.showCalculated ? 'true' : 'false'" aria-controls="pt-calculated-fields" t-on-click="() => state.showCalculated = !state.showCalculated"><t t-esc="state.showCalculated ? 'Hide calculated fields' : 'Show calculated fields'"/> (<t t-esc="state.data.calculated_fields.length"/>)</button></div>
            <section t-if="state.showCalculated" id="pt-calculated-fields" class="pt-calculated"><h3>Calculated fields · reference only</h3><p>Payroll calculates these fields. They cannot be added to the input template or moved between tabs.</p><div class="pt-calculated-list"><article t-foreach="calculatedFields" t-as="f" t-key="f.id" class="pt-calculated-field"><b t-esc="f.label"/><small><t t-esc="f.column"/> · <t t-esc="f.code"/> · Read-only</small><code t-if="f.formula" t-esc="f.formula"/></article></div><p t-if="!calculatedFields.length">No calculated fields match your search.</p></section>
            <div class="pt-layout">
              <t t-foreach="['available','time','adjustments','records']" t-as="lane" t-key="lane">
                <section t-attf-class="pt-lane {{ lane === 'available' ? 'palette' : lane === 'records' ? 'records' : '' }}" t-on-dragover="allowDrop" t-on-drop="(ev) => this.drop(ev,lane)">
                  <header><h3 t-esc="lane === 'available' ? 'Available fields' : lane === 'time' ? '① Time' : lane === 'adjustments' ? '② Monthly adjustments' : '③ Employee records'"/><small t-esc="lane === 'available' ? 'Extra inputs and saved context' : lane === 'time' ? 'Days, hours and time quantities' : lane === 'adjustments' ? 'Amounts paid or deducted this month' : 'Locked reference sheet · move a field to Monthly adjustments to edit it'"/></header>
                  <div class="pt-identity" t-if="lane !== 'available'"><b><t t-esc="state.data.identity_labels.code"/> + <t t-esc="state.data.identity_labels.name"/></b><small>Always included · Values from mapped employee records</small></div>
                  <div class="pt-fields">
                    <div t-foreach="fieldsIn(lane)" t-as="f" t-key="f.id" t-attf-class="pt-field {{ f.record_eligible ? 'record-field' : 'monthly-field' }}" t-att-draggable="state.data.can_layout ? 'true' : 'false'" t-att-data-field="f.id" t-att-aria-label="f.label + ', ' + lane" t-on-dragstart="ev => this.startDrag(ev,f.id)" t-on-dragover="allowDrop" t-on-drop="ev => this.drop(ev,lane,f.id)">
                      <span class="pt-grip">⠿</span><div class="pt-field-name"><b t-esc="f.label"/><small t-esc="f.source_summary ? f.source_summary : f.application_source ? f.reason : f.record_eligible ? 'Saved record · ' + (f.record_group === 'bank' ? 'Bank' : f.record_group === 'employee' ? 'Employee' : f.record_group === 'contract' ? 'Contract' : 'Contract component') : f.default === lane ? 'Suggested · ' + f.reason : 'Custom placement'"/></div><span class="pt-unit" t-esc="unit(f)"/>
                      <button class="pt-field-more" t-att-aria-label="'Move ' + f.label" t-on-click="() => state.menu = state.menu === f.id ? '' : f.id" t-att-disabled="!state.data.can_layout">⋮</button>
                      <div class="pt-field-menu" t-if="state.menu === f.id"><button t-if="lane !== 'time' and canPlace(f.id,'time')" t-on-click="() => this.move(f.id,'time')">Move to Time</button><button t-if="lane !== 'adjustments' and canPlace(f.id,'adjustments')" t-on-click="() => this.move(f.id,'adjustments')">Move to Monthly adjustments</button><button t-if="lane !== 'records' and canPlace(f.id,'records')" t-on-click="() => this.move(f.id,'records')">Move to Employee records</button><button t-on-click="() => this.earlier(f.id,lane)">Move earlier</button><button t-on-click="() => this.later(f.id,lane)">Move later</button><button t-if="lane !== 'available'" t-on-click="() => this.move(f.id,'available')">Remove from workbook</button></div>
                    </div>
                    <div t-if="!fieldsIn(lane).length" class="pt-empty" t-esc="state.query ? 'No input fields match your search.' : 'Drop fields here'"/>
                  </div><footer t-if="lane !== 'available'" t-esc="lane === 'records' ? 'Locked in monthly downloads. Use Records Desk for master changes, or move a field to Monthly adjustments for reviewed payroll edits.' : 'Blank cells keep this month’s saved values.'"/>
                </section>
              </t>
            </div>
            <div class="pt-note">Green fields are saved master data and can be placed in Employee records or Monthly adjustments. Their mappings and review permissions stay the same. Yellow fields are monthly inputs and can only be placed in Time or Monthly adjustments. Use Show calculated fields to inspect formula outputs. Defaults use component types, quantities and record mappings. Review ambiguous inputs before first use. Moving a field changes its worksheet and position; its payroll calculation stays the same.</div>
            <div class="pt-section-head"><h2>Live workbook preview</h2><span t-esc="state.dirty ? 'Draft layout' : 'Saved layout'"/></div>
            <div class="pt-preview"><div class="pt-preview-tabs"><button t-att-class="state.preview === 'time' ? 'active' : ''" t-on-click="() => state.preview='time'">Time</button><button t-att-class="state.preview === 'adjustments' ? 'active' : ''" t-on-click="() => state.preview='adjustments'">Monthly adjustments</button><button t-att-class="state.preview === 'records' ? 'active' : ''" t-on-click="() => state.preview='records'"><t t-esc="'Employee records (locked)'"/></button></div><table><thead><tr><th t-esc="state.data.identity_labels.code"/><th t-esc="state.data.identity_labels.name"/><th t-foreach="fieldsIn(state.preview)" t-as="f" t-key="f.id" t-esc="f.label"/></tr></thead><tbody><tr><td>Mapped employee code</td><td>Mapped employee name</td><td t-foreach="fieldsIn(state.preview)" t-as="f" t-key="f.id" t-esc="f.readonly ? 'Saved record' : 'Monthly input'"/></tr></tbody></table><small>The scheme’s employee code stays first on all three tabs. Monthly templates include connected values for the chosen period.</small></div>
          </t>
          <t t-elif="state.screen === 'history'"><h2>Import history</h2><p>Confirmed workbook changes for this payroll configuration.</p><div class="pt-history"><div t-if="!state.data.history.length" class="pt-empty">Your confirmed imports will appear here.</div><article t-foreach="state.data.history" t-as="h" t-key="h.id"><span class="pt-history-icon">✓</span><div><b t-esc="h.filename"/><small><t t-esc="h.by"/> · <t t-esc="h.when"/> · <t t-esc="h.mode === 'monthly' ? h.period : 'Employee records'"/></small></div><strong><t t-esc="h.count"/> changes</strong><span t-att-class="h.pending ? 'pt-draft' : 'pt-saved'" t-esc="h.pending ? 'Submitted for approval' : 'Confirmed'"/></article></div><button class="pt-link" t-on-click="openRecords">Employee change approvals and Undo → Records Desk history</button></t>
        </t>
        <div t-elif="state.data" class="pt-empty">Create a payroll configuration to start using templates.</div>
      </div>
    </div>
  </t>

  <t t-name="pb_payroll_templates.Review">
    <Dialog title="state.result ? 'Import confirmed' : 'Here’s what will change'" size="'xl'">
      <div class="pt-review">
        <t t-if="state.result"><div class="pt-success">✓</div><h2 t-esc="state.result.pending ? 'Sent for approval' : 'Import confirmed'"/><p t-esc="state.result.pending ? 'Employee and contract records will update when the existing approval route completes.' : props.data.mode === 'monthly' ? 'These inputs belong only to the selected pay month. They are ready for the selected pay period.' : 'Download the employee workbook again to see the updated records.'"/><p t-if="state.result.with_whom" t-esc="state.result.with_whom"/><p t-if="!state.result.pending"><t t-esc="state.result.written"/> values saved.</p><div class="pt-error" t-if="state.result.refused and state.result.refused.length"><b>Some values could not be saved</b><ul><li t-foreach="state.result.refused" t-as="r" t-key="r_index"><t t-esc="r.emp_name"/> · <t t-esc="r.why"/></li></ul></div></t>
        <t t-else=""><div class="pt-review-file"><span>▦</span><div><b t-esc="props.data.filename"/><small t-esc="props.data.mode === 'monthly' ? props.data.period + ' · Time + Monthly adjustments · Employee records ignored' : 'Employee and contract records'"/></div><span class="pt-saved" t-if="!props.data.issues.length">Ready to confirm</span></div>
          <div class="pt-metrics"><div><b t-esc="props.data.changes.length"/><small>changes</small></div><div><b t-esc="props.data.blanks"/><small>blanks ignored</small></div><div><b t-esc="props.data.unchanged"/><small>unchanged values</small></div><div><b t-esc="props.data.issues.length"/><small>issues</small></div></div>
          <div class="pt-error" t-if="props.data.issues.length"><b>Resolve these issues and import again</b><ul><li t-foreach="props.data.issues" t-as="i" t-key="i_index" t-esc="i"/></ul></div>
          <div class="pt-review-scroll"><table class="pt-review-table"><thead><tr><th/><th>Employee</th><th>Field</th><th>Current value</th><th/><th>Will become</th></tr></thead><tbody><tr t-foreach="props.data.changes" t-as="c" t-key="c.key"><td><input type="checkbox" t-att-aria-label="'Apply ' + c.field_label + ' for ' + c.emp_name" t-att-checked="state.selected.includes(c.key)" t-on-change="()=>this.toggle(c.key)"/></td><td><b t-esc="c.emp_name"/></td><td><b t-esc="c.field_label"/><small t-esc="c.tab"/></td><td t-esc="c.old_label || value(c.old)"/><td>→</td><td><strong t-esc="c.new_label || value(c.value)"/><span class="pt-zero" t-if="c.value === 0">Set to 0</span></td></tr></tbody></table></div>
          <div class="pt-note" t-if="!props.data.changes.length and !props.data.issues.length">Nothing changes. All supplied values already match, or the editable cells are blank.</div>
          <p class="pt-note">Blank cells are ignored. Identity columns stay protected. Confirmed employee changes follow the existing approval route.</p>
        </t>
        <div class="pt-error" t-if="state.error" role="alert" t-esc="state.error"/>
      </div>
      <t t-set-slot="footer"><button class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.busy" t-esc="state.result ? 'Done' : 'Cancel'"/><button t-if="!state.result and props.data.mode === 'monthly' and !props.data.changes.length and !props.data.issues.length" class="btn btn-primary" t-on-click="useCurrent" t-att-disabled="state.busy">Use current monthly inputs</button><button t-elif="!state.result" class="btn btn-primary" t-on-click="confirm" t-att-disabled="state.busy or !state.selected.length or props.data.issues.length"><t t-if="state.busy">Saving…</t><t t-else="">Confirm <t t-esc="state.selected.length"/> change<t t-if="state.selected.length !== 1">s</t></t></button></t>
    </Dialog>
  </t>

  <t t-name="pb_payroll_templates.StudioDoors" t-inherit="pb_formula_studio.PbFormulaStudio" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('cs-card-actions')]" position="inside"><button class="pbfs-btn soft sm" t-on-click="() => this.openPayrollTemplates(c.id)">Configure Templates</button></xpath>
    <xpath expr="//div[hasclass('pbfs-cfg')]" position="inside"><button class="pbfs-btn soft sm" t-on-click="() => this.openPayrollTemplates(state.config.id)">Configure Templates</button></xpath>
  </t>
  <t t-name="pb_payroll_templates.PayrunDoors" t-inherit="pb_payrun_wizard.PayrunWizard" t-inherit-mode="extension">
    <xpath expr="//div[@data-coach='pw-scope']" position="before"><div class="pt-note" t-if="state.form.templates_monthly and !state.sheet.file_name">Payroll scheme selected from Templates. No workbook has been uploaded. Choose the pay period, then upload and confirm your Excel workbook in the Pay data step.</div></xpath>
    <xpath expr="//div[@data-coach='pw-paydata']/div[1]/p[1]" position="after"><div class="pt-payrun-doors"><button class="pw-btn pw-btn--sm" t-on-click="openPayrollTemplates"><t t-out="ic('settings',15)"/> Configure Templates</button><button class="pw-btn pw-btn--sm" t-on-click="downloadMonthlyTemplate">↓ Download this month’s template</button><small>Configure a reusable layout, then return here to upload this month’s file.</small><small t-if="!state.sheet.file_name">No workbook uploaded yet. Downloading a template does not import it.</small></div></xpath>
    <xpath expr="//t[@t-if='state.sheet.file_name']" position="attributes"><attribute name="t-if">state.sheet.file_name and !state.sheet.templateFile</attribute></xpath>
    <xpath expr="//div[hasclass('pw-cov')]" position="before"><div class="pt-note" t-if="state.sheet.templateFile">Uploaded and confirmed: <b t-esc="state.sheet.uploadedName"/>. Monthly inputs are ready for <t t-esc="state.form.date_start.slice(0,7)"/>. System records are refreshed when the run starts; confirmed edits apply to this month only. <button class="pt-link" t-if="state.sheet.reviewToken" t-on-click="reviewMonthlyInputs">Review inputs →</button></div></xpath>
    <xpath expr="//div[@class='pw-cov']" position="attributes"><attribute name="t-if">!state.sheet.templateFile</attribute></xpath>
    <xpath expr="//div[hasclass('pw-covlist')]" position="attributes"><attribute name="t-if">!state.sheet.templateFile</attribute></xpath>
  </t>
</templates>
