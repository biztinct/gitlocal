<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="pb_coach.CoachOverlay">
  <div class="pbc" t-att-class="{ 'pbc-live': state.active }">

    <!-- ============ SPOTLIGHT (dim everything but the target) ============ -->
    <t t-if="state.active and ui.hasTarget">
      <div class="pbc-spot" t-att-style="spotStyle"/>
      <!-- animated pointer -->
      <div class="pbc-pointer" t-att-style="pointerStyle">
        <span class="pbc-pointer-ic"><t t-out="icon('hand', 30)"/></span>
      </div>
    </t>

    <!-- soft full-screen scrim when we have no specific target (centered card) -->
    <t t-if="state.active and !ui.hasTarget">
      <div class="pbc-scrim"/>
    </t>

    <!-- ==================== COACH CARD ==================== -->
    <t t-if="state.active">
      <div class="pbc-card" t-ref="card" t-att-class="cardPlaceClass" t-att-style="cardStyle">
        <div class="pbc-card-top">
          <span class="pbc-eyebrow">
            <span class="pbc-dot"/> Step <t t-esc="state.index + 1"/> of <t t-esc="state.steps.length"/>
          </span>
          <div class="pbc-top-actions">
            <button class="pbc-mini" t-att-class="{ 'pbc-mini--on': state.mode === 'autoplay' }"
                    t-on-click="toggleMode"
                    t-att-title="state.mode === 'autoplay' ? 'Pause autoplay' : 'Watch (autoplay)'">
              <t t-out="icon(state.mode === 'autoplay' ? 'pause' : 'play', 13)"/>
              <span t-esc="state.mode === 'autoplay' ? 'Watching' : 'Watch'"/>
            </button>
            <button class="pbc-x" t-on-click="onSkip" title="End tour"><t t-out="icon('x', 16)"/></button>
          </div>
        </div>

        <h3 class="pbc-title" t-esc="step and step.title"/>
        <p class="pbc-body" t-esc="step and step.body"/>

        <t t-if="ui.resolving">
          <div class="pbc-hint"><span class="pbc-spin"/> Finding it on your screen…</div>
        </t>

        <div class="pbc-rail">
          <t t-foreach="state.steps" t-as="s" t-key="s_index">
            <span class="pbc-rail-seg"
                  t-att-class="{ 'is-done': s_index &lt; state.index, 'is-cur': s_index === state.index }"/>
          </t>
        </div>

        <div class="pbc-foot">
          <button class="pbc-btn pbc-btn--ghost" t-if="state.index &gt; 0" t-on-click="onBack">
            <t t-out="icon('back', 14)"/> Back
          </button>
          <span class="pbc-sp"/>
          <button class="pbc-btn pbc-btn--ghost pbc-skip" t-on-click="onSkip">Skip</button>
          <button class="pbc-btn pbc-btn--primary" t-on-click="onNext">
            <t t-if="isLast">Finish <t t-out="icon('check', 14)"/></t>
            <t t-else="">
              <t t-esc="step and step.action === 'click' ? 'Got it' : 'Next'"/> <t t-out="icon('arrow', 14)"/>
            </t>
          </button>
        </div>
      </div>
    </t>

    <!-- ==================== WELCOME MODAL ==================== -->
    <t t-if="state.welcome">
      <div class="pbc-modal-scrim" t-on-click="dismissWelcome"/>
      <div class="pbc-welcome">
        <span class="pbc-welcome-badge"><t t-out="icon('sparkles', 26)"/></span>
        <h2>Welcome to Payobook 👋</h2>
        <p class="pbc-welcome-lead">
          You're in a live, read-only demo world — 4,500 employees and a formula-driven
          payroll ready to explore. Let's run your first pay run in about two minutes.
        </p>
        <div class="pbc-welcome-actions">
          <button class="pbc-btn pbc-btn--primary pbc-btn--lg" t-on-click="() => this.startHero('interactive')">
            <t t-out="icon('compass', 16)"/> Take the tour
          </button>
          <button class="pbc-btn pbc-btn--soft pbc-btn--lg" t-on-click="() => this.startHero('autoplay')">
            <t t-out="icon('play', 16)"/> Watch it play
          </button>
        </div>
        <button class="pbc-welcome-skip" t-on-click="dismissWelcome">I'll explore on my own</button>
      </div>
    </t>

    <!-- ==================== "GETTING STARTED" LAUNCHER ==================== -->
    <t t-if="ui.showLauncher and !state.active and !state.welcome">
      <div class="pbc-launcher">
        <t t-if="ui.launcherOpen">
          <div class="pbc-launch-menu">
            <div class="pbc-launch-head"><t t-out="icon('compass', 15)"/> Guided tours</div>
            <button class="pbc-launch-item pbc-launch-item--hero" t-if="screenTour"
                    t-on-click="() => this.launch(screenTour.id)">
              <span class="pbc-launch-nm"><t t-out="icon('play', 13)"/> Tour this screen</span>
              <span class="pbc-launch-sm" t-esc="screenTour.name"/>
            </button>
            <button class="pbc-launch-item" t-foreach="tourList" t-as="tr" t-key="tr.id"
                    t-on-click="() => this.launch(tr.id)">
              <span class="pbc-launch-nm" t-esc="tr.name"/>
              <span class="pbc-launch-sm" t-esc="tr.summary"/>
            </button>
          </div>
        </t>
        <button class="pbc-fab" t-on-click="toggleLauncher" title="Guided tours">
          <t t-out="icon(ui.launcherOpen ? 'x' : 'help', 20)"/>
        </button>
      </div>
    </t>

    <!-- ==================== EPHEMERAL-DATA DISCLAIMER ==================== -->
    <t t-if="ui.showDisclaimer and !state.active and !state.welcome">
      <div class="pbc-disclaimer">
        <span class="pbc-disc-ic"><t t-out="icon('info', 15)"/></span>
        <span class="pbc-disc-tx">
          Shared demo — pay slips you generate are temporary and may be cleaned or overwritten
          by another demo user.
          <a class="pbc-disc-link" t-on-click="requestCustomDemo">Want a private demo?</a>
        </span>
        <button class="pbc-disc-x" t-on-click="dismissDisclaimer" title="Dismiss"><t t-out="icon('x', 13)"/></button>
      </div>
    </t>

  </div>
</t>

</templates>
