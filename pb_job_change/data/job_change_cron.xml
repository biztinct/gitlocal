<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Approved job changes are written on their day.

         Hourly, so a change starts within the hour after midnight in its
         company's own time zone. Each change is its own transaction, written
         all-or-none; one that cannot be written is sent back with the reason
         (a quiet to-do for whoever prepared it, never an email). With nothing
         scheduled it reads one empty list and stops. -->
    <record id="ir_cron_job_change_start_due" model="ir.cron">
        <field name="name">Change job: start approved changes on their day</field>
        <field name="model_id" ref="model_pb_job_change"/>
        <field name="state">code</field>
        <field name="code">model._cron_start_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
