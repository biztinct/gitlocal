#. module: pb_job_change
#. odoo-python
#: code:addons/pb_job_change/models/job_change.py:0
msgid "%(co)s pays in %(cur)s. Type the new monthly pay in %(cur)s too."
msgstr "%(co)s trả lương bằng %(cur)s. Hãy nhập lương tháng mới bằng %(cur)s."

#. module: pb_job_change
