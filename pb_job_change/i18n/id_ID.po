#. module: pb_job_change
#. odoo-python
#: code:addons/pb_job_change/models/job_change.py:0
msgid "%(who)s already has a job change waiting (%(ref)s). Finish or cancel that one first."
msgstr "%(who)s sudah punya perubahan jabatan yang menunggu (%(ref)s). Selesaikan atau batalkan dulu."

#. module: pb_job_change
#. odoo-python
#: code:addons/pb_job_change/models/job_change.py:0
msgid "%s has no running contract, so their pay cannot be changed here."
msgstr "%s tidak punya kontrak yang berjalan, jadi gajinya tidak bisa diubah di sini."

#. module: pb_job_change
#. odoo-javascript
#: code:addons/pb_job_change/static/src/xml/job_change.xml:0
msgid "(written automatically on its start date)"
msgstr "(ditulis otomatis pada tanggal mulainya)"

#. module: pb_job_change
#. odoo-javascript
#: code:addons/pb_job_change/static/src/xml/job_change.xml:0
msgid ", a date in the past. It is written when it is signed off and recorded as starting that day."
msgstr ", tanggal yang sudah lewat. Perubahan ditulis saat disetujui dan dicatat mulai pada hari itu."

#. module: pb_job_change
#. odoo-javascript
#: code:addons/pb_job_change/static/src/xml/job_change.xml:0
msgid ", early that morning. Nothing has changed yet."
msgstr ", pagi-pagi hari itu. Belum ada yang berubah."

#. module: pb_job_change
#. odoo-javascript
#: code:addons/pb_job_change/static/src/xml/job_change.xml:0
msgid ". Check their next payslip with the pay team."
msgstr ". Periksa slip gaji berikutnya bersama tim penggajian."

#. module: pb_job_change
#. odoo-javascript
#: code:addons/pb_job_change/static/src/xml/job_change.xml:0
msgid ". Once it is signed off it waits, and is written that morning."
msgstr ". Setelah disetujui, perubahan menunggu dan ditulis pagi hari itu."

#. module: pb_job_change
#. odoo-javascript
#: code:addons/pb_job_change/static/src/xml/job_change.xml:0
msgid ". The person, their contract and their pay now read the new details."
msgstr ". Karyawan, kontrak dan gajinya kini memakai rincian baru."

#. module: pb_job_change
