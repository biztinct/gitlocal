#. module: pb_job_change
#. odoo-python
#: code:addons/pb_job_change/models/job_change.py:0
msgid "%(co)s pays in %(cur)s. Type the new monthly pay in %(cur)s too."
msgstr "%(co)s membayar dalam %(cur)s. Ketik gaji bulanan baru dalam %(cur)s juga."

#. module: pb_job_change
#. odoo-python
#: code:addons/pb_job_change/models/job_change.py:0
msgid "%(m)s reports to %(p)s, so %(p)s cannot report to %(m)s."
msgstr "%(m)s melapor ke %(p)s, jadi %(p)s tidak bisa melapor ke %(m)s."

#. module: pb_job_change
#. odoo-python
#: code:addons/pb_job_change/models/job_change.py:0
msgid "%(what)s belongs to %(co)s, not %(target)s."
msgstr "%(what)s milik %(co)s, bukan %(target)s."

#. module: pb_job_change
#. odoo-python
#: code:addons/pb_job_change/models/job_change.py:0
