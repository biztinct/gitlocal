#. module: pb_schedule
#: model:ir.model.constraint,message:pb_schedule.constraint_hr_shift_coverage_requirement_headcount_positive
msgid "A coverage requirement cannot be negative."
msgstr "Yêu cầu bảo hiểm không thể âm."

#. module: pb_schedule
#. odoo-python
#: code:addons/pb_schedule/models/shift_coverage.py:0
msgid ""
"A coverage requirement needs either a weekday (the standing rule) or a specific date "
"(the exception) — exactly one of them."
msgstr ""
"Yêu cầu bảo hiểm cần một ngày trong tuần (quy tắc thường trực) hoặc một ngày cụ thể "
"(ngoại lệ) - chính xác là một trong số đó."

#. module: pb_schedule
#. odoo-python
#: code:addons/pb_schedule/models/schedule_budget.py:0
msgid "A labour budget cannot be negative."
msgstr "Ngân sách lao động không thể âm."

#. module: pb_schedule
#: model:ir.model.fields,help:pb_schedule.field_hr_shift_coverage_requirement__date
msgid "A one-off requirement. When both exist, the date wins."
msgstr "Một yêu cầu một lần. Khi cả hai tồn tại, ngày thắng."

#. module: pb_schedule
#. odoo-javascript
#: code:addons/pb_schedule/static/src/xml/pb_schedule.xml:0
msgid ""
"A weekday row is the standing rule; a date row is the exception and\n"
"            wins for that day. A row with no shift states a whole-day total.\n"
"            Departments with a rule of their own are not also subject to the\n"
"            company-wide one."
msgstr ""
"Hàng ngày trong tuần là quy tắc thường trực; một hàng ngày là ngoại lệ và\n"
"            chiến thắng cho ngày hôm đó. Một hàng không có ca cho biết tổng cộng cả ngày.\n"
"            Các phòng ban có quy định riêng cũng không phải tuân theo\n"
"            toàn công ty."

