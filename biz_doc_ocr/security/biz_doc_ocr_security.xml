<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Job rows hold extraction results (PII: whatever the consumer's schema
         pulled out of the document) — a plain user touches only their OWN jobs. -->
    <record id="doc_ocr_job_rule_own" model="ir.rule">
        <field name="name">Doc OCR job: own</field>
        <field name="model_id" ref="model_biz_doc_ocr_job"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="doc_ocr_job_rule_system" model="ir.rule">
        <field name="name">Doc OCR job: system (all)</field>
        <field name="model_id" ref="model_biz_doc_ocr_job"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
