<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Retry cron: re-attempt pending / failed(attempts<3) OCR jobs every 5
         minutes — covers slow local Ollama/Tesseract runs and API blips. -->
    <record id="cron_biz_doc_ocr_retry" model="ir.cron">
        <field name="name">Document OCR: retry pending jobs</field>
        <field name="model_id" ref="model_biz_doc_ocr_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_retry()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
