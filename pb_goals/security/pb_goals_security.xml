<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         THREE RUNGS, AND A LINE MANAGER IS NOT ON ANY OF THEM.

         That is the whole shape of the permissions here and it is worth
         saying out loud, because the obvious design is wrong. A manager needs
         to read and weigh their own team's goal sheets — and handing every
         manager in the company a group would hand them the WHOLE company's
         goal sheets, which is the opposite of what anybody meant. The record
         rule carries them instead: "sheets of people who report to me" is a
         domain, and a domain is exactly the right tool for a permission that
         is granted by a RECORD rather than by a group.

         So the ladder is for the HR side of it:

           * Goals user   — the HR administrator who sets the year up and
                            watches the board.
           * Goals manager— the HR lead who agrees and locks, and may hand out
                            goal sheets to a whole company.
           * Head of goals— plus the switches.

         NO `&` IN A PRIVILEGE NAME, EVER (R124). Odoo 19 builds the user
         form's access-rights arch by embedding privilege names into
         `<group string="…">` without escaping, and one ampersand makes
         opening ANY user from Settings crash — found live when the owner
         tried to change their own password.
         ================================================================== -->

    <record id="module_category_goals" model="ir.module.category">
        <field name="name">Goals</field>
        <field name="sequence">58</field>
    </record>

    <!-- Odoo 19 pattern: `res.groups` has no `category_id`; a privilege
         record carries it instead. -->
    <record id="res_groups_privilege_goals" model="res.groups.privilege">
        <field name="name">Goals</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_goals"/>
    </record>

    <record id="group_goals_user" model="res.groups">
        <field name="name">Goals administrator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_goals"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read every goal sheet in the company, set the goal year up and write the goal templates. This is the group the Goals board is for.</field>
    </record>

    <record id="group_goals_manager" model="res.groups">
        <field name="name">HR lead for goals</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_goals"/>
        <field name="implied_ids" eval="[(4, ref('group_goals_user'))]"/>
        <field name="comment">Everything above, plus agreeing and locking a goal sheet, sending one back, setting weights on anybody's, and opening a goal sheet for everybody in a company at once.</field>
    </record>

    <record id="group_goals_admin" model="res.groups">
        <field name="name">Head of goals</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_goals"/>
        <field name="implied_ids" eval="[(4, ref('group_goals_manager'))]"/>
        <!-- The two built-in administrator accounts and NOBODY ELSE. Every
             other person is added by a human, on purpose. -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Everything above, plus the switches: whether goal sheets open themselves for a new joiner, whether people are chased, and how long the sign-off has before it is escalated.</field>
    </record>

</odoo>
