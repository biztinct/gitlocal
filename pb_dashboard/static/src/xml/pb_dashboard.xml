<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="pb_dashboard.PbDashboard">
    <div class="pbd-root" t-att-class="{ 'pbd-root--embedded': props.embedded }">
        <t t-if="state.loaded">
            <!-- Hero (solid) -->
            <div class="pbd-hero" data-coach="dash-hero">
                <div class="pbd-hero-l">
                    <!-- The one element the Home hub already owns: its command
                         bar says "Home", so this line would be the second thing
                         on screen naming where you are (W17). The greeting, the
                         run summary and both hero buttons stay — an embedded
                         mode that removed a figure or a door would be a fork. -->
                    <div class="pbd-eyebrow" t-if="!props.embedded" t-esc="companyEyebrow()"/>
                    <h1><t t-esc="greeting()"/>, <t t-esc="state.d.user"/></h1>
                    <div class="pbd-sub" t-if="isEmpty">No payroll data yet — let's get you set up</div>
                    <div class="pbd-sub" t-else="">
                        <t t-esc="state.d.run.name"/> · <t t-esc="state.d.run.done"/>/<t t-esc="state.d.run.slips"/> payslips done ·
                        <t t-esc="state.d.kpis.pending"/> awaiting approval
                    </div>
                </div>
                <div class="pbd-hero-r">
                    <button class="pbd-btn-glass" data-coach="dash-runpayroll" t-on-click="() => this.open('pb_payrun_wizard.action_pb_payrun_wizard')">
                        <t t-out="icon('zap',15)"/> Run Payroll</button>
                    <button class="pbd-btn-glass" t-on-click="() => this.openInsights()">
                        <t t-out="icon('trending-up',15)"/> Analytics</button>
                </div>
            </div>

            <!-- Activation checklist. Sits BETWEEN the hero and the KPI strip
                 so every data-coach anchor below stays exactly where it was;
                 the KPIs and cards still render, showing honest zeros.

                 It is drawn while the tenant has no pay run and disappears for
                 good once it has one. Every tick comes from a count the server
                 took this second, so there is no state in here to get wrong.
                 The first unfinished step is the only primary button on the
                 screen. -->
            <div class="pbd-act" t-if="activation">
                <div class="pbd-act-head">
                    <span class="pbd-act-hic"><t t-out="icon('flag',18)"/></span>
                    <div class="pbd-act-hx">
                        <div class="pbd-act-t">Get your first payroll out</div>
                        <div class="pbd-act-s">Each step opens the screen it talks about. Come back here any time.</div>
                    </div>
                    <div class="pbd-act-count"><t t-esc="activation.doneCount"/> of <t t-esc="activation.items.length"/> done</div>
                </div>
                <ol class="pbd-acts">
                    <li t-foreach="activation.items" t-as="it" t-key="it.key"
                        class="pbd-act-i"
                        t-att-class="{ 'is-done': it.done, 'is-next': it_index === activation.next }">
                        <span class="pbd-act-mark">
                            <t t-if="it.done"><t t-out="icon('check',14)"/></t>
                            <t t-else=""><t t-out="icon(it.icon,15)"/></t>
                        </span>
                        <div class="pbd-act-x">
                            <div class="pbd-act-n" t-esc="it.title"/>
                            <div class="pbd-act-d" t-esc="it.desc"/>
                        </div>
                        <button class="pbd-btn" t-att-class="{ ghost: it_index !== activation.next }"
                                t-on-click="() => this.runStep(it)"><t t-esc="it.cta"/></button>
                    </li>
                </ol>
            </div>

            <!-- WHICH MONTH THESE FIGURES ARE ABOUT.
                 The one line this page never had. It comes BEFORE the numbers
                 because a reader who never touches the strip below still has
                 to know what they are looking at (R4). -->
            <div class="pbd-period" data-coach="dash-period">
                <span class="pbd-period-ic"><t t-out="icon('calendar',15)"/></span>
                <b class="pbd-period-t" t-esc="periodLine"/>
                <span t-if="period and period.latest" class="pbd-period-tag">the latest payroll month</span>
                <span t-if="period and period.state === 'current'" class="pbd-period-tag now">this month</span>
                <span t-if="state.scoping" class="pbd-period-busy" role="status">Reading…</span>
                <button t-if="period and !period.latest" class="pbd-period-back"
                        t-on-click="() => this.toLatest()">
                    Back to the latest month
                </button>
            </div>

            <!-- A link that named a month this database does not have.
                 Not an error, and never a blank screen: the server answered
                 with the latest one and says so here (ledger rule 21). -->
            <div t-if="period and period.fell_back" class="pbd-period-note"
                 t-esc="fellBackLine"/>

            <!-- KPI strip -->
            <div class="pbd-kpis" data-coach="dash-kpis">
                <div class="pbd-kpi k-indigo"><div class="kl">Headcount <t t-out="icon('users',15)"/></div><div class="kv" t-esc="state.d.kpis.headcount"/><div class="ks" t-esc="activeContractsLabel()"/></div>
                <div class="pbd-kpi k-green"><div class="kl">Monthly payroll <t t-out="icon('wallet',15)"/></div><div class="kv" t-esc="money(state.d.kpis.payroll)"/><div class="ks" t-esc="payrollCaption"/></div>
                <div class="pbd-kpi k-amber"><div class="kl">Pending approval <t t-out="icon('clock',15)"/></div><div class="kv" t-esc="state.d.kpis.pending"/><div class="ks">awaiting sign-off</div></div>
                <div class="pbd-kpi k-cyan"><div class="kl">Active configs <t t-out="icon('calculator',15)"/></div><div class="kv" t-esc="state.d.formula.active"/><div class="ks" t-esc="rulesLabel()"/></div>
            </div>

            <!-- THE STRIP. One chip per payroll month, oldest to newest, each
                 carrying how many people were paid in it against the busiest
                 month — so the shape of the year is readable before anything
                 is pressed. Many months scroll; none is ever dropped.

                 Nothing here is `disabled` while the board re-scopes: the
                 guard is in the handler, or the chip the keyboard is standing
                 on loses focus mid-flight and the next arrow press goes
                 nowhere (T23). -->
            <div t-if="periods.length" class="pbd-strip" t-ref="strip"
                 t-on-keydown="onStripKey"
                 role="group" aria-label="Pick a payroll month">
                <button t-foreach="periods" t-as="mo" t-key="mo.key"
                        class="pbd-mchip"
                        t-att-class="{ 'is-on': isLit(mo.key),
                                       'is-now': mo.state === 'current',
                                       'is-quiet': !mo.people }"
                        t-att-data-month="mo.key"
                        t-att-title="chipTitle(mo)"
                        t-att-aria-pressed="isLit(mo.key) ? 'true' : 'false'"
                        t-on-click="() => this.pressChip(mo)">
                    <span class="pbd-mchip-l">
                        <b t-esc="mo.short"/><i t-esc="mo.year"/>
                    </span>
                    <span class="pbd-mchip-bar">
                        <span class="pbd-mchip-fill"
                              t-attf-style="width: {{barWidth(mo)}}%"/>
                    </span>
                    <span class="pbd-mchip-v" t-esc="chipCount(mo)"/>
                    <span t-if="mo.latest" class="pbd-mchip-flag">latest</span>
                </button>
            </div>
            <div t-if="periods.length" class="pbd-striphint" t-esc="stripHint"/>

            <!-- Nobody has been paid on this database yet. Not a hole where a
                 strip should be: a sentence, and the one thing to do next.

                 Every sentence in this block is built as ONE string in JS and
                 printed with a single `t-esc`: a sentence written either side
                 of a `<t t-esc/>` is TWO msgids no translator can reorder
                 (L17), and the whitespace an XML file indents with is baked
                 into whatever the extractor collects. -->
            <div t-else="" class="pbd-strip-empty">
                <t t-out="icon('calendar',16)"/>
                <!-- The space between the two is an EXPLICIT non-breaking
                     space, not the newline above it: whitespace between two
                     adjacent nodes is whitespace the browser may collapse
                     (GR22), and it read "months yet.Once a pay run" on the
                     golden template. -->
                <span>
                  <b t-esc="emptyStripLead"/>&#160;<t t-esc="emptyStripLine"/>
                </span>
            </div>

            <!-- Cockpit cards -->
            <div class="pbd-grid">
                <div class="pbd-card">
                    <div class="pbd-card-head">
                        <div><div class="pbd-card-t">Latest pay run</div><div class="pbd-card-m" t-esc="state.d.run.name"/></div>
                        <!-- With no payslips there is no readiness to measure,
                             and a red empty dial is a measurement this tenant
                             has not earned. Draw the placeholder instead —
                             same idiom as the Company-overview card below. -->
                        <t t-if="state.d.run.slips" t-out="ring(state.d.run.readiness)"/>
                        <span class="pbd-ring-none" t-else="">—</span>
                    </div>
                    <div class="pbd-pills">
                        <span class="pbd-pill ok"><t t-esc="state.d.run.done"/>/<t t-esc="state.d.run.slips"/> done</span>
                        <span class="pbd-pill warn" t-if="state.d.run.pending"><t t-esc="state.d.run.pending"/> pending</span>
                    </div>
                    <div class="pbd-mini">
                        <div><div class="mv" t-esc="state.d.run.slips"/><div class="ml">Payslips</div></div>
                        <div><div class="mv" t-esc="state.d.run.done"/><div class="ml">Approved</div></div>
                        <div><div class="mv" t-esc="state.d.run.pending"/><div class="ml">Pending</div></div>
                    </div>
                    <button class="pbd-link" t-on-click="() => this.open('pb_payruns.action_pb_payruns_kanban')">Open pay runs →</button>
                </div>

                <div class="pbd-card">
                    <div class="pbd-card-head">
                        <div><div class="pbd-card-t">Company overview</div><div class="pbd-card-m">All departments · monthly</div></div>
                        <!-- The 100 was a decoration, not a measurement. With nobody
                             on the payroll there is nothing to be 100% of, and a red
                             0 ring would be a different lie — so it draws nothing. -->
                        <t t-if="!isEmpty and state.d.kpis.headcount" t-out="ring(100)"/>
                    </div>
                    <div class="pbd-pills">
                        <span class="pbd-pill muted"><t t-esc="state.d.kpis.headcount"/> headcount</span>
                        <span class="pbd-pill warn"><t t-esc="state.d.kpis.pending"/> approvals</span>
                    </div>
                    <div class="pbd-mini">
                        <div><div class="mv" t-esc="money(state.d.kpis.payroll)"/><div class="ml">Payroll</div></div>
                        <div><div class="mv" t-esc="money(state.d.kpis.avg)"/><div class="ml">Avg salary</div></div>
                        <div><div class="mv" t-esc="money(state.d.kpis.contributions)"/><div class="ml">Contributions</div></div>
                    </div>
                    <button class="pbd-link" t-on-click="() => this.openInsights()">Open analytics →</button>
                </div>

                <div class="pbd-card" data-coach="dash-formula">
                    <div class="pbd-card-head">
                        <div><div class="pbd-card-t">Formula engine</div><div class="pbd-card-m">Excel-driven configs</div></div>
                        <!-- Nothing configured yet is not nought percent
                             healthy; it is nothing to be healthy about. -->
                        <t t-if="state.d.formula.count" t-out="ring(state.d.formula.health)"/>
                        <span class="pbd-ring-none" t-else="">—</span>
                    </div>
                    <div class="pbd-pills">
                        <span class="pbd-pill cyan"><t t-esc="state.d.formula.active"/> active</span>
                        <span class="pbd-pill muted"><t t-esc="state.d.formula.count"/> configs</span>
                    </div>
                    <div class="pbd-mini">
                        <div><div class="mv" t-esc="state.d.formula.rules"/><div class="ml">Rules</div></div>
                        <div><div class="mv" t-esc="state.d.formula.count"/><div class="ml">Configs</div></div>
                        <div><div class="mv" t-esc="state.d.formula.tests"/><div class="ml">Tests</div></div>
                    </div>
                    <button class="pbd-link" t-on-click="() => this.open('pb_formula_studio.action_pb_formula_studio')">Open formula engine →</button>
                </div>
            </div>
        </t>
        <t t-else=""><div class="pbd-loading">Loading dashboard…</div></t>
    </div>
</t>

</templates>
