<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Analytics Action -->
    <record id="action_payroll_analytics" model="ir.actions.act_window">
        <field name="name">Analytics Records</field>
        <field name="res_model">payroll.analytics</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No analytics records found!
            </p>
            <p>
                Analytics are automatically generated when payslip batches reach Level 2 approval status.
            </p>
        </field>
    </record>
    
    <!-- Analytics Dashboard Action -->
    <record id="action_payroll_analytics_dashboard" model="ir.actions.act_window">
        <field name="name">Analytics Dashboard</field>
        <field name="res_model">payroll.analytics</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_analytics_dashboard"/>
        <field name="target">current</field>
    </record>
    
    <!-- Bank Export Wizard Action -->
    <record id="action_payroll_bank_export_wizard" model="ir.actions.act_window">
        <field name="name">Bank Export Wizard</field>
        <field name="res_model">payroll.bank.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <!-- Main Analytics Menu -->
    <menuitem id="menu_payroll_analytics_root"
              name="Payroll Analytics"
              parent="om_hr_payroll.menu_hr_payroll_root"
              sequence="90"
              groups="payroll_analytics_approval.group_payroll_analytics_user"/>
    
    <!-- Analytics Dashboard Menu -->
    <menuitem id="menu_payroll_analytics_dashboard"
              name="Analytics Dashboard"
              parent="menu_payroll_analytics_root"
              action="action_payroll_analytics_dashboard"
              sequence="10"
              groups="payroll_analytics_approval.group_payroll_analytics_manager"/>
    
    <!-- Analytics Records Menu -->
    <menuitem id="menu_payroll_analytics_records"
              name="Analytics Records"
              parent="menu_payroll_analytics_root"
              action="action_payroll_analytics"
              sequence="20"
              groups="payroll_analytics_approval.group_payroll_analytics_user"/>
    
    <!-- Bank Export Menu -->
    <menuitem id="menu_payroll_bank_export"
              name="Bank Export"
              parent="menu_payroll_analytics_root"
              action="action_payroll_bank_export_wizard"
              sequence="30"
              groups="payroll_analytics_approval.group_payroll_analytics_manager"/>
    
</odoo>