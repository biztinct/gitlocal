<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payroll_component_detail_tree" model="ir.ui.view">
        <field name="name">payroll.analytics.component.detail.tree</field>
        <field name="model">payroll.analytics.component.detail</field>
        <field name="arch" type="xml">
            <list string="Component Detail" create="0" edit="0"
                  decoration-success="variance_percent &gt; 0"
                  decoration-danger="variance_percent &lt; 0"
                  decoration-muted="variance_percent == 0">
                <field name="employee_id" string="Employee Name"/>
                <field name="current_total" string="Current Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="previous_total" string="Previous Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="variance_percent" string="Variance %" widget="percentage"/>
            </list>
        </field>
    </record>
</odoo>
