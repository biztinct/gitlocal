<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Record Rules -->
    <record id="payroll_analytics_rule_user" model="ir.rule">
        <field name="name">Payroll Analytics: User Access</field>
        <field name="model_id" ref="model_payroll_analytics"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('state', 'in', ['ready', 'approved'])]</field>
        <field name="groups" eval="[(4, ref('pb_hr_payroll_base.group_payroll_analytics_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
    <record id="payroll_analytics_rule_manager" model="ir.rule">
        <field name="name">Payroll Analytics: Manager Access</field>
        <field name="model_id" ref="model_payroll_analytics"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('pb_hr_payroll_base.group_payroll_analytics_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    
    <!-- Approval Rules -->
    <record id="payroll_analytics_approval_rule" model="ir.rule">
        <field name="name">Payroll Analytics: Final Approval</field>
        <field name="model_id" ref="model_payroll_analytics"/>
        <field name="domain_force">[('state', '=', 'ready')]</field>
        <field name="groups" eval="[(4, ref('pb_hr_payroll_base.group_payroll_final_approver'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    
</odoo>
