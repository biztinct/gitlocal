<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FLEET P5 — what a paused customer's people see.

         STANDALONE, NOT `web.layout`. This page has to render on a database
         whose whole web client is behind the door it is standing in front of,
         and it must carry no navigation, no product chrome and above all no
         login form: somebody turned away from their payroll must not be shown
         a box that looks like their password stopped working.

         Every word on it is the product's own (rail R7) and every sentence is
         plain: what has happened, what has NOT happened to their data, and who
         to ask. -->
    <!-- The doctype is ESCAPED, exactly as the framework's own `web.layout`
         escapes it: a DOCTYPE declaration inside element content is not
         well-formed XML, and the file would not load at all. -->
    <template id="paused_page" name="Payobook access paused">&lt;!DOCTYPE html&gt;
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title t-if="paused">Payobook — access paused</title>
                <title t-else="">Payobook</title>
                <style>
                    * { box-sizing: border-box; }
                    body { margin:0; min-height:100vh; display:flex; align-items:center;
                           justify-content:center; padding:24px;
                           background:#F7F6FB; color:#1E1B2E;
                           font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; }
                    .pbp-card { width:100%; max-width:480px; background:#fff;
                                border:1px solid #E6E4F0; border-radius:18px;
                                padding:38px 34px 30px; box-shadow:0 18px 46px rgba(30,27,46,.09);
                                animation:pbp-in .34s cubic-bezier(.2,.7,.3,1) both; }
                    @keyframes pbp-in { from { opacity:0; transform:translateY(10px); }
                                        to { opacity:1; transform:none; } }
                    @media (prefers-reduced-motion: reduce) { .pbp-card { animation:none; } }
                    .pbp-brand { font-size:11px; letter-spacing:.16em; text-transform:uppercase;
                                 color:#5A4BB0; font-weight:800; margin-bottom:22px; }
                    .pbp-ic { width:52px; height:52px; border-radius:14px;
                              display:flex; align-items:center; justify-content:center;
                              background:#F1F0F7; color:#5A4BB0; margin-bottom:18px; }
                    .pbp-ic.ok { background:#E7F3EC; color:#2E7D4F; }
                    h1 { font-size:22px; margin:0 0 10px; letter-spacing:-.3px; }
                    p { font-size:15px; line-height:1.6; margin:0 0 12px; color:#3B3752; }
                    .pbp-quiet { font-size:13px; color:#6B6880; }
                    .pbp-safe { border-left:3px solid #2E7D4F; background:#F5FAF7;
                                padding:11px 14px; border-radius:0 10px 10px 0;
                                font-size:14px; margin:18px 0 20px; }
                    .pbp-acts { display:flex; gap:10px; flex-wrap:wrap; margin-top:6px; }
                    a.pbp-btn { display:inline-flex; align-items:center; gap:7px;
                                padding:9px 15px; border-radius:9px; font-size:14px;
                                font-weight:600; text-decoration:none;
                                border:1px solid #E6E4F0; color:#3B3752; background:#fff; }
                    a.pbp-btn.primary { background:#5A4BB0; border-color:#5A4BB0; color:#fff; }
                </style>
            </head>
            <body>
                <div class="pbp-card">
                    <div class="pbp-brand">Payobook</div>
                    <t t-if="paused">
                        <div class="pbp-ic">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                        </div>
                        <h1>Your Payobook access is paused</h1>
                        <p t-esc="text"/>
                        <div class="pbp-safe">
                            <b>Nothing has been deleted.</b> Every employee, contract, pay run
                            and payslip is exactly where you left it, and it all comes back
                            the moment access is restored.
                        </div>
                        <p class="pbp-quiet">
                            If you think this is a mistake, ask your administrator to get in
                            touch with Payobook — it usually takes a few minutes to put right.
                        </p>
                    </t>
                    <t t-else="">
                        <div class="pbp-ic ok">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="m9 12 2 2 4-4"/>
                                <circle cx="12" cy="12" r="10"/>
                            </svg>
                        </div>
                        <h1>Your access is back</h1>
                        <p>Everything is open again. Carry on where you left off.</p>
                    </t>
                    <div class="pbp-acts">
                        <a t-if="not paused" class="pbp-btn primary" href="/">Open Payobook</a>
                        <a class="pbp-btn" href="/web/session/logout">Sign out</a>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
