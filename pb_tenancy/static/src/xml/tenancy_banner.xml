<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="pb_tenancy.Banner">
    <PbTenancyBar t-if="notice" notice="notice" onDismiss.bind="dismiss"/>
</t>

<t t-name="pb_tenancy.Bar">
    <div t-attf-class="pbtn-bar pbtn-{{ kind }} {{ props.preview ? 'pbtn-preview' : '' }}"
         role="status" aria-live="polite">
        <span class="pbtn-bar-ic"><t t-out="ic(icon, 17)"/></span>
        <span class="pbtn-bar-kind" t-esc="label"/>
        <span class="pbtn-bar-tt" t-esc="props.notice.title"/>
        <span t-if="props.notice.text" class="pbtn-bar-tx" t-esc="props.notice.text"/>
        <span t-if="range" class="pbtn-bar-when"><t t-out="ic('clock', 13)"/> <t t-esc="range"/></span>
        <!-- An update in progress swaps the close button for a live dot: it
             cannot be hidden, and the dot says why it is still there. -->
        <span t-if="props.notice.live" class="pbtn-bar-live" title="This is happening right now"/>
        <button t-elif="dismissable" class="pbtn-bar-x" t-on-click="props.onDismiss"
                title="Hide this message">
            <t t-out="ic('x', 14)"/>
        </button>
    </div>
</t>

</templates>
