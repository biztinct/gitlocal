<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="pb_attendance_flow.PbAttendanceFlow">
    <div class="pbaf pbim" t-att-class="{ 'pbaf--embedded': props.embedded }">

      <!-- ============================ loading ============================ -->
      <div t-if="!state.loaded" class="pbaf-loading">
        <div class="pbaf-spin"/><span>Loading Attendance Control…</span>
      </div>

      <!-- ============================ BOARD ============================= -->
      <div t-elif="state.view === 'board' and state.data" class="pbaf-wrap">

        <!-- hero + KPIs. Embedded: the Time hub already drew the page header,
             the window is the hub's week and Import is a sibling lens — so the
             whole hero goes (W17: suppress only chrome the host owns). -->
        <div class="pbaf-hero" t-if="!props.embedded">
          <div class="pbaf-hero-main">
            <div class="eyebrow"><span class="i" t-out="ic('clock',15)"/> Attendance Control</div>
            <h1>Exceptions &amp; corrections</h1>
            <div class="sub">
              <span t-esc="state.data.window.from"/> → <span t-esc="state.data.window.to"/>
              <t t-if="state.data.truncated">
                <span class="dot">•</span>
                <span class="warn"><t t-esc="state.data.truncated"/> more employees not shown</span>
              </t>
            </div>
          </div>
          <button class="pbaf-btn ghost" t-on-click="openImport">
            <span t-out="ic('upload',16)"/><span>Import punches</span>
          </button>
        </div>

        <!-- The numbers: one quiet line (QUIET_BOARD_ROLLOUT). Amber when
             exceptions or corrections are waiting on someone; the rest neutral. -->
        <t t-call="pb_import_kit.QuietGlance">
          <t t-set="qGlance" t-value="glance"/>
          <t t-set="qGlanceOn" t-value="glanceOn"/>
        </t>

        <div class="pbaf-cols">

          <!-- ===================== exceptions queue ==================== -->
          <section class="pbaf-panel exceptions">
            <div class="panel-h">
              <div class="ttl"><span t-out="ic('inbox',18)"/> Exceptions queue</div>
            </div>

            <!-- The shared context's pinned person, as a clearable chip
                 (P1b §2.4). A filtered queue that does not SAY it is filtered
                 reads as "this person has no exceptions" — which is the
                 opposite of the truth when the pin simply matched nobody. -->
            <div class="pbaf-pfilter" t-if="personFilter">
              <span class="i" t-out="ic('user',13)"/>
              <span class="n" t-esc="personFilter.name or ('#' + personFilter.id)"/>
              <span class="s">only</span>
              <button class="x" t-on-click="() => this.clearPersonFilter()"
                      title="Show everyone" aria-label="Show everyone">
                <span t-out="ic('x',12)"/>
              </button>
            </div>

            <div class="pbaf-tabs">
              <button t-attf-class="tab {{ state.activeKind === 'all' ? 'active' : '' }}"
                      t-on-click="() => this.setKind('all')">
                All <span class="c" t-esc="state.data.exceptions.length"/>
              </button>
              <button t-foreach="kindTabs" t-as="t" t-key="t.kind"
                      t-attf-class="tab {{ state.activeKind === t.kind ? 'active' : '' }}"
                      t-on-click="() => this.setKind(t.kind)">
                <span class="i" t-out="ic(t.icon,14)"/>
                <t t-esc="t.label"/> <span class="c" t-esc="t.count"/>
              </button>
            </div>

            <!-- empty state -->
            <div t-if="!visibleExceptions.length" class="pbaf-empty">
              <span class="i" t-out="ic('checkCircle',30)"/>
              <div class="t">All clear</div>
              <div class="s">No attendance exceptions in this window. Nice.</div>
            </div>

            <div t-else="" class="pbaf-exc-list">
              <div t-foreach="visibleExceptions" t-as="x" t-key="x_index"
                   t-attf-class="exc-row {{ KIND_META[x.kind].tone }}">
                <span class="kind-ico" t-out="ic(kindIcon(x.kind),18)"/>
                <img class="av" t-att-src="x.avatar_url" alt=""/>
                <div class="who">
                  <div class="nm" t-esc="x.name"/>
                  <div class="dt">
                    <t t-esc="x.date"/>
                    <t t-if="x.shift_code"> · <span class="chip" t-esc="x.shift_code"/></t>
                  </div>
                </div>
                <div class="detail" t-esc="x.detail"/>
                <span t-if="x.minutes" t-attf-class="mins {{ minutesTone(x.minutes) }}">
                  <t t-esc="x.minutes"/>m
                </span>
                <div class="acts">
                  <button class="pbaf-btn tiny primary" t-on-click="() => this.fileCorrection(x)">
                    <span t-out="ic('edit',13)"/><span>File correction</span>
                  </button>
                  <button class="pbaf-btn tiny ghost" t-on-click="() => this.openEmployee(x.employee_id)"
                          title="Open employee record">
                    <span t-out="ic('user',13)"/>
                  </button>
                </div>
              </div>
            </div>
          </section>

          <!-- ===================== corrections pipeline ================ -->
          <section class="pbaf-panel corrections">
            <div class="panel-h">
              <div class="ttl"><span t-out="ic('edit',18)"/> Corrections</div>
            </div>

            <!-- FILTER wave 7: the shared filter panel over the corrections
                 (views, search, the left panel with counts, the chips).
                 Embedded, the Time hub's week, department and pinned person
                 arrive as chips the officer can remove. -->
            <div class="pbaf-corr-filter">
            <PbFilterLayout kit="kit" searchPlaceholder="searchHint">

            <div t-if="!state.corrLoaded" class="pbaf-skel" aria-busy="true" aria-label="Loading corrections">
              <span/><span/><span/>
            </div>

            <div t-elif="kit.failed" class="pbaf-empty small">
              <span class="i" t-out="ic('alertCircle',26)"/>
              <div class="t">The corrections could not be loaded</div>
              <div class="s" t-if="kit.refusal" t-esc="kit.refusal"/>
              <div class="s" t-else="">Reload the page to try again.</div>
            </div>

            <div t-elif="corrEmpty === 'none'" class="pbaf-empty small">
              <span class="i" t-out="ic('sparkles',26)"/>
              <div class="t">No corrections yet</div>
              <div class="s">File one from an exception above.</div>
            </div>

            <div t-elif="corrEmpty === 'calm'" class="pbaf-empty small">
              <span class="i" t-out="ic('checkCircle',26)"/>
              <div class="t">Nothing is waiting for approval</div>
              <div class="s">Every correction filed so far has been decided.</div>
              <button class="pbaf-btn tiny ghost" t-on-click="corrShowAll">Show all corrections</button>
            </div>

            <div t-elif="corrEmpty === 'search'" class="pbaf-empty small">
              <span class="i" t-out="kic('search',26)"/>
              <div class="t">Nothing matches “<t t-esc="kit.search"/>”</div>
              <div class="s">Try a reference, a person’s name or a word from the reason.</div>
              <button class="pbaf-btn tiny ghost" t-on-click="() => kit.setSearch('', true)">Clear the search</button>
            </div>

            <div t-elif="corrEmpty === 'filters'" class="pbaf-empty small">
              <span class="i" t-out="ic('inbox',26)"/>
              <div class="t">No correction matches these filters</div>
              <div class="s">Remove a filter above, or start again from the ones waiting for approval.</div>
              <button class="pbaf-btn tiny ghost" t-on-click="corrStartAgain">Start again</button>
            </div>

            <div t-else="" class="pbaf-corr-list">
              <div t-foreach="state.corrections" t-as="c" t-key="c.id"
                   class="corr-card" tabindex="0" role="button"
                   t-on-click="() => this.openCorrection(c.id)"
                   t-on-keydown="(ev) => ev.key === 'Enter' and this.openCorrection(c.id)">
                <img class="av" t-att-src="c.avatar_url" alt=""/>
                <div class="body">
                  <div class="row1">
                    <span class="nm" t-esc="c.employee"/>
                    <span t-attf-class="badge {{ stateTone(c.state) }}" t-esc="stateLabel(c.state)"/>
                  </div>
                  <div class="row2">
                    <span class="ty" t-esc="typeLabel(c.type)"/>
                    <span class="dot">•</span>
                    <span t-esc="c.date"/>
                  </div>
                  <div t-if="c.apply_error" class="err" t-esc="c.apply_error"/>
                </div>
                <span class="go" t-out="ic('chevron',16)"/>
              </div>
            </div>

            <div t-if="state.corrections.length" class="pbaf-corr-foot">
              Showing <b t-esc="state.corrections.length"/> of <b t-esc="state.corrTotal"/>
              <button t-if="corrHasMore" class="pbaf-btn tiny ghost" t-att-disabled="state.corrMore"
                      t-on-click="loadMoreCorrections">
                <t t-if="state.corrMore">Loading…</t>
                <t t-else="">Show <t t-esc="corrNext"/> more</t>
              </button>
            </div>
            </PbFilterLayout>
            </div>
          </section>
        </div>
      </div>

      <!-- ============================ COMPOSER ========================== -->
      <div t-elif="state.view === 'composer' and state.composer" class="pbaf-wrap composer">
        <div class="pbaf-sub-head">
          <button class="pbaf-back" t-on-click="backToBoard" t-out="ic('back',18)"/>
          <div class="h">
            <h1><t t-esc="state.composer.name"/></h1>
            <div class="sub">
              <span t-esc="state.composer.employee"/>
              <span class="dot">•</span>
              <span t-esc="state.composer.date"/>
              <span t-attf-class="badge {{ stateTone(state.composer.state) }}"
                    t-esc="stateLabel(state.composer.state)"/>
            </div>
          </div>
        </div>

        <div t-if="state.composer.apply_error" class="pbaf-refusal">
          <span t-out="ic('xCircle',18)"/>
          <div><b>Refused on apply:</b> <t t-esc="state.composer.apply_error"/></div>
        </div>

        <div class="pbaf-split">
          <!-- LEFT: the day's punches timeline -->
          <div class="pane punches">
            <div class="pane-h">The day’s punches</div>
            <div t-if="!state.composer.day_punches.length" class="pbaf-empty small">
              <span class="i" t-out="ic('calendar',24)"/>
              <div class="t">No punches this day</div>
            </div>
            <div t-else="" class="punch-list">
              <div t-foreach="state.composer.day_punches" t-as="p" t-key="p.id"
                   t-attf-class="punch {{ p.is_device ? 'device' : '' }} {{ state.composer.attendance_id === p.id ? 'picked' : '' }}"
                   t-on-click="() => this.pickTargetPunch(p.id)">
                <span class="src">
                  <span t-if="p.is_device" class="shield" title="Device punch — protected"
                        t-out="ic('shield',14)"/>
                  <span t-else="" t-out="ic('edit',14)"/>
                  <t t-esc="p.source"/>
                </span>
                <span class="tm"><t t-esc="p.check_in"/> → <t t-esc="p.check_out || '—'"/></span>
              </div>
            </div>
          </div>

          <!-- RIGHT: the proposed change + stepper -->
          <div class="pane change">
            <div class="pane-h">Proposed change</div>

            <div class="pbaf-typerow">
              <button t-foreach="['create','adjust','delete']" t-as="ty" t-key="ty"
                      t-attf-class="tychip {{ state.composer.type === ty ? 'active' : '' }}"
                      t-on-click="() => this.setComposerType(ty)"
                      t-esc="typeLabel(ty)"/>
            </div>

            <div t-if="state.composer.type !== 'delete'" class="pbaf-fields">
              <label>
                <span>Check-in</span>
                <input type="text" t-att-value="state.composer.new_check_in"
                       t-on-input="(ev) => this.onComposerField('new_check_in', ev)"
                       placeholder="YYYY-MM-DD HH:MM:SS"/>
              </label>
              <label>
                <span>Check-out</span>
                <input type="text" t-att-value="state.composer.new_check_out"
                       t-on-input="(ev) => this.onComposerField('new_check_out', ev)"
                       placeholder="YYYY-MM-DD HH:MM:SS"/>
              </label>
            </div>
            <div t-else="" class="pbaf-note">
              <span t-out="ic('trash',15)"/> This will remove the selected punch.
            </div>

            <label class="pbaf-reason">
              <span>Reason</span>
              <textarea t-on-input="(ev) => this.onComposerField('reason', ev)"
                        placeholder="Why is this correction needed?"
                        t-esc="state.composer.reason"/>
            </label>

            <!-- approval stepper (rendered from the chain trail JSON) -->
            <t t-set="stp" t-value="parsedStepper(state.composer.stepper)"/>
            <div class="pbaf-stepper">
              <div t-foreach="stp.steps || []" t-as="s" t-key="s_index"
                   t-attf-class="step {{ stp.current === s.state ? 'current' : '' }} {{ (stp.trail || []).find(l => l.to_state === s.state) ? 'done' : '' }}">
                <span class="dot"/>
                <div class="lbl">
                  <div class="n" t-esc="s.label"/>
                  <div class="g" t-esc="s.group_label"/>
                </div>
              </div>
            </div>

            <!-- refuse note panel -->
            <div t-if="state.refuseOpen" class="pbaf-refuse-box">
              <textarea t-on-input="onRefuseNote" placeholder="Reason for refusal (optional)"/>
              <div class="acts">
                <button class="pbaf-btn tiny ghost" t-on-click="cancelRefuse">Cancel</button>
                <button class="pbaf-btn tiny bad" t-on-click="confirmRefuse">Refuse</button>
              </div>
            </div>

            <!-- actions -->
            <div class="pbaf-actbar">
              <button t-if="state.composer.state === 'draft'" class="pbaf-btn ghost"
                      t-att-disabled="state.busy" t-on-click="saveComposer">
                <span t-out="ic('check',15)"/><span>Save</span>
              </button>
              <button t-if="state.composer.can_submit" class="pbaf-btn primary"
                      t-att-disabled="state.busy" t-on-click="() => this.composerAction('submit')">
                <span t-out="ic('arrow',15)"/><span>Submit</span>
              </button>
              <button t-if="state.composer.can_approve" class="pbaf-btn primary"
                      t-att-disabled="state.busy" t-on-click="() => this.composerAction('approve')">
                <span t-out="ic('check',15)"/><span>Approve &amp; apply</span>
              </button>
              <button t-if="state.composer.can_refuse" class="pbaf-btn bad ghost"
                      t-att-disabled="state.busy" t-on-click="() => this.composerAction('refuse')">
                <span t-out="ic('x',15)"/><span>Refuse</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================ IMPORT =========================== -->
      <div t-elif="state.view === 'import'" class="pbaf-wrap import">
        <div class="pbaf-sub-head">
          <button class="pbaf-back" t-if="canLeaveImport"
                  t-on-click="backFromImport" t-out="ic('back',18)"/>
          <div class="h">
            <h1 t-if="!props.embedded">Import attendance</h1>
            <div class="sub" t-if="isPunches">Excel, CSV, the machine’s own log file (attlog.dat) or the attendance program’s daily sheet</div>
            <div class="sub" t-else="">CSV or Excel · columns: Employee · Date · Check-in · Check-out</div>
          </div>
        </div>

        <!-- what kind of file (CLOCK-1) — only when there is a choice -->
        <div class="pbaf-modes" t-if="state.modes.length > 1 and state.imp.step === 'upload'"
             role="radiogroup">
          <button t-foreach="state.modes" t-as="m" t-key="m.key"
                  type="button" role="radio"
                  t-att-aria-checked="state.imp.mode === m.key"
                  t-attf-class="pbaf-mode {{ state.imp.mode === m.key ? 'on' : '' }}"
                  t-on-click="() => this.setImportMode(m.key)">
            <span class="mi" t-out="kic(m.icon, 20)"/>
            <span class="mt">
              <span class="ml" t-esc="m.label"/>
              <span class="ms" t-esc="m.sub"/>
            </span>
            <span class="mc" t-out="kic(state.imp.mode === m.key ? 'checkCircle' : 'circle', 16)"/>
          </button>
        </div>

        <!-- step rail -->
        <div class="pbaf-steprail">
          <div t-foreach="importSteps" t-as="st" t-key="st.key"
               t-attf-class="s {{ state.imp.step === st.key ? 'active' : '' }}">
            <span class="d"/><span class="t" t-esc="st.label"/>
          </div>
        </div>

        <!-- UPLOAD -->
        <div t-if="state.imp.step === 'upload'" class="pbaf-drop">
          <span class="i" t-out="kic(isPunches ? 'scan' : 'upload', 34)"/>
          <t t-if="isPunches">
            <div class="t">Drop a punch file</div>
            <div class="s">One tap per row: the number on the machine and when it was pressed. The machine’s attlog.dat and the program’s daily sheet are recognised on their own.</div>
          </t>
          <t t-else="">
            <div class="t">Drop an attendance file</div>
            <div class="s">Employee (badge or name), Date, Check-in, and optionally Check-out.</div>
          </t>
          <label class="pbaf-btn primary">
            <span t-if="state.busy" t-out="kic('loader', 15)"/>
            <span>Choose file</span>
            <input type="file" t-att-accept="importAccept" t-on-change="onImportFile" style="display:none"/>
          </label>
          <div class="pbaf-next" t-if="isPunches">
            <span t-out="kic('info', 13)"/>
            <span>What happens next: you see what the file holds before anything is added. Punches then pair into days on their own — first punch in, last punch out.</span>
          </div>
        </div>

        <!-- MAP -->
        <div t-elif="state.imp.step === 'map'" class="pbaf-mapwrap">
          <div class="pbaf-map">
            <div class="mh"><t t-esc="state.imp.fileName"/> · <t t-esc="fmtN(state.imp.total)"/> rows</div>
            <div class="mhs" t-if="isPunches">Tell us which column holds what. Give either one date-and-time column, or a date column and a time column.</div>
            <div class="maprow" t-foreach="importTargets" t-as="tg" t-key="tg.key">
              <span class="tg" t-esc="tg.label"/>
              <select t-on-change="(ev) => this.onMap(tg.key, ev)">
                <option value="">— none —</option>
                <option t-foreach="state.imp.columns" t-as="col" t-key="col_index"
                        t-att-value="col" t-att-selected="state.imp.mapping[tg.key] === col"
                        t-esc="col"/>
              </select>
            </div>
          </div>
          <div class="pbaf-sample">
            <table>
              <thead><tr><th t-foreach="state.imp.columns" t-as="col" t-key="col_index" t-esc="col"/></tr></thead>
              <tbody>
                <tr t-foreach="state.imp.sample" t-as="row" t-key="row_index">
                  <td t-foreach="state.imp.columns" t-as="col" t-key="col_index" t-esc="row[col]"/>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="pbaf-actbar">
            <button class="pbaf-btn primary" t-att-disabled="!canValidate or state.busy"
                    t-on-click="validateImport">
              <span t-out="ic('check',15)"/><span>Check the file</span>
            </button>
          </div>
        </div>

        <!-- CHECK — punches: what the file holds (the hero moment) -->
        <div t-elif="state.imp.step === 'validate' and isPunches and state.imp.preview"
             class="pbaf-valwrap pbaf-pp">
          <t t-set="pv" t-value="state.imp.preview"/>
          <div class="pp-hero">
            <div class="pp-big"><b t-esc="fmtN(pv.punches)"/><span>punches</span></div>
            <div class="pp-big"><b t-esc="fmtN(pv.people)"/><span>people</span></div>
            <div class="pp-big"><b t-esc="fmtN(pv.days)"/><span t-esc="pv.days === 1 ? tr.day : tr.days"/></div>
            <div class="pp-spark" t-if="sparkBars.length" aria-hidden="true">
              <svg width="128" height="46" viewBox="0 0 128 46">
                <rect t-foreach="sparkBars" t-as="b" t-key="b.date"
                      t-att-x="b.x" t-att-y="44 - b.h" width="12" t-att-height="b.h" rx="2"
                      t-attf-class="{{ b.zero ? 'z' : '' }}">
                  <title t-esc="b.label + ': ' + b.n"/>
                </rect>
              </svg>
              <span class="pp-spark__cap">last 7 days in the file</span>
            </div>
          </div>
          <div class="pp-meta">
            <span t-esc="state.imp.fileName"/>
            <span t-if="formatLabel(pv.format)"> · <t t-esc="formatLabel(pv.format)"/></span>
            <span t-if="pv.date_from"> · <t t-esc="pv.date_from"/><t t-if="pv.date_to !== pv.date_from"> → <t t-esc="pv.date_to"/></t></span>
          </div>
          <div class="pp-facts">
            <span t-attf-class="pp-fact {{ pv.new ? 'go' : '' }}"><b t-esc="fmtN(pv.new)"/> new</span>
            <span t-attf-class="pp-fact {{ pv.on_record ? 'info' : '' }}"><b t-esc="fmtN(pv.on_record)"/> already on record</span>
            <span t-attf-class="pp-fact {{ pv.repeats ? 'info' : '' }}"><b t-esc="fmtN(pv.repeats)"/> repeated in the file</span>
            <span t-attf-class="pp-fact {{ pv.bad ? 'warn' : '' }}"><b t-esc="fmtN(pv.bad)"/> rows not readable</span>
          </div>
          <div class="pp-unknown" t-if="pv.unknown_count">
            <div class="pp-unknown__h">
              <span t-out="kic('userX', 15)"/>
              <span t-esc="unknownHeadline(pv.unknown_count)"/>
            </div>
            <div class="pp-chips">
              <span t-foreach="pv.unknown" t-as="u" t-key="u.code" class="pp-chip">
                <b t-esc="u.code"/><i t-esc="u.punches"/>
              </span>
              <span class="pp-chip more" t-if="pv.unknown_count > pv.unknown.length">+<t t-esc="pv.unknown_count - pv.unknown.length"/> more</span>
            </div>
            <div class="pp-unknown__s">Their punches are kept. After the import, press Assign now and match each number to a person — their days are paired straight away.</div>
          </div>
          <div class="pp-ok" t-elif="pv.punches">
            <span t-out="kic('checkCircle', 15)"/><span>Every number matches a person.</span>
          </div>
          <div class="pp-bad" t-if="pv.bad_rows.length">
            <div class="eh">Rows that could not be read</div>
            <div t-foreach="pv.bad_rows" t-as="er" t-key="er_index" class="er">
              <span class="ix">#<t t-esc="er.index"/></span>
              <span class="emp" t-esc="er.employee"/>
              <span class="rs" t-esc="er.reason"/>
            </div>
          </div>
          <div class="pp-trunc" t-if="pv.truncated">
            <span t-out="kic('alert', 14)"/>
            <span t-esc="truncLabel(pv.max_rows)"/>
          </div>
          <div class="pbaf-actbar">
            <button class="pbaf-btn ghost" t-if="pv.format === 'table'" t-on-click="backToMap">
              <span t-out="ic('back',15)"/><span>Back to columns</span>
            </button>
            <button class="pbaf-btn ghost" t-else="" t-on-click="openImport">
              <span t-out="ic('back',15)"/><span>Choose another file</span>
            </button>
            <button class="pbaf-btn primary" t-att-disabled="!pv.new or state.busy"
                    t-on-click="commitImport">
              <span t-out="kic(state.busy ? 'loader' : 'download',15)"/>
              <span t-if="pv.new" t-esc="addLabel(pv.new)"/>
              <span t-else="">Nothing new to add</span>
            </button>
          </div>
        </div>

        <!-- VALIDATE (attendance days) -->
        <div t-elif="state.imp.step === 'validate' and state.imp.validation" class="pbaf-valwrap">
          <div class="pbaf-valsum">
            <div class="s ok"><b t-esc="state.imp.validation.summary.valid"/><span>valid</span></div>
            <div class="s bad"><b t-esc="state.imp.validation.summary.invalid"/><span>flagged</span></div>
            <div class="s"><b t-esc="state.imp.validation.summary.total"/><span>rows</span></div>
          </div>
          <div class="pbaf-valtable">
            <div t-foreach="state.imp.validation.rows" t-as="r" t-key="r_index"
                 t-attf-class="vr {{ r.ok ? 'ok' : 'bad' }}">
              <span class="pill" t-out="ic(r.ok ? 'checkCircle' : 'xCircle',15)"/>
              <span class="ix">#<t t-esc="r.index"/></span>
              <span class="emp" t-esc="r.employee"/>
              <span class="dt" t-esc="r.date"/>
              <span class="reasons">
                <span t-foreach="r.errors" t-as="er" t-key="er_index" class="chip" t-esc="er"/>
              </span>
            </div>
          </div>
          <div class="pbaf-actbar">
            <button class="pbaf-btn ghost" t-on-click="backToMap">
              <span t-out="ic('back',15)"/><span>Back to mapping</span>
            </button>
            <button class="pbaf-btn primary" t-att-disabled="!state.imp.validation.summary.valid or state.busy"
                    t-on-click="commitImport">
              <span t-out="ic('download',15)"/>
              <span>Import <t t-esc="state.imp.validation.summary.valid"/> rows</span>
            </button>
          </div>
        </div>

        <!-- DONE — punches -->
        <div t-elif="state.imp.step === 'done' and isPunches and state.imp.result" class="pbaf-done pbaf-pp-done">
          <t t-set="rs" t-value="state.imp.result"/>
          <span class="i" t-out="kic(rs.created ? 'checkCircle' : 'info', 40)"/>
          <div class="t" t-if="rs.created" t-esc="addedLabel(rs.created)"/>
          <div class="t" t-else="">Nothing new — every punch was already on record</div>
          <div class="s" t-esc="rs.message"/>
          <div class="s" t-if="rs.new_devices and rs.new_devices.length">
            <t t-esc="newMachinesLabel(rs.new_devices)"/>
          </div>
          <div class="pp-unknown center" t-if="rs.unknown_count">
            <div class="pp-chips">
              <span t-foreach="rs.unknown_codes" t-as="c" t-key="c" class="pp-chip"><b t-esc="c"/></span>
              <span class="pp-chip more" t-if="rs.unknown_count > rs.unknown_codes.length">+<t t-esc="rs.unknown_count - rs.unknown_codes.length"/> more</span>
            </div>
          </div>
          <div t-if="rs.errors.length" class="pbaf-errtable">
            <div class="eh">Rows that could not be read</div>
            <div t-foreach="rs.errors" t-as="er" t-key="er_index" class="er">
              <span class="ix">#<t t-esc="er.index"/></span>
              <span class="emp" t-esc="er.employee"/>
              <span class="rs" t-esc="er.reason"/>
            </div>
          </div>
          <div class="pbaf-actbar center">
            <button class="pbaf-btn ghost" t-on-click="openImport">Add another file</button>
            <button class="pbaf-btn primary" t-if="canOpenClocks and rs.unknown_count"
                    t-on-click="() => this.openClocks(rs.unknown_codes)">
              <span t-out="kic('userCheck', 15)"/><span>Assign now</span>
            </button>
            <button class="pbaf-btn primary" t-elif="canOpenClocks"
                    t-on-click="() => this.openClocks([])">
              <span t-out="kic('scan', 15)"/><span>Open Time clocks</span>
            </button>
            <button class="pbaf-btn primary" t-else="" t-on-click="backFromImport">
              <t t-if="canLeaveImport">Back to control</t>
              <t t-else="">Done</t>
            </button>
          </div>
        </div>

        <!-- DONE — attendance days -->
        <div t-elif="state.imp.step === 'done' and state.imp.result" class="pbaf-done">
          <span class="i" t-out="ic('checkCircle',40)"/>
          <div class="t"><t t-esc="state.imp.result.created"/> punches imported</div>
          <div class="s">
            <t t-esc="state.imp.result.skipped"/> skipped of <t t-esc="state.imp.result.total"/> rows.
          </div>
          <div t-if="state.imp.result.errors.length" class="pbaf-errtable">
            <div class="eh">Skipped rows</div>
            <div t-foreach="state.imp.result.errors" t-as="er" t-key="er_index" class="er">
              <span class="ix">#<t t-esc="er.index"/></span>
              <span class="emp" t-esc="er.employee"/>
              <span class="rs" t-esc="er.reason"/>
            </div>
          </div>
          <div class="pbaf-actbar center">
            <button class="pbaf-btn ghost" t-on-click="openImport">Import another</button>
            <button class="pbaf-btn primary" t-on-click="backFromImport">
              <t t-if="canLeaveImport">Back to control</t>
              <t t-else="">Done</t>
            </button>
          </div>
        </div>
      </div>

      <!-- ============================ error ============================ -->
      <div t-else="" class="pbaf-empty">
        <span class="i" t-out="ic('alertCircle',28)"/>
        <div class="t">Couldn’t load Attendance Control</div>
        <button class="pbaf-btn ghost" t-on-click="load">Retry</button>
      </div>
    </div>
  </t>

</templates>
