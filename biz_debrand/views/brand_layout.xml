<?xml version="1.0" encoding="utf-8"?>
<!-- Part of biz_debrand — portable Odoo 19 white-label layer. License LGPL-3.

     Publishes the brand to the browser synchronously, before any asset bundle
     runs. web.layout is the common ancestor of the backend web client, the
     login/portal/website pages and the report layouts, so one inherit reaches
     every JS context that biz_debrand_runtime.js is loaded into.

     `request` is None when a report is rendered outside an HTTP request; the
     guard makes t-att-content falsy there and QWeb simply omits the attribute
     (the JS falls back to its defaults). -->
<odoo>
    <template id="biz_debrand_layout_brand" inherit_id="web.layout" name="Brand metadata">
        <xpath expr="//head/meta[@charset]" position="after">
            <meta name="biz-brand"
                  t-att-content="request and request.env['ir.config_parameter'].sudo().get_param('biz_debrand.brand_name')"/>
            <meta name="biz-brand-website"
                  t-att-content="request and request.env['ir.config_parameter'].sudo().get_param('biz_debrand.brand_website')"/>
            <!-- ERRORS E3-2. Empty unless this database is a tenant whose brand
                 differs from the master product name, in which case the JS
                 seams that rewrite SOURCE text rewrite that name too. -->
            <meta name="biz-brand-product"
                  t-att-content="request and request.env['ir.config_parameter'].sudo().get_param('biz_debrand.product_name')"/>
            <!-- ERRORS E4-1. Who built the platform, when the customer is on
                 the "powered by" level and has agreed to say so. Empty on both
                 other levels, which is what makes this a middle tier rather
                 than a switch: the default customer is not credited to anybody
                 because the product IS ours, and a fully white-labelled one
                 has paid for the credit to be absent. -->
            <meta name="biz-brand-powered-by"
                  t-att-content="request and request.env['ir.config_parameter'].sudo().get_param('biz_debrand.powered_by')"/>
        </xpath>
    </template>
</odoo>
