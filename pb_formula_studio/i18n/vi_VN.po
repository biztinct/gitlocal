msgstr "Cột %(cols)s · Đầu vào %(inputs)s%(country)s"

#. module: pb_formula_studio
#. odoo-python
#: code:addons/pb_formula_studio/models/pb_formula_studio.py:0
msgid ""
"%(count)s contracts already carry a value for %(code)s. Wire this column to a field "
"instead — what the contracts hold is kept as history — or leave it on the contract."
msgstr ""
"%(count)s hợp đồng đã có giá trị cho %(code)s. Hãy nối cột này tới một trường thay thế"
" — những gì hợp đồng đang lưu vẫn được giữ làm lịch sử — hoặc cứ để nó trên hợp đồng."

