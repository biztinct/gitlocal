#. module: pb_formula_studio
#. odoo-python
#: code:addons/pb_formula_studio/models/pb_formula_studio.py:0
msgid ""
"\"%(name)s\" is used by %(blockers)s, so it can't be deleted. Archive it instead to "
"hide it without losing that history."
msgstr ""
"\"%(name)s\" được %(blockers)s sử dụng nên không thể xóa được. Thay vào đó hãy lưu trữ"
" nó để ẩn nó mà không làm mất lịch sử đó."

#. module: pb_formula_studio
#. odoo-javascript
#: code:addons/pb_formula_studio/static/src/xml/studio.xml:0
msgid "% identical ·"
msgstr "% inha khoa ·"

#. module: pb_formula_studio
#. odoo-javascript
#: code:addons/pb_formula_studio/static/src/xml/studio.xml:0
msgid "% of changed employees"
msgstr "% of đã thay đổi nhân viên"

#. module: pb_formula_studio
#. odoo-python
#: code:addons/pb_formula_studio/models/pb_formula_studio.py:0
msgid "%(a)s and %(b)s both want the code '%(code)s'."
msgstr "%(a)s và %(b)s đều muốn có mã “%(code)s”."

#. module: pb_formula_studio
#. odoo-javascript
#: code:addons/pb_formula_studio/static/src/js/mapping/journey_board.js:0
msgid "%(base)s — read from the first %(read)s of %(all)s"
msgstr "%(base)s - đọc từ %(read)s đầu tiên của %(all)s"

#. module: pb_formula_studio
#. odoo-python
#: code:addons/pb_formula_studio/models/pb_formula_studio.py:0
msgid ""
"%(code)s is already kept on the contract as TEXT, and the contract entry is never re-"
"typed — an import would go on writing text. Send this column to a field instead, or "
"leave it as a text component."
msgstr ""
"%(code)s đã được lưu giữ trong hợp đồng dưới dạng TEXT và mục nhập hợp đồng không bao "
"giờ được nhập lại - quá trình nhập sẽ tiếp tục viết văn bản. Thay vào đó, hãy gửi cột "
"này đến một trường hoặc để nó dưới dạng thành phần văn bản."

#. module: pb_formula_studio
#. odoo-python
#: code:addons/pb_formula_studio/models/pb_formula_studio.py:0
msgid ""
"%(code)s is already kept on the contract as an AMOUNT, and the contract entry is never"
" re-typed — an import would go on writing a number. Send this column to a field "
"instead, or leave it as an amount component."
msgstr ""
"%(code)s đã được lưu trong hợp đồng dưới dạng SỐ TIỀN và mục nhập hợp đồng không bao "
"giờ được nhập lại — quá trình nhập sẽ tiếp tục viết một số. Thay vào đó, hãy gửi cột "
"này đến một trường hoặc để nó dưới dạng thành phần số lượng."

#. module: pb_formula_studio
#. odoo-python
#: code:addons/pb_formula_studio/models/pb_formula_studio.py:0
msgid ""
"%(code)s is wired to %(other)s. A pay run reads only the connection its scheme is set "
"to, so two wires means one of them is doing nothing."
msgstr ""
"%(code)s được nối với %(other)s. Một kỳ lương chỉ đọc kết nối mà sơ đồ của nó được "
"đặt, vì vậy hai dây có nghĩa là một trong số chúng không làm gì cả."

#. module: pb_formula_studio
#. odoo-python
#: code:addons/pb_formula_studio/models/pb_formula_studio.py:0
msgid ""
"%(code)s will read %(names)s, in that order. The first one that carries a value wins; "
"the others are read only when it does not."
msgstr ""
"%(code)s sẽ đọc %(names)s theo thứ tự đó. Cái đầu tiên mang giá trị sẽ thắng; những "
"cái khác chỉ được đọc khi nó không được đọc."

#. module: pb_formula_studio
#. odoo-javascript
#: code:addons/pb_formula_studio/static/src/js/mapping/mapping_studio.js:0
