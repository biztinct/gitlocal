<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- NETROLE P2 — the category review.

         A real action record, not an inline dict: the formula engine chains it
         at the end of an import through `env.ref(...)` and stays installable
         without the studio, exactly as the people-mapping hand-off does. -->
    <record id="action_pb_category_review" model="ir.actions.client">
        <field name="name">Review component categories</field>
        <field name="tag">pb_category_review</field>
    </record>

    <!-- ...and a way back to it at any time, from the structure itself. -->
    <record id="action_server_category_review" model="ir.actions.server">
        <field name="name">Review component categories</field>
        <field name="model_id" ref="pb_hr_payroll_formula.model_hr_formula_config"/>
        <field name="binding_model_id" ref="pb_hr_payroll_formula.model_hr_formula_config"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records[:1].action_open_category_review()</field>
    </record>
</odoo>
