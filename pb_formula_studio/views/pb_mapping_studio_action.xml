<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Integrations Cycle 2 — the Mapping Studio's own front door.

         A RECORD and not just a registry tag, for the reason the Settings hub
         learned the hard way: a bare tag reaches the action service with no
         NAME, and every breadcrumb that passes through it then reads
         "Unnamed". The name here is what a back chip and a crumb print. -->
    <record id="action_pb_mapping_studio" model="ir.actions.client">
        <field name="name">Mapping Studio</field>
        <field name="tag">pb_mapping_studio</field>
    </record>
</odoo>
