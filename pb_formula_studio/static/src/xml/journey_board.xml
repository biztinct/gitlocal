<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ====================================================================
       JOURNEY J5, redesigned by CLEANMAP P2 — the Journey board.

       Up to five lanes, one SVG under them, and a CARD that is no longer one
       button. A card holds two actions and a list now: the body toggles it
       open, the small corner icon navigates. Both are real `button` elements,
       so the focus ring, the Space key and the ARIA role are the platform's
       and not ours to re-earn one at a time (MJ10).

       The SVG is a child of `.jny-stage` and `.jny-stage` is ALSO the element
       the geometry measures against, which is not an accident: a wire's points
       are pixels relative to some origin, and if the origin is not the element
       the SVG is stretched over, every wire is offset by whatever chrome sits
       between the two. One ref, one origin, no arithmetic.

       MJ21: decorative rules use ==== and never dashes. Two consecutive
       hyphens are illegal inside an XML comment BODY, the parser refuses the
       whole file, and OWL then reports every t-name in it as a template that
       does not exist.
       ==================================================================== -->
  <t t-name="pb_formula_studio.JourneyBoard">
    <div t-attf-class="jny {{ props.busy ? 'is-busy' : '' }}"
         tabindex="-1" t-on-keydown="onKeydown">

      <!-- ==== the bar over the lanes ==== -->
      <div class="jny-bar">
        <div class="jny-bar__say">
          <b t-esc="d.config and d.config.name"/>
          <span class="jny-bar__sub" t-esc="headline"/>
        </div>
        <div class="jny-q">
          <span class="jny-q__ic" t-out="ic('search', 14)"/>
          <input type="search" t-ref="q" t-on-input="onSearch"
                 placeholder="Filter the journey…"
                 aria-label="Filter the journey"/>
          <button t-if="ui.q" class="jny-q__x" t-on-click="clearSearch"
                  title="Clear the filter">
            <t t-out="ic('x', 13)"/>
          </button>
        </div>
      </div>

      <!-- ==== the board ====
           `.jny-board` scrolls; `.jny-stage` is the full content and the wire
           origin. Lane bodies do NOT scroll individually any more: a row and
           the row it is wired to have to be on screen together, and two
           independently scrolling columns is the one arrangement that cannot
           promise it. -->
      <div class="jny-board">
        <div class="jny-stage" t-ref="stage">

          <svg class="jny-wires" aria-hidden="true">
            <g t-foreach="ui.geom" t-as="g" t-key="g.id"
               t-attf-class="jny-wire {{ g.kind }} {{ g.dimmed ? 'dim' : '' }} {{ g.span > 1 ? 'span' : '' }} {{ g.lit === 1 ? 'lit' : (g.lit === -1 ? 'off' : '') }}">
              <path class="jny-wire__p" t-att-d="g.d"
                    t-attf-style="stroke-width:{{ g.width }}px"/>
              <polygon class="jny-wire__h" t-att-points="g.head"/>
              <polygon t-if="g.headBack" class="jny-wire__h back" t-att-points="g.headBack"/>
              <title t-esc="edgeTitle(g)"/>
            </g>
            <t t-foreach="ui.geom" t-as="g" t-key="'n' + g.id">
              <g t-if="g.badge" class="jny-wire__n">
                <circle class="jny-wire__nb" t-att-cx="g.hx" t-att-cy="g.hy" r="9"/>
                <text class="jny-wire__nt" t-att-x="g.hx" t-att-y="g.hy + 3"
                      text-anchor="middle" t-esc="g.count"/>
              </g>
            </t>
          </svg>

          <!-- ==== the zero state: an invitation, never five ghosts ==== -->
          <div t-if="invite" class="jny-invite">
            <span class="jny-invite__ic" t-out="ic('gitMerge', 22)"/>
            <b t-esc="invite.title"/>
            <span t-esc="invite.sub"/>
            <div class="jny-invite__doors">
              <button t-foreach="inviteDoors()" t-as="dr" t-key="dr.id"
                      type="button" class="jny-invite__b"
                      t-on-click="(ev) => this.openInvite(dr, ev)">
                <span t-out="ic(dr.icon, 14)"/>
                <span t-esc="dr.label"/>
              </button>
            </div>
          </div>

          <div t-attf-class="jny-lanes n{{ lanes.length }}"
               t-attf-style="--jny-cols:{{ lanes.length }}">
            <div class="jny-lane" t-foreach="lanes" t-as="lane" t-key="lane.id">
              <div class="jny-lane__h">
                <span class="jny-lane__ic" t-out="ic(lane.icon, 13)"/>
                <span class="jny-lane__t" t-esc="lane.label"/>
                <span class="jny-lane__n" t-esc="laneCount(lane.id)"/>
              </div>

              <div class="jny-lane__b" t-ref="{{ lane.id }}">
                <t t-foreach="cardsFor(lane.id)" t-as="c" t-key="c.id">

                <div t-att-class="cardClass(c)"
                     t-on-mouseenter="() => this.onCardEnter(c)"
                     t-on-mouseleave="() => this.onRowLeave()">

                  <div class="jny-card__h">
                    <button class="jny-card__t" type="button"
                            t-att-data-id="c.id"
                            t-att-aria-expanded="isOpen(c) ? 'true' : 'false'"
                            t-att-title="cardTitle(c)"
                            t-on-focus="() => this.onCardEnter(c)"
                            t-on-click="() => this.toggle(c)">
                      <span t-if="c.rows.length" class="jny-card__v"
                            t-out="ic(isOpen(c) ? 'chevronDown' : 'chevron', 12)"/>
                      <span class="jny-card__ic" t-out="ic(cardIcon(c), 14)"/>
                      <span class="jny-card__tx">
                        <span class="jny-card__l" t-esc="c.label"/>
                        <span t-if="cardSub(c)" class="jny-card__s" t-esc="cardSub(c)"/>

                        <!-- ==== the scheme card's fed bar ==== -->
                        <t t-if="c.kind === 'scheme' and c.bar">
                          <span class="jny-bars">
                            <span class="jny-bars__seg ok"
                                  t-attf-style="width:{{ schemeBar.pct }}%"/>
                          </span>
                          <span class="jny-keys">
                            <span class="jny-key ok"><i class="jny-key__d"/><t t-esc="c.fed_label"/></span>
                            <span t-if="schemeBar.unfed" class="jny-key warn">
                              <i class="jny-key__d"/><t t-esc="c.unfed_label"/>
                            </span>
                          </span>
                        </t>
                      </span>
                    </button>

                    <button t-if="c.door" class="jny-card__go" type="button"
                            t-att-title="doorHint(c)"
                            t-on-click="(ev) => this.openDoor(c, ev)">
                      <t t-out="ic('external', 13)"/>
                    </button>
                  </div>

                  <!-- ==== the warnings, BESIDE the title button and never
                       inside it: a button within a button is not valid
                       markup and the inner one stops being reachable. ==== -->
                  <div t-if="c.chips.length" class="jny-chips">
                    <button t-foreach="c.chips" t-as="chip" t-key="chip.id"
                            type="button"
                            t-attf-class="jny-chip {{ chip.tone }}"
                            t-att-title="chip.hint"
                            t-on-click="(ev) => this.openChip(chip, ev)">
                      <t t-out="ic('alert', 11)"/>
                      <t t-esc="chip.label"/>
                    </button>
                  </div>

                  <!-- ==== the fields inside ==== -->
                  <ul t-if="isOpen(c)" class="jny-rows"
                      t-on-transitionend="onRevealEnd">
                    <t t-foreach="groupsOf(c)" t-as="grp" t-key="grp.id">
                      <li t-if="rowsInGroup(c, grp.id).length"
                          class="jny-sub" t-esc="grp.label"/>
                      <li t-foreach="rowsInGroup(c, grp.id)" t-as="r" t-key="r.id"
                          t-att-data-id="r.id" t-att-class="rowClass(r)"
                          tabindex="0" t-att-title="rowTitle(r)"
                          t-on-mouseenter="() => this.onRowEnter(r)"
                          t-on-mouseleave="() => this.onRowLeave()"
                          t-on-focus="() => this.onRowEnter(r)"
                          t-on-click="(ev) => this.pinRow(r, ev)">
                        <span class="jny-row__g" t-esc="r.tag"/>
                        <span class="jny-row__l" t-esc="r.label"/>
                        <span t-if="r.state === 'gone'" class="jny-row__n" t-esc="r.sub"/>
                        <span t-elif="r.fed === false" class="jny-row__n">not fed</span>
                        <span class="jny-row__p" t-esc="partnerText(r)"/>
                      </li>
                    </t>
                    <t t-if="hasUngrouped(c)">
                      <li t-foreach="ungrouped(c)" t-as="r" t-key="r.id"
                          t-att-data-id="r.id" t-att-class="rowClass(r)"
                          tabindex="0" t-att-title="rowTitle(r)"
                          t-on-mouseenter="() => this.onRowEnter(r)"
                          t-on-mouseleave="() => this.onRowLeave()"
                          t-on-focus="() => this.onRowEnter(r)"
                          t-on-click="(ev) => this.pinRow(r, ev)">
                        <span class="jny-row__g" t-esc="r.tag"/>
                        <span class="jny-row__l" t-esc="r.label"/>
                        <span t-if="r.state === 'gone'" class="jny-row__n" t-esc="r.sub"/>
                        <span t-elif="r.fed === false" class="jny-row__n">not fed</span>
                        <span class="jny-row__p" t-esc="partnerText(r)"/>
                      </li>
                    </t>

                    <!-- ==== ONE folded line for what the scheme works out
                         for itself. Its own toggle, inside the card. ==== -->
                    <t t-if="c.folded and c.folded.n">
                      <li class="jny-fold">
                        <button type="button" class="jny-fold__b"
                                t-att-aria-expanded="ui.folded ? 'true' : 'false'"
                                t-on-click="(ev) => this.toggleFolded(ev)">
                          <span t-out="ic(ui.folded ? 'chevronDown' : 'chevron', 11)"/>
                          <span t-esc="c.folded.label"/>
                        </button>
                      </li>
                      <li t-if="ui.folded" t-foreach="c.folded.rows" t-as="fr"
                          t-key="fr.id" class="jny-row calc" t-att-title="fr.label">
                        <span class="jny-row__g"/>
                        <span class="jny-row__l" t-esc="fr.label"/>
                      </li>
                    </t>
                  </ul>

                  <div t-if="cardActions(c).length" class="jny-card__acts">
                    <button t-foreach="cardActions(c)" t-as="a" t-key="a.id"
                            type="button" class="jny-act"
                            t-on-click="(ev) => this.runAction(a, ev)">
                      <span t-out="ic(a.icon || 'external', 13)"/>
                      <span t-esc="a.label"/>
                    </button>
                  </div>
                </div>
                </t>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </t>

</templates>
