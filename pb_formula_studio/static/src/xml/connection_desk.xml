<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="pb_formula_studio.ConnectionDesk">
 <div class="pbcdesk">
  <div class="pbcdesk-heading"><div><h2>Connections</h2><p>Map input components to their sources and storage. See calculations in Journey.</p></div><div class="pbcdesk-actions"><button class="pbim-btn" t-on-click="priorities">Source order</button><button t-if="props.data.can_edit" class="pbim-btn primary" t-on-click="newComponent">+ Component</button></div></div>
  <div t-if="state.error" class="pbcdesk-error" role="alert" t-esc="state.error"/>
  <div class="pbcdesk-layout">
   <section class="pbcdesk-list" aria-label="Input components" data-coach="md-list">
    <div class="pbcdesk-search"><input type="search" aria-label="Find a component" placeholder="Find a component by name, code or letter…" t-model="state.q"/><div class="pbcdesk-filters"><button t-att-class="state.filter==='all' ? 'on' : ''" t-on-click="() => this.state.filter='all'">All <b t-esc="rows.length"/></button><button t-att-class="state.filter==='missing' ? 'on' : ''" t-on-click="() => this.state.filter='missing'">Need a source <b t-esc="missingCount"/></button><button t-att-class="state.filter==='multiple' ? 'on' : ''" t-on-click="() => this.state.filter='multiple'">With fallback <b t-esc="multipleCount"/></button></div></div>
    <div class="pbcdesk-listhead"><span>Component / read order</span><span>Sample value</span></div>
    <div class="pbcdesk-rows">
     <button t-foreach="filtered" t-as="r" t-key="r.id" t-attf-class="pbcdesk-row {{selected and selected.id===r.id ? 'on' : ''}}" t-on-click="() => this.select(r)" t-att-aria-pressed="selected and selected.id===r.id">
      <div class="pbcdesk-rowmain"><span class="pbcdesk-letter" t-esc="r.col"/><div><strong t-esc="r.name"/><small><t t-esc="r.code"/> · <t t-esc="kindLabel(r.value_kind)"/></small></div><span class="pbcdesk-value" t-esc="value(r)"/></div>
      <div class="pbcdesk-chips"><span t-foreach="r.sources" t-as="s" t-key="s_index" t-attf-class="pbcdesk-chip {{s.kind==='none' ? 'missing' : ''}}"><b t-if="r.type==='input' and s.kind!=='none'" t-esc="s_index+1"/><t t-esc="label(s.kind)"/></span></div>
     </button>
     <div t-if="!filtered.length" class="pbcdesk-blank">No components match. Try another search or filter.</div>
    </div>
    <p class="pbcdesk-footnote"><t t-if="sampleName">Values shown for sample: <b t-esc="sampleName"/>.</t><t t-else="">No sample values available.</t> These are separate from recorded run sources.</p>
   </section>
   <aside t-if="selected" class="pbcdesk-inspector" aria-label="Component details" data-coach="md-inspector">
    <div class="pbcdesk-detailhead"><small>COMPONENT <t t-esc="selected.col"/></small><h3 t-esc="selected.name"/><code t-esc="selected.code"/><div class="pbcdesk-hero" t-esc="value(selected)"/><small>Sample preview</small></div>
    <div class="pbcdesk-tabs" role="tablist"><button t-foreach="['sources','storage','payroll']" t-as="tab" t-key="tab" t-att-class="state.tab===tab ? 'on' : ''" role="tab" t-att-aria-selected="state.tab===tab" t-on-click="() => this.state.tab=tab"><t t-esc="{sources:'Sources',storage:'Storage',payroll:'Use in payroll'}[tab]"/></button></div>
    <div class="pbcdesk-detailbody">
     <t t-if="state.tab==='sources'">
      <h4>Configured read order</h4><p t-if="selected.type==='input'">The first supplied value is used. Zero and No count as supplied; blank values fall through.</p>
      <ol class="pbcdesk-sourceorder"><li t-foreach="selected.sources" t-as="s" t-key="s_index"><b t-esc="label(s.kind)"/><small t-esc="s.label || s.key"/></li></ol>
      <div class="pbcdesk-evidence"><h4>Latest recorded run source</h4><t t-if="selected.source.actual"><strong t-esc="label(selected.source.actual.kind)"/><p><t t-esc="selected.source.actual.key"/> · <t t-esc="selected.source.actual.run"/></p><small>A historical run record; it may be for a different employee from this sample.</small></t><p t-else="">No recorded run source for this component.</p></div>
      <button class="pbim-btn" t-on-click="trace">Trace this component</button>
      <t t-if="selected.type==='input'"><h4>Manage connections</h4><div class="pbcdesk-stack"><button t-if="props.data.priority.enabled.api" class="pbim-btn" t-on-click="() => this.open('api')">System fields &amp; suggestions →</button><button t-if="props.data.priority.enabled.excel" class="pbim-btn" t-on-click="() => this.open('import')">Spreadsheet columns →</button><button class="pbim-btn" t-on-click="() => this.props.onNewRule(selected.id)">Create a transformation →</button></div></t>
     </t>
     <t t-elif="state.tab==='storage'">
      <div class="pbcdesk-sectiontitle"><h4>Contract storage</h4><button t-if="props.data.can_edit and savedStorage" class="pbcdesk-textbtn" t-att-aria-expanded="state.storageEditing ? 'true' : 'false'" t-att-disabled="state.busy" t-on-click="() => this.state.storageEditing=!this.state.storageEditing"><t t-esc="state.storageEditing ? 'Close choices' : 'Change'"/></button></div>
      <div t-if="savedStorage" class="pbcdesk-storagecard saved">
       <div class="pbcdesk-storageicon" aria-hidden="true" t-out="icon(savedStorage==='text' ? 'fileText' : 'banknote')"/>
       <div><span class="pbcdesk-status"><t t-out="icon('checkCircle')"/> Saved on contract</span><strong t-esc="savedStorage==='text' ? 'Text component' : 'Amount component'"/><small t-esc="savedStorage==='text' ? 'Keeps words, codes and other text.' : 'Keeps a number payroll can calculate with.'"/></div>
      </div>
      <p t-if="savedStorage" class="pbcdesk-storagehelp">Import writes this value to the contract. A later pay run can read it back.</p>
      <p t-else="">No contract component storage selected. Choose how to keep this value for later pay runs.</p>
      <div t-if="props.data.can_edit and (!savedStorage or state.storageEditing)" class="pbcdesk-storagechoices" role="group" aria-label="Contract storage choices">
       <button t-foreach="['text','amount']" t-as="storageChoice" t-key="storageChoice" t-attf-class="pbcdesk-storagechoice {{savedStorage===storageChoice ? 'current' : ''}} {{state.storage===storageChoice ? 'draft' : ''}}" t-att-disabled="state.busy or savedStorage===storageChoice" t-att-aria-pressed="(state.storage || savedStorage)===storageChoice ? 'true' : 'false'" t-on-click="() => this.pickStorage(storageChoice)">
        <span class="pbcdesk-choiceicon" aria-hidden="true" t-out="icon(storageChoice==='text' ? 'fileText' : 'banknote')"/><span><strong t-esc="storageChoice==='text' ? 'Text component' : 'Amount component'"/><small t-esc="storageChoice==='text' ? 'Words, grades or reference codes' : 'Salary, allowances or other numbers'"/></span><span class="pbcdesk-choicebadge" t-if="savedStorage===storageChoice">Current</span><span class="pbcdesk-choicebadge" t-elif="state.storage===storageChoice">Draft</span>
       </button>
      </div>
      <div t-if="state.storage" class="pbcdesk-draftnote" role="status"><strong>Unsaved storage change</strong><small>Save setup to switch to <t t-esc="state.storage==='text' ? 'text' : 'amount'"/> storage. Source connections stay in place.</small></div>
      <div t-if="selected.storage" class="pbcdesk-recordstorage"><small>Linked record field</small><strong t-esc="label(selected.storage.kind)"/><span t-esc="selected.storage.label || selected.storage.key"/></div>
      <button class="pbcdesk-mappinglink" t-on-click="() => this.open('employee')"><span class="pbcdesk-linkicon" aria-hidden="true" t-out="icon('users')"/><span><strong>Employee &amp; contract mappings</strong><small>View mappings for this component</small></span><span aria-hidden="true" t-out="icon('chevron')"/></button>
     </t>
     <t t-else=""><h4>How payroll reads this value</h4><p>Value type controls display and numeric treatment. Pay role controls how reports count it.</p></t>
     <t t-if="state.tab!=='sources'">
      <div class="pbcdesk-treatment">
       <h4 t-if="state.tab==='storage'">How payroll reads it</h4>
       <label>Value type<select t-att-value="state.kind" t-on-change="kindChanged" t-att-disabled="!props.data.can_edit or state.busy"><option t-foreach="props.data.kinds" t-as="k" t-key="k.value" t-att-value="k.value" t-att-selected="state.kind===k.value" t-esc="k.label"/></select></label>
       <div t-if="storageMismatch" class="pbcdesk-typehint"><strong>Check the value type</strong><small>Contract storage is <t t-esc="(state.storage || savedStorage)==='text' ? 'text' : 'an amount'"/>, while payroll reads this as <t t-esc="kindLabel(state.kind)"/>. Choose a matching value type if this is not intended.</small></div>
       <label t-if="state.tab==='payroll'">Pay role<select t-model="state.role" t-att-disabled="!props.data.can_edit or state.busy"><option value="">Not assigned</option><option t-foreach="roleOptions" t-as="p" t-key="p.key" t-att-value="p.key" t-esc="p.label"/></select></label>
       <small>Existing pay runs keep their stored results until recomputed.</small>
      </div>
      <div t-if="props.data.can_edit and setupDirty" class="pbcdesk-savebar"><span>Unsaved changes</span><button class="pbim-btn ghost" t-att-disabled="state.busy" t-on-click="discardSetup">Discard</button><button class="pbim-btn primary" t-att-disabled="state.busy or (state.storage and storageMismatch)" t-on-click="saveSetup">Save setup</button></div>
      <button class="pbcdesk-textbtn pbcdesk-treatmentlink" t-on-click="() => this.open('treatment')">All treatment settings <span aria-hidden="true">→</span></button>
     </t>
    </div>
   </aside>
  </div>
  <div t-if="state.trace" class="pbcdesk-overlay" t-on-keydown="trap"><section t-ref="traceModal" class="pbcdesk-dialog pbcdesk-trace" role="dialog" aria-modal="true" aria-label="Component journey"><header><div><h3>Trace this component</h3><p>Same Journey view, focused on the selected component. Arrowheads show the direction of data flow; two heads mean both ways.</p></div><button class="pbim-btn" t-on-click="() => this.state.trace=null">Close trace</button></header><div class="pbcdesk-tracebody"><JourneyBoard data="state.trace.data" componentId="state.trace.id" onOpenDoor="(door) => this.traceDoor(door)"/></div></section></div>
  <div t-if="state.priority" class="pbcdesk-overlay" t-on-keydown="trap"><section t-ref="priorityModal" class="pbcdesk-dialog" role="dialog" aria-modal="true" aria-label="Source order"><header><h3>Source order for this scheme</h3><button class="pbim-btn" t-att-disabled="state.busy" t-on-click="() => this.state.priority=null">Cancel</button></header><div class="pbcdesk-dialogbody"><p>Applies to every input component. The first nonblank source wins. This changes read order; it does not run an integration or enable a job.</p><div t-foreach="state.priority.order" t-as="lane" t-key="lane" class="pbcdesk-lane"><b t-esc="lane_index+1"/><span><t t-esc="laneLabel(lane)"/><small t-if="!props.data.priority.enabled[lane]">Lane is disabled in this scheme</small></span><button class="pbim-btn" t-att-disabled="state.busy or lane_index===0" t-att-aria-label="'Move '+laneLabel(lane)+' up'" t-on-click="() => this.moveLane(lane_index,-1)">↑</button><button class="pbim-btn" t-att-disabled="state.busy or lane_index===2" t-att-aria-label="'Move '+laneLabel(lane)+' down'" t-on-click="() => this.moveLane(lane_index,1)">↓</button></div><p>Within systems: direct fields before rule outputs. Within records: mapped fields before contract components. Pay-period fallback stays last.</p><h4>Review the impact</h4><p t-if="state.priority.affected===null">Checking components…</p><t t-else=""><p><b t-esc="state.priority.affected.length"/> components have a different configured source order. Actual winners and amounts depend on the data in a future run.</p><div t-foreach="state.priority.affected" t-as="r" t-key="r.id" class="pbcdesk-impact"><b t-esc="r.name"/><small>Before: <t t-foreach="r.before" t-as="s" t-key="s_index"><t t-if="s_index"> → </t><t t-esc="label(s.kind)"/></t></small><small>After: <t t-foreach="r.after" t-as="s" t-key="s_index"><t t-if="s_index"> → </t><t t-esc="label(s.kind)"/></t></small></div></t><div t-if="state.error" class="pbcdesk-error" role="alert" t-esc="state.error"/></div><footer><button t-if="props.data.can_edit" class="pbim-btn primary" t-att-disabled="state.busy or state.priority.affected===null" t-on-click="savePriority">Save order for this scheme</button></footer></section></div>
  <div t-if="state.draft" class="pbcdesk-overlay" t-on-keydown="trap"><section t-ref="draftModal" class="pbcdesk-dialog" role="dialog" aria-modal="true" aria-label="New component"><header><h3>New component</h3><button class="pbim-btn" t-att-disabled="state.busy" t-on-click="() => this.state.draft=null">Cancel</button></header><div class="pbcdesk-dialogbody"><p>This is a draft. Nothing is created until you save.</p><label>Name<input t-model="state.draft.name" placeholder="e.g. Transport allowance"/></label><label>Value type<select t-model="state.draft.kind"><option t-foreach="props.data.kinds" t-as="k" t-key="k.value" t-att-value="k.value" t-esc="k.label"/></select></label><label>Contract storage<select t-att-value="state.draft.storage" t-on-change="draftStorageChanged"><option value="">Choose later</option><option value="amount">Amount component</option><option value="text">Text component</option></select></label><p>The component is created as an input. You can map a source next.</p><div t-if="state.error" class="pbcdesk-error" role="alert" t-esc="state.error"/></div><footer><button class="pbim-btn primary" t-att-disabled="state.busy or !state.draft.name.trim()" t-on-click="createComponent">Save component</button></footer></section></div>
 </div>
</t>
</templates>
