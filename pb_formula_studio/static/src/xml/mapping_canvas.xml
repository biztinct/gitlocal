<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="pb_formula_studio.MappingCanvas">
    <div class="mapping-canvas" t-ref="root" tabindex="0" t-on-keydown="onKeydown">

      <!-- wire layer (SVG bezier paths, pixel coords relative to root) -->
      <svg class="mc-wires" preserveAspectRatio="none">
        <t t-foreach="ui.geom" t-as="g" t-key="g.id">
          <path t-att-d="g.path"
                t-attf-class="mc-wire {{ g.state }} {{ ui.hoverWire === g.id ? 'hot' : '' }}"/>
        </t>
      </svg>

      <div class="mc-cols">
        <!-- LEFT column (source) -->
        <div class="mc-col left" t-on-scroll="onColScroll">
          <div class="mc-col-head">
            <span class="mc-col-title" t-esc="props.leftTitle or 'Source'"/>
            <span class="mc-col-count" t-esc="props.leftItems.length"/>
          </div>
          <div class="mc-col-body">
            <t t-foreach="props.leftItems" t-as="it" t-key="it.id">
              <!-- opt-in group header: drawn only for items that carry a
                   `group`, so every existing adapter renders unchanged -->
              <div t-if="leftGroupHead(it_index)" class="mc-group" t-esc="leftGroupHead(it_index)"/>
              <div data-side="left" t-att-data-id="it.id"
                   t-attf-class="mc-item {{ isArmed('left', it.id) ? 'armed' : '' }} {{ leftHasAccepted(it.id) ? 'accepted' : (isLeftWired(it.id) ? 'wired' : '') }} {{ ui.focusSide==='left' and ui.focusId===it.id ? 'focus' : '' }}"
                   t-on-click="() => this.clickLeft(it.id)">
                <div class="mc-item-main">
                  <div class="mc-item-label" t-esc="it.label"/>
                  <div class="mc-item-sub"><span t-if="it.meta and it.meta.col" class="mc-col-tag" t-esc="it.meta.col"/><t t-esc="it.sublabel"/></div>
                  <!-- what the data actually looks like; absent when the feed
                       has no stored payload to sample -->
                  <div t-if="it.sample" class="mc-item-sample" t-esc="it.sample"/>
                </div>
                <span class="mc-plug right"/>
              </div>
            </t>
          </div>
        </div>

        <!-- RIGHT column (target) -->
        <div class="mc-col right" t-on-scroll="onColScroll">
          <div class="mc-col-head">
            <span class="mc-col-title" t-esc="props.rightTitle or 'Target'"/>
            <span class="mc-col-count" t-esc="props.rightItems.length"/>
          </div>
          <div class="mc-col-body">
            <t t-foreach="props.rightItems" t-as="it" t-key="it.id">
              <div data-side="right" t-att-data-id="it.id"
                   t-attf-class="mc-item {{ ui.armedLeft != null and props.canEdit ? 'drophint' : '' }} {{ rightHasAccepted(it.id) ? 'accepted' : (isRightWired(it.id) ? 'wired' : '') }} {{ ui.focusSide==='right' and ui.focusId===it.id ? 'focus' : '' }}"
                   t-on-click="() => this.clickRight(it.id)">
                <span class="mc-plug left"/>
                <div class="mc-item-main">
                  <div class="mc-item-label" t-esc="it.label"/>
                  <div class="mc-item-sub"><span t-if="it.meta and it.meta.col" class="mc-col-tag" t-esc="it.meta.col"/><t t-esc="it.sublabel"/></div>
                </div>
                <button t-if="props.onRemoveRight and !isRightWired(it.id)" class="mc-item-x" title="Remove field"
                        t-on-click="(ev) => this.removeRight(it.id, ev)">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
                </button>
              </div>
            </t>
          </div>
        </div>
      </div>

      <!-- wire action badges (accept/reject on suggested, delete on accepted) -->
      <div class="mc-badges">
        <t t-foreach="ui.geom" t-as="g" t-key="'b'+g.id">
          <div t-if="g.state==='suggested'" class="mc-badge sug"
               t-attf-style="left:{{g.mx}}px;top:{{g.my}}px"
               t-on-mouseenter="() => { ui.hoverWire = g.id; }" t-on-mouseleave="() => { ui.hoverWire = null; }">
            <span class="mc-conf" t-att-title="g.reason" t-esc="confidencePct(g)+'%'"/>
            <button t-if="props.canEdit" class="mc-b-ok" title="Accept" t-on-click="() => this.accept(g)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg></button>
            <button t-if="props.canEdit" class="mc-b-x" title="Reject" t-on-click="() => this.reject(g)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
          </div>
          <!-- W62 — accepted API wire: transform badge (visible to everyone) + delete (managers) -->
          <div t-elif="g.state==='accepted' and g.transform"
               t-attf-class="mc-badge tf {{ g.transform.error ? 'err' : '' }}"
               t-attf-style="left:{{g.mx}}px;top:{{g.my}}px"
               t-on-mouseenter="() => { ui.hoverWire = g.id; }" t-on-mouseleave="() => { ui.hoverWire = null; }">
            <button class="mc-tf-chip"
                    t-att-title="g.transform.error ? (g.transform.error_msg or 'Transform failed — using default') : (g.transform.python ? 'Python transform (edit in backend)' : 'Edit transform')"
                    t-on-click="() => this.openTransform(g)">
              <t t-esc="transformGlyph(g.transform)"/>
            </button>
            <button t-if="props.canEdit" class="mc-b-del" title="Remove mapping" t-on-click="() => this.del(g)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
          </div>
          <!-- accepted cycle wire (no transform): delete only, managers -->
          <div t-elif="g.state==='accepted' and props.canEdit" class="mc-badge acc"
               t-attf-style="left:{{g.mx}}px;top:{{g.my}}px"
               t-on-mouseenter="() => { ui.hoverWire = g.id; }" t-on-mouseleave="() => { ui.hoverWire = null; }">
            <button class="mc-b-del" title="Remove mapping" t-on-click="() => this.del(g)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
          </div>
        </t>
      </div>

      <!-- W62 — transform editor popover (scrim pattern, C11) -->
      <t t-if="ui.tfOpen">
        <div class="mc-tf-scrim" t-on-click="closeTransform"/>
        <div class="mc-tf-pop" t-attf-style="left:{{tfAnchor.x}}px;top:{{tfAnchor.y}}px" t-on-click="(ev) => ev.stopPropagation()">
          <div class="mc-tf-head">
            <span class="mc-tf-title">Transform on the wire</span>
            <button class="mc-tf-x" t-on-click="closeTransform"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
          </div>

          <!-- python: read-only on the canvas (D-I2) -->
          <div t-if="ui.tfPy" class="mc-tf-note">
            <span class="mc-tf-glyph">ƒ</span>
            <div>
              <b>Python expression</b>
              <p>Code transforms are edited in the connector's field-mapping form in the backend, not on the canvas.</p>
              <p t-if="ui.tfPreview.error" class="mc-tf-err"><t t-esc="ui.tfPreview.error"/></p>
            </div>
          </div>

          <!-- read-only user: badge + locked notice, no editor (W104 lesson) -->
          <div t-elif="!props.canEdit" class="mc-tf-note">
            <span class="mc-tf-glyph"><t t-esc="tfDraftGlyph"/></span>
            <div>
              <b>View only</b>
              <p>Only payroll managers can edit transforms on the wire.</p>
            </div>
          </div>

          <!-- manager editor -->
          <t t-else="">
            <div class="mc-tf-row">
              <label>Operation</label>
              <select class="mc-tf-sel" t-on-change="onDraftType">
                <option t-foreach="tfTypeOptions" t-as="o" t-key="o.v" t-att-value="o.v" t-att-selected="o.v === ui.tfDraft.transformation_type" t-esc="o.l"/>
              </select>
            </div>
            <div t-if="tfNeedsValue" class="mc-tf-row">
              <label>Factor / value</label>
              <input class="mc-tf-inp" type="number" step="any" t-att-value="ui.tfDraft.transformation_value" t-on-input="onDraftValue"/>
            </div>
            <div t-if="tfNeedsDecimals" class="mc-tf-row">
              <label>Decimal places</label>
              <input class="mc-tf-inp" type="number" step="1" min="0" t-att-value="ui.tfDraft.transformation_decimals" t-on-input="onDraftDecimals"/>
            </div>

            <!-- live preview: sample → transformed (D-I2) -->
            <div class="mc-tf-prev">
              <span class="mc-tf-badge"><t t-esc="tfDraftGlyph"/></span>
              <t t-if="ui.tfPreview.loading"><span class="mc-tf-dim">computing…</span></t>
              <t t-elif="ui.tfPreview.error"><span class="mc-tf-err" t-esc="ui.tfPreview.error"/></t>
              <t t-else="">
                <span class="mc-tf-dim" t-esc="ui.tfPreview.sample"/>
                <svg class="mc-tf-arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                <b t-esc="ui.tfPreview.result"/>
              </t>
            </div>

            <div class="mc-tf-actions">
              <button class="mc-tf-cancel" t-on-click="closeTransform">Cancel</button>
              <button class="mc-tf-save" t-att-disabled="ui.tfSaving" t-on-click="saveTransform">
                <t t-esc="ui.tfSaving ? 'Saving…' : 'Save'"/>
              </button>
            </div>
          </t>
        </div>
      </t>

      <!-- draw-mode hint -->
      <div t-if="ui.armedLeft != null and props.canEdit" class="mc-drawhint">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        Click a target component to connect · <b>Esc</b> to cancel
      </div>
    </div>
  </t>

</templates>
