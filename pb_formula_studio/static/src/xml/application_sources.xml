<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="pb_formula_studio.ApplicationSources">
<div class="pas-workspace">
  <div class="pas-shell">
    <button class="pas-back" t-on-click="back">← Back to payroll</button>
    <header class="pas-hero"><div><div class="pas-eyebrow">PAYROLL SOURCES</div><h1>Your records. Ready for payroll.</h1><p>Choose how pay is calculated and where each payroll item gets its value.</p><strong t-if="state.data" t-esc="state.data.name"/></div><div class="pas-save"><span t-esc="state.dirty ? 'Unsaved changes' : 'All changes saved'"/><button class="pas-primary" t-on-click="save" t-att-disabled="state.busy or !state.dirty or !state.data?.can_edit">Save changes</button></div></header>
    <div class="pas-error" t-if="state.error" role="alert" t-esc="state.error"/>
    <div t-if="!state.data" class="pas-empty">Loading payroll sources…</div>
    <t t-if="state.data">
      <nav class="pas-tabs"><button t-att-class="state.tab==='calculation'?'active':''" t-on-click="()=>state.tab='calculation'">How pay is calculated</button><button t-att-class="state.tab==='sources'?'active':''" t-on-click="()=>state.tab='sources'">Where values come from <span t-esc="state.rows.length"/></button></nav>
      <div t-if="state.tab==='calculation'" class="pas-calculation">
        <section class="pas-card pas-enable"><div><h2>Use application records</h2><p>Run payroll without a spreadsheet. Each run checks the records for its selected employees and dates.</p></div><label class="pas-toggle"><input type="checkbox" aria-label="Use application records" t-att-checked="state.settings.application_data_enabled" t-att-disabled="!state.data.can_edit" t-on-change="ev=>this.set('application_data_enabled',ev.target.checked)"/><span t-esc="state.settings.application_data_enabled?'Enabled':'Off'"/></label><label class="pas-date">Available for pay periods starting on<input type="date" aria-label="Application payroll start date" t-att-value="state.settings.application_effective_from || ''" t-att-disabled="!state.data.can_edit" t-on-change="ev=>this.set('application_effective_from',ev.target.value||false)"/></label><small>Earlier periods keep their existing payroll process.</small></section>
        <section class="pas-card"><div class="pas-step">01 · PAY BASIS</div><h2>What determines paid time?</h2><div class="pas-choices">
          <button t-attf-class="pas-choice {{state.settings.payroll_basis==='contractual'?'selected':''}}" t-on-click="()=>this.set('payroll_basis','contractual')" t-att-disabled="!state.data.can_edit"><span class="pas-radio"/><div><b>Contractual monthly pay</b><p>Start with the employee’s schedule. Adjust for joining, leaving and unpaid leave.</p><small>Regular timesheets are not required.</small></div></button>
          <button t-attf-class="pas-choice {{state.settings.payroll_basis==='timesheet'?'selected':''}}" t-on-click="()=>this.set('payroll_basis','timesheet')" t-att-disabled="!state.data.can_edit"><span class="pas-radio"/><div><b>Approved timesheets</b><p>Use manager-approved time checked against attendance. Add paid leave and public holidays once.</p><small>Missing or conflicting time needs review.</small></div></button>
        </div></section>
        <section class="pas-card"><div class="pas-step">02 · MONTHLY DAY BASIS</div><h2>How many days make a full month?</h2><div class="pas-choices">
          <button t-attf-class="pas-choice {{state.settings.standard_day_basis==='calendar'?'selected':''}}" t-on-click="()=>this.set('standard_day_basis','calendar')" t-att-disabled="!state.data.can_edit"><span class="pas-radio"/><div><b>Employee work calendar</b><p>Use each employee’s scheduled working days for that month.</p></div></button>
          <button t-attf-class="pas-choice {{state.settings.standard_day_basis==='fixed'?'selected':''}}" t-on-click="()=>this.set('standard_day_basis','fixed')" t-att-disabled="!state.data.can_edit"><span class="pas-radio"/><div><b>Fixed monthly days</b><p>Use one standard number for this payroll configuration.</p></div></button>
        </div><label t-if="state.settings.standard_day_basis==='fixed'" class="pas-date">Days in a full month<input aria-label="Fixed monthly days" type="number" min="1" step="0.5" t-att-value="state.settings.fixed_standard_days" t-on-change="ev=>this.set('fixed_standard_days',Number(ev.target.value))" t-att-disabled="!state.data.can_edit"/></label>
        <aside class="pas-example"><b>How it works</b><p t-if="state.settings.payroll_basis==='contractual'">A full month of eligible service is fully paid. Unpaid leave and dates outside employment reduce the payable share. Paid leave is not added twice.</p><p t-else="">Approved regular time, paid leave and holidays determine the payable share. Overtime is calculated through its own mapped pay items.</p><small t-if="state.settings.standard_day_basis==='fixed'">A fixed day basis scales the same share of the employee’s schedule; it does not create extra paid days.</small></aside></section>
      </div>
      <section t-else="" class="pas-sources">
        <div class="pas-stats"><div><b t-esc="connected"/><span>Connected items</span></div><button t-on-click="()=>state.filter=state.filter==='review'?'all':'review'"><b t-esc="needsReview"/><span>Need a source review</span></button><p>Connections describe where values come from. Employee data and approvals are checked for each pay period.</p></div>
        <div class="pas-toolbar"><input type="search" aria-label="Find a payroll source" placeholder="Search payroll items or source records…" t-model="state.query"/><button t-on-click="()=>state.filter=state.filter==='review'?'all':'review'" t-esc="state.filter==='review'?'Show all items':'Needs review only'"/></div>
        <div class="pas-source-table"><div class="pas-source-head"><span>PAYROLL ITEM</span><span>RECORDS IT COMES FROM</span><span>VALUE USED</span><span/></div><article t-foreach="visibleRows" t-as="row" t-key="row.id" class="pas-source-row"><div><b t-esc="row.name"/><small t-if="row.pending" class="pas-warning">Source needs review</small></div><div><span class="pas-owner" t-esc="row.owner"/></div><div><span t-esc="row.label"/><small t-if="row.owner==='Monthly adjustments'">Approved for the employee and pay period</small></div><button t-on-click="()=>this.pick(row)" t-att-disabled="!state.data.can_edit">Change source</button><details class="pas-details"><summary>Connection details</summary><p t-esc="row.description"/><p>Changing the worksheet position does not change this connection.</p><details><summary>Technical details</summary><code t-esc="row.model"/><code t-esc="row.key || row.code"/><p t-if="row.technical_note" t-esc="row.technical_note"/></details></details></article><div t-if="!visibleRows.length" class="pas-empty">No payroll items match this view.</div></div>
      </section>
      <div t-if="state.picker" class="pas-overlay" t-on-click="()=>state.picker=0"><section role="dialog" aria-modal="true" aria-label="Choose a payroll source" class="pas-picker" t-on-click.stop="()=>{}"><header><div><small>CHOOSE A SOURCE</small><h2 t-esc="selected.name"/></div><button aria-label="Close source picker" t-on-click="()=>state.picker=0">×</button></header><p>Choose where this payroll item gets its value. Compatible sources are shown first; approval rules still apply.</p><input type="search" aria-label="Search available sources" placeholder="Search employee, contract, leave, overtime…" t-model="state.sourceQuery"/><label class="pas-source-toggle"><input type="checkbox" t-model="state.showAllSources"/> Show all source types, including payroll history</label><button t-if="selected.native_label!=='No saved-record mapping'" class="pas-option" t-on-click="()=>this.choose('')"><b>Existing employee or contract mapping</b><span t-esc="selected.native_label"/></button><div class="pas-options"><p t-if="!options.length" class="pas-empty">No matching sources. Try another search or show all source types.</p><button t-foreach="options" t-as="option" t-key="option.key" class="pas-option" t-on-click="()=>this.choose(option.key)"><span class="pas-owner" t-esc="option.owner"/><b t-esc="option.label"/><small t-esc="option.description"/></button></div></section></div>
    </t>
  </div>
</div>
</t>
</templates>
