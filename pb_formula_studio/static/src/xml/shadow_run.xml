<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="pb_formula_studio.PbShadowRun">
    <div class="pbsr-root">

      <!-- ============ OVERVIEW ============ -->
      <t t-if="state.view === 'overview'">
        <header class="pbsr-hero">
          <div class="pbsr-hero-txt">
            <h1>Shadow Parallel Run</h1>
            <p>Recompute historical payroll through the engine and prove it matches — cell by cell.</p>
          </div>
        </header>

        <div class="pbsr-launch">
          <div class="pbsr-launch-f">
            <label>Configuration</label>
            <select t-on-change="onLaunchConfig">
              <t t-foreach="state.configs" t-as="c" t-key="c.id">
                <option t-att-value="c.id" t-att-selected="c.id === state.launch.config_id">
                  <t t-esc="c.name"/> (<t t-esc="c.payslips"/> payslips)
                </option>
              </t>
            </select>
          </div>
          <div class="pbsr-launch-f sm">
            <label>Max payslips</label>
            <input type="number" t-att-value="state.launch.limit" t-on-change="onLaunchLimit"/>
          </div>
          <button class="pbsr-btn primary" t-att-disabled="state.busy" t-on-click="launchRun">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Run shadow
          </button>
        </div>

        <div t-if="state.busy and state.progress" class="pbsr-progress">
          <div class="pbsr-progress-h"><t t-esc="state.progress.phase"/>
            <span t-if="state.progress.total"><t t-esc="state.progress.done"/> / <t t-esc="state.progress.total"/></span>
          </div>
          <div class="pbsr-progress-bar">
            <div class="fill" t-attf-style="width: {{ state.progress.total ? Math.round(state.progress.done/state.progress.total*100) : 5 }}%"/>
          </div>
        </div>

        <div t-if="!state.configs.length and !state.loading" class="pbsr-empty">
          No configuration has computed payslips with stored values yet. Compute a payrun first, then shadow it.
        </div>

        <div class="pbsr-runs" t-if="state.runs.length">
          <div class="pbsr-run" t-foreach="state.runs" t-as="r" t-key="r.id" t-on-click="() => this.openRun(r.id)">
            <div t-attf-class="pbsr-conf {{ confClass(r.confidence) }}">
              <b><t t-esc="confidencePct(r.confidence)"/>%</b><small>confidence</small>
            </div>
            <div class="pbsr-run-main">
              <div class="pbsr-run-name"><t t-esc="r.name"/></div>
              <div class="pbsr-run-sub"><t t-esc="r.config"/></div>
            </div>
            <div class="pbsr-run-stats">
              <span><b t-esc="r.employees"/> employees</span>
              <span><b t-esc="r.values_matched"/>/<t t-esc="r.values_total"/> cells</span>
              <span t-attf-class="{{ r.clusters ? 'warn' : 'ok' }}"><b t-esc="r.clusters"/> clusters</span>
              <span t-if="r.certified" class="pbsr-cert-badge">Certified</span>
            </div>
          </div>
        </div>
      </t>

      <!-- ============ DETAIL ============ -->
      <t t-if="state.view === 'detail' and state.detail">
        <header class="pbsr-dhead">
          <button class="pbsr-back" t-on-click="backToList">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <div class="pbsr-dhead-txt">
            <h1><t t-esc="state.detail.name"/></h1>
            <p><t t-esc="state.detail.config"/></p>
          </div>
          <div class="pbsr-dhead-actions">
            <button class="pbsr-btn ghost" t-att-disabled="state.busy" t-on-click="() => this.recompute(state.detail.id)">Recompute</button>
            <button class="pbsr-btn ghost danger" t-att-disabled="state.busy" t-on-click="() => this.dropRun(state.detail.id)">Drop</button>
            <button class="pbsr-btn primary" t-att-disabled="state.busy" t-on-click="certify">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/><path d="M8.5 14 7 22l5-3 5 3-1.5-8"/></svg>
              Certificate
            </button>
          </div>
        </header>

        <div t-if="state.busy and state.progress" class="pbsr-progress">
          <div class="pbsr-progress-h"><t t-esc="state.progress.phase"/>
            <span t-if="state.progress.total"><t t-esc="state.progress.done"/> / <t t-esc="state.progress.total"/></span>
          </div>
          <div class="pbsr-progress-bar"><div class="fill" t-attf-style="width: {{ state.progress.total ? Math.round(state.progress.done/state.progress.total*100) : 5 }}%"/></div>
        </div>

        <div class="pbsr-detail">
          <!-- confidence hero -->
          <div class="pbsr-cardring">
            <svg viewBox="0 0 120 120" class="pbsr-ring">
              <circle cx="60" cy="60" r="52" class="track"/>
              <circle cx="60" cy="60" r="52" t-attf-class="val {{ confClass(state.detail.confidence) }}"
                      t-att-stroke-dasharray="ringDash(state.detail.confidence).dash"
                      t-att-stroke-dashoffset="ringDash(state.detail.confidence).offset"
                      transform="rotate(-90 60 60)"/>
            </svg>
            <div class="pbsr-ring-txt">
              <b><t t-esc="confidencePct(state.detail.confidence)"/>%</b>
              <small>Migration confidence</small>
            </div>
          </div>

          <div class="pbsr-cardstats">
            <div class="pbsr-stat"><b t-esc="state.detail.employees"/><small>employees</small></div>
            <div class="pbsr-stat"><b t-esc="state.detail.values_matched"/><small>cells matched</small></div>
            <div class="pbsr-stat"><b t-esc="state.detail.values_total - state.detail.values_matched"/><small>cells off</small></div>
            <div class="pbsr-stat"><b t-esc="state.detail.clusters.length"/><small>clusters</small></div>

            <div class="pbsr-periods">
              <span class="pbsr-period" t-foreach="state.detail.periods" t-as="p" t-key="p.id">
                <b t-esc="p.label"/> · <t t-esc="p.employees"/> emp
                <t t-if="p.discrepant"> · <span class="warn"><t t-esc="p.discrepant"/> off</span></t>
                <t t-if="p.errors"> · <span class="bad"><t t-esc="p.errors"/> err</span></t>
              </span>
            </div>
          </div>
        </div>

        <!-- tolerance -->
        <div class="pbsr-tol">
          <label>Tolerance (JSON, per component or <code>*</code>)</label>
          <div class="pbsr-tol-row">
            <input t-model="state.tolDraft"/>
            <button class="pbsr-btn ghost" t-att-disabled="state.busy" t-on-click="applyTolerance">Re-compare</button>
          </div>
        </div>

        <!-- clusters -->
        <div class="pbsr-clusters">
          <div class="pbsr-clusters-h">
            <h2>Discrepancy clusters</h2>
            <button class="pbsr-btn soft" t-att-disabled="state.busy" t-on-click="nameWithAI">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3.2"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>
              Name causes with AI
            </button>
          </div>

          <div t-if="!state.detail.clusters.length" class="pbsr-clean">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
            Every recomputed cell matched the historical result within tolerance.
          </div>

          <table t-else="" class="pbsr-ctable">
            <thead><tr><th>Component</th><th>Period</th><th>Employees</th><th>Avg Δ</th><th>Likely cause</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <tr t-foreach="state.detail.clusters" t-as="c" t-key="c.id" t-attf-class="res-{{ c.resolution }}">
                <td><b t-esc="c.code"/></td>
                <td t-esc="c.period"/>
                <td><t t-esc="c.lines"/> <small>(<t t-esc="c.count"/> cells)</small></td>
                <td t-attf-class="{{ c.avg_delta >= 0 ? 'pos' : 'neg' }}" t-esc="c.avg_delta"/>
                <td class="cause"><t t-esc="c.cause or '—'"/></td>
                <td><span t-attf-class="pbsr-restag {{ c.resolution }}" t-esc="c.resolution"/></td>
                <td class="pbsr-cact">
                  <button title="Open in Formula Studio" t-on-click="() => this.openInStudio(c)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                  </button>
                  <button title="Accept as expected" t-on-click="() => this.setResolution(c, 'accepted')">Accept</button>
                  <button title="Won't fix" t-on-click="() => this.setResolution(c, 'wontfix')">Ignore</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </t>

    </div>
  </t>

</templates>
