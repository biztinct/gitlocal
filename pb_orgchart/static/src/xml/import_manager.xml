<?xml version="1.0" encoding="UTF-8"?>
<!-- MANAGERCOL — "Managers from the file" on the import's last step and on the
     batch page. Every word arrives in the payload, already translated
     (`hr.payroll.import.batch._pb_manager_summary`); this only lays it out.
     The rows fold out with a native <details>, so neither host component
     needs a line of new JS. -->
<templates xml:space="preserve">

  <t t-name="pb_orgchart.ImportManagers">
    <div t-if="m and m.show" class="pbmg" t-att-data-tone="m.tone or ''" data-coach="managers-from-file">
      <div class="pbmg-h">
        <span class="pbmg-ic"><t t-out="ic('users', 15)"/></span>
        <span class="pbmg-t" t-esc="m.title"/>
        <span class="pbmg-chips">
          <span t-foreach="m.chips" t-as="c" t-key="c.key" class="pbmg-chip"
                t-att-data-tone="c.n ? (c.tone or 'plain') : 'zero'">
            <b t-esc="c.n"/> <t t-esc="c.label"/>
          </span>
        </span>
      </div>
      <div t-if="m.hint" class="pbmg-hint" t-esc="m.hint"/>
      <details t-if="m.rows and m.rows.length" class="pbmg-more">
        <summary t-esc="m.toggle"/>
        <ul class="pbmg-rows">
          <li t-foreach="m.rows" t-as="r" t-key="r.id" class="pbmg-row" t-att-data-st="r.state">
            <span class="pbmg-nm" t-esc="r.name"/>
            <span class="pbmg-cd" t-esc="r.code"/>
            <span class="pbmg-why" t-esc="r.note"/>
          </li>
        </ul>
      </details>
    </div>
  </t>

  <t t-inherit="pb_import_wizard.ImportWizard" t-inherit-mode="extension">
    <xpath expr="//div[@data-coach='iw-outcome']" position="after">
      <t t-call="pb_orgchart.ImportManagers">
        <t t-set="m" t-value="!state.summary.pending and state.summary.managers"/>
      </t>
    </xpath>
  </t>

  <t t-inherit="pb_import_batch.BatchCockpit" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('pbbc-actions')]" position="before">
      <t t-call="pb_orgchart.ImportManagers">
        <t t-set="m" t-value="d.managers"/>
      </t>
    </xpath>
  </t>

</templates>
