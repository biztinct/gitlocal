        <field name="sequence">974</field>
        <field name="action_xmlid">pb_audit.action_pb_audit</field>
        <field name="action_tag">pb_audit</field>
        <field name="match_action_tags">pb_audit</field>
        <field name="groups_id" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
</odoo>
