        <field name="action_xmlid">pb_hr_payroll_formula.action_payroll_proration_line</field>
    </record>
    <record id="item_retro" model="pb.sidebar.item">
        <field name="section_id" ref="sec_payrun"/><field name="name">Retro Adjustments</field>
        <field name="icon">percent</field><field name="sequence">80</field>
        <field name="action_xmlid">pb_hr_payroll_formula.action_payroll_retro_adjustment</field>
    </record>

