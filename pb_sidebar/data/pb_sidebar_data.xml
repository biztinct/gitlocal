        <field name="section_id" ref="sec_payrun"/><field name="name">Full &amp; Final</field>
        <field name="icon">file</field><field name="sequence">60</field>
        <field name="action_xmlid">pb_hr_fullandfinal.action_full_and_final_employees</field>
