    </record>
    <!-- Phase O: a REAL Workforce Analytics surface, gated like its
         neighbours. The slot previously held pb_demo's placeholder, injected
         imperatively by pb_demo/hooks.py with NO groups at all and with every
         query filtered `is_demo = true` — so it was visible to everyone and
         empty on any real database. -->
