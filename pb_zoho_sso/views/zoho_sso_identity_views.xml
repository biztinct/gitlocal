<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pb_zoho_sso_identity_list" model="ir.ui.view">
        <field name="name">pb.zoho.sso.identity.list</field>
        <field name="model">pb.zoho.sso.identity</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" decoration-muted="state == 'blocked'">
                <field name="email"/>
                <field name="display_name"/>
                <field name="zoho_user_id"/>
                <field name="accounts_url" optional="hide"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
                <field name="last_login_at"/>
            </list>
        </field>
    </record>

    <record id="view_pb_zoho_sso_identity_form" model="ir.ui.view">
        <field name="name">pb.zoho.sso.identity.form</field>
        <field name="model">pb.zoho.sso.identity</field>
        <field name="arch" type="xml">
            <form string="Zoho SSO identity">
                <sheet>
                    <div class="oe_title"><h1><field name="email"/></h1></div>
                    <group>
                        <group>
                            <field name="display_name"/>
                            <field name="zoho_user_id"/>
                            <field name="accounts_url"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="state"/>
                            <field name="last_seen_at"/>
                            <field name="last_login_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pb_zoho_sso_identity" model="ir.actions.act_window">
        <field name="name">Zoho SSO</field>
        <field name="res_model">pb.zoho.sso.identity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Zoho identities have attempted to sign in yet.</p>
            <p>After Zoho verifies a user, approve the identity by selecting an active Payobook user and setting its status to Linked.</p>
        </field>
    </record>

    <record id="view_pb_zoho_sso_audit_list" model="ir.ui.view">
        <field name="name">pb.zoho.sso.audit.list</field>
        <field name="model">pb.zoho.sso.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="event" widget="badge"/>
                <field name="email"/>
                <field name="user_id"/>
                <field name="remote_ip"/>
                <field name="detail"/>
            </list>
        </field>
    </record>

    <record id="action_pb_zoho_sso_audit" model="ir.actions.act_window">
        <field name="name">Zoho SSO audit</field>
        <field name="res_model">pb.zoho.sso.audit</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_pb_zoho_sso_root" name="Zoho SSO"
              parent="base.menu_administration" sequence="85" groups="base.group_system"/>
    <menuitem id="menu_pb_zoho_sso_identities" name="Identity approvals"
              parent="menu_pb_zoho_sso_root" action="action_pb_zoho_sso_identity" sequence="10"
              groups="base.group_system"/>
    <menuitem id="menu_pb_zoho_sso_audit" name="Sign-in audit"
              parent="menu_pb_zoho_sso_root" action="action_pb_zoho_sso_audit" sequence="20"
              groups="base.group_system"/>
</odoo>
