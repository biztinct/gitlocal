msgstr "Thay đổi này đã được gửi đi rồi."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "There is nothing in this change to approve."
msgstr "Thay đổi này không có gì để phê duyệt."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Division"
msgstr "Bộ phận"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Values"
msgstr "Số giá trị"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Showing the first %(shown)s of %(total)s values."
msgstr "Đang hiển thị %(shown)s trong tổng số %(total)s giá trị."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Now"
msgstr "Hiện tại"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Proposed"
msgstr "Đề xuất"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid " and %s more"
msgstr " và %s mục nữa"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Nothing was changed. Somebody else has already changed %(n)s of these values since this was proposed: %(names)s%(more)s. Send this back and propose it again against what is there now."
msgstr "Không có gì được thay đổi. Người khác đã sửa %(n)s giá trị trong số này kể từ khi đề xuất được tạo: %(names)s%(more)s. Hãy trả lại và đề xuất lại dựa trên dữ liệu hiện có."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "These have been changed by somebody else since this was proposed, so nothing was written: %(names)s%(more)s."
msgstr "Những mục này đã bị người khác sửa kể từ khi đề xuất được tạo, nên không có gì được ghi: %(names)s%(more)s."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "A reason was written down"
msgstr "Đã ghi lý do"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "People affected"
msgstr "Số người bị ảnh hưởng"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Values changed"
msgstr "Số giá trị thay đổi"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Changes bank details"
msgstr "Thay đổi thông tin ngân hàng"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Changes pay"
msgstr "Thay đổi lương"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Where it came from"
msgstr "Nguồn của thay đổi"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Typed on the desk"
msgstr "Nhập trên màn hình Hồ sơ"

#. module: pb_records
#. odoo-javascript
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
#: code:addons/pb_records/static/src/xml/records_desk.xml:0
msgid "From a file"
msgstr "Từ một tệp"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Bank details"
msgstr "Thông tin ngân hàng"

#. module: pb_records
#. odoo-javascript
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
#: code:addons/pb_records/models/pb_records_io.py:0
#: code:addons/pb_records/models/records_approval.py:0
#: code:addons/pb_records/static/src/js/records_cells.js:0
msgid "Yes"
msgstr "Có"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "Pay"
msgstr "Lương"

#. module: pb_records
#. odoo-python
#. odoo-javascript
#: code:addons/pb_records/models/records_approval.py:0 code:addons/pb_records/models/pb_records_desk.py:0 code:addons/pb_records/static/src/js/records_desk.js:0
msgid "Records Desk changes"
msgstr "Thay đổi hồ sơ hàng loạt"

#. module: pb_records
#. odoo-javascript
#: code:addons/pb_records/static/src/js/records_desk.js:0
msgid "Sent for approval — %s"
msgstr "Đã gửi duyệt — %s"

#. module: pb_records
#. odoo-javascript
#: code:addons/pb_records/static/src/js/records_desk.js:0
msgid "waiting for its approver"
msgstr "đang chờ người phê duyệt"

#. module: pb_records
#. odoo-javascript
#: code:addons/pb_records/static/src/js/records_desk.js:0
msgid "Approvals"
msgstr "Phê duyệt"

#. module: pb_records
#. odoo-javascript
#: code:addons/pb_records/static/src/js/records_desk.js:0
msgid "The Approvals screen is not installed on this database."
msgstr "Màn hình Phê duyệt chưa được cài trên cơ sở dữ liệu này."

#. module: pb_records
#. odoo-javascript
#: code:addons/pb_records/static/src/xml/records_desk.xml:0
msgid "See the request"
msgstr "Xem yêu cầu"

#. module: pb_records
#. odoo-python
#. odoo-javascript
#: code:addons/pb_records/models/records_approval.py:0 code:addons/pb_records/models/pb_records_desk.py:0 code:addons/pb_records/static/src/js/records_desk.js:0
msgid "with"
msgstr "đang ở chỗ"

#. module: pb_records
#. odoo-javascript
#: code:addons/pb_records/static/src/js/records_palette.js:0
msgid "Records"
msgstr "Hồ sơ"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "One of: %s"
msgstr "Một trong: %s"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "One of this field's choices."
msgstr "Một trong các lựa chọn của trường này."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Yes or No."
msgstr "Có hoặc Không."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "A name. One that does not exist yet is created."
msgstr "Một cái tên. Tên chưa có sẽ được tạo mới."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "A name that already exists — new ones are not created from a file."
msgstr "Một cái tên đã có — tên mới không được tạo từ tệp."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "A date, like 2026-08-29."
msgstr "Một ngày, ví dụ 2026-08-29."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "A number, like 1500000."
msgstr "Một số, ví dụ 1500000."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Part of the bank account. It is only saved when an account number results."
msgstr "Một phần của tài khoản ngân hàng. Chỉ được lưu khi có số tài khoản."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Text."
msgstr "Văn bản."

#. module: pb_records
#. odoo-javascript
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
#: code:addons/pb_records/models/pb_records_io.py:0
#: code:addons/pb_records/static/src/js/records_cells.js:0
msgid "No"
msgstr "Không"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Spreadsheets cannot be written on this server yet. Ask an administrator to install the spreadsheet library."
msgstr "Máy chủ này chưa tạo được bảng tính. Hãy nhờ quản trị viên cài thư viện bảng tính."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Pick at least one field first — a file needs a column to carry."
msgstr "Hãy chọn ít nhất một trường trước — tệp cần có một cột để chứa dữ liệu."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Identity — used to match the row to a person. It is never imported."
msgstr "Thông tin nhận diện — dùng để khớp dòng với một người. Không bao giờ được nhập vào."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Pick one of the listed values."
msgstr "Hãy chọn một trong các giá trị được liệt kê."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Not one of the choices"
msgstr "Không nằm trong các lựa chọn"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "%(n)s people carry the code %(code)s — this row cannot say which one."
msgstr "%(n)s người cùng có mã %(code)s — dòng này không xác định được là ai."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "%(n)s people use the email %(email)s — add the employee code."
msgstr "%(n)s người dùng chung email %(email)s — hãy thêm mã nhân viên."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "%(n)s people called %(name)s — add the employee code."
msgstr "%(n)s người tên %(name)s — hãy thêm mã nhân viên."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "This row names nobody — it has no employee code, name or email."
msgstr "Dòng này không chỉ ra ai — không có mã nhân viên, tên hay email."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "Nobody here matches %s."
msgstr "Không có ai ở đây khớp với %s."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "That file is empty."
msgstr "Tệp đó trống."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "That file is larger than 10 MB. Export a smaller slice — filter to one department and try again."
msgstr "Tệp đó lớn hơn 10 MB. Hãy xuất một phần nhỏ hơn — lọc theo một phòng ban rồi thử lại."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "This is not a spreadsheet. Drop an .xlsx or a .csv file."
msgstr "Đây không phải bảng tính. Hãy thả tệp .xlsx hoặc .csv."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "That file could not be opened as a spreadsheet."
msgstr "Không mở được tệp đó dưới dạng bảng tính."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "That file could not be opened as a spreadsheet. If it was renamed, save it again as .xlsx or .csv."
msgstr "Không mở được tệp đó dưới dạng bảng tính. Nếu tệp đã bị đổi tên, hãy lưu lại dưới dạng .xlsx hoặc .csv."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "This file has no heading row."
msgstr "Tệp này không có dòng tiêu đề."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "None of the headings match a field this pay scheme maps — export a file from this desk first, fill it in and drop it back."
msgstr "Không tiêu đề nào khớp với trường mà chương trình lương này dùng — hãy xuất tệp từ Bàn hồ sơ trước, điền vào rồi thả lại."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "No employee code, name or email column was recognised, so no row can be matched to a person."
msgstr "Không nhận ra cột mã nhân viên, tên hay email, nên không dòng nào khớp được với một người."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_io.py:0
msgid "This file has headings only — fill it in and drop it again."
msgstr "Tệp này chỉ có tiêu đề — hãy điền dữ liệu rồi thả lại."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "You do not have access to employee records. Ask an administrator for the HR or Payroll Officer role."
msgstr "Bạn không có quyền xem hồ sơ nhân viên. Hãy nhờ quản trị viên cấp vai trò Nhân sự hoặc Cán bộ lương."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "All schemes"
msgstr "Tất cả chương trình lương"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "%(name)s ← %(code)s"
msgstr "%(name)s ← %(code)s"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Part of the employee's bank account."
msgstr "Một phần của tài khoản ngân hàng của nhân viên."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Account number, bank, SWIFT/BIC and holder name are four columns that together make ONE bank account. A change is only saved when an account number results."
msgstr "Số tài khoản, ngân hàng, SWIFT/BIC và tên chủ tài khoản là bốn cột cùng tạo nên MỘT tài khoản ngân hàng. Thay đổi chỉ được lưu khi có số tài khoản."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Cannot be changed here"
msgstr "Không thể thay đổi ở đây"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "This destination is read-only on the record, so a value typed here would be dropped."
msgstr "Trường đích này chỉ đọc trên hồ sơ, nên giá trị gõ vào đây sẽ bị bỏ qua."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Contract component · %s"
msgstr "Thành phần hợp đồng · %s"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Text kept on the contract"
msgstr "Văn bản lưu trên hợp đồng"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Amount kept on the contract"
msgstr "Số tiền lưu trên hợp đồng"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Contract components live on the person's contract, one line per component. Changing one here writes that line and records the change."
msgstr "Thành phần hợp đồng nằm trên hợp đồng của mỗi người, mỗi thành phần một dòng. Thay đổi ở đây sẽ ghi vào dòng đó và lưu lại thay đổi."

#. module: pb_records
#. odoo-javascript
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Employee"
msgstr "Nhân viên"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Contract"
msgstr "Hợp đồng"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Bank"
msgstr "Ngân hàng"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Contract components"
msgstr "Thành phần hợp đồng"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Not set"
msgstr "Chưa đặt"

#. module: pb_records
#. odoo-javascript
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
#: code:addons/pb_records/static/src/xml/records_desk.xml:0
msgid "No contract"
msgstr "Không có hợp đồng"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "Not stated"
msgstr "Không ghi rõ"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "%(list)s and %(n)s more"
msgstr "%(list)s và %(n)s mục nữa"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "'%(value)s' is not one of the choices — use %(list)s"
msgstr "'%(value)s' không nằm trong các lựa chọn — hãy dùng %(list)s"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "one of this field's choices"
msgstr "một trong các lựa chọn của trường này"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "'%(value)s' is not a yes or a no — use Yes or No"
msgstr "'%(value)s' không phải Có hoặc Không — hãy dùng Có hoặc Không"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "%s cannot be changed here — it is read-only on the record."
msgstr "%s không thể thay đổi ở đây — trường này chỉ đọc trên hồ sơ."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/pb_records_desk.py:0
msgid "'%(value)s' is not a number — type an amount like 1500000."
msgstr "'%(value)s' không phải là số — hãy gõ số tiền, ví dụ 1500000."

#. module: pb_records
#. odoo-python
