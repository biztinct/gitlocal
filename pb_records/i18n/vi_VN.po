msgstr "Những gì sẽ thay đổi"

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
msgid "This change has already been carried out."
msgstr "Thay đổi này đã được thực hiện rồi."

#. module: pb_records
#. odoo-python
#: code:addons/pb_records/models/records_approval.py:0
