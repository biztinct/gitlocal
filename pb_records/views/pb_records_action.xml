<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The Records Desk as a standalone client action.

        The desk's main door is the People hub's Records lens, but a client
        action RECORD (rather than a bare tag) is what a deep link, the ⌘K
        palette and R3's other doors all need: an action opened by tag alone is
        synthesised on the fly with no name, and anything that later returns
        through a breadcrumb comes back to a crumb labelled "Unnamed" (W98).
    -->
    <record id="action_pb_records_desk" model="ir.actions.client">
        <field name="name">Records Desk</field>
        <field name="tag">pb_records_desk</field>
        <field name="target">current</field>
    </record>

</odoo>
