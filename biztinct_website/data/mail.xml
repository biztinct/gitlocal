<odoo noupdate="1">
    <record id="gmail_server" model="ir.mail_server">
        <field name="name">Biztinct website · Gmail (enter App Password, test, then activate)</field>
        <field name="smtp_host">smtp.gmail.com</field>
        <field name="smtp_port">587</field>
        <field name="smtp_encryption">starttls</field>
        <field name="smtp_user">ash@biztinct.com</field>
        <field name="smtp_debug" eval="False"/>
        <field name="biztinct_contact_only" eval="True"/>
        <field name="sequence">10</field>
        <field name="active" eval="False"/>
    </record>
    <record id="contact_notification_cron" model="ir.cron">
        <field name="name">Biztinct: deliver saved website enquiries</field>
        <field name="model_id" ref="model_biztinct_contact"/>
        <field name="state">code</field>
        <field name="code">model._process_notifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
