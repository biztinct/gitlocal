<odoo>
    <template id="layout" name="Biztinct public layout">
        <t t-raw="'&lt;!DOCTYPE html&gt;'"/>
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title><t t-esc="title"/> | Biztinct</title>
                <meta name="description" t-att-content="description"/>
                <meta name="theme-color" content="#0a0d18"/>
                <meta property="og:type" content="website"/>
                <meta property="og:site_name" content="Biztinct"/>
                <meta property="og:title" t-att-content="title + ' | Biztinct'"/>
                <meta property="og:description" t-att-content="description"/>
                <meta property="og:url" t-att-content="'https://biztinct.com' + request.httprequest.path"/>
                <link rel="canonical" t-att-href="'https://biztinct.com' + request.httprequest.path"/>
                <link rel="icon" type="image/x-icon" href="/biztinct_website/static/src/img/biztinct-original-favicon.ico"/>
                <link rel="preload" href="/biztinct_website/static/src/fonts/manrope-400.ttf" as="font" type="font/ttf" crossorigin="anonymous"/>
                <link rel="stylesheet" href="/biztinct_website/static/src/css/site.css?v=2.2.1"/>
                <link rel="stylesheet" href="/biztinct_website/static/src/css/experience.css?v=2.2.1"/>
                <script defer="defer" src="/biztinct_website/static/src/js/site.js?v=2.2.1"/>
                <script defer="defer" src="/biztinct_website/static/src/js/experience.js?v=2.2.1"/>
                <t t-if="page in ('thanks', 'login')"><meta name="robots" content="noindex, follow"/></t>
            </head>
            <body t-att-class="'page-' + page">
                <div class="scroll-progress" aria-hidden="true"></div>
                <a href="#main" class="skip-link">Skip to content</a>
                <header class="site-header">
                    <div class="shell header-inner">
                        <a class="wordmark" href="/" aria-label="Biztinct home">
                            <img src="/biztinct_website/static/src/img/biztinct-original-logo.png" width="107" height="39" alt="Biztinct"/>
                        </a>
                        <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
                            <span></span><span></span>
                        </button>
                        <nav id="site-nav" class="site-nav" aria-label="Main navigation">
                            <a href="/solutions" t-att-aria-current="'page' if page == 'solutions' else None">Solutions</a>
                            <a href="/approach" t-att-aria-current="'page' if page == 'approach' else None">Our approach</a>
                            <a class="nav-contact" href="/contactus" t-att-aria-current="'page' if page == 'contact' else None">Let’s talk <span aria-hidden="true">↗</span></a>
                        </nav>
                    </div>
                </header>
                <main id="main"><t t-raw="0"/></main>
                <footer class="site-footer">
                    <div class="shell">
                        <div class="footer-top">
                            <div><a class="wordmark" href="/" aria-label="Biztinct home"><img src="/biztinct_website/static/src/img/biztinct-original-logo.png" width="107" height="39" alt="Biztinct"/></a><p>Distinct by design.<br/>Connected by purpose.</p></div>
                            <div class="footer-statement">Good software should<br/>feel like <em>second nature.</em></div>
                            <div class="footer-links"><a href="/solutions">Solutions</a><a href="/approach">Our approach</a><a href="/contactus">Contact</a><a href="mailto:ash@biztinct.com">ash@biztinct.com <span aria-hidden="true">↗</span></a></div>
                        </div>
                        <div class="footer-bottom"><span>© <t t-esc="year"/> Biztinct</span><span>Custom software. Human possibilities.</span><div><a href="/privacy">Privacy</a><a href="https://biztinct.com/web/login">Client login <span aria-hidden="true">↗</span></a></div></div>
                    </div>
                </footer>
            </body>
        </html>
    </template>

