      {
        "code": "VNDAYRATE",
        "name": "Salary per paid day",
        "kind": "money",
        "formula": "IF({VNBASIS}=1,({VNBASE}+{VNRESP}+{VNPOS})/{VNDIVISOR},{VNBASE}+{VNRESP}+{VNPOS})",
        "role": "info",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNBASEHOUR",
        "name": "Basic hourly rate",
        "kind": "money",
        "formula": "IF({VNBASIS}=1,{VNBASE}/{VNDIVISOR},{VNBASE})/{VNHOURSDAY}",
        "role": "info",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNREGULAR",
        "name": "Regular salary",
        "kind": "money",
        "formula": "{VNDAYRATE}*{VNPAIDDAYS}",
        "role": "earning",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNLEAVEPAY",
        "name": "Leave / meal pay",
        "kind": "money",
        "formula": "{VNLEAVEQTY}*{VNLEAVERATE}",
        "role": "earning",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNOTPAY",
        "name": "Normal overtime base pay",
        "kind": "money",
        "formula": "{VNBASEHOUR}*{VNOTHOURS}",
        "role": "earning",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNPREMPAY",
        "name": "Overtime premium pay",
        "kind": "money",
        "formula": "{VNBASEHOUR}*{VNPREMHOURS}",
        "role": "earning",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNSUNPAY",
        "name": "Sunday base pay",
        "kind": "money",
        "formula": "{VNDAYRATE}/{VNHOURSDAY}*{VNSUNDAYHOURS}",
        "role": "earning",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNGROSS",
        "name": "Gross earnings",
        "kind": "money",
        "formula": "{VNATT}+{VNATTPLUS}+{VNHOUSE}+{VNOTHER}+{VNWORK}+{VNMILEAGE}+{VNSAT}+{VNSHIFT}+{VNPROD}+{VNADJUST}+{VNEFF}+{VNSENIOR}+{VNCHILD}+{VNREGULAR}+{VNLEAVEPAY}+{VNOTPAY}+{VNPREMPAY}+{VNSUNPAY}",
        "role": "info",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNATAX",
        "name": "Assessable income in source",
        "kind": "money",
        "formula": "{VNGROSS}-{VNPERSONAL}-{VNOTHERDED}-{VNINS}-{VNPREMPAY}-{VNSUNPAY}-{VNSAT}+{VNTAXCARRY}",
        "role": "info",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNTAXABLE",
        "name": "Taxable income in this view",
        "kind": "money",
        "formula": "IF({VNTAXZERO}=1,0,MAX(0,{VNATAX}-{VNRELIEF}))",
        "role": "info",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "PIT",
        "name": "Income tax",
        "kind": "money",
        "formula": "ROUND(IF({VNTAXABLE}<=10000000,{VNTAXABLE}*0.05,IF({VNTAXABLE}<=30000000,{VNTAXABLE}*0.1-500000,IF({VNTAXABLE}<=60000000,{VNTAXABLE}*0.2-3500000,IF({VNTAXABLE}<=100000000,{VNTAXABLE}*0.3-9500000,{VNTAXABLE}*0.35-14500000)))),-3)",
        "role": "deduction",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNRECOVERYADJUST",
        "name": "Source omission of recovery deduction",
        "kind": "money",
        "formula": "{VNRECOVERY}*(1-{VNRECOVERYUSED})",
        "role": "earning",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNNETRAW",
        "name": "Net pay before rounding",
        "kind": "money",
        "formula": "{VNGROSS}-{VNRECOVERY}*{VNRECOVERYUSED}-{VNUNION}-{VNPERSONAL}-{VNOTHERDED}-{VNINS}-{PIT}-{VNADVANCE}-{VNBANKFEE}+{VNNETADJUST}",
        "role": "info",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNNET",
        "name": "Net pay",
        "kind": "money",
        "formula": "ROUND({VNNETRAW},-3)+{VNROUNDADJUST}",
        "role": "net",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      },
      {
        "code": "VNROUNDING",
        "name": "Rounding adjustment",
        "kind": "money",
        "formula": "{VNNET}-{VNNETRAW}-{VNROUNDADJUST}",
        "role": "earning",
        "lane": "adjustments",
        "destination": "",
        "application": "",
        "required": false
      }
    ]
  }
