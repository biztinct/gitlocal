<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- F113 / T113.2b — Vietnam 2026 FULL statutory pack (B4).
         The engine ships a 2025 baseline (10 items) + a draft 2026 relief pack
         (relief only). The F113 template needs the complete 2026 statutory set
         resolvable at BOTH real seed time and certification time, so this pack
         carries all ten codes at their 2026 values and is PUBLISHED — the
         resolver's "newest-effective published wins" then serves 2026 values to
         every new config, while the certification suite pins version 2026.1 for
         reproducibility.

         ⚠ VERIFY (see report): CAPLO/CAPHI 2026 values carried forward from 2025;
         the 20× reference-level revisions were pending as of mid-2026. -->
    <data noupdate="1">
        <record id="legis_pack_vn_2026" model="hr.formula.legislation.pack">
            <field name="name">Vietnam Statutory Parameters 2026</field>
            <field name="country_code">VN</field>
            <field name="version">2026.1</field>
            <field name="effective_date">2026-01-01</field>
            <field name="authority">Resolution 110/2025/UBTVQH15 (relief) · Law on Social Insurance 58/2014/QH13 (rates/caps)</field>
            <field name="state">published</field>
            <field name="sequence">5</field>
            <field name="description">Complete 2026 Vietnam statutory parameter set: raised personal/dependent relief, SI/HI/UI employee &amp; employer rates and contribution caps. Serves both existing-config rollout (B4) and new-config template seeding (F113).</field>
        </record>

        <record id="legis_2026_deductself" model="hr.formula.legislation.item">
            <field name="pack_id" ref="legis_pack_vn_2026"/>
            <field name="code">DEDUCTSELF</field>
            <field name="label">Personal Income-Tax Relief (self)</field>
            <field name="value">15500000</field>
            <field name="number_format">currency</field>
            <field name="note">Resolution 110/2025 — up from ₫11,000,000</field>
            <field name="sequence">10</field>
        </record>
        <record id="legis_2026_deductdep" model="hr.formula.legislation.item">
            <field name="pack_id" ref="legis_pack_vn_2026"/>
            <field name="code">DEDUCTDEP</field>
            <field name="label">Dependent Tax Relief (each)</field>
            <field name="value">6200000</field>
            <field name="number_format">currency</field>
            <field name="note">Resolution 110/2025 — up from ₫4,400,000</field>
            <field name="sequence">20</field>
        </record>
        <record id="legis_2026_eesi" model="hr.formula.legislation.item">
            <field name="pack_id" ref="legis_pack_vn_2026"/>
            <field name="code">EESI</field>
            <field name="label">Social Insurance — Employee</field>
            <field name="value">0.08</field>
            <field name="number_format">percentage</field>
            <field name="sequence">30</field>
        </record>
        <record id="legis_2026_eehi" model="hr.formula.legislation.item">
