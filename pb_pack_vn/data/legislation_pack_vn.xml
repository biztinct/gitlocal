            <field name="value">0.01</field>
            <field name="number_format">percentage</field>
            <field name="sequence">50</field>
        </record>
        <record id="legis_2026_ersi" model="hr.formula.legislation.item">
            <field name="pack_id" ref="legis_pack_vn_2026"/>
            <field name="code">ERSI</field>
