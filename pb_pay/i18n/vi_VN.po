msgstr "Không tạo được hướng dẫn."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_change.py:0
msgid "The guidance for this person is %(guide)s%%; this is %(pct)s%%."
msgstr "Hướng dẫn cho người này là %(guide)s%%; mức này là %(pct)s%%."

#. module: pb_pay
#: model:res.groups,comment:pb_pay.group_pay_ceo
msgid "The last step of a pay review: approve it so it can be applied."
msgstr "Bước cuối của một đợt xét lương: duyệt để có thể áp dụng."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_change.py:0
#: code:addons/pb_pay/models/pb_pay_review.py:0
msgid "The manager"
msgstr "Quản lý"

#. module: pb_pay
#: model_terms:ir.ui.view,arch_db:pb_pay.view_pb_pay_change_form
