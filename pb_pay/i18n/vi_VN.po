msgstr ""
"Các dòng ngân sách chưa có chỗ để chuyển tới — phần Ngân sách chưa được cập "
"nhật trên cơ sở dữ liệu này."

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/xml/pay_review.xml:0
