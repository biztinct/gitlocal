#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid ""
"Amounts from companies that keep their books in different money are never "
"added together without a rate."
msgstr ""
"Số tiền của các công ty ghi sổ bằng loại tiền khác nhau không bao giờ được "
"cộng gộp khi chưa có tỷ giá."

#. module: pb_pay
#: model_terms:ir.ui.view,arch_db:pb_pay.fairness_statement
msgid "Answer"
msgstr "Câu trả lời"

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/xml/pay.xml:0
msgid ""
"At least 15% under the middle pay of everybody doing\n"
"                            the same job."
msgstr ""
"Thấp hơn ít nhất 15% so với mức lương giữa của những người cùng chức danh."

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/xml/pay.xml:0
msgid ""
"At least 15% under the middle pay of everybody doing\n"
"                            the same job. Names are for a pay manager to see."
msgstr ""
"Thấp hơn ít nhất 15% so với mức lương giữa của những người cùng chức danh. "
"Chỉ người quản lý lương mới thấy tên."

