#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid "\"Paid least for the same work\" means at least %(pct)s%% under the middle pay of everybody in the same job, where at least three people hold it."
msgstr "\"Trả thấp nhất cho cùng một công việc\" nghĩa là thấp hơn ít nhất %(pct)s%% so với mức lương giữa của tất cả những người cùng chức danh, khi có ít nhất ba người giữ chức danh đó."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
