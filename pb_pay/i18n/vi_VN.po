#. module: pb_pay
#: model:ir.model.fields,help:pb_pay.field_hr_contract__pb_position_pct
msgid "0 is the bottom of the band and 100 the top."
msgstr "0 là đáy khoảng lương và 100 là đỉnh."

#. module: pb_pay
#: model:ir.model.fields,help:pb_pay.field_pb_pay_position__position_pct
msgid "0 is the bottom of the band and 100 the top. Below 0 or above 100 means the pay is outside it."
msgstr "0 là đáy khoảng lương và 100 là đỉnh. Dưới 0 hoặc trên 100 nghĩa là mức lương nằm ngoài khoảng."

#. module: pb_pay
#: model:ir.model.fields,help:pb_pay.field_pb_pay_band__level
msgid "1 is the most junior. Levels are this company's own ladder."
msgstr "1 là bậc thấp nhất. Các bậc là thang riêng của công ty này."

#. module: pb_pay
#: model_terms:ir.ui.view,arch_db:pb_pay.fairness_statement
msgid "<span class=\"eyebrow\">PAY FAIRNESS STATEMENT</span>"
msgstr "<span class=\"eyebrow\">BÁO CÁO CÔNG BẰNG TIỀN LƯƠNG</span>"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "A band has a lowest and a highest edge."
msgstr "Một khoảng lương có một mép thấp nhất và một mép cao nhất."

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/xml/pay.xml:0
msgid "A band is the lowest, middle and highest monthly pay\n                            for one level of one kind of work. There is nobody\n                            with an open contract and a job title here yet, so\n                            there is nothing to draw one from — import a\n                            spreadsheet to start."
msgstr "Khoảng lương là mức thấp nhất, mức giữa và mức cao nhất hằng tháng cho một bậc của một loại công việc. Ở đây chưa có ai có hợp đồng đang hiệu lực kèm chức danh, nên chưa có gì để dựng khoảng lương — hãy nhập từ bảng tính để bắt đầu."

#. module: pb_pay
#: model_terms:ir.actions.act_window,help:pb_pay.action_pb_pay_band
msgid "A band is the lowest, middle and highest monthly pay for one level of one job family. The Pay screen can suggest a full set from what you already pay."
msgstr "Khoảng lương là mức thấp nhất, mức giữa và mức cao nhất hằng tháng cho một bậc của một nhóm công việc. Màn hình Lương có thể đề xuất trọn bộ từ mức bạn đang trả."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
msgid "A band needs a highest amount above zero, or nobody can be measured against it."
msgstr "Khoảng lương cần một mức cao nhất lớn hơn không, nếu không thì không ai đo được theo nó."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
msgid "A band reads lowest, middle, highest. On %(band)s the three numbers are not in that order."
msgstr "Khoảng lương đọc theo thứ tự thấp nhất, giữa, cao nhất. Ở %(band)s ba con số không theo thứ tự đó."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid "A comparison is made only where there are at least %(count)s people on each side. Everything smaller says so rather than printing a number nobody should act on."
msgstr "Chỉ so sánh khi mỗi bên có ít nhất %(count)s người. Nhóm nhỏ hơn sẽ nói rõ như vậy thay vì in ra một con số không ai nên hành động theo."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_family.py:0
