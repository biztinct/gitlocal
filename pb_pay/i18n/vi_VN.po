msgstr "Không ghi được mức lương mới."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_change.py:0
msgid ""
"The new pay is the same as the old pay, so there is nothing to send for "
"approval."
msgstr "Mức lương mới giống hệt mức lương cũ, nên không có gì để gửi duyệt."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_change.py:0
msgid "The old pay is back in place."
msgstr "Mức lương cũ đã trở lại."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_retire.py:0
msgid "The old planning module is already gone from this database."
msgstr "Phần lập kế hoạch cũ đã không còn trên cơ sở dữ liệu này."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_retire.py:0
msgid "The old planning module is installed here."
msgstr "Phần lập kế hoạch cũ đang được cài ở đây."

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/js/pay_review.js:0
