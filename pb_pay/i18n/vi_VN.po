#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid ""
"\"Paid least for the same work\" means at least %(pct)s%% under the middle "
"pay of everybody in the same job, where at least three people hold it."
msgstr ""
"\"Trả thấp nhất cho cùng một công việc\" nghĩa là thấp hơn ít nhất %(pct)s%%"
" so với mức lương giữa của tất cả những người cùng chức danh, khi có ít nhất"
" ba người giữ chức danh đó."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
msgid ""
"%(band)s already has a range in force from %(since)s. Two ranges for the "
"same family, level and country cannot cover the same days — end the old one "
"the day before the new one starts."
msgstr ""
"%(band)s đã có một khoảng lương hiệu lực từ %(since)s. Hai khoảng lương cho "
"cùng nhóm công việc, cùng bậc và cùng quốc gia không thể trùng ngày — hãy "
"kết thúc khoảng cũ vào ngày trước khi khoảng mới bắt đầu."

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/js/pay_hub.js:0
msgid "%(bands)s bands and %(jobs)s jobs saved."
msgstr "Đã lưu %(bands)s khoảng lương và %(jobs)s chức danh."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(cell)s is not an amount"
msgstr "%(cell)s không phải là một số tiền"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(code)s is not a country this product runs payroll for"
msgstr "%(code)s không phải là quốc gia mà sản phẩm này tính lương"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(code)s is not a currency on file"
msgstr "%(code)s không phải là loại tiền có trong hệ thống"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(code)s · %(count)s bands"
msgstr "%(code)s · %(count)s khoảng lương"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(cost)s a year to bring %(people)s back in"
msgstr "%(cost)s mỗi năm để đưa %(people)s trở lại trong khoảng"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(cost)s a year would bring everybody back in"
msgstr "%(cost)s mỗi năm sẽ đưa tất cả trở lại trong khoảng"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(count)s above"
msgstr "%(count)s trên khoảng"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(count)s below"
msgstr "%(count)s dưới khoảng"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid "%(count)s companies"
msgstr "%(count)s công ty"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid "%(count)s people"
msgstr "%(count)s người"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid ""
"%(count)s people have no gender on their record, so they are in no "
"comparison above."
msgstr ""
"%(count)s người chưa có giới tính trên hồ sơ, nên không nằm trong bất kỳ so "
"sánh nào ở trên."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid "%(count)s people measured."
msgstr "Đã đo trên %(count)s người."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(family)s · level %(level)s · %(country)s"
msgstr "%(family)s · bậc %(level)s · %(country)s"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(good)s row(s) ready, %(bad)s to fix."
msgstr "%(good)s dòng sẵn sàng, %(bad)s dòng cần sửa."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
msgid ""
"%(job)s is already in %(band)s over those days. A job sits in one band at a "
"time."
msgstr ""
"%(job)s đã nằm trong %(band)s trong những ngày đó. Mỗi chức danh chỉ thuộc "
"một khoảng lương tại một thời điểm."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid ""
"%(job)s is not in a band yet. Put it in one and the suggested offer appears "
"here; until then the best guide is what %(people)s already doing it are "
"paid."
msgstr ""
"%(job)s chưa nằm trong khoảng lương nào. Hãy xếp nó vào một khoảng thì mức "
"đề xuất sẽ hiện ở đây; trước mắt, cơ sở tốt nhất là mức lương của %(people)s"
" đang làm công việc này."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(made)s band(s) saved."
msgstr "Đã lưu %(made)s khoảng lương."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_position.py:0
#: code:addons/pb_pay/models/pb_pay_review.py:0
msgid "%(pct)s%% of the way through the band"
msgstr "Ở mức %(pct)s%% của khoảng lương"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(people)s · %(low)s to %(high)s"
msgstr "%(people)s · %(low)s đến %(high)s"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "%(people)s would sit above the band"
msgstr "%(people)s sẽ nằm trên khoảng lương"

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/js/pay_hub.js:0
msgid "%(rows)s people placed in %(ms)s ms."
msgstr "Đã xếp %(rows)s người trong %(ms)s ms."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid ""
"%(women)s women and %(men)s men, %(compared)s of them in a group big enough "
"to compare."
msgstr ""
"%(women)s nữ và %(men)s nam, trong đó %(compared)s người thuộc nhóm đủ lớn "
"để so sánh."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid "%(women)s women, %(men)s men."
msgstr "%(women)s nữ, %(men)s nam."

#. module: pb_pay
#: model:ir.model.fields,help:pb_pay.field_hr_contract__pb_position_pct
msgid "0 is the bottom of the band and 100 the top."
msgstr "0 là đáy khoảng lương và 100 là đỉnh."

#. module: pb_pay
#: model:ir.model.fields,help:pb_pay.field_pb_pay_position__position_pct
msgid ""
"0 is the bottom of the band and 100 the top. Below 0 or above 100 means the "
"pay is outside it."
msgstr ""
"0 là đáy khoảng lương và 100 là đỉnh. Dưới 0 hoặc trên 100 nghĩa là mức "
"lương nằm ngoài khoảng."

#. module: pb_pay
#: model:ir.model.fields,help:pb_pay.field_pb_pay_band__level
msgid "1 is the most junior. Levels are this company's own ladder."
msgstr "1 là bậc thấp nhất. Các bậc là thang riêng của công ty này."

#. module: pb_pay
#: model_terms:ir.ui.view,arch_db:pb_pay.fairness_statement
msgid "<span class=\"eyebrow\">PAY FAIRNESS STATEMENT</span>"
msgstr "<span class=\"eyebrow\">BÁO CÁO CÔNG BẰNG TIỀN LƯƠNG</span>"

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "A band has a lowest and a highest edge."
msgstr "Một khoảng lương có một mép thấp nhất và một mép cao nhất."

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/xml/pay.xml:0
msgid ""
"A band is the lowest, middle and highest monthly pay\n"
"                            for one level of one kind of work. There is nobody\n"
"                            with an open contract and a job title here yet, so\n"
"                            there is nothing to draw one from — import a\n"
"                            spreadsheet to start."
msgstr ""
"Khoảng lương là mức thấp nhất, mức giữa và mức cao nhất hằng tháng cho một "
"bậc của một loại công việc. Ở đây chưa có ai có hợp đồng đang hiệu lực kèm "
"chức danh, nên chưa có gì để dựng khoảng lương — hãy nhập từ bảng tính để "
"bắt đầu."

#. module: pb_pay
#: model_terms:ir.actions.act_window,help:pb_pay.action_pb_pay_band
msgid ""
"A band is the lowest, middle and highest monthly pay for one level of one "
"job family. The Pay screen can suggest a full set from what you already pay."
msgstr ""
"Khoảng lương là mức thấp nhất, mức giữa và mức cao nhất hằng tháng cho một "
"bậc của một nhóm công việc. Màn hình Lương có thể đề xuất trọn bộ từ mức bạn"
" đang trả."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
msgid ""
"A band needs a highest amount above zero, or nobody can be measured against "
"it."
msgstr ""
"Khoảng lương cần một mức cao nhất lớn hơn không, nếu không thì không ai đo "
"được theo nó."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
msgid ""
"A band reads lowest, middle, highest. On %(band)s the three numbers are not "
"in that order."
msgstr ""
"Khoảng lương đọc theo thứ tự thấp nhất, giữa, cao nhất. Ở %(band)s ba con số"
" không theo thứ tự đó."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_fairness.py:0
msgid ""
"A comparison is made only where there are at least %(count)s people on each "
"side. Everything smaller says so rather than printing a number nobody should"
" act on."
msgstr ""
"Chỉ so sánh khi mỗi bên có ít nhất %(count)s người. Nhóm nhỏ hơn sẽ nói rõ "
"như vậy thay vì in ra một con số không ai nên hành động theo."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_family.py:0
msgid "A job family needs a name."
msgstr "Nhóm công việc cần có tên."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_band.py:0
msgid "A level runs from 1 to %(top)s."
msgstr "Bậc chạy từ 1 đến %(top)s."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_bands.py:0
msgid "A manager paid less"
msgstr "Quản lý được trả thấp hơn"

#. module: pb_pay
#. odoo-javascript
#: code:addons/pb_pay/static/src/xml/pay.xml:0
msgid ""
"A spreadsheet with one band per row: job family,\n"
"                            level, country, currency, lowest, middle, highest,\n"
"                            and the dates it is in force. Export first if you\n"
"                            want the exact columns."
msgstr ""
"Một bảng tính, mỗi dòng một khoảng lương: nhóm công việc, bậc, quốc gia, "
"loại tiền, thấp nhất, giữa, cao nhất và các ngày hiệu lực. Hãy xuất ra trước"
" nếu bạn muốn đúng các cột."

#. module: pb_pay
#. odoo-python
#: code:addons/pb_pay/models/pb_pay_position.py:0
#: code:addons/pb_pay/models/pb_pay_review.py:0
#: model:ir.model.fields.selection,name:pb_pay.selection__pb_pay_guidance_cell__position_band__above
msgid "Above the band"
msgstr "Trên khoảng lương"

