<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ==================================================================
         WHO MAY SEE A PROPOSED BAND CHANGE.

         A seat is also a read (ledger AM60): the engine re-checks
         `check_access('read')` before it lets anybody decide, and the head of
         pay a band route names may hold no pay role on this module.

         The wide rule ships WITH the narrow one and never without — rules are
         OR-ed over the groups a person is in, and a pay manager is also a
         plain internal user.
         ================================================================== -->

    <record id="rule_bands_proposal_seat" model="ir.rule">
        <field name="name">Pay band change: the ones I was asked to decide</field>
        <field name="model_id" ref="model_pb_bands_proposal"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|',
            ('seat_user_ids', 'in', [user.id]),
            ('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_bands_proposal_pay" model="ir.rule">
        <field name="name">Pay band change: the pay team</field>
        <field name="model_id" ref="model_pb_bands_proposal"/>
        <field name="groups" eval="[
            (4, ref('pb_pay.group_pay_manager')),
            (4, ref('pb_pay.group_pay_viewer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
