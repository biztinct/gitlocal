<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         TWO TIERS, and the line between them is NAMES.

         Looking at the bands and at whether pay is fair is part of running a
         people function: an HR manager gets it without being given anything.
         Seeing WHO is paid least for the same work, and moving a band, is a
         pay manager's act — a fairness screen must never become a way to read
         your colleagues' salaries one name at a time.
         ================================================================== -->

    <record id="module_category_pay" model="ir.module.category">
        <field name="name">Pay bands and fairness</field>
        <field name="sequence">54</field>
    </record>

    <record id="res_groups_privilege_pay" model="res.groups.privilege">
        <field name="name">Pay bands and fairness</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_pay"/>
    </record>

    <record id="group_pay_viewer" model="res.groups">
        <field name="name">See the pay bands</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pay"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Look at the pay bands, the health cards and the fairness figures, without the names behind them.</field>
    </record>

    <record id="group_pay_manager" model="res.groups">
        <field name="name">Set the pay bands</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pay"/>
        <field name="implied_ids" eval="[(4, ref('pb_pay.group_pay_viewer'))]"/>
        <field name="comment">Write and move pay bands, put jobs in them, import them, and see who is paid least for the same work.</field>
    </record>

    <!-- Additive: this only ADDS an implication to groups somebody else owns. -->
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pb_pay.group_pay_viewer'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pb_pay.group_pay_manager'))]"/>
    </record>

<data noupdate="1">

    <!-- A band may be written for a whole country, so a band with no company
         named is everybody's; one that names companies belongs to them. -->
    <record id="rule_band_job_company" model="ir.rule">
        <field name="name">Job in a pay band: company</field>
        <field name="model_id" ref="model_pb_pay_band_job"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- A position is a fact about one company's own contract. -->
    <record id="rule_position_company" model="ir.rule">
        <field name="name">Position in band: company</field>
        <field name="model_id" ref="model_pb_pay_position"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</data>
</odoo>
