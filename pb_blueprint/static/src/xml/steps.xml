<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ==========================================================
       STEP 1 — Start. The only step that creates anything.
       ========================================================== -->
  <t t-name="pb_blueprint.StepStart">
    <div class="pbbp-step">
      <div class="pbbp-step-head">
        <span class="pbbp-eyebrow" t-esc="meta.eyebrow"/>
        <h1 class="pbbp-h1" t-esc="meta.title"/>
        <p class="pbbp-lead" t-esc="meta.lead"/>
      </div>

      <!-- The draft could not be created: the reason, and one button. -->
      <div class="pbbp-alert is-err" t-if="props.error">
        <span class="i" t-out="ic('alert', 18)"/>
        <div>
          <b>The configuration was not created</b>
          <p t-esc="props.error"/>
          <p class="pbbp-alert-sub">Nothing was saved, so nothing needs cleaning up.</p>
        </div>
        <button class="pbim-btn ghost pbim-btn-sm" t-on-click="() => this.props.onRetry()">
          <t t-out="ic('rotate', 14)"/> Try again
        </button>
      </div>

      <!-- ================ Identity ================ -->
      <section t-attf-class="pbbp-card {{ props.busy ? 'is-dimmed' : '' }}">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('idCard', 18)"/>
          <div>
            <h2>Identity</h2>
            <p>What this configuration is called, and the shape of the pay run it drives.</p>
          </div>
        </header>

        <div class="pbbp-fields">
          <div class="pbbp-field">
            <label>Company</label>
            <span class="pbbp-chip-ro">
              <t t-out="ic('building', 14)"/><t t-esc="props.company"/>
            </span>
            <small>Switch company in the top bar.</small>
          </div>

          <div class="pbbp-field">
            <label for="pbbp-name">Configuration name <span class="req">required</span></label>
            <input id="pbbp-name" type="text" t-ref="name"
                   placeholder="Vietnam · Monthly payroll"
                   t-att-value="props.form.name"
                   t-att-class="props.nameError ? 'is-bad' : ''"
                   t-att-aria-invalid="props.nameError ? 'true' : 'false'"
                   t-on-input="(ev) => this.onField('name', ev)"/>
            <small class="pbbp-err" t-if="props.nameError" t-esc="props.nameError"/>
            <small t-else="">People will search for this name. Say where and who it pays.</small>
          </div>

          <div class="pbbp-field">
            <label for="pbbp-country">Country</label>
            <select id="pbbp-country" t-if="!props.created"
                    t-on-change="(ev) => this.onField('country_code', ev)">
              <option t-foreach="props.countries" t-as="c" t-key="c.code"
                      t-att-value="c.code" t-att-selected="c.code === props.form.country_code"
                      t-esc="c.label"/>
            </select>
            <div class="pbbp-locked" t-else="">
              <span t-esc="countryLabel"/>
              <button class="pbbp-changelink" t-on-click="() => this.props.onUnlock('country')">Change</button>
            </div>
            <small>Decides the currency, the statutory rules and how people are matched.</small>
          </div>

          <div class="pbbp-field">
            <label for="pbbp-cycle">Pay cycle</label>
            <select id="pbbp-cycle" t-on-change="(ev) => this.onField('cycle_type', ev)">
              <option t-foreach="props.cycles" t-as="cy" t-key="cy.value"
                      t-att-value="cy.value" t-att-selected="cy.value === props.form.cycle_type"
                      t-esc="cy.label"/>
            </select>
            <small>A regular monthly payroll, an advance, the closing run, or a leaver's last pay.</small>
          </div>

          <div class="pbbp-field">
            <label for="pbbp-eff">Effective from</label>
            <input id="pbbp-eff" type="date" t-att-value="props.form.effective_from"
                   t-on-change="(ev) => this.onField('effective_from', ev)"/>
            <small>The first pay period this configuration is meant for.</small>
          </div>
        </div>

        <!-- Creation progress: three real facts, ticked as they land. -->
        <ol class="pbbp-progress" t-if="props.progress.length">
          <li t-foreach="props.progress" t-as="p" t-key="p.label"
              t-attf-class="{{ p.done ? 'is-done' : '' }}">
            <span class="k" t-if="p.done" t-out="ic('check', 13)"/>
            <span class="k is-spin" t-else=""/>
            <t t-esc="p.label"/>
          </li>
        </ol>
      </section>

      <!-- ================ Starting point ================ -->
      <section t-attf-class="pbbp-card {{ props.busy ? 'is-dimmed' : '' }}">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('layers', 18)"/>
          <div>
            <h2>How would you like to start?</h2>
            <p>A ready-made library, your own workbook, or nothing at all.</p>
          </div>
        </header>

        <p class="pbbp-note is-warn" t-if="noStarterNote" t-esc="noStarterNote"/>

        <div class="pbbp-starters">
          <button t-foreach="starters" t-as="s" t-key="s.key"
                  t-attf-class="pbbp-starter {{ s.key === props.form.template_key ? 'is-on' : '' }}"
                  t-att-aria-pressed="s.key === props.form.template_key ? 'true' : 'false'"
                  t-on-click="() => this.props.onPickStarter(s.key)">
            <span class="pbbp-starter-top">
              <span class="pbbp-starter-ic" t-out="ic(starterIcon(s), 18)"/>
              <span class="pbbp-starter-chk" t-if="s.key === props.form.template_key"
                    t-out="ic('check', 14)"/>
            </span>
            <span class="pbbp-starter-nm" t-esc="s.name"/>
            <span class="pbbp-starter-badges" t-if="s.kind === 'template'">
              <span t-if="s.certified" class="pbim-badge ok">Certified</span>
              <span t-else="" class="pbim-badge muted">Draft</span>
              <span class="pbbp-starter-meta" t-esc="starterMeta(s)"/>
            </span>
            <span class="pbbp-starter-counts" t-if="s.kind === 'template'" t-esc="starterCounts(s)"/>
            <span class="pbbp-starter-desc" t-esc="s.desc"/>
          </button>
        </div>

        <p class="pbbp-note" t-if="starterNote" t-esc="starterNote"/>
      </section>

      <!-- ================ Who are you paying ================ -->
      <section class="pbbp-card">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('users', 18)"/>
          <div>
            <h2>Who are you paying?</h2>
            <p>Pick every group that applies. It decides which components and which sample
               people the next steps offer you.</p>
          </div>
        </header>

        <div class="pbbp-tiles">
          <button t-foreach="AUDIENCES" t-as="a" t-key="a.key"
                  t-attf-class="pbbp-tile {{ has(props.situations.audiences, a.key) ? 'is-on' : '' }}"
                  t-att-aria-pressed="has(props.situations.audiences, a.key) ? 'true' : 'false'"
                  t-on-click="() => this.props.onToggleAudience(a.key)">
            <span class="pbbp-tile-ic" t-out="ic(a.icon, 18)"/>
            <span class="pbbp-tile-t">
              <b t-esc="a.label"/>
              <small t-esc="a.hint"/>
            </span>
            <span class="pbbp-tile-chk" t-if="has(props.situations.audiences, a.key)"
                  t-out="ic('check', 14)"/>
          </button>
        </div>
      </section>

      <!-- ================ Real life ================ -->
      <section class="pbbp-card">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('calendar', 18)"/>
          <div>
            <h2>Real life belongs in the design</h2>
            <p>The months that are not ordinary. Tick them now and the next steps bring them up
               instead of leaving them to be discovered on payday.</p>
          </div>
        </header>

        <div class="pbbp-checks">
          <label t-foreach="REALLIFE" t-as="r" t-key="r.key" class="pbbp-check">
            <input type="checkbox" t-att-checked="has(props.situations.reallife, r.key)"
                   t-on-change="() => this.props.onToggleReallife(r.key)"/>
            <span class="pbbp-check-t">
              <b t-esc="r.label"/>
              <small t-esc="r.hint"/>
            </span>
          </label>
        </div>
      </section>
    </div>
  </t>

  <!-- ==========================================================
       STEP 6 — Finish.
       ========================================================== -->
  <t t-name="pb_blueprint.StepFinish">
    <div class="pbbp-step pbbp-fin">
      <div class="pbbp-step-head">
        <span class="pbbp-eyebrow" t-esc="meta.eyebrow"/>
        <h1 class="pbbp-h1" t-esc="meta.title"/>
        <p class="pbbp-lead" t-esc="meta.lead"/>
      </div>

      <!-- Loading, a page that could not be read, and the page itself: one
           unbroken chain. Nothing may sit between these siblings, not even a
           comment — it breaks the chain at runtime (BP10). -->
      <div class="pbbp-fin-boot" t-if="state.loading">
        <div class="pbim-spin"/>
        <span>Reading what you built…</span>
      </div>
      <div class="pbbp-alert is-err" t-elif="state.error">
        <span class="i" t-out="ic('alert', 18)"/>
        <div>
          <b>This page could not be read</b>
          <p t-esc="state.error"/>
        </div>
        <button class="pbim-btn ghost pbim-btn-sm" t-on-click="() => this.load()">
          <t t-out="ic('rotate', 14)"/> Try again
        </button>
      </div>
      <t t-else="">

      <!-- A setup that is already complete says so first, and offers the two
           things left to do with it. -->
      <div class="pbbp-fin-done" t-if="finished">
        <span class="i" t-out="ic('checkCheck', 18)"/>
        <div>
          <b>Setup complete</b>
          <p t-esc="finishedNote"/>
        </div>
      </div>

      <div class="pbbp-tilerow" aria-live="polite">
        <div class="pbbp-fintile" t-foreach="tiles" t-as="t" t-key="t.key">
          <span class="pbbp-fintile-ic" t-out="ic(t.icon, 18)"/>
          <b t-esc="t.shown"/>
          <span class="pbbp-fintile-l" t-esc="t.label"/>
          <small t-esc="t.hint"/>
        </div>
      </div>

      <!-- ================ identity ================ -->
      <section class="pbbp-card">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('idCard', 18)"/>
          <div>
            <h2>What you decided</h2>
            <p>Hand this page to somebody else and they can tell what this payroll does.</p>
          </div>
        </header>

        <dl class="pbbp-sum">
          <t t-foreach="rows" t-as="r" t-key="r.key">
            <dt t-esc="r.label"/>
            <dd t-attf-class="{{ r.mono ? 'is-mono' : '' }}" t-esc="r.value"/>
          </t>
        </dl>

        <div class="pbbp-sum-chips" t-if="chips.length">
          <span class="pbbp-eyebrow">You told us about</span>
          <div class="pbim-chips">
            <span class="pbim-chip" t-foreach="chips" t-as="c" t-key="c" t-esc="c"/>
          </div>
        </div>

        <div t-if="pack" t-attf-class="pbbp-fin-pack {{ pack.cls }}">
          <span class="i" t-out="ic('landmark', 15)"/>
          <b t-esc="pack.name"/>
          <span class="pbbp-fin-pack-t" t-esc="pack.text"/>
          <button class="pbbp-changelink" t-if="pack.cls !== 'is-good'"
                  t-on-click="() => this.go({ step: 'rules', tab: 'tax' })">
            Review the values
          </button>
        </div>
      </section>

      <!-- ================ decisions ================ -->
      <section class="pbbp-card">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('userCheck', 18)"/>
          <div>
            <h2>Decisions still need an owner</h2>
            <p t-esc="decisionsNote"/>
          </div>
          <!-- Its own class, not the kit's badge: `.pbim-badge` is
               `text-transform: capitalize`, which is right for a status word
               and wrong for a count — it rendered "8 Open" (BP19, third
               time). -->
          <span class="pbbp-fin-open" t-if="decisionsTotal" t-esc="decisionChip"/>
        </header>

        <div class="pbim-empty is-slim" t-if="!decisions.length">
          <span t-esc="decisionsEmpty"/>
        </div>
        <t t-else="">
          <ul class="pbbp-fin-dec">
            <li t-foreach="decisions" t-as="d" t-key="d.key">
              <span class="pbbp-fin-dec-dot"/>
              <div class="pbbp-fin-dec-t">
                <b>
                  <t t-esc="d.title"/>
                  <code t-if="d.code" t-esc="d.code"/>
                </b>
                <small t-esc="d.text"/>
              </div>
              <button class="pbim-btn ghost pbim-btn-sm" t-on-click="() => this.go(d)"
                      t-att-aria-label="d.action">
                <t t-esc="d.action"/> <t t-out="ic('arrow', 13)"/>
              </button>
            </li>
          </ul>
          <p class="pbim-note" t-if="decisionsMore" t-esc="decisionsMore"/>
        </t>
      </section>

      <!-- ================ checks ================ -->
      <section class="pbbp-card pbbp-fin-checks">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('beaker', 18)"/>
          <div>
            <h2>What has been checked</h2>
            <p>The evidence behind these numbers: which scenarios were run, and whether
               anything has changed since.</p>
          </div>
        </header>

        <div class="pbbp-fin-evi" aria-live="polite">
          <span t-attf-class="pbbp-evi {{ checks.cls }}">
            <span class="i" t-out="ic(checks.icon, 13)"/>
            <span t-esc="checks.text"/>
          </span>
          <span class="pbbp-fin-evi-n" t-if="everRun" t-esc="checksFraction"/>
          <span class="pbbp-fin-evi-w" t-if="checks.last" t-esc="checks.last"/>
          <div class="pbbp-foot-sp"/>
          <button class="pbim-btn ghost pbim-btn-sm"
                  t-on-click="() => this.go({ step: 'test' })">
            <t t-if="everRun">Run the checks again</t>
            <t t-else="">Run the checks</t>
          </button>
        </div>
      </section>

      <!-- ================ optional setup ================ -->
      <section class="pbbp-card">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('layoutList', 18)"/>
          <div>
            <h2>Optional setup</h2>
            <p>None of these has to be finished before you carry on, and each one can be
               changed later from the configuration's settings.</p>
          </div>
        </header>

        <ul class="pbbp-fin-opt">
          <li t-foreach="optional" t-as="o" t-key="o.task">
            <b t-esc="o.label"/>
            <span t-attf-class="pbbp-cn-pill {{ o.pill.cls }}" t-esc="o.pill.label"/>
            <small t-esc="o.detail"/>
            <button class="pbbp-changelink" t-if="o.task !== 'approvals'"
                    t-on-click="() => this.go({ step: 'connect', task: o.task })">
              Change
            </button>
          </li>
        </ul>
      </section>

      <!-- ================ the button ================ -->
      <section class="pbbp-card is-cta">
        <div class="pbbp-fin-cta-t">
          <h2 t-if="finished">This setup is complete</h2>
          <h2 t-else="">Ready when you are</h2>
          <p t-esc="note"/>
          <p class="pbbp-err" t-if="state.refusal" t-esc="state.refusal"/>
        </div>
        <div class="pbbp-fin-cta-b">
          <button class="pbim-btn primary" t-att-disabled="state.busy or !button.enabled"
                  t-att-title="button.reason"
                  t-on-click="onFinish">
            <t t-if="state.busy">Checking…</t>
            <t t-else=""><t t-esc="button.label"/></t>
          </button>
          <button class="pbbp-changelink" t-if="!finished"
                  t-on-click="onDiscard">Discard this draft</button>
          <button class="pbbp-changelink" t-if="finished and editable"
                  t-on-click="onReopen">Revisit the setup</button>
        </div>
      </section>

      <!-- What is left, in words, under the button that refused. Never a toast
           on its own: a reason a person cannot re-read is a reason they lost. -->
      <section class="pbbp-card is-block" t-if="!finished and !gate.ok">
        <header class="pbbp-card-head">
          <span class="pbbp-card-ic" t-out="ic('alert', 18)"/>
          <div>
            <h2 t-esc="blockedHeading"/>
            <p>These are about the numbers themselves, so they are the ones that have to be
               right before the setup can be finished.</p>
          </div>
        </header>
        <ul class="pbbp-fin-block">
          <li t-foreach="gate.reasons" t-as="r" t-key="r.code">
            <span class="i" t-out="ic('alert', 14)"/>
            <span t-esc="r.text"/>
            <button class="pbim-btn ghost pbim-btn-sm" t-if="r.action"
                    t-on-click="() => this.go(r)">
              <t t-esc="r.action"/>
            </button>
          </li>
        </ul>
      </section>
      </t>
    </div>
  </t>

</templates>
