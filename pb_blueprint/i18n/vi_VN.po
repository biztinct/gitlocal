#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:875
msgid "This draft could not be read."
msgstr "Không thể đọc được bản nháp này."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:897
msgid "This draft could not be discarded."
msgstr "Không thể hủy bản nháp này."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:901
msgid "The draft was discarded. Nothing was kept."
msgstr "Bản thảo đã bị loại bỏ. Không có gì được giữ lại."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:926
msgid "Someone else changed this draft."
msgstr "Ai đó đã thay đổi bản nháp này."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_doors.js:32
msgid "Setup"
msgstr "Thiết lập"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_doors.js:41
msgid "Guided setup"
msgstr "Thiết lập có hướng dẫn"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_doors.js:42
msgid ""
"Build a payroll configuration step by step, with a live view of one person's"
" pay."
msgstr ""
"Xây dựng cấu hình bảng lương theo từng bước, với chế độ xem trực tiếp về "
"lương của một người."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_doors.js:48
msgid ""
"Six steps from a starting point to a configuration you can explain — and any"
" setup you left half-finished is on the configurations screen, waiting to be"
" resumed."
msgstr ""
"Sáu bước từ điểm bắt đầu đến cấu hình mà bạn có thể giải thích — và mọi "
"thiết lập bạn chưa hoàn thành nửa chừng đều nằm trên màn hình cấu hình, đang"
" chờ được tiếp tục."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:28
msgid "Start"
msgstr "Bắt đầu"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:29
msgid "Name, starter, who you pay"
msgstr "Tên, người bắt đầu, người bạn trả tiền"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:30
msgid "01 / CHOOSE YOUR STARTING POINT"
msgstr "01/ CHỌN ĐIỂM KHỞI ĐẦU"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:31
msgid "A clear start. A connected payroll."
msgstr "Một sự khởi đầu rõ ràng. Một bảng lương được kết nối."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:32
msgid ""
"Choose how to build this configuration. You can fill in the details now and "
"connect the optional parts whenever you are ready."
msgstr ""
"Chọn cách xây dựng cấu hình này. Bạn có thể điền thông tin chi tiết ngay bây"
" giờ và kết nối các bộ phận tùy chọn bất cứ khi nào bạn sẵn sàng."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:35
msgid "Pay rules"
msgstr "Quy tắc lương"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:36
msgid "Components, tax, calendar"
msgstr "Thành phần, thuế, lịch"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:37
msgid "02 / WHAT GOES INTO PAY"
msgstr "02/ NHỮNG GÌ ĐƯỢC THANH TOÁN"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:38
msgid "Every component. One clear rule."
msgstr "Mọi thành phần. Một quy tắc rõ ràng."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:39
msgid ""
"Each thing a person is paid, and each thing taken off, written as a sentence"
" anyone can read — with the calculation underneath it."
msgstr ""
"Mỗi thứ mà một người được trả, và mỗi thứ được lấy ra, được viết dưới dạng "
"một câu mà ai cũng có thể đọc được - với phép tính bên dưới nó."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:42
msgid "Connect"
msgstr "Kết nối"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:43
msgid "Sources, payslip, approvals"
msgstr "Nguồn, phiếu lương, phê duyệt"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:44
msgid "03 / CONNECT WHAT YOU NEED"
msgstr "03/ KẾT NỐI NHỮNG ĐIỀU BẠN CẦN"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:45
msgid "Connect what you need. Continue when ready."
msgstr "Kết nối những gì bạn cần. Tiếp tục khi đã sẵn sàng."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:46
msgid ""
"These tasks belong to this company and configuration. Set them up here, or "
"skip individually and come back through the configuration's Settings later."
msgstr ""
"Những nhiệm vụ này thuộc về công ty và cấu hình này. Thiết lập chúng ở đây "
"hoặc bỏ qua từng cái một và quay lại phần Cài đặt của cấu hình sau."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:49
msgid "Outputs"
msgstr "Đầu ra"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:50
msgid "Every formula, one table"
msgstr "Mỗi công thức, một bảng"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:51
msgid "04 / EVERY NUMBER, IN THE OPEN"
msgstr "04/ MỌI SỐ, TRONG MỞ"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:52
msgid "Nothing hidden. Nothing assumed."
msgstr "Không có gì ẩn giấu. Không có gì giả định."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:53
msgid ""
"The whole configuration in one table: what each component works out, what it"
" depends on, and what it produces for the sample employee."
msgstr ""
"Toàn bộ cấu hình trong một bảng: mỗi thành phần hoạt động ra sao, nó phụ "
"thuộc vào cái gì và nó tạo ra cái gì cho nhân viên mẫu."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:56
msgid "Test"
msgstr "Kiểm thử"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:57
msgid "Try the days that aren't ordinary"
msgstr "Hãy thử những ngày không bình thường"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:58
msgid "05 / THE DAYS THAT AREN'T ORDINARY"
msgstr "05/ NHỮNG NGÀY KHÔNG THƯỜNG XUYÊN"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:59
msgid "One click. Meaningful checks."
msgstr "Một cú nhấp chuột. Kiểm tra có ý nghĩa."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:60
msgid ""
"A joiner, a leaver, a tax-band edge, a month with no working days. Every "
"awkward case, run through the real engine."
msgstr ""
"Một người thợ mộc, một người bỏ nghề, một người phải nộp thuế, một tháng "
"không có ngày làm việc. Mọi trường hợp khó xử, chạy qua máy thật."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:63
msgid "Finish"
msgstr "Hoàn thành"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:64
msgid "Review and open"
msgstr "Xem xét và mở"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:65
msgid "06 / A CONFIGURATION YOU CAN EXPLAIN"
msgstr "06/ CẤU HÌNH BẠN CÓ THỂ GIẢI THÍCH"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:66
msgid "Ready to review. Built to evolve."
msgstr "Sẵn sàng để xem xét. Được xây dựng để phát triển."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint_steps.js:67
msgid ""
"Everything you decided, in one place — and a configuration you can hand to "
