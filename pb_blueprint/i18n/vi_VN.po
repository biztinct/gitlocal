"[{\"ref\": \"Resolution 110/2025/UBTVQH15\", \"title\": \"Family-"
"circumstance deductions (self 15.5M / dependant 6.2M)\", \"url\": \"\", "
"\"effective_date\": \"2026-01-01\"}, {\"ref\": \"PIT Law 04/2007/QH12\", "
"\"title\": \"Personal income tax \\u2014 seven-band progressive schedule\", "
