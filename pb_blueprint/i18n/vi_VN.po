msgid "Those inputs could not be opened."
msgstr "Những đầu vào đó không thể mở được."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:694
msgid ""
"This configuration has no inputs to adjust yet. Add an input component "
"first."
msgstr ""
"Cấu hình này chưa có đầu vào để điều chỉnh. Thêm thành phần đầu vào trước."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:708
msgid "Those inputs could not be saved."
msgstr "Không thể lưu những thông tin đầu vào đó."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:729
msgid ""
"This removes all %(n)s components and formulas of this draft and adds the "
"%(starter)s ones. Anything you edited by hand is lost."
msgstr ""
"Thao tác này sẽ xóa tất cả các thành phần và công thức %(n)s của bản nháp "
"này và thêm các thành phần và công thức %(starter)s. Mọi thứ bạn chỉnh sửa "
"bằng tay đều bị mất."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:741
msgid "The components could not be replaced."
msgstr "Các thành phần không thể được thay thế."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:751
