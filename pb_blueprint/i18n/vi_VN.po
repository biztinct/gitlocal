msgstr "Các thành phần %s đã sẵn sàng."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:752
msgid "The draft is empty and ready for your own components."
msgstr "Bản nháp trống và sẵn sàng cho các thành phần của riêng bạn."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/js/blueprint.js:766
msgid "Import from Excel"
msgstr "Nhập từ Excel"

