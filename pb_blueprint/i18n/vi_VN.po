msgstr "Quy tắc này đã được chỉnh sửa bằng tay."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
msgid ""
"The sentence below is the last guided version. Bringing it back replaces the"
" typed calculation; your Excel is kept in the history."
msgstr ""
"Câu dưới đây là phiên bản hướng dẫn cuối cùng. Đưa nó trở lại sẽ thay thế "
"phép tính đã gõ; Excel của bạn được lưu giữ trong lịch sử."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
msgid "For"
msgstr "Cho"

#. module: pb_blueprint
#. odoo-javascript
