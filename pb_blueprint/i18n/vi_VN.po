msgstr "Hủy bỏ"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/pay_preview.xml:1
msgid "Save and recalculate"
msgstr "Lưu và tính toán lại"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
msgid "Opening the rule…"
msgstr "Mở quy tắc…"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
msgid "Somebody else changed this configuration"
msgstr "Ai đó đã thay đổi cấu hình này"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
msgid "Show me their version"
msgstr "Cho tôi xem phiên bản của họ"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
msgid "Site allowance"
msgstr "phụ cấp địa điểm"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
msgid "Short code"
msgstr "Mã ngắn"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
msgid "Where it belongs"
msgstr "Nơi nó thuộc về"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/static/src/xml/sentence_editor.xml:1
