#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/data/config_template_vn_complete.xml:1
msgid ""
"Everything a Vietnamese monthly payroll normally needs, with a plain "
"sentence behind every line: paid salary and proration, allowances and "
"incentives, four kinds of overtime, thirteenth-month pay, social, health and"
" unemployment insurance for employee and employer, union dues, private "
"health cover, prior-period corrections, and income tax by the route that "
"applies to the person. Statutory values come from the Vietnam rule pack and "
"can be reviewed and changed during setup."
msgstr ""
"Mọi thứ mà một bảng lương hàng tháng của Việt Nam thường cần, với một câu rõ"
" ràng đằng sau mỗi dòng: tiền lương được trả và tỷ lệ, phụ cấp và khuyến "
"khích, bốn loại tiền làm thêm giờ, lương tháng thứ mười ba, bảo hiểm xã hội,"
" y tế và thất nghiệp cho người lao động và người sử dụng lao động, phí công "
"đoàn, bảo hiểm y tế tư nhân, các khoản điều chỉnh trước kỳ và thuế thu nhập "
"theo lộ trình áp dụng cho cá nhân. Các giá trị theo luật định được lấy từ "
"gói quy tắc của Việt Nam và có thể được xem xét cũng như thay đổi trong quá "
"trình thiết lập."

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/data/config_template_vn_complete.xml:1
msgid ""
"[{\"code\": \"VNTAX\", \"name\": \"Vietnam income tax (monthly, seven "
"bands)\", \"note\": \"Progressive marginal schedule. Editable on the Tax and"
" protection tab of the guided setup.\", \"legislation_ref\": \"PIT Law "
"04/2007/QH12 (Circular 111/2013/TT-BTC schedule)\", \"brackets\": "
"[{\"lower\": 0, \"rate\": 0.05}, {\"lower\": 5000000, \"rate\": 0.1}, "
"{\"lower\": 10000000, \"rate\": 0.15}, {\"lower\": 18000000, \"rate\": 0.2},"
" {\"lower\": 32000000, \"rate\": 0.25}, {\"lower\": 52000000, \"rate\": "
"0.3}, {\"lower\": 80000000, \"rate\": 0.35}]}]"
msgstr ""
"[{\"code\": \"VNTAX\", \"name\": \"Thuế thu nhập Việt Nam (hàng tháng, bảy "
"dải)\", \"note\": \"Biểu đồ cận biên lũy tiến. Có thể chỉnh sửa trên tab "
"Thuế và bảo vệ của thiết lập được hướng dẫn.\", \"legslation_ref\": \"Luật "
"thuế TNCN 04/2007/QH12 (Thông tư 111/2013/TT-BTC biểu)\", \"ngoặc\": "
"[{\"thấp hơn\": 0, \"tỷ lệ\": 0,05}, {\"thấp hơn\": 5000000, \"tỷ lệ\": "
"0,1}, {\"thấp hơn\": 10000000, \"tỷ lệ\": 0,15}, {\"thấp hơn\": 18000000, "
"\"tỷ lệ\": 0,2}, {\"thấp hơn\": 32000000, \"tỷ lệ\": 0,25}, {\"thấp hơn\": "
"52000000, \"tỷ lệ\": 0,3}, {\"thấp hơn\": 80000000, \"tỷ lệ\": 0,35}]}]"

#. module: pb_blueprint
#. odoo-javascript
#: code:addons/pb_blueprint/data/config_template_vn_complete.xml:1
