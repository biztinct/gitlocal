<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Past-month re-work board (a lens of the Payroll hub, and its own
         page). A named action RECORD, so a deep link and a breadcrumb back to
         it have a name. -->
    <record id="action_pb_retro_board" model="ir.actions.client">
        <field name="name">Past-month re-work</field>
        <field name="tag">pb_retro_board</field>
        <field name="target">current</field>
    </record>

    <!-- ================================================================
         Native views: an off-menu fallback for administrators. The board
         is the screen. Nothing here can type a figure: every result row is
         written by the working-out only.
         ================================================================ -->
    <record id="view_pb_retro_review_list" model="ir.ui.view">
        <field name="name">pb.retro.review.list</field>
        <field name="model">pb.retro.review</field>
        <field name="arch" type="xml">
            <list string="Past-month re-work" create="0" edit="0">
                <field name="name"/>
                <field name="config_id"/>
                <field name="month_from"/>
                <field name="month_to"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'done'"
                       decoration-success="state == 'closed'"
                       decoration-warning="state == 'draft'"/>
                <field name="worked_out_on"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pb_retro_review_form" model="ir.ui.view">
        <field name="name">pb.retro.review.form</field>
        <field name="model">pb.retro.review</field>
        <field name="arch" type="xml">
            <form string="Past-month re-work" create="0" edit="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="What it covers">
                            <field name="config_id"/>
                            <field name="month_from"/>
                            <field name="month_to"/>
                            <field name="people"/>
                            <field name="employee_ids" widget="many2many_tags"
                                   invisible="people != 'picked'"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Worked out">
                            <field name="worked_out_on"/>
                            <field name="worked_out_by"/>
                            <field name="closed_on" invisible="not closed_on"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Why">
                        <field name="reason" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Differences" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="employee_id"/>
                                    <field name="month"/>
                                    <field name="name"/>
                                    <field name="was"/>
                                    <field name="would_be"/>
                                    <field name="diff"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payslips" name="slips">
                            <field name="slip_ids" readonly="1">
                                <list>
                                    <field name="employee_name"/>
                                    <field name="month"/>
                                    <field name="run_name"/>
                                    <field name="status"/>
                                    <field name="diff_net"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pb_retro_review" model="ir.actions.act_window">
        <field name="name">Past-month re-work</field>
        <field name="res_model">pb.retro.review</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
