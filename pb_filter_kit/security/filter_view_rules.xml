<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Saved views (owner ruling 2026-10-30): private to whoever saved them,
         unless they switch "Share with everyone" on. Group rules OR together,
         so for READ only the first rule applies (own or shared), for
         write/create/delete only the second (own). Settings admins may tidy
         up anything. -->
    <record id="rule_pb_filter_view_read" model="ir.rule">
        <field name="name">Saved views: read your own and the shared ones</field>
        <field name="model_id" ref="model_pb_filter_view"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('shared', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_pb_filter_view_own" model="ir.rule">
        <field name="name">Saved views: change only your own</field>
        <field name="model_id" ref="model_pb_filter_view"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_pb_filter_view_admin" model="ir.rule">
        <field name="name">Saved views: settings admins tidy any view</field>
        <field name="model_id" ref="model_pb_filter_view"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
