<!-- =================================================================
     SOLUTION OPTIONS FOR INCREASING PREVIEW_DATA WIDTH
     ================================================================= -->

<!-- OPTION 1: FULL-WIDTH WITH CUSTOM CSS CLASS (RECOMMENDED) -->
<!-- Preview Section -->
<group string="Export Preview" attrs="{'invisible': [('preview_data', '=', False)]}">
    <div class="alert alert-success">
        <h5><i class="fa fa-check"/> Export Preview Ready</h5>
        <p>Found <strong><field name="preview_record_count" readonly="1"/></strong> employees with total amount of <strong><field name="preview_total_amount" widget="monetary" readonly="1"/></strong></p>
    </div>
    <field name="preview_data" widget="text" readonly="1" 
           class="o_field_text_full_width" 
           style="width: 100%; min-width: 800px; min-height: 300px; font-family: monospace;"/>
</group>

<!-- Add this CSS in your view or as a separate CSS file -->
<style>
    .o_field_text_full_width {
        width: 100% !important;
        min-width: 800px !important;
        min-height: 300px !important;
        max-width: none !important;
        font-family: 'Courier New', monospace !important;
        font-size: 12px !important;
        resize: both !important;
    }
    
    .o_field_text_full_width textarea {
        width: 100% !important;
        min-width: 800px !important;
        min-height: 300px !important;
        resize: both !important;
    }
</style>

<!-- =================================================================== -->

<!-- OPTION 2: REMOVE GROUP STRUCTURE FOR FULL WIDTH -->
<!-- Preview Section -->
<separator string="Export Preview" attrs="{'invisible': [('preview_data', '=', False)]}"/>
<div attrs="{'invisible': [('preview_data', '=', False)]}">
    <div class="alert alert-success">
        <h5><i class="fa fa-check"/> Export Preview Ready</h5>
        <p>Found <strong><field name="preview_record_count" readonly="1"/></strong> employees with total amount of <strong><field name="preview_total_amount" widget="monetary" readonly="1"/></strong></p>
    </div>
    <field name="preview_data" widget="text" readonly="1" 
           nolabel="1"
           style="width: 100%; min-width: 900px; min-height: 400px; font-family: monospace; font-size: 12px;"/>
</div>

<!-- =================================================================== -->

<!-- OPTION 3: USE NOTEBOOK PAGE FOR MAXIMUM SPACE -->
<notebook attrs="{'invisible': [('preview_data', '=', False)]}">
    <page string="Export Preview" name="preview_page">
        <div class="alert alert-success">
            <h5><i class="fa fa-check"/> Export Preview Ready</h5>
            <p>Found <strong><field name="preview_record_count" readonly="1"/></strong> employees with total amount of <strong><field name="preview_total_amount" widget="monetary" readonly="1"/></strong></p>
        </div>
        <field name="preview_data" widget="text" readonly="1" 
               nolabel="1"
               style="width: 100%; min-width: 1000px; min-height: 500px; font-family: monospace; font-size: 11px; resize: both;"/>
    </page>
</notebook>

<!-- =================================================================== -->

<!-- OPTION 4: CUSTOM DIV WITH PRECISE CONTROL -->
<!-- Preview Section -->
<group string="Export Preview" attrs="{'invisible': [('preview_data', '=', False)]}" col="1">
    <div class="alert alert-success">
        <h5><i class="fa fa-check"/> Export Preview Ready</h5>
        <p>Found <strong><field name="preview_record_count" readonly="1"/></strong> employees with total amount of <strong><field name="preview_total_amount" widget="monetary" readonly="1"/></strong></p>
    </div>
    <div style="width: 100%; margin: 10px 0;">
        <field name="preview_data" widget="text" readonly="1" 
               nolabel="1"
               style="width: 100%; min-width: 95vw; min-height: 350px; font-family: 'Courier New', monospace; font-size: 12px; border: 1px solid #ccc; padding: 10px; background-color: #f8f9fa; overflow: auto; white-space: pre; resize: both;"/>
    </div>
</group>

<!-- =================================================================== -->

<!-- OPTION 5: FULL VIEWPORT WIDTH WITH SCROLLING -->
<!-- Preview Section -->
<group string="Export Preview" attrs="{'invisible': [('preview_data', '=', False)]}">
    <div class="alert alert-success">
        <h5><i class="fa fa-check"/> Export Preview Ready</h5>
        <p>Found <strong><field name="preview_record_count" readonly="1"/></strong> employees with total amount of <strong><field name="preview_total_amount" widget="monetary" readonly="1"/></strong></p>
    </div>
    <field name="preview_data" widget="html" readonly="1" 
           style="width: 98vw; min-height: 400px; margin-left: -20px; margin-right: -20px;"/>
</group>

