<!-- RECOMMENDED SOLUTION: OPTION 1 WITH ENHANCED STYLING -->
<group string="Export Preview" attrs="{'invisible': [('preview_data', '=', False)]}" col="1">
    <div class="alert alert-success" style="margin-bottom: 15px;">
        <h5><i class="fa fa-check-circle"/> Export Preview Ready</h5>
        <p>Found <strong><field name="preview_record_count" readonly="1"/></strong> employees with total amount of <strong><field name="preview_total_amount" widget="monetary" readonly="1"/></strong></p>
    </div>
    <div class="preview_data_container">
        <label class="o_form_label" style="margin-bottom: 8px; display: block; font-weight: bold;">Bank Export Data:</label>
        <field name="preview_data" widget="text" readonly="1" 
               nolabel="1"
               class="preview_data_field"/>
    </div>
</group>

<style>
    .preview_data_container {
        width: 100%;
        margin: 10px 0;
    }
    
    .preview_data_field {
        width: 100% !important;
        min-width: 900px !important;
        min-height: 400px !important;
        max-width: none !important;
        font-family: 'Courier New', 'Monaco', 'Menlo', monospace !important;
        font-size: 12px !important;
        line-height: 1.4 !important;
        border: 1px solid #dee2e6 !important;
        border-radius: 4px !important;
        padding: 12px !important;
        background-color: #f8f9fa !important;
        color: #495057 !important;
        resize: both !important;
        overflow: auto !important;
        white-space: pre !important;
    }
    
    .preview_data_field:focus {
        border-color: #007bff !important;
        box-shadow: 0 0 0 0.2rem rgba(0,123,255,0.25) !important;
    }
    
    /* Ensure the field expands in the form */
    .o_form_sheet .preview_data_container .preview_data_field {
        width: calc(100% - 0px) !important;
    }
</style>

