<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- A seat is also a read (ledger AM60). The finance controller a rate
         route names holds no group role, and the engine re-checks
         `check_access('read')` before it lets anybody decide. The wide rule
         ships with the narrow one: rules are OR-ed over a person's groups,
         and a group administrator is also a plain internal user. -->

    <record id="rule_fx_proposal_seat" model="ir.rule">
        <field name="name">Rate change: the ones I was asked to decide</field>
        <field name="model_id" ref="model_pb_fx_proposal"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|',
            ('seat_user_ids', 'in', [user.id]),
            ('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_fx_proposal_admin" model="ir.rule">
        <field name="name">Rate change: the group administrators</field>
        <field name="model_id" ref="model_pb_fx_proposal"/>
        <field name="groups" eval="[(4, ref('pb_group.group_group_admin'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
