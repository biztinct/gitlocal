#. odoo-javascript
#: code:addons/pb_group/static/src/js/group_room.js:0
msgid "%(month)s: the newest rate is from %(date)s. Click to add one."
msgstr "%(month)s: tỷ giá mới nhất là từ %(date)s. Bấm để thêm một tỷ giá."

