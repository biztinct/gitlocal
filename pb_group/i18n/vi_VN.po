#. module: pb_group
#. odoo-python
#: code:addons/pb_group/models/pb_fx.py:0
msgid ""
"Nobody has told this system what one %(src)s is worth in %(dst)s in "
"%(month)s, so these figures stay in %(src)s. Add an exchange rate and the "
"group figure appears."
msgstr ""
"Chưa ai cho hệ thống biết 1 %(src)s bằng bao nhiêu %(dst)s trong %(month)s, "
"nên các số này vẫn để bằng %(src)s. Thêm một tỷ giá và con số của tập đoàn "
"sẽ hiện ra."

#. module: pb_group
#. odoo-javascript
#: code:addons/pb_group/static/src/js/group_room.js:0
msgid "%(company)s pays joiners and leavers a full month, as before."
msgstr ""
"%(company)s vẫn trả đủ cả tháng cho người mới vào và người nghỉ việc, như "
"trước."

#. module: pb_group
#. odoo-javascript
#: code:addons/pb_group/static/src/js/group_room.js:0
msgid ""
"%(company)s will pay joiners and leavers for the days they work, from the "
"next pay run."
msgstr ""
"Từ kỳ trả lương tới, %(company)s sẽ trả cho người mới vào và người nghỉ việc"
" theo đúng số ngày họ làm."

#. module: pb_group
#. odoo-python
#: code:addons/pb_group/models/pb_division.py:0
msgid ""
"%(department)s is already in %(division)s from %(since)s. A department can "
"only be in one division at a time — give the first one an end date, or start"
" this one later."
msgstr ""
"%(department)s đã thuộc %(division)s từ %(since)s. Một phòng ban chỉ thuộc "
"một khối tại một thời điểm — hãy đặt ngày kết thúc cho lần gắn trước, hoặc "
"cho lần này bắt đầu muộn hơn."

#. module: pb_group
#. odoo-python
#: code:addons/pb_group/models/pb_group_room.py:0
msgid ""
"%(department)s joined %(division)s on %(since)s. Pick that day or a later "
"one to take it out."
msgstr ""
"%(department)s vào %(division)s ngày %(since)s. Hãy chọn đúng ngày đó hoặc "
"một ngày sau đó để tách ra."

