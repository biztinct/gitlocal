<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View for Employee Payroll Details -->
    <record id="view_hr_payroll_employee_detail_tree" model="ir.ui.view">
        <field name="name">hr.payroll.employee.detail.tree</field>
        <field name="model">hr.payroll.employee.detail</field>
        <field name="arch" type="xml">
            <list string="Employee Payroll Details" create="false" edit="false" decoration-info="True">
                <field name="department_name" string="Department"/>
                <field name="employee_name"/>
                <field name="month_name"/>
                <field name="basic_salary" sum="Total Basic"/>
                <field name="allowances" sum="Total Allowances"/>
                <field name="contributions" sum="Total Contributions"/>
                <field name="total" sum="Grand Total"/>
            </list>
        </field>
    </record>

    <!-- Pivot View for Employee Payroll Details -->
    <record id="view_hr_payroll_employee_detail_pivot" model="ir.ui.view">
        <field name="name">hr.payroll.employee.detail.pivot</field>
        <field name="model">hr.payroll.employee.detail</field>
        <field name="arch" type="xml">
            <pivot string="Employee Payroll Analysis">
                <field name="department_name" invisible="1"/>
                <field name="employee_name" type="row"/>
                <field name="month" interval="month" type="col"/>
                <field name="basic_salary" type="measure"/>
                <field name="allowances" type="measure"/>
                <field name="contributions" type="measure"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View for Employee Payroll Details -->
    <record id="view_hr_payroll_employee_detail_graph" model="ir.ui.view">
        <field name="name">hr.payroll.employee.detail.graph</field>
        <field name="model">hr.payroll.employee.detail</field>
        <field name="arch" type="xml">
            <graph string="Employee Payroll Trends" type="line">
                <field name="month"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_payroll_employee_detail_search" model="ir.ui.view">
        <field name="name">hr.payroll.employee.detail.search</field>
        <field name="model">hr.payroll.employee.detail</field>
        <field name="arch" type="xml">
            <search string="Search Employee Payroll">
                <field name="department_name" string="Department" filter_domain="[('department_name','ilike',self)]"/>
                <field name="employee_name"/>
                <field name="month"/>
                <separator/>
                <filter name="group_by_department" string="Department" context="{'group_by': 'department_name'}"/>
                <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_name'}"/>
                <filter name="group_by_month" string="Month" context="{'group_by': 'month:month'}"/>
            </search>
        </field>
    </record>

    <!-- Action to Open Employee Payroll Details -->
    <record id="action_hr_payroll_employee_detail" model="ir.actions.act_window">
        <field name="name">Employee Payroll Details</field>
        <field name="res_model">hr.payroll.employee.detail</field>
        <field name="view_mode">pivot,tree,graph</field>
        <field name="context">{
            'group_by': ['employee_name'],
            'pivot_measures': ['basic_salary', 'allowances', 'contributions', 'total'],
            'pivot_column_groupby': ['month:month'],
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No payroll detail data available
            </p>
            <p>
                Click on a chart segment in the Analytics Dashboard to drill down into employee-level details.
            </p>
        </field>
    </record>

</odoo>
