<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main HR Analytics Dashboard - Unified View with Tabs -->
    <record id="view_hr_analytics_dashboard_form" model="ir.ui.view">
        <field name="name">HR Analytics Dashboard</field>
        <field name="model">hr.analytics.dashboard</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <form string="HR Analytics Dashboard" create="false" delete="false" js_class="hr_analytics_dashboard">
                <header>
                    <button name="action_refresh_all_analytics" type="object" class="oe_highlight" string="Refresh All Analytics" icon="fa-refresh"/>
                    <button name="action_clear_cache" type="object" string="Clear Cache" icon="fa-trash"/>
                    <button name="%(pb_hr_payroll_analytics.action_hr_analytics_export_wizard)d" type="action" string="Export" icon="fa-download"/>
                </header>

                <sheet>
                    <!-- Title -->
                    <div class="oe_title">
                        <h1>HR Analytics Dashboard</h1>
                        <p class="oe_grey">Professional analytics for personnel costs, headcount, and statutory compliance</p>
                    </div>

                    <!-- Global Filters at Top -->
                    <div style="margin-bottom: 20px; padding: 15px; background-color: #f8f9fa; border-radius: 8px;">
                        <group col="4">
                            <field name="selected_country" string="Country"/>
                            <field name="date_from" string="From"/>
                            <field name="date_to" string="To"/>
                            <div/>
                        </group>
                        <div style="margin-top: 10px;">
                            <button name="action_refresh_all_analytics" type="object" string="Apply Filters" class="btn btn-primary btn-sm" icon="fa-filter"/>
                        </div>
                    </div>

                    <!-- Quick Stats Cards -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_refresh_all_analytics" icon="fa-users">
                            <field string="Total Employees" name="total_headcount" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_refresh_all_analytics" icon="fa-dollar">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="total_personnel_cost" widget="monetary"/></span>
                                <span class="o_stat_text">Total Personnel Cost</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_refresh_all_analytics" icon="fa-files-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="total_contributions" widget="monetary"/></span>
                                <span class="o_stat_text">Total Contributions</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_refresh_all_analytics" icon="fa-percent">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="average_salary" widget="monetary"/></span>
                                <span class="o_stat_text">Avg Cost/Employee</span>
                            </div>
                        </button>
                    </div>

                    <!-- Tab Navigation -->
                    <notebook>
                        <!-- Tab 1: Personnel Costs -->
                        <page string="Personnel Costs for Management" name="personnel_costs">
                            <div class="alert alert-info">
                                <strong>Personnel Costs for Management:</strong> Comprehensive analysis of direct salaries, employer contributions, benefits, training, and recruitment costs by department, job title, designation, and cost center.
                            </div>
                            <div style="padding: 20px;">
                                <group col="2">
                                    <field name="total_personnel_cost" widget="monetary"/>
                                    <field name="total_contributions" widget="monetary"/>
                                    <field name="total_headcount"/>
                                    <field name="average_salary" widget="monetary"/>
                                </group>
                                <div style="margin-top: 20px;">
                                    <button name="action_refresh_all_analytics" type="object" string="Refresh Personnel Costs" class="btn btn-primary"/>
                                </div>
                                <!-- Charts Containers -->
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px;">
                                    <div style="min-height: 400px;"><canvas id="doughnut-chart-personnel"></canvas></div>
                                    <div style="min-height: 400px;"><canvas id="stacked-bar-chart-personnel"></canvas></div>
                                </div>
                            </div>
                        </page>

                        <!-- Tab 2: Cross Country Analytics -->
                        <page string="Cross Country Analytics" name="cross_country">
                            <div class="alert alert-info">
                                <strong>Cross Country Analytics:</strong> Global view of personnel costs across all countries with multi-country comparisons, headcount distribution, and cost-per-employee analysis.
                            </div>
                            <!-- Charts Containers -->
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px;">
                                <div style="min-height: 400px;"><canvas id="bar-chart-country-costs"></canvas></div>
                                <div style="min-height: 400px;"><canvas id="pie-chart-headcount"></canvas></div>
                            </div>
                            <div style="margin-top: 30px; min-height: 400px;"><canvas id="scatter-chart-costvsheadcount"></canvas></div>
                        </page>

                        <!-- Tab 3: Statutory Contributions -->
                        <page string="Statutory Contributions" name="statutory_contributions">
                            <div class="alert alert-info">
                                <strong>Statutory Contributions:</strong> Employee &amp; employer contributions tracking with compliance status and payment tracking.
                            </div>
                            <div style="padding: 20px;">
                                <group col="2">
                                    <field name="total_contributions" widget="monetary"/>
                                    <field name="total_headcount"/>
                                    <field name="total_personnel_cost" widget="monetary"/>
                                    <field name="average_salary" widget="monetary"/>
                                </group>
                                <div style="margin-top: 20px;">
                                    <button name="action_refresh_all_analytics" type="object" string="Refresh Contributions" class="btn btn-primary"/>
                                </div>
                                <!-- Charts Containers -->
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px;">
                                    <div style="min-height: 400px;"><canvas id="doughnut-chart-statutory"></canvas></div>
                                    <div style="min-height: 400px;"><canvas id="stacked-bar-chart-statutory"></canvas></div>
                                </div>
                            </div>
                        </page>

                        <!-- Tab 4: Headcount Analysis -->
                        <page string="Headcount Analysis" name="headcount">
                            <div class="alert alert-info">
                                <strong>Headcount Analysis:</strong> Employee count, FTE calculations, attrition rates, and headcount trends with department breakdowns.
                            </div>
                            <div style="padding: 20px;">
                                <group col="4">
                                    <field name="total_headcount"/>
                                    <field name="total_personnel_cost" widget="monetary"/>
                                    <field name="average_salary" widget="monetary"/>
                                    <field name="total_contributions" widget="monetary"/>
                                </group>
                                <div style="margin-top: 20px;">
                                    <button name="action_refresh_all_analytics" type="object" string="Refresh Headcount" class="btn btn-primary"/>
                                </div>
                                <!-- Charts Container -->
                                <div style="margin-top: 30px; min-height: 400px;"><canvas id="pie-chart-hc-type"></canvas></div>
                            </div>
                        </page>

                        <!-- Tab 5: Dependents &amp; Benefits -->
                        <page string="Dependents &amp; Benefits" name="dependents">
                            <div class="alert alert-info">
                                <strong>Dependents &amp; Benefits:</strong> Dependent count tracking, age distribution, benefits impact analysis, and tax benefit implications.
                            </div>
                            <div style="padding: 20px;">
                                <group col="2">
                                    <field name="total_contributions" widget="monetary"/>
                                    <field name="total_headcount"/>
                                    <field name="total_personnel_cost" widget="monetary"/>
                                    <field name="average_salary" widget="monetary"/>
                                </group>
                                <div style="margin-top: 20px;">
                                    <button name="action_refresh_all_analytics" type="object" string="Refresh Dependents" class="btn btn-primary"/>
                                </div>
                                <!-- Charts Container - Sample Data Note -->
                                <div class="alert alert-warning" style="margin-top: 30px;">
                                    <strong>Note:</strong> Dependents data populated from sample data. Uses Chart.js visualization for future live data integration.
                                </div>
                                <div style="margin-top: 20px; min-height: 400px;"><canvas id="bar-chart-dependents"></canvas></div>
                            </div>
                        </page>

                        <!-- Tab 6: Budget Variance -->
                        <page string="Budget Variance" name="budget_variance">
                            <div class="alert alert-warning">
                                <strong>Budget Variance (Sample Data):</strong> Budgeted vs actual cost comparison with variance analysis and alerts for high-variance items.
                            </div>
                            <div style="padding: 20px;">
                                <group col="2">
                                    <field name="total_personnel_cost" widget="monetary"/>
                                    <field name="average_salary" widget="monetary"/>
                                </group>
                                <div style="margin-top: 20px;">
                                    <button name="action_refresh_all_analytics" type="object" string="Refresh Budget" class="btn btn-primary"/>
                                </div>
                                <!-- Charts Containers -->
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px;">
                                    <div style="min-height: 400px;"><canvas id="grouped-bar-chart-budget"></canvas></div>
                                    <div style="min-height: 400px;"><canvas id="bar-chart-variance"></canvas></div>
                                </div>
                            </div>
                        </page>

                        <!-- Tab 7: Annual HR Costs -->
                        <page string="Annual HR Costs" name="annual_costs">
                            <div class="alert alert-info">
                                <strong>Annual HR Costs Overview:</strong> Annual salary costs, total cost of employment, cost trends, and full-year projections with year-over-year comparison.
                            </div>
                            <div style="padding: 20px;">
                                <group col="2">
                                    <field name="total_personnel_cost" widget="monetary"/>
                                    <field name="total_contributions" widget="monetary"/>
                                    <field name="total_headcount"/>
                                    <field name="average_salary" widget="monetary"/>
                                </group>
                                <div style="margin-top: 20px;">
                                    <button name="action_refresh_all_analytics" type="object" string="Refresh Annual Costs" class="btn btn-primary"/>
                                </div>
                                <!-- Charts Container -->
                                <div style="margin-top: 30px; min-height: 400px;"><canvas id="line-chart-annual-trend"></canvas></div>
                            </div>
                        </page>
                    </notebook>

                    <!-- Hidden fields for caching -->
                    <field name="last_refresh" invisible="1"/>
                    <field name="cache_valid" invisible="1"/>
                    <field name="auto_refresh" invisible="1"/>

                </sheet>

                <!-- Inline CSS for Dashboard Styling -->
                <style>
                    .metric-card {
                        transition: transform 0.3s ease, box-shadow 0.3s ease;
                    }
                    .metric-card:hover {
                        transform: translateY(-3px);
                        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
                    }
                    .row {
                        display: flex;
                        flex-wrap: wrap;
                        margin: -15px;
                    }
                    .col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-6, .col-md-12 {
                        padding: 15px;
                    }
                    .col-md-1 { width: 8.333%; }
                    .col-md-2 { width: 16.666%; }
                    .col-md-3 { width: 25%; }
                    .col-md-4 { width: 33.333%; }
                    .col-md-6 { width: 50%; }
                    .col-md-12 { width: 100%; }
                    @media (max-width: 768px) {
                        .col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-6, .col-md-12 {
                            width: 100% !important;
                        }
                    }
                </style>
            </form>
        </field>
    </record>

    <!-- Dashboard Tree View (List) -->
    <record id="view_hr_analytics_dashboard_tree" model="ir.ui.view">
        <field name="name">HR Analytics Dashboard List</field>
        <field name="model">hr.analytics.dashboard</field>
        <field name="arch" type="xml">
            <tree string="HR Analytics Dashboards">
                <field name="name"/>
                <field name="selected_country"/>
                <field name="active_tab"/>
                <field name="last_refresh"/>
            </tree>
        </field>
    </record>

    <!-- Server Action to Prepare Dashboard with Auto-Generated Data -->
    <record id="action_prepare_hr_analytics_dashboard" model="ir.actions.server">
        <field name="name">Prepare HR Analytics Dashboard</field>
        <field name="model_id" ref="model_hr_analytics_dashboard"/>
        <field name="state">code</field>
        <field name="code">
# Get or create dashboard
dashboard = env['hr.analytics.dashboard'].search([('name', '=', 'HR Analytics Dashboard')], limit=1)

if not dashboard:
    dashboard = env['hr.analytics.dashboard'].create({'name': 'HR Analytics Dashboard'})

# Auto-generate data if missing
if not dashboard.personnel_costs_id:
    try:
        dashboard.action_refresh_all_analytics()
    except Exception:
        pass

action = {
    'type': 'ir.actions.act_window',
    'name': 'HR Analytics Dashboard',
    'res_model': 'hr.analytics.dashboard',
    'res_id': dashboard.id,
    'view_mode': 'form',
    'view_id': env.ref('pb_hr_payroll_analytics.view_hr_analytics_dashboard_form').id,
    'target': 'current',
}
        </field>
    </record>

    <!-- Action to Open Dashboard (Window Action - fallback) -->
    <record id="action_open_hr_analytics_dashboard" model="ir.actions.act_window">
        <field name="name">HR Analytics Dashboard</field>
        <field name="res_model">hr.analytics.dashboard</field>
        <field name="view_mode">form,tree</field>
        <field name="view_id" ref="view_hr_analytics_dashboard_form"/>
        <field name="target">current</field>
        <field name="context">{'default_auto_refresh': True}</field>
    </record>

</odoo>
