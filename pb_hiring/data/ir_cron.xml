<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- `numbercall` and `doall` were REMOVED from ir.cron in Odoo 19 —
         including either aborts the whole module load — and `nextcall` takes
         no eval expression in a data file, so the first run is simply the
         next tick after installation.

         ONE job, not two: both nudges are the same question asked of two
         tables, and a person reading the log wants one line with two numbers
         in it rather than two lines they have to add up. It is idempotent by
         the to-do it raises, so running it twice in a morning changes
         nothing. -->

    <record id="cron_hiring_daily" model="ir.cron">
        <field name="name">Hiring: chase the adverts, the roles nobody is recruiting and the late opinions</field>
        <field name="model_id" ref="model_pb_hiring_automation"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- ==================================================================
         A2. A SECOND JOB, AND IT HAS TO BE A SECOND ONE. The nightly step
         asks "what has gone stale"; this one asks "who has something in half
         an hour", and that answer is only worth anything if it is asked
         every ten minutes. Folding it into the night would make the
         half-hour reminder arrive some time the following morning.

         Both nudges are stamped on the interview itself, so a tick that
         overlaps the previous one sends nothing twice. The switch
         `pb_hiring.reminders` turns the whole job off without disabling the
         cron row, so a business that has silenced it can still see it is
         there — a thing that is off and does not say so is reported as
         broken (R54).
         ================================================================== -->
    <record id="cron_hiring_interview_reminders" model="ir.cron">
        <field name="name">Hiring: remind everybody about the interviews that are coming</field>
        <field name="model_id" ref="model_pb_hiring_automation"/>
        <field name="state">code</field>
        <field name="code">model._cron_reminders()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
