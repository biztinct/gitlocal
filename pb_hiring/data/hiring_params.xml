<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ==================================================================
         The DIALS, shipped so they are discoverable rather than folklore.

         The SWITCHES are deliberately not here. They default in code
         (`hiring_common.DEFAULTS`), because a `noupdate="1"` record for a
         switch freezes whatever value a test run happened to leave behind:
         the next upgrade never corrects it. P3, P4 and P5 all wrote the
         same thing down.

         `pb_hiring.platform_mail` in particular defaults to OFF and is
         meant to be turned on by hand, once, by somebody who has read the
         advert a job board is about to receive.
         ================================================================== -->

    <record id="param_jd_reminder_days" model="ir.config_parameter">
        <field name="key">pb_hiring.jd_reminder_days</field>
        <!-- Three days. Long enough that a hiring manager on a short trip is
             not chased for nothing; short enough that an advert waiting to
             be agreed does not quietly cost a fortnight. -->
        <field name="value">3</field>
    </record>

    <record id="param_recruiter_nudge_days" model="ir.config_parameter">
        <field name="key">pb_hiring.recruiter_nudge_days</field>
        <!-- How long a role may be open with nobody recruiting it before the
             hiring administrators are told. -->
        <field name="value">3</field>
    </record>

    <!-- ============ A2 ============ -->

    <record id="param_feedback_hours" model="ir.config_parameter">
        <field name="key">pb_hiring.feedback_hours</field>
        <!-- WORKING hours, on the company's own calendar. Twenty-four plain
             hours would ask a panel member who interviewed at four on a
             Friday to answer by four on a Saturday. -->
        <field name="value">24</field>
    </record>

    <record id="param_urgent_after_hours" model="ir.config_parameter">
        <field name="key">pb_hiring.urgent_after_hours</field>
        <!-- Zero: the chase goes out the moment an opinion is late. A panel
             member asked a week later has forgotten the conversation, so a
             grace period buys nothing and costs the answer. -->
        <field name="value">0</field>
    </record>

    <record id="param_interview_duration" model="ir.config_parameter">
        <field name="key">pb_hiring.interview_duration</field>
        <!-- What the length box starts at. Forty-five minutes is the length
             of a real interview; an hour is what a diary defaults to. -->
        <field name="value">45</field>
    </record>

    <record id="param_reminder_cap" model="ir.config_parameter">
        <field name="key">pb_hiring.reminder_cap</field>
        <!-- A cap that is right for a screen is a bug in a job (R76), so the
             jobs carry their own and it is a dial rather than a literal. Four
             hundred interviews inside one ten-minute window is far beyond
             anything real; the number exists so a runaway cannot mail a
             company into silence. -->
        <field name="value">400</field>
    </record>

</data>
</odoo>
