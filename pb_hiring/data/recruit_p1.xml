<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================================================================
         RECRUIT P1

         1. THE STOCK RECRUITMENT MENUS ARE HIDDEN (RC15, G-11). The board and
            Hiring set-up are the only doors. `active` is set to False — a
            menu is never deleted, so an upgrade of the standard module has
            nothing to re-create and a support engineer can switch one back.
            noupdate="0" on purpose: every load of this module re-hides them.
         2. HIRING SET-UP, the talent lead's door (G-10). A client action
            RECORD, never a bare tag, so a breadcrumb back to it has a name.
         ================================================================== -->
    <record id="hr_recruitment.menu_hr_recruitment_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_recruitment.menu_crm_case_categ0_act_job" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_recruitment.menu_hr_job_position" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_recruitment.menu_hr_job_position_interviewer" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_recruitment.menu_hr_talent_pools" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_recruitment.menu_crm_case_categ_all_app" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_recruitment.menu_hr_recruitment_configuration" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="website_hr_recruitment.menu_job_pages" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <record id="action_pb_hiring_setup" model="ir.actions.client">
        <field name="name">Hiring set-up</field>
        <field name="tag">pb_hiring_setup</field>
    </record>
</odoo>
