<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ==================================================================
         SIX LINES TO START FROM, because a blank checklist is a checklist
         nobody fills in. A company that checks something else edits these
         under the cog and the next candidate is checked on the new list.

         COMPANY-LESS (R8): `company_id` defaults to the loading user's
         company, so a seeded row installs onto whichever company ran the
         install and the company rule then hides it from everybody else.

         EACH ONE IS ITS OWN RECORD WITH ITS OWN XMLID (R58). A
         `(0, 0, {...})` inside a one2many is a CREATE with nothing to match
         on, so three upgrades would leave three copies of every line.

         `noupdate="1"` so a company that has reworded one keeps its wording
         through every upgrade.
         ================================================================== -->

    <record id="bgv_identity" model="pb.hiring.bgv.template">
        <field name="name">Who they are</field>
        <field name="sequence">10</field>
        <field name="required" eval="True"/>
        <field name="help_text">A government photo ID, and the name on it matches the name on the offer.</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="bgv_qualification" model="pb.hiring.bgv.template">
        <field name="name">Their highest qualification</field>
        <field name="sequence">20</field>
        <field name="required" eval="True"/>
        <field name="help_text">The certificate exists and the institution confirms it, or the candidate has told us it cannot be confirmed and why.</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="bgv_employer_1" model="pb.hiring.bgv.template">
        <field name="name">Their last employer</field>
        <field name="sequence">30</field>
        <field name="required" eval="True"/>
        <field name="help_text">The dates and the job title match what they told us. A company that will only confirm dates is a normal answer, not a problem.</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="bgv_employer_2" model="pb.hiring.bgv.template">
        <field name="name">The employer before that</field>
        <field name="sequence">40</field>
        <field name="required" eval="True"/>
        <field name="help_text">The same again. Mark it "does not apply" for a first job — that is an answer, not a gap.</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="bgv_references" model="pb.hiring.bgv.template">
        <field name="name">Two people who have worked with them</field>
        <field name="sequence">50</field>
        <field name="required" eval="True"/>
        <field name="help_text">Both spoken to, and at least one of them managed them. Write down what they said, not whether they were positive.</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="bgv_criminal" model="pb.hiring.bgv.template">
        <field name="name">Criminal record check</field>
        <field name="sequence">60</field>
        <!-- OPTIONAL, deliberately: it is not lawful or proportionate for
             every role in every country, and a checklist that demanded it
             everywhere would be a checklist people tick without doing. -->
        <field name="required" eval="False"/>
        <field name="help_text">Only where the role and the law call for it. Leave it alone otherwise.</field>
        <field name="company_id" eval="False"/>
    </record>

</data>
</odoo>
