<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ==================================================================
         RECRUIT P8 — the one new internal email: a colleague was given
         access to a candidate (the P4 owner item). English (R11), sent with
         an explicit `email_to` from the hiring sender; reads public computed
         fields only (RC49): `pb_parts_words`, `pb_role_title`,
         `pb_board_url`. Shares are only ever made with a full login (P4), so
         the door is the hiring board.
         ================================================================== -->
    <record id="mail_template_share_granted" model="mail.template">
        <field name="name">Hiring: you were given access to a candidate</field>
        <field name="model_id" ref="model_pb_hiring_share"/>
        <field name="email_from">{{ object.company_id.pb_hiring_sender or user.email_formatted }}</field>
        <field name="subject">You were given access to {{ object.applicant_id.partner_name }} on {{ object.pb_role_title }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733; font-size:14px; line-height:1.55;">
                <p>Hello <t t-out="object.user_id.name or ''"/>,</p>
                <p>
                    <strong><t t-out="object.granted_by_id.name or 'The hiring team'"/></strong>
                    gave you access to <strong><t t-out="object.applicant_id.partner_name or ''"/></strong>,
                    a candidate for <t t-out="object.pb_role_title or ''"/>.
                </p>
                <p t-if="object.pb_parts_words">You can see: <t t-out="object.pb_parts_words"/>.</p>
                <p t-if="object.note" style="border-left:3px solid #E2E8F0; padding-left:12px; color:#4A5568;"><t t-out="object.note"/></p>
                <p style="color:#64748B;">Only what was shared with you is open to you; everything else stays with the hiring team.</p>
                <p style="margin:20px 0;">
                    <a t-att-href="object.pb_board_url"
                       style="background:#4F46E5; color:#FFFFFF; text-decoration:none; padding:11px 20px; border-radius:9px; font-weight:600; display:inline-block;">Open the hiring board</a>
                </p>
                <t t-out="object.company_id.name or ''"/>
            </div>
        </field>
    </record>

</data>
</odoo>
