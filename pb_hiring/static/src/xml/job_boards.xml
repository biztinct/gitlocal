<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="pb_hiring.JobBoards">
  <div class="pb-jobboards">
    <header class="jb-header"><div><span class="jb-eyebrow" t-esc="state.company"/><h1>Find your next great hire.</h1><p>One advert. The right boards. Every application back in Hiring.</p></div><button t-if="state.can_setup" class="jb-button" t-on-click="connections">Set up job boards <t t-out="ic('sliders')"/></button></header>
    <div t-if="state.error" class="jb-alert error" role="alert" t-esc="state.error"/>
    <section class="jb-picker"><div><span class="jb-eyebrow">Start with a role</span><h2>Where would you like to advertise?</h2></div><div class="jb-pick-fields"><label>Find a role<input type="search" t-model="state.query" placeholder="Search title, city or country"/></label><label>Role<select t-att-value="state.roleId" t-on-change="chooseRole" t-att-disabled="state.busy"><option value="">Choose a role…</option><option t-foreach="roles" t-as="role" t-key="role.id" t-att-value="role.id"><t t-esc="role.title"/> · <t t-esc="role.location || role.country"/><t t-if="role.confidential"> · Confidential</t></option></select></label></div></section>
    <p t-if="state.capped">Showing the latest 500 active roles.</p>
    <div t-if="state.busy" class="jb-loading" role="status">Working…</div>
    <div t-if="!state.panel" class="jb-welcome"><span class="jb-orbit"><t t-out="ic('globe',40)"/></span><h2>Your next hire starts here</h2><p>Choose a role above to prepare its advert, choose a job board and follow applications.</p><div class="jb-welcome-steps"><span>01 · Choose a board</span><span>02 · Prepare your advert</span><span>03 · Review and publish</span></div><p t-if="!state.roles.length and !state.busy">No active roles in this company yet. Open a role from Hiring Overview first.</p></div>
    <t t-if="state.panel">
      <div class="jb-rolebar"><div><strong t-esc="state.panel.title"/><span><t t-esc="state.panel.location || state.panel.country"/> · <t t-esc="state.panel.company"/></span></div><button class="jb-text" t-on-click="openRole">Open role →</button><button class="jb-button" t-on-click="refresh" t-att-disabled="state.busy">Refresh status</button></div>
      <div t-if="!canPost" class="jb-alert">This role is confidential or closed. Public advertising is unavailable.</div>
      <div t-elif="!state.panel.on_page" class="jb-careers"><div><strong>First, give candidates a place to apply</strong><p>Publish the role on your careers page to activate its application links.</p></div><button class="jb-button primary" t-on-click="publishCareers" t-att-disabled="state.busy">Publish careers page</button></div>
      <div t-else="" class="jb-careers ready"><div><strong>Careers page is live</strong><p>Your tracked links lead to this role’s application form.</p></div><a t-if="careers" t-att-href="careers.link" target="_blank" rel="noopener" class="jb-text">Preview careers page ↗</a></div>
      <t t-if="state.step === 0">
        <div class="jb-section-title"><div><span class="jb-eyebrow">01 / Choose your audience</span><h2>Job boards</h2></div><span>Available for <t t-esc="state.panel.country || 'this role'"/></span></div>
        <div class="jb-grid"><article t-foreach="boards" t-as="board" t-key="board.id" class="jb-board"><div class="jb-board-top"><span t-att-class="'jb-logo ' + board.key" t-esc="board.key === 'linkedin' ? 'in' : board.name.slice(0,2)"/><span class="jb-badge" t-att-class="{live: board.live}"><t t-if="board.api_managed" t-esc="board.delivery_state"/><t t-elif="board.live">Posted manually</t><t t-else="">Not posted</t></span></div><h3 t-esc="board.name"/><p t-esc="board.connection.note"/><div class="jb-board-meta"><span t-esc="board.connection.ready ? 'Connected publishing' : 'Manual posting'"/><b><t t-esc="board.apps"/> applications</b></div><button class="jb-button primary" t-on-click="() => this.chooseBoard(board)" t-att-disabled="!canPost || state.busy"><t t-if="board.api_managed or board.live">Manage posting</t><t t-else="">Prepare advert</t> →</button></article></div>
        <div t-if="!boards.length" class="jb-welcome"><h3>No job boards enabled for this country</h3><p>Your hiring administrator can enable the relevant boards in Hiring set-up → Channels.</p></div>
        <p class="jb-footnote">Manual postings count applications through their tracked link. Connected listings are live only after the provider confirms them.</p>
      </t>
      <t t-elif="state.channel">
        <div class="jb-section-title"><button class="jb-text" t-on-click="() => { this.state.step=0; this.state.channel=null; }" t-att-disabled="state.busy">← All boards</button><span t-esc="state.channel.name"/></div>
        <ol class="jb-steps"><li t-att-class="{current:state.step === 1}">1 <span>Prepare advert</span></li><li t-att-class="{current:state.step === 2}">2 <span>Review and publish</span></li><li t-att-class="{current:state.step === 3}">3 <span>Track results</span></li></ol>
        <div t-if="state.channel.api_managed" class="jb-alert"><strong t-esc="state.channel.api_status"/><button class="jb-text" t-on-click="manage" t-att-disabled="state.busy">Check delivery, close listing or retry intake →</button></div>
        <div t-if="state.step === 1" class="jb-editor">
          <section class="jb-surface"><span class="jb-eyebrow">Make the first impression count</span><h2>Prepare your advert</h2><p>Changes here are saved for this board. Your careers-page advert stays as it is.</p>
            <label>Job title <input t-model="state.values.title" required="required" maxlength="250"/></label><label>City and country <input t-model="state.values.location" placeholder="e.g. Hanoi, Vietnam" required="required"/></label><label>Job advert <textarea t-model="state.values.description" rows="14" placeholder="Tell candidates about the role, responsibilities, experience and what you offer." required="required"/></label>
            <div class="jb-actions"><button class="jb-button" t-on-click="saveDraft" t-att-disabled="state.busy || !complete">Save draft</button><span t-if="state.saved">Draft saved</span><button class="jb-button primary" t-on-click="review" t-att-disabled="state.busy || !complete">Continue to review →</button></div>
          </section>
          <aside class="jb-surface jb-preview"><span class="jb-eyebrow">Advert preview</span><span class="jb-badge" t-esc="state.channel.name"/><h2 t-esc="state.values.title || 'Your job title'"/><p><t t-esc="state.panel.company"/> · <t t-esc="state.values.location || 'City, country'"/></p><hr/><div class="jb-advert" t-esc="state.values.description || 'Your advert will appear here as you write.'"/><div class="jb-preview-apply">Apply for this role</div><small>The job board controls its final layout.</small></aside>
        </div>
        <section t-if="state.step === 2" class="jb-surface jb-review"><span class="jb-eyebrow">One final look</span><h2>Publish to <t t-esc="state.channel.name"/></h2><p><strong t-esc="state.values.title"/> · <t t-esc="state.values.location"/></p>
          <div t-if="state.channel.connection.ready and !state.channel.api_managed" class="jb-route"><button class="jb-button" t-att-class="{primary:!state.manual}" t-on-click="() => { this.state.manual=false; this.state.confirmed=false; }">Publish from Payobook</button><button class="jb-button" t-att-class="{primary:state.manual}" t-on-click="() => { this.state.manual=true; this.state.confirmed=false; }">Post manually</button></div>
          <t t-if="automatic">
            <div class="jb-alert"><strong>Destination: <t t-esc="state.panel.company"/> · <t t-esc="state.channel.connection.environment === 'production' ? 'LIVE environment' : 'Provider test environment'"/></strong><p>Submitting sends this advert to the provider. Any charges follow your company’s board agreement.</p></div>
            <label class="jb-check"><input type="checkbox" t-model="state.values.native_apply"/><span><strong>Let candidates apply on the job board</strong><small>Applications and supported CVs arrive in Hiring. Review any missing role-specific answers before progressing candidates. When off, candidates apply on your careers page.</small></span></label>
            <div t-if="state.channel.key === 'jobstreet'" class="jb-seek"><h3>JobStreet posting details</h3><p>Use the location, category and ad product approved for your company by SEEK.</p><label>Search summary<input t-model="state.values.summary"/></label><div class="jb-columns"><label>Location identifier<input t-model="state.values.location_id"/></label><label>Category identifier<input t-model="state.values.category_id"/></label><label>Ad product identifier<input t-model="state.values.product_id"/></label><label>Currency<input t-model="state.values.currency" placeholder="IDR"/></label><label>Salary from<input type="number" t-model.number="state.values.salary_min" min="0"/></label><label>Salary to<input type="number" t-model.number="state.values.salary_max" min="0"/></label><label>Salary interval<select t-model="state.values.pay_interval"><option value="Year">Per year</option><option value="Month">Per month</option><option value="Hour">Per hour</option></select></label><label>Employment type<select t-model="state.values.work_type"><option value="FullTime">Full time</option><option value="PartTime">Part time</option><option value="ContractTemp">Contract</option><option value="Casual">Casual</option></select></label><label>Workplace<select t-model="state.values.arrangement"><option value="OnSite">On site</option><option value="Hybrid">Hybrid</option><option value="Remote">Remote</option></select></label></div></div>
          </t>
          <t t-else="">
            <div t-if="state.channel.api_managed" class="jb-alert error">This listing is managed by a connection that needs attention. Ask your administrator to restore it; use the delivery controls above to check its status.</div>
            <div t-else="" class="jb-manual"><p>Direct publishing is optional. Follow these three steps to post this advert yourself.</p><ol><li><strong>Copy your advert</strong><p>Paste it into a job posting in your company’s <t t-esc="state.channel.name"/> employer account.</p><button class="jb-button" t-on-click="() => this.copy(this.packedAdvert)">Copy advert and application link</button></li><li><strong>Use this as the application link</strong><p>It opens the careers application form and records <t t-esc="state.channel.name"/> as the source. Select external applications on the board where supported.</p><div class="jb-copy"><input readonly="readonly" aria-label="Tracked application link" t-att-value="state.channel.link"/><button class="jb-button" t-on-click="() => this.copy(this.state.channel.link)">Copy link</button></div></li><li><strong>Come back with the live posting</strong><label>Published job URL<input type="url" t-model="state.externalUrl" placeholder="https://…"/></label><small>This records the posting you created. It does not publish to the board.</small></li></ol></div>
          </t>
          <label class="jb-check"><input type="checkbox" t-model="state.confirmed"/><span t-esc="automatic ? 'I have reviewed the advert, destination and any provider charges.' : 'I have published this job on the board using the tracked application link.'"/></label>
          <div t-if="!state.panel.on_page" class="jb-alert">Publish the careers page first to enable applications.</div>
          <div class="jb-actions"><button class="jb-button" t-on-click="() => { this.state.step=1; }" t-att-disabled="state.busy">← Edit advert</button><button class="jb-button primary" t-on-click="submit" t-att-disabled="state.busy || !state.confirmed || !state.panel.on_page || pending || (!automatic &amp;&amp; (!state.externalUrl || state.channel.api_managed))" t-esc="submitLabel"/></div>
        </section>
        <section t-if="state.step === 3" class="jb-surface jb-result" role="status"><span class="jb-orbit"><t t-out="ic('check',36)"/></span><h2 t-esc="automatic ? 'Your advert is on its way' : 'Posting recorded'"/><p t-esc="state.result"/><p><strong t-esc="state.channel.name"/> · <t t-esc="state.channel.api_managed ? state.channel.delivery_state : 'Posted manually'"/> · <t t-esc="state.channel.apps"/> applications</p><div class="jb-actions"><button class="jb-button" t-on-click="refresh">Back to boards</button><button t-if="state.channel.api_managed" class="jb-button primary" t-on-click="manage">Check provider status</button></div></section>
      </t>
    </t>
  </div>
</t>
</templates>
