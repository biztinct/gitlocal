<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="pb_hiring.JobBoards">
  <div class="pb-jobboards">
    <header class="jb-header"><div><span class="jb-eyebrow" t-esc="state.company"/><h1>Find your next great hire.</h1><p>Prepare adverts, connect accounts and track applications.</p></div><button t-if="state.can_setup" class="jb-button" t-on-click="connections">Connected accounts <t t-out="ic('sliders')"/></button></header>
    <div t-if="state.error" class="jb-alert error" role="alert" t-esc="state.error"/>
    <nav class="jb-tabs" aria-label="Job board workspace"><button t-att-class="{selected:state.view === 'catalogue'}" t-on-click="() => this.switchView('catalogue')">Connect &amp; set up</button><button t-att-class="{selected:state.view === 'publish'}" t-on-click="() => this.switchView('publish')">Publish jobs</button></nav>
    <t t-if="state.guide" t-call="pb_hiring.BoardGuide"/>
    <t t-elif="state.view === 'catalogue'" t-call="pb_hiring.BoardCatalogue"/>
    <t t-else="">
    <section class="jb-picker"><div><span class="jb-eyebrow">Start with a role</span><h2>Where would you like to advertise?</h2></div><div class="jb-pick-fields"><label>Find a role<input type="search" t-model="state.query" placeholder="Search title, city or country"/></label><label>Role<select t-att-value="state.roleId" t-on-change="chooseRole" t-att-disabled="state.busy"><option value="">Choose a role…</option><option t-foreach="roles" t-as="role" t-key="role.id" t-att-value="role.id"><t t-esc="role.title"/> · <t t-esc="role.location || role.country"/><t t-if="role.confidential"> · Confidential</t></option></select></label></div></section>
    <p t-if="state.capped">Showing the latest 500 active roles.</p>
    <div t-if="state.busy" class="jb-loading" role="status">Working…</div>
    <div t-if="!state.panel" class="jb-welcome"><span class="jb-orbit"><t t-out="ic('globe',40)"/></span><h2>Your next hire starts here</h2><p>Choose a role above to prepare its advert, choose a job board and follow applications.</p><div class="jb-welcome-steps"><span>01 · Choose a board</span><span>02 · Prepare your advert</span><span>03 · Review and publish</span></div><p t-if="!state.roles.length and !state.busy">No active roles in this company yet. Open a role from Hiring Overview first.</p></div>
    <t t-if="state.panel">
      <div class="jb-rolebar"><div><strong t-esc="state.panel.title"/><span><t t-esc="state.panel.location || state.panel.country"/> · <t t-esc="state.panel.company"/></span></div><button class="jb-text" t-on-click="openRole">Open role →</button><button class="jb-button" t-on-click="refresh" t-att-disabled="state.busy">Refresh status</button></div>
      <div t-if="!canPost" class="jb-alert">This role is confidential or closed. Public advertising is unavailable.</div>
      <div t-elif="!state.panel.on_page" class="jb-careers"><div><strong>First, give candidates a place to apply</strong><p>Publish the role on your careers page to activate its application links.</p></div><button class="jb-button primary" t-on-click="publishCareers" t-att-disabled="state.busy">Publish careers page</button></div>
      <div t-else="" class="jb-careers ready"><div><strong>Careers page is live</strong><p>Your tracked links lead to this role’s application form.</p></div><a t-if="careers" t-att-href="careers.link" target="_blank" rel="noopener" class="jb-text">Preview careers page ↗</a></div>
      <t t-if="state.step === 0">
        <div class="jb-section-title"><div><span class="jb-eyebrow">01 / Choose your audience</span><h2>Job boards</h2></div><span>Available for <t t-esc="state.panel.country || 'this role'"/></span></div>
        <label class="jb-board-search">Find a board<input type="search" t-model="state.boardQuery" placeholder="Search job boards"/></label>
        <div class="jb-grid"><article t-foreach="boards" t-as="board" t-key="board.id" class="jb-board"><div class="jb-board-top"><span t-att-class="'jb-logo ' + board.key" t-esc="board.key === 'linkedin' ? 'in' : board.name.slice(0,2)"/><span class="jb-badge" t-att-class="{live: board.live}"><t t-if="board.api_managed" t-esc="board.delivery_state"/><t t-elif="board.live">Posted manually</t><t t-elif="board.feed_current">Included in feed</t><t t-else="">Not posted</t></span></div><h3 t-esc="board.name"/><p t-esc="board.connection.note"/><div class="jb-board-meta"><span t-esc="board.connection.ready ? 'Connected publishing' : board.route === 'feed' ? 'Feed distribution' : board.route === 'discovery' ? 'Search discovery' : 'Manual posting'"/><b><t t-esc="board.apps"/> applications</b></div><button t-if="board.route !== 'discovery'" class="jb-button primary" t-on-click="() => this.chooseBoard(board)" t-att-disabled="!canPost || state.busy"><t t-if="board.api_managed or board.live">Manage posting</t><t t-else="">Prepare advert</t> →</button><button t-if="board.route === 'feed'" class="jb-button" t-on-click="() => this.chooseFeed(board)" t-att-disabled="state.busy">Manage feed distribution</button><button t-if="board.route" class="jb-text" t-on-click="() => this.guide(board.key)" t-att-disabled="state.busy">Setup guide →</button></article></div>
        <div t-if="!boards.length" class="jb-welcome"><h3>No job boards enabled for this country</h3><p>Your hiring administrator can enable the relevant boards in Hiring set-up → Channels.</p></div>
        <p class="jb-footnote">Manual postings count applications through their tracked link. Connected listings are live only after the provider confirms them.</p>
      </t>
      <t t-elif="state.channel">
        <div class="jb-section-title"><button class="jb-text" t-on-click="() => { this.state.step=0; this.state.channel=null; }" t-att-disabled="state.busy">← All boards</button><span t-esc="state.channel.name"/></div>
        <ol t-if="state.step !== 4" class="jb-steps"><li t-att-class="{current:state.step === 1}">1 <span>Prepare advert</span></li><li t-att-class="{current:state.step === 2}">2 <span>Review and publish</span></li><li t-att-class="{current:state.step === 3}">3 <span>Track results</span></li></ol>
        <section t-if="state.step === 4" class="jb-surface jb-review">
          <span class="jb-eyebrow">Feed distribution</span><h2>Share this public careers advert</h2>
          <p>Only the published careers-page title and description enter the feed. Later edits to that page are included automatically. Board-specific drafts are not used.</p>
          <p>Applications follow the tracked link back to Hiring. Including a job in this feed does not confirm that the provider has published it.</p>
          <div t-if="!state.channel.feed_ready" class="jb-alert">A hiring administrator must enable this feed in the setup guide first.<button class="jb-text" t-on-click="() => this.guide(this.state.channel.key)">Open setup guide →</button></div>
          <div class="jb-advert" t-esc="state.panel.feed_description"/>
          <label>Include until<input type="date" t-model="state.expires"/></label><small>Choose a date within 90 days. Closed, confidential, expired and unpublished roles are excluded automatically.</small>
          <div t-if="state.result" class="jb-alert" role="status" t-esc="state.result"/>
          <div class="jb-actions"><button class="jb-button primary" t-on-click="() => this.selectFeed(true)" t-att-disabled="state.busy || !state.channel.feed_ready || !canPost || !state.panel.on_page">Include in feed</button><button t-if="state.channel.feed_selected" class="jb-button" t-on-click="() => this.selectFeed(false)" t-att-disabled="state.busy">Remove from feed</button></div>
        </section>
        <div t-if="state.channel.api_managed" class="jb-alert"><strong t-esc="state.channel.api_status"/><button class="jb-text" t-on-click="manage" t-att-disabled="state.busy">Check delivery, close listing or retry intake →</button></div>
        <div t-if="state.step === 1" class="jb-editor">
          <section class="jb-surface"><span class="jb-eyebrow">Make the first impression count</span><h2>Prepare your advert</h2><p>Changes here are saved for this board. Your careers-page advert stays as it is.</p>
            <label>Job title <input t-model="state.values.title" required="required" maxlength="250"/></label><label>City and country <input t-model="state.values.location" placeholder="e.g. Hanoi, Vietnam" required="required"/></label><label>Job advert <textarea t-model="state.values.description" rows="14" placeholder="Tell candidates about the role, responsibilities, experience and what you offer." required="required"/></label>
            <div class="jb-actions"><button class="jb-button" t-on-click="saveDraft" t-att-disabled="state.busy || !complete">Save draft</button><span t-if="state.saved">Draft saved</span><button class="jb-button primary" t-on-click="review" t-att-disabled="state.busy || !complete">Continue to review →</button></div>
          </section>
          <aside class="jb-surface jb-preview"><span class="jb-eyebrow">Advert preview</span><span class="jb-badge" t-esc="state.channel.name"/><h2 t-esc="state.values.title || 'Your job title'"/><p><t t-esc="state.panel.company"/> · <t t-esc="state.values.location || 'City, country'"/></p><hr/><div class="jb-advert" t-esc="state.values.description || 'Your advert will appear here as you write.'"/><div class="jb-preview-apply">Apply for this role</div><small>The job board controls its final layout.</small></aside>
        </div>
        <section t-if="state.step === 2" class="jb-surface jb-review"><span class="jb-eyebrow">One final look</span><h2>Publish to <t t-esc="state.channel.name"/></h2><p><strong t-esc="state.values.title"/> · <t t-esc="state.values.location"/></p>
          <div t-if="state.channel.connection.ready and !state.channel.api_managed" class="jb-route"><button class="jb-button" t-att-class="{primary:!state.manual}" t-on-click="() => { this.state.manual=false; this.state.confirmed=false; }">Publish from Payobook</button><button class="jb-button" t-att-class="{primary:state.manual}" t-on-click="() => { this.state.manual=true; this.state.confirmed=false; }">Post manually</button></div>
          <t t-if="automatic">
            <div class="jb-alert"><strong>Destination: <t t-esc="state.panel.company"/> · <t t-esc="state.channel.connection.environment === 'production' ? 'LIVE environment' : 'Provider test environment'"/></strong><p>Submitting sends this advert to the provider. Any charges follow your company’s board agreement.</p></div>
            <label class="jb-check"><input type="checkbox" t-model="state.values.native_apply"/><span><strong>Let candidates apply on the job board</strong><small>Applications and supported CVs arrive in Hiring. Review any missing role-specific answers before progressing candidates. When off, candidates apply on your careers page.</small></span></label>
            <div t-if="state.channel.key === 'jobstreet'" class="jb-seek"><h3>JobStreet posting details</h3><p>Use the location, category and ad product approved for your company by SEEK.</p><label>Search summary<input t-model="state.values.summary"/></label><div class="jb-columns"><label>Location identifier<input t-model="state.values.location_id"/></label><label>Category identifier<input t-model="state.values.category_id"/></label><label>Ad product identifier<input t-model="state.values.product_id"/></label><label>Currency<input t-model="state.values.currency" placeholder="IDR"/></label><label>Salary from<input type="number" t-model.number="state.values.salary_min" min="0"/></label><label>Salary to<input type="number" t-model.number="state.values.salary_max" min="0"/></label><label>Salary interval<select t-model="state.values.pay_interval"><option value="Year">Per year</option><option value="Month">Per month</option><option value="Hour">Per hour</option></select></label><label>Employment type<select t-model="state.values.work_type"><option value="FullTime">Full time</option><option value="PartTime">Part time</option><option value="ContractTemp">Contract</option><option value="Casual">Casual</option></select></label><label>Workplace<select t-model="state.values.arrangement"><option value="OnSite">On site</option><option value="Hybrid">Hybrid</option><option value="Remote">Remote</option></select></label></div></div>
          </t>
          <t t-else="">
            <div t-if="state.channel.api_managed" class="jb-alert error">This listing is managed by a connection that needs attention. Ask your administrator to restore it; use the delivery controls above to check its status.</div>
            <div t-else="" class="jb-manual"><p>Direct publishing is optional. Follow these three steps to post this advert yourself.</p><ol><li><strong>Copy your advert</strong><p>Paste it into a job posting in your company’s <t t-esc="state.channel.name"/> employer account.</p><button class="jb-button" t-on-click="() => this.copy(this.packedAdvert)">Copy advert and application link</button></li><li><strong>Use this as the application link</strong><p>It opens the careers application form and records <t t-esc="state.channel.name"/> as the source. Select external applications on the board where supported.</p><div class="jb-copy"><input readonly="readonly" aria-label="Tracked application link" t-att-value="state.channel.link"/><button class="jb-button" t-on-click="() => this.copy(this.state.channel.link)">Copy link</button></div></li><li><strong>Come back with the live posting</strong><label>Published job URL<input type="url" t-model="state.externalUrl" placeholder="https://…"/></label><small>This records the posting you created. It does not publish to the board.</small></li></ol></div>
          </t>
          <label class="jb-check"><input type="checkbox" t-model="state.confirmed"/><span t-esc="automatic ? 'I have reviewed the advert, destination and any provider charges.' : 'I have published this job on the board using the tracked application link.'"/></label>
          <div t-if="!state.panel.on_page" class="jb-alert">Publish the careers page first to enable applications.</div>
          <button t-if="state.channel.live and !state.channel.api_managed" class="jb-text" t-on-click="closeManual" t-att-disabled="state.busy">I removed this listing from the board — record closure</button>
          <div class="jb-actions"><button class="jb-button" t-on-click="() => { this.state.step=1; }" t-att-disabled="state.busy">← Edit advert</button><button class="jb-button primary" t-on-click="submit" t-att-disabled="state.busy || !state.confirmed || !state.panel.on_page || pending || (!automatic &amp;&amp; (!state.externalUrl || state.channel.api_managed))" t-esc="submitLabel"/></div>
        </section>
        <section t-if="state.step === 3" class="jb-surface jb-result" role="status"><span class="jb-orbit"><t t-out="ic('check',36)"/></span><h2 t-esc="automatic ? 'Your advert is on its way' : 'Posting recorded'"/><p t-esc="state.result"/><p><strong t-esc="state.channel.name"/> · <t t-esc="state.channel.api_managed ? state.channel.delivery_state : 'Posted manually'"/> · <t t-esc="state.channel.apps"/> applications</p><div class="jb-actions"><button class="jb-button" t-on-click="refresh">Back to boards</button><button t-if="state.channel.api_managed" class="jb-button primary" t-on-click="manage">Check provider status</button></div></section>
      </t>
    </t>
    </t>
  </div>
</t>
<t t-name="pb_hiring.BoardCatalogue">
  <section class="jb-catalogue-intro"><div><span class="jb-eyebrow">India · Vietnam · Indonesia</span><h2>The right audience for every role</h2><p>Choose a destination to see how it works and who handles each setup step. Payobook manages the integration; your company authorizes its employer account.</p></div><span class="jb-total"><strong t-esc="state.catalogue.length"/> destinations</span></section>
  <div class="jb-filters"><label>Country<select t-model="state.country"><option value="">All three countries</option><option value="IN">India</option><option value="VN">Vietnam</option><option value="ID">Indonesia</option></select></label><label>Find a board<input type="search" t-model="state.boardQuery" placeholder="Board name or hiring audience"/></label><label>Connection method<select t-model="state.routeFilter"><option value="">All methods</option><option value="api">Account connection</option><option value="feed">Job feed</option><option value="partner">Partner onboarding</option><option value="discovery">Search discovery</option></select></label></div>
  <p class="jb-footnote"><t t-esc="catalogueBoards.length"/> destinations match. “Partner onboarding” means automatic publishing is not available yet. Manual adverts can still use tracked application links where the board permits them.</p>
  <div class="jb-grid"><article t-foreach="catalogueBoards" t-as="board" t-key="board.key" class="jb-board">
    <div class="jb-board-top"><span t-att-class="'jb-logo ' + board.key" t-esc="board.key === 'linkedin' ? 'in' : board.name.slice(0,2)"/><span class="jb-badge" t-att-class="{live:board.ready}" t-esc="board.status"/></div>
    <h3 t-esc="board.name"/><p t-esc="board.audience"/><small t-esc="board.country_label"/>
    <div class="jb-board-meta"><span t-esc="routeLabel(board.route)"/><span t-esc="board.enabled ? 'Enabled in catalogue' : 'Hidden from roles'"/></div>
    <small t-if="board.onboarding_stage !== 'not_started'" t-esc="board.onboarding_label"/>
    <button class="jb-button primary" t-on-click="() => this.guide(board.key)" t-att-disabled="state.busy">View setup guide →</button>
  </article></div>
  <div t-if="!catalogueBoards.length" class="jb-welcome"><h3>No matching boards</h3><p>Try another country, name or connection method.</p></div>
</t>
<t t-name="pb_hiring.BoardGuide">
  <section class="jb-guide jb-surface">
    <button class="jb-text" t-on-click="() => { this.state.guide=null; }" t-att-disabled="state.busy">← Back to job boards</button>
    <div class="jb-section-title"><div><span class="jb-eyebrow" t-esc="routeLabel(state.guide.route)"/><h2 t-esc="state.guide.name"/></div><a t-att-href="state.guide.url" target="_blank" rel="noopener noreferrer" class="jb-text">Provider information ↗</a></div>
    <p t-esc="state.guide.evidence"/>
    <div class="jb-responsibilities"><section><span class="jb-eyebrow">1 · Payobook handles</span><p t-esc="state.guide.platform"/></section><section><span class="jb-eyebrow">2 · Your company provides</span><p t-esc="state.guide.customer"/></section></div>
    <section><span class="jb-eyebrow">3 · Test before activation</span><p>Use provider-approved test resources. Verify job creation, update and closure, the application route and correct source attribution. Provider approval and successful tests are required before enabling automatic publishing.</p></section>
    <div t-if="state.guide.route === 'api'" class="jb-alert"><p>The connector is implemented. Complete employer setup and Payobook partner activation in Connected accounts.</p><button t-if="state.can_setup" class="jb-button" t-on-click="connections">Open connected accounts</button></div>
    <div t-elif="state.guide.route === 'partner'" class="jb-alert">Payobook must finish partner onboarding and the connector before this board can publish automatically. Saving a provider response below does not activate it.</div>
    <t t-if="state.guide.route !== 'discovery'">
      <details class="jb-request"><summary>Prepared request for the provider</summary><p>Copy this message for your account manager or the provider’s official contact form. Nothing is sent from this screen.</p><textarea readonly="readonly" rows="12" aria-label="Provider onboarding request" t-att-value="state.guide.request_text"/><button class="jb-button" t-on-click="() => this.copy(this.state.guide.request_text)">Copy request</button></details>
    </t>
    <t t-if="state.guide.can_setup">
      <div class="jb-setup-fields"><label class="jb-check"><input type="checkbox" t-model="state.guide.enabled"/><span>Offer this destination for eligible roles</span></label>
        <div class="jb-columns"><label>Onboarding progress<select t-model="state.guide.onboarding_stage"><option value="not_started">Not started</option><option value="requested">Request sent</option><option value="in_review">Discussing with provider</option><option value="response_received">Provider response received</option></select></label><label>Progress notes<textarea t-model="state.guide.onboarding_note" rows="3" maxlength="2000" placeholder="Contact, next step and document location. No passwords or API keys."/></label></div>
        <t t-if="state.guide.route === 'feed'">
          <label class="jb-check"><input type="checkbox" t-model="state.guide.feed_enabled"/><span><strong>Enable this company’s job feed</strong><small>Only roles explicitly included under Publish jobs will appear. The feed contains public adverts and tracked apply links; no candidate data. Confirm provider acceptance separately.</small></span></label>
          <div t-foreach="state.guide.feeds" t-as="feed" t-key="feed.id" class="jb-feed-url"><strong t-esc="feed.name"/><p><t t-esc="feed.count"/> eligible jobs currently included</p><div t-if="feed.url" class="jb-copy"><input readonly="readonly" aria-label="Job feed URL" t-att-value="feed.url"/><button class="jb-button" t-on-click="() => this.copy(feed.url)">Copy feed URL</button></div><p t-if="feed.note" t-esc="feed.note"/></div>
          <p class="jb-footnote">Save to generate feed links. Share a link only with the agreed provider. Disabling and re-enabling the feed replaces its link. Removing a job can take time to reach a board.</p>
        </t>
        <button class="jb-button primary" t-on-click="saveSetup" t-att-disabled="state.busy">Save setup progress</button>
      </div>
    </t>
    <p t-else="" class="jb-footnote">Your hiring administrator can update onboarding and account setup. You can use this guide to prepare the next steps.</p>
  </section>
</t>
</templates>
