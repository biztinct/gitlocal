#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Assignment brief"
msgstr "Đề bài tập"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Ready for a considered decision."
msgstr "Sẵn sàng cho một quyết định thấu đáo."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Sending it in is your agreement. The Head of HR agrees it next; the role does not wait for it — only the offer does."
msgstr "Gửi đi nghĩa là bạn đồng ý. Tiếp theo Trưởng phòng nhân sự sẽ đồng ý; vị trí không cần chờ bước này — chỉ lời mời nhận việc phải chờ."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Annual budget for this request"
msgstr "Ngân sách năm cho yêu cầu này"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Budget currency"
msgstr "Đơn vị tiền tệ ngân sách"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "When should the position be closed?"
msgstr "Khi nào nên đóng vị trí?"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "← Back"
msgstr "← Quay lại"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_board_p1.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_forms.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p5.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p6.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p7.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Cancel"
msgstr "Huỷ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Continue →"
msgstr "Tiếp tục →"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Write the advert"
msgstr "Viết tin tuyển dụng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "This is what a candidate reads.\n                 Share it with the manager for their comments, then make it\n                 final; the final one goes onto the careers page word for\n                 word."
msgstr "Đây là nội dung ứng viên sẽ đọc.\nChia sẻ với quản lý để lấy góp ý, rồi chốt bản\ncuối; bản cuối được đưa lên trang tuyển dụng\nnguyên văn."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Job title"
msgstr "Chức danh"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "The one-line version"
msgstr "Bản tóm tắt một dòng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "One sentence a candidate would read on a list of jobs"
msgstr "Một câu ứng viên sẽ đọc trong danh sách việc làm"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Company story · included automatically"
msgstr "Câu chuyện công ty · tự động thêm vào"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Save this version"
msgstr "Lưu phiên bản này"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Better suited to another role"
msgstr "Phù hợp hơn với vị trí khác"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "moves onto the other role and\n                starts at its first stage. Both roles get a note saying so."
msgstr "được chuyển sang vị trí kia và\nbắt đầu ở giai đoạn đầu tiên. Cả hai vị trí đều có ghi chú về việc này."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Which role"
msgstr "Vị trí nào"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Pick one…"
msgstr "Chọn một…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Move them"
msgstr "Chuyển"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Arrange an interview with"
msgstr "Sắp xếp phỏng vấn với"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Everybody gets an invitation with a\n                 calendar file. Payobook reminds them the day before and again\n                 half an hour before, and afterwards each person on the panel\n                 gets their own link to say what they thought."
msgstr "Mọi người nhận thư mời kèm tệp\nlịch. Payobook nhắc họ trước một ngày và một lần nữa\ntrước nửa giờ, sau đó mỗi người trong hội đồng\nnhận đường dẫn riêng để cho ý kiến."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p6.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "When"
msgstr "Thời gian"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "How long, in minutes"
msgstr "Thời lượng (phút)"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Which stage of this role"
msgstr "Giai đoạn nào của vị trí này"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Not one of the agreed stages"
msgstr "Không thuộc các giai đoạn đã thống nhất"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "How it happens"
msgstr "Hình thức"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Where, or the link to the call"
msgstr "Địa điểm, hoặc đường dẫn cuộc gọi"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Meeting room 2, the site office, or a video link"
msgstr "Phòng họp 2, văn phòng công trường, hoặc đường dẫn gọi video"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Who is on the panel"
msgstr "Thành viên hội đồng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Type a name…"
msgstr "Nhập tên…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Arrange it and invite everybody"
msgstr "Sắp xếp và mời mọi người"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Move the interview with"
msgstr "Dời lịch phỏng vấn với"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "The old time is called off and\n                 everybody is told, then the new invitation goes out. The old\n                 round stays on the record so the history is whole."
msgstr "Lịch cũ bị huỷ và\nmọi người được thông báo, sau đó thư mời mới được gửi đi. Vòng\ncũ vẫn được lưu để lịch sử đầy đủ."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Moving to"
msgstr "Dời sang"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Whose side moved it"
msgstr "Bên nào dời lịch"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Say which…"
msgstr "Chọn…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Why it is moving"
msgstr "Lý do dời lịch"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "In six weeks nobody will remember, and this is the only place the answer will be."
msgstr "Sáu tuần nữa sẽ không ai nhớ, và đây là nơi duy nhất lưu câu trả lời."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Move it and tell everybody"
msgstr "Dời lịch và báo mọi người"

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/models/analytics.py:0
#: code:addons/pb_hiring/models/analytics_p6.py:0
#: code:addons/pb_hiring/models/board_p1.py:0
#: code:addons/pb_hiring/models/hiring_common.py:0
msgid "Nobody came"
msgstr "Không ai đến"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "The round with"
msgstr "Vòng với"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "is closed and the opinions\n                 nobody can now give are closed with it. An unexplained empty\n                 hour teaches nobody anything, so this one asks whose side."
msgstr "đã đóng và các ý kiến\nkhông ai còn đưa ra được cũng đóng theo. Một giờ trống không rõ lý do\nkhông giúp ai rút kinh nghiệm, nên ở đây cần biết do bên nào."

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/models/analytics.py:0
#: code:addons/pb_hiring/models/analytics_p6.py:0
msgid "Who did not come"
msgstr "Ai không đến"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "What happened"
msgstr "Chuyện gì đã xảy ra"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Optional. Anything that would change what we do next time."
msgstr "Không bắt buộc. Bất cứ điều gì giúp lần sau làm khác đi."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Write it down"
msgstr "Ghi lại"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "What did we decide about"
msgstr "Chúng ta đã quyết định gì về"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Write it down while everybody still\n                 remembers it. Choosing “We want them” marks this candidate as\n                 the one, and the offer starts from there."
msgstr "Hãy ghi lại khi mọi người còn\nnhớ. Chọn “Chúng tôi muốn nhận” sẽ đánh dấu ứng viên này là\nngười được chọn, và lời mời nhận việc bắt đầu từ đó."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "What was decided"
msgstr "Quyết định"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "What the panel agreed"
msgstr "Điều hội đồng đã thống nhất"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "What was said in the room. The scores are already recorded — this is the part they do not capture."
msgstr "Những gì đã trao đổi trong buổi gặp. Điểm số đã được ghi lại — đây là phần điểm số không thể hiện."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Record the decision"
msgstr "Ghi lại quyết định"

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_board_p1.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p5.xml:0
#: code:addons/pb_hiring/models/hiring_common.py:0
msgid "Not this time"
msgstr "Lần này chưa phù hợp"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "is told, kindly and in plain\n                words. It is a small thing and almost nobody does it."
msgstr "được thông báo, nhẹ nhàng và bằng lời\nlẽ đơn giản. Đó là một việc nhỏ mà hầu như không ai làm."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Why, for our own records"
msgstr "Lý do, để chúng ta lưu lại"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Tell them"
msgstr "Báo cho họ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Write down what was actually\n                 found, not whether it was good. In a year this sentence is\n                 the whole of what anybody will know."
msgstr "Ghi lại những gì thực sự\nphát hiện được, không phải tốt hay xấu. Một năm nữa, câu này\nlà tất cả những gì mọi người biết."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "What came back"
msgstr "Kết quả trả về"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "What was found"
msgstr "Những gì phát hiện được"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "They confirmed the dates but not the job title."
msgstr "Họ xác nhận thời gian làm việc nhưng không xác nhận chức danh."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Go ahead anyway"
msgstr "Vẫn tiếp tục"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Something came back on this check.\n                 An offer can still be made — say why, and what you say is\n                 kept with the check for ever."
msgstr "Lần kiểm tra này có phát hiện.\nVẫn có thể gửi lời mời nhận việc — hãy nêu lý do, và những gì bạn viết\nsẽ được lưu mãi cùng lần kiểm tra."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Why we are going ahead"
msgstr "Lý do vẫn tiếp tục"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "The previous employer will only confirm dates as a matter of policy. The candidate told us this before we asked."
msgstr "Theo chính sách, công ty cũ chỉ xác nhận thời gian làm việc. Ứng viên đã báo trước khi chúng tôi hỏi."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Go ahead"
msgstr "Tiếp tục"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Change this line"
msgstr "Sửa dòng này"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Add a line"
msgstr "Thêm một dòng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Use the word a candidate would use.\n                 \"Basic pay\", \"Lunch allowance\", \"Sign-on bonus\" — never a\n                 component code."
msgstr "Dùng từ mà ứng viên sẽ dùng.\n\"Lương cơ bản\", \"Phụ cấp ăn trưa\", \"Thưởng khi nhận việc\" — không bao giờ dùng\nmã khoản lương."

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_p6.xml:0
#: code:addons/pb_hiring/models/offer_approval.py:0
msgid "What it is"
msgstr "Nội dung"

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/models/offer.py:0
msgid "Basic pay"
msgstr "Lương cơ bản"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Kind"
msgstr "Loại"

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/models/offer_approval.py:0
msgid "How often"
msgstr "Tần suất"

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
#: code:addons/pb_hiring/models/offer_approval.py:0
msgid "Amount"
msgstr "Số tiền"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Note, if it needs one"
msgstr "Ghi chú, nếu cần"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Paid with the first full month's salary."
msgstr "Trả cùng lương của tháng làm việc đủ đầu tiên."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "Save the line"
msgstr "Lưu dòng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "The letter, as it will read"
msgstr "Thư, đúng như khi người nhận đọc"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "If a placeholder is still showing\n                 on the page instead of a name or a number, the letter\n                 template has a hole this offer cannot fill — change the\n                 wording under Lifecycle."
msgstr "Nếu một chỗ cần điền vẫn hiện\ntrên trang thay vì tên hoặc con số, mẫu thư\ncó một chỗ trống mà lời mời này không điền được — hãy sửa\nnội dung ở mục Vòng đời."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_board.xml:0
msgid "The PDF"
