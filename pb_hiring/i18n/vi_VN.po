#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Type the new tag"
msgstr "Nhập thẻ mới"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "After"
msgstr "Sau"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Right away"
msgstr "Ngay lập tức"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "After hours"
msgstr "Sau vài giờ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "After days"
msgstr "Sau vài ngày"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Once per candidate (off: every time it happens)"
msgstr "Một lần cho mỗi ứng viên (tắt: mỗi lần sự việc xảy ra)"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Try it on a candidate"
msgstr "Thử trên một ứng viên"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Nothing is sent and nothing changes."
msgstr "Không gửi gì và không thay đổi gì."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Pick somebody"
msgstr "Chọn một người"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Type a candidate's name…"
msgstr "Nhập tên ứng viên…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Nobody by that name."
msgstr "Không có ai tên như vậy."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Save and switch on"
msgstr "Lưu và bật"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Open “%s”"
msgstr "Mở “%s”"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "On. Press to switch it off."
msgstr "Đang bật. Bấm để tắt."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Off. Press to switch it on."
msgstr "Đang tắt. Bấm để bật."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_p8.xml:0
msgid "Puts %s where the cursor is"
msgstr "Chèn %s vào vị trí con trỏ"

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
#: code:addons/pb_hiring/static/src/js/hiring_privacy_p4.js:0
#: code:addons/pb_hiring/models/facade_p4.py:0
msgid "Shared with you"
msgstr "Được chia sẻ với bạn"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "The recruiter chose what you see for each person. Open one to read it."
msgstr "Chuyên viên tuyển dụng đã chọn những gì bạn được xem về từng người. Mở một người để đọc."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Shared with"
msgstr "Đã chia sẻ với"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Nobody outside the hiring team sees this person. Share the parts a manager needs."
msgstr "Ngoài nhóm tuyển dụng, không ai xem được người này. Hãy chia sẻ những phần quản lý cần."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "You can see where they are on the board and when they are interviewed. Ask the recruiter if you need their CV or their answers."
msgstr "Bạn xem được họ đang ở đâu trên bảng và khi nào họ được phỏng vấn. Hãy hỏi chuyên viên tuyển dụng nếu bạn cần CV hoặc câu trả lời của họ."

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
#: code:addons/pb_hiring/static/src/js/hiring_privacy_p4.js:0
#: code:addons/pb_hiring/models/facade_p4.py:0
msgid "Not shared with you"
msgstr "Chưa được chia sẻ với bạn"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Recruiter notes"
msgstr "Ghi chú của chuyên viên tuyển dụng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Nothing written yet. What you write here is never on the timeline: only you and the talent lead read it, unless you share one note."
msgstr "Chưa có ghi chú nào. Những gì bạn viết ở đây không bao giờ hiện trên dòng thời gian: chỉ bạn và trưởng nhóm tuyển dụng đọc được, trừ khi bạn chia sẻ một ghi chú."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Share with"
msgstr "Chia sẻ với"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Comfortable at 28m; would move for 30m."
msgstr "Ổn ở mức 28 triệu; sẽ chuyển việc nếu 30 triệu."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Add a private note"
msgstr "Thêm ghi chú riêng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Anonymised on"
msgstr "Đã ẩn danh ngày"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "· their numbers stay in Hiring numbers"
msgstr "· số liệu của họ vẫn nằm trong Số liệu tuyển dụng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "kept longer by"
msgstr "được giữ lâu hơn bởi"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "What the hiring manager sees by default"
msgstr "Những gì quản lý tuyển dụng xem được theo mặc định"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Each new candidate on this role is shared like this. Changing it never changes what was already shared."
msgstr "Mỗi ứng viên mới của vị trí này được chia sẻ như vậy. Thay đổi ở đây không làm thay đổi những gì đã chia sẻ."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "The talent lead sets it."
msgstr "Trưởng nhóm tuyển dụng thiết lập mục này."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "On this role:"
msgstr "Ở vị trí này:"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Nobody is named as the hiring manager on this role yet, so nothing is shared by default."
msgstr "Vị trí này chưa có quản lý tuyển dụng nên mặc định không chia sẻ gì."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "The Resume bank could not be opened"
msgstr "Không mở được kho ứng viên"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Search a name, a skill, a role, a tag…"
msgstr "Tìm tên, kỹ năng, vị trí, thẻ…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Off: Future-fit people and talent pools. On: everybody who ever applied."
msgstr "Tắt: người Phù hợp về sau và các nhóm nhân tài. Bật: tất cả những ai từng ứng tuyển."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Everybody who ever applied"
msgstr "Tất cả những ai từng ứng tuyển"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Nobody matches that"
msgstr "Không có ai phù hợp"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Try fewer words, or clear the filters. Switch on \"Everybody who ever applied\" to search every application, not only the people kept for later."
msgstr "Thử ít từ hơn, hoặc bỏ bộ lọc. Bật \"Tất cả những ai từng ứng tuyển\" để tìm trong mọi hồ sơ, không chỉ những người được giữ lại cho sau này."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Clear the search"
msgstr "Xoá tìm kiếm"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Nobody has been kept for later yet"
msgstr "Chưa có ai được giữ lại cho sau này"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "The first look puts people here: press \"Future-fit\" on a candidate who is not right for this role but could be for the next one. They wait here, searchable by skill, country and tag, until their consent runs out."
msgstr "Bước xem lần đầu đưa người vào đây: bấm \"Phù hợp về sau\" với ứng viên chưa hợp vị trí này nhưng có thể hợp vị trí sau. Họ được lưu ở đây, tìm được theo kỹ năng, quốc gia và thẻ, cho đến khi sự đồng ý của họ hết hạn."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Search everybody who ever applied"
msgstr "Tìm trong tất cả những ai từng ứng tuyển"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Tick everybody on this page"
msgstr "Đánh dấu tất cả trên trang này"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Person"
msgstr "Người"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Last role"
msgstr "Vị trí gần nhất"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Skills and tags"
msgstr "Kỹ năng và thẻ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
#: code:addons/pb_hiring/static/src/js/hiring_privacy_p4.js:0
msgid "Came from"
msgstr "Nguồn"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Kept until"
msgstr "Giữ đến"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "· applied"
msgstr "· ứng tuyển"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "No skills or tags yet"
msgstr "Chưa có kỹ năng hay thẻ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Copy them into a role's Applications received"
msgstr "Sao chép họ vào Hồ sơ đã nhận của một vị trí"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Add to a role"
msgstr "Thêm vào vị trí"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Tag them"
msgstr "Gắn thẻ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Previous"
msgstr "Trước"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Selected people"
msgstr "Người đã chọn"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "selected"
msgstr "đã chọn"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
#: code:addons/pb_hiring/static/src/js/hiring_privacy_p4.js:0
msgid "Tag"
msgstr "Gắn thẻ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Esc clear"
msgstr "Esc bỏ chọn"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Tick who, then what. They see exactly that and nothing else; everything else stays a lock. You can undo it for five seconds."
msgstr "Đánh dấu ai, rồi đến nội dung gì. Họ chỉ xem đúng phần đó, còn lại vẫn bị khoá. Bạn có thể hoàn tác trong năm giây."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Nobody is named on this role yet. Search for the person below."
msgstr "Vị trí này chưa có ai được chỉ định. Hãy tìm người đó bên dưới."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Portal login only — cannot open the board"
msgstr "Chỉ có tài khoản cổng thông tin — không mở được bảng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Somebody else — type a name…"
msgstr "Người khác — nhập tên…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "What they see"
msgstr "Những gì họ xem được"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Always: the name, the stage and interview dates"
msgstr "Luôn có: tên, giai đoạn và ngày phỏng vấn"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Expected pay is money: only tick it when they need it."
msgstr "Mức lương mong muốn là chuyện tiền bạc: chỉ đánh dấu khi họ cần."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Share"
msgstr "Chia sẻ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "to a role"
msgstr "vào vị trí"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "A copy lands in the role's Applications received, CV and all. Their old application stays where it is."
msgstr "Một bản sao, kèm cả CV, sẽ vào Hồ sơ đã nhận của vị trí. Hồ sơ cũ của họ vẫn giữ nguyên."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Find a role…"
msgstr "Tìm vị trí…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "No open role matches. Open a role first, then add them."
msgstr "Không có vị trí đang mở nào phù hợp. Hãy mở một vị trí trước, rồi thêm họ."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Add to the role"
msgstr "Thêm vào vị trí"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "\"Keep in touch\", a market, a skill word — whatever helps the next search."
msgstr "\"Giữ liên lạc\", một thị trường, một kỹ năng — bất cứ gì giúp lần tìm sau."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "A tag already in use"
msgstr "Thẻ đang dùng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Or a new one"
msgstr "Hoặc thẻ mới"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Keep in touch"
msgstr "Giữ liên lạc"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Stop sharing with %s"
msgstr "Ngừng chia sẻ với %s"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Shared — press to make it private again"
msgstr "Đã chia sẻ — bấm để chuyển lại thành riêng tư"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Share this note with %s"
msgstr "Chia sẻ ghi chú này với %s"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Country not given"
msgstr "Chưa có quốc gia"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_privacy_p4.xml:0
msgid "Take the tag %s off"
msgstr "Gỡ thẻ %s"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Asked of"
msgstr "Đã gửi cho"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "· reminded every"
msgstr "· nhắc mỗi"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "working days"
msgstr "ngày làm việc"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "they have started it"
msgstr "họ đã bắt đầu điền"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Waiting on"
msgstr "Đang chờ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "to press Agree"
msgstr "bấm Đồng ý"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Agreed."
msgstr "Đã đồng ý."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Still to fill in before it can be sent:"
msgstr "Cần điền thêm trước khi gửi được:"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "The budget figures are with the hiring team."
msgstr "Số liệu ngân sách do nhóm tuyển dụng nắm giữ."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Expected (the manager's)"
msgstr "Dự kiến (của quản lý)"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Confirmed with Finance"
msgstr "Đã xác nhận với Tài chính"

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
#: code:addons/pb_hiring/models/analytics.py:0
msgid "Not recorded"
msgstr "Chưa ghi nhận"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "What it is compared with"
msgstr "So sánh với"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Budget conversation"
msgstr "Trao đổi về ngân sách"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Told when a request is over budget:"
msgstr "Được báo khi yêu cầu vượt ngân sách:"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Off the careers page, off referrals and out of every list; seen only by the hiring team, the person it is for and who they would report to."
msgstr "Không hiện trên trang tuyển dụng, không nhận giới thiệu và không có trong danh sách nào; chỉ nhóm tuyển dụng, người đề xuất vị trí và người mà vị trí này sẽ báo cáo mới thấy."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "The advert"
msgstr "Tin tuyển dụng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "From a template…"
msgstr "Từ mẫu…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "· suggested"
msgstr "· gợi ý"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Start"
msgstr "Bắt đầu"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Write one"
msgstr "Tự viết"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "The advert changed since the job boards' packs were made."
msgstr "Tin tuyển dụng đã thay đổi kể từ khi tạo bộ tin cho các trang việc làm."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "No advert yet. Start from a template for this kind of role (the suggested one fits its department), share it with the manager for input, then make it final.\n      Publishing without one writes it from the suggested template."
msgstr "Chưa có tin tuyển dụng. Hãy bắt đầu từ một mẫu cho loại vị trí này (mẫu gợi ý phù hợp với phòng ban của vị trí), chia sẻ với quản lý để góp ý, rồi chốt bản cuối.\n      Nếu đăng tin khi chưa có, hệ thống sẽ viết tin từ mẫu gợi ý."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "v"
msgstr "v"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Final"
msgstr "Bản cuối"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Draft"
msgstr "Bản nháp"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "· shared with"
msgstr "· đã chia sẻ với"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "· final"
msgstr "· chốt bản cuối"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "OPEN A ROLE"
msgstr "MỞ VỊ TRÍ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Five things, and the role exists."
msgstr "Chỉ cần năm thông tin là có vị trí."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "The stages and the application form fill in from the department and country. You can publish it and meet candidates straight away — the hiring request only matters when you send an offer."
msgstr "Các giai đoạn và mẫu đơn ứng tuyển được điền sẵn theo phòng ban và quốc gia. Bạn có thể đăng tin và gặp ứng viên ngay — yêu cầu tuyển dụng chỉ cần khi bạn gửi lời mời nhận việc."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "What is the role called?"
msgstr "Tên vị trí là gì?"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Territory Manager"
msgstr "Quản lý khu vực"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Choose…"
msgstr "Chọn…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "How many seats?"
msgstr "Cần tuyển bao nhiêu người?"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Who recruits it?"
msgstr "Ai phụ trách tuyển?"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "The hiring rule for the country decides"
msgstr "Theo quy tắc tuyển dụng của quốc gia"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Ask a manager for a hiring request"
msgstr "Nhờ quản lý lập yêu cầu tuyển dụng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "ASK A MANAGER"
msgstr "NHỜ QUẢN LÝ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "The request for"
msgstr "Yêu cầu cho"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "A hiring request, from the manager"
msgstr "Yêu cầu tuyển dụng, do quản lý lập"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "They get one page by email that saves as they type — no sign-in. Sending it in is their agreement. They are reminded until they do, and the talent lead is told after three working days."
msgstr "Họ nhận một trang qua email, tự lưu khi họ gõ — không cần đăng nhập. Gửi trang này đi nghĩa là họ đồng ý. Họ sẽ được nhắc cho đến khi gửi, và trưởng nhóm tuyển dụng được báo sau ba ngày làm việc."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "has no email address,"
msgstr "không có địa chỉ email,"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "so nothing was sent. Send them this link however you like — it is the whole request."
msgstr "nên chưa có gì được gửi. Hãy gửi đường dẫn này cho họ theo cách bạn muốn — đó là toàn bộ yêu cầu."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Which manager?"
msgstr "Quản lý nào?"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "no email — you will get their link to send"
msgstr "không có email — bạn sẽ nhận đường dẫn để tự gửi cho họ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "This department"
msgstr "Phòng ban này"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Nobody by that name. Try part of it."
msgstr "Không có ai tên như vậy. Hãy thử gõ một phần tên."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "A line for them (optional)"
msgstr "Lời nhắn cho họ (không bắt buộc)"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Budi — could you complete this by Friday? It is the second territory role we talked about."
msgstr "Budi ơi — bạn hoàn thành giúp trước thứ Sáu nhé? Đây là vị trí khu vực thứ hai mình đã bàn."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Remind them every"
msgstr "Nhắc họ mỗi"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "working day"
msgstr "ngày làm việc"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "2 working days"
msgstr "2 ngày làm việc"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "3 working days"
msgstr "3 ngày làm việc"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "week"
msgstr "tuần"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "The role itself carries on; only the offer waits. The recruiter gets a to-do."
msgstr "Vị trí vẫn tiếp tục; chỉ có lời mời nhận việc phải chờ. Chuyên viên tuyển dụng sẽ nhận một việc cần làm."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Why? (optional)"
msgstr "Lý do? (không bắt buộc)"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Not this quarter — ask again in January."
msgstr "Chưa phải quý này — hãy hỏi lại vào tháng Một."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Confirmed budget"
msgstr "Ngân sách đã xác nhận"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "The confirmed budget"
msgstr "Ngân sách đã xác nhận"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "What Finance confirmed for this role for a year. If the manager's figure is higher, the people who watch the budget are told. Nothing is blocked."
msgstr "Số tiền Tài chính đã xác nhận cho vị trí này trong một năm. Nếu con số của quản lý cao hơn, những người theo dõi ngân sách sẽ được báo. Không có gì bị chặn."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Confirmed a year ("
msgstr "Đã xác nhận mỗi năm ("

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Remind now works again in a few minutes"
msgstr "Có thể nhắc lại sau vài phút"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Remind now works again in %s minutes"
msgstr "Có thể nhắc lại sau %s phút"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Still to fill in: %s"
msgstr "Cần điền thêm: %s"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Not given yet"
msgstr "Chưa cung cấp"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "No budget to compare with"
msgstr "Không có ngân sách để so sánh"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Email it to %s with a page to comment on"
msgstr "Gửi email cho %s kèm một trang để góp ý"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_requests_p3.xml:0
msgid "Nobody is named on this role yet"
msgstr "Vị trí này chưa có ai được chỉ định"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Tell colleagues when a role opens to referrals"
msgstr "Báo cho đồng nghiệp khi một vị trí mở nhận giới thiệu"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "On: everyone with a login gets one short email with a \"Refer someone\" button. Confidential roles are never announced."
msgstr "Bật: mọi người có tài khoản đăng nhập nhận một email ngắn kèm nút \"Giới thiệu ai đó\". Vị trí bảo mật không bao giờ được thông báo."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Sign-offs record and tell; nothing waits for them. The one thing that waits is sending an offer, until the role's request is agreed."
msgstr "Các bước phê duyệt chỉ ghi nhận và thông báo; không có gì phải chờ chúng. Việc duy nhất phải chờ là gửi lời mời, cho đến khi yêu cầu tuyển dụng của vị trí được đồng ý."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Who is told when a request is over budget"
msgstr "Ai được báo khi yêu cầu vượt ngân sách"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Usually the CEO, the Head of HR and Finance. They get an email and a to-do; nothing is blocked."
msgstr "Thường là Giám đốc điều hành, Trưởng phòng nhân sự và bộ phận Tài chính. Họ nhận một email và một việc cần làm; không có gì bị chặn."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Add somebody — type a name…"
msgstr "Thêm người — nhập tên…"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "A second person who agrees every hiring request"
msgstr "Người thứ hai đồng ý mọi yêu cầu tuyển dụng"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "The Head of HR agrees each request after the manager sends it in. Name somebody here only if the company wants a second agreement."
msgstr "Trưởng phòng nhân sự đồng ý từng yêu cầu sau khi quản lý gửi lên. Chỉ chọn người ở đây nếu công ty muốn có thêm một lần đồng ý."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Nobody — the Head of HR is enough"
msgstr "Không ai — Trưởng phòng nhân sự là đủ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "When the candidate is asked for their papers"
msgstr "Khi nào ứng viên được yêu cầu nộp giấy tờ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Asking never holds the offer up. Two working days, a reminder a day, and the talent lead is told when they are late."
msgstr "Việc yêu cầu không bao giờ làm chậm lời mời. Hạn hai ngày làm việc, mỗi ngày nhắc một lần, và trưởng nhóm tuyển dụng được báo khi ứng viên nộp trễ."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Hiring emails come from"
msgstr "Email tuyển dụng được gửi từ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Every hiring email uses this address, never the person who pressed the button."
msgstr "Mọi email tuyển dụng đều dùng địa chỉ này, không bao giờ dùng địa chỉ của người bấm nút."

#. module: pb_hiring
#. odoo-javascript
#. odoo-python
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
#: code:addons/pb_hiring/models/facade_p4.py:0
msgid "Consent & retention"
msgstr "Sự đồng ý & thời hạn lưu trữ"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Every candidate ticks a consent sentence when they apply. That day starts a clock: when their market's months are up, the clean-up takes their name, contact details, answers and files out, and keeps the numbers. Hired people, anyone still in play and anyone with a live offer are never touched."
msgstr "Mỗi ứng viên đánh dấu vào câu đồng ý khi nộp hồ sơ. Ngày đó bắt đầu tính giờ: khi hết số tháng của thị trường của họ, quá trình dọn dữ liệu sẽ xoá tên, thông tin liên hệ, câu trả lời và tệp của họ, và giữ lại các số liệu. Người đã được tuyển, người còn trong quy trình và người có lời mời đang hiệu lực không bao giờ bị động đến."

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "The clean-up runs every night"
msgstr "Dọn dữ liệu chạy mỗi đêm"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "The clean-up is switched off"
msgstr "Dọn dữ liệu đang tắt"

#. module: pb_hiring
#. odoo-javascript
#: code:addons/pb_hiring/static/src/xml/hiring_setup.xml:0
msgid "Next run"
