#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "How did the conversation go?"
msgstr "Buổi trao đổi diễn ra thế nào?"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Two or three sentences a hiring manager can read in ten seconds."
msgstr "Hai hoặc ba câu mà quản lý tuyển dụng đọc được trong mười giây."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Overall fit"
msgstr "Mức độ phù hợp chung"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: you would put them in front of the panel tomorrow."
msgstr "Năm sao: bạn sẵn sàng đưa họ gặp hội đồng ngay ngày mai."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Anything to check in the next round?"
msgstr "Có gì cần kiểm tra ở vòng tiếp theo không?"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "A doubt, a gap in the CV, a number to test."
msgstr "Một điểm nghi ngờ, một khoảng trống trong CV, một con số cần kiểm chứng."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Skills for the role"
msgstr "Kỹ năng cho vị trí"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: they have done this exact work well."
msgstr "Năm sao: họ đã làm tốt đúng công việc này."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Problem solving"
msgstr "Giải quyết vấn đề"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: given a problem they had never seen, they asked the right question first."
msgstr "Năm sao: gặp một vấn đề chưa từng thấy, họ đặt đúng câu hỏi ngay từ đầu."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Depth"
msgstr "Chiều sâu"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: they went two levels deeper than you asked."
msgstr "Năm sao: họ đi sâu hơn hai bậc so với câu bạn hỏi."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Strengths"
msgstr "Điểm mạnh"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Concerns"
msgstr "Điểm cần lưu ý"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Communication"
msgstr "Giao tiếp"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: a person outside their field would have followed every word."
msgstr "Năm sao: một người ngoài ngành cũng hiểu được từng lời họ nói."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Values and ways of working"
msgstr "Giá trị và cách làm việc"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: you would put them in a room with a difficult colleague without worrying."
msgstr "Năm sao: bạn yên tâm để họ làm việc cùng một đồng nghiệp khó tính."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Field readiness"
msgstr "Sẵn sàng làm việc thực địa"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: they could run a day in the field on their own next week."
msgstr "Năm sao: ngay tuần sau họ đã có thể tự mình đảm nhận một ngày làm việc thực địa."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Judgement in scenarios"
msgstr "Khả năng phán đoán theo tình huống"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: their answer to the scenario is the one you would give."
msgstr "Năm sao: câu trả lời của họ cho tình huống chính là câu trả lời bạn sẽ đưa ra."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Commercial reasoning"
msgstr "Tư duy kinh doanh"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: they found the money in the case without being led."
msgstr "Năm sao: họ tự tìm ra cơ hội doanh thu trong tình huống mà không cần gợi ý."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Stakeholder skills"
msgstr "Kỹ năng làm việc với các bên liên quan"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Five: you would send them to your hardest customer."
msgstr "Năm sao: bạn sẵn sàng cử họ gặp khách hàng khó tính nhất của mình."

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "Earlier scorecard"
msgstr "Phiếu đánh giá cũ"

#. module: pb_hiring
#. odoo-python
#: code:addons/pb_hiring/models/scorecards_p5.py:0
msgid "The five scored lines every interviewer used before scorecards."
msgstr "Năm tiêu chí chấm điểm mà mọi người phỏng vấn đã dùng trước khi có phiếu đánh giá."
