<odoo>
  <record id="cover_rule_connections_list" model="ir.ui.view">
    <field name="name">Cover approvers in hiring rules</field>
    <field name="model">pb.hiring.country.rule</field>
    <field name="inherit_id" ref="view_pb_hiring_country_rule_list"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="attributes"><attribute name="open_form_view">1</attribute></xpath>
      <xpath expr="//field[@name='recruiter_manager_id']" position="after">
        <field name="ta_lead_id" optional="show"/>
        <field name="cover_hr_fallback_id" optional="show"/>
        <field name="ta_absent_from" optional="hide"/>
        <field name="ta_absent_until" optional="hide"/>
      </xpath>
    </field>
  </record>
  <record id="action_hiring_connections" model="ir.actions.client"><field name="name">Hiring connections</field><field name="tag">pb_hiring_connections</field></record>
  <record id="view_visibility_policy_list" model="ir.ui.view"><field name="name">Hiring stage visibility</field><field name="model">pb.hiring.visibility.policy</field><field name="arch" type="xml">
    <list editable="bottom"><field name="company_id" groups="base.group_multi_company"/><field name="stage_id"/><field name="audience"/><field name="group_id" readonly="audience != 'group'" required="audience == 'group'"/><field name="profile"/><field name="cv"/><field name="portfolio"/><field name="assignment"/><field name="attachments"/><field name="answers"/><field name="scorecards"/><field name="expected_pay"/><field name="active" optional="hide"/></list>
  </field></record>
  <record id="action_visibility_policy" model="ir.actions.act_window"><field name="name">Candidate stage visibility</field><field name="res_model">pb.hiring.visibility.policy</field><field name="view_mode">list</field><field name="help" type="html"><p>Choose the parts visible at each stage to the candidate’s hiring manager, interview panel or a group that already has access to the hiring request. A matching policy replaces individual shares at that stage. Agencies keep their restricted portal. No matching policy means existing shares apply.</p></field></record>
  <record id="view_offer_cost_profile_list" model="ir.ui.view"><field name="name">Country offer setup list</field><field name="model">pb.hiring.cost.profile</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="country_id"/><field name="effective_from"/><field name="effective_to"/><field name="active"/></list></field></record>
  <record id="view_offer_cost_profile_form" model="ir.ui.view"><field name="name">Country offer setup form</field><field name="model">pb.hiring.cost.profile</field><field name="arch" type="xml"><form><sheet><div class="alert alert-info" role="status">An administrator selects a payroll calculation approved by HR/Finance. Offer estimates reuse its formulas. Missing inputs stop the calculation; no statutory rates are assumed.</div><group><group><field name="name"/><field name="company_id"/><field name="country_id"/><field name="effective_from"/><field name="effective_to"/><field name="active"/></group><group><field name="config_id"/><field name="gross_input_id"/><field name="employer_rule_ids" widget="many2many_tags"/><field name="letter_template_id"/><field name="company_signer_id"/></group></group><group><field name="defaults_json"/></group></sheet></form></field></record>
  <record id="action_offer_cost_profile" model="ir.actions.act_window"><field name="name">Country offer setup</field><field name="res_model">pb.hiring.cost.profile</field><field name="view_mode">list,form</field></record>
  <record id="cover_rule_connections_form" model="ir.ui.view"><field name="name">Cover designated approvers</field><field name="model">pb.hiring.country.rule</field><field name="inherit_id" ref="view_pb_hiring_country_rule_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Recruiter cover approval"><div class="alert alert-info" role="status" colspan="2">Cover goes to the designated TA Lead. The Head of HR fallback is used during the absence dates, when the lead is inactive, or when the lead is the requester. Self-approval is not allowed.</div><group><field name="ta_lead_id"/><field name="cover_hr_fallback_id"/></group><group><field name="ta_absent_from"/><field name="ta_absent_until"/></group></group></xpath></field></record>
  <record id="booking_form" model="ir.ui.view"><field name="name">Interview booking</field><field name="model">pb.hiring.booking</field><field name="arch" type="xml"><form><header><button name="action_find_slots" type="object" string="Find shared availability" class="btn-primary" invisible="state in ('booked','cancelled')"/><button name="action_cancel" type="object" string="Cancel invitation" invisible="state in ('booked','cancelled')"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="applicant_id"/><field name="company_id" invisible="1"/><field name="organiser_id" readonly="1"/><field name="panel_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]"/><field name="provider"/><field name="mode"/><field name="location"/></group><group><field name="date_from"/><field name="date_to"/><field name="duration"/><field name="tz"/><field name="hour_from"/><field name="hour_to"/><field name="expires_at"/></group></group><group invisible="state != 'ready'" string="Share with the candidate"><field name="booking_url" widget="CopyClipboardChar"/><div class="alert alert-info" role="status">Copy this private link into your candidate message. Availability is checked again when they book. Each invitation can be used once.</div></group><field name="interview_id" invisible="state != 'booked'"/><field name="slot_ids"><list create="0" delete="0"><field name="start"/><field name="stop"/></list></field></sheet></form></field></record>
  <record id="cv_review_form" model="ir.ui.view"><field name="name">CV extraction review</field><field name="model">pb.hiring.cv.review</field><field name="arch" type="xml"><form><div class="alert alert-info" role="status">Check these suggestions against the CV. Only listed skills are matched; unmatched sections stay blank. New skills use the first available proficiency level, which you should review separately.</div><group><field name="applicant_id"/><field name="skill_ids" widget="many2many_tags"/><field name="experience"/><field name="education"/><field name="replace_existing"/></group><notebook><page string="Extracted text"><field name="text"/></page></notebook><footer><button name="action_apply" type="object" string="Apply reviewed suggestions" class="btn-primary"/><button string="Close" special="cancel"/></footer></form></field></record>
  <record id="applicant_connections_form" model="ir.ui.view"><field name="name">Candidate connections</field><field name="model">hr.applicant</field><field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="CV and connections" name="pb_connections" groups="pb_hiring.group_hiring_user"><group><button name="action_extract_cv" type="object" string="Extract CV" class="btn-primary"/><button name="action_review_cv" type="object" string="Review extracted CV" invisible="pb_cv_state not in ('review','applied')"/><button name="action_booking_invitation" type="object" string="Find panel availability"/></group><group><group><field name="pb_cv_state" readonly="1"/><field name="pb_cv_note"/><field name="pb_cv_reviewed_by"/><field name="pb_cv_reviewed_at"/><field name="pb_cv_experience"/><field name="pb_cv_education"/></group><group string="Reminder preference"><field name="pb_whatsapp_opt_in"/><field name="pb_whatsapp_consent_note" required="pb_whatsapp_opt_in"/></group></group></page></xpath></field></record>
  <record id="offer_connections_form" model="ir.ui.view"><field name="name">Offer cost and signing</field><field name="model">pb.hiring.offer</field><field name="inherit_id" ref="view_pb_hiring_offer_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Country and employer cost" groups="pb_hiring.group_hiring_user"><group><button name="action_country_offer_setup" type="object" string="Use country setup"/><field name="pb_cost_profile_id"/><field name="pb_cost_inputs"/><button name="action_calculate_employer_cost" type="object" string="Calculate employer cost" class="btn-primary"/><field name="pb_cost_at"/><field name="pb_cost_result"/></group></page><page string="Electronic signing" groups="pb_hiring.group_hiring_user"><group><field name="pb_company_signer_id"/><field name="pb_sign_status"/><field name="pb_envelope_id"/><field name="pb_sign_note"/><field name="pb_sign_checked_at"/><field name="pb_sign_reviewed" invisible="not pb_envelope_id or pb_sign_status != 'draft'"/></group><div class="alert alert-info" role="status">Prepare the agreed offer, place signature fields in DocuSign and review the recipients. Sending invites the signers. Payobook verifies completed signatures and files the signed PDF and DocuSign completion certificate automatically. Existing legacy envelopes continue using their original provider.</div><button name="action_prepare_esign" type="object" string="Prepare signing draft" class="btn-primary" invisible="pb_envelope_id or state not in ('hr_ok','sent','accepted')"/><button name="action_open_esign" type="object" string="Open signing provider" invisible="not pb_envelope_id"/><button name="action_send_esign" type="object" string="Send signature invitation" class="btn-primary" invisible="pb_sign_status != 'draft'" confirm="Send this offer to the reviewed signers through the configured signing provider?"/><button name="action_sync_esign" type="object" string="Check signing status" invisible="not pb_envelope_id or pb_sign_status == 'cancelled'"/><button name="action_cancel_esign" type="object" string="Cancel signature request" invisible="pb_sign_status not in ('draft','pending')" confirm="Cancel this signature request? An unsent draft is moved to the provider recycle bin or removed."/><button name="action_restart_esign" type="object" string="Start a fresh signing draft" invisible="pb_sign_status != 'cancelled'"/></page></xpath></field></record>
<record id="interview_delivery_form" model="ir.ui.view"><field name="name">Interview reminder delivery</field><field name="model">pb.hiring.interview</field><field name="inherit_id" ref="view_pb_hiring_interview_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="WhatsApp delivery" groups="pb_hiring.group_hiring_user"><p>Messages are queued only for candidates with recorded WhatsApp consent. Unknown delivery is not retried automatically; check Meta before sending again.</p><field name="pb_delivery_ids"><list create="0" delete="0"><field name="reminder"/><field name="state"/><field name="updated_at"/><field name="note"/></list></field></page></xpath></field></record>
</odoo>
