<?xml version="1.0" encoding="UTF-8"?>
<odoo><template id="interview_booking_page" name="Choose an interview time"><t t-call="website.layout"><main class="container py-5" style="max-width:760px"><span class="text-muted" t-esc="booking.company_id.name"/><h1 class="mt-2">Choose your interview time</h1><p t-esc="booking.applicant_id.pb_requisition_id.title"/><div t-if="booking.state == 'booked'" class="alert alert-success"><h2>Your interview is booked</h2><p>Please keep the interview invitation for the time and joining details.</p></div><t t-else=""><p>These times work for the interview panel. Availability is checked again when you book.</p><div t-if="error" class="alert alert-warning" t-esc="error"/><form method="get"><label for="timezone">Show times in</label><div class="d-flex gap-2 my-2"><select name="tz" id="timezone" class="form-select"><option t-foreach="zones" t-as="zn" t-att-value="zn" t-att-selected="zn == tz" t-esc="zn"/></select><button class="btn btn-outline-primary">Update timezone</button></div></form><form method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="tz" t-att-value="tz"/><div class="my-4"><label t-foreach="slots" t-as="sl" class="d-block border rounded p-3 mb-2"><input type="radio" name="slot_id" t-att-value="sl['id']" required="required" class="me-2"/><t t-esc="sl['label']"/> · <t t-esc="tz"/></label></div><button class="btn btn-primary" t-if="slots">Book this time</button><p t-else="">No future slots remain. Please ask your recruiter for a new link.</p></form></t></main></t></template></odoo>
