<odoo>
  <record id="view_board_review" model="ir.ui.view">
    <field name="name">Board publishing review</field>
    <field name="model">pb.hiring.board.review</field>
    <field name="arch" type="xml">
      <form string="Review board publishing">
        <field name="role_channel_id" invisible="1"/><field name="provider" invisible="1"/><field name="delivery_state" invisible="1"/>
        <div class="alert alert-info"><field name="status" nolabel="1"/> <p>Use provider-approved test resources first. A successful connection check confirms access only; complete publishing and application acceptance before live use.</p></div>
        <group><field name="title"/><field name="location"/><field name="native_apply"/></group>
        <div class="alert alert-warning" invisible="not native_apply">Native intake imports contact details and a supported CV. Recruiters must review missing role-specific answers and consent before progressing the candidate. Custom question parity and provider certification remain part of acceptance.</div>
        <field name="description" placeholder="Review the complete advert"/>
        <group invisible="provider != 'seek'" string="JobStreet advert details">
          <group><field name="summary"/><field name="location_id"/><field name="category_id"/><field name="product_id"/></group>
          <group><field name="currency"/><field name="salary_min"/><field name="salary_max"/><field name="pay_interval"/><field name="work_type"/><field name="arrangement"/></group>
          <div class="text-muted" colspan="2">Use identifiers supplied by SEEK for the configured hirer and market. Playground cannot publish. Your provider must approve the test hirer and ad product.</div>
        </group>
        <group string="Application intake"><field name="intake_summary" nolabel="1"/></group>
        <field name="confirmed"/>
        <footer>
          <button name="action_save" type="object" string="Save advert draft" class="btn-secondary"/>
          <button name="action_submit" type="object" string="Queue advert" class="btn-primary" invisible="delivery_state != 'draft'"/>
          <button name="action_update" type="object" string="Queue update" invisible="delivery_state not in ('live','attention')"/>
          <button name="action_close_listing" type="object" string="Queue closure" invisible="delivery_state not in ('live','attention')"/>
          <button name="action_refresh" type="object" string="Check provider status" invisible="delivery_state in ('draft','queued')"/>
          <button name="action_retry_intake" type="object" string="Retry failed intake" invisible="delivery_state == 'draft'"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
