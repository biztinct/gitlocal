<odoo>
  <record id="hiring_message_company_rule" model="ir.rule">
    <field name="name">Hiring templates: allowed companies</field>
    <field name="model_id" ref="model_pb_hiring_message_template"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="view_hiring_brand" model="ir.ui.view">
    <field name="name">Recruitment identity</field><field name="model">res.company</field>
    <field name="arch" type="xml"><form string="Recruitment identity"><sheet>
      <div class="oe_title"><h1>Make every candidate touchpoint yours</h1></div>
      <group><field name="name" readonly="1"/><field name="pb_mr_approver_id"/><field name="pb_hiring_brand" placeholder="Defaults to the company name"/><field name="website"/><field name="pb_hiring_linkedin"/></group>
      <notebook><page string="Company story"><group><field name="pb_hiring_about"/><field name="pb_hiring_building"/><field name="pb_hiring_mission"/><field name="pb_hiring_operate"/><field name="pb_hiring_why"/></group></page>
      <page string="Acknowledgement"><field name="pb_hiring_intro" placeholder="A short introduction included in the application received email"/></page></notebook>
    </sheet></form></field>
  </record>
  <record id="view_hiring_message_list" model="ir.ui.view"><field name="name">Hiring emails</field><field name="model">pb.hiring.message.template</field><field name="arch" type="xml"><list><field name="name"/><field name="key"/><field name="company_id"/><field name="active"/></list></field></record>
  <record id="view_hiring_message_form" model="ir.ui.view"><field name="name">Hiring email</field><field name="model">pb.hiring.message.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="key"/><field name="company_id"/><field name="active"/></group><field name="subject"/><field name="body"/>
  <div class="text-muted">Use {{first_name}}, {{role}}, {{brand}}, {{sender_name}}, {{hr_name}}, {{website}}, {{linkedin}}, {{company_intro}}. Message-specific details such as {{deadline}}, {{reason}} and {{scheduling_link}} are requested before sending.</div></sheet></form></field></record>
  <record id="view_hiring_request_journey" model="ir.ui.view"><field name="name">Hiring request details</field><field name="model">pb.hiring.requisition</field><field name="inherit_id" ref="view_pb_hiring_requisition_form"/><field name="arch" type="xml"><xpath expr="//field[@name='requirements']" position="after"><field name="pb_target_close_date"/><field name="pb_role_level"/><field name="pb_assignment"/><field name="pb_jd_file" filename="pb_jd_filename"/><field name="pb_jd_filename" invisible="1"/><field name="pb_assignment_file" filename="pb_assignment_filename" invisible="not pb_assignment"/><field name="pb_assignment_filename" invisible="1"/></xpath></field></record>
  <record id="view_applicant_journey" model="ir.ui.view"><field name="name">Candidate profile and attribution</field><field name="model">hr.applicant</field><field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Application profile"><group><field name="pb_location"/><field name="pb_nationality"/><field name="pb_linkedin" widget="url"/><field name="pb_portfolio" widget="url"/><field name="pb_work_authorization"/><field name="pb_relocation"/></group><field name="pb_motivation"/><group><field name="pb_hold_until"/><field name="pb_stage_reason"/></group></page><page string="Source attribution"><group><field name="source_id"/><field name="medium_id"/><field name="campaign_id"/></group><field name="pb_first_touch"/><field name="pb_application_touch"/></page></xpath></field></record>
  <record id="view_referral_journey" model="ir.ui.view"><field name="name">Referral declarations</field><field name="model">pb.hiring.referral</field><field name="inherit_id" ref="view_pb_hiring_referral_form"/><field name="arch" type="xml"><xpath expr="//field[@name='note']" position="after"><group string="Consent and relationship"><field name="pb_consent"/><field name="pb_declaration"/><field name="pb_relationship"/><field name="pb_nationality"/><field name="pb_location"/><field name="pb_linkedin"/></group><group string="Referrer"><field name="pb_referrer_email"/><field name="pb_department"/><field name="pb_designation"/><field name="pb_employment_type"/><field name="pb_entity"/></group></xpath></field></record>
</odoo>
