<odoo>
<record id="connection_company_connection" model="ir.rule"><field name="name">Hiring connection: company</field><field name="model_id" ref="model_pb_hiring_connection"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="connection_company_visibility_policy" model="ir.rule"><field name="name">Hiring visibility_policy: company</field><field name="model_id" ref="model_pb_hiring_visibility_policy"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="connection_company_cost_profile" model="ir.rule"><field name="name">Hiring cost_profile: company</field><field name="model_id" ref="model_pb_hiring_cost_profile"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="connection_company_booking" model="ir.rule"><field name="name">Hiring booking: company</field><field name="model_id" ref="model_pb_hiring_booking"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="connection_company_booking_slot" model="ir.rule"><field name="name">Hiring booking_slot: company</field><field name="model_id" ref="model_pb_hiring_booking_slot"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="connection_company_message_delivery" model="ir.rule"><field name="name">Hiring message_delivery: company</field><field name="model_id" ref="model_pb_hiring_message_delivery"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="booking_organiser" model="ir.rule"><field name="name">Booking: own organiser</field><field name="model_id" ref="model_pb_hiring_booking"/><field name="groups" eval="[(4, ref('pb_hiring.group_hiring_user'))]"/><field name="domain_force">[('organiser_id', '=', user.id)]</field></record>
<record id="booking_lead" model="ir.rule"><field name="name">Booking: talent lead</field><field name="model_id" ref="model_pb_hiring_booking"/><field name="groups" eval="[(4, ref('pb_hiring.group_hiring_manager'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
</odoo>