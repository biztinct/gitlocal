msgid "We already have your name, email and phone from your application. You will not be asked again."
msgstr "Chúng tôi đã có họ tên, email và số điện thoại từ hồ sơ ứng tuyển của bạn. Bạn không cần nhập lại."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "We sent a 6-digit code to %(email)s. It works for 10 minutes."
msgstr "Chúng tôi đã gửi mã gồm 6 chữ số đến %(email)s. Mã có hiệu lực trong 10 phút."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Welcome aboard, %(name)s"
msgstr "Chào mừng %(name)s gia nhập công ty"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/models/messages.py:0
msgid "Welcome to {{brand}}. A few details before you start"
msgstr "Chào mừng bạn đến với {{brand}}. Một vài thông tin trước ngày đi làm"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Welcome to %(company)s, %(name)s"
msgstr "Chào mừng %(name)s đến với %(company)s"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "When, where, what to bring"
msgstr "Thời gian, địa điểm và những gì cần mang theo"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Where your pay goes"
msgstr "Nơi nhận lương của bạn"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Who should we call if something happens at work?"
msgstr "Chúng tôi nên gọi cho ai nếu xảy ra sự cố tại nơi làm việc?"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Who to call"
msgstr "Người cần liên hệ"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "You can ask again in {time}"
msgstr "Bạn có thể yêu cầu lại sau {time}"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "You can stop at any point and come back with the same link. Have your identity card, tax card and bank details nearby."
msgstr "Bạn có thể dừng bất cứ lúc nào và quay lại bằng liên kết này. Hãy chuẩn bị thẻ căn cước, thẻ thuế và thông tin ngân hàng."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/models/board.py:0
msgid "You cannot open this joining."
msgstr "Bạn không thể mở hồ sơ nhận việc này."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "You start as %(job)s on %(date)s, in %(days)s days."
msgstr "Bạn sẽ bắt đầu làm %(job)s vào %(date)s, sau %(days)s ngày nữa."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "You start as %(job)s on %(date)s."
msgstr "Bạn sẽ bắt đầu công việc %(job)s vào %(date)s."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "You start as %(job)s today."
msgstr "Hôm nay bạn bắt đầu công việc %(job)s."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/models/messages.py:0
msgid "Your code for {{brand}} is {{code}}. It works for 10 minutes. If you did not ask for it, ignore this message."
msgstr "Mã của bạn cho {{brand}} là {{code}}. Mã có hiệu lực trong 10 phút. Nếu bạn không yêu cầu mã, hãy bỏ qua tin nhắn này."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Your first day"
msgstr "Ngày đầu đi làm"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Your identity card"
msgstr "Thẻ căn cước của bạn"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Your manager"
msgstr "Quản lý của bạn"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Your manager will send you the time and place before you start."
msgstr "Quản lý sẽ báo cho bạn thời gian và địa điểm trước khi bạn bắt đầu."

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Your papers"
msgstr "Giấy tờ của bạn"

#. module: pb_joining
#. odoo-python
#: code:addons/pb_joining/controllers/joining.py:0
msgid "Your pay is sent here. The name on the account must match your identity card."
msgstr "Lương sẽ được chuyển vào tài khoản này. Tên chủ tài khoản phải khớp với thẻ căn cước của bạn."
