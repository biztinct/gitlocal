        <!-- ==== Zoho People · the legacy ABM employee form (Cycle 3) ====
             Every field the ABM application actually read off
             `forms/employee/getRecords`, from its two write sites
             (om_hr_payroll/models/hr_zoho_staging.py:376-402 and the
             `bypass_create` twin at :406). They all arrive on ONE feed, so they
             all carry endpoint_code=zohoemployees and the Mapping Studio groups
             them under a single header.

             TARGET CODES obey the formula-converter contract: UPPERCASE,
             underscore-free, and no code may be a SUBSTRING of another. That
             last rule is what rules out the obvious spellings here: `ENFULLNAME`
             and `VNFULLNAME` both contain `FULLNAME`, which already exists four
             rows above — so the English and Vietnamese names are `NAMEEN` and
             `NAMEVN`. Same reason `VNBANKACC` is not available beside `BANKACC`,
             and the Vietnamese-dong account is `VNDACCOUNT`.

             ONE FIELD IS DELIBERATELY ABSENT. `FirstName` has no GIVENNAME row,
             because `action_apply_mapping_template` de-dupes template rows by
             `source_path` (integration_connector.py:503) — `mt_zoho_name` above
             already claims `FirstName` for the FULLNAME concat, and a second row
             naming it would be data that ships, loads, freezes under noupdate,
             and silently never applies. `LastName` has no such claim, so SURNAME
             is real. -->

        <record id="mt_zoho_lastname" model="hr.integration.mapping.template">
            <field name="connector_type">zoho</field><field name="endpoint_code">zohoemployees</field>
            <field name="source_path">LastName</field>
            <field name="target_code">SURNAME</field><field name="target_label">Last name</field><field name="sequence">150</field>
            <field name="note">Pairs with FirstName above, which the FULLNAME row concatenates</field>
        </record>
        <record id="mt_zoho_nameen" model="hr.integration.mapping.template">
            <field name="connector_type">zoho</field><field name="endpoint_code">zohoemployees</field>
            <field name="source_path">Nick_Name</field>
            <field name="target_code">NAMEEN</field><field name="target_label">Full name (English)</field><field name="sequence">160</field>
            <field name="note">Legacy semantic: ABM stored Nick_Name as full_name_en, not as a nickname</field>
        </record>
        <record id="mt_zoho_namevn" model="hr.integration.mapping.template">
            <field name="connector_type">zoho</field><field name="endpoint_code">zohoemployees</field>
            <field name="source_path">Full_Name_Vietnamese</field>
            <field name="target_code">NAMEVN</field><field name="target_label">Full name (Vietnamese)</field><field name="sequence">170</field>
            <field name="note">The name that must appear on Vietnamese statutory filings</field>
