<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- F114 — ready-made HR/API connector field templates (A3).
         Rows are seeds, not gospel: verify/derive rows ship suggested and are
         only promoted through the wizard's batch test. noupdate so bureau edits
         survive upgrades; re-seed by uninstalling only if needed. -->
    <data noupdate="1">

        <!-- ============ Zoho People (REST v2 · P_EmployeeView) ============ -->
        <record id="mt_zoho_empid" model="hr.integration.mapping.template">
            <field name="connector_type">zoho</field><field name="source_path">EmployeeID</field>
            <field name="target_code">EMPID</field><field name="target_label">Employee ID</field>
            <field name="is_required" eval="True"/><field name="sequence">10</field>
            <field name="note">Zoho People API v2 · P_EmployeeView record key</field>
        </record>
        <record id="mt_zoho_name" model="hr.integration.mapping.template">
            <field name="connector_type">zoho</field><field name="source_path">FirstName</field>
            <field name="target_code">FULLNAME</field><field name="target_label">Full name</field>
            <field name="transformation_type">python</field><field name="verify" eval="True"/><field name="sequence">20</field>
            <field name="note">Concat FirstName + LastName — resolve in batch test</field>
        </record>
        <record id="mt_zoho_email" model="hr.integration.mapping.template">
            <field name="connector_type">zoho</field><field name="source_path">EmailID</field>
            <field name="target_code">EMAIL</field><field name="target_label">Email</field><field name="sequence">30</field>
        </record>
