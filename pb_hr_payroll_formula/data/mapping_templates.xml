            <field name="connector_type">zoho</field><field name="source_path">Dateofjoining</field>
            <field name="target_code">JOINDATE</field><field name="target_label">Join date</field>
            <field name="verify" eval="True"/><field name="sequence">60</field>
            <field name="note">Zoho date format dd-MMM-yyyy — verify parse</field>
        </record>
        <record id="mt_zoho_basic" model="hr.integration.mapping.template">
