<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Payroll Import Batch -->
        <record id="sequence_payroll_import_batch" model="ir.sequence">
            <field name="name">Payroll Import Batch</field>
            <field name="code">hr.payroll.import.batch</field>
            <field name="prefix">IMP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>

    <!--
        SUPPORTED FUNCTIONS
        ===================

        WDGAP PR-A: there is ONE list, formula_engine/functions.py (_TABLE):
        name, converter helper, number of values, one help line, example.
        The converter, both validators, the save-time refusal, the formula
        bar and the Formula Studio function list are all derived from it
        (RPC hr.formula.rule.pb_formula_functions). This comment used to
        hold a hand-kept copy that listed TODAY, NOW, LEFT, VLOOKUP, PMT ...
        most of which never computed; do not add a list here again.
    -->
</odoo>
