<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- SC-2 — the hourly DISPATCHER (was RD49's monthly fetch).

             The cadence no longer lives here: each connector carries its own
             schedule (daily / weekly / monthly on a day / last day of month,
             at a time on the company's clock) and its own `sync_next_run`.
             This record just ticks hourly and runs whatever has come due —
             so its own time of day is nobody's decision and needs none.

             The record is active, but the job does nothing at all until a
             connector is switched on for it — see `cron_pull_enabled`, which is
             off by default. A schedule that reaches into somebody's HR system
             is opt-in, per connector.

             ODOO 19 — `numbercall` and `doall` are GONE from `ir.cron`; leaving
             `numbercall` in place aborted the whole module load with
             `ValueError: Invalid field 'numbercall' in 'ir.cron'`, which takes
             every other module in the same upgrade down with it. A cron now
             simply repeats until deactivated, so "run forever" needs no field.

             `nextcall` is required and is left to the model's default (now).
             This file is `noupdate`, so EXISTING databases get the hourly
             cadence from the 19.0.1.117.0 migration, not from this file. -->
        <record id="ir_cron_pull_previous_month" model="ir.cron">
            <field name="name">Payroll: scheduled data fetch</field>
            <field name="model_id" ref="model_hr_integration_connector"/>
            <field name="state">code</field>
            <field name="code">model.cron_pull_previous_month()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
