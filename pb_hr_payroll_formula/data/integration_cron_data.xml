<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- RD49 — the 5th of the month, for the month just gone.

             The 5th and not the 1st: a connected system is still settling the
             final days of a month on the 1st, and re-fetching a month that is
             already complete costs nothing while fetching one that is not costs
             a wrong pay run.

             The record is active, but the job does nothing at all until a
             connector is switched on for it — see `cron_pull_enabled`, which is
             off by default. A schedule that reaches into somebody's HR system
             is opt-in, per connector.

             ODOO 19 — `numbercall` and `doall` are GONE from `ir.cron`; leaving
             `numbercall` in place aborted the whole module load with
             `ValueError: Invalid field 'numbercall' in 'ir.cron'`, which takes
             every other module in the same upgrade down with it. A cron now
             simply repeats until deactivated, so "run forever" needs no field.
             `interval_type` does still accept 'months'.

             `nextcall` is required and is left to the model's default (now), so
             the first run happens on install and then settles onto the monthly
             cadence. On install it finds no opted-in connector and logs exactly
             that — which is the cheapest possible proof the job is wired up. -->
        <record id="ir_cron_pull_previous_month" model="ir.cron">
            <field name="name">Payroll: fetch last month's data</field>
            <field name="model_id" ref="model_hr_integration_connector"/>
            <field name="state">code</field>
            <field name="code">model.cron_pull_previous_month()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
