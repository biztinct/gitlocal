msgid ""
"\"%(name)s\" cannot be deleted because it is used by %(blockers)s.\n"
"\n"
"Archive it instead - the configuration is hidden from everyday use while the payroll history that depends on it stays intact."
msgstr ""
"Không thể xóa \"%(name)s\" vì nó được %(blockers)s sử dụng.\n"
"\n"
"Thay vào đó hãy lưu trữ nó - cấu hình bị ẩn khỏi việc sử dụng hàng ngày trong khi lịch sử bảng lương phụ thuộc vào nó vẫn còn nguyên."

#. module: pb_hr_payroll_formula
#: model_terms:ir.ui.view,arch_db:pb_hr_payroll_formula.view_api_transformation_rule_form
msgid ""
"# Example: Count minor dependents\n"
"children = [r for r in records if r.get('relationship') == 'Child']\n"
"minors = [c for c in children if c.get('age', 0) < 18]\n"
"result = len(minors)"
msgstr ""
"# Ví dụ: Tính người phụ thuộc thứ yếu\n"
"trẻ em = [r cho r trong hồ sơ if r.get('relationship') == 'Child']\n"
"trẻ vị thành niên = [c cho c ở trẻ em nếu c.get('age', 0) < 18]\n"
"kết quả = len(trẻ vị thành niên)"

