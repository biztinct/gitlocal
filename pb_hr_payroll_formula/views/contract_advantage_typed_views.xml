<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Contract components can hold text as well as an amount (COLROLES / CR-A3).
      The list lives in om_hr_payroll's contract form; this inherited view adds
      the new columns there rather than editing that module, so nothing outside
      pb_hr_payroll_formula has to be upgraded to show them.

      RD50 — A TEXT COMPONENT HAD NOWHERE TO SHOW ITSELF.

      The Text Value column was added, and that was not enough: every row still
      rendered three money cells, so a text component read as
      "0.00 · 0.00 · 0.00" with an empty column somewhere off to the right. On a
      contract with twenty-one components, four of them text, nothing on screen
      said which four — and the meaningless zeros were louder than the one cell
      that mattered. The owner's words: "it shows only float values".

      So the row now shows the cells that MEAN something for its type and blanks
      the rest. Per-row, not per-column: one list holds both kinds, and hiding a
      whole column would take the amounts away from the seventeen components
      that do have one.

      `value_type` is `column_invisible` rather than an optional column,
      deliberately. An optional column a person has switched off is not fetched,
      and every modifier below reads it — the row would then fall back to
      showing everything, which is the bug this fixes, arriving quietly and only
      for whoever had toggled that column.
    -->
    <record id="view_hr_contract_form_typed_components" model="ir.ui.view">
        <field name="name">hr.contract.form.typed.components</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_contract_form_inherit"/>
        <field name="arch" type="xml">
            <!-- The type has to be IN the list for the row modifiers to read it,
                 and must never be shown: it is a property of the template, not
                 of this line, and it is already said by which cells appear. -->
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='advantage_template_code']"
                   position="after">
                <field name="value_type" column_invisible="1"/>
            </xpath>

            <!-- Money cells: nothing for a text component to put in them. -->
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='advantage_lower_bound']"
                   position="attributes">
                <attribute name="invisible">value_type == 'text'</attribute>
            </xpath>
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='advantage_upper_bound']"
                   position="attributes">
                <attribute name="invisible">value_type == 'text'</attribute>
            </xpath>
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='amount']"
                   position="attributes">
                <attribute name="invisible">value_type == 'text'</attribute>
            </xpath>

            <!-- …and the text cell is the one that means something there.
                 Not `optional`: a component whose only value lives in this
                 column must not depend on somebody having switched it on. -->
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='amount']"
                   position="after">
                <field name="text_value"
                       invisible="value_type != 'text'"
                       placeholder="Type the value…"/>
            </xpath>
        </field>
    </record>

    <!--
      PDR P2 W3b — a component whose scheme rule has words ("0=No;1=Yes",
      "0=None;1=Insurance tax;2=All tax") shows and edits the WORD here, the
      way the contract panel does. `amount` still stores the number; picking
      "No" keeps a line holding 0 (never deletes it). A component without
      words keeps the number column exactly as before.
    -->
    <record id="view_hr_contract_form_component_words" model="ir.ui.view">
        <field name="name">hr.contract.form.component.words</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="view_hr_contract_form_typed_components"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='value_type']"
                   position="after">
                <field name="pb_value_words" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='advantage_lower_bound']"
                   position="attributes">
                <attribute name="invisible">value_type == 'text' or pb_value_words</attribute>
            </xpath>
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='advantage_upper_bound']"
                   position="attributes">
                <attribute name="invisible">value_type == 'text' or pb_value_words</attribute>
            </xpath>
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='amount']"
                   position="attributes">
                <attribute name="invisible">value_type == 'text' or pb_value_words</attribute>
            </xpath>
            <xpath expr="//field[@name='advantages_ids']/list/field[@name='amount']"
                   position="after">
                <field name="pb_amount_word" widget="pb_value_word" width="140px"
                       invisible="not pb_value_words"/>
            </xpath>
        </field>
    </record>

</odoo>
