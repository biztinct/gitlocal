<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================
         MAIN MENU STRUCTURE
         ========================================== -->

    <!-- Formula Configuration Root Menu (Under Payroll) -->
    <menuitem id="menu_formula_root"
              name="Formula Engine"
              parent="om_hr_payroll.menu_hr_payroll_root"
              sequence="50"
              groups="pb_hr_payroll_formula.group_formula_user"/>

    <!-- Configurations Submenu -->
    <menuitem id="menu_formula_configs"
              name="Configurations"
              parent="menu_formula_root"
              action="action_formula_config"
              sequence="10"/>

    <menuitem id="menu_payslip_import_mapping"
              name="Employee/Contract Field Mapping"
              parent="menu_formula_root"
              action="action_payslip_import_mapping_wizard"
              sequence="12"
              groups="om_hr_payroll.group_hr_payroll_manager"/>

    <menuitem id="menu_mid_cycle_carryover"
              name="Mid-Cycle Carryover"
              parent="menu_formula_root"
              action="action_payroll_cycle_carryover"
              sequence="13"
              groups="pb_hr_payroll_formula.group_formula_manager"/>

    <menuitem id="menu_cycle_component_mapping"
              name="Mid-Cycle to End-Cycle Mapping"
              parent="menu_formula_root"
              action="action_payroll_cycle_component_mapping_wizard"
              sequence="14"
              groups="pb_hr_payroll_formula.group_formula_manager"/>

    <menuitem id="menu_proration_lines"
              name="Proration Audit"
              parent="menu_formula_root"
              action="action_payroll_proration_line"
              sequence="15"
              groups="pb_hr_payroll_formula.group_formula_manager"/>

    <menuitem id="menu_retro_adjustments"
              name="Retro Adjustments"
              parent="menu_formula_root"
              action="action_payroll_retro_adjustment"
              sequence="16"
              groups="pb_hr_payroll_formula.group_formula_manager"/>

    <!-- Pay Data Submenu.
         JOURNEY J2 — every label here says what it MOVES and when you use it.
         "New Import" and "Import Batches" sat side by side saying neither, next
         to a "Import from Excel" button on the scheme form that sets up columns
         instead of loading numbers. Doing, and browsing what you have done, are
         now spelled differently. -->
    <menuitem id="menu_formula_import"
              name="Pay Data"
              parent="menu_formula_root"
              sequence="20"
              groups="pb_hr_payroll_formula.group_formula_manager"/>

    <menuitem id="menu_import_batches"
              name="Past Pay Data Loads"
              parent="menu_formula_import"
              action="action_payroll_import_batch"
              sequence="10"/>

    <menuitem id="menu_import_new"
              name="Load Pay Data…"
              parent="menu_formula_import"
              action="action_payroll_load_pay_data"
              sequence="20"/>

    <!-- RD54 — the same load, starting on the connected system instead of a
         file. Beside the one above rather than replacing it: both sources are
         legitimate and which one you want is a decision, not a default. -->
    <menuitem id="menu_import_from_feed"
              name="Load From Connected System…"
              parent="menu_formula_import"
              action="action_payroll_load_from_feed"
              sequence="25"/>

    <!-- Integration Submenu -->
    <menuitem id="menu_formula_integrations"
              name="Integrations"
              parent="menu_formula_root"
              sequence="20"
              groups="pb_hr_payroll_formula.group_formula_admin"/>

    <menuitem id="menu_integration_connectors"
              name="Connectors"
              parent="menu_formula_integrations"
              action="action_integration_connector"
              sequence="10"/>

    <menuitem id="menu_integration_mappings"
              name="Field Mappings"
              parent="menu_formula_integrations"
              action="action_field_mapping"
              sequence="20"/>

    <menuitem id="menu_api_data_store"
              name="API Data Store"
              parent="menu_formula_integrations"
              action="action_api_data_store"
              sequence="30"/>

    <menuitem id="menu_transformation_rules"
              name="Transformation Rules"
              parent="menu_formula_integrations"
              action="action_api_transformation_rule"
              sequence="40"/>

    <!-- Testing Submenu -->
    <menuitem id="menu_formula_testing"
              name="Testing"
              parent="menu_formula_root"
              sequence="30"
              groups="pb_hr_payroll_formula.group_formula_manager"/>

    <menuitem id="menu_sample_data"
              name="Sample Data"
              parent="menu_formula_testing"
              action="action_sample_data"
              sequence="10"/>

    <menuitem id="menu_test_results"
              name="Test Results"
              parent="menu_formula_testing"
              action="action_test_results"
              sequence="20"/>

    <!-- Settings Submenu -->
    <menuitem id="menu_formula_settings"
              name="Settings"
              parent="menu_formula_root"
              sequence="100"
              groups="pb_hr_payroll_formula.group_formula_admin"/>

</odoo>
