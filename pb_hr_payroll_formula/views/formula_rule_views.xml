<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================
         FORMULA RULE VIEWS
         ========================================== -->

    <record id="view_formula_rule_tree" model="ir.ui.view">
        <field name="name">hr.formula.rule.tree</field>
        <field name="model">hr.formula.rule</field>
        <field name="arch" type="xml">
            <list string="Formula Rules" editable="bottom" default_order="sequence"
                  decoration-success="column_type == 'formula' and has_evaluation_error == False"
                  decoration-info="column_type == 'input'"
                  decoration-danger="has_evaluation_error == True">
                <field name="sequence" widget="handle"/>
                <field name="column_letter" readonly="1" string="Col"/>
                <field name="name" string="Component"/>
                <field name="component_type" string="Category" optional="show"/>
                <field name="code"/>
                <field name="column_type" string="Type"/>
                <field name="data_source" string="Source"/>
                <field name="excel_formula_display" invisible="column_type != 'formula'" optional="show"/>
                <field name="data_source_field" invisible="column_type != 'input'" optional="hide"/>
                <field name="constant_value" invisible="column_type != 'constant'" optional="hide"/>
                <field name="default_value" optional="hide"/>
                <field name="number_format" optional="hide"/>
                <field name="source_sheet_name" optional="hide"/>
                <field name="is_valid" widget="boolean" readonly="1"/>
                <field name="has_evaluation_error" widget="boolean" readonly="1" string="Eval Error" optional="hide"/>
                <field name="appears_on_payslip" optional="hide"/>
                <field name="is_contract_component" optional="hide"/>
                <field name="requires_new_contract" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_formula_rule_form" model="ir.ui.view">
        <field name="name">hr.formula.rule.form</field>
        <field name="model">hr.formula.rule</field>
        <field name="arch" type="xml">
            <form string="Formula Rule">
                <sheet>
                    <widget name="web_ribbon" title="Invalid" bg_color="bg-danger"
                            invisible="[('is_valid', '=', True)]"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Basic Salary"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identification">
                            <field name="config_id" invisible="1"/>
                            <field name="column_letter" readonly="1"/>
                            <field name="code" placeholder="e.g., BASIC"/>
                            <field name="sequence"/>
                            <field name="category_id"/>
                            <field name="salary_rule_id"/>
                        </group>
                        <group string="Column Type">
                            <field name="column_type" widget="radio"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Input Column Settings -->
                        <page string="Input Settings" name="input"
                              invisible="[('column_type', '!=', 'input')]">
                            <group>
                                <group string="Data Source">
                                    <field name="data_source_field" placeholder="e.g., basic_salary"/>
                                    <field name="default_value"/>
                                </group>
                            </group>
                        </page>

                        <!-- Formula Settings -->
                        <page string="Formula" name="formula"
                              invisible="[('column_type', '!=', 'formula')]">

                            <!-- Evaluation Error Alert (shown prominently if there's an error) -->
                            <div class="alert alert-danger" role="alert" style="margin-bottom: 20px;"
                                 invisible="[('has_evaluation_error', '=', False)]">
                                <h4 class="alert-heading">
                                    <i class="fa fa-exclamation-triangle"/> Formula Evaluation Error
                                </h4>
                                <field name="has_evaluation_error" invisible="1"/>
                                <field name="last_evaluation_date" readonly="1" string="Error occurred at"/>
                                <hr/>
                                <strong>Error Details:</strong>
                                <field name="last_evaluation_error" readonly="1" widget="text"
                                       style="font-family: 'Courier New', monospace; font-size: 12px;
                                              background: #fff; padding: 10px; border-radius: 4px;
                                              margin-top: 10px; display: block;"/>
                            </div>

                            <group>
                                <group string="Excel Formula">
                                    <field name="excel_formula_display" placeholder="e.g., =A1+B1*0.08"
                                           widget="char" class="o_text_mono"/>
                                </group>
                                <group string="Converted Python (for debugging)">
                                    <field name="excel_formula_converted" readonly="1"
                                           widget="text" class="o_text_mono"/>
                                    <field name="python_formula" readonly="1"
                                           widget="text" class="o_text_mono"/>
                                </group>
                            </group>
                            <group string="Dependencies">
                                <field name="formula_dependencies" readonly="1"/>
                            </group>
                            <group string="Validation Status">
                                <field name="is_valid"/>
                                <field name="validation_message"/>
                                <field name="has_circular_ref"/>
                            </group>
                        </page>

                        <!-- Constant Settings -->
                        <page string="Constant" name="constant"
                              invisible="[('column_type', '!=', 'constant')]">
                            <group>
                                <field name="constant_value"/>
                            </group>
                        </page>

                        <!-- Display Settings -->
                        <page string="Display" name="display">
                            <group>
                                <group string="Formatting">
                                    <field name="number_format" widget="radio"/>
                                    <field name="decimal_places"/>
                                    <field name="column_width"/>
                                </group>
                                <group string="Visibility">
                                    <field name="appears_on_payslip"/>
                                    <field name="is_visible_in_grid"/>
                                    <field name="report_visible"/>
                                </group>
                                <group string="Contract">
                                    <field name="is_contract_component"/>
                                    <field name="requires_new_contract"
                                           invisible="[('is_contract_component', '=', False)]"/>
                                </group>
                            </group>
                        </page>

                        <!-- Data Source Settings (Multi-Sheet Import) -->
                        <page string="Data Source" name="data_source">
                            <group>
                                <group string="Component Classification">
                                    <field name="component_type"/>
                                    <field name="source_sheet_name" readonly="1"/>
                                    <field name="original_column_letter" readonly="1"/>
                                </group>
                                <group string="Data Source Configuration">
                                    <field name="data_source"/>
                                    <field name="integration_connector_id"
                                           invisible="[('data_source', '!=', 'integration')]" required="[('data_source', '=', 'integration')]"
                                           options="{'no_create': True}"/>
                                    <field name="source_field_mapping"
                                           invisible="[('data_source', '!=', 'integration')]"/>
                                </group>
                            </group>
                            <group string="Information" class="oe_read_only">
                                <div class="alert alert-info" role="alert">
                                    <strong>Data Source Options:</strong>
                                    <ul class="mb-0">
                                        <li><b>Excel Import:</b> Values come from the primary Excel file during import</li>
                                        <li><b>Integration Connector:</b> Values fetched from external system (Zoho, SAP, etc.)</li>
                                        <li><b>Calculated (Formula):</b> Computed from other fields using formula</li>
                                        <li><b>Manual Entry:</b> User enters value manually for each payslip</li>
                                        <li><b>Not Populated:</b> Field exists in structure but has no data source</li>
                                    </ul>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_formula_rule_kanban" model="ir.ui.view">
        <field name="name">hr.formula.rule.kanban</field>
        <field name="model">hr.formula.rule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_order="sequence">
                <field name="column_letter"/>
                <field name="name"/>
                <field name="code"/>
                <field name="column_type"/>
                <field name="excel_formula_display"/>
                <field name="is_valid"/>
                <field name="sequence"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span t-attf-class="badge #{record.column_type.raw_value == 'formula' ? 'text-bg-success' : record.column_type.raw_value == 'input' ? 'text-bg-info' : 'text-bg-secondary'}"
                                              style="font-size: 14px; margin-right: 8px;">
                                            <field name="column_letter"/>
                                        </span>
                                        <field name="name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="code"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body" t-if="record.column_type.raw_value == 'formula'">
                                <code><field name="excel_formula_display"/></code>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="column_type" widget="badge"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <t t-if="record.is_valid.raw_value">
                                        <span class="badge text-bg-success">
                                            <i class="fa fa-check"/> Valid
                                        </span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge text-bg-danger">
                                            <i class="fa fa-times"/> Invalid
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_formula_rule_search" model="ir.ui.view">
        <field name="name">hr.formula.rule.search</field>
        <field name="model">hr.formula.rule</field>
        <field name="arch" type="xml">
            <search string="Search Formula Rules">
                <field name="name"/>
                <field name="code"/>
                <field name="column_letter"/>
                <field name="excel_formula"/>
                <field name="component_type"/>
                <field name="source_sheet_name"/>
                <filter name="input_columns" string="Input Columns"
                        domain="[('column_type', '=', 'input')]"/>
                <filter name="formula_columns" string="Formula Columns"
                        domain="[('column_type', '=', 'formula')]"/>
                <filter name="constant_columns" string="Constant Columns"
                        domain="[('column_type', '=', 'constant')]"/>
                <separator/>
                <filter name="data_source_excel" string="From Excel"
                        domain="[('data_source', '=', 'excel')]"/>
                <filter name="data_source_integration" string="From Integration"
                        domain="[('data_source', '=', 'integration')]"/>
                <filter name="data_source_none" string="No Data Source"
                        domain="[('data_source', '=', 'none')]"/>
                <separator/>
                <filter name="valid" string="Valid"
                        domain="[('is_valid', '=', True)]"/>
                <filter name="invalid" string="Invalid"
                        domain="[('is_valid', '=', False)]"/>
                <separator/>
                <filter name="on_payslip" string="On Payslip"
                        domain="[('appears_on_payslip', '=', True)]"/>
                <group name="group_by">
                    <filter name="group_type" string="Column Type"
                            context="{'group_by': 'column_type'}"/>
                    <filter name="group_data_source" string="Data Source"
                            context="{'group_by': 'data_source'}"/>
                    <filter name="group_component_type" string="Component Type"
                            context="{'group_by': 'component_type'}"/>
                    <filter name="group_sheet" string="Source Sheet"
                            context="{'group_by': 'source_sheet_name'}"/>
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_format" string="Number Format"
                            context="{'group_by': 'number_format'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for standalone rule management -->
    <record id="action_formula_rule" model="ir.actions.act_window">
        <field name="name">Formula Rules</field>
        <field name="res_model">hr.formula.rule</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define formula-based salary rules
            </p>
            <p>
                Create rules with Excel-like column letters and formulas.
                Use column types: Input (from data source), Formula (calculated), or Constant.
            </p>
        </field>
    </record>

</odoo>
