<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================
         SAMPLE DATA VIEWS
         ========================================== -->

    <record id="view_formula_sample_data_tree" model="ir.ui.view">
        <field name="name">hr.formula.sample.data.tree</field>
        <field name="model">hr.formula.sample.data</field>
        <field name="arch" type="xml">
            <tree string="Sample Data" decoration-success="all_passed == True"
                  decoration-danger="all_passed == False and discrepancy_count > 0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="source_type" widget="badge"
                       decoration-info="source_type == 'manual'"
                       decoration-success="source_type == 'employee'"
                       decoration-warning="source_type == 'payslip'"/>
                <field name="is_anonymized"/>
                <field name="validation_status" widget="badge"
                       decoration-success="validation_status == 'passed'"
                       decoration-danger="validation_status == 'failed'"
                       decoration-warning="validation_status == 'warning'"/>
                <field name="discrepancy_count"/>
                <field name="max_discrepancy"/>
                <field name="last_computed"/>
                <field name="all_passed" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_formula_sample_data_form" model="ir.ui.view">
        <field name="name">hr.formula.sample.data.form</field>
        <field name="model">hr.formula.sample.data</field>
        <field name="arch" type="xml">
            <form string="Sample Data">
                <header>
                    <button name="action_recompute" string="Recompute" type="object"
                            class="btn-primary" icon="fa-refresh"/>
                    <button name="action_copy_computed_to_expected" string="Copy to Expected" type="object"
                            class="btn-secondary" icon="fa-copy"/>
                </header>
                <sheet>
                    <field name="all_passed" invisible="1"/>
                    <field name="discrepancy_count" invisible="1"/>

                    <widget name="web_ribbon" title="All Passed" bg_color="bg-success"
                            attrs="{'invisible': [('all_passed', '!=', True)]}"/>
                    <widget name="web_ribbon" title="Failed" bg_color="bg-danger"
                            attrs="{'invisible': ['|', ('all_passed', '=', True), ('discrepancy_count', '=', 0)]}"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., High Earner Sample"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Sample Info">
                            <field name="config_id"/>
                            <field name="sequence"/>
                            <field name="description"/>
                            <field name="is_anonymized"/>
                            <field name="active"/>
                        </group>
                        <group string="Source">
                            <field name="source_type" widget="radio"/>
                            <field name="source_employee_id"
                                   attrs="{'invisible': [('source_type', 'not in', ['employee'])]}"/>
                            <field name="source_payslip_id"
                                   attrs="{'invisible': [('source_type', 'not in', ['payslip'])]}"/>
                            <field name="source_date"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Input Values -->
                        <page string="Input Values" name="inputs">
                            <group string="JSON Input Data">
                                <field name="input_values_json" widget="ace" options="{'mode': 'json'}"
                                       placeholder='{"BASIC": 10000000, "HRA": 2000000, ...}'
                                       nolabel="1" colspan="2"/>
                            </group>
                        </page>

                        <!-- Expected Values -->
                        <page string="Expected Values" name="expected">
                            <group string="Expected Results">
                                <field name="expected_values_json" widget="ace" options="{'mode': 'json'}"
                                       placeholder='{"GROSS": 12500000, "NET": 10000000, ...}'
                                       nolabel="1" colspan="2"/>
                            </group>
                        </page>

                        <!-- Computed Results -->
                        <page string="Computed Results" name="computed">
                            <group string="Calculated by Formula Engine">
                                <field name="computed_values_json" widget="ace" options="{'mode': 'json'}"
                                       readonly="1" nolabel="1" colspan="2"/>
                            </group>
                            <group>
                                <field name="last_computed" readonly="1"/>
                            </group>
                        </page>

                        <!-- Validation -->
                        <page string="Validation" name="validation">
                            <group>
                                <group string="Test Results">
                                    <field name="validation_status" widget="badge"/>
                                    <field name="discrepancy_count"/>
                                    <field name="max_discrepancy"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_formula_sample_data_kanban" model="ir.ui.view">
        <field name="name">hr.formula.sample.data.kanban</field>
        <field name="model">hr.formula.sample.data</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="name"/>
                <field name="source_type"/>
                <field name="all_passed"/>
                <field name="discrepancy_count"/>
                <field name="max_discrepancy"/>
                <field name="validation_status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-if="record.all_passed.raw_value">
                                            <i class="fa fa-check-circle text-success me-1"/>
                                        </t>
                                        <t t-elif="record.discrepancy_count.raw_value > 0">
                                            <i class="fa fa-times-circle text-danger me-1"/>
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-question-circle text-muted me-1"/>
                                        </t>
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.discrepancy_count.raw_value > 0" class="text-danger">
                                    <strong><field name="discrepancy_count"/></strong> discrepancies
                                </div>
                                <div t-elif="record.all_passed.raw_value" class="text-success">
                                    All values match!
                                </div>
                                <div t-else="" class="text-muted">
                                    Not tested yet
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="source_type" widget="badge"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_formula_sample_data_search" model="ir.ui.view">
        <field name="name">hr.formula.sample.data.search</field>
        <field name="model">hr.formula.sample.data</field>
        <field name="arch" type="xml">
            <search string="Search Sample Data">
                <field name="name"/>
                <field name="config_id"/>
                <filter name="passed" string="Passed"
                        domain="[('validation_status', '=', 'passed')]"/>
                <filter name="failed" string="Failed"
                        domain="[('validation_status', '=', 'failed')]"/>
                <filter name="pending" string="Pending"
                        domain="[('validation_status', '=', 'pending')]"/>
                <separator/>
                <filter name="manual" string="Manual Entry"
                        domain="[('source_type', '=', 'manual')]"/>
                <filter name="from_employee" string="From Employees"
                        domain="[('source_type', '=', 'employee')]"/>
                <filter name="from_payslip" string="From Payslips"
                        domain="[('source_type', '=', 'payslip')]"/>
                <separator/>
                <filter name="anonymized" string="Anonymized"
                        domain="[('is_anonymized', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_config" string="Configuration"
                            context="{'group_by': 'config_id'}"/>
                    <filter name="group_source" string="Source Type"
                            context="{'group_by': 'source_type'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'validation_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==========================================
         TEST RESULTS VIEWS
         ========================================== -->

    <record id="view_formula_test_result_tree" model="ir.ui.view">
        <field name="name">hr.formula.test.result.tree</field>
        <field name="model">hr.formula.test.result</field>
        <field name="arch" type="xml">
            <tree string="Test Results" decoration-success="status == 'passed'"
                  decoration-warning="status == 'warning'" decoration-danger="status == 'failed'">
                <field name="test_date"/>
                <field name="config_id"/>
                <field name="sample_id"/>
                <field name="rule_code"/>
                <field name="expected_value"/>
                <field name="computed_value"/>
                <field name="difference"/>
                <field name="discrepancy_percent"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'passed'"
                       decoration-warning="status == 'warning'"
                       decoration-danger="status == 'failed'"/>
            </tree>
        </field>
    </record>

    <record id="view_formula_test_result_form" model="ir.ui.view">
        <field name="name">hr.formula.test.result.form</field>
        <field name="model">hr.formula.test.result</field>
        <field name="arch" type="xml">
            <form string="Test Result" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Test Info">
                            <field name="config_id"/>
                            <field name="sample_id"/>
                            <field name="rule_code"/>
                            <field name="test_date"/>
                        </group>
                        <group string="Values">
                            <field name="expected_value"/>
                            <field name="computed_value"/>
                            <field name="difference"/>
                            <field name="discrepancy_percent"/>
                        </group>
                    </group>
                    <group>
                        <field name="status" widget="badge"/>
                        <field name="error_message" attrs="{'invisible': [('error_message', '=', False)]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==========================================
         ACTIONS
         ========================================== -->

    <record id="action_sample_data" model="ir.actions.act_window">
        <field name="name">Sample Data</field>
        <field name="res_model">hr.formula.sample.data</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create sample data for formula testing
            </p>
            <p>
                Import data from real employees/payslips (anonymized) or create
                manual test cases to validate your formula configurations.
            </p>
        </field>
    </record>

    <record id="action_test_results" model="ir.actions.act_window">
        <field name="name">Test Results</field>
        <field name="res_model">hr.formula.test.result</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No test results yet
            </p>
            <p>
                Run tests on sample data to see results here.
            </p>
        </field>
    </record>

</odoo>
