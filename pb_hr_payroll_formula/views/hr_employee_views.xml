<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="formula_hr_employee_view_form" model="ir.ui.view">
        <field name="name">formula.hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='user']" position="after">
                <group string="Work timezone" name="payroll_work_timezone">
                    <field name="payroll_country" help="Defaults the employee’s work timezone unless a work-location timezone is explicitly set. This is not nationality."/>
                    <field name="pb_work_timezone_note" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='payroll_work_timezone']/field[@name='pb_work_timezone_note']" position="before">
                <xpath expr="//field[@name='tz']" position="move"/>
            </xpath>
            <!-- All custom fields moved to Others page for Odoo 19 compatibility -->
            <xpath expr="//notebook" position="inside">
                <page name="payroll_info" string="Payroll Info">
                    <group>
                        <group string="Employee Payroll Settings">
                            <field name="date_of_joining"/>
                            <field name="overtime_status"/>
                            <field name="fire_prevention_officer"/>
                            <field name="tham_gia_bhxh"/>
                            <field name="level_of_health_compensation"/>
                            <field name="subject_to_pit"/>
                            <field name="trade_union_participation"/>
                            <field name="funeral_fund_participation"/>
                        </group>
                        <group string="Other Settings">
                            <field name="female_excluding_pregnant"/>
                            <field name="osh_worker_code"/>
                            <field name="insurance_code"/>
                            <field name="trade_union_fee_code"/>
                            <field name="basic_overtime_electricity"/>
                            <field name="bd_phsk"/>
                            <field name="deduction_of_funeral_money"/>
                            <field name="different_subjects"/>
                            <field name="legal_entity_pays_salary"/>
                            <field name="bank_name"/>
                            <field name="account_number"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="payroll_work_location_timezone" model="ir.ui.view">
        <field name="name">hr.work.location.payroll.timezone</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <field name="address_id" position="after">
                <field name="pb_work_timezone" placeholder="Use the work-location country"/>
            </field>
        </field>
    </record>

</odoo>

