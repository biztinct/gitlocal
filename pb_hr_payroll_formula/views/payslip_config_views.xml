<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payslip_config_tree" model="ir.ui.view">
        <field name="name">hr.payslip.config.tree</field>
        <field name="model">hr.payslip.config</field>
        <field name="arch" type="xml">
            <list string="Payslip Configuration" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="salary_structure_id" required="1"/>
                <field name="identifier"/>
                <field name="label"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_config_search" model="ir.ui.view">
        <field name="name">hr.payslip.config.search</field>
        <field name="model">hr.payslip.config</field>
        <field name="arch" type="xml">
            <search string="Payslip Configuration">
                <field name="salary_structure_id"/>
                <field name="identifier"/>
                <field name="label"/>
            </search>
        </field>
    </record>

    <record id="action_payslip_config" model="ir.actions.act_window">
        <field name="name">Payslip Configuration</field>
        <field name="res_model">hr.payslip.config</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_payslip_config_tree"/>
        <field name="search_view_id" ref="view_payslip_config_search"/>
        <field name="target">current</field>
    </record>

</odoo>
