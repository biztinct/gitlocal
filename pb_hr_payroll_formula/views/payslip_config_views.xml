<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payslip_config_tree" model="ir.ui.view">
        <field name="name">hr.payslip.config.tree</field>
        <field name="model">hr.payslip.config</field>
        <field name="arch" type="xml">
            <tree string="Payslip Configuration" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="identifier"/>
                <field name="label"/>
            </tree>
        </field>
    </record>

    <record id="action_payslip_config" model="ir.actions.act_window">
        <field name="name">Payslip Configuration</field>
        <field name="res_model">hr.payslip.config</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_payslip_config_tree"/>
        <field name="target">current</field>
    </record>

</odoo>
