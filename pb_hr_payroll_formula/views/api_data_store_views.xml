<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================
         API DATA STORE — TREE VIEW
         ========================================== -->

    <record id="view_api_data_store_tree" model="ir.ui.view">
        <field name="name">hr.api.data.store.tree</field>
        <field name="model">hr.api.data.store</field>
        <field name="arch" type="xml">
            <list string="API Data Store"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'archived'"
                  decoration-success="state == 'extracted'"
                  decoration-info="state == 'consumed'">
                <field name="connector_id"/>
                <field name="employee_external_id"/>
                <field name="employee_id"/>
                <field name="data_type"/>
                <field name="period_label"/>
                <field name="pull_date"/>
                <field name="version"/>
                <field name="has_changes" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'extracted'"
                       decoration-info="state == 'consumed'"
                       decoration-danger="state == 'error'"
                       decoration-muted="state == 'archived'"
                       decoration-warning="state == 'raw'"/>
            </list>
        </field>
    </record>

    <!-- ==========================================
         API DATA STORE — FORM VIEW
         ========================================== -->

    <record id="view_api_data_store_form" model="ir.ui.view">
        <field name="name">hr.api.data.store.form</field>
        <field name="model">hr.api.data.store</field>
        <field name="arch" type="xml">
            <form string="API Data Store Record">
                <header>
                    <button name="action_extract" string="Re-Extract" type="object"
                            class="btn-primary"
                            invisible="state not in ('raw', 'error')"/>
                    <button name="action_re_extract" string="Re-Extract from Raw" type="object"
                            invisible="state not in ('extracted', 'consumed')"/>
                    <button name="action_match_employees" string="Match Employee" type="object"
                            invisible="employee_id"/>
                    <button name="action_recompute_transformations" string="Recompute Transformations"
                            type="object"
                            invisible="state not in ('extracted', 'consumed')"/>
                    <button name="action_archive" string="Archive" type="object"
                            invisible="state == 'archived'"
                            confirm="Archive this record? It will be hidden from default views."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="raw,extracted,consumed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Error" bg_color="bg-danger"
                            invisible="state != 'error'"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-secondary"
                            invisible="state != 'archived'"/>
                    <widget name="web_ribbon" title="Changes Detected" bg_color="bg-warning"
                            invisible="not has_changes"/>

                    <group>
                        <group string="Identity">
                            <field name="connector_id"/>
                            <field name="data_type"/>
                            <field name="employee_external_id"/>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Pull Metadata">
                            <field name="pull_date"/>
                            <field name="pull_duration_ms"/>
                            <field name="pull_triggered_by"/>
                            <field name="version"/>
                            <field name="previous_version_id"/>
                        </group>
                    </group>

                    <group>
                        <group string="Period">
                            <field name="period_from"/>
                            <field name="period_to"/>
                            <field name="period_label"/>
                        </group>
                        <group string="Traceability">
                            <field name="import_batch_id"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Extracted Data (most useful for operators) -->
                        <page string="Extracted Data" name="extracted">
                            <field name="extracted_data" widget="json"/>
                        </page>

                        <!-- Computed Data (from transformation rules) -->
                        <page string="Computed Data" name="computed">
                            <field name="computed_data" widget="json"/>
                        </page>

                        <!-- Raw Payload (audit trail) -->
                        <page string="Raw Payload" name="raw">
                            <div class="alert alert-warning mb-3">
                                <i class="fa fa-lock"/> This is the immutable raw API response.
                                It is stored for audit purposes and should not be modified.
                            </div>
                            <field name="raw_payload" widget="json"/>
                        </page>

                        <!-- Changes / Diff -->
                        <page string="Changes" name="changes"
                              invisible="not has_changes">
                            <div class="alert alert-info mb-3">
                                <i class="fa fa-exchange"/>
                                Changes detected compared to previous version (v<field name="version" class="d-inline"/>).
                            </div>
                            <field name="change_summary" widget="json"/>
                        </page>

                        <!-- Error Log -->
                        <page string="Error" name="error"
                              invisible="not error_message">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==========================================
         API DATA STORE — SEARCH VIEW
         ========================================== -->

    <record id="view_api_data_store_search" model="ir.ui.view">
        <field name="name">hr.api.data.store.search</field>
        <field name="model">hr.api.data.store</field>
        <field name="arch" type="xml">
            <search string="API Data Store">
                <field name="employee_external_id"/>
                <field name="employee_id"/>
                <field name="connector_id"/>
                <separator/>
                <filter string="Has Changes" name="has_changes" domain="[('has_changes', '=', True)]"/>
                <filter string="Errors" name="errors" domain="[('state', '=', 'error')]"/>
                <filter string="Ready for Mapping" name="extracted" domain="[('state', '=', 'extracted')]"/>
                <filter string="Consumed" name="consumed" domain="[('state', '=', 'consumed')]"/>
                <filter string="Active (not archived)" name="active_records"
                        domain="[('state', '!=', 'archived')]"/>
                <separator/>
                <filter string="Employee Data" name="type_employee" domain="[('data_type', '=', 'employee')]"/>
                <filter string="Salary Data" name="type_salary" domain="[('data_type', '=', 'salary')]"/>
                <filter string="Attendance" name="type_attendance" domain="[('data_type', '=', 'attendance')]"/>
                <filter string="Leave" name="type_leave" domain="[('data_type', '=', 'leave')]"/>
                <filter string="Dependents" name="type_dependent" domain="[('data_type', '=', 'dependent')]"/>
                <separator/>
                <group name="group_by">
                    <filter string="Connector" name="group_connector" context="{'group_by': 'connector_id'}"/>
                    <filter string="Data Type" name="group_data_type" context="{'group_by': 'data_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Pull Date" name="group_pull_date" context="{'group_by': 'pull_date:month'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==========================================
         API DATA STORE — ACTIONS
         ========================================== -->

    <record id="action_api_data_store" model="ir.actions.act_window">
        <field name="name">API Data Store</field>
        <field name="res_model">hr.api.data.store</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_records': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No API data stored yet
            </p>
            <p>
                Use the "Pull Data" button on a connector to fetch
                data from external HRIS systems and store it here.
            </p>
        </field>
    </record>

</odoo>
