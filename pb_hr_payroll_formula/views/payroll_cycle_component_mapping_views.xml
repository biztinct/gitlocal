<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payroll_cycle_component_mapping_tree" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.component.mapping.tree</field>
        <field name="model">hr.payroll.cycle.component.mapping</field>
        <field name="arch" type="xml">
            <tree string="Mid-Cycle to End-Cycle Mapping" editable="bottom">
                <field name="mid_cycle_config_id"/>
                <field name="mid_component_id"/>
                <field name="end_cycle_config_id"/>
                <field name="end_component_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_payroll_cycle_component_mapping_search" model="ir.ui.view">
        <field name="name">hr.payroll.cycle.component.mapping.search</field>
        <field name="model">hr.payroll.cycle.component.mapping</field>
        <field name="arch" type="xml">
            <search string="Mid-Cycle to End-Cycle Mapping">
                <field name="mid_cycle_config_id"/>
                <field name="end_cycle_config_id"/>
                <field name="mid_component_id"/>
                <field name="end_component_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_mid" string="Mid-Cycle Config" context="{'group_by': 'mid_cycle_config_id'}"/>
                    <filter name="group_end" string="End-Cycle Config" context="{'group_by': 'end_cycle_config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payroll_cycle_component_mapping" model="ir.actions.act_window">
        <field name="name">Mid-Cycle to End-Cycle Mapping</field>
        <field name="res_model">hr.payroll.cycle.component.mapping</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_payroll_cycle_component_mapping_search"/>
    </record>

</odoo>
