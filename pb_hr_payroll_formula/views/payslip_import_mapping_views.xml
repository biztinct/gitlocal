<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payslip_import_mapping_tree" model="ir.ui.view">
        <field name="name">hr.payslip.import.mapping.tree</field>
        <field name="model">hr.payslip.import.mapping</field>
        <field name="arch" type="xml">
            <list string="Employee/Contract Field Mapping" editable="bottom">
                <!-- COLROLES P3 — a mapping now has two shapes. The model/field pair
                     is no longer required at the database level, so the list has to
                     say which shape a row is or a bank row reads as a broken one. -->
                <field name="destination_type"/>
                <field name="target_model_id"
                       required="destination_type == 'field'"
                       readonly="destination_type == 'bank_account'"/>
                <field name="target_field_id" string="Field"
                       required="destination_type == 'field'"
                       readonly="destination_type == 'bank_account'"/>
                <field name="bank_role" string="Bank Detail"
                       required="destination_type == 'bank_account'"
                       readonly="destination_type != 'bank_account'"/>
                <field name="salary_structure_id" context="{'no_code_display': True}"/>
                <field name="component_id" string="Component"/>
            </list>
        </field>
    </record>

    <record id="view_payslip_import_mapping_search" model="ir.ui.view">
        <field name="name">hr.payslip.import.mapping.search</field>
        <field name="model">hr.payslip.import.mapping</field>
        <field name="arch" type="xml">
            <search string="Employee/Contract Field Mapping">
                <field name="salary_structure_id" context="{'no_code_display': True}"/>
                <field name="target_model_id"/>
                <field name="target_field_id"/>
                <field name="component_id"/>
                <filter name="dest_field" string="Field destinations"
                        domain="[('destination_type', '=', 'field')]"/>
                <filter name="dest_bank" string="Bank destinations"
                        domain="[('destination_type', '=', 'bank_account')]"/>
            </search>
        </field>
    </record>

    <record id="action_payslip_import_mapping" model="ir.actions.act_window">
        <field name="name">Employee/Contract Field Mapping</field>
        <field name="res_model">hr.payslip.import.mapping</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_payslip_import_mapping_tree"/>
        <field name="search_view_id" ref="view_payslip_import_mapping_search"/>
        <field name="target">current</field>
    </record>

</odoo>
