<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================
         INTEGRATION CONNECTOR VIEWS
         ========================================== -->

    <record id="view_integration_connector_tree" model="ir.ui.view">
        <field name="name">hr.integration.connector.tree</field>
        <field name="model">hr.integration.connector</field>
        <field name="arch" type="xml">
            <list string="HR System Connectors">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="connector_type"/>
                <field name="country_code"/>
                <field name="connection_status" widget="badge"
                       decoration-success="connection_status == 'connected'"
                       decoration-danger="connection_status == 'error'"
                       decoration-warning="connection_status == 'disconnected'"/>
                <field name="last_sync"/>
                <field name="mapping_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_integration_connector_form" model="ir.ui.view">
        <field name="name">hr.integration.connector.form</field>
        <field name="model">hr.integration.connector</field>
        <field name="arch" type="xml">
            <form string="HR System Connector">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object"
                            class="btn-primary"/>
                    <button name="action_pull_data" string="Pull Data" type="object"
                            class="btn-secondary"
                            invisible="connection_status != 'connected' or connector_type == 'excel'"
                            confirm="Pull data from the external HRIS? This will store new records in the API Data Store."/>
                    <button name="action_sync_now" string="Sync Now" type="object"
                            invisible="connection_status != 'connected'"/>
                    <button name="action_fetch_available_fields" string="Fetch Fields" type="object"
                            invisible="connector_type == 'excel'"/>
                    <field name="connection_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_launch_payroll_import"
                                icon="fa-upload"
                                invisible="connection_status != 'connected'">
                            <span class="o_stat_text">Payroll Import</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_data_store"
                                icon="fa-database"
                                invisible="connector_type == 'excel'">
                            <field name="data_store_count" widget="statinfo" string="Data Store"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_mappings"
                                icon="fa-exchange">
                            <field name="mapping_count" widget="statinfo" string="Mappings"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Error" bg_color="bg-danger"
                            invisible="connection_status != 'error'"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Zoho People - Vietnam"/>
                        </h1>
                    </div>

                    <!-- Visual Connector Type Icons Guide -->
                    <div class="alert alert-info" style="margin: 10px 0;">
                        <h5 style="margin-top: 0;">Connector Types:</h5>
                        <div class="row">
                            <div class="col-md-2 text-center" style="padding: 10px;">
                                <i class="fa fa-cloud fa-2x text-primary"/>
                                <br/><small>Zoho People</small>
                            </div>
                            <div class="col-md-2 text-center" style="padding: 10px;">
                                <i class="fa fa-file-excel-o fa-2x text-success"/>
                                <br/><small>Excel Import</small>
                            </div>
                            <div class="col-md-2 text-center" style="padding: 10px;">
                                <i class="fa fa-building fa-2x text-info"/>
                                <br/><small>SAP SuccessFactors</small>
                            </div>
                            <div class="col-md-2 text-center" style="padding: 10px;">
                                <i class="fa fa-calendar fa-2x text-warning"/>
                                <br/><small>Workday</small>
                            </div>
                            <div class="col-md-2 text-center" style="padding: 10px;">
                                <i class="fa fa-database fa-2x text-danger"/>
                                <br/><small>Oracle HCM</small>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Connection Type">
                            <field name="connector_type" widget="radio"/>
                            <field name="country_code"/>
                            <field name="active"/>
                        </group>
                        <group string="Status">
                            <field name="last_sync"/>
                            <field name="last_sync_status" widget="badge"/>
                            <field name="sync_interval"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- API Settings -->
                        <page string="API Settings" name="api"
                              invisible="connector_type == 'excel'">
                            <group>
                                <group string="Endpoint">
                                    <field name="api_endpoint"/>
                                    <field name="api_version"/>
                                </group>
                                <group string="Authentication">
                                    <field name="auth_type"/>
                                </group>
                            </group>
                            <group string="OAuth 2.0 Settings"
                                   invisible="auth_type != 'oauth2'">
                                <field name="oauth_authorize_url"/>
                                <field name="oauth_token_url"/>
                                <field name="oauth_scope"/>
                                <field name="oauth_redirect_uri"/>
                            </group>
                        </page>

                        <!-- Credentials -->
                        <page string="Credentials" name="credentials"
                              groups="base.group_system"
                              invisible="connector_type == 'excel'">
                            <group>
                                <field name="client_id"/>
                                <field name="client_secret" password="True"/>
                                <field name="api_key" password="True"
                                       invisible="auth_type != 'api_key'"/>
                                <field name="username"
                                       invisible="auth_type != 'basic'"/>
                                <field name="password" password="True"
                                       invisible="auth_type != 'basic'"/>
                            </group>
                            <group string="Tokens" invisible="auth_type != 'oauth2'">
                                <field name="access_token" password="True"/>
                                <field name="refresh_token" password="True"/>
                                <field name="token_expiry"/>
                            </group>
                        </page>

                        <!-- Excel Import Settings -->
                        <page string="Excel Settings" name="excel"
                              invisible="connector_type != 'excel'">
                            <group>
                                <group string="File Settings">
                                    <field name="file_header_row"/>
                                    <field name="file_data_start_row"/>
                                    <field name="file_sheet_name"/>
                                </group>
                                <group string="Last Import">
                                    <field name="last_import_filename"/>
                                </group>
                            </group>
                            <!-- Import button removed for Excel connector as it served no purpose -->
                        </page>

                        <!-- Field Mappings -->
                        <page string="Field Mappings" name="mappings"
                              invisible="connector_type == 'excel'">
                            <field name="field_mapping_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="source_field" widget="source_field_autocomplete"/>
                                    <field name="source_field_label"/>
                                    <field name="source_data_type"/>
                                    <field name="target_rule_id"/>
                                    <field name="transformation_type"/>
                                    <field name="transformation_value"
                                           invisible="transformation_type in ('direct', 'python')"/>
                                    <field name="is_required"/>
                                    <field name="default_value"/>
                                    <button name="action_open_form" type="object"
                                            icon="fa-pencil" title="Open"
                                            class="btn-link"/>
                                </list>
                            </field>
                        </page>

                        <!-- Transformation Rules -->
                        <page string="Transformation Rules" name="transformations"
                              invisible="connector_type == 'excel'">
                            <div class="alert alert-info mb-3">
                                <i class="fa fa-magic"/> Transformation rules derive computed values
                                from stored API data (e.g., count dependents, calculate tenure).
                                Results are merged with extracted data at mapping time.
                            </div>
                            <field name="transformation_rule_ids" nolabel="1"
                                   context="{'default_connector_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="output_key"/>
                                    <field name="rule_type"/>
                                    <field name="source_data_type"/>
                                    <field name="aggregate_field"
                                           invisible="rule_type not in ('sum', 'avg', 'min', 'max')"/>
                                    <field name="default_value"/>
                                    <field name="active"/>
                                    <button name="action_open_form" type="object"
                                            icon="fa-pencil" title="Open"
                                            class="btn-link"/>
                                </list>
                            </field>
                            <div class="mt-2">
                                <button name="action_recompute_transformations"
                                        string="⟳ Recompute All" type="object"
                                        class="btn-secondary btn-sm"
                                        confirm="Recompute all transformation rules for extracted records?"/>
                            </div>
                        </page>

                        <!-- Error Log -->
                        <page string="Error Log" name="errors"
                              invisible="not last_error">
                            <field name="last_error" readonly="1"/>
                            <field name="last_sync_message" readonly="1"/>
                        </page>
                    </notebook>

                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==========================================
         FIELD MAPPING VIEWS
         ========================================== -->

    <record id="view_field_mapping_tree" model="ir.ui.view">
        <field name="name">hr.integration.field.mapping.tree</field>
        <field name="model">hr.integration.field.mapping</field>
        <field name="arch" type="xml">
            <list string="Field Mappings" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="connector_id"/>
                <field name="source_field" widget="source_field_autocomplete"/>
                <field name="source_field_label"/>
                <field name="source_data_type"/>
                <field name="target_rule_id"/>
                <field name="target_column_letter"/>
                <field name="transformation_type"/>
                <field name="is_mapped" widget="boolean"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_field_mapping_form" model="ir.ui.view">
        <field name="name">hr.integration.field.mapping.form</field>
        <field name="model">hr.integration.field.mapping</field>
        <field name="arch" type="xml">
            <form string="Field Mapping">
                <header>
                    <button name="action_test_against_employee" type="object"
                            string="Test against employee" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Source">
                            <field name="connector_id"/>
                            <field name="source_field" widget="source_field_autocomplete"/>
                            <field name="source_field_label"/>
                            <field name="source_data_type"/>
                            <field name="source_sample_value"/>
                        </group>
                        <group string="Target">
                            <field name="target_rule_id" domain="[('column_type', '=', 'input')]"/>
                            <field name="target_column_letter"/>
                            <field name="target_rule_code"/>
                        </group>
                    </group>
                    <group string="Transformation">
                        <field name="transformation_type"/>
                        <field name="transformation_value"
                               invisible="transformation_type in ('direct', 'python')"/>
                        <field name="transformation_decimals"
                               invisible="transformation_type != 'round'"/>
                        <field name="transformation_code"
                               invisible="transformation_type != 'python'"/>
                    </group>
                    <group string="Validation">
                        <field name="is_required"/>
                        <field name="default_value"/>
                        <field name="min_value"/>
                        <field name="max_value"/>
                    </group>
                    <group>
                        <button name="action_test_mapping" string="Test Mapping" type="object"/>
                        <button name="action_auto_map" string="Auto-Map" type="object"/>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Connector Kanban View -->
    <record id="view_integration_connector_kanban" model="ir.ui.view">
        <field name="name">hr.integration.connector.kanban</field>
        <field name="model">hr.integration.connector</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="true" edit="true" delete="true">
                <field name="name"/>
                <field name="connector_type"/>
                <field name="country_code"/>
                <field name="connection_status"/>
                <field name="last_sync"/>
                <field name="mapping_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="connection_status" widget="badge"
                                       decoration-success="connection_status == 'connected'"
                                       decoration-danger="connection_status == 'error'"
                                       decoration-warning="connection_status == 'disconnected'"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <span class="text-muted">Type:</span>
                                        <br/>
                                        <strong><field name="connector_type"/></strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">Country:</span>
                                        <br/>
                                        <strong><field name="country_code"/></strong>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <i class="fa fa-exchange"/> <field name="mapping_count"/> mappings
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-3">
                                <div class="oe_kanban_bottom_left">
                                    <field name="last_sync"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==========================================
         ACTIONS
         ========================================== -->

    <record id="action_integration_connector" model="ir.actions.act_window">
        <field name="name">HR System Connectors</field>
        <field name="res_model">hr.integration.connector</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect to external HR systems
            </p>
            <p>
                Configure connections to Zoho People, SAP SuccessFactors,
                Workday, Oracle HCM, or import data from Excel files.
            </p>
        </field>
    </record>

    <!-- Kanban View Action for Connectors -->
    <record id="action_integration_connector_kanban" model="ir.actions.act_window">
        <field name="name">HR System Connectors</field>
        <field name="res_model">hr.integration.connector</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_integration_connector_kanban"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect to external HR systems
            </p>
            <p>
                Configure connections to Zoho People, SAP SuccessFactors,
                Workday, Oracle HCM, or import data from Excel files.
            </p>
        </field>
    </record>

    <record id="action_field_mapping" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">hr.integration.field.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
