<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_json_tabs" model="ir.ui.view">
        <field name="name">hr.payslip.form.json.tabs</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="calculation_method" invisible="1"/>
                <!-- Also offered on a payslip NOT yet marked as formula but with
                     no salary structure either: that is the payslip showing 0.00
                     the button exists to repair, and hiding it there left the
                     screen with no remedy at all. `action_recompute_formula_lines`
                     resolves the scheme and sets both fields as it goes. -->
                <button name="action_recompute_formula_lines"
                        type="object"
                        string="Recompute Formulas"
                        class="oe_highlight"
                        invisible="calculation_method != 'formula' and struct_id"/>
            </xpath>
            <!-- Formula-computed payslips carry no salary structure (they compute
                 via the formula engine), yet the native form marks struct_id
                 required whenever a contract is set — and readonly here — so Confirm
                 would fail "Missing required fields" with no way to fix it. Only
                 require a structure for non-formula payslips.

                 RD47 — AND IT HAD TO REACH THE FIELD IN THE SHEET. This xpath
                 matches the FIRST `struct_id` in document order, and the header
                 insert above used to add one — so the relaxed condition landed
                 on the duplicate this view had just created, and the real field
                 in the sheet kept `required="contract_id"`. Every formula
                 payslip therefore refused to save with "Missing required
                 fields", from Confirm, from Cancel Payslip and from any button
                 that saves first; it went unnoticed because the run-level
                 buttons never open the payslip form. The header field is gone
                 (a modifier can read any field in the view, wherever it sits),
                 so this xpath now reaches the one that was always the problem.
                 Verified on the served arch, not on the source: two `struct_id`
                 fields with two different `required` expressions is exactly
                 what reading only this file hides. -->
            <xpath expr="//field[@name='struct_id']" position="attributes">
                <attribute name="required">contract_id and calculation_method != 'formula'</attribute>
            </xpath>
            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Formula Input JSON" name="formula_input_json">

                        <field name="formula_input_values" colspan="4" nolabel="1" widget="text"
                               class="o_payslip_json_field"/>

                </page>
                <page string="Formula Computed JSON" name="formula_computed_json">

                        <field name="formula_computed_values" colspan="4" nolabel="1" widget="text" readonly="1"
                               class="o_payslip_json_field"/>

                </page>
                <page string="Payslip Identifier JSON" name="payslip_identifier_json">

                        <field name="payslip_identifier_payload" colspan="4" nolabel="1" widget="text" readonly="1"
                               class="o_payslip_json_field"/>

                </page>
                <page string="Report Visible JSON" name="report_visible_json">

                        <field name="report_visible_string_payload" colspan="4" nolabel="1" widget="text" readonly="1"
                               class="o_payslip_json_field"/>

                </page>
            </xpath>
        </field>
    </record>
</odoo>
