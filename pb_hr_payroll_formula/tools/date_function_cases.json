  {"id": "garbage-year", "formula": "=YEAR(I2)", "values": {"I": "not a date"}, "expected": 0},
  {"id": "garbage-day", "formula": "=DAY(I2)", "values": {"I": "2024-02-30"}, "expected": 0, "note": "an impossible date is unreadable"},
  {"id": "blank-datedif", "formula": "=DATEDIF(I2,DATE(2024,1,1),\"Y\")", "values": {"I": ""}, "expected": 0},
  {"id": "blank-edate", "formula": "=EDATE(I2,1)", "values": {"I": ""}, "expected": 0},
  {"id": "blank-eomonth", "formula": "=EOMONTH(I2,1)", "values": {"I": ""}, "expected": 0},
  {"id": "blank-days", "formula": "=DAYS(DATE(2024,1,1),I2)", "values": {"I": ""}, "expected": 0},
  {"id": "blank-test", "formula": "=IF(YEAR(I2)=0,1,2)", "values": {"I": ""}, "expected": 1, "note": "the documented blank test"},
  {"id": "period-end", "formula": "=DATE(J2,K2,L2)", "expected": 45351, "note": "DATE(PAYYEAR, PAYMONTH, ENDDAY)"},
  {"id": "service-feb29-end", "formula": "=DATEDIF(I2,DATE(J2,K2,L2),\"Y\")", "values": {"I": "2020-02-29"}, "expected": 4, "note": "joiner on 29 Feb, period ends 29 Feb 2024"},
  {"id": "service-on-period-end", "formula": "=DATEDIF(I2,DATE(J2,K2,L2),\"Y\")", "values": {"I": "2023-02-28", "K": 2, "L": 28, "J": 2024}, "expected": 1, "note": "joined exactly one year before the period end"},
  {"id": "service-day-after", "formula": "=DATEDIF(I2,DATE(J2,K2,L2),\"Y\")", "values": {"I": "2023-03-01", "K": 2, "L": 29, "J": 2024}, "expected": 0, "note": "joined one day after the period-end date a year earlier"},
