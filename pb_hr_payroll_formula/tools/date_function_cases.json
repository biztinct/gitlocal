  {"id": "date-day-zero-jan", "formula": "=DATE(2024,1,0)", "expected": 45291},
  {"id": "date-truncates", "formula": "=DATE(2024.9,1.9,15.9)", "expected": 45306},
  {"id": "date-two-digit-year", "formula": "=YEAR(DATE(24,1,1))", "expected": 1924},
  {"id": "year-60", "formula": "=YEAR(60)", "expected": 1900},
  {"id": "month-60", "formula": "=MONTH(60)", "expected": 2},
  {"id": "day-60", "formula": "=DAY(60)", "expected": 29, "note": "serial 60 reads as 29 Feb 1900, as in Excel"},
  {"id": "year-leap", "formula": "=YEAR(DATE(2024,2,29))", "expected": 2024},
  {"id": "month-leap", "formula": "=MONTH(DATE(2024,2,29))", "expected": 2},
  {"id": "day-leap", "formula": "=DAY(DATE(2024,2,29))", "expected": 29},
  {"id": "day-not-leap", "formula": "=DAY(DATE(2023,2,29))", "expected": 1, "note": "2023 is not a leap year: 1 Mar"},
  {"id": "day-2100", "formula": "=DAY(DATE(2100,2,29))", "expected": 1, "note": "2100 is not a leap year"},
  {"id": "year-serial", "formula": "=YEAR(45306)", "expected": 2024},
  {"id": "day-serial-time", "formula": "=DAY(45306.75)", "expected": 15, "note": "time of day dropped"},
  {"id": "edate-month-end-leap", "formula": "=EDATE(DATE(2024,1,31),1)", "expected": 45351, "note": "31 Jan + 1 month = 29 Feb 2024"},
