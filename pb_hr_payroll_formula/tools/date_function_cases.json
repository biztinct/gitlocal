  {"id": "edate-negative", "formula": "=EDATE(DATE(2024,3,31),-1)", "expected": 45351},
  {"id": "edate-negative-year", "formula": "=EDATE(DATE(2024,1,15),-13)", "expected": 44910},
  {"id": "eomonth-next", "formula": "=EOMONTH(DATE(2024,1,31),1)", "expected": 45351},
  {"id": "eomonth-same", "formula": "=EOMONTH(DATE(2024,1,15),0)", "expected": 45322},
  {"id": "eomonth-negative", "formula": "=EOMONTH(DATE(2024,3,15),-1)", "expected": 45351},
  {"id": "eomonth-negative-2", "formula": "=EOMONTH(DATE(2024,1,15),-2)", "expected": 45260},
  {"id": "days-forward", "formula": "=DAYS(DATE(2024,3,1),DATE(2024,1,1))", "expected": 60},
  {"id": "days-negative", "formula": "=DAYS(DATE(2024,1,1),DATE(2024,3,1))", "expected": -60},
