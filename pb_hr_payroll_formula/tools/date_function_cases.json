  {"id": "ref-year-iso", "formula": "=YEAR(I2)", "values": {"I": "2024-01-15"}, "expected": 2024, "note": "a date component inside a date function reads the date"},
  {"id": "ref-days-iso", "formula": "=DAYS(DATE(2024,2,1),I2)", "values": {"I": "2024-01-15"}, "expected": 17},
  {"id": "ref-datedif-iso-before", "formula": "=DATEDIF(I2,DATE(2025,1,14),\"Y\")", "values": {"I": "2024-01-15"}, "expected": 0},
