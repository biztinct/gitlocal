{
 "_about": "WDGAP PR-A shared date-function battery. Read by tools/excel_semantics_battery.py (both Python evaluation paths), tests/test_wdgap_pra_dates.py (all three paths in Odoo) and pb_formula_studio/tools/date_functions_battery.mjs (the Studio flowchart's JS mirror). Expected values are Excel's (1900 date system serials). Columns: I=JOIN (a date component, ISO text), J=PAYYEAR, K=PAYMONTH, L=ENDDAY, M=DAY (a component coded DAY). 'values' overrides the defaults by column letter. 'py_only' cases use component codes, which the JS mirror (cell references only) does not read.",
 "columns": {"I": "JOIN", "J": "PAYYEAR", "K": "PAYMONTH", "L": "ENDDAY", "M": "DAY"},
 "defaults": {"I": "2020-02-29", "J": 2024, "K": 2, "L": 29, "M": 3},
 "cases": [
  {"id": "date-basic", "formula": "=DATE(2024,1,15)", "expected": 45306},
  {"id": "date-first", "formula": "=DATE(1900,1,1)", "expected": 1},
  {"id": "date-1900-feb29", "formula": "=DATE(1900,2,29)", "expected": 60, "note": "Excel's phantom 29 Feb 1900"},
  {"id": "date-1900-mar1", "formula": "=DATE(1900,3,1)", "expected": 61},
  {"id": "date-month-overflow", "formula": "=DATE(2024,13,1)", "expected": 45658},
