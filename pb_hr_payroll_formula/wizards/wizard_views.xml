<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================
         SAMPLE DATA WIZARD
         ========================================== -->

    <record id="view_formula_sample_data_wizard_form" model="ir.ui.view">
        <field name="name">hr.formula.sample.data.wizard.form</field>
        <field name="model">hr.formula.sample.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Sample Data">
                <group>
                    <field name="config_id" readonly="1"/>
                    <field name="source" widget="radio"/>
                </group>

                <!-- Employee Selection -->
                <group invisible="source != 'employees'">
                    <field name="employee_ids" widget="many2many_tags"
                           placeholder="Leave empty to use all active employees"/>
                </group>

                <!-- Payslip Selection -->
                <group invisible="source != 'payslips'">
                    <field name="payslip_ids" widget="many2many_tags"
                           domain="[('state', '=', 'done')]"
                           placeholder="Leave empty to use recent payslips"/>
                </group>

                <!-- File Import -->
                <group invisible="source != 'file'">
                    <field name="import_file" filename="import_filename"
                           string="Excel File"
                           required="source == 'file'"/>
                    <field name="import_filename" invisible="1"/>
                    <div class="o_form_label">First row headers; subsequent rows are samples.</div>
                </group>

                <!-- Random Generation Options -->
                <group string="Random Generation Settings"
                       invisible="source != 'random'">
                    <field name="sample_count"/>
                    <field name="min_salary"/>
                    <field name="max_salary"/>
                </group>

                <!-- Options -->
                <group string="Options">
                    <field name="anonymize"/>
                    <field name="include_expected"
                           invisible="source != 'payslips'"/>
                    <field name="sample_count"
                           invisible="source != 'random'"/>
                </group>

                <footer>
                    <button name="action_generate_samples" string="Generate Samples"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_formula_sample_data_wizard" model="ir.actions.act_window">
        <field name="name">Generate Sample Data</field>
        <field name="res_model">hr.formula.sample.data.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ==========================================
         FORMULA IMPORT WIZARD
         ========================================== -->

    <record id="view_formula_import_wizard_form" model="ir.ui.view">
        <field name="name">hr.formula.import.wizard.form</field>
        <field name="model">hr.formula.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Formula Configuration">
                <group>
                    <field name="config_id" readonly="1"/>
                    <field name="import_source" widget="radio"/>
                </group>

                <!-- Salary Rules Selection -->
                <group invisible="import_source not in ['salary_rules', 'structure']">
                    <field name="structure_id"
                           invisible="import_source != 'structure'"
                           required="import_source == 'structure'"/>
                    <field name="salary_rule_ids" widget="many2many_tags"
                           invisible="import_source != 'salary_rules'"/>
                </group>

                <!-- File Upload -->
                <group invisible="import_source not in ['json', 'excel']">
                    <field name="import_file" filename="import_filename"
                           required="import_source in ['json', 'excel']"/>
                    <field name="import_filename" invisible="1"/>
                </group>

                <!-- Options -->
                <group string="Options">
                    <field name="create_input_columns"/>
                    <field name="preserve_existing"/>
                    <field name="map_categories"
                           invisible="import_source not in ['salary_rules', 'structure']"/>
                </group>

                <footer>
                    <button name="action_import" string="Import"
                            type="object" class="btn-primary"/>
                    <button name="action_download_template" string="Download Template"
                            type="object" class="btn-secondary"
                            invisible="import_source != 'excel'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_formula_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Formula Configuration</field>
        <field name="res_model">hr.formula.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ==========================================
         INTEGRATION SYNC WIZARD (Advanced Pull)
         ========================================== -->

    <record id="view_integration_sync_wizard_form" model="ir.ui.view">
        <field name="name">hr.integration.sync.wizard.form</field>
        <field name="model">hr.integration.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Pull Data with Options">

                <sheet>
                    <!-- Setup State -->
                    <div invisible="state != 'setup'">
                        <div class="alert alert-info mb-3">
                            <i class="fa fa-info-circle"/>
                            Select what data to pull, the period, and optionally
                            preview before committing. Data flows into the
                            <b>API Data Store</b> and transformation rules run automatically.
                        </div>

                        <group>
                            <group string="Connection">
                                <field name="connector_id" readonly="1"/>
                                <field name="connector_type" invisible="1"/>
                            </group>
                            <group string="Period">
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                        </group>

                        <group>
                            <group string="Data Types to Pull">
                                <field name="pull_employee"/>
                                <field name="pull_salary"/>
                                <field name="pull_dependent"/>
                                <field name="pull_attendance"/>
                                <field name="pull_leave"/>
                            </group>
                            <group string="Options">
                                <field name="max_records"/>
                                <field name="run_transformations"/>
                            </group>
                        </group>

                        <!-- Excel file upload (only for Excel connectors) -->
                        <group string="File Upload"
                               invisible="connector_type != 'excel'">
                            <field name="import_file" filename="import_filename"/>
                            <field name="import_filename" invisible="1"/>
                        </group>
                    </div>

                    <!-- Preview State -->
                    <div invisible="state != 'preview'">
                        <div class="alert alert-warning mb-3">
                            <i class="fa fa-eye"/>
                            <b>Preview</b> — Review the data below, then click
                            <b>Pull Now</b> to commit to the Data Store.
                        </div>

                        <group>
                            <group>
                                <field name="preview_employee_count"/>
                                <field name="preview_record_count"/>
                            </group>
                        </group>

                        <field name="preview_data" widget="text" readonly="1"
                               nolabel="1" class="o_field_text"
                               style="font-family: monospace; white-space: pre-wrap;"/>
                    </div>

                    <!-- Done State -->
                    <div invisible="state != 'done'">
                        <div class="alert alert-success mb-3">
                            <i class="fa fa-check-circle"/>
                            Data has been pulled into the API Data Store.
                        </div>
                    </div>
                </sheet>

                <footer>
                    <!-- Setup buttons -->
                    <button name="action_preview" string="Preview"
                            type="object" class="btn-secondary"
                            invisible="state != 'setup'"
                            title="Preview what will be pulled"/>
                    <button name="action_pull" string="Pull Now"
                            type="object" class="btn-primary"
                            invisible="state != 'setup'"
                            title="Pull immediately without preview"/>

                    <!-- Preview buttons -->
                    <button name="action_pull" string="Pull Now"
                            type="object" class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button name="action_back_to_setup" string="← Back"
                            type="object" class="btn-secondary"
                            invisible="state != 'preview'"/>

                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_integration_sync_wizard" model="ir.actions.act_window">
        <field name="name">Pull Data with Options</field>
        <field name="res_model">hr.integration.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ==========================================
         COMPUTE SAMPLE WIZARD
         ========================================== -->
    <record id="view_compute_sample_wizard_form" model="ir.ui.view">
        <field name="name">hr.formula.compute.wizard.form</field>
        <field name="model">hr.formula.compute.wizard</field>
        <field name="arch" type="xml">
            <form string="Check Calculations">
                <group>
                    <field name="note" nolabel="1" readonly="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_run" string="Continue" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_compute_sample_wizard" model="ir.actions.act_window">
        <field name="name">Sync &amp; Compute</field>
        <field name="res_model">hr.formula.compute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_sample_id': active_id}</field>
    </record>

</odoo>
