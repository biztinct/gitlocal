<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payslip_config_wizard_form" model="ir.ui.view">
        <field name="name">hr.payslip.config.wizard.form</field>
        <field name="model">hr.payslip.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Payslip Configuration">
                <group>
                    <field name="salary_structure_id" widget="radio"/>
                </group>
                <footer>
                    <button name="action_open_config" type="object"
                            string="Open Configurations" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payslip_config_wizard" model="ir.actions.act_window">
        <field name="name">Payslip Configuration</field>
        <field name="res_model">hr.payslip.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payslip_config_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
