<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shadow_import_wizard_form" model="ir.ui.view">
        <field name="name">hr.formula.shadow.import.wizard.form</field>
        <field name="model">hr.formula.shadow.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Historical Results">
                <group>
                    <field name="config_id" readonly="state != 'upload'"/>
                    <field name="import_file" filename="import_filename" readonly="state != 'upload'"/>
                    <field name="import_filename" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="run_id" invisible="1"/>
                </group>
                <div invisible="state != 'upload'" class="text-muted">
                    Upload a workbook of historical payroll results (employees × components).
                    Payobook maps result columns to your components, resolves employees, then
                    recomputes and compares — nothing is written to payslips.
                </div>
                <group invisible="state != 'map'">
                    <field name="sheet_name"/>
                    <field name="period_label"/>
                    <field name="employee_ref_header"
                           placeholder="e.g. MSNV / Employee Code"/>
                    <field name="mapping_json" widget="text"
                           help="{workbook header: component code} — edit before importing."/>
                </group>
                <group invisible="state != 'done'">
                    <field name="unmatched_report" readonly="1"/>
                </group>
                <footer>
                    <button name="action_analyze" type="object" string="Analyze"
                            class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_import" type="object" string="Import &amp; build run"
                            class="btn-primary" invisible="state != 'map'"/>
                    <button name="action_open_run" type="object" string="Open shadow run"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shadow_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Historical Results</field>
        <field name="res_model">hr.formula.shadow.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
