<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==========================================
         MULTI-SHEET IMPORT WIZARD VIEWS
         ========================================== -->


    <!-- Main Wizard Form View -->
    <record id="view_multisheet_import_wizard_form" model="ir.ui.view">
        <field name="name">hr.formula.multisheet.import.wizard.form</field>
        <field name="model">hr.formula.multisheet.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Multi-Sheet Excel Import">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="upload,select_sheets,select_columns,configure_order,review_components,confirm"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span attrs="{'invisible': [('state', '!=', 'upload')]}">
                                Upload Excel File
                            </span>
                            <span attrs="{'invisible': [('state', '!=', 'select_sheets')]}">
                                Select Worksheets
                            </span>
                            <span attrs="{'invisible': [('state', '!=', 'select_columns')]}">
                                Select Columns
                            </span>
                            <span attrs="{'invisible': [('state', '!=', 'configure_order')]}">
                                Configure Append Order
                            </span>
                            <span attrs="{'invisible': [('state', '!=', 'review_components')]}">
                                Review Components
                            </span>
                            <span attrs="{'invisible': [('state', '!=', 'map_missing')]}">
                                Map Missing Fields
                            </span>
                            <span attrs="{'invisible': [('state', '!=', 'confirm')]}">
                                Confirm Import
                            </span>
                        </h1>
                    </div>

                    <!-- Step 1: Upload File -->
                    <group attrs="{'invisible': [('state', '!=', 'upload')]}">
                        <group string="Target Configuration">
                            <field name="config_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Excel File">
                            <field name="import_file" filename="import_filename"/>
                            <field name="import_filename" invisible="1"/>
                        </group>
                        <group string="Instructions" class="oe_read_only">
                            <div class="alert alert-info" role="alert">
                                <p><strong>Multi-Sheet Import Wizard</strong></p>
                                <p>This wizard will analyze your Excel file and:</p>
                                <ul>
                                    <li>Detect all worksheets in the workbook</li>
                                    <li>Auto-detect header rows based on content patterns</li>
                                    <li>Extract component types from merged cells</li>
                                    <li>Resolve cross-worksheet formula references</li>
                                </ul>
                                <p>Supported formats: .xlsx, .xls</p>
                            </div>
                        </group>
                    </group>

                    <!-- Step 2: Select Worksheets -->
                    <group attrs="{'invisible': [('state', '!=', 'select_sheets')]}">
                        <group col="4">
                            <group string="Primary Key" colspan="4">
                                <field name="primary_key_column"
                                       placeholder="e.g., Employee ID"/>
                            </group>
                            <group string="Available Worksheets" colspan="4">
                                <field name="available_sheet_ids" nolabel="1" colspan="4">
                                    <tree editable="bottom">
                                        <field name="is_selected" widget="boolean_toggle" string="Include"/>
                                        <field name="is_main_sheet" widget="boolean_toggle" string="Main"/>
                                        <field name="sheet_name" readonly="1" string="Sheet Name"/>
                                        <field name="detected_header_row" string="Header Row"/>
                                        <field name="column_count" readonly="1" string="Cols"/>
                                        <field name="row_count" readonly="1" string="Rows"/>
                                        <field name="has_formulas" widget="boolean" readonly="1" string="Formulas"/>
                                        <field name="references_other_sheets" widget="boolean" readonly="1" string="Refs Others" optional="show"/>
                                        <field name="header_confidence" widget="progressbar" readonly="1" optional="hide"/>
                                    </tree>
                                </field>
                            </group>
                        </group>
                        <group string="Instructions" class="oe_read_only">
                            <div class="alert alert-info" role="alert">
                                <ul>
                                    <li><strong>Include:</strong> Select worksheets to process</li>
                                    <li><strong>Main Sheet:</strong> Designate ONE sheet as the primary payroll structure</li>
                                    <li><strong>Header Row:</strong> Adjust if auto-detection was incorrect</li>
                                    <li><strong>Primary Key:</strong> Column used to match data across worksheets</li>
                                    <li><strong>Refs Others:</strong> Indicates this sheet has formulas that reference other sheets (e.g., =TAM_UNG!A1)</li>
                                </ul>
                            </div>
                        </group>
                    </group>

                    <!-- Step 3: Select Columns -->
                    <group attrs="{'invisible': [('state', '!=', 'select_columns')]}">
                        <group col="4">
                            <group string="Instructions" class="oe_read_only" colspan="4">
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Select Columns to Import</strong></p>
                                    <ul>
                                        <li>Each tab shows columns from a selected worksheet</li>
                                        <li>All columns are selected by default</li>
                                        <li>Uncheck columns you don't want to import</li>
                                        <li><span class="badge bg-warning text-dark">⚠</span> Columns referenced by main sheet formulas are highlighted</li>
                                    </ul>
                                </div>
                            </group>
                            <group string="Columns by Worksheet" colspan="4">
                                <field name="column_selection_ids" nolabel="1" colspan="4" context="{'tree_view_ref': 'pb_hr_payroll_formula.view_multisheet_column_selection_inline_tree'}">
                                    <tree editable="bottom" decoration-warning="is_referenced_by_main and not is_selected"
                                          decoration-info="has_cross_sheet_ref"
                                          create="false" delete="false">
                                        <field name="sheet_name" readonly="1" string="Worksheet" width="150px"/>
                                        <field name="is_selected" widget="boolean_toggle" width="70px"/>
                                        <field name="column_letter" string="Col" readonly="1" width="50px"/>
                                        <field name="original_header" string="Header" readonly="1" width="200px"/>
                                        <field name="component_type" string="Category" readonly="1" optional="show" width="150px"/>
                                        <field name="column_type" string="Type" readonly="1" width="80px"/>
                                        <field name="sample_value" string="Sample" readonly="1" width="120px"/>
                                        <field name="has_cross_sheet_ref" widget="boolean" string="Has Ref" readonly="1" optional="show" width="70px"/>
                                        <field name="is_referenced_by_other_sheet" widget="boolean" string="Ref'd By" readonly="1" optional="show" width="70px"/>
                                        <field name="refers_to_sheet_names" string="Refers To" readonly="1" optional="show" width="150px"/>
                                        <field name="referenced_by_sheet_names" string="Ref By Sheets" readonly="1" optional="show" width="150px"/>
                                        <field name="is_referenced_by_main" widget="boolean" string="Required" readonly="1" optional="hide" width="70px"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Selection Summary" class="oe_read_only" colspan="4">
                                <div class="alert alert-secondary">
                                    <p><strong>Note:</strong> If you deselect a column that is referenced by a formula in the main worksheet,
                                    the cross-sheet formula cannot be resolved. You will be notified in the next step.</p>
                                </div>
                            </group>
                        </group>
                    </group>

                    <!-- Step 4: Configure Append Order -->
                    <group attrs="{'invisible': [('state', '!=', 'configure_order')]}">
                        <group col="4">
                            <group string="Worksheet Append Order" colspan="4">
                                <field name="append_order_ids" nolabel="1" colspan="4">
                                    <tree editable="bottom" decoration-success="is_main_sheet" create="false" delete="false">
                                        <field name="append_sequence" widget="handle"/>
                                        <field name="sheet_name" readonly="1"/>
                                        <field name="is_main_sheet" widget="boolean" readonly="1" string="Main"/>
                                        <field name="selected_column_count" string="Columns"/>
                                        <field name="start_column_letter" string="Start" readonly="1"/>
                                        <field name="end_column_letter" string="End" readonly="1"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Cross-Sheet Formula Statistics" colspan="4">
                                <field name="cross_sheet_formula_count" string="Cross-Sheet Formulas"/>
                                <field name="resolved_formula_count" string="Can Be Resolved"/>
                                <field name="unresolved_formula_count" string="Cannot Resolve"/>
                            </group>
                            <group string="Instructions" class="oe_read_only" colspan="4">
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Configure Append Order</strong></p>
                                    <ul>
                                        <li>The <strong>Main Worksheet</strong> columns come first (locked at top)</li>
                                        <li>Drag auxiliary worksheets to reorder them</li>
                                        <li><strong>Start/End columns</strong> show where each worksheet's columns will be placed</li>
                                        <li>Cross-sheet formula references will be resolved to new column positions</li>
                                    </ul>
                                </div>
                            </group>
                        </group>
                    </group>

                    <!-- Step 5: Review Components -->
                    <group attrs="{'invisible': [('state', '!=', 'review_components')]}">
                        <group col="4">
                            <group string="Import Statistics" colspan="4">
                                <field name="import_count" string="Components to Import"/>
                                <field name="formula_count" string="Formulas Detected"/>
                                <field name="duplicate_count" string="Duplicates Found"/>
                            </group>
                            <group string="Instructions" class="oe_read_only" colspan="4">
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Review Detected Components</strong></p>
                                    <ul>
                                        <li><strong>Component:</strong> Field name from your Excel header row</li>
                                        <li><strong>Component Type:</strong> Category from merged cells above header</li>
                                        <li><strong>Type:</strong> Input (manual data entry) or Formula (auto-calculated)</li>
                                    </ul>
                                    <p>Uncheck "Include" to skip importing a component. Edit Code/Name if needed.</p>
                                </div>
                            </group>
                            <group string="Detected Components" colspan="4">
                                <field name="component_preview_ids" nolabel="1" colspan="4">
                                    <tree editable="bottom" decoration-muted="not include_in_import"
                                          decoration-warning="is_duplicate"
                                          decoration-success="column_type == 'formula'">
                                        <field name="include_in_import" widget="boolean_toggle" width="70px"/>
                                        <field name="original_header" string="Component" width="180px"/>
                                        <field name="component_type" string="Category" width="150px"/>
                                        <field name="column_type" string="Type" width="80px"/>
                                        <field name="data_source" string="Source" width="100px"/>
                                        <field name="sample_value" string="Sample" width="120px"/>
                                        <field name="excel_formula" string="Formula"
                                               attrs="{'invisible': [('column_type', '!=', 'formula')]}" width="250px"/>
                                        <field name="source_sheet" string="Sheet" width="120px"/>
                                        <field name="column_letter" string="Col" width="50px"/>
                                        <field name="generated_code" string="Code" width="120px"/>
                                        <field name="generated_name" string="Name" width="180px"/>
                                        <field name="is_duplicate" widget="boolean" readonly="1" optional="hide" width="70px"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Import Options" colspan="4">
                                <field name="preserve_existing"/>
                                <field name="merge_duplicates"/>
                                <field name="update_existing"/>
                            </group>
                        </group>
                    </group>

                    <!-- Step 6: Map Missing Fields -->
                    <group attrs="{'invisible': [('state', '!=', 'map_missing')]}">
                        <group col="4">
                            <group string="Missing Fields" class="oe_read_only" colspan="4">
                                <div class="alert alert-warning" role="alert">
                                    <p><strong>Some fields in your configuration are not present in the Excel file.</strong></p>
                                    <p>For each missing field, specify how it should be populated:</p>
                                    <ul>
                                        <li><strong>Not Populated:</strong> Leave empty during import</li>
                                        <li><strong>From Integration:</strong> Fetch from external system (Zoho, SAP, etc.)</li>
                                        <li><strong>Manual Entry:</strong> User will enter manually on each payslip</li>
                                    </ul>
                                </div>
                            </group>
                            <group string="Configure Missing Fields" colspan="4">
                                <field name="missing_field_ids" nolabel="1" colspan="4">
                                    <tree editable="bottom">
                                        <field name="field_code" readonly="1"/>
                                        <field name="field_name" readonly="1"/>
                                        <field name="data_source"/>
                                        <field name="integration_connector_id"
                                               attrs="{'invisible': [('data_source', '!=', 'integration')],
                                                       'required': [('data_source', '=', 'integration')]}"
                                               options="{'no_create': True}"/>
                                        <field name="integration_field_name"
                                               attrs="{'invisible': [('data_source', '!=', 'integration')]}"/>
                                    </tree>
                                </field>
                            </group>
                        </group>
                    </group>

                    <!-- Step 7: Confirm -->
                    <group attrs="{'invisible': [('state', '!=', 'confirm')]}" colspan="4">
                        <group col="4">
                            <group string="Import Summary" colspan="4">
                                <field name="import_count" string="Components to Import"/>
                                <field name="formula_count" string="Formulas"/>
                                <field name="duplicate_count" string="Duplicates"/>
                            </group>
                            <group string="Target Configuration" colspan="4">
                                <field name="config_id" readonly="1"/>
                                <field name="main_sheet_name" readonly="1"/>
                            </group>
                            <group string="Components Preview (First 10)" colspan="4">
                                <field name="component_preview_ids" nolabel="1" readonly="1" colspan="4">
                                    <tree limit="10" decoration-success="column_type == 'formula'">
                                        <field name="original_header" string="Component"/>
                                        <field name="component_type" string="Category"/>
                                        <field name="column_type" string="Type"/>
                                        <field name="data_source" string="Source"/>
                                        <field name="generated_code" string="Code"/>
                                    </tree>
                                </field>
                            </group>
                            <group string="Final Review" colspan="4">
                                <group col="2" colspan="4">
                                    <group>
                                        <div class="alert alert-success" role="alert">
                                            <p><strong>Ready to Import!</strong></p>
                                            <p>Review the summary above, then click "Execute Import" to create formula rules.</p>
                                        </div>
                                    </group>
                                    <group>
                                        <div class="alert alert-success" role="alert">
                                            <ul class="mb-0">
                                                <li><strong>Input components</strong> will use data from Excel/Integration</li>
                                                <li><strong>Formula components</strong> will be auto-calculated</li>
                                                <li><strong>Category</strong> groups components under merged cell headers</li>
                                            </ul>
                                        </div>
                                    </group>
                                </group>
                            </group>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <!-- Step 1: Upload - Buttons -->
                    <button name="action_analyze_file" type="object"
                            string="Analyze File" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'upload')]}"/>

                    <!-- Back Button (shown for all steps except upload) -->
                    <button name="action_back" type="object"
                            string="Back" class="btn-secondary"
                            attrs="{'invisible': [('state', '=', 'upload')]}"/>

                    <!-- Step 2: Select Sheets - Buttons -->
                    <button name="action_process_sheets" type="object"
                            string="Select Columns" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'select_sheets')]}"/>

                    <!-- Step 3: Select Columns - Buttons -->
                    <button name="action_configure_order" type="object"
                            string="Configure Order" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'select_columns')]}"/>

                    <!-- Step 4: Configure Order - Buttons -->
                    <button name="action_process_with_resolution" type="object"
                            string="Process &amp; Resolve" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'configure_order')]}"/>

                    <!-- Step 5: Review Components - Buttons -->
                    <button name="action_detect_missing_fields" type="object"
                            string="Continue" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'review_components')]}"/>

                    <!-- Step 6: Map Missing - Buttons -->
                    <button name="action_skip_missing" type="object"
                            string="Skip" class="btn-secondary"
                            attrs="{'invisible': [('state', '!=', 'map_missing')]}"/>
                    <button name="action_apply_missing_mapping" type="object"
                            string="Apply and Continue" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'map_missing')]}"/>

                    <!-- Step 7: Confirm - Buttons -->
                    <button name="action_execute_import" type="object"
                            string="Execute Import" class="btn-success"
                            attrs="{'invisible': [('state', '!=', 'confirm')]}"/>

                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_multisheet_import_wizard" model="ir.actions.act_window">
        <field name="name">Multi-Sheet Excel Import</field>
        <field name="res_model">hr.formula.multisheet.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

    <!-- ==========================================
         SHEET LINE VIEWS (Embedded)
         ========================================== -->

    <record id="view_multisheet_sheet_line_tree" model="ir.ui.view">
        <field name="name">hr.formula.multisheet.sheet.line.tree</field>
        <field name="model">hr.formula.multisheet.sheet.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="is_selected" widget="boolean_toggle"/>
                <field name="is_main_sheet" widget="boolean_toggle"/>
                <field name="sheet_name" readonly="1"/>
                <field name="detected_header_row"/>
                <field name="column_count" readonly="1"/>
                <field name="row_count" readonly="1"/>
                <field name="has_formulas" widget="boolean" readonly="1"/>
                <field name="references_other_sheets" widget="boolean" readonly="1"/>
            </tree>
        </field>
    </record>

    <!-- ==========================================
         COMPONENT PREVIEW VIEWS (Embedded)
         ========================================== -->

    <record id="view_multisheet_component_preview_tree" model="ir.ui.view">
        <field name="name">hr.formula.multisheet.component.preview.tree</field>
        <field name="model">hr.formula.multisheet.component.preview</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-muted="not include_in_import"
                  decoration-warning="is_duplicate">
                <field name="include_in_import" widget="boolean_toggle"/>
                <field name="source_sheet"/>
                <field name="column_letter"/>
                <field name="original_header"/>
                <field name="generated_code"/>
                <field name="generated_name"/>
                <field name="component_type"/>
                <field name="column_type"/>
                <field name="excel_formula"/>
                <field name="is_duplicate" widget="boolean" readonly="1"/>
                <field name="data_source"/>
            </tree>
        </field>
    </record>

    <!-- ==========================================
         MISSING FIELD VIEWS (Embedded)
         ========================================== -->

    <record id="view_multisheet_missing_field_tree" model="ir.ui.view">
        <field name="name">hr.formula.multisheet.missing.field.tree</field>
        <field name="model">hr.formula.multisheet.missing.field</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="field_code" readonly="1"/>
                <field name="field_name" readonly="1"/>
                <field name="data_source"/>
                <field name="integration_connector_id"
                       attrs="{'invisible': [('data_source', '!=', 'integration')]}"/>
                <field name="integration_field_name"
                       attrs="{'invisible': [('data_source', '!=', 'integration')]}"/>
            </tree>
        </field>
    </record>

    <!-- ==========================================
         COLUMN SELECTION VIEWS (Embedded)
         ========================================== -->

    <record id="view_multisheet_column_selection_tree" model="ir.ui.view">
        <field name="name">hr.formula.multisheet.column.selection.tree</field>
        <field name="model">hr.formula.multisheet.column.selection</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-warning="is_referenced_by_main and not is_selected"
                  decoration-info="has_cross_sheet_ref" create="false" delete="false">
                <field name="sheet_line_id" readonly="1" string="Sheet"/>
                <field name="is_selected" widget="boolean_toggle"/>
                <field name="column_letter" string="Column" readonly="1"/>
                <field name="original_header" string="Header" readonly="1"/>
                <field name="component_type" string="Category" readonly="1" optional="show"/>
                <field name="column_type" string="Type" readonly="1"/>
                <field name="sample_value" string="Sample" readonly="1" optional="show"/>
                <field name="has_cross_sheet_ref" widget="boolean" string="Cross-Ref" readonly="1" optional="show"/>
                <field name="is_referenced_by_other_sheet" widget="boolean" string="Ref By Other" readonly="1" optional="show"/>
                <field name="refers_to_sheet_names" string="Refers To" readonly="1" optional="show"/>
                <field name="referenced_by_sheet_names" string="Ref By Sheets" readonly="1" optional="show"/>
                <field name="cross_sheet_formula" string="Formula" readonly="1" optional="hide"/>
                <field name="is_referenced_by_main" widget="boolean" string="Required" readonly="1" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ==========================================
         APPEND ORDER VIEWS (Embedded)
         ========================================== -->

    <record id="view_multisheet_append_order_tree" model="ir.ui.view">
        <field name="name">hr.formula.multisheet.append.order.tree</field>
        <field name="model">hr.formula.multisheet.append.order</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-success="is_main_sheet" create="false" delete="false">
                <field name="append_sequence" widget="handle"/>
                <field name="sheet_name" readonly="1"/>
                <field name="is_main_sheet" widget="boolean" readonly="1" string="Main"/>
                <field name="selected_column_count" string="Selected Cols" readonly="1"/>
                <field name="total_column_count" string="Total Cols" readonly="1"/>
                <field name="start_column_letter" string="Start Col" readonly="1"/>
                <field name="end_column_letter" string="End Col" readonly="1"/>
            </tree>
        </field>
    </record>

</odoo>
