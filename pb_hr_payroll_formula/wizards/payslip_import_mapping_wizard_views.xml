<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payslip_import_mapping_wizard_form" model="ir.ui.view">
        <field name="name">hr.payslip.import.mapping.wizard.form</field>
        <field name="model">hr.payslip.import.mapping.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Salary Structure">
                <group>
                    <field name="salary_structure_id" widget="radio" context="{'no_code_display': True}"/>
                </group>
                <footer>
                    <button name="action_open_mappings" type="object" string="Open Mappings"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_payslip_import_mapping_wizard" model="ir.actions.act_window">
        <field name="name">Employee/Contract Field Mapping</field>
        <field name="res_model">hr.payslip.import.mapping.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payslip_import_mapping_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
