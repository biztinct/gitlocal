<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ==========================================
             SECURITY CATEGORIES
             ========================================== -->

        <record id="module_category_formula_payroll" model="ir.module.category">
            <field name="name">Formula Payroll</field>
            <field name="description">Formula-based payroll calculation module</field>
            <field name="sequence">25</field>
        </record>

        <!-- ==========================================
             SECURITY GROUPS
             ========================================== -->

        <!-- Formula User - Can view and use formula configurations -->
        <record id="group_formula_user" model="res.groups">
            <field name="name">Formula User</field>
            <field name="category_id" ref="module_category_formula_payroll"/>
            <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
            <field name="comment">
                Can view formula configurations and use them for payroll calculation.
                Cannot create or modify configurations.
            </field>
        </record>

        <!-- Formula Manager - Can create and manage formula configurations -->
        <record id="group_formula_manager" model="res.groups">
            <field name="name">Formula Manager</field>
            <field name="category_id" ref="module_category_formula_payroll"/>
            <field name="implied_ids" eval="[(4, ref('group_formula_user'))]"/>
            <field name="comment">
                Can create, edit, and manage formula configurations.
                Can manage sample data and run tests.
            </field>
        </record>

        <!-- Formula Admin - Full access including integrations -->
        <record id="group_formula_admin" model="res.groups">
            <field name="name">Formula Administrator</field>
            <field name="category_id" ref="module_category_formula_payroll"/>
            <field name="implied_ids" eval="[(4, ref('group_formula_manager'))]"/>
            <field name="comment">
                Full access to all formula and integration features.
                Can manage external system connectors and credentials.
            </field>
        </record>

        <!-- ==========================================
             RECORD RULES
             ========================================== -->

        <!-- Formula Config - Company Rule -->
        <record id="formula_config_comp_rule" model="ir.rule">
            <field name="name">Formula Config: Company Access</field>
            <field name="model_id" ref="model_hr_formula_config"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Integration Connector - Admin Only for Credentials -->
        <record id="integration_connector_admin_rule" model="ir.rule">
            <field name="name">Integration Connector: Admin Access</field>
            <field name="model_id" ref="model_hr_integration_connector"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_formula_admin'))]"/>
        </record>

        <!-- Formula Rule - Same as Config -->
        <record id="formula_rule_comp_rule" model="ir.rule">
            <field name="name">Formula Rule: Company Access</field>
            <field name="model_id" ref="model_hr_formula_rule"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
