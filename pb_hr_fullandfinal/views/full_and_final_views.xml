<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_full_and_final_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Full and Final</field>
        <field name="res_model">hr.full.final.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_full_and_final_tree" model="ir.ui.view">
        <field name="name">hr.full.final.settlement.tree</field>
        <field name="model">hr.full.final.settlement</field>
        <field name="arch" type="xml">
            <list string="Full and Final" create="0" edit="0">
                <header>
                    <button name="%(action_full_and_final_generate_wizard)d"
                            type="action"
                            string="Generate Full and Final"
                            class="oe_highlight"
                            icon="fa-plus"/>
                </header>
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="department_id"/>
                <field name="settlement_date"/>
                <field name="formula_config_id"/>
                <field name="net_payable"/>
                <field name="source"/>
                <button name="action_download_full_and_final"
                        type="object"
                        string="Download Full and Final"
                        class="oe_highlight"
                        icon="fa-download"/>
            </list>
        </field>
    </record>

    <record id="view_full_and_final_form" model="ir.ui.view">
        <field name="name">hr.full.final.settlement.form</field>
        <field name="model">hr.full.final.settlement</field>
        <field name="arch" type="xml">
            <form string="Full and Final">
                <header>
                    <button name="action_download_full_and_final"
                            type="object"
                            string="Download Full and Final"
                            class="oe_highlight"
                            icon="fa-download"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="employee_code"/>
                        <field name="department_id"/>
                        <field name="job_id"/>
                        <field name="contract_id"/>
                    </group>
                    <group>
                        <field name="settlement_date"/>
                        <field name="settlement_month"/>
                        <field name="formula_config_id"/>
                        <field name="import_batch_id"/>
                        <field name="source"/>
                    </group>
                    <group>
                        <field name="total_earnings"/>
                        <field name="total_deductions"/>
                        <field name="net_payable"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_full_and_final_search" model="ir.ui.view">
        <field name="name">hr.full.final.settlement.search</field>
        <field name="model">hr.full.final.settlement</field>
        <field name="arch" type="xml">
            <search string="Full and Final">
                <field name="employee_id" string="Employee"
                       filter_domain="['|', ('employee_id', 'ilike', self), ('employee_code', 'ilike', self)]"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="formula_config_id" string="Salary Structure"/>
                <field name="settlement_month"/>
                <separator/>
                <!-- Rich date picker (This/Last Month, Quarter, Year …) -->
                <filter name="filter_settlement_date" string="Settlement Date" date="settlement_date"/>
                <filter name="this_month"
                        string="This Month"
                        domain="[('settlement_date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('settlement_date', '&lt;', (context_today() + relativedelta(day=1, months=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_month"
                        string="Last Month"
                        domain="[('settlement_date', '&gt;=', (context_today() + relativedelta(day=1, months=-1)).strftime('%Y-%m-%d')), ('settlement_date', '&lt;', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_year"
                        string="This Year"
                        domain="[('settlement_date', '&gt;=', (context_today() + relativedelta(day=1, month=1)).strftime('%Y-%m-%d')), ('settlement_date', '&lt;', (context_today() + relativedelta(day=1, month=1, years=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="source_manual" string="Manual" domain="[('source', '=', 'manual')]"/>
                <filter name="source_auto" string="Auto" domain="[('source', '=', 'auto')]"/>
                <separator/>
                <filter name="high_value" string="Net ≥ ₫30M" domain="[('net_payable', '&gt;=', 30000000)]"/>
                <group name="group_by">
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_structure" string="Salary Structure" context="{'group_by': 'formula_config_id'}"/>
                    <filter name="group_job" string="Job Position" context="{'group_by': 'job_id'}"/>
                    <filter name="group_month" string="Settlement Month" context="{'group_by': 'settlement_month'}"/>
                    <filter name="group_date" string="Settlement Date" context="{'group_by': 'settlement_date:month'}"/>
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_full_and_final_employees" model="ir.actions.act_window">
        <field name="name">Full and Final</field>
        <field name="res_model">hr.full.final.settlement</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_full_and_final_tree"/>
        <field name="search_view_id" ref="view_full_and_final_search"/>
        <field name="domain">[]</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
