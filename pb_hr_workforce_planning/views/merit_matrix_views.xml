<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Merit Matrix Tree -->
    <record id="view_wfp_merit_tree" model="ir.ui.view">
        <field name="name">wfp.merit.matrix.tree</field>
        <field name="model">wfp.merit.matrix</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Merit Matrix Form -->
    <record id="view_wfp_merit_form" model="ir.ui.view">
        <field name="name">wfp.merit.matrix.form</field>
        <field name="model">wfp.merit.matrix</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <field name="note"/>
                    <field name="cell_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="performance_label"/>
                            <field name="compa_min"/>
                            <field name="compa_max"/>
                            <field name="increase_pct"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wfp_merit_matrix" model="ir.actions.act_window">
        <field name="name">Merit Matrices</field>
        <field name="res_model">wfp.merit.matrix</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
