<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Monthly Projection Tree -->
    <record id="view_wfp_projection_tree" model="ir.ui.view">
        <field name="name">wfp.monthly.projection.tree</field>
        <field name="model">wfp.monthly.projection</field>
        <field name="arch" type="xml">
            <list decoration-info="is_pre_effective">
                <field name="period_label"/>
                <field name="headcount"/>
                <field name="total_base" widget="monetary"/>
                <field name="total_gross" widget="monetary"/>
                <field name="total_employer_cost" widget="monetary"/>
                <field name="total_cost_to_company" widget="monetary" string="TCOW"/>
                <field name="delta_vs_current" widget="monetary"/>
                <field name="is_pre_effective"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Monthly Projection Graph -->
    <record id="view_wfp_projection_graph" model="ir.ui.view">
        <field name="name">wfp.monthly.projection.graph</field>
        <field name="model">wfp.monthly.projection</field>
        <field name="arch" type="xml">
            <graph string="Monthly Cost Projection" type="line">
                <field name="period_label"/>
                <field name="total_cost_to_company" type="measure"/>
                <field name="total_employer_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wfp_projection" model="ir.actions.act_window">
        <field name="name">Monthly Projections</field>
        <field name="res_model">wfp.monthly.projection</field>
        <field name="view_mode">list,graph</field>
    </record>
</odoo>
