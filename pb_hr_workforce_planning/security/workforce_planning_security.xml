<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_workforce_planning" model="ir.module.category">
        <field name="name">Workforce Planning</field>
        <field name="sequence">50</field>
    </record>

    <!-- Privilege (Odoo 19 pattern: replaces category_id on groups) -->
    <record id="res_groups_privilege_workforce_planning" model="res.groups.privilege">
        <field name="name">Workforce Planning</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_workforce_planning"/>
    </record>

    <!-- Security Groups using privilege_id (Odoo 19) -->
    <record id="group_wfp_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_workforce_planning"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">View workforce planning scenarios and forecasts.</field>
    </record>

    <record id="group_wfp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_workforce_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_wfp_user'))]"/>
        <field name="comment">Create, calculate, and approve scenarios. Tag components.</field>
    </record>

    <record id="group_wfp_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_workforce_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_wfp_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full configuration access including grades, matrices, and cycles.</field>
    </record>

<data noupdate="1">
    <!-- Multi-company rules -->
    <record id="wfp_scenario_company_rule" model="ir.rule">
        <field name="name">Scenario: Multi-Company</field>
        <field name="model_id" ref="model_wfp_planning_scenario"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="wfp_forecast_company_rule" model="ir.rule">
        <field name="name">Forecast: Multi-Company</field>
        <field name="model_id" ref="model_wfp_employee_forecast"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="wfp_grade_company_rule" model="ir.rule">
        <field name="name">Pay Grade: Multi-Company</field>
        <field name="model_id" ref="model_wfp_pay_grade"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</data>
</odoo>
