<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#21435F"/>
      <stop offset="100%" style="stop-color:#2d6a9f"/>
    </linearGradient>
  </defs>
  <rect width="100" height="100" rx="20" fill="url(#bg)"/>
  <!-- Chart bars -->
  <rect x="18" y="55" width="12" height="25" rx="3" fill="rgba(255,255,255,0.4)"/>
  <rect x="34" y="40" width="12" height="40" rx="3" fill="rgba(255,255,255,0.55)"/>
  <rect x="50" y="30" width="12" height="50" rx="3" fill="rgba(255,255,255,0.7)"/>
  <rect x="66" y="25" width="12" height="55" rx="3" fill="rgba(255,255,255,0.85)"/>
  <!-- Trend line -->
  <polyline points="24,50 40,38 56,28 72,22" fill="none" stroke="#27ae60" stroke-width="2.5" stroke-linecap="round"/>
  <!-- Arrow up -->
  <polygon points="72,22 68,28 76,28" fill="#27ae60"/>
  <!-- People icon -->
  <circle cx="30" cy="18" r="5" fill="rgba(255,255,255,0.8)"/>
  <path d="M22,25 Q30,30 38,25" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="2"/>
</svg>
