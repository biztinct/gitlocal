<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Overtime Config List View -->
    <record id="view_overtime_config_list" model="ir.ui.view">
        <field name="name">hr.overtime.config.list</field>
        <field name="model">hr.overtime.config</field>
        <field name="arch" type="xml">
            <list string="Overtime Rules" editable="bottom"
                  decoration-info="overtime_type == 'night'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="country_id"/>
                <field name="overtime_type"/>
                <field name="rate_multiplier"/>
                <field name="rate_display" string="Rate"/>
                <field name="max_hours_per_day"/>
                <field name="max_hours_per_month"/>
                <field name="requires_approval"/>
            </list>
        </field>
    </record>

    <!-- Overtime Config Form View -->
    <record id="view_overtime_config_form" model="ir.ui.view">
        <field name="name">hr.overtime.config.form</field>
        <field name="model">hr.overtime.config</field>
        <field name="arch" type="xml">
            <form string="Overtime Rule">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Vietnam — Weekday OT"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="country_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="overtime_type"/>
                            <field name="requires_approval"/>
                        </group>
                        <group string="Rates &amp; Limits">
                            <field name="rate_multiplier"/>
                            <field name="rate_display" string="Effective Rate"/>
                            <field name="max_hours_per_day"/>
                            <field name="max_hours_per_month"/>
                        </group>
                    </group>
                    <group string="Night Shift Boundaries"
                           invisible="overtime_type != 'night'">
                        <field name="time_from" widget="float_time"/>
                        <field name="time_to" widget="float_time"/>
                    </group>
                    <field name="note" placeholder="Legal reference or description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_overtime_config" model="ir.actions.act_window">
        <field name="name">Overtime Rules</field>
        <field name="res_model">hr.overtime.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
