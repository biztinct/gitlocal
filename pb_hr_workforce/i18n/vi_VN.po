#. module: pb_hr_workforce
#. odoo-javascript
#: code:addons/pb_hr_workforce/static/src/js/attendance_weekgrid.js:0
msgid ""
"%(h)s h past the monthly ceiling of %(cap)s h. The excess is recorded as bonus hours, "
"not overtime pay — you can still enter it."
msgstr ""
"%(h)s h đã vượt mức trần hàng tháng của %(cap)s h. Phần vượt quá được ghi là số giờ "
"thưởng chứ không phải tiền làm thêm giờ - bạn vẫn có thể nhập số tiền đó."

#. module: pb_hr_workforce
#. odoo-javascript
#: code:addons/pb_hr_workforce/static/src/js/attendance_weekgrid.js:0
