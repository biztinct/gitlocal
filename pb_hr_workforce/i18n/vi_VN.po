#. module: pb_hr_workforce
#: model_terms:ir.ui.view,arch_db:pb_hr_workforce.view_overtime_config_form
msgid ""
"<b>Extended OT:</b> When OT hours exceed the <b>max OT hours/day</b>, the remaining "
"hours escalate to this rule."
msgstr ""
"<b>Extends OT:</b> Khi số giờ OT vượt quá <b>max số giờ OT/ngày</b>, số giờ còn lại sẽ"
" tăng dần theo quy tắc này."

#. module: pb_hr_workforce
#: model_terms:ir.ui.view,arch_db:pb_hr_workforce.view_overtime_config_form
msgid "<b>Holiday OT:</b> ALL hours on public holidays are overtime at this rate."
msgstr ""
"<b>Hngày lễ OT:</b> TẤT CẢ các giờ vào ngày nghỉ lễ đều là giờ làm thêm ở mức này."

#. module: pb_hr_workforce
#: model_terms:ir.ui.view,arch_db:pb_hr_workforce.view_overtime_config_form
msgid ""
"<b>Night Premium:</b> Hours falling within the <b>time window</b> (e.g. 10 PM – 6 AM) "
"earn the night premium."
msgstr ""
"<b>Night Premium:</b> Số giờ nằm trong khung thời gian <b></b> (ví dụ: 10 giờ tối - 6 "
"giờ sáng) sẽ nhận được phí thưởng đêm."

#. module: pb_hr_workforce
#: model_terms:ir.ui.view,arch_db:pb_hr_workforce.view_overtime_config_form
msgid ""
"<b>Weekday OT:</b> Hours worked beyond the <b>threshold</b> on applicable weekdays "
"become overtime."
msgstr ""
"<b>Ngày trong tuần OT:</b> Số giờ làm việc vượt quá <b>threshold</b> vào các ngày "
"trong tuần áp dụng sẽ trở thành giờ làm thêm."

#. module: pb_hr_workforce
#: model_terms:ir.ui.view,arch_db:pb_hr_workforce.view_overtime_config_form
msgid "<b>Weekend OT:</b> ALL hours on Saturday/Sunday are overtime at this rate."
msgstr ""
"<b>OT cuối tuần:</b> TẤT CẢ các giờ vào Thứ Bảy/Chủ Nhật đều là giờ làm thêm ở mức "
"này."

#. module: pb_hr_workforce
#: model_terms:ir.ui.view,arch_db:pb_hr_workforce.view_overtime_config_form
msgid ""
"<strong>🔍 Classification Logic:</strong>\n"
"                        The Timecard system automatically classifies each attendance record\n"
"                        into regular or overtime hours using this rule's configuration:"
msgstr ""
"<strong>🔍 Logic phân loại:</strong>\n"
"                        Hệ thống Timecard tự động phân loại từng hồ sơ điểm danh\n"
"                        thành giờ thông thường hoặc làm thêm giờ bằng cách sử dụng cấu hình của quy tắc này:"

