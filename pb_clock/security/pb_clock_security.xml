<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company-scoped: a punch or a machine is only ever visible inside the
         companies the user is working in. The engine and the intake paths run
         sudo and scope themselves. -->
    <record id="rule_pb_clock_punch_company" model="ir.rule">
        <field name="name">Time clock punches: own companies</field>
        <field name="model_id" ref="model_pb_clock_punch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pb_clock_device_company" model="ir.rule">
        <field name="name">Attendance machines: own companies</field>
        <field name="model_id" ref="model_pb_clock_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pb_clock_command_company" model="ir.rule">
        <field name="name">Machine commands: own companies</field>
        <field name="model_id" ref="model_pb_clock_command"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pb_clock_alert_company" model="ir.rule">
        <field name="name">Time clock alerts: own companies</field>
        <field name="model_id" ref="model_pb_clock_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
<record id="rule_clock_connector_company" model="ir.rule"><field name="name">Connector: own companies</field><field name="model_id" ref="model_pb_clock_connector"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record><record id="rule_clock_connector_event_company" model="ir.rule"><field name="name">Connector: own companies</field><field name="model_id" ref="model_pb_clock_connector_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>
