<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- THE PAIRING JOB (CLOCK ledger rule 12). Every intake path only adds
         ledger rows and then `_trigger()`s this job, so a punch file is paired
         within seconds; the 5-minute interval is the safety net and the pace
         for machines that push.

         model_id names hr.attendance, NOT a pb_clock model (Decision Room
         GR25): a worker that is still running yesterday's code builds the
         server action's eval context with env[model] BEFORE our line runs, and
         a model only this module defines would throw KeyError there. The code
         line asks `in env` instead, which cannot throw.

         Not noupdate: plumbing, not a setting anyone tunes. The template
         database keeps it OFF (pb_tenants.template_active_crons lists it so a
         new tenant gets it ON). -->
    <record id="cron_pair_punches" model="ir.cron">
        <field name="name">Time clocks: pair punches</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">env['pb.clock.pairing']._cron_run() if 'pb.clock.pairing' in env else None</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- CLOCK-3 THE WATCHER: every 15 minutes, one company at a time, raises,
         refreshes and resolves pb.clock.alert rows and sends the two emails
         (the 08:00 summary, the immediate "a machine stopped" note). Same
         `in env` guard as the pairing job (GR25). Template database: OFF,
         its id appended to pb_tenants.template_active_crons (ledger G3). -->
    <record id="cron_watch_clocks" model="ir.cron">
        <field name="name">Time clocks: watch machines and days</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">env['pb.clock.alert']._cron_watch() if 'pb.clock.alert' in env else None</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- CLOCK-3 §5 THE NIGHTLY RE-CHECK: one job for every company; it does
         the work for a company only inside that company's night (02:30–06:00
         local) and once a day, so every 15 minutes costs a clock read. -->
    <record id="cron_recheck_clocks" model="ir.cron">
        <field name="name">Time clocks: nightly re-check</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">env['pb.clock.recheck']._cron_recheck() if 'pb.clock.recheck' in env else None</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
