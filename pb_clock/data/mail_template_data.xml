<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">
    <!-- CLOCK-3 §4.5 — ONE template for both time-clock emails (the 08:00
         summary and the immediate "a machine stopped" note).

         Every word comes from the sender in the RECIPIENT's language
         (`pb.clock.alert._send`, rendered under `lang=<manager's language>`
         with `_()`), so the Vietnamese is the same catalogue the screens use
         and nothing here needs its own translation. The recipient is passed
         explicitly in `email_values` (pb_comp_ben R6). Outgoing debranding is
         biz_mail_debrand's; never write a brand name here.

         Not noupdate: the layout is plumbing; there is nothing to tune. -->
    <record id="mail_template_clock_alerts" model="mail.template">
        <field name="name">Time clocks: alerts for attendance managers</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="email_from">{{ (object.email_formatted or user.email_formatted) }}</field>
        <field name="subject">{{ ctx.get('pb_subject') or '' }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin:0; padding:0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1B1733;">
                <p style="margin: 0 0 12px 0;"><t t-out="ctx.get('pb_hello') or ''"/></p>
                <p style="margin: 0 0 12px 0;"><t t-out="ctx.get('pb_intro') or ''"/></p>
                <ul style="margin: 0 0 16px 0; padding-left: 18px;">
                    <t t-foreach="ctx.get('pb_lines') or []" t-as="line">
                        <li style="margin: 0 0 6px 0;"><t t-out="line"/></li>
                    </t>
                </ul>
                <p style="margin: 0 0 16px 0;">
                    <a t-att-href="ctx.get('pb_url') or '#'"
                       style="background-color: #5A4BB0; color: #ffffff; padding: 9px 16px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-block;">
                        <t t-out="ctx.get('pb_button') or ''"/>
                    </a>
                </p>
                <p style="margin: 0; color: #64748B; font-size: 12px;"><t t-out="ctx.get('pb_footer') or ''"/></p>
            </div>
        </field>
    </record>
</data>
</odoo>
