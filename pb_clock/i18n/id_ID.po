#. module: pb_clock
#: model_terms:ir.ui.view,arch_db:pb_clock.view_clock_connector_form
#: model:ir.model.fields.selection,name:pb_clock.selection__pb_clock_connector__state__disabled
msgid "Disabled"
msgstr "Dinonaktifkan"

#. module: pb_clock
#: model_terms:ir.ui.view,arch_db:pb_clock.view_clock_connector_form
msgid "Disable"
msgstr "Nonaktifkan"

#. module: pb_clock
#: model_terms:ir.ui.view,arch_db:pb_clock.view_clock_connector_form
msgid "Enable"
msgstr "Aktifkan"

#. module: pb_clock
#: model_terms:ir.ui.view,arch_db:pb_clock.view_clock_connector_form
msgid "This PC will stop sending clock-ins until you enable it again. Nothing already received is removed, and it does not need to be paired again."
msgstr "PC ini akan berhenti mengirim absen sampai Anda mengaktifkannya lagi. Tidak ada yang sudah diterima yang dihapus, dan PC tidak perlu dipasangkan ulang."

#. module: pb_clock
#: model_terms:ir.ui.view,arch_db:pb_clock.view_clock_connector_form
msgid "This PC is not sending clock-ins. It stays paired, nothing already received is removed, and everything punched meanwhile is sent once you enable it."
msgstr "PC ini tidak mengirim absen. PC tetap terpasang, yang sudah diterima tidak dihapus, dan semua absen selama itu dikirim setelah Anda mengaktifkannya."

#. module: pb_clock
#. odoo-python
#: code:addons/pb_clock/models/clock_connector.py:0
msgid "Disabled. This PC stops sending clock-ins until it is enabled again. Nothing already received is removed and the PC stays paired."
msgstr "Dinonaktifkan. PC ini berhenti mengirim absen sampai diaktifkan lagi. Yang sudah diterima tidak dihapus dan PC tetap terpasang."

#. module: pb_clock
#. odoo-python
#: code:addons/pb_clock/models/clock_connector.py:0
msgid "Enabled. On its next sync the PC sends everything punched while it was disabled."
msgstr "Diaktifkan. Pada sinkronisasi berikutnya PC mengirim semua absen selama dinonaktifkan."

#. module: pb_clock
#. odoo-python
#: code:addons/pb_clock/models/clock_connector.py:0
msgid "Only a connected PC can be disabled. This one is not paired."
msgstr "Hanya PC yang terhubung yang dapat dinonaktifkan. PC ini belum dipasangkan."

#. module: pb_clock
#. odoo-python
#: code:addons/pb_clock/models/clock_connector.py:0
msgid "Only a disabled PC can be enabled."
msgstr "Hanya PC yang dinonaktifkan yang dapat diaktifkan."

#. module: pb_clock
#. odoo-javascript
#: code:addons/pb_clock/static/src/xml/clock_lens.xml:0
msgid "Same number for two people"
msgstr "Nomor sama untuk dua orang"
