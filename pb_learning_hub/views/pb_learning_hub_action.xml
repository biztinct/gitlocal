<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Learning hub (LEARNING L0). Declared as a RECORD rather than
         reached by bare tag, so anything returning through a breadcrumb sees
         a named action instead of "Unnamed" (W98).

         Test URL: /bizapp/action-pb_learning_hub -->
    <record id="action_pb_learning_hub" model="ir.actions.client">
        <field name="name">Learning</field>
        <field name="tag">pb_learning_hub</field>
    </record>
</odoo>
