<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- ==================================================================
         The build-up job. Daily, because it is cheap and never adds a month
         twice: a month is posted the first run after it has ended. Quiet (no
         email, no to-do) and safe on an empty database: no kind that builds
         up, no work. Odoo 19 has no `numbercall` / `doall` on ir.cron.
         ================================================================== -->
    <record id="cron_leave_earning" model="ir.cron">
      <field name="name">Leave: add the days people have earned</field>
      <field name="model_id" ref="model_pb_leave_earning"/>
      <field name="state">code</field>
      <field name="code">model._cron_post()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="nextcall">2026-11-16 18:30:00</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
