<odoo>
    <record id="action_outgoing_email" model="ir.actions.act_window">
        <field name="name">Outgoing email servers</field>
        <field name="res_model">ir.mail_server</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False, 'default_active': False}</field>
        <field name="view_id" ref="base.ir_mail_server_list"/>
        <field name="search_view_id" ref="base.view_ir_mail_server_search"/>
    </record>
    <record id="view_mail_server_activation" model="ir.ui.view">
        <field name="name">ir.mail_server.explicit.activation</field>
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="base.ir_mail_server_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="active" string="Active — allow outgoing email"/>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="alert alert-info" invisible="active">Inactive: this server will not be selected automatically to send email. Activate it only when you are ready.</div>
            </xpath>
        </field>
    </record>
    <record id="view_mail_server_active_list" model="ir.ui.view">
        <field name="name">ir.mail_server.active.list</field>
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="base.ir_mail_server_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after"><field name="active" string="Active"/></xpath>
        </field>
    </record>
</odoo>
