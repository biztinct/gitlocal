<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ===================================================== the Settings hub
       Section comments use `=` rules: a doubled hyphen inside an XML comment is
       a parse error that takes the WHOLE template file down, every t-name in it
       with it (W22), and the same trap covers naming a CSS custom property,
       whose prefix is two hyphens (W72). -->
  <t t-name="pb_settings.PbSettingsHub">
    <div class="pbim pbst">

      <!-- ======================= header ======================= -->
      <header class="pbst-top">
        <span class="pbst-brand">
          <span class="pbst-brand__ic" t-out="ic('settings', 16)"/>
          <span class="pbst-brand__tx">Settings</span>
        </span>

        <!-- The return door, when the caller passed one. It sits beside the
             title because that is where a user looks for "where am I and how
             do I get out". -->
        <HubBackChip t-if="back" back="back" tone="'light'"/>

        <span class="pbst-sp"/>

        <button class="pbst-search" t-on-click="() => this.openPalette()"
                aria-label="Search screens and actions">
          <span class="pbst-search__ic" t-out="ic('search', 14)"/>
          <span class="pbst-search__tx">Search screens and actions…</span>
          <!-- A keyboard glyph is NOT translated — it is what is printed on
               the key (W80). -->
          <span class="pbst-search__kbd" t-esc="paletteHint"/>
        </button>
      </header>

      <div class="pbst-body">

        <!-- NOTHING may sit between these three branches, not even a comment:
             `t-elif` / `t-else` bind to the immediately preceding sibling and a
             comment silently breaks the chain into a runtime template error
             (W23). The second branch is the honest empty state — a persona with
             none of the configuration groups gets a SENTENCE, because a blank
             pane with no explanation reads as a broken build. -->
        <div t-if="!state.resolved" class="pbim-busy">
          <div class="pbim-spin"/><span>Loading settings…</span>
        </div>
        <div t-elif="!categories.length" class="pbst-none">
          <span class="pbst-none__ic" t-out="ic('lock', 22)"/>
          <span class="pbst-none__t" t-esc="emptyTitle"/>
          <span class="pbst-none__s" t-esc="emptyNote"/>
        </div>
        <div t-else="" class="pbst-split">

          <!-- ==================== the rail of groups ====================
               NAV P2: seven groups on the rail standard (ledger R1: 72px, an
               icon above a short capital word, the selected one a soft pill,
               no hover widening). The full word is the tooltip. -->
          <nav class="pbst-nav" aria-label="Settings groups"
               t-on-keydown="(ev) => this.onRailKeydown(ev)">
            <button t-foreach="groups" t-as="g" t-key="g.key"
                    class="pbst-nav__b"
                    t-att-class="{ 'is-on': currentGroup and currentGroup.key === g.key }"
                    t-att-aria-current="currentGroup and currentGroup.key === g.key ? 'page' : false"
                    t-att-title="g.title or g.label"
                    t-att-data-group="g.key"
                    t-on-click="() => this.setGroup(g.key)">
              <span class="pbst-nav__ic" t-out="ic(g.icon, 18)"/>
              <span class="pbst-nav__l" t-esc="g.label"/>
            </button>
          </nav>

          <!-- ======================= the pane =======================
               The group's categories, each a titled section of its cards.
               A category with one door says so on its title, and the title
               opens that door (setCat's sole-card rule). -->
          <main class="pbst-main" t-if="currentGroup">
            <h1 class="pbst-h" t-esc="currentGroup.label"/>
            <section t-foreach="currentGroup.cats" t-as="c" t-key="c.key"
                     class="pbst-sec" t-att-data-cat="c.key">
              <h2 class="pbst-sec__h">
                <button t-if="soleCard(c)" class="pbst-sec__t is-door"
                        t-att-title="c.label"
                        t-on-click="() => this.setCat(c.key)">
                  <span class="pbst-sec__ic" t-out="ic(c.icon, 15)"/>
                  <span t-esc="c.label"/>
                  <span class="pbst-sec__go" t-out="ic('chevron', 13)"/>
                </button>
                <span t-else="" class="pbst-sec__t">
                  <span class="pbst-sec__ic" t-out="ic(c.icon, 15)"/>
                  <span t-esc="c.label"/>
                </span>
              </h2>
              <p class="pbst-blurb" t-esc="c.blurb"/>

              <div class="pbst-cards">
                <div t-foreach="cardsOf(c)" t-as="k" t-key="k.id"
                     class="pbst-card" t-att-class="{ 'is-locked': !!cardLock(k) }">
                  <span class="pbst-card__ic" t-out="ic(cardLock(k) ? 'lock' : k.icon, 17)"/>
                  <span class="pbst-card__tx">
                    <span class="pbst-card__l" t-esc="k.label"/>
                    <!-- FLEET P4. A part of the product this company has not got,
                         kept on screen because the platform asked for a padlock
                         rather than for it to vanish. The card says what it is
                         and how to get it, in the platform's own words. -->
                    <span class="pbst-card__s"
                          t-esc="cardLock(k) or k.sub"/>
                  </span>
                  <button t-if="!cardLock(k)" class="pbim-btn primary pbst-go"
                          t-att-title="k.label"
                          t-on-click="() => this.openCard(k)">Open</button>
                  <button t-else="" class="pbim-btn outline pbst-go"
                          t-att-title="k.label"
                          t-on-click="() => this.openCard(k)">Ask Payobook</button>
                </div>
              </div>
            </section>
          </main>
        </div>
      </div>
    </div>
  </t>

</templates>
