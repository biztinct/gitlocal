#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_final
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we are giving you a final written warning.\n"
"\n"
"${decision}\n"
"\n"
"This warning stays on your HR file until ${valid_until}. If the problem happens again, your employment may end. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr ""

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_written
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we are giving you a written warning.\n"
"\n"
"${decision}\n"
"\n"
"This warning stays on your HR file until ${valid_until}. If the problem happens again, further steps may be taken. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr ""

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_dismissal
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we have decided to end your employment.\n"
"\n"
"${decision}\n"
"\n"
"HR will contact you about your last day, your final pay and returning company property. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr ""

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_none
msgid ""
"Dear ${employee},\n"
"\n"
"Thank you for meeting us about ${reason}.\n"
"\n"
"${decision}\n"
"\n"
"We have decided to take no further action. This letter is kept on your HR file.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr ""

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_verbal
msgid ""
"Dear ${employee},\n"
"\n"
"This letter confirms the verbal warning you were given about ${reason}.\n"
"\n"
"${decision}\n"
"\n"
"The warning stays on your HR file until ${valid_until}. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr ""

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_invite
msgid ""
"Dear ${employee},\n"
"\n"
"We would like to meet you to talk about a concern: ${reason}.\n"
"\n"
"The meeting will take place on ${hearing_date} at ${hearing_place}.\n"
"\n"
"You may bring a colleague or an employee representative with you. You will be able to give your side of what happened before any decision is made.\n"
"\n"
"If you cannot attend at this time, please tell HR as soon as possible.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr ""

