#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_final
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we are giving you a final written warning.\n"
"\n"
"${decision}\n"
"\n"
"This warning stays on your HR file until ${valid_until}. If the problem happens again, your employment may end. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Yth. ${employee},\n\nSetelah pertemuan kita mengenai ${reason}, kami memberikan teguran tertulis terakhir kepada Anda.\n\n${decision}\n\nTeguran ini tercatat di berkas HR Anda sampai ${valid_until}. Jika masalah ini terulang, hubungan kerja Anda dapat berakhir. Anda dapat membalas surat ini jika tidak setuju.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_written
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we are giving you a written warning.\n"
"\n"
"${decision}\n"
"\n"
"This warning stays on your HR file until ${valid_until}. If the problem happens again, further steps may be taken. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Yth. ${employee},\n\nSetelah pertemuan kita mengenai ${reason}, kami memberikan teguran tertulis kepada Anda.\n\n${decision}\n\nTeguran ini tercatat di berkas HR Anda sampai ${valid_until}. Jika masalah ini terulang, langkah lanjutan dapat diambil. Anda dapat membalas surat ini jika tidak setuju.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_dismissal
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we have decided to end your employment.\n"
"\n"
"${decision}\n"
"\n"
"HR will contact you about your last day, your final pay and returning company property. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Yth. ${employee},\n\nSetelah pertemuan kita mengenai ${reason}, kami memutuskan untuk mengakhiri hubungan kerja Anda.\n\n${decision}\n\nHR akan menghubungi Anda tentang hari terakhir, gaji terakhir, dan pengembalian aset perusahaan. Anda dapat membalas surat ini jika tidak setuju.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_none
msgid ""
"Dear ${employee},\n"
"\n"
"Thank you for meeting us about ${reason}.\n"
"\n"
"${decision}\n"
"\n"
"We have decided to take no further action. This letter is kept on your HR file.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Yth. ${employee},\n\nTerima kasih telah bertemu kami mengenai ${reason}.\n\n${decision}\n\nKami memutuskan tidak mengambil tindakan lanjutan. Surat ini disimpan di berkas HR Anda.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_verbal
msgid ""
"Dear ${employee},\n"
"\n"
"This letter confirms the verbal warning you were given about ${reason}.\n"
"\n"
"${decision}\n"
"\n"
"The warning stays on your HR file until ${valid_until}. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Yth. ${employee},\n\nSurat ini mengonfirmasi teguran lisan yang Anda terima mengenai ${reason}.\n\n${decision}\n\nTeguran ini tercatat di berkas HR Anda sampai ${valid_until}. Anda dapat membalas surat ini jika tidak setuju.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_invite
msgid ""
"Dear ${employee},\n"
"\n"
"We would like to meet you to talk about a concern: ${reason}.\n"
"\n"
"The meeting will take place on ${hearing_date} at ${hearing_place}.\n"
"\n"
"You may bring a colleague or an employee representative with you. You will be able to give your side of what happened before any decision is made.\n"
"\n"
"If you cannot attend at this time, please tell HR as soon as possible.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Yth. ${employee},\n\nKami ingin bertemu Anda untuk membicarakan sebuah keluhan: ${reason}.\n\nPertemuan akan diadakan pada ${hearing_date} di ${hearing_place}.\n\nAnda boleh membawa seorang rekan atau perwakilan karyawan. Anda dapat menyampaikan penjelasan Anda sebelum keputusan apa pun dibuat.\n\nJika Anda tidak dapat hadir pada waktu tersebut, mohon beri tahu HR secepatnya.\n\n${signed_by}\n${company}\n${date}"

