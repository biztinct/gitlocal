#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_final
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we are giving you a final written warning.\n"
"\n"
"${decision}\n"
"\n"
"This warning stays on your HR file until ${valid_until}. If the problem happens again, your employment may end. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Kính gửi ${employee},\n\nSau buổi làm việc về việc ${reason}, công ty gửi bạn cảnh cáo bằng văn bản lần cuối.\n\n${decision}\n\nCảnh cáo này được lưu trong hồ sơ nhân sự của bạn đến ${valid_until}. Nếu sự việc tái diễn, hợp đồng lao động của bạn có thể bị chấm dứt. Bạn có thể phản hồi thư này nếu không đồng ý.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_written
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we are giving you a written warning.\n"
"\n"
"${decision}\n"
"\n"
"This warning stays on your HR file until ${valid_until}. If the problem happens again, further steps may be taken. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Kính gửi ${employee},\n\nSau buổi làm việc về việc ${reason}, công ty gửi bạn cảnh cáo bằng văn bản.\n\n${decision}\n\nCảnh cáo này được lưu trong hồ sơ nhân sự của bạn đến ${valid_until}. Nếu sự việc tái diễn, công ty có thể có biện pháp tiếp theo. Bạn có thể phản hồi thư này nếu không đồng ý.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_dismissal
msgid ""
"Dear ${employee},\n"
"\n"
"Following our meeting about ${reason}, we have decided to end your employment.\n"
"\n"
"${decision}\n"
"\n"
"HR will contact you about your last day, your final pay and returning company property. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Kính gửi ${employee},\n\nSau buổi làm việc về việc ${reason}, công ty quyết định chấm dứt hợp đồng lao động với bạn.\n\n${decision}\n\nBộ phận Nhân sự sẽ liên hệ với bạn về ngày làm việc cuối cùng, khoản lương cuối và việc hoàn trả tài sản công ty. Bạn có thể phản hồi thư này nếu không đồng ý.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_none
msgid ""
"Dear ${employee},\n"
"\n"
"Thank you for meeting us about ${reason}.\n"
"\n"
"${decision}\n"
"\n"
"We have decided to take no further action. This letter is kept on your HR file.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Kính gửi ${employee},\n\nCảm ơn bạn đã tham gia buổi làm việc về việc ${reason}.\n\n${decision}\n\nCông ty quyết định không xử lý thêm. Thư này được lưu trong hồ sơ nhân sự của bạn.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_verbal
msgid ""
"Dear ${employee},\n"
"\n"
"This letter confirms the verbal warning you were given about ${reason}.\n"
"\n"
"${decision}\n"
"\n"
"The warning stays on your HR file until ${valid_until}. You may reply to this letter if you disagree.\n"
"\n"
"${signed_by}\n"
"${company}\n"
"${date}"
msgstr "Kính gửi ${employee},\n\nThư này xác nhận lời nhắc nhở bạn đã nhận về việc ${reason}.\n\n${decision}\n\nNhắc nhở này được lưu trong hồ sơ nhân sự của bạn đến ${valid_until}. Bạn có thể phản hồi thư này nếu không đồng ý.\n\n${signed_by}\n${company}\n${date}"

#. module: pb_conduct
#: model:pb.conduct.letter.template,body:pb_conduct.tpl_invite
msgid ""
"Dear ${employee},\n"
"\n"
"We would like to meet you to talk about a concern: ${reason}.\n"
"\n"
"The meeting will take place on ${hearing_date} at ${hearing_place}.\n"
"\n"
