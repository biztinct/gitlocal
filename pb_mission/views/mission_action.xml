<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Mission Control shell. Test URL: /odoo/action-pb_workforce
         (on this server the backend prefix is /bizapp — biz_deroute).

         Deep-linking: `pb_shell_lens` names the lens to open, and `pb_lens` /
         `pb_focus` are forwarded to the Time lens unchanged, so a caller uses
         the SAME vocabulary whether it targets the hub directly or the shell
         around it (W26). e.g.
             doAction("pb_mission.action_pb_workforce", { additionalContext: {
                 pb_shell_lens: "time", pb_lens: "exceptions", pb_focus: "queue" } })

         The SEVEN cockpit actions this shell absorbs all stay registered and
         reachable — P3a retires rail entries, never actions (W18). -->
    <record id="action_pb_workforce" model="ir.actions.client">
        <field name="name">Workforce</field>
        <field name="tag">pb_workforce</field>
    </record>
</odoo>
