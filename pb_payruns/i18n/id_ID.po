msgstr "menunggu persetujuan"

#. module: pb_payruns
#. odoo-python
#: code:addons/pb_payruns/models/workflow_contract.py:0
msgid "Someone sends the pay run for approval"
msgstr "Seseorang mengirim penggajian untuk disetujui"

#. module: pb_payruns
#. odoo-python
#: code:addons/pb_payruns/models/workflow_contract.py:0
msgid "done"
msgstr "selesai"

#. module: pb_payruns
#. odoo-python
#: code:addons/pb_payruns/models/workflow_contract.py:0
