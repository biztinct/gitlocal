msgstr "Pemberi persetujuan menolaknya"

#. module: pb_payruns
#. odoo-python
#: code:addons/pb_payruns/models/workflow_contract.py:0
msgid ""
"Its payslips are checked and held while the run waits for approval, so nobody can change or pay them."
msgstr ""
"Slip gajinya diperiksa dan ditahan selama penggajian menunggu persetujuan, jadi tidak ada yang bisa mengubah atau membayarnya."

#. module: pb_payruns
#. odoo-python
#: code:addons/pb_payruns/models/workflow_contract.py:0
msgid "Its payslips are finished, ready for payslips, bank files and payment."
msgstr "Slip gajinya sudah final, siap untuk slip gaji, file bank, dan pembayaran."

#. module: pb_payruns
#. odoo-python
#: code:addons/pb_payruns/models/workflow_contract.py:0
msgid "Its payslips are cancelled."
msgstr "Slip gajinya dibatalkan."

#. module: pb_payruns
#. odoo-python
#: code:addons/pb_payruns/models/workflow_contract.py:0
msgid "Draft"
msgstr "Draf"

#. module: pb_payruns
#. odoo-python
#: code:addons/pb_payruns/models/workflow_contract.py:0
