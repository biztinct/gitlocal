<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Two papers = two paper formats = two report actions sharing ONE
         template (Odoo 19 needs an explicit ir.actions.report record, FACTS
         gotcha 12). The orientation travels in the render context
         (`landscape`), the top margin in the page's own attributes (taller
         with the company letterhead). Not bound to any Print menu. -->
    <record id="paperformat_pdf_a4" model="report.paperformat">
        <field name="name">Report PDF - A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">16</field>
        <field name="margin_bottom">22</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="False"/>
    </record>
    <record id="paperformat_pdf_a3" model="report.paperformat">
        <field name="name">Report PDF - A3</field>
        <field name="default" eval="False"/>
        <field name="format">A3</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">16</field>
        <field name="margin_bottom">22</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="False"/>
    </record>

    <record id="action_report_pdf_a4" model="ir.actions.report">
        <field name="name">Report PDF (A4)</field>
        <field name="model">pb.report.pdf.look</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pb_report_pdf.report_table</field>
        <field name="report_file">pb_report_pdf.report_table</field>
        <field name="paperformat_id" ref="paperformat_pdf_a4"/>
    </record>
    <record id="action_report_pdf_a3" model="ir.actions.report">
        <field name="name">Report PDF (A3)</field>
        <field name="model">pb.report.pdf.look</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pb_report_pdf.report_table</field>
        <field name="report_file">pb_report_pdf.report_table</field>
        <field name="paperformat_id" ref="paperformat_pdf_a3"/>
    </record>

    <!-- The table, drawn the same way on screen (first page) and in the PDF.
         Every value is already written for the reader; t-esc keeps any text
         inert. -->
    <template id="table_body">
        <style t-out="doc['css']"/>
        <div class="pbrp">
            <div class="pbrp-head">
                <h1 class="pbrp-title" t-esc="doc['title']"/>
                <p t-if="doc['subtitle']" class="pbrp-sub" t-esc="doc['subtitle']"/>
                <div t-if="doc['cap_note']" class="pbrp-cap" t-esc="doc['cap_note']"/>
            </div>
            <table t-if="doc['columns']" t-attf-class="pbrp-t {{ doc['stripes'] and 'pbrp-striped' or '' }}">
                <colgroup>
                    <col t-foreach="doc['columns']" t-as="c" t-attf-style="width: {{ c['w'] }}%;"/>
                </colgroup>
                <thead>
                    <tr>
                        <th t-foreach="doc['columns']" t-as="c" t-att-class="c['align']" t-att-data-key="c['key']" t-esc="c['label']"/>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="doc['entries']" t-as="e">
                        <tr t-if="e['t'] == 'r'" t-att-class="e['odd'] and 'pbrp-odd' or None">
                            <td t-foreach="e['cells']" t-as="v" t-att-class="doc['aligns'][v_index]" t-esc="v"/>
                        </tr>
                        <tr t-elif="e['t'] == 'g'" t-attf-class="pbrp-g pbrp-g{{ e['level'] }}">
                            <td t-att-colspan="doc['ncols']"><t t-esc="e['label']"/><span class="pbrp-gc" t-esc="e['count']"/></td>
                        </tr>
                        <tr t-else="" t-attf-class="{{ e['t'] == 't' and 'pbrp-gt' or 'pbrp-s' }}">
                            <td t-foreach="e['cells']" t-as="lines" t-att-class="doc['aligns'][lines_index]">
                                <t t-foreach="lines" t-as="ln"><t t-if="ln_index"><br/></t><t t-esc="ln"/></t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <p t-if="doc['empty']" class="pbrp-empty" t-esc="doc['empty']"/>
            <p t-if="doc['source_note']" class="pbrp-note" t-esc="doc['source_note']"/>
            <div t-if="doc['closing']" class="pbrp-closing" t-esc="doc['closing']"/>
        </div>
    </template>

    <!-- The footer line added to the company's own footer when the
         letterhead is on (see models/report.py). Inline styles: the footer
         is its own small page with only the report styles. -->
    <template id="footer_extra">
        <div class="pbrp-foot-extra" style="font-family: 'DejaVu Sans', Arial, Helvetica, sans-serif; font-size: 8.5px; color: #64748b; text-align: center; margin-top: 1mm;">
            <span t-if="doc['printed']" t-esc="doc['printed']"/>
            <span t-if="doc['printed'] and doc['cap_note']"> · </span>
            <span t-if="doc['cap_note']" style="color: #92400e;" t-esc="doc['cap_note']"/>
        </div>
    </template>

    <!-- The PDF. One document per render. -->
    <template id="report_table">
        <t t-if="rp">
            <t t-set="title" t-value="rp['title']"/>
            <t t-set="data_report_margin_top" t-value="margin_top"/>
            <t t-set="data_report_header_spacing" t-value="header_spacing"/>
            <t t-if="letterhead">
                <t t-call="web.html_container">
                    <t t-set="o" t-value="None"/>
                    <t t-call="web.external_layout">
                        <div class="page">
                            <t t-call="pb_doc_studio.page_frame">
                                <t t-set="mode" t-value="'pdf'"/>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
            <t t-else="">
                <t t-call="web.html_container">
                    <div class="article pbrp-article" t-att-data-oe-lang="doc_lang">
                        <div class="page">
                            <t t-call="pb_doc_studio.page_frame">
                                <t t-set="mode" t-value="'pdf'"/>
                            </t>
                        </div>
                    </div>
                    <div class="footer pbrp-footer">
                        <table t-if="rp['printed'] or rp['pages_on'] or rp['cap_note']" style="width: 100%; border-collapse: collapse; font-family: 'DejaVu Sans', Arial, Helvetica, sans-serif; font-size: 8.5px; color: #64748b; border-top: 1px solid #e2e4ee;">
                            <tr>
                                <td style="padding-top: 1.5mm; text-align: left; vertical-align: top;">
                                    <span t-if="rp['printed']" t-esc="rp['printed']"/>
                                    <div t-if="rp['cap_note']" style="color: #92400e;" t-esc="rp['cap_note']"/>
                                </td>
                                <td t-if="rp['pages_on']" style="padding-top: 1.5mm; text-align: right; vertical-align: top; white-space: nowrap; width: 30%;">
                                    <t t-out="page_counter"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- The first page on screen: the paper at its real size, the page
         frame in screen mode (it draws the letterhead itself) and the
         footer at the foot of the sheet. -->
    <template id="screen_page">
        <div t-attf-class="pbrp-sheet {{ doc['sideways'] and 'is-sideways' or '' }}"
             t-attf-style="width: {{ doc['paper_mm'][0] }}mm; height: {{ doc['paper_mm'][1] }}mm;">
            <div class="pbrp-sheet-body">
                <t t-call="pb_doc_studio.page_frame">
                    <t t-set="mode" t-value="'screen'"/>
                </t>
            </div>
            <div class="pbrp-sheet-foot">
                <div t-if="footer_contact" class="pbrp-sheet-contact" t-esc="footer_contact"/>
                <div class="pbrp-sheet-line">
                    <span class="pbrp-sheet-printed">
                        <t t-if="doc['printed']" t-esc="doc['printed']"/>
                        <span t-if="doc['cap_note']" class="pbrp-sheet-cap" t-esc="doc['cap_note']"/>
                    </span>
                    <span t-if="doc['pages_on']" class="pbrp-sheet-page" t-esc="page_word"/>
                </div>
            </div>
        </div>
    </template>

</odoo>
