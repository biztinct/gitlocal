#. module: pb_offboarding
#: model:mail.template,name:pb_offboarding.mail_template_resignation_returned
msgid "Offboarding: resignation sent back"
msgstr "Pengunduran diri: surat pengunduran diri dikembalikan"

#. module: pb_offboarding
#: model:mail.template,subject:pb_offboarding.mail_template_resignation_returned
msgid "Your resignation was sent back to you"
msgstr "Surat pengunduran diri Anda dikembalikan kepada Anda"

#. module: pb_offboarding
#: model:mail.template,body_html:pb_offboarding.mail_template_resignation_returned
msgid ""
"<div style=\"margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;\">\n"
"                <p>Hello <t t-out=\"object.greeting() or ''\"/>,</p>\n"
"                <p>\n"
"                    Your resignation was sent back to you before a decision,\n"
"                    so nothing has been changed on your record yet.\n"
"                </p>\n"
"                <div style=\"border-left:3px solid #5A4BB0; padding:8px 14px; margin:14px 0; background:#F4F2FB;\">\n"
"                    <t t-out=\"object._pb_sent_back_note() or 'No reason was given.'\"/>\n"
"                </div>\n"
"                <p>\n"
"                    Change what is asked and send it again from your own page\n"
"                    under <strong>My resignation</strong>.\n"
"                </p>\n"
"                <p>\n"
"                    <a t-attf-href=\"/my/resignation\" style=\"display:inline-block; padding:10px 18px; background:#5A4BB0; color:#ffffff; border-radius:8px; text-decoration:none;\">\n"
"                        Open my resignation\n"
"                    </a>\n"
"                </p>\n"
"                <br/>\n"
"                The HR team<br/>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin:0; padding:0; font-family:Inter,Helvetica,Arial,sans-serif; color:#1B1733;\">\n"
"                <p>Halo <t t-out=\"object.greeting() or ''\"/>,</p>\n"
"                <p>\n"
"                    Pengunduran diri Anda dikembalikan sebelum ada keputusan,\n"
"                    jadi belum ada yang diubah pada catatan Anda.\n"
"                </p>\n"
"                <div style=\"border-left:3px solid #5A4BB0; padding:8px 14px; margin:14px 0; background:#F4F2FB;\">\n"
"                    <t t-out=\"object._pb_sent_back_note() or 'Tidak ada alasan yang diberikan.'\"/>\n"
"                </div>\n"
"                <p>\n"
"                    Ubah sesuai yang diminta lalu kirim lagi dari halaman Anda\n"
"                    di bagian <strong>Pengunduran diri saya</strong>.\n"
"                </p>\n"
"                <p>\n"
"                    <a t-attf-href=\"/my/resignation\" style=\"display:inline-block; padding:10px 18px; background:#5A4BB0; color:#ffffff; border-radius:8px; text-decoration:none;\">\n"
"                        Buka pengunduran diri saya\n"
"                    </a>\n"
"                </p>\n"
"                <br/>\n"
"                Tim HR<br/>\n"
"            </div>\n"
"        "
