<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LEARN REFRESH step 6. Lifecycle › Exits closes a settlement and sends a
         ready-to-check one for approval. The HR exits team therefore reads and
         writes every settlement in its companies — the base rule alone ("the
         ones I was asked to decide") hid them all. -->
    <record id="rule_fnf_exits_team" model="ir.rule">
        <field name="name">Final settlement: the HR exits team</field>
        <field name="model_id" ref="pb_hr_fullandfinal.model_hr_full_final_settlement"/>
        <field name="groups" eval="[(4, ref('pb_lifecycle.group_lifecycle_manager')), (4, ref('pb_lifecycle.group_lifecycle_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
