#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.portal_ask_hr_new
msgid ""
"<span class=\"pbah-step-n\">1</span><span><b>HR gets it straight "
"away</b><span>Your question goes to the HR team's queue.</span></span>"
msgstr ""
"<span class=\"pbah-step-n\">1</span><span><b>Nhân sự nhận được "
"ngay</b><span>Câu hỏi của bạn vào hàng chờ của phòng nhân sự.</span></span>"

#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.portal_ask_hr_new
msgid ""
"<span class=\"pbah-step-n\">2</span><span><b>Their answer appears "
"here</b><span>We e-mail you as well, so you do not have to "
"check.</span></span>"
msgstr ""
"<span class=\"pbah-step-n\">2</span><span><b>Câu trả lời hiện ở "
"đây</b><span>Chúng tôi cũng gửi e-mail cho bạn, nên bạn không cần phải kiểm "
"tra.</span></span>"

#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.portal_ask_hr_new
msgid ""
"<span class=\"pbah-step-n\">3</span><span><b>Reply, or mark it "
"solved</b><span>Ask a follow-up in the same conversation.</span></span>"
msgstr ""
"<span class=\"pbah-step-n\">3</span><span><b>Trả lời, hoặc đánh dấu đã "
"xong</b><span>Hỏi thêm ngay trong cùng cuộc trao đổi.</span></span>"

#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.portal_ask_hr_ticket
msgid ""
"<span>HR answered. Reply if you need more, or tell them it solved it.</span>"
msgstr ""
"<span>Nhân sự đã trả lời. Hãy trả lời nếu bạn cần thêm, hoặc báo cho họ biết"
" vấn đề đã được giải quyết.</span>"

#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.portal_ask_hr_ticket
msgid "<span>Sorted it another way?</span>"
msgstr "<span>Đã giải quyết theo cách khác?</span>"

#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.portal_ask_hr_ticket
msgid ""
"<span>With HR. They usually answer within a working day, and we e-mail you "
"when they do.</span>"
msgstr ""
"<span>Đang ở phòng nhân sự. Họ thường trả lời trong một ngày làm việc, và "
"chúng tôi sẽ gửi e-mail cho bạn khi có câu trả lời.</span>"

