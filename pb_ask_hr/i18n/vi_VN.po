#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.portal_ask_hr_ticket
msgid ""
"<b>Did that answer it?</b><span>Mark it solved and it moves to Closed. You "
"can reopen it for 14 days.</span>"
msgstr ""
"<b>Câu trả lời đã giải quyết được chưa?</b><span>Đánh dấu đã xong, câu hỏi "
"sẽ chuyển sang mục Đã đóng. Bạn có thể mở lại trong 14 ngày.</span>"

#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.portal_ask_hr_ticket
msgid "<b>This question is closed.</b>"
msgstr "<b>Câu hỏi này đã đóng.</b>"

#. module: pb_ask_hr
#: model_terms:ir.ui.view,arch_db:pb_ask_hr.pbah_picker
