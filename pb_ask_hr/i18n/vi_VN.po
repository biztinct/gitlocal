"<span class=\"pbah-drop-t\"><b>Attach files</b><span>PDF, JPG or PNG, up to "
"3, 10 MB each</span></span>"
msgstr ""
"<span class=\"pbah-drop-t\"><b>Đính kèm tệp</b><span>PDF, JPG hoặc PNG, tối "
"đa 3 tệp, mỗi tệp 10 MB</span></span>"

