<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Update salary rules with accounting information
             Using base chart of accounts:
               - account.1_expense_salary (630000 Salary Expenses) for expense rules
               - account.1_salary_payable (230000 Salary Payable) for payable rules
        -->
        <record id="om_hr_payroll.hr_rule_basic" model="hr.salary.rule">
            <field name="account_debit" ref="account.1_expense_salary"/>
            <field name="account_credit" ref="account.1_salary_payable"/>
        </record>

        <record id="om_hr_payroll.hr_rule_taxable" model="hr.salary.rule">
            <field name="account_debit" ref="account.1_expense_salary"/>
            <field name="account_credit" ref="account.1_salary_payable"/>
        </record>

        <record id="om_hr_payroll.hr_rule_hra" model="hr.salary.rule">
