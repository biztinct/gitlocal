            <field name="account_credit" ref="account.1_salary_payable"/>
        </record>

        <record id="om_hr_payroll.hr_rule_da" model="hr.salary.rule">
            <field name="account_debit" ref="account.1_expense_salary"/>
            <field name="account_credit" ref="account.1_salary_payable"/>
        </record>

        <record id="om_hr_payroll.hr_rule_travel" model="hr.salary.rule">
            <field name="account_debit" ref="account.1_expense_salary"/>
