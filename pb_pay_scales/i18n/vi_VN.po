#. module: pb_pay_scales
#. odoo-python
#: code:addons/pb_pay_scales/models/scale_raise_screen.py:0
msgid ""
"Worked out through each person's own pay rules: basic pay and everything "
"that follows from it, with the employer's contributions."
msgstr "Tính theo quy tắc lương của từng người: lương cơ bản và mọi khoản theo sau nó, cùng phần đóng góp của công ty."

#. module: pb_pay_scales
#. odoo-python
#: code:addons/pb_pay_scales/models/scale_raise_screen.py:0
msgid ""
"Worked out through the pay rules where the person's scheme allows it; the "
"rest by the wage difference alone."
msgstr "Tính theo quy tắc lương khi bảng lương của người đó cho phép; phần còn lại chỉ theo chênh lệch lương."

#. module: pb_pay_scales
#. odoo-javascript
#: code:addons/pb_pay_scales/static/src/xml/scale_raise.xml:0
