msgstr "Xóa bản nháp này? Không có gì khác thay đổi."

#. module: pb_pay_scales
#. odoo-javascript
#: code:addons/pb_pay_scales/static/src/js/scale_raise.js:0
msgid ""
"Starts from the table now in force (%s). That table is kept exactly as it "
"was."
msgstr "Bắt đầu từ bảng đang áp dụng (%s). Bảng đó được giữ nguyên."

#. module: pb_pay_scales
#. odoo-python
#: code:addons/pb_pay_scales/models/review_dated.py:0
