#. module: pb_explorer
#. odoo-javascript
#: code:addons/pb_explorer/static/src/js/explorer.js:0
msgid "Filter"
msgstr "Filter"

#. module: pb_explorer
#. odoo-python
#: code:addons/pb_explorer/models/pb_explorer.py:0
msgid "This breakdown is not available right now. Open the board again."
msgstr "Pembagian ini sedang tidak tersedia. Buka papan ini lagi."

#. module: pb_explorer
#. odoo-python
#: code:addons/pb_explorer/models/pb_explorer_view.py:0
msgid "This view was split or filtered by a field that is not available to you any more, so it opened without it."
msgstr "Tampilan ini dibagi atau disaring menurut kolom yang tidak lagi tersedia untuk Anda, jadi dibuka tanpa kolom itu."

#. module: pb_explorer
#. odoo-python
#: code:addons/pb_explorer/models/pb_explorer.py:0
msgid "“%(measure)s” cannot be split or filtered by “%(dim)s”. That field belongs to a person, while component-level figures are counted per pay component — one person appears in many components. Pick another measure, or take the component off the filters."
msgstr "“%(measure)s” tidak bisa dibagi atau disaring menurut “%(dim)s”. Kolom itu milik seseorang, sedangkan angka per komponen dihitung per komponen gaji — satu orang ada di banyak komponen. Pilih ukuran lain, atau keluarkan komponen dari saringan."
