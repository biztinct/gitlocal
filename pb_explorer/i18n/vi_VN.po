#. module: pb_explorer
#. odoo-python
#: code:addons/pb_explorer/models/pb_explorer.py:0
msgid "“%(measure)s” cannot be broken down by “%(dim)s”. Headcount and job-level figures are counted per employee, while component-level figures are counted per pay component — one employee appears in many components, so combining them would count people more than once. Pick a component measure, or group by department or division instead."
msgstr "“%(measure)s” không thể được chia nhỏ thành “%(dim)s”. Số lượng nhân viên và cấp độ công việc được tính cho mỗi nhân viên, trong khi số liệu ở cấp thành phần được tính cho mỗi thành phần trả lương — một nhân viên xuất hiện trong nhiều thành phần, do đó việc kết hợp chúng sẽ tính số người nhiều lần. Thay vào đó, hãy chọn một thước đo thành phần hoặc nhóm theo bộ phận hoặc bộ phận."

#. module: pb_explorer
#. odoo-python
#: code:addons/pb_explorer/models/pb_explorer.py:0
msgid "“%s” is not a money total, so the movement below explains NET PAY."
msgstr "“%s” không phải là tổng số tiền, vì vậy chuyển động bên dưới giải thích NET PAY."

#. module: pb_explorer
#. odoo-python
#: code:addons/pb_explorer/models/pb_explorer.py:0
msgid "“%s” started being paid"
msgstr "“%s” bắt đầu được thanh toán"

#. module: pb_explorer
#. odoo-python
#: code:addons/pb_explorer/models/pb_explorer.py:0
msgid "“%s” stopped being paid"
msgstr "“%s” đã ngừng thanh toán"
