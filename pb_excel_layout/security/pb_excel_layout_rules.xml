<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DOCSTUDIO X. Cloned from pb_explorer/security/pb_explorer_rules.xml,
         one step tighter: through the ORM a person reaches ONLY their own
         layouts. A layout somebody shared is reached only through the
         facade `pb.excel.layout.board`, after that facade has proven the
         reader may open the report the layout belongs to, so the file (which
         may hold last month's figures) never reaches someone who cannot open
         that report. Settings admins may tidy any layout. -->
    <record id="rule_pb_excel_layout_own" model="ir.rule">
        <field name="name">Excel layouts: only your own</field>
        <field name="model_id" ref="model_pb_excel_layout"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_pb_excel_layout_admin" model="ir.rule">
        <field name="name">Excel layouts: settings admins tidy any</field>
        <field name="model_id" ref="model_pb_excel_layout"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
