msgstr "Một người"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "Something went wrong. Try again."
msgstr "Đã có lỗi. Hãy thử lại."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Standard Excel"
msgstr "Excel chuẩn"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
#: model:ir.model.fields,field_description:pb_excel_layout.field_pb_excel_layout__start_cell
msgid "Start cell"
msgstr "Ô bắt đầu"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Steps"
msgstr "Các bước"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/pb_explorer_schedule.py:0
msgid ""
"That Excel layout is no longer available. Choose another, or the standard "
"Excel."
msgstr "Mẫu Excel đó không còn nữa. Hãy chọn mẫu khác, hoặc tệp Excel chuẩn."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The Excel table “%s” has a different number of columns, so it was left as it"
" is. Make it as wide as the report and it will grow with the rows."
msgstr ""
"Bảng Excel “%s” có số cột khác nên được giữ nguyên. Hãy làm bảng rộng bằng "
"báo cáo thì bảng sẽ tự dài theo số hàng."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "The Excel table “%s” now covers every row."
msgstr "Bảng Excel “%s” giờ đã bao hết các hàng."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "The figures do not fit below %(cell)s. Start higher up."
msgstr "Số liệu không vừa bên dưới %(cell)s. Hãy bắt đầu cao hơn."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "The figures do not fit to the right of %(cell)s. Start further left."
msgstr "Số liệu không vừa ở bên phải %(cell)s. Hãy bắt đầu lùi sang trái."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "The figures start at"
msgstr "Số liệu bắt đầu tại"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The filled file did not pass the final check, so it was not handed out."
msgstr "Tệp đã điền không qua được bước kiểm tra cuối nên không được giao ra."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The headings of the Excel table “%(table)s” (%(ref)s) are inside the area "
"where the figures go. Start the figures at the table's heading row, or move "
"the table."
msgstr ""
"Tiêu đề của bảng Excel “%(table)s” (%(ref)s) nằm trong vùng ghi số liệu. Hãy"
" bắt đầu số liệu tại hàng tiêu đề của bảng, hoặc dời bảng đi."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The layout could not be used. Open it, check the sheet and the start cell, "
"and try again."
msgstr ""
"Không dùng được mẫu này. Hãy mở ra, kiểm tra trang tính và ô bắt đầu, rồi "
"thử lại."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "The report behind this layout is no longer available."
msgstr "Báo cáo của mẫu này không còn nữa."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid ""
"The sheet of this layout is missing from its file, so the standard Excel is "
"sent until a sheet is picked again."
msgstr ""
"Tệp của mẫu này thiếu trang tính, nên tệp Excel chuẩn được gửi cho tới khi "
"chọn lại trang tính."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"The sheet “%(sheet)s” and the start cell %(cell)s are kept when the new file"
" still has that sheet."
msgstr ""
"Trang tính “%(sheet)s” và ô bắt đầu %(cell)s được giữ nguyên nếu tệp mới vẫn"
" có trang tính đó."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The sheet “%(sheet)s” is not in this file. Pick the sheet that receives the "
"figures."
msgstr ""
"Trang tính “%(sheet)s” không có trong tệp này. Hãy chọn trang tính nhận số "
"liệu."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"The sheet “%s” is not in this file. Pick the sheet that receives the "
"figures."
msgstr ""
"Trang tính “%s” không có trong tệp này. Hãy chọn trang tính nhận số liệu."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "They get their own figures in it, never yours."
msgstr "Họ nhận số liệu của chính họ trong đó, không bao giờ là của bạn."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "This file cannot be used"
msgstr "Không dùng được tệp này"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "This file contains macros. %(product)s does not run or change them."
msgstr "Tệp này có macro. %(product)s không chạy và không thay đổi chúng."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "This file contains macros. They are kept, never run."
msgstr "Tệp này có macro. Chúng được giữ nguyên, không bao giờ được chạy."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file could not be opened as an Excel workbook. Save it from Excel as "
".xlsx and upload it again."
msgstr ""
"Không mở được tệp này như một sổ làm việc Excel. Hãy lưu lại từ Excel thành "
".xlsx rồi tải lên lại."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file could not be read. Open it in Excel, save it again and upload the "
"new copy."
msgstr ""
"Không đọc được tệp này. Hãy mở bằng Excel, lưu lại và tải lên bản mới."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file does not hold an Excel workbook. Save it from Excel as .xlsx and "
"upload it again."
msgstr ""
"Tệp này không chứa sổ làm việc Excel. Hãy lưu từ Excel thành .xlsx rồi tải "
"lên lại."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file has unusual content and cannot be used. Save it again from Excel "
"and upload the new copy."
msgstr ""
"Tệp này có nội dung bất thường nên không dùng được. Hãy lưu lại từ Excel và "
"tải lên bản mới."

#. module: pb_excel_layout
#. odoo-javascript
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"This file is larger than 10 MB. Remove what is not needed (old sheets, large"
" pictures) and upload it again."
msgstr ""
"Tệp này lớn hơn 10 MB. Hãy xóa những gì không cần (trang tính cũ, hình ảnh "
"lớn) rồi tải lên lại."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file is password-protected. Remove the password and upload it again."
msgstr "Tệp này có mật khẩu. Hãy gỡ mật khẩu rồi tải lên lại."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file is too large once it is opened (over 80 MB). Remove what is not "
"needed and upload it again."
msgstr ""
"Tệp này quá lớn khi được mở ra (trên 80 MB). Hãy xóa những gì không cần rồi "
"tải lên lại."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file is too large once it is opened. Remove what is not needed and "
"upload it again."
msgstr ""
"Tệp này quá lớn khi được mở ra. Hãy xóa những gì không cần rồi tải lên lại."

#. module: pb_excel_layout
#. odoo-javascript
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"This is an old-style Excel file (.xls). Open it in Excel, save it as .xlsx "
"and upload it again."
msgstr ""
"Đây là tệp Excel kiểu cũ (.xls). Hãy mở bằng Excel, lưu thành .xlsx rồi tải "
"lên lại."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "This layout belongs to a different report."
msgstr "Mẫu này thuộc về một báo cáo khác."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "This layout is no longer available."
msgstr "Mẫu này không còn nữa."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "This report has no columns to write yet."
msgstr "Báo cáo này chưa có cột nào để ghi."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid ""
"This view has no figures right now; only the headings would be written. Try "
"it again after the next pay run."
msgstr ""
"Dạng xem này hiện chưa có số liệu; chỉ tiêu đề được ghi. Hãy thử lại sau kỳ "
"chạy lương tới."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid ""
"To send your own Excel file filled with these figures, set it up first with "
"“My Excel layout” at the top of the board."
msgstr ""
"Để gửi tệp Excel của chính bạn với số liệu này, hãy thiết lập trước bằng "
"“Mẫu Excel của tôi” ở đầu bảng."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/pb_explorer_view.py:0
msgid "Total"
msgstr "Tổng"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"Totals and charts in your file refresh when it is opened in Excel. Some "
"other spreadsheet programs need “Recalculate” pressed."
msgstr ""
"Tổng và biểu đồ trong tệp của bạn tự cập nhật khi mở bằng Excel. Một số "
"chương trình bảng tính khác cần bấm “Tính lại”."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Try it"
msgstr "Thử ngay"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Try it and save"
msgstr "Thử và lưu"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid ""
"Upload it once. Every download brings it back with fresh figures, in your "
"own headings, formulas and charts."
msgstr ""
"Tải lên một lần. Mỗi lần tải về, bạn nhận lại tệp với số liệu mới, giữ "
"nguyên tiêu đề, công thức và biểu đồ của bạn."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Use another file"
msgstr "Dùng tệp khác"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Use my Excel layout"
msgstr "Dùng mẫu Excel của tôi"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Where the figures go"
msgstr "Chỗ ghi số liệu"

#. module: pb_excel_layout
#: model:ir.model.fields,field_description:pb_excel_layout.field_pb_explorer_schedule_log__reason
msgid "Why"
msgstr "Lý do"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
#: model:ir.model.fields,field_description:pb_excel_layout.field_pb_excel_layout__write_headers
msgid "Write the column headings"
msgstr "Ghi tiêu đề cột"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/pb_excel_layout.py:0
msgid "You already have %s Excel layouts. Delete one you no longer use first."
msgstr "Bạn đã có %s mẫu Excel. Hãy xóa bớt một mẫu không còn dùng trước."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "You have 20 layouts. Delete one to add another."
msgstr "Bạn đã có 20 mẫu. Hãy xóa một mẫu để thêm mẫu mới."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"Your Excel table “%s” starts here. It will grow and shrink with the rows."
msgstr ""
"Bảng Excel “%s” của bạn bắt đầu ở đây. Bảng sẽ dài ra hoặc ngắn lại theo số "
"hàng."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Your file"
msgstr "Tệp của bạn"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"Your file is downloaded with %(rows)s rows from %(cell)s. Open it to check, "
"then save the layout."
msgstr ""
"Tệp của bạn đã được tải về với %(rows)s hàng từ %(cell)s. Hãy mở ra kiểm "
"tra, rồi lưu mẫu."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Your own Excel file, filled with these figures"
msgstr "Tệp Excel của chính bạn, điền sẵn số liệu này"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Your own headings stay; the figures start right at the cell."
msgstr "Tiêu đề của bạn được giữ; số liệu bắt đầu ngay tại ô đó."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "across to column %s"
msgstr "sang tới cột %s"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "choose a file"
msgstr "chọn tệp"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "down to row %s"
msgstr "xuống tới hàng %s"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "on “%s”"
msgstr "trên “%s”"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "or"
msgstr "hoặc"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "— .xlsx or .xlsm, up to 10 MB"
msgstr "— .xlsx hoặc .xlsm, tối đa 10 MB"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"“%(cell)s” is not a cell. Click a cell in the grid, or type one like B6."
msgstr ""
"“%(cell)s” không phải là một ô. Hãy bấm vào một ô trong lưới, hoặc gõ một ô "
"như B6."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"“%(name)s” could not be used: %(why)s The standard Excel was downloaded "
"instead."
msgstr ""
"Không dùng được “%(name)s”: %(why)s Đã tải về tệp Excel chuẩn thay thế."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"“%(sheet)s” is a chart sheet, not a sheet with cells. Pick a sheet with "
"cells."
msgstr ""
"“%(sheet)s” là trang biểu đồ, không có ô. Hãy chọn một trang tính có ô."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "“%s” is now only yours."
msgstr "“%s” giờ chỉ của riêng bạn."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "“%s” is saved."
msgstr "Đã lưu “%s”."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "“%s” is saved. Use “Download in my layout” any time."
msgstr "Đã lưu “%s”. Dùng “Tải về theo mẫu của tôi” bất cứ lúc nào."
