#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Standard Excel"
msgstr "Excel standar"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
#: model:ir.model.fields,field_description:pb_excel_layout.field_pb_excel_layout__start_cell
msgid "Start cell"
msgstr "Sel awal"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Steps"
msgstr "Langkah"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/pb_explorer_schedule.py:0
msgid ""
"That Excel layout is no longer available. Choose another, or the standard "
"Excel."
msgstr ""
"Tata letak Excel itu sudah tidak tersedia. Pilih yang lain, atau Excel "
"standar."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The Excel table “%s” has a different number of columns, so it was left as it"
" is. Make it as wide as the report and it will grow with the rows."
msgstr ""
"Tabel Excel “%s” memiliki jumlah kolom berbeda, jadi dibiarkan apa adanya. "
"Buat selebar laporan dan tabel akan bertambah mengikuti barisnya."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "The Excel table “%s” now covers every row."
msgstr "Tabel Excel “%s” kini mencakup semua baris."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "The figures do not fit below %(cell)s. Start higher up."
msgstr "Angka-angkanya tidak muat di bawah %(cell)s. Mulai lebih ke atas."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "The figures do not fit to the right of %(cell)s. Start further left."
msgstr ""
"Angka-angkanya tidak muat di sebelah kanan %(cell)s. Mulai lebih ke kiri."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "The figures start at"
msgstr "Angka-angkanya dimulai di"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The filled file did not pass the final check, so it was not handed out."
msgstr ""
"Berkas yang sudah diisi tidak lolos pemeriksaan akhir, jadi tidak diberikan."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The headings of the Excel table “%(table)s” (%(ref)s) are inside the area "
"where the figures go. Start the figures at the table's heading row, or move "
"the table."
msgstr ""
"Judul tabel Excel “%(table)s” (%(ref)s) berada di dalam area tempat angka-"
"angkanya. Mulai angkanya di baris judul tabel, atau pindahkan tabelnya."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The layout could not be used. Open it, check the sheet and the start cell, "
"and try again."
msgstr ""
"Tata letak tidak dapat dipakai. Buka, periksa lembar dan sel awalnya, lalu "
"coba lagi."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "The report behind this layout is no longer available."
msgstr "Laporan di balik tata letak ini sudah tidak tersedia."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid ""
"The sheet of this layout is missing from its file, so the standard Excel is "
"sent until a sheet is picked again."
msgstr ""
"Lembar tata letak ini hilang dari berkasnya, jadi Excel standar dikirim "
"sampai lembar dipilih lagi."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"The sheet “%(sheet)s” and the start cell %(cell)s are kept when the new file"
" still has that sheet."
msgstr ""
"Lembar “%(sheet)s” dan sel awal %(cell)s tetap dipakai jika berkas baru "
"masih memiliki lembar itu."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"The sheet “%(sheet)s” is not in this file. Pick the sheet that receives the "
"figures."
msgstr ""
"Lembar “%(sheet)s” tidak ada di berkas ini. Pilih lembar yang menerima "
"angka-angkanya."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"The sheet “%s” is not in this file. Pick the sheet that receives the "
"figures."
msgstr ""
"Lembar “%s” tidak ada di berkas ini. Pilih lembar yang menerima angka-"
"angkanya."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "They get their own figures in it, never yours."
msgstr ""
"Mereka mendapat angka mereka sendiri di dalamnya, tidak pernah angka Anda."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "This file cannot be used"
msgstr "Berkas ini tidak dapat dipakai"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
