msgstr "Tata letak ini milik laporan lain."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "This layout is no longer available."
msgstr "Tata letak ini sudah tidak tersedia."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid "This report has no columns to write yet."
msgstr "Laporan ini belum memiliki kolom untuk ditulis."

