msgstr "Judul Anda sendiri tetap; angka-angkanya dimulai tepat di sel itu."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "across to column %s"
msgstr "ke kanan sampai kolom %s"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "choose a file"
msgstr "pilih berkas"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "down to row %s"
msgstr "ke bawah sampai baris %s"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "on “%s”"
msgstr "di “%s”"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "or"
msgstr "atau"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "— .xlsx or .xlsm, up to 10 MB"
msgstr "— .xlsx atau .xlsm, hingga 10 MB"

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"“%(cell)s” is not a cell. Click a cell in the grid, or type one like B6."
msgstr "“%(cell)s” bukan sel. Klik sel di kisi, atau ketik sel seperti B6."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"“%(name)s” could not be used: %(why)s The standard Excel was downloaded "
"instead."
msgstr ""
"“%(name)s” tidak dapat dipakai: %(why)s Excel standar diunduh sebagai "
"gantinya."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"“%(sheet)s” is a chart sheet, not a sheet with cells. Pick a sheet with "
"cells."
msgstr ""
"“%(sheet)s” adalah lembar grafik, bukan lembar bersel. Pilih lembar yang "
"memiliki sel."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid "“%s” is now only yours."
msgstr "“%s” kini hanya milik Anda."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
