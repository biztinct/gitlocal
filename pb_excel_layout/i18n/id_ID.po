msgstr ""
"Berkas ini berisi makro. %(product)s tidak menjalankan atau mengubahnya."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "This file contains macros. They are kept, never run."
msgstr "Berkas ini berisi makro. Makro disimpan, tidak pernah dijalankan."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file could not be opened as an Excel workbook. Save it from Excel as "
".xlsx and upload it again."
msgstr ""
"Berkas ini tidak dapat dibuka sebagai buku kerja Excel. Simpan dari Excel "
"sebagai .xlsx lalu unggah lagi."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file could not be read. Open it in Excel, save it again and upload the "
"new copy."
msgstr ""
"Berkas ini tidak dapat dibaca. Buka di Excel, simpan lagi lalu unggah "
"salinan barunya."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file does not hold an Excel workbook. Save it from Excel as .xlsx and "
"upload it again."
msgstr ""
"Berkas ini tidak berisi buku kerja Excel. Simpan dari Excel sebagai .xlsx "
"lalu unggah lagi."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
