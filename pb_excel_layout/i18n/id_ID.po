#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Try it"
msgstr "Coba"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Try it and save"
msgstr "Coba dan simpan"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
