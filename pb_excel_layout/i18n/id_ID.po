#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid ""
"To send your own Excel file filled with these figures, set it up first with "
"“My Excel layout” at the top of the board."
msgstr ""
"Untuk mengirim berkas Excel Anda sendiri berisi angka-angka ini, siapkan "
"dulu lewat “Tata letak Excel saya” di bagian atas papan."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/pb_explorer_view.py:0
