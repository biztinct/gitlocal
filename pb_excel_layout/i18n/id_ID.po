#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"This file is larger than 10 MB. Remove what is not needed (old sheets, large"
" pictures) and upload it again."
msgstr ""
"Berkas ini lebih dari 10 MB. Hapus yang tidak diperlukan (lembar lama, "
"gambar besar) lalu unggah lagi."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file is password-protected. Remove the password and upload it again."
msgstr ""
"Berkas ini dilindungi kata sandi. Hapus kata sandinya lalu unggah lagi."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file is too large once it is opened (over 80 MB). Remove what is not "
"needed and upload it again."
msgstr ""
"Berkas ini terlalu besar setelah dibuka (lebih dari 80 MB). Hapus yang tidak"
" diperlukan lalu unggah lagi."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
msgid ""
"This file is too large once it is opened. Remove what is not needed and "
"upload it again."
msgstr ""
"Berkas ini terlalu besar setelah dibuka. Hapus yang tidak diperlukan lalu "
"unggah lagi."

#. module: pb_excel_layout
#. odoo-javascript
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
msgid ""
"This is an old-style Excel file (.xls). Open it in Excel, save it as .xlsx "
"and upload it again."
msgstr ""
"Ini berkas Excel format lama (.xls). Buka di Excel, simpan sebagai .xlsx "
"lalu unggah lagi."

#. module: pb_excel_layout
#. odoo-python
#: code:addons/pb_excel_layout/models/words.py:0
