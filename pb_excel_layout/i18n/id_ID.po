"Upload it once. Every download brings it back with fresh figures, in your "
"own headings, formulas and charts."
msgstr ""
"Unggah sekali. Setiap unduhan mengembalikannya dengan angka terbaru, dengan "
"judul, rumus, dan grafik Anda sendiri."

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Use another file"
msgstr "Pakai berkas lain"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/js/excel_layout.js:0
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Use my Excel layout"
msgstr "Pakai tata letak Excel saya"

#. module: pb_excel_layout
#. odoo-javascript
#: code:addons/pb_excel_layout/static/src/xml/excel_layout.xml:0
msgid "Where the figures go"
msgstr "Tempat angka-angkanya"

#. module: pb_excel_layout
