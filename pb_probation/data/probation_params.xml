<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ==================================================================
         The dials, shipped so they are DISCOVERABLE rather than folklore.

         The SWITCHES — probation_mail, auto_trigger, hourly_alerts — are
         deliberately NOT here, for the reason P3 and P4 both wrote down:
         they default in code (`probation_common.DEFAULTS`), and shipping a
         record for them would freeze whatever value a test run happened to
         leave behind, because `noupdate="1"` means the next upgrade never
         corrects it.

         `pb_probation.auto_trigger` in particular defaults to OFF in code
         and is meant to be turned on by hand, once, after an administrator
         has read the count the daily job logs.

         Everything below is a number with a sensible answer, and changing
         one is a normal thing for an HR administrator to do. They are only
         reached when no probation policy covers the person at all — the
         policies are the real answer.
         ================================================================== -->

    <record id="param_duration_months" model="ir.config_parameter">
        <field name="key">pb_probation.duration_months</field>
        <field name="value">2</field>
    </record>

    <record id="param_lead_days" model="ir.config_parameter">
        <field name="key">pb_probation.evaluation_lead_days</field>
        <!-- How far before the end of a trial period the review opens.
             Three weeks leaves room to ask colleagues, read the answers and
             have the conversation without rushing the decision. -->
        <field name="value">21</field>
    </record>

    <record id="param_feedback_days" model="ir.config_parameter">
        <field name="key">pb_probation.feedback_window_days</field>
        <!-- How long a colleague has to answer. Short on purpose: a window
             that runs for a fortnight is answered on the fourteenth day. -->
        <field name="value">3</field>
    </record>

    <record id="param_grace_days" model="ir.config_parameter">
        <field name="key">pb_probation.extension_grace_days</field>
        <field name="value">1</field>
    </record>

    <record id="param_extension_months" model="ir.config_parameter">
        <field name="key">pb_probation.default_extension_months</field>
        <field name="value">1</field>
    </record>

    <record id="param_trigger_cap" model="ir.config_parameter">
        <field name="key">pb_probation.trigger_cap</field>
        <!-- Even with the trigger switched on, one night never opens more
             than this many reviews. A backlog worked through over three
             nights is a backlog; three hundred at once is an incident. -->
        <field name="value">20</field>
    </record>

    <record id="param_remind_far" model="ir.config_parameter">
        <field name="key">pb_probation.remind_days_far</field>
        <field name="value">15</field>
    </record>

    <record id="param_remind_near" model="ir.config_parameter">
        <field name="key">pb_probation.remind_days_near</field>
        <field name="value">5</field>
    </record>

</data>
</odoo>
