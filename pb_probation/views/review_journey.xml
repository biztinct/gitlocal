<odoo>
  <record id="view_probation_journey" model="ir.ui.view"><field name="name">Probation assessment and review</field><field name="model">pb.probation.review</field><field name="inherit_id" ref="view_pb_probation_review_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_pb_approve" string="Approve recommendation" type="object" class="oe_highlight" invisible="pb_gate not in ['hr', 'ceo']"/></xpath><xpath expr="//sheet" position="inside"><group string="Manager evaluation · expectations scale (1–4)"><field name="pb_leadership"/><field name="pb_manager_quality"/><field name="pb_manager_culture"/><field name="pb_manager_adaptability"/><field name="pb_manager_initiative"/><field name="pb_manager_leadership" invisible="not pb_leadership"/><field name="pb_improvement_plan"/><field name="pb_improvement_due" readonly="1"/></group><group string="Review trail"><field name="pb_gate"/><field name="pb_review_note"/><field name="pb_hr_by"/><field name="pb_ceo_by"/><field name="pb_proposed"/></group></xpath></field></record>
  <record id="view_probation_policy_journey" model="ir.ui.view"><field name="name">Probation policy</field><field name="model">pb.probation.policy</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="country_id"/><field name="sequence"/><field name="active"/></group><group string="Timeline"><field name="duration_months"/><field name="evaluation_lead_days"/><field name="feedback_window_days" string="Peer feedback window (working days)"/><field name="extension_grace_days"/><field name="default_extension_months"/></group><group string="Peers and reviewers"><field name="peer_min"/><field name="peer_max"/><field name="hr_reviewer_id"/><field name="ceo_reviewer_id"/></group><field name="note"/></sheet></form></field></record>
  <template id="sop_feedback_validation" inherit_id="pb_lifecycle.journey_feedback_page"><xpath expr="//form" position="before"><div t-if="sop_error" class="alert alert-danger" role="alert" t-esc="sop_error"/></xpath></template>
  <record id="rule_probation_named_reviewer" model="ir.rule"><field name="name">Probation: assigned reviewers</field><field name="model_id" ref="model_pb_probation_review"/><field name="groups" eval="[(4, ref('base.group_user'))]"/><field name="domain_force">['|', ('policy_id.hr_reviewer_id', '=', user.id), ('policy_id.ceo_reviewer_id', '=', user.id)]</field></record>
</odoo>
