<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ==================================================================
         NO NEW GROUP LADDER. A trial period is not a separate permission
         from the rest of the employee lifecycle — the board lives inside
         the Lifecycle hub and answers a question about the same people —
         so these models ride P0's user / manager / administrator tiers,
         the same call P3 and P4 made for the same reason. A sixth ladder
         would be a group nobody would know to grant, and the first symptom
         would be an empty board on a database full of new joiners.

         WHAT IS DIFFERENT HERE, and why there are `base.group_user` rows
         in the access list at all: the LINE MANAGER is not in the HR team
         by definition, and a review whose every step can only be taken by
         HR is a review HR takes every step of — which is not a manager's
         judgement, it is HR's. So a plain internal user may read and
         advance the reviews of the people who report to them, and nothing
         else.

         Granted at the ACCESS-LIST level and narrowed HERE, which is the
         standard shape: the list says what the model allows, the rule says
         which rows.
         ================================================================== -->

    <record id="rule_probation_policy_company" model="ir.rule">
        <field name="name">Probation policy: company</field>
        <field name="model_id" ref="model_pb_probation_policy"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_probation_review_company" model="ir.rule">
        <field name="name">Probation review: company</field>
        <field name="model_id" ref="model_pb_probation_review"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_training_track_company" model="ir.rule">
        <field name="name">Training course: company</field>
        <field name="model_id" ref="model_pb_training_track"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_training_item_company" model="ir.rule">
        <field name="name">Training item: company</field>
        <field name="model_id" ref="model_pb_training_item"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_training_status_company" model="ir.rule">
        <field name="name">Training status: company</field>
        <field name="model_id" ref="model_pb_training_status"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ==================================================================
         WHO SEES WHOSE REVIEW.

         A probation review is the second most private record in this
         product — it is four colleagues' opinions about whether somebody
         keeps their job. So a plain internal user sees THEIR OWN and the
         ones of the people who report to them, and nothing else. The
         lifecycle manager tier — the HR team — sees the board.

         Both are group rules, and Odoo ORs group rules together, so an HR
         person who also holds the plain user tier is not narrowed by the
         tighter one.
         ================================================================== -->

    <record id="rule_probation_review_own" model="ir.rule">
        <field name="name">Probation review: mine and my team's</field>
        <field name="model_id" ref="model_pb_probation_review"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('manager_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_probation_review_all" model="ir.rule">
        <field name="name">Probation review: the HR team</field>
        <field name="model_id" ref="model_pb_probation_review"/>
        <field name="groups" eval="[(4, ref('pb_lifecycle.group_lifecycle_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- The employee's own page reads through the controller under sudo
         after the route has proved the record is theirs, so this rule is
         the second lock rather than the first. -->
    <record id="rule_probation_review_portal" model="ir.rule">
        <field name="name">Probation review: my own (portal)</field>
        <field name="model_id" ref="model_pb_probation_review"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <!-- ==================================================================
         WHO SEES WHICH TRAINING ROW. Their own, their team's, and the HR
         team's view of everybody. A course somebody has not finished is
         not a secret from them — it is the thing they have to go and do.
         ================================================================== -->

    <record id="rule_training_status_own" model="ir.rule">
        <field name="name">Training status: mine and my team's</field>
        <field name="model_id" ref="model_pb_training_status"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_training_status_all" model="ir.rule">
        <field name="name">Training status: the HR team</field>
        <field name="model_id" ref="model_pb_training_status"/>
        <field name="groups" eval="[(4, ref('pb_lifecycle.group_lifecycle_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</data>
</odoo>
