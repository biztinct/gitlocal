<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The hub kit's test surface. HIDDEN on purpose: an action record so it
         can be opened by URL, and NO menu and NO pb.sidebar.item, because it is
         not a product surface and the rail's contents are Cycle 5's cutover.

         Test URL: /odoo/action-pb_hub_demo
                   (/bizapp/action-pb_hub_demo on the live server — biz_deroute)

         Deep-linking, per pb_hub/static/src/js/hub_nav.js:
             openHub(actionService, {
                 tag: "pb_hub_demo",
                 lens: "records",
                 back: { label: "Overview", tag: "pb_hub_demo", lens: "overview" },
             })
         which writes `pb_lens` and `pb_back` into the action context. -->
    <record id="action_pb_hub_demo" model="ir.actions.client">
        <field name="name">Hub Kit Demo</field>
        <field name="tag">pb_hub_demo</field>
    </record>
</odoo>
