<odoo>
 <record id="policy_list" model="ir.ui.view"><field name="name">pb.attendance.policy.list</field><field name="model">pb.attendance.policy</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="tz"/><field name="state" widget="badge"/></list></field></record>
 <record id="policy_form" model="ir.ui.view"><field name="name">pb.attendance.policy.form</field><field name="model">pb.attendance.policy</field><field name="arch" type="xml">
  <form string="Attendance calculation policy">
   <header><button name="action_activate" string="Activate confirmed policy" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_retire" string="Retire" type="object" invisible="state != 'active'"/><field name="state" widget="statusbar"/></header>
   <sheet><div class="oe_title"><h1><field name="name" placeholder="Company attendance rules"/></h1></div>
    <div class="alert alert-info">Original punch times are retained. Calculations use the assigned shift, unpaid break and additional deduction bands. Review inferred schedules before publishing them. The employee/contract working calendar still sets standard payroll days and paid holidays; keep its normal hours consistent with these shift rules. Unknown deduction bands require review.</div>
    <group><group><field name="company_id"/><field name="tz"/><field name="pairing"/><field name="deduction_basis"/><field name="allocation"/></group><group><field name="capture_before"/><field name="capture_after"/><field name="night_premium"/><field name="night_start" widget="float_time" invisible="not night_premium"/><field name="night_end" widget="float_time" invisible="not night_premium"/></group></group>
    <notebook>
     <page string="Normal hours and breaks"><p>Offsets are elapsed hours from the shift start. Example: a 07:30 shift with normal end 9, break start 4 and break length 1 has normal time until 16:30 and an unpaid 11:30–12:30 break. Shift end can be later to include expected overtime.</p><field name="shift_ids" readonly="state != 'draft'"><list editable="bottom"><field name="template_id" domain="[('company_id','=',parent.company_id)]"/><field name="normal_end_offset"/><field name="break_start_offset"/><field name="break_hours"/><field name="second_break_start_offset"/><field name="second_break_hours"/><field name="normal_hours"/><field name="note"/></list></field></page>
     <page string="Lateness deductions"><p>Bands include the lower limit and exclude the upper limit. Deductions reduce hours already worked, starting with normal hours, then overtime if needed, never below zero. They do not deduct annual leave. An unconfirmed band is held for review.</p><field name="band_ids" readonly="state != 'draft'"><list editable="bottom"><field name="category"/><field name="minimum"/><field name="maximum" readonly="open_ended"/><field name="open_ended"/><field name="hours"/><field name="pay_late_minutes"/><field name="confirmed"/><field name="note"/></list></field></page>
     <page string="Evidence and assumptions"><field name="note"/></page>
    </notebook>
   </sheet><chatter/>
  </form>
 </field></record>
 <record id="action_policy" model="ir.actions.act_window"><field name="name">Attendance calculation policies</field><field name="res_model">pb.attendance.policy</field><field name="view_mode">list,form</field></record>
 <menuitem id="menu_policy" name="Attendance calculation policies" parent="pb_hr_workforce.menu_workforce_config" action="action_policy" sequence="5" groups="hr_attendance.group_hr_attendance_manager"/>
 <record id="roster_form" model="ir.ui.view"><field name="name">hr.shift.planning.calculation</field><field name="model">hr.shift.planning</field><field name="inherit_id" ref="pb_hr_workforce.view_shift_planning_form"/><field name="arch" type="xml">
  <xpath expr="//header" position="inside"><button name="action_preview_calculation" string="Preview payable hours" type="object" groups="hr_attendance.group_hr_attendance_manager"/><button name="action_recalculate" string="Recalculate for timesheets" type="object" groups="hr_attendance.group_hr_attendance_manager"/></xpath>
  <xpath expr="//field[@name='note']" position="before"><group string="Attendance calculation"><field name="pb_policy_id"/><field name="pb_day_kind"/><field name="pb_category"/><field name="pb_inferred"/><field name="pb_evidence"/><field name="pb_calculation_status"/><field name="pb_worked_hours"/><field name="pb_deduction_hours"/><field name="pb_normal_hours"/><field name="pb_overtime_hours"/></group><group string="Calculation detail"><field name="pb_calculation_summary" nolabel="1"/></group></xpath>
 </field></record>
 <record id="employee_form" model="ir.ui.view"><field name="name">hr.employee.attendance.policy</field><field name="model">hr.employee</field><field name="inherit_id" ref="hr.view_employee_form"/><field name="arch" type="xml"><xpath expr="//group[@name='identification_group']" position="inside"><field name="pb_attendance_category"/><field name="pb_attendance_policy_id"/></xpath></field></record>
 <record id="employee_list" model="ir.ui.view"><field name="name">hr.employee.attendance.policy.list</field><field name="model">hr.employee</field><field name="arch" type="xml"><list editable="bottom" create="0" delete="0"><field name="name" readonly="1"/><field name="barcode" readonly="1"/><field name="department_id" readonly="1"/><field name="job_title" readonly="1"/><field name="pb_attendance_category"/><field name="pb_attendance_policy_id"/><field name="company_id" readonly="1"/></list></field></record>
 <record id="action_employee_policy" model="ir.actions.act_window"><field name="name">Employee attendance settings</field><field name="res_model">hr.employee</field><field name="view_mode">list,form</field><field name="view_id" ref="employee_list"/></record>
 <menuitem id="menu_employee_policy" name="Employee attendance settings" parent="pb_hr_workforce.menu_workforce_config" action="action_employee_policy" sequence="6" groups="hr_attendance.group_hr_attendance_manager"/>
</odoo>
