<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="pb_govt_reports.PbGovtReports">
    <div class="pbim gov pbim-page gov-board" t-att-class="{ 'gov-board--embedded': props.embedded }">
      <div t-if="!state.loaded" class="pbim-busy"><div class="pbim-spin"/><span>Loading filings…</span></div>

      <div t-else="" class="pbim-wrap">

        <div class="ppl-head" data-coach="gr-head">
          <!-- The identity block is chrome the Compliance hub's command bar
               already renders (W17). The period picker beside it is a CONTROL
               and stays in both modes. -->
          <div t-if="!props.embedded">
            <HubBackChip t-if="back" back="back" tone="'light'"/>
            <h1 class="pbim-h1">Government Reports</h1>
            <p class="pbim-sub">Statutory filings for <b><t t-esc="state.data.company"/></b> · <t t-esc="state.data.country_label"/></p>
          </div>
          <div class="ppl-head-actions">
            <button t-if="state.data.form_lines and state.data.form_groups and state.data.form_groups.length" class="pbim-btn ghost gov-formlines" t-on-click="openFormLines"><t t-out="ic('listTree',15)"/> Form lines</button>
            <label class="gov-period"><t t-out="ic('calendar',15)"/>
              <input type="month" t-att-value="state.month" t-on-change="onMonth"/>
            </label>
          </div>
        </div>

        <div t-if="state.data.multi_country" class="gov-countries" data-coach="gr-countries">
          <span class="gov-clabel">Country</span>
          <t t-foreach="state.data.countries" t-as="c" t-key="c.code">
            <button class="pbim-chip" t-att-class="{'active': c.code === state.data.country_code}" t-on-click="() => this.selectCountry(c.code)">
              <t t-esc="c.label"/>
            </button>
          </t>
        </div>

        <t t-if="state.data.available">
          <!-- WDGAP S2-B2: the form tiles in their groups (Tax returns, Fund files) -->
          <div t-foreach="state.data.form_groups or []" t-as="fg" t-key="fg.key" class="pbim-panel gov-forms" t-att-data-coach="fg_first ? 'gr-forms' : undefined" t-att-data-section="fg.key">
            <div class="pbim-panel-h"><h2 class="pbim-h2"><t t-out="ic(fg.icon or 'landmark',18)"/> <t t-esc="fg.label"/></h2></div>
            <div class="gov-grid">
              <div class="gov-tile" t-foreach="fg.forms" t-as="f" t-key="f.id">
                <span class="gov-tile-ic"><t t-out="ic('fileCheck',22)"/></span>
                <div class="gov-tile-tx">
                  <span class="nm" t-esc="f.name"/>
                  <span class="jb" t-esc="f.official_name"/>
                  <span t-if="f.required_missing.length" class="gov-flag is-amber"><t t-out="ic('alert',12)"/> Pay items to choose on Form lines</span>
                  <span t-elif="!f.accepted and f.adviser_wording === 'fund'" class="gov-flag is-amber"><t t-out="ic('alert',12)"/> Check with the fund before the first upload</span>
                  <span t-elif="!f.accepted" class="gov-flag is-amber"><t t-out="ic('alert',12)"/> Check with your adviser before first filing</span>
                  <span t-else="" class="gov-flag is-green"><t t-out="ic('checkCircle',12)"/> Accepted by the authority</span>
                  <span t-if="f.latest_state_label" class="gov-flag"><t t-esc="f.latest_period"/> · <t t-esc="f.latest_state_label"/></span>
                </div>
                <button class="pbim-btn primary gov-gen" t-on-click="() => this.openForm(f)">
                  <t t-out="ic('fileCheck',15)"/> Prepare
                </button>
              </div>
            </div>
          </div>
          <div class="pbim-panel" t-foreach="state.data.groups" t-as="g" t-key="g.label">
            <div class="pbim-panel-h"><h2 class="pbim-h2"><t t-out="ic(g.icon or 'fileText',18)"/> <t t-esc="g.label"/></h2></div>
            <div class="gov-grid" data-coach="gr-grid">
              <div class="gov-tile" t-foreach="g.reports" t-as="r" t-key="r.key">
                <span class="gov-tile-ic"><t t-out="ic('fileText',22)"/></span>
                <div class="gov-tile-tx">
                  <span class="nm" t-esc="r.en"/>
                  <span class="jb" t-esc="r.vi"/>
                </div>
                <button class="pbim-btn primary gov-gen" t-on-click="() => this.generate(r.key)">
                  <t t-out="ic('download',15)"/> Generate
                </button>
              </div>
            </div>
          </div>
        </t>

        <div t-else="" class="pbim-panel">
          <div class="pbim-empty" data-coach="gr-empty">
            <t t-out="ic('file',30)"/>
            <p>Government reports for <b><t t-esc="state.data.country_label"/></b> are coming soon.</p>
          </div>
        </div>

      </div>
    </div>
  </t>

</templates>
