#: code:addons/pb_pay_builder_change/models/change.py:0
msgid ""
"A full month before and after. The month the change starts may mix both."
msgstr ""
"Lương cả tháng trước và sau khi thay đổi. Tháng bắt đầu thay đổi có thể áp "
"dụng cả hai mức."

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Yearly review"
msgstr "Đánh giá hằng năm"

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Promotion"
msgstr "Thăng chức"

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Correction"
msgstr "Điều chỉnh"

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Other"
msgstr "Khác"

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "You can look at this person but not at their pay."
msgstr "Bạn có thể xem hồ sơ người này nhưng không có quyền xem lương."

#. module: pb_pay_builder_change
#. odoo-python
#. odoo-javascript
#: code:addons/pb_pay_builder_change/models/change.py:0
#: code:addons/pb_pay_builder_change/static/src/js/change_pay.js:0
msgid "This contract is not available."
msgstr "Hợp đồng này hiện không khả dụng."

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Open the person's running contract to change their pay."
msgstr "Hãy mở hợp đồng đang có hiệu lực của người này để thay đổi lương."

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Choose the reason and the day the new pay starts."
msgstr "Chọn lý do và ngày bắt đầu áp dụng lương mới."

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Choose a pay scheme for this person first."
msgstr "Trước tiên, hãy chọn chế độ lương cho người này."

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Check the amounts and try again."
msgstr "Kiểm tra các khoản tiền rồi thử lại."

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "The new pay could not be worked out. Check the amounts."
msgstr "Không tính được lương mới. Hãy kiểm tra các khoản tiền."

#. module: pb_pay_builder_change
#. odoo-python
#: code:addons/pb_pay_builder_change/models/change.py:0
msgid "Check the permitted amount for %s."
msgstr "Kiểm tra mức được phép cho %s."

#. module: pb_pay_builder_change
#. odoo-javascript
#: code:addons/pb_pay_builder_change/static/src/js/change_pay.js:0
