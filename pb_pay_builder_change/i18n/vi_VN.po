msgstr "Thay đổi lương"

#. module: pb_pay_builder_change
#. odoo-javascript
#: code:addons/pb_pay_builder_change/static/src/js/change_pay.js:0
msgid "Save"
msgstr "Lưu"

#. module: pb_pay_builder_change
#. odoo-javascript
#: code:addons/pb_pay_builder_change/static/src/js/change_pay.js:0
msgid "Send for approval"
msgstr "Gửi phê duyệt"

#. module: pb_pay_builder_change
#. odoo-javascript
#: code:addons/pb_pay_builder_change/static/src/js/change_pay.js:0
msgid "The pay change could not be sent."
msgstr "Không gửi được thay đổi lương."

#. module: pb_pay_builder_change
#. odoo-javascript
#: code:addons/pb_pay_builder_change/static/src/xml/change_pay.xml:0
