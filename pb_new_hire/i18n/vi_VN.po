#: model:mail.template,body_html:pb_new_hire.mail_template_welcome
msgid ""
"<div style=\"margin:0;padding:0;font-family:Inter,Arial,sans-serif;color:#1f2430;font-size:15px;line-height:1.5;max-width:560px\">\n"
"    <p style=\"margin:0 0 12px\">Hello <t t-out=\"ctx.get('pb_nh_first') or object.name or ''\"/>,</p>\n"
"    <p t-if=\"ctx.get('pb_nh_kind') == 'reminder'\" style=\"margin:0 0 12px\">A quick reminder: a few things are still open before your first day at <t t-out=\"object.company_id.name or ''\"/>.</p>\n"
"    <p t-else=\"\" style=\"margin:0 0 12px\">Welcome to <t t-out=\"object.company_id.name or ''\"/>. We look forward to seeing you on <b t-out=\"ctx.get('pb_nh_day') and format_date(ctx.get('pb_nh_day'), date_format='EEEE d MMMM') or ''\"/>.</p>\n"
"    <p style=\"margin:0 0 8px\">Please finish these before your first day:</p>\n"
"    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;border-collapse:collapse;margin:0 0 18px\">\n"
"        <t t-foreach=\"ctx.get('pb_nh_items') or []\" t-as=\"item\">\n"
"            <tr>\n"
"                <td style=\"padding:9px 12px;border:1px solid #e5e7f0;border-radius:8px;background:#fafafd\">\n"
"                    <span style=\"font-weight:600\" t-out=\"item.get('label') or ''\"/>\n"
"                    <span t-if=\"item.get('need')\" style=\"display:inline-block;margin-left:6px;font-size:12px;color:#b45309\" t-out=\"item.get('need')\"/>\n"
"                </td>\n"
"            </tr>\n"
"        </t>\n"
"    </table>\n"
"    <p style=\"margin:0 0 18px\">\n"
"        <a t-att-href=\"ctx.get('pb_nh_link')\" style=\"background:#5A4BB0;color:#ffffff;padding:12px 24px;border-radius:9px;text-decoration:none;display:inline-block;font-weight:600\">Get started</a>\n"
"    </p>\n"
"    <p t-if=\"ctx.get('pb_nh_signed_in')\" style=\"margin:0 0 12px;font-size:13px;color:#5b6478\">Sign in with <t t-out=\"ctx.get('pb_nh_login') or ''\"/> to finish them.</p>\n"
"    <p t-elif=\"ctx.get('pb_nh_days')\" style=\"margin:0 0 12px;font-size:13px;color:#5b6478\">You will choose a password the first time. The link works for <t t-out=\"ctx.get('pb_nh_days')\"/> days; ask HR for a new one after that.</p>\n"
"    <p t-else=\"\" style=\"margin:0 0 12px;font-size:13px;color:#5b6478\">You will choose a password the first time. The link works for <t t-out=\"ctx.get('pb_nh_hours')\"/> hours; ask HR for a new one after that.</p>\n"
"    <p style=\"margin:0 0 12px;font-size:13px;color:#5b6478\">If the button does not work, copy this address into your browser:<br/><t t-out=\"ctx.get('pb_nh_link') or ''\"/></p>\n"
"    <p style=\"margin:0\">See you soon,<br/>The <t t-out=\"object.company_id.name or ''\"/> HR team</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Inter,Arial,sans-serif;color:#1f2430;font-size:15px;line-height:1.5;max-width:560px\">\n"
