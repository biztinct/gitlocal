<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Singapore Payroll Structure -->
        <record id="hr_payroll_structure_singapore" model="hr.payroll.structure">
            <field name="name">Singapore Salary Structure</field>
            <field name="code">SG</field>
            <field name="country_id" ref="base.sg"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="parent_id" ref="om_hr_payroll.structure_base"/>
            <field name="note">Singapore Employee Salary Structure with CPF, Income Tax and SDL components</field>
        </record>
        
        <!-- Link salary rules to structure after both are created -->
        <record id="hr_payroll_structure_singapore" model="hr.payroll.structure">
            <field name="rule_ids" eval="[(6, 0, [
                ref('hr_salary_rule_basic_singapore'),
                ref('hr_salary_rule_cpf_employee_singapore'),
                ref('hr_salary_rule_cpf_employer_singapore')
            ])]"/>
        </record>
    </data>
</odoo>