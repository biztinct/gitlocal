<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A contract row on "<name>'s Contracts History" opens the contract
         slide-over (contract_history_field.js). The stock list is
         editable="bottom" in an edit="false" form, which made a click a no-op. -->
    <record id="hr_contract_history_view_form_pb_open" model="ir.ui.view">
        <field name="name">hr.contract.history.form.pb.open</field>
        <field name="model">hr.contract.history</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_history_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='contract_ids']" position="attributes">
                <attribute name="widget">pb_contract_history</attribute>
            </xpath>
            <xpath expr="//field[@name='contract_ids']/list" position="attributes">
                <attribute name="editable"/>
            </xpath>
        </field>
    </record>
</odoo>
