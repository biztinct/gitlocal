<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDR P3 F1 (owner ruling 2026-11-05, every company, every database):
         HR Responsible is no longer required on the full contract form.
         The demand was view-only - the standard form writes
         `<field name="hr_responsible_id" required="1"/>`; the field on
         hr.contract has no `required=`. Still shown and still editable. -->
    <record id="hr_contract_view_form_pb_hr_responsible_optional" model="ir.ui.view">
        <field name="name">hr.contract.form.pb.hr.responsible.optional</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hr_responsible_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
