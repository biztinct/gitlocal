#!/bin/bash
# pb-tenant-map
#
# Writes the list of hostnames that ARE a live workspace into an nginx map, so
# sites-available/pb-wildcard can tell a real tenant from a typo.
#
# WHY THIS EXISTS (ERRORS E2-5). *.payobook.com catches every subdomain, so
# `riez.payobook.com` reached the application, no database matched the host, and
# the visitor got the platform's pre-database page: "No database is selected and
# the requested URL was not found in the server-wide controllers … Alternatively,
# use the X-Odoo-Database header." That page is served before a database is
# chosen, so no module can reach it — the only place to answer is nginx.
#
# WHY IT IS GENERATED AND NOT HARD-CODED. `dbfilter = ^%d$` in
# /etc/odoo-server.conf means a hostname is serviceable exactly when a database
# of that name exists. So the database list IS the tenant list, and reading it
# is the only version of this guard that cannot go stale and take a live tenant
# dark. _step_cert() in pb_tenants deliberately treats a failed certificate as
# non-fatal and lets a new tenant run on the wildcard, so a guard that assumed
# every tenant had its own nginx block would have broken exactly that fallback.
#
# Run by pb-tenant-map.timer every two minutes. It reloads nginx ONLY when the
# generated content actually changed and `nginx -t` passes, so a new tenant goes
# live within one tick and a normal day causes no reloads at all.
#
# Installed at /usr/local/bin/pb-tenant-map.
# Tear-down: delete /etc/nginx/conf.d/pb-known-tenants.conf, remove the
# `if ($pb_workspace = 0)` guard from sites-available/pb-wildcard, reload.
set -euo pipefail

OUT=/etc/nginx/conf.d/pb-known-tenants.conf
TMP="$(mktemp /tmp/pb-known-tenants.XXXXXX)"
trap 'rm -f "$TMP"' EXIT

BASE_DOMAIN="${PB_BASE_DOMAIN:-payobook.com}"

# Databases that are never a customer workspace. `postgres` is the cluster's own
# bookkeeping database; the two templates are copied from, never served.
SKIP_RE='^(postgres|template0|template1)$'

{
    echo "# GENERATED by /usr/local/bin/pb-tenant-map — do not edit by hand."
    echo "# Written $(date -u '+%Y-%m-%d %H:%M:%S UTC') from the live database list."
    echo "#"
    echo "# 1 = this hostname is a live workspace and is proxied to the"
    echo "#     application. 0 = nobody is here; pb-wildcard serves the"
    echo "#     'no workspace at this address' page instead."
    echo "map \$host \$pb_workspace {"
    echo "    default 0;"
    # The apex and www are the marketing site, not a tenant, but they have their
    # own server blocks and never reach the wildcard. Listed anyway so that a
    # future block reusing this map cannot turn the front door off.
    echo "    ${BASE_DOMAIN} 1;"
    echo "    www.${BASE_DOMAIN} 1;"
    sudo -u postgres psql -Atc \
        "SELECT datname FROM pg_database WHERE datistemplate = false ORDER BY 1" \
    | while read -r db; do
        [[ -z "$db" ]] && continue
        [[ "$db" =~ $SKIP_RE ]] && continue
        # Only a name that can actually BE a hostname label. Anything else could
        # not have been reached through the wildcard in the first place.
        [[ "$db" =~ ^[a-z0-9]([a-z0-9_-]*[a-z0-9])?$ ]] || continue
        # A database name may carry an underscore (payobook_template); a
        # hostname may not, so such a database is unreachable and is skipped.
        [[ "$db" == *_* ]] && continue
        echo "    ${db}.${BASE_DOMAIN} 1;"
    done
    echo "}"
} > "$TMP"

# A map with no tenants in it would take every workspace on the box down. If the
# database list came back empty or unreadable, change nothing and say so.
if [[ "$(grep -c '\.'"${BASE_DOMAIN}"' 1;' "$TMP")" -lt 2 ]]; then
    echo "pb-tenant-map: refusing to write a map with no tenants in it" >&2
    exit 1
fi

if [[ -f "$OUT" ]] && diff -q <(grep -v '^# Written ' "$OUT") \
                              <(grep -v '^# Written ' "$TMP") >/dev/null; then
    exit 0   # nothing changed — no write, no reload
fi

# Keep the outgoing file so a bad generation can be put straight back. The file
# is NEVER deleted on failure: pb-wildcard reads $pb_workspace, and a missing map
# makes `nginx -t` fail with "unknown variable" — which would turn a cosmetic
# problem into an outage at the next reload.
PREV=""
if [[ -f "$OUT" ]]; then
    PREV="${OUT}.prev"
    cp -f "$OUT" "$PREV"
fi

cp -f "$TMP" "$OUT"
chmod 0644 "$OUT"

if ! nginx -t 2>/tmp/pb-tenant-map-nginx.err; then
    echo "pb-tenant-map: nginx -t failed, putting the previous map back" >&2
    cat /tmp/pb-tenant-map-nginx.err >&2
    if [[ -n "$PREV" ]]; then
        cp -f "$PREV" "$OUT"
    else
        # Nothing to go back to: fail OPEN. Every hostname is treated as a live
        # workspace, which is exactly how this box behaved before the guard.
        printf 'map $host $pb_workspace {\n    default 1;\n}\n' > "$OUT"
    fi
    nginx -t
    exit 1
fi

systemctl reload nginx
echo "pb-tenant-map: updated $OUT"
