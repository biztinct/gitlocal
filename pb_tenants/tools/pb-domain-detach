#!/bin/bash
# pb-domain-detach <hostname> — removes a custom-domain nginx block + cert.
set -euo pipefail

HOSTNAME_ARG="${1:-}"
if ! [[ "$HOSTNAME_ARG" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]; then
    echo "invalid hostname" >&2; exit 2
fi

rm -f "/etc/nginx/sites-enabled/pb-tenant-${HOSTNAME_ARG}.conf" \
      "/etc/nginx/sites-available/pb-tenant-${HOSTNAME_ARG}.conf"
certbot delete --non-interactive --cert-name "pb-tenant-${HOSTNAME_ARG}" || true
nginx -t
systemctl reload nginx
echo "OK detached ${HOSTNAME_ARG}"
