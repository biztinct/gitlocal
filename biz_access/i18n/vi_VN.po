#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%(from)s to %(to)s, %(date)s"
msgstr "%(from)s cho %(to)s, %(date)s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "Delegation"
msgstr "Bàn giao quyền"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "A hand-over for a while needs a day it ends on. If it is not going to end, choose \"For good\" instead."
msgstr "Bàn giao có thời hạn cần có ngày kết thúc. Nếu không kết thúc, hãy chọn \"Vĩnh viễn\"."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "It would end before it starts. Check the two dates."
msgstr "Ngày kết thúc đang trước ngày bắt đầu. Hãy kiểm tra lại hai ngày."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "You cannot hand your access to yourself."
msgstr "Bạn không thể bàn giao quyền cho chính mình."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "A hand-over is a record of something that happened, so it cannot be deleted. Take it back instead — that is written down too, and it is what an auditor needs to see."
msgstr "Một lần bàn giao là bản ghi về việc đã xảy ra nên không thể xóa. Hãy thu hồi nó — việc thu hồi cũng được ghi lại, và đó là điều kiểm toán viên cần xem."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "This hand-over is already %s."
msgstr "Lần bàn giao này đã ở trạng thái %s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%(who)s can now do this on %(whose)s behalf: %(what)s."
msgstr "%(who)s giờ có thể thay %(whose)s làm việc này: %(what)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "Some of that was already theirs, so this hand-over will only take back what it actually gave."
msgstr "Một phần trong đó vốn đã là của họ, nên khi thu hồi chỉ lấy lại đúng những gì lần bàn giao này đã trao."

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
#: code:addons/biz_access/models/pb_access_facade.py:0
#: code:addons/biz_access/models/pb_access_approval.py:0
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "Choose at least one thing to hand over."
msgstr "Hãy chọn ít nhất một thứ để bàn giao."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "\"%s\" would carry the administrator permission for the whole system. It is never handed over from this screen."
msgstr "\"%s\" sẽ mang theo quyền quản trị toàn hệ thống. Quyền này không bao giờ được bàn giao từ màn hình này."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "You do not have %s, so you cannot hand it to anybody else. You can only lend what you hold yourself."
msgstr "Bạn không có %s, nên không thể trao nó cho người khác. Bạn chỉ có thể bàn giao những gì chính mình đang có."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%(who)s does not have %(what)s, so it cannot be handed to anybody else. You can only lend what somebody holds themselves."
msgstr "%(who)s không có %(what)s, nên không thể trao nó cho người khác. Chỉ có thể bàn giao những gì người đó đang có."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "Only a hand-over that is running can be taken back. This one is %s."
msgstr "Chỉ có thể thu hồi lần bàn giao đang hiệu lực. Lần này đang ở trạng thái %s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Taken back by %s."
msgstr "Đã được %s thu hồi."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "1 permission was"
msgstr "1 quyền"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%s permissions were"
msgstr "%s quyền"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%(n)s taken back."
msgstr "Đã thu hồi %(n)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "1 had"
msgstr "1 quyền"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%s had"
msgstr "%s quyền"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%(body)s %(n)s already been removed by somebody else."
msgstr "%(body)s %(n)s đã bị người khác gỡ trước đó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "nothing"
msgstr "không có gì"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "Ended on its own on %s, the day after it was due to finish."
msgstr "Tự kết thúc vào %s, một ngày sau ngày hết hạn."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "Nothing was due to end. Every hand-over that is running still has time on it."
msgstr "Không có gì cần kết thúc. Mọi lần bàn giao đang hiệu lực đều còn thời hạn."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "1 hand-over"
msgstr "1 lần bàn giao"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%s hand-overs"
msgstr "%s lần bàn giao"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%(ended)s ended and %(removed)s taken back."
msgstr "Đã kết thúc %(ended)s và thu hồi %(removed)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%s ended, and nothing needed taking back."
msgstr "Đã kết thúc %s, không có gì cần thu hồi."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%(line)s %(n)s already been removed by somebody else."
msgstr "%(line)s %(n)s đã bị người khác gỡ trước đó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "is still running"
msgstr "vẫn đang hiệu lực"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "are still running"
msgstr "vẫn đang hiệu lực"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "it"
msgstr "lần bàn giao đó"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "them"
msgstr "các lần bàn giao đó"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "%(line)s %(n)s could not be ended and %(still)s — an administrator should look at %(them)s."
msgstr "%(line)s %(n)s không thể kết thúc và %(still)s — quản trị viên nên kiểm tra %(them)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_delegation.py:0
msgid "You can hand over your own access. Handing over somebody else's is something the access team does."
msgstr "Bạn có thể bàn giao quyền của chính mình. Bàn giao quyền của người khác là việc của nhóm quản lý quyền truy cập."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_role_ability.py:0
msgid "\"%(what)s\" would carry %(bad)s — the administrator permission for the whole system. That is never something a role can hand out. An administrator changes it on the person's own record, deliberately."
msgstr "\"%(what)s\" sẽ mang theo %(bad)s — quyền quản trị toàn hệ thống. Một vai trò không bao giờ được trao quyền này. Quản trị viên chỉ thay đổi nó trên hồ sơ của chính người đó, một cách có chủ đích."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "%(what)s · %(roles)s · %(who)s"
msgstr "%(what)s · %(roles)s · %(who)s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "Access request"
msgstr "Yêu cầu quyền truy cập"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "What is being asked"
msgstr "Nội dung yêu cầu"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "How many roles"
msgstr "Số vai trò"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "Ends on a date"
msgstr "Kết thúc vào một ngày"

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Which roles"
msgstr "Những vai trò nào"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "Whole company"
msgstr "Toàn công ty"

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
#: code:addons/biz_access/models/pb_access_facade.py:0
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "1 role"
msgstr "1 vai trò"

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
#: code:addons/biz_access/models/pb_access_facade.py:0
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "%s roles"
msgstr "%s vai trò"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "Handed to"
msgstr "Bàn giao cho"

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
#: code:addons/biz_access/models/access_export.py:0
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Until"
msgstr "Đến ngày"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "What would change"
msgstr "Điều gì sẽ thay đổi"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "Who"
msgstr "Ai"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "This is approved, but %s is not allowed to change who holds a role. Ask somebody who looks after approvals to move this step to a person who is, or give them that permission first."
msgstr "Yêu cầu này đã được phê duyệt, nhưng %s không được phép thay đổi người giữ vai trò. Hãy nhờ người phụ trách phê duyệt chuyển bước này cho người có quyền đó, hoặc cấp quyền đó cho họ trước."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_request.py:0
msgid "Approver"
msgstr "Người phê duyệt"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_role_profile.py:0
msgid "\"%(what)s\" would carry %(bad)s — the administrator permission for the whole system. It is not something this board can hand out, and it cannot be put on a role. An administrator changes it on the person's own record, deliberately."
msgstr "\"%(what)s\" sẽ mang theo %(bad)s — quyền quản trị toàn hệ thống. Bảng này không thể trao quyền đó, và cũng không thể gắn nó vào một vai trò. Quản trị viên chỉ thay đổi nó trên hồ sơ của chính người đó, một cách có chủ đích."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_role_profile.py:0
msgid "\"%s\" is the administrator permission for the whole system. It is not something this board can hand out, and it cannot be put on a profile. An administrator changes it on the user record itself, deliberately."
msgstr "\"%s\" là quyền quản trị toàn hệ thống. Bảng này không thể trao quyền đó, và cũng không thể gắn nó vào một hồ sơ quyền. Quản trị viên chỉ thay đổi nó trực tiếp trên tài khoản người dùng, một cách có chủ đích."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "This board is for people with a full login. Portal accounts do not have one."
msgstr "Bảng này dành cho người có tài khoản đăng nhập đầy đủ. Tài khoản cổng thông tin không có loại đó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Giving somebody a role, or taking one away, is something the access team does. You can still hand over your own access for a while — that is the other tab."
msgstr "Giao hoặc thu hồi vai trò là việc của nhóm quản lý quyền truy cập. Bạn vẫn có thể bàn giao quyền của mình trong một thời gian — đó là ở thẻ bên cạnh."

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "For a while"
msgstr "Có thời hạn"

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "For good"
msgstr "Vĩnh viễn"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Not started"
msgstr "Chưa bắt đầu"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Running"
msgstr "Đang hiệu lực"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Ended"
msgstr "Đã kết thúc"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Taken back"
msgstr "Đã thu hồi"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "No roles have been written down yet."
msgstr "Chưa có vai trò nào được ghi lại."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "You hold 1"
msgstr "Bạn giữ 1"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "You hold %s"
msgstr "Bạn giữ %s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%(p)s in plain English — who holds them, and what each one opens. %(m)s."
msgstr "%(p)s bằng lời dễ hiểu — ai đang giữ, và mỗi vai trò mở ra những gì. %(m)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
#: code:addons/biz_access/models/pb_access_approval.py:0
msgid "%(who)s already has \"%(what)s\"."
msgstr "%(who)s đã có \"%(what)s\"."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Given on the roles board."
msgstr "Được giao trên bảng vai trò."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%(who)s now has \"%(what)s\"."
msgstr "%(who)s giờ đã có \"%(what)s\"."

#. module: biz_access
#. odoo-javascript
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
#: code:addons/biz_access/models/pb_access_approval.py:0
#: code:addons/biz_access/static/src/js/access_board.js:0
msgid "Choose at least one role."
msgstr "Hãy chọn ít nhất một vai trò."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Choose no more than 100 roles at a time."
msgstr "Mỗi lần chỉ chọn tối đa 100 vai trò."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
#: code:addons/biz_access/models/pb_access_approval.py:0
msgid "%s already has all of those roles."
msgstr "%s đã có tất cả các vai trò đó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Given together on the roles board."
msgstr "Được giao cùng lúc trên bảng vai trò."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%(who)s now has %(count)s new roles."
msgstr "%(who)s giờ có thêm %(count)s vai trò mới."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Choose a different person to copy from."
msgstr "Hãy chọn một người khác để sao chép."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%s has no permanent roles to copy."
msgstr "%s không có vai trò cố định nào để sao chép."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Copied from %s on the roles board."
msgstr "Sao chép từ %s trên bảng vai trò."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "another role"
msgstr "một vai trò khác"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%(who)s has \"%(what)s\" through %(others)s, not as a separate role. Remove %(others)s instead — removing \"%(what)s\" would change nothing."
msgstr "%(who)s có \"%(what)s\" thông qua %(others)s, không phải một vai trò riêng. Hãy gỡ %(others)s — gỡ \"%(what)s\" sẽ không thay đổi gì."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%(who)s does not have \"%(what)s\"."
msgstr "%(who)s không có \"%(what)s\"."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Every permission in \"%(what)s\" is also part of %(others)s, which %(who)s holds too — so taking this one away would change nothing. Take the other one away instead, or, if the two roles have come to mean the same thing, archive one of them from its own card."
msgstr "Mọi quyền trong \"%(what)s\" cũng nằm trong %(others)s, mà %(who)s cũng đang giữ — nên gỡ vai trò này sẽ không thay đổi gì. Hãy gỡ vai trò kia, hoặc nếu hai vai trò giờ đã giống nhau, hãy cất một trong hai đi từ thẻ của nó."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Taken away on the roles board."
msgstr "Được gỡ trên bảng vai trò."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Taken away by %s."
msgstr "Đã được %s gỡ."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%(who)s no longer has \"%(what)s\"."
msgstr "%(who)s không còn \"%(what)s\" nữa."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "That role is not on this system any more."
msgstr "Vai trò đó không còn trên hệ thống."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "\"%s\" does not point at a permission, so there is nothing to hand out."
msgstr "\"%s\" không gắn với quyền nào, nên không có gì để trao."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "\"%s\" would carry the administrator permission for the whole system. It is never given out from this screen — an administrator changes it on the person's own record, deliberately."
msgstr "\"%s\" sẽ mang theo quyền quản trị toàn hệ thống. Quyền này không bao giờ được trao từ màn hình này — quản trị viên chỉ thay đổi nó trên hồ sơ của chính người đó, một cách có chủ đích."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "That person does not have a login here."
msgstr "Người đó không có tài khoản đăng nhập ở đây."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%s has an employee login only. Roles are for people who work inside this application."
msgstr "%s chỉ có tài khoản nhân viên. Vai trò dành cho những người làm việc bên trong ứng dụng này."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Say which day it ends. That is what takes the access back without anybody having to remember."
msgstr "Hãy cho biết ngày kết thúc. Ngày đó sẽ tự thu hồi quyền mà không ai phải nhớ."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid " until %s"
msgstr " đến %s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%(who)s can now do it on your behalf%(until)s."
msgstr "%(who)s giờ có thể làm việc đó thay bạn%(until)s."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "That hand-over is not on this system."
msgstr "Lần bàn giao đó không có trên hệ thống."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "You can take back what you lent. Taking back somebody else's hand-over is something the access team does."
msgstr "Bạn có thể thu hồi những gì mình đã bàn giao. Thu hồi lần bàn giao của người khác là việc của nhóm quản lý quyền truy cập."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "The access has been taken back."
msgstr "Quyền đã được thu hồi."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Re-reading the role catalogue is something a system administrator does."
msgstr "Đọc lại danh mục vai trò là việc của quản trị viên hệ thống."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "does not open anything new on the left menu"
msgstr "không mở thêm mục nào trên menu bên trái"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "opens %s"
msgstr "mở %s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "opens %(most)s and %(last)s"
msgstr "mở %(most)s và %(last)s"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Give the role a name somebody could say out loud — it is what people will ask for by."
msgstr "Hãy đặt cho vai trò một cái tên dễ gọi — đó là tên mọi người sẽ dùng khi xin quyền."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "Tick at least one thing this role lets somebody do. A role with nothing in it is a name that hands out nothing."
msgstr "Hãy đánh dấu ít nhất một việc vai trò này cho phép làm. Vai trò không có gì bên trong chỉ là một cái tên không trao được gì."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "There is already a role called \"%s\". Two roles with one name is how somebody ends up granting the wrong one — give this one a different name, or change the one that exists."
msgstr "Đã có một vai trò tên \"%s\". Hai vai trò trùng tên dễ khiến ai đó giao nhầm — hãy đặt tên khác cho vai trò này, hoặc sửa vai trò đang có."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "That would carry %s — the administrator permission for the whole system. It is never something a role can hand out."
msgstr "Điều đó sẽ mang theo %s — quyền quản trị toàn hệ thống. Một vai trò không bao giờ được trao quyền này."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "\"%(what)s\" would hand out exactly what \"%(twin)s\" already hands out, down to the last permission. Two roles that mean the same thing cannot be told apart afterwards, and neither can be taken away from somebody who holds both. Give this one something \"%(twin)s\" does not have — or start from \"%(twin)s\" and change it."
msgstr "\"%(what)s\" sẽ trao đúng y những gì \"%(twin)s\" đang trao, không sót một quyền nào. Hai vai trò giống hệt nhau thì về sau không phân biệt được, và không thể gỡ khỏi người đang giữ cả hai. Hãy cho vai trò này thêm điều gì đó mà \"%(twin)s\" không có — hoặc bắt đầu từ \"%(twin)s\" rồi chỉnh sửa."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "\"%s\" is written down. Nobody holds it yet — give it to somebody when you are ready."
msgstr "\"%s\" đã được ghi lại. Chưa ai giữ vai trò này — hãy giao cho ai đó khi bạn sẵn sàng."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "1 person is"
msgstr "1 người"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%s people are"
msgstr "%s người"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "\"%(what)s\" is written down. %(who)s already able to do all of it, so they hold it from the start."
msgstr "\"%(what)s\" đã được ghi lại. %(who)s đã làm được tất cả những việc này, nên họ giữ vai trò ngay từ đầu."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "holds"
msgstr "đang giữ"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "hold"
msgstr "đang giữ"

