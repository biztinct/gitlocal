#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "%(said)s One entry on the left menu was opened only by it — %(where)s — so nobody can reach that entry now. The Screens lens shows it with a warning."
msgstr "%(said)s Một mục trên menu bên trái chỉ được mở bởi vai trò này — %(where)s — nên giờ không ai vào được mục đó. Thẻ Màn hình sẽ hiện nó kèm cảnh báo."

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/pb_access_facade.py:0
msgid "You can look at your own access here. Looking at somebody else's is something the access team does."
msgstr "Bạn có thể xem quyền của chính mình ở đây. Xem quyền của người khác là việc của nhóm quản lý quyền truy cập."

#. module: biz_access
#. odoo-python
