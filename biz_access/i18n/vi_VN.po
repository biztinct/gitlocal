#: code:addons/biz_access/static/src/js/access_palette.js:0
msgid "Navigation"
msgstr "Điều hướng"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_palette.js:0
msgid "What the left menu offers, who can see each entry, and in what order."
msgstr "Menu bên trái có những gì, ai thấy được từng mục, và theo thứ tự nào."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_palette.js:0
msgid "The left menu"
msgstr "Menu bên trái"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_palette.js:0
msgid "Every entry drawn as the menu itself — who can open it, why, and in what order."
msgstr "Mọi mục được vẽ đúng như trên menu — ai mở được, vì sao, và theo thứ tự nào."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_palette.js:0
msgid "Admin"
msgstr "Quản trị"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_palette.js:0
msgid "Hand my access to somebody"
msgstr "Bàn giao quyền của tôi cho người khác"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/access_palette.js:0
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Access"
msgstr "Quyền truy cập"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/mini_rail.js:0
msgid "They can open this."
msgstr "Họ mở được mục này."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/mini_rail.js:0
msgid "They see this, locked, with a note about what it is."
msgstr "Họ thấy mục này ở dạng khóa, kèm ghi chú cho biết đó là gì."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/mini_rail.js:0
msgid "This is not on their menu at all."
msgstr "Mục này hoàn toàn không có trên menu của họ."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/js/mini_rail.js:0
msgid "%s of %s"
msgstr "%s / %s"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Reading who can do what…"
msgstr "Đang đọc ai được làm gì…"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "The access board could not be read"
msgstr "Không đọc được bảng quyền truy cập"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Try again"
msgstr "Thử lại"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Look at these screens as somebody else. It changes nothing."
msgstr "Xem các màn hình này dưới góc nhìn của người khác. Không thay đổi gì cả."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "See it as"
msgstr "Xem như"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "See it as somebody else"
msgstr "Xem như người khác"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Everything on this screen is drawn as they would see it.\n                  Nothing you do changes because of it."
msgstr "Mọi thứ trên màn hình này được hiện đúng như họ sẽ thấy. Những gì bạn làm không bị ảnh hưởng."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "You"
msgstr "Bạn"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Back to your own view"
msgstr "Quay lại góc nhìn của bạn"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Start typing a name"
msgstr "Bắt đầu gõ tên"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nobody with a login matches that."
msgstr "Không có tài khoản nào khớp."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Read it again"
msgstr "Đọc lại"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "One line per person per role"
msgstr "Mỗi dòng là một người với một vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Every hand-over, grant and removal, ever"
msgstr "Mọi lần bàn giao, giao quyền và gỡ quyền, từ trước đến nay"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "History"
msgstr "Lịch sử"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Do now exactly what the nightly check does"
msgstr "Làm ngay việc mà lần kiểm tra ban đêm vẫn làm"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Take back what has ended"
msgstr "Thu hồi những gì đã hết hạn"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Add a role, rename one, or change what it says"
msgstr "Thêm vai trò, đổi tên, hoặc sửa mô tả"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Edit the list of roles"
msgstr "Sửa danh sách vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Hand my access over"
msgstr "Bàn giao quyền của tôi"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "New role"
msgstr "Vai trò mới"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Roles they hold are tagged, and the People lens is on their\n              passport. You still have exactly your own access."
msgstr "Các vai trò họ giữ được gắn nhãn, và thẻ Nhân sự đang mở hồ sơ của họ. Quyền của bạn vẫn giữ nguyên."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Search a role, or what it lets someone do"
msgstr "Tìm vai trò, hoặc việc nó cho phép làm"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "No roles written down yet"
msgstr "Chưa có vai trò nào được ghi lại"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "A role here is a permission this product already has, given a name\n              somebody can say out loud and one sentence explaining what it lets\n              them do. It is what makes \"give Mai the payroll thing\" a decision\n              instead of a guess."
msgstr "Mỗi vai trò ở đây là một quyền sẵn có trong sản phẩm, được đặt một cái tên dễ gọi và một câu giải thích nó cho phép làm gì. Nhờ vậy, \"giao cho Mai quyền lương\" là một quyết định rõ ràng thay vì phỏng đoán."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "You hold this"
msgstr "Bạn giữ vai trò này"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Restricted"
msgstr "Hạn chế"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Only shown to the people this concerns"
msgstr "Chỉ hiện với những người liên quan"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Working out what this opens…"
msgstr "Đang xác định vai trò này mở ra những gì…"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Opens on the left menu"
msgstr "Mở trên menu bên trái"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "People without this role still see this entry, locked, with a note about what it is."
msgstr "Người không có vai trò này vẫn thấy mục này ở dạng khóa, kèm ghi chú cho biết đó là gì."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "No entry on the left menu is limited to a permission\n                        yet, so nothing here changes what somebody SEES down\n                        the side of the screen. What this role changes is what\n                        they can do once they are inside."
msgstr "Chưa có mục nào trên menu bên trái bị giới hạn theo quyền, nên vai trò này không thay đổi những gì ai đó THẤY ở menu bên cạnh. Điều vai trò này thay đổi là những việc họ làm được khi đã vào bên trong."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "This role does not unlock any entry on the left menu.\n                        It changes what somebody can do inside the screens they\n                        already have."
msgstr "Vai trò này không mở thêm mục nào trên menu bên trái. Nó thay đổi những việc ai đó làm được bên trong các màn hình họ đã có."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Lets them"
msgstr "Cho phép họ"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nothing is written against this role yet, so it hands\n                        out nothing. Open the list of roles to say what it\n                        should let somebody do."
msgstr "Vai trò này chưa có nội dung nào, nên chưa trao được gì. Hãy mở danh sách vai trò để ghi rõ nó cho phép làm gì."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nobody holds this yet. It is written down and ready —\n                        give it to somebody when you need to."
msgstr "Chưa ai giữ vai trò này. Vai trò đã được ghi lại và sẵn sàng — hãy giao cho ai đó khi cần."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Lent"
msgstr "Được bàn giao"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "End the hand-over"
msgstr "Kết thúc bàn giao"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Take back"
msgstr "Thu hồi"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Give this to somebody"
msgstr "Giao vai trò này cho ai đó"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Take it off the board. It hands out nothing, nobody loses a permission, and the history keeps every mention of it."
msgstr "Đưa vai trò ra khỏi bảng. Vai trò không trao gì nữa, không ai mất quyền nào, và lịch sử vẫn giữ mọi lần nó được nhắc đến."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Put this role away"
msgstr "Cất vai trò này đi"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "People with access"
msgstr "Người có quyền truy cập"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Choose someone to see what they can use."
msgstr "Chọn một người để xem họ dùng được những gì."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Add a person"
msgstr "Thêm người"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Search a name"
msgstr "Tìm theo tên"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Reading the list…"
msgstr "Đang đọc danh sách…"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nobody with a login matches that. Try part of a name, or clear\n                the box to see everybody."
msgstr "Không có tài khoản nào khớp. Hãy thử một phần của tên, hoặc xóa ô tìm kiếm để xem tất cả."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Working out what they can see…"
msgstr "Đang xác định họ thấy được những gì…"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Their history"
msgstr "Lịch sử của họ"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Give a role"
msgstr "Giao vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "There is no left menu written down on this system, so there\n                    is nothing to draw here yet."
msgstr "Hệ thống này chưa ghi lại menu bên trái nào, nên chưa có gì để vẽ ở đây."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "They are an administrator, so every entry is open to them\n                      whatever roles they hold. Roles change what they can do\n                      inside a screen, not whether they can reach it."
msgstr "Người này là quản trị viên, nên mọi mục đều mở cho họ dù họ giữ vai trò nào. Vai trò thay đổi việc họ làm được bên trong một màn hình, chứ không quyết định họ có vào được hay không."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "No entry on the left menu is limited to a permission yet,\n                      so everybody with a login sees the same menu. What a role\n                      changes today is what somebody can do once they are\n                      inside a screen."
msgstr "Chưa có mục nào trên menu bên trái bị giới hạn theo quyền, nên mọi người có tài khoản đăng nhập đều thấy cùng một menu. Hiện tại, vai trò chỉ thay đổi những việc ai đó làm được khi đã vào một màn hình."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Roles they carry"
msgstr "Vai trò họ đang giữ"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "No roles yet. They see only the entries every account\n                      gets, and can do only what comes with having a login."
msgstr "Chưa có vai trò. Họ chỉ thấy các mục mà mọi tài khoản đều có, và chỉ làm được những việc đi kèm tài khoản đăng nhập."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Pick somebody"
msgstr "Chọn một người"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Choose a name on the left and this side shows their left menu\n                exactly as they see it, and every role they carry."
msgstr "Chọn một tên ở bên trái, bên này sẽ hiện menu bên trái đúng như họ thấy, cùng mọi vai trò họ đang giữ."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Reading the left menu…"
msgstr "Đang đọc menu bên trái…"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "The left menu could not be read"
msgstr "Không đọc được menu bên trái"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "There is no left menu on this system"
msgstr "Hệ thống này không có menu bên trái"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nothing is written down for the menu down the side of the\n                screen, so there is nothing here to gate or reorder yet."
msgstr "Chưa có gì được ghi lại cho menu bên cạnh màn hình, nên chưa có gì để giới hạn hay sắp xếp lại."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Drag an entry to move it, or hold\n                  Alt and press the up and down arrows"
msgstr "Kéo một mục để di chuyển, hoặc giữ Alt và nhấn phím mũi tên lên, xuống"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Locked block"
msgstr "Khối bị khóa"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "This whole block is shown locked to people who are not administrators."
msgstr "Cả khối này hiện dạng khóa với những người không phải quản trị viên."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Drag to move this entry"
msgstr "Kéo để di chuyển mục này"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "everyone with a login"
msgstr "mọi người có tài khoản đăng nhập"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "People who cannot open it still see it, locked, with a note."
msgstr "Người không mở được vẫn thấy mục này ở dạng khóa, kèm ghi chú."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "teaser"
msgstr "xem trước"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "nobody can open it"
msgstr "không ai mở được"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "nobody holds this role yet"
msgstr "chưa ai giữ vai trò này"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "The plain table of entries"
msgstr "Bảng danh sách các mục"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Working out who can open it…"
msgstr "Đang xác định ai mở được…"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "The only role that opened this entry has been put away, so\n                    nobody but an administrator can reach it. Put another role\n                    on it below, or take the gate off to open it to everybody\n                    again."
msgstr "Vai trò duy nhất mở mục này đã bị cất đi, nên ngoài quản trị viên không ai vào được. Hãy gắn vai trò khác vào mục này ở bên dưới, hoặc bỏ giới hạn để mở lại cho mọi người."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nobody holds the role this entry asks for, so nobody but an\n                    administrator sees it. Give the role to somebody, or put a\n                    role people already hold on it."
msgstr "Chưa ai giữ vai trò mà mục này yêu cầu, nên ngoài quản trị viên không ai thấy nó. Hãy giao vai trò đó cho ai đó, hoặc gắn một vai trò mà mọi người đang giữ."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Unlocked by"
msgstr "Được mở bởi"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nothing is asked for, so every person with a login sees this\n                  entry. Put a role on it and only the people who hold that role\n                  will."
msgstr "Mục này không yêu cầu gì, nên mọi người có tài khoản đăng nhập đều thấy. Gắn một vai trò vào đây thì chỉ người giữ vai trò đó mới thấy."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Put away"
msgstr "Đã cất"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nobody holds this yet."
msgstr "Chưa ai giữ vai trò này."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Give this role to somebody"
msgstr "Giao vai trò này cho ai đó"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Take it off"
msgstr "Gỡ ra"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Never mind"
msgstr "Thôi"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Let another role in"
msgstr "Cho thêm một vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Search a role"
msgstr "Tìm vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Every role on the board already opens this entry."
msgstr "Mọi vai trò trên bảng đều đã mở mục này."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "1 person holds it"
msgstr "1 người đang giữ"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "nobody holds it yet"
msgstr "chưa ai giữ"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Who sees it today"
msgstr "Ai thấy mục này hôm nay"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Everybody with a login. Nothing is asked for, so there is no\n                  list to show."
msgstr "Mọi người có tài khoản đăng nhập. Mục này không yêu cầu gì, nên không có danh sách để hiện."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nobody. Not one person on this system holds what this entry\n                  asks for, so only an administrator can reach it."
msgstr "Không ai cả. Không một người nào trên hệ thống giữ quyền mà mục này yêu cầu, nên chỉ quản trị viên vào được."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Everybody else"
msgstr "Những người còn lại"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Do not show it at all"
msgstr "Hoàn toàn không hiện"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Show it locked, with a note"
msgstr "Hiện dạng khóa, kèm ghi chú"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "They see the entry with a padlock on it. Clicking it shows\n                    the note below instead of opening anything."
msgstr "Họ thấy mục này có biểu tượng ổ khóa. Bấm vào sẽ hiện ghi chú bên dưới thay vì mở ra."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "The entry is simply not on their menu. They will not know it\n                    exists — which is right for something that is none of their\n                    business, and wrong for something they may need to ask for."
msgstr "Mục này đơn giản là không có trên menu của họ. Họ sẽ không biết nó tồn tại — phù hợp với thứ không liên quan đến họ, nhưng không phù hợp với thứ họ có thể cần xin quyền."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Pick an entry"
msgstr "Chọn một mục"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Choose one on the left and this side shows who can open it,\n                  through which role, and what is inside it."
msgstr "Chọn một mục ở bên trái, bên này sẽ hiện ai mở được, qua vai trò nào, và bên trong có gì."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Nobody is covering for anybody"
msgstr "Không ai đang làm thay ai"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Going away? Hand what you can do to whoever is covering, until a\n              date. Only what you actually hold is added, exactly what was\n              added is written down, and it is taken back on the morning\n              after — nobody has to remember."
msgstr "Sắp đi vắng? Hãy bàn giao những việc bạn làm được cho người làm thay, đến một ngày nhất định. Chỉ những gì bạn thực sự có mới được thêm, những gì đã thêm được ghi lại chính xác, và sẽ được thu hồi vào sáng hôm sau ngày kết thúc — không ai phải nhớ."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Take it back now"
msgstr "Thu hồi ngay"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "The full history, including every\n              role given and taken away"
msgstr "Toàn bộ lịch sử, gồm mọi lần giao và gỡ vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Create their login now. We will also try to email an invitation."
msgstr "Tạo tài khoản đăng nhập cho họ ngay. Hệ thống cũng sẽ thử gửi email mời."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Close"
msgstr "Đóng"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "They start with basic access only. After they appear in the list, open their name and choose"
msgstr "Ban đầu họ chỉ có quyền cơ bản. Khi họ hiện trong danh sách, hãy mở tên họ và chọn"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Their name"
msgstr "Tên của họ"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "For example, Mai Nguyen"
msgstr "Ví dụ: Nguyễn Thị Mai"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Work email"
msgstr "Email công việc"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "mai@company.com"
msgstr "mai@congty.com"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "This will be the email they use to sign in."
msgstr "Đây là email họ dùng để đăng nhập."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Cancel"
msgstr "Hủy"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Add person"
msgstr "Thêm người"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Take this role away"
msgstr "Gỡ vai trò này"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Choose roles"
msgstr "Chọn vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Copy from another person"
msgstr "Sao chép từ người khác"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Select one or more. Nothing changes until you confirm."
msgstr "Chọn một hoặc nhiều. Không có gì thay đổi cho đến khi bạn xác nhận."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "They already hold every role on this board. There is nothing\n                left to give them here."
msgstr "Họ đã giữ mọi vai trò trên bảng này. Không còn gì để giao thêm ở đây."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Copy permanent roles from"
msgstr "Sao chép vai trò cố định từ"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Start typing a person's name"
msgstr "Bắt đầu gõ tên một người"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "has"
msgstr "có"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "permanent role that can be added."
msgstr "vai trò cố định có thể thêm."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "permanent roles that can be added."
msgstr "vai trò cố định có thể thêm."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Temporary hand-overs are not copied."
msgstr "Các lần bàn giao tạm thời không được sao chép."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "has no new permanent roles to add."
msgstr "không có vai trò cố định mới nào để thêm."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Who is it for"
msgstr "Giao cho ai"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "It goes in the history and cannot be deleted."
msgstr "Việc này được ghi vào lịch sử và không thể xóa."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Name it, say what it lets somebody do, tick the abilities. The\n                 menu beside you updates as you tick."
msgstr "Đặt tên, nói rõ vai trò cho phép làm gì, rồi đánh dấu các quyền thao tác. Menu bên cạnh sẽ cập nhật khi bạn đánh dấu."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Close without creating anything"
msgstr "Đóng mà không tạo gì"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "What it is called"
msgstr "Tên vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Payroll auditor"
msgstr "Kiểm toán lương"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "What this lets someone do — one honest sentence"
msgstr "Vai trò này cho phép làm gì — một câu thật rõ ràng"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Read every pay run and payslip, and explore the numbers. Changes nothing."
msgstr "Xem mọi đợt lương và phiếu lương, và phân tích số liệu. Không thay đổi gì."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Where it belongs"
msgstr "Thuộc khu vực"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Worked out for you"
msgstr "Được xác định sẵn cho bạn"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "A holder of this role would see"
msgstr "Người giữ vai trò này sẽ thấy"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Every entry on this menu is open to everybody with a login\n                  today, so ticking abilities does not change this picture yet.\n                  What a role changes is what somebody can do once they are\n                  inside a screen."
msgstr "Hiện mọi mục trên menu này đều mở cho mọi người có tài khoản đăng nhập, nên việc đánh dấu quyền thao tác chưa làm thay đổi hình này. Điều vai trò thay đổi là những việc ai đó làm được khi đã vào một màn hình."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "This is exactly"
msgstr "Đây chính là"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "again. Two roles\n                  that let people do the same things are two things to keep in\n                  step forever — give that one out instead, or tick something\n                  else."
msgstr "lặp lại. Hai vai trò cho phép làm cùng những việc là hai thứ phải giữ khớp nhau mãi mãi — hãy giao vai trò kia thay thế, hoặc đánh dấu việc khác."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Next to"
msgstr "So với"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "this also lets somebody"
msgstr "vai trò này còn cho phép"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid ", and"
msgstr ", và"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "this leaves out"
msgstr "vai trò này bỏ bớt"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "The administrator permission for the whole system can never be\n                  put in a role, and you can only ever hand out what you hold\n                  yourself."
msgstr "Quyền quản trị toàn hệ thống không bao giờ được đưa vào một vai trò, và bạn chỉ có thể trao những gì chính mình đang có."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Start from an existing role instead"
msgstr "Bắt đầu từ một vai trò có sẵn"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Tick at least one thing it lets somebody do."
msgstr "Hãy đánh dấu ít nhất một việc vai trò này cho phép làm."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Create role"
msgstr "Tạo vai trò"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Hand your access over"
msgstr "Bàn giao quyền của bạn"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "You can only hand over what you hold yourself, so this list is\n            yours. Both of you get an email, and everything here is written down\n            in a history nobody can delete."
msgstr "Bạn chỉ có thể bàn giao những gì chính mình đang có, nên danh sách này là của bạn. Cả hai người đều nhận email, và mọi thứ ở đây được ghi vào lịch sử không ai xóa được."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Who is covering for you"
msgstr "Người làm thay cho bạn"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "What they should be able to do"
msgstr "Họ cần làm được những gì"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "You do not hold any of the roles on this board, so there is\n              nothing to hand over. That is not a fault — most people's access\n              comes from their job rather than from a role."
msgstr "Bạn không giữ vai trò nào trên bảng này, nên không có gì để bàn giao. Đây không phải lỗi — quyền của hầu hết mọi người đến từ công việc của họ chứ không phải từ một vai trò."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "On the morning after that date, exactly what was given is taken\n            back — and only what is still there. Nobody has to remember."
msgstr "Vào sáng hôm sau ngày đó, đúng những gì đã trao sẽ được thu hồi — và chỉ những gì vẫn còn. Không ai phải nhớ."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "There is no end date, so it stays until somebody takes it back. If\n            they are covering for a fortnight, choose \"For a while\" instead."
msgstr "Không có ngày kết thúc, nên quyền giữ nguyên cho đến khi có người thu hồi. Nếu họ chỉ làm thay hai tuần, hãy chọn \"Có thời hạn\"."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Two weeks in Da Nang"
msgstr "Hai tuần công tác ở Đà Nẵng"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/access_board.xml:0
msgid "Hand it over"
msgstr "Bàn giao"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/mini_rail.xml:0
msgid "A miniature of the left menu, showing which entries this opens"
msgstr "Menu bên trái thu nhỏ, cho thấy những mục vai trò này mở ra"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/mini_rail.xml:0
msgid "This whole group is shown to them locked, with a note about what it is."
msgstr "Cả nhóm này hiện với họ ở dạng khóa, kèm ghi chú cho biết đó là gì."

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/mini_rail.xml:0
msgid "they see it"
msgstr "họ thấy được"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/mini_rail.xml:0
msgid "locked, with a note"
msgstr "khóa, kèm ghi chú"

#. module: biz_access
#. odoo-javascript
#: code:addons/biz_access/static/src/xml/mini_rail.xml:0
msgid "select a menu to see its sub-menus"
msgstr "chọn một menu để xem các menu con"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_common.py:0
msgid "General"
msgstr "Chung"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_common.py:0
msgid "Payroll"
msgstr "Lương"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_common.py:0
msgid "Lifecycle"
msgstr "Vòng đời nhân sự"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_common.py:0
msgid "Money & budgets"
msgstr "Tiền & ngân sách"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_common.py:0
msgid "System"
msgstr "Hệ thống"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_export.py:0
msgid "Delegated"
msgstr "Bàn giao"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_export.py:0
msgid "Granted on the roles board"
msgstr "Giao trên bảng vai trò"

#. module: biz_access
#. odoo-python
#: code:addons/biz_access/models/access_export.py:0
msgid "Removed on the roles board"
msgstr "Gỡ trên bảng vai trò"
