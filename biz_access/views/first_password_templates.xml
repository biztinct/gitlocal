<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The first-password page (controllers/first_password.py). It wears
         the sign-in page's own layout, so it looks like the next step of
         signing in, which is exactly what it is. -->
    <template id="first_password_page" name="Choose your own password">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post"
                  action="/biz_access/first-password">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h4 class="mb-2">Choose your own password</h4>
                <p class="text-muted mb-3" t-esc="intro"/>
                <p class="text-muted small mb-3" t-esc="signin"/>
                <div class="mb-3">
                    <label for="new1" class="form-label">New password</label>
                    <input type="password" name="new1" id="new1" class="form-control"
                           required="required" minlength="8" maxlength="4096"
                           autocomplete="new-password" autofocus="autofocus"/>
                    <div class="form-text">At least 8 characters.</div>
                </div>
                <div class="mb-3">
                    <label for="new2" class="form-label">The same password again</label>
                    <input type="password" name="new2" id="new2" class="form-control"
                           required="required" minlength="8" maxlength="4096"
                           autocomplete="new-password"/>
                </div>
                <p class="alert alert-danger" t-if="error" role="alert" t-esc="error"/>
                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Save and continue</button>
                    <a class="btn btn-link btn-sm" href="/web/session/logout">Sign out</a>
                </div>
            </form>
        </t>
    </template>
</odoo>
