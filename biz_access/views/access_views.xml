<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         `<act_window>` and `<report>` shortcut tags are gone from the
         Odoo 19 data-file RNG; every action here is an explicit
         `<record model="ir.actions.act_window">`.

         This module ships NO menu and NO rail item. Its door is the Access
         home behind the Settings cog, and the command palette. The plain
         lists below are what a "see them all" chip opens for somebody who
         would rather read a table — and, for the hand-over history, they
         are the audit view.

         A view `<group>` in a search view has no `expand`/`string` attrs
         on Odoo 19, and xpath may not select by `[@string=...]`.
         ================================================================== -->

    <!-- ============================= roles ============================= -->

    <record id="view_pb_role_profile_list" model="ir.ui.view">
        <field name="name">pb.role.profile.list</field>
        <field name="model">pb.role.profile</field>
        <field name="arch" type="xml">
            <!-- THE SENTENCE TRAVELS WITH THE NAME. This list is read by the
                 person deciding who gets what, and a row that says only
                 "Vendor owner / System / 0" makes them guess. `description` is
                 the column that stops the guess, so it is on by default and
                 sits directly after the name.

                 `decoration-muted` on the unheld rows is the other half: a
                 role nobody holds is either new or dead, and either way it is
                 the row somebody needs to notice. -->
            <list string="Roles" multi_edit="1"
                  decoration-muted="holder_count == 0">
                <field name="sequence" widget="handle"/>
                <!-- Widths are pinned because the description is a paragraph
                     and an auto-sized table gives a paragraph everything: the
                     NAME — the one column somebody scans for — was collapsing
                     to "Payroll — c…" while the sentence ran to 800px. The
                     name gets enough room to finish, the area badge enough not
                     to read "PAYRO…", and the sentence takes what is left. -->
                <field name="name" width="240px"/>
                <field name="description" optional="show"/>
                <!-- No per-area decoration: the areas belong to whichever
                     application is installed on top of this one, and a colour
                     keyed on a word this module invented would be wrong on the
                     next product. The board itself tints by area, from a
                     palette that falls back rather than guessing. -->
                <field name="area" width="150px" widget="badge"/>
                <field name="holder_count" string="People" width="90px"/>
                <field name="ability_ids" widget="many2many_tags"
                       optional="hide"/>
                <field name="group_id" optional="hide" readonly="1"/>
                <field name="visible_group_id" width="170px" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pb_role_profile_search" model="ir.ui.view">
        <field name="name">pb.role.profile.search</field>
        <field name="model">pb.role.profile</field>
        <field name="arch" type="xml">
            <!-- Searching a role by the WORDS IN ITS SENTENCE is the point:
                 people arrive here knowing what they want somebody to be able
                 to do, not what the role is called. `description` and the
                 permission group are therefore in the default search along
                 with the name. -->
            <search string="Roles">
                <field name="name" string="Role"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('description', 'ilike', self), ('ability_ids', 'ilike', self)]"/>
                <field name="ability_ids"/>
                <field name="group_ids"/>
                <field name="visible_group_id"/>

                <!-- AREAS ARE THE APPLICATION'S WORDS, NOT THIS MODULE'S, so
                     there is no shipped filter per area here: an application
                     registers its own list and a hard-coded one would be five
                     buttons that match nothing on the next product. Grouping by
                     area (below) reads the live list and is right on every
                     build. -->
                <filter name="held" string="Somebody holds it"
                        domain="[('holder_count', '&gt;', 0)]"/>
                <filter name="unheld" string="Nobody holds it"
                        domain="[('holder_count', '=', 0)]"/>
                <separator/>
                <filter name="restricted" string="Only shown to some people"
                        domain="[('visible_group_id', '!=', False)]"/>
                <separator/>
                <filter name="inactive" string="Switched off"
                        domain="[('active', '=', False)]"/>

                <!-- No `string`/`expand` on a search <group> in Odoo 19 — the
                     RNG rejects them and the whole module load fails. -->
                <group name="group_by">
                    <filter name="gb_area" string="Area"
                            context="{'group_by': 'area'}"/>
                    <filter name="gb_ability" string="What it lets someone do"
                            context="{'group_by': 'ability_ids'}"/>
                    <filter name="gb_visible" string="Only shown to"
                            context="{'group_by': 'visible_group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pb_role_profile_form" model="ir.ui.view">
        <field name="name">pb.role.profile.form</field>
        <field name="model">pb.role.profile</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Payroll approver — final"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="area"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="holder_count"/>
                            <field name="visible_group_id"/>
                        </group>
                    </group>
                    <group string="What this lets someone do">
                        <field name="description" colspan="2" nolabel="1"
                               placeholder="One or two sentences, in the words somebody would use out loud. It is what the person granting it reads before they press the button."/>
                    </group>
                    <!-- THE ABILITIES ARE THE EDITABLE HALF AND THE
                         PERMISSIONS ARE THE CONSEQUENCE. Showing the worked-out
                         permissions beside the ticks is what stops this screen
                         being a promise nobody can check; showing them as
                         editable would be a second place to say the same thing,
                         and two places is how they come to disagree. -->
                    <group string="What it is made of">
                        <field name="ability_ids" colspan="2" nolabel="1"
                               widget="many2many_tags"
                               options="{'no_quick_create': True}"/>
                    </group>
                    <group string="Permissions this adds up to">
                        <field name="group_ids" colspan="2" nolabel="1"
                               widget="many2many_tags" readonly="1"/>
                        <field name="group_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pb_role_profile" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">pb.role.profile</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pb_role_profile_search"/>
        <!-- Deliberately NOT grouped by default. Grouping by area was tried
             and reverted the same day: Odoo opens groups COLLAPSED, so the
             screen landed on five headings and no roles, and every visit began
             with an expand. Twenty-odd rows fit on one screen — the colour of
             the area badge does the grouping work here, and "Area" is one
             press away in Group By for anybody who wants the real thing. -->
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No roles written down yet</p>
            <p>
                A role is a permission group with a name a person can act on and
                one sentence saying what it lets somebody do. It is what the
                access board hands out. The system administrator permission is
                never one of these.
            </p>
        </field>
    </record>

    <!-- =========================== abilities =========================== -->
    <!-- The small units a role is built from. There is no menu and no rail
         item on purpose: this is what opens when somebody clicks an ability on
         a role, and an auto-generated form would show the key first and the
         sentence last, which is the wrong way round for the only two people
         who will ever read it. -->

    <record id="view_pb_role_ability_list" model="ir.ui.view">
        <field name="name">pb.role.ability.list</field>
        <field name="model">pb.role.ability</field>
        <field name="arch" type="xml">
            <list string="Abilities" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name" width="260px"/>
                <field name="description" optional="show"/>
                <!-- No per-area decoration: the areas belong to whichever
                     application is installed on top of this one, and a colour
                     keyed on a word this module invented would be wrong on the
                     next product. The board itself tints by area, from a
                     palette that falls back rather than guessing. -->
                <field name="area" width="150px" widget="badge"/>
                <field name="group_ids" widget="many2many_tags"
                       optional="show"/>
                <field name="technical_key" width="180px" optional="hide"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_pb_role_ability_form" model="ir.ui.view">
        <field name="name">pb.role.ability.form</field>
        <field name="model">pb.role.ability</field>
        <field name="arch" type="xml">
            <form string="Ability">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Approve a pay run"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="area"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="technical_key" readonly="1"/>
                        </group>
                    </group>
                    <group string="The honest sentence">
                        <field name="description" colspan="2" nolabel="1"
                               placeholder="What this lets somebody do, and what it stops short of. One sentence."/>
                    </group>
                    <group string="Permissions it carries">
                        <field name="group_ids" colspan="2" nolabel="1"
                               widget="many2many_tags"/>
                    </group>
                    <group string="Roles that include it">
                        <field name="profile_ids" colspan="2" nolabel="1"
                               widget="many2many_tags" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================== the hand-overs ========================== -->

    <record id="view_pb_access_delegation_list" model="ir.ui.view">
        <field name="name">pb.access.delegation.list</field>
        <field name="model">pb.access.delegation</field>
        <field name="arch" type="xml">
            <list string="Access history" create="false" delete="false">
                <field name="date_start"/>
                <field name="origin"/>
                <field name="delegator_user_id"/>
                <field name="delegate_user_id"/>
                <field name="profile_ids" widget="many2many_tags"/>
                <field name="kind"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="reason" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_pb_access_delegation_form" model="ir.ui.view">
        <field name="name">pb.access.delegation.form</field>
        <field name="model">pb.access.delegation</field>
        <field name="arch" type="xml">
            <form string="Hand-over" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="delegator_user_id"/>
                            <field name="delegate_user_id"/>
                            <field name="kind"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="What was handed over">
                        <field name="profile_ids" colspan="2" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group string="What was actually added to their account">
                        <field name="applied_group_ids" colspan="2" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="applied_on"/>
                            <field name="ended_on"/>
                        </group>
                        <group>
                            <field name="ended_note"/>
                        </group>
                    </group>
                    <group string="Why">
                        <field name="reason" colspan="2" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pb_access_delegation_search" model="ir.ui.view">
        <field name="name">pb.access.delegation.search</field>
        <field name="model">pb.access.delegation</field>
        <field name="arch" type="xml">
            <search string="Access history">
                <field name="delegator_user_id"/>
                <field name="delegate_user_id"/>
                <filter name="running" string="Running now"
                        domain="[('state', '=', 'active')]"/>
                <filter name="handovers" string="Hand-overs only"
                        domain="[('origin', '=', 'delegation')]"/>
                <group>
                    <filter name="by_state" string="Where it is"
                            context="{'group_by': 'state'}"/>
                    <filter name="by_to" string="Who got it"
                            context="{'group_by': 'delegate_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_access_delegation" model="ir.actions.act_window">
        <field name="name">Access history</field>
        <field name="res_model">pb.access.delegation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pb_access_delegation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has been handed over yet</p>
            <p>
                Every hand-over of access, and every role given or taken away on
                the access board, is a line here. Nothing on this list can be
                deleted — that is the point of it.
            </p>
        </field>
    </record>

    <!-- ====================== the two panels themselves ====================== -->
    <!-- `ir.actions.client` RECORDS, never a bare tag: a bare tag reaches the
         action service with no NAME, and anything returning through a
         breadcrumb then lands on a crumb labelled "Unnamed". -->


    <!-- ======================= the home itself ======================= -->
    <!-- An `ir.actions.client` RECORD, never a bare tag: a bare tag reaches
         the action service with no NAME, and anything returning through a
         breadcrumb then lands on a crumb labelled "Unnamed". -->

    <record id="action_pb_access_board" model="ir.actions.client">
        <field name="name">Access &amp; delegation</field>
        <field name="tag">pb_access_board</field>
    </record>

         gate is meant to be edited, and the two plain tables behind it stay
         registered for the administrator who needs the row itself. If those
         tables went on showing only the permission column, they would describe
         an entry gated on a role as ungated — and an administrator would then
         "fix" it by widening something that was never open.

         `optional="show"` on the list rather than a plain column: the table is
         already wide, and the field belongs to a module the table's owner has
         never heard of. -->
    <record id="view_pb_sidebar_item_list_roles" model="ir.ui.view">
        <field name="name">pb.sidebar.item.list.roles</field>
        <field name="model">pb.sidebar.item</field>
        <field name="inherit_id" ref="pb_sidebar.view_pb_sidebar_item_list"/>
        <field name="arch" type="xml">
            <field name="groups_id" position="after">
                <field name="role_ids" widget="many2many_tags"
                       optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_pb_sidebar_item_form_roles" model="ir.ui.view">
        <field name="name">pb.sidebar.item.form.roles</field>
        <field name="model">pb.sidebar.item</field>
        <field name="inherit_id" ref="pb_sidebar.view_pb_sidebar_item_form"/>
        <field name="arch" type="xml">
            <field name="groups_id" position="after">
                <field name="role_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>

</odoo>