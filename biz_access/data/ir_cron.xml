<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- `numbercall` and `doall` were REMOVED from ir.cron in Odoo 19 —
         including either aborts the whole module load — and `nextcall` takes
         no eval expression in a data file, so the first run is simply the
         next tick after installation.

         THE JOB THAT TAKES SOMETHING AWAY. It is deliberately its own record
         and its own module: switching an application's own reminder mails off
         must never be able to switch off the thing that closes a security
         hole.

         IDEMPOTENT BY CONSTRUCTION, not by a stamp: it only ever finds rows in
         `active`, and the first thing it does is move the state. -->

    <record id="cron_access_auto_revert" model="ir.cron">
        <field name="name">Access: take back the hand-overs that have ended</field>
        <field name="model_id" ref="model_pb_access_delegation"/>
        <field name="state">code</field>
        <field name="code">env['pb.access.delegation'].cron_auto_revert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Leavers: close the login the day after the employee's departure date,
         open it again if that date is cleared (account_workers.py, point 3).
         Off by switch `biz_access.close_leavers` = '0'. -->
    <record id="cron_access_close_leavers" model="ir.cron">
        <field name="name">Access: close the logins of people who have left</field>
        <field name="model_id" ref="model_pb_access"/>
        <field name="state">code</field>
        <field name="code">env['pb.access'].cron_close_leavers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
