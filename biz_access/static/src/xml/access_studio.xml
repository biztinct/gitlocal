<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="biz_access.StudioExtension" t-inherit="biz_access.PbAccessBoard" t-inherit-mode="extension">
    <xpath expr="//div[contains(@class, 'pbva-head-id')]/h2" position="replace"><h2 t-if="!props.embedded" class="pbva-h">Access Studio</h2></xpath>
    <xpath expr="//p[@class='pbva-s']" position="replace"><p class="pbva-s">Profiles, roles and permissions — with a clear explanation for every person.</p></xpath>
    <xpath expr="//div[@class='pbva-bar']" position="before">
      <div class="pbva-studio-scope">
        <label>Workspace <select class="pbva-in" aria-label="Access workspace" t-model="state.workspace" t-on-change="setWorkspace" t-att-disabled="props.workspace">
          <option t-foreach="studio.workspaces" t-as="ws" t-key="ws.key" t-att-value="ws.key" t-esc="ws.label"/>
        </select></label>
        <span><strong t-esc="studio.company"/> · One catalogue, focused on this module</span>
        <button t-if="studio.central_owner" class="pbim-btn ghost" t-on-click="studioOwners">Module owners</button>
      </div>
      <p t-if="state.studioError" class="pbva-studio-error" role="alert" t-esc="state.studioError"/>
    </xpath>
    <xpath expr="//div[@class='pbva-chips']" position="replace"><p t-if="state.lens === 'roles'" class="pbva-hint">Showing roles owned by the selected workspace. Use the workspace selector to browse another module.</p></xpath>
    <xpath expr="//div[@class='pbva-bar']" position="after"><t t-call="biz_access.StudioPanels"/></xpath>
    <xpath expr="//div[contains(@class, 'pbva-role-body')]" position="inside">
      <button t-if="studioCanManage &amp;&amp; studio.resources.length" class="pbim-btn ghost pbva-studio-policy-link" t-on-click="() => this.studioOpenPolicy(pf)">Record &amp; field policy</button>
    </xpath>
    <xpath expr="//div[contains(@class, 'pbva-access')]" position="inside"><t t-call="biz_access.StudioDialog"/></xpath>
  </t>

  <t t-name="biz_access.StudioPanels">
    <section t-if="state.lens === 'studio_people'" class="pbva-studio-panel">
      <div class="pbva-studio-title"><div><h3>People &amp; assignments</h3><p>See who has access, how they received it, and when it should be reviewed.</p></div>
        <div class="pbva-studio-actions"><button t-if="studioCanManage" class="pbim-btn ghost" t-on-click="() => this.setLens('people')">People &amp; full menu passports</button><button class="pbim-btn ghost" t-on-click="() => this.studioRequestExtra()">Request access</button></div>
      </div>
      <div class="pbva-studio-toolbar">
        <input class="pbva-in" type="search" placeholder="Search people" aria-label="Search people in Access Studio" t-att-value="state.studioSearch" t-on-input="studioSearch"/>
        <select class="pbva-in" aria-label="People filter" t-model="state.studioPeopleFilter"><option value="module">Assigned in this module</option><option value="all">All company people</option><option value="due">Review due</option></select>
        <button t-if="studioCanManage" class="pbim-btn ghost" t-on-click="studioToggleAll">Select visible</button>
        <button t-if="studioCanManage" class="pbim-btn primary" t-att-disabled="!state.studioSelected.length" t-on-click="() => this.studioAssign()">Assign profile <t t-esc="state.studioSelected.length || ''"/></button>
      </div>
      <div class="pbva-studio-grid">
        <article t-foreach="studioPeople" t-as="person" t-key="person.id" class="pbva-studio-card">
          <div class="pbva-studio-cardhead"><input t-if="studioCanManage" type="checkbox" t-att-aria-label="'Select ' + person.name" t-att-checked="state.studioSelected.includes(person.id)" t-on-change="() => this.studioTogglePerson(person.id)"/>
            <img class="pbva-face" t-att-src="'/web/image/res.users/' + person.id + '/avatar_128'" alt=""/><div><h4 t-esc="person.name"/><small t-esc="person.login"/></div></div>
          <p t-if="!person.assignments.length" class="pbva-hint">No profile assigned in this module. Existing roles may still provide access.</p>
          <div t-foreach="person.assignments" t-as="assignment" t-key="assignment.id" class="pbva-studio-assignment"><strong t-esc="assignment.profile"/><span><t t-esc="assignment.origin === 'automatic' ? 'Department rule' : 'Owner assignment'"/> · <t t-esc="assignment.date_end ? 'Until ' + assignment.date_end : 'No expiry'"/></span><small t-att-class="assignment.due ? 'pbva-studio-warning' : ''">Review <t t-esc="assignment.review_date"/></small>
            <button t-if="studioCanManage" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('review', 'Review ' + assignment.profile, {...assignment, retain: true})">Review assignment</button></div>
          <div t-foreach="person.extras" t-as="extra" t-key="extra.id" class="pbva-studio-assignment"><strong t-esc="extra.role"/><small>Independent grant · until <t t-esc="extra.date_end"/></small><button t-if="studioCanManage" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('revoke_extra', 'Revoke temporary grant', extra)">Revoke grant</button></div>
          <div class="pbva-studio-actions"><button t-if="studio.resources.length" class="pbim-btn ghost" t-on-click="() => this.studioExplain(person)">Explain access</button><button t-if="studioCanManage" class="pbim-btn ghost" t-on-click="() => this.studioAssign(person)">Assign profile</button></div>
        </article>
      </div>
      <div t-if="!studioPeople.length" class="pbim-empty"><h3>No people match this view</h3><p>Choose “All company people” to make a first assignment, or adjust the search.</p></div>
      <p t-if="studio.people_more" class="pbva-hint">Showing up to 200 people. Search by name to find someone else.</p>
    </section>

    <section t-if="state.lens === 'packages'" class="pbva-studio-panel">
      <div class="pbva-studio-title"><div><h3>Profiles</h3><p>Reusable packages of roles. Editing a role updates every profile that references it.</p></div><button t-if="studioCanManage" class="pbim-btn primary" t-on-click="() => this.studioOpenProfile()">New profile</button></div>
      <div class="pbva-studio-toolbar"><input class="pbva-in" aria-label="Search profiles" placeholder="Search profiles" t-att-value="state.studioSearch" t-on-input="studioSearch"/><select class="pbva-in" aria-label="Profile status" t-model="state.studioStatus"><option value="active">Active profiles</option><option value="retired">Retired profiles</option><option value="all">All profiles</option></select></div>
      <div class="pbva-studio-grid"><article t-foreach="studioProfiles" t-as="profile" t-key="profile.id" class="pbva-studio-card">
        <div class="pbva-studio-cardhead"><h4 t-esc="profile.name"/><span class="pbva-badge" t-esc="profile.active ? 'Active' : 'Retired'"/></div><p t-esc="profile.description"/>
        <p><strong t-esc="profile.members"/> people · <strong t-esc="profile.role_ids.length"/> roles · Version <t t-esc="profile.revision"/></p>
        <div class="pbva-studio-tags"><span t-foreach="profile.roles" t-as="roleName" t-key="roleName" class="pbva-chip" t-esc="roleName"/></div>
        <p class="pbva-hint">Owner: <t t-esc="profile.owner"/> · Review <t t-esc="profile.review_date"/></p><p t-if="profile.auto_department">Automatic assignment: <t t-esc="profile.auto_department"/></p>
        <div class="pbva-studio-actions"><button t-if="studioCanManage &amp;&amp; profile.active" class="pbim-btn ghost" t-on-click="() => this.studioOpenProfile(profile)">Edit</button><button t-if="studioCanManage" class="pbim-btn ghost" t-on-click="() => this.studioOpenProfile(profile, true)">Clone</button><button class="pbim-btn ghost" t-on-click="() => this.studioCompare(profile)">Compare</button><button t-if="studioCanManage &amp;&amp; profile.active" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('retire', 'Retire profile', profile)">Retire</button></div>
      </article></div>
      <div t-if="!studioProfiles.length" class="pbim-empty"><h3>No profiles yet</h3><p>Create a named package from existing roles. People’s current assignments stay in place until a reviewed change is approved.</p></div>
    </section>

    <section t-if="state.lens === 'roles' &amp;&amp; studioCanManage" class="pbva-studio-info">Open a role to edit its abilities and menu preview. <t t-if="studio.resources.length">Choose <strong>Record &amp; field policy</strong> for record scopes, business actions and field permissions.</t><t t-else="">This workspace uses the application’s existing permission controls. Granular record and field policies are currently available in Hiring, People and Payroll.</t></section>
    <section t-if="state.lens === 'policy' &amp;&amp; state.studioPolicy" class="pbva-studio-panel">
      <div class="pbva-studio-title"><div><button class="pbim-btn ghost" t-on-click="() => this.setLens('roles')">← Roles &amp; permissions</button><h3 t-esc="state.studioPolicy.name"/><p>Policy version <t t-esc="state.studioPolicy.revision"/> · <t t-esc="state.studioPolicy.people.length"/> assigned people · <t t-esc="state.studioPolicy.profiles.length"/> profiles</p></div><button class="pbim-btn primary" t-on-click="studioReviewPolicy">Review &amp; submit</button></div>
      <div class="pbva-studio-info">These controls refine the role’s application permissions. Another independent grant may still provide wider access; use Explain access to see the combined result.</div>
      <div class="pbva-studio-toolbar"><label>Resource <select class="pbva-in" t-model="state.studioResource"><option t-foreach="studio.resources" t-as="resource" t-key="resource.key" t-att-value="resource.key" t-esc="resource.label"/></select></label><span t-if="studioCurrentResource" class="pbva-hint">Own = <t t-esc="studioCurrentResource.owner_label"/> · Team = you and your reporting hierarchy</span></div>
      <div t-if="!studioRule" class="pbim-empty"><h3>Uses the application’s existing permissions</h3><p>No additional policy has been set for this role and resource.</p><button class="pbim-btn primary" t-on-click="studioEnableResource">Add a policy</button></div>
      <t t-else="">
        <div class="pbva-studio-toolbar"><button t-foreach="[['permissions','Actions'],['rules','Record rules'],['fields','Form fields']]" t-as="policyTab" t-key="policyTab[0]" class="pbva-chip" t-att-class="state.studioPolicyTab === policyTab[0] ? 'is-on' : ''" t-on-click="() => state.studioPolicyTab = policyTab[0]" t-esc="policyTab[1]"/><button class="pbim-btn ghost" t-on-click="studioRemoveResource">Return to application defaults</button></div>
        <div t-if="state.studioPolicyTab === 'permissions'">
          <div class="pbva-studio-matrix"><label t-foreach="[['read','View'],['create','Create'],['write','Edit'],['unlink','Delete']]" t-as="operation" t-key="operation[0]"><strong t-esc="operation[1]"/><select class="pbva-in" t-att-aria-label="operation[1] + ' scope'" t-att-value="studioRule[operation[0]]" t-on-change="(ev) => studioRule[operation[0]] = ev.target.value"><option value="none" t-att-selected="studioRule[operation[0]] === 'none'">No access</option><option value="own" t-att-selected="studioRule[operation[0]] === 'own'">Own records</option><option value="team" t-att-selected="studioRule[operation[0]] === 'team'">Team records</option><option value="all" t-att-selected="studioRule[operation[0]] === 'all'">All allowed company records</option></select></label></div>
          <h4>Business actions</h4><div class="pbva-studio-checks"><label t-foreach="[['export','Export records'],['download','Download attachments'],['archive','Archive'],['reassign','Reassign owner'],['approve','Approve / finalise'],['reveal','Reveal masked fields with a reason']]" t-as="business" t-key="business[0]"><input type="checkbox" t-att-disabled="business[0] === 'archive' &amp;&amp; !studioCurrentResource.can_archive || business[0] === 'approve' &amp;&amp; !studioCurrentResource.can_approve" t-att-checked="studioRule[business[0]]" t-on-change="(ev) => studioRule[business[0]] = ev.target.checked"/><span t-esc="business[1]"/></label></div>
          <p class="pbva-hint">Application workflow and approval requirements still apply. Approvals require Edit permission to update the workflow state. The application still prevents approving your own work. Unavailable actions are disabled for this resource.</p>
        </div>
        <div t-if="state.studioPolicyTab === 'rules'">
          <div class="pbva-studio-info">Company isolation always applies. Record scope is combined with the conditions below.</div>
          <label>Match <select class="pbva-in" t-model="studioRule.match"><option value="all">All conditions (AND)</option><option value="any">Any condition (OR)</option></select></label>
          <fieldset t-if="studioCurrentResource.department"><legend>Departments</legend><p class="pbva-hint">Leave empty for all departments allowed by the application.</p><label t-foreach="studio.departments" t-as="department" t-key="department.id"><input type="checkbox" t-att-checked="studioRule.department_ids.includes(department.id)" t-on-change="() => this.studioPolicyList('department_ids', department.id)"/><t t-esc="department.name"/></label></fieldset>
          <fieldset t-if="studioCurrentResource.states.length"><legend>Visible workflow stages</legend><p class="pbva-hint">Leave empty for all stages.</p><label t-foreach="studioCurrentResource.states" t-as="stage" t-key="stage.key"><input type="checkbox" t-att-checked="studioRule.states.includes(stage.key)" t-on-change="() => this.studioPolicyList('states', stage.key)"/><t t-esc="stage.label"/></label></fieldset>
          <fieldset t-if="studioCurrentResource.states.length"><legend>Stages that may be edited or deleted</legend><p class="pbva-hint">Leave empty to use the application workflow limits.</p><label t-foreach="studioCurrentResource.states" t-as="stage" t-key="stage.key"><input type="checkbox" t-att-checked="studioRule.write_states.includes(stage.key)" t-on-change="() => this.studioPolicyList('write_states', stage.key)"/><t t-esc="stage.label"/></label></fieldset>
        </div>
        <div t-if="state.studioPolicyTab === 'fields'" class="pbva-studio-tablewrap"><table class="pbva-studio-table"><thead><tr><th>Field</th><th>Existing record</th><th>May supply on create</th></tr></thead><tbody><tr t-foreach="studioCurrentResource.fields" t-as="field" t-key="field.key"><td><strong t-esc="field.label"/><small t-if="field.required">Required</small><small t-if="field.sensitive">Sensitive</small></td><td><select class="pbva-in" t-att-aria-label="field.label + ' permission'" t-model="studioRule.fields[field.key]"><option t-if="!field.required" value="hidden">Hidden</option><option value="view">View only</option><option t-if="!field.readonly" value="edit">View &amp; edit</option><option t-if="field.sensitive &amp;&amp; !field.required" value="masked">Masked; reasoned reveal only</option></select></td><td><input type="checkbox" t-att-aria-label="'Supply ' + field.label + ' on create'" t-att-disabled="field.readonly || field.required" t-att-checked="studioRule.create_fields.includes(field.key)" t-on-change="() => this.studioPolicyList('create_fields', field.key)"/></td></tr></tbody></table><p class="pbva-hint">Hidden and masked values are protected on the server. Required fields remain available. Masked values can be revealed individually only when the business action permits it.</p></div>
      </t>
    </section>

    <section t-if="state.lens === 'reviews'" class="pbva-studio-panel">
      <div class="pbva-studio-title"><div><h3>Requests &amp; reviews</h3><p>Review the exact change before it takes effect. You cannot approve your own request.</p></div><button class="pbim-btn ghost" t-on-click="() => this.studioRequestExtra()">Request access</button></div>
      <div class="pbva-studio-toolbar"><button class="pbva-chip" t-att-class="state.studioReview === 'requests' ? 'is-on' : ''" t-on-click="() => state.studioReview = 'requests'">Requests</button><button class="pbva-chip" t-att-class="state.studioReview === 'periodic' ? 'is-on' : ''" t-on-click="() => state.studioReview = 'periodic'">Access reviews <t t-esc="studioDue.length"/></button><select t-if="state.studioReview === 'requests'" class="pbva-in" aria-label="Request status" t-model="state.studioRequestFilter"><option value="pending">Awaiting review</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="all">All requests</option></select></div>
      <t t-if="state.studioReview === 'requests'"><article t-foreach="studioRequests" t-as="request" t-key="request.id" class="pbva-studio-card pbva-studio-request"><div class="pbva-studio-cardhead"><h4 t-esc="request.name"/><span class="pbva-badge" t-esc="request.state"/></div><p>Requested by <strong t-esc="request.requester"/> · #<t t-esc="request.id"/></p><p t-esc="request.reason"/><p t-if="request.impact.people">People: <t t-esc="request.impact.people.join(', ') || 'No current assignments'"/></p><p t-if="request.impact.roles">Roles: <t t-esc="request.impact.roles.join(', ')"/></p><p t-if="request.impact.expires">Until <t t-esc="request.impact.expires"/></p><details><summary>Full change impact</summary><pre t-esc="studioJson(request.impact)"/></details><div class="pbva-studio-actions" t-if="studioCanManage &amp;&amp; request.state === 'pending'"><button class="pbim-btn primary" t-att-disabled="request.mine" t-on-click="() => this.studioConfirm('decide', 'Approve change', {...request, approve: true})">Approve</button><button class="pbim-btn ghost" t-att-disabled="request.mine" t-on-click="() => this.studioConfirm('decide', 'Reject change', {...request, approve: false})">Reject</button><small t-if="request.mine">Another access owner must decide this request.</small></div><p t-if="request.decision"><t t-esc="request.decider"/>: <t t-esc="request.decision"/></p></article><div t-if="!studioRequests.length" class="pbim-empty"><h3>No requests in this view</h3><p>Submitted changes will appear here for independent review.</p></div></t>
      <t t-else=""><article t-foreach="studioDue" t-as="review" t-key="review.id" class="pbva-studio-card pbva-studio-request"><h4 t-esc="review.user"/><p><t t-esc="review.profile"/> · Review due <t t-esc="review.review_date"/></p><button t-if="studioCanManage" class="pbim-btn primary" t-on-click="() => this.studioConfirm('review', 'Review access', {...review, retain: true})">Review assignment</button></article><div t-if="!studioDue.length" class="pbim-empty"><h3>No reviews due</h3><p>New profile assignments are reviewed after 90 days.</p></div></t>
    </section>

    <section t-if="state.lens === 'studio_history'" class="pbva-studio-panel"><div class="pbva-studio-title"><div><h3>History</h3><p>Published changes, decisions and reasoned reveals are retained.</p></div><button class="pbim-btn ghost" t-on-click="openHistory">Role &amp; delegation audit</button></div><article t-foreach="studio.history" t-as="event" t-key="event.id" class="pbva-studio-card pbva-studio-request"><h4 t-esc="event.name"/><small><t t-esc="event.actor"/> · <t t-esc="historyDate(event.date)"/></small><p t-esc="event.reason"/><details><summary>Details</summary><pre t-esc="studioJson(event.details)"/></details><button t-if="studioCanManage &amp;&amp; event.details.role_id &amp;&amp; event.details.after" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('restore', 'Review restoration', event)">Restore through review</button></article><div t-if="!studio.history.length" class="pbim-empty"><h3>No Studio changes yet</h3><p>Existing role and delegation history remains available above.</p></div></section>
  </t>
  <t t-name="biz_access.StudioDialog">
    <div t-if="state.studioDialog" class="pbva-studio-backdrop" t-on-click="closeStudio">
      <section class="pbva-studio-dialog" t-att-class="state.studioDialog.kind === 'explain' ? 'pbva-studio-drawer' : ''" role="dialog" aria-modal="true" t-att-aria-label="state.studioDialog.title" t-on-click.stop="() => {}">
        <t t-set="dialog" t-value="state.studioDialog"/><t t-set="form" t-value="dialog.form"/>
        <header><div><span class="pbva-hint" t-esc="studio.company"/><h3 t-esc="dialog.title"/></div><button class="pbim-btn ghost" aria-label="Close dialog" t-on-click="closeStudio">×</button></header>
        <div class="pbva-studio-dialogbody">
          <p t-if="dialog.error" class="pbva-studio-error" role="alert" t-esc="dialog.error"/>
          <t t-if="dialog.kind === 'profile'">
            <label>Profile name<input class="pbva-in" t-model="form.name" placeholder="For example, Recruiting team" required="required"/></label>
            <label>Purpose<textarea class="pbva-in" t-model="form.description" rows="2" placeholder="What is this profile for?"/></label>
            <div class="pbva-studio-matrix"><label>Profile owner<select class="pbva-in" t-model.number="form.owner_id"><option t-foreach="studio.people" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/></select></label><label>Next review<input class="pbva-in" type="date" t-model="form.review_date"/></label></div>
            <fieldset><legend>Roles in this profile</legend><p class="pbva-hint">Shared roles remain references. Their definitions are owned by their original module.</p><div class="pbva-studio-toolbar"><input class="pbva-in" aria-label="Search roles in picker" placeholder="Search roles" t-model="dialog.roleSearch"/><label><input type="checkbox" t-model="dialog.includeOtherModules"/> Include other modules</label></div><label t-foreach="studioPickerRoles" t-as="role" t-key="role.id"><input type="checkbox" t-att-disabled="!role.allowed" t-att-checked="form.role_ids.includes(role.id)" t-on-change="() => this.studioToggleRole(role.id)"/><span><t t-esc="role.name"/><small t-esc="role.workspace === state.workspace ? '' : 'Shared from ' + role.workspace"/></span></label></fieldset>
            <details><summary>Automatic department assignment</summary><label>Assign on join or department change<select class="pbva-in" t-model.number="form.auto_department_id"><option value="0">Manual assignment only</option><option t-foreach="studio.departments" t-as="department" t-key="department.id" t-att-value="department.id" t-esc="department.name"/></select></label><p class="pbva-hint">After approval, future employee joins and moves into this department receive the profile. Moving out removes automatic assignments and flags manual assignments for review. Archiving an employee removes Studio grants; account deactivation remains part of offboarding.</p></details>
          </t>
          <t t-if="dialog.kind === 'assign'"><p>Assign to <strong t-esc="studioNames(form.users)"/>.</p><label>Profile<select class="pbva-in" t-model.number="form.profile_id"><option t-foreach="studioAssignable" t-as="profile" t-key="profile.id" t-att-value="profile.id" t-esc="profile.name"/></select></label><label>Expiry (optional)<input class="pbva-in" type="date" t-model="form.date_end"/></label><p class="pbva-studio-info">An independent owner reviews this assignment. Existing roles, other profiles and temporary grants are preserved.</p></t>
          <t t-if="dialog.kind === 'extra'"><label>Person<select class="pbva-in" t-model.number="form.user_id"><option t-foreach="studio.people" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/></select></label><label>Temporary role<select class="pbva-in" t-model.number="form.role_id"><option t-foreach="studioRoles" t-as="role" t-key="role.id" t-att-value="role.id" t-esc="role.name"/></select></label><label>End date<input class="pbva-in" type="date" t-model="form.date_end" required="required"/></label><p class="pbva-hint">This is an independent grant. Removing a profile will not remove it. It ends after the selected day.</p></t>
          <t t-if="dialog.kind === 'policy'"><p><strong t-esc="form.name"/> · Policy version <t t-esc="form.revision"/></p><p><strong t-esc="form.people.length"/> assigned people: <t t-esc="form.people.join(', ') || 'None'"/></p><p>Referenced by: <t t-esc="form.profiles.join(', ') || 'No profiles yet'"/></p><div class="pbva-studio-info">Changes remain a draft until an independent owner approves. A later role change will require a fresh review.</div><details><summary>Submitted policy</summary><pre t-esc="studioJson(form.policy)"/></details></t>
          <t t-if="dialog.kind === 'decide'"><h4 t-esc="form.name"/><p t-esc="form.reason"/><p t-if="form.impact.people">People: <t t-esc="form.impact.people.join(', ')"/></p><details open="open"><summary>Reviewed impact</summary><pre t-esc="studioJson(form.impact)"/></details><p class="pbva-hint">Your identity, current authority, conflicts and the submitted version are checked again when you decide.</p></t>
          <t t-if="dialog.kind === 'review'"><p>Profile: <strong t-esc="form.profile"/></p><label>Decision<select class="pbva-in" t-model="form.retain"><option t-att-value="true">Retain and review in 90 days</option><option t-att-value="false">Remove this profile assignment</option></select></label><p class="pbva-hint">Removing this assignment preserves independent roles, other profiles and temporary grants.</p></t>
          <p t-if="dialog.kind === 'retire'">Retire <strong t-esc="form.name"/>? The profile must have no active assignments. Its history will remain available.</p>
          <p t-if="dialog.kind === 'revoke_extra'">Revoke <strong t-esc="form.role"/>? Only this independent temporary grant will be removed.</p>
          <p t-if="dialog.kind === 'restore'">Submit this historical policy as a new change. The current role and all affected people will be reviewed before it takes effect.</p>
          <t t-if="dialog.kind === 'owner'"><p>Module owners can assign only the roles selected below. They cannot manage another module or grant platform administration.</p><label>Owner<select class="pbva-in" t-att-value="form.user_id" t-on-change="studioOwnerSelect"><option t-foreach="studio.people" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/></select></label><label><input type="checkbox" t-model="form.active"/> Active module owner</label><fieldset><legend>Grant ceiling</legend><div class="pbva-studio-toolbar"><input class="pbva-in" aria-label="Search roles in picker" placeholder="Search roles" t-model="dialog.roleSearch"/><label><input type="checkbox" t-model="dialog.includeOtherModules"/> Include other modules</label></div><label t-foreach="studioPickerRoles" t-as="role" t-key="role.id"><input type="checkbox" t-att-checked="form.role_ids.includes(role.id)" t-on-change="() => this.studioToggleRole(role.id)"/><span t-esc="role.name"/></label></fieldset></t>
          <t t-if="dialog.kind === 'compare'"><h4 t-esc="form.profile.name"/><label>Compare with<select class="pbva-in" t-model.number="form.other_id"><option t-foreach="studio.profiles.filter(p => p.id !== form.profile.id)" t-as="profile" t-key="profile.id" t-att-value="profile.id" t-esc="profile.name"/></select></label><table class="pbva-studio-table"><thead><tr><th>Role</th><th>This profile</th><th>Other profile</th></tr></thead><tbody><tr t-foreach="studioComparison" t-as="row" t-key="row.id"><td t-esc="row.name"/><td t-esc="row.left ? 'Included' : '—'"/><td t-esc="row.right ? 'Included' : '—'"/></tr></tbody></table></t>
          <t t-if="dialog.kind === 'explain'">
            <h4 t-esc="form.user"/><p class="pbva-studio-info">Read-only preview. You remain signed in as yourself.</p>
            <label>Resource<select class="pbva-in" t-model="form.model"><option t-foreach="studio.resources" t-as="resource" t-key="resource.key" t-att-value="resource.key" t-esc="resource.label"/></select></label>
            <div class="pbva-studio-matrix"><label>Action<select class="pbva-in" t-model="form.action"><option value="read">View</option><option value="create">Create</option><option value="write">Edit</option><option value="unlink">Delete</option></select></label><label>Record ID (optional)<input class="pbva-in" type="number" min="1" t-model="form.record_id" placeholder="Check a specific record"/></label></div>
            <label>Field (optional)<select class="pbva-in" t-model="form.field_name"><option value="">Whole record</option><option t-foreach="studioFieldOptions()" t-as="field" t-key="field.key" t-att-value="field.key" t-esc="field.label"/></select></label>
            <label><input type="checkbox" t-model="form.without_profile"/> What if all profiles were removed?</label><button class="pbim-btn primary" t-on-click="studioRunExplain">Check access</button>
            <div t-if="dialog.result" class="pbva-studio-explanation"><h4 t-att-class="dialog.result.allowed ? 'pbva-studio-allowed' : 'pbva-studio-warning'" t-esc="dialog.result.allowed ? 'Allowed within matching record rules' : 'Not allowed by current access'"/><p>Company: <t t-esc="dialog.result.company"/></p><article t-foreach="dialog.result.sources" t-as="source" t-key="source.source + ':' + source.role_id" class="pbva-studio-assignment"><strong t-esc="source.name"/><span><t t-esc="source.source.startsWith('package:') ? 'From a profile' : source.source.startsWith('extra:') ? 'Independent temporary grant' : source.source.startsWith('loan:') ? 'Delegated' : 'Assigned or existing permission'"/> · <t t-esc="source.scope"/></span><small t-esc="source.matches ? 'Matches this check' : 'Does not match this check'"/><small t-if="source.field">Field: <t t-esc="source.field"/></small></article><p class="pbva-hint" t-esc="dialog.result.note"/></div>
            <button t-if="canManage" class="pbim-btn ghost" t-on-click="() => { this.seeAs({id: form.user_id, name: form.user}); this.closeStudio(); this.setLens('screens'); }">See their full menu</button>
            <button t-if="form.user_id === board.me.id &amp;&amp; form.record_id &amp;&amp; form.field_name" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('reveal', 'Reveal sensitive value', {...form})">Reveal with a reason</button>
          </t>
          <t t-if="dialog.kind === 'reveal'"><p>This reveals one value for your own signed-in account. Your reason is retained in the audit trail.</p><div t-if="dialog.result" class="pbva-studio-info"><strong t-esc="dialog.result.value"/><p>Audit receipt #<t t-esc="dialog.result.receipt"/></p></div></t>
          <label t-if="!['compare','explain'].includes(dialog.kind)">Reason<textarea class="pbva-in" rows="3" t-model="dialog.reason" placeholder="Explain why this change is needed" required="required"/></label>
        </div>
        <footer><button class="pbim-btn ghost" t-on-click="closeStudio" t-att-disabled="state.studioBusy">Close</button><button t-if="!['compare','explain'].includes(dialog.kind) &amp;&amp; !dialog.result" class="pbim-btn primary" t-att-disabled="state.studioBusy || !dialog.reason.trim()" t-on-click="studioSubmit"><t t-esc="state.studioBusy ? 'Saving…' : ['profile','assign','extra','policy','restore'].includes(dialog.kind) ? 'Submit for review' : 'Confirm'"/></button></footer>
      </section>
    </div>
  </t>
</templates>
