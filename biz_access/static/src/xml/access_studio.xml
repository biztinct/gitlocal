<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="biz_access.StudioExtension" t-inherit="biz_access.PbAccessBoard" t-inherit-mode="extension">
    <xpath expr="//div[contains(@class, 'pbva-head-id')]/h2" position="replace"><h2 t-if="!props.embedded" class="pbva-h">Access Studio</h2></xpath>
    <xpath expr="//p[@class='pbva-s']" position="replace"><p class="pbva-s"><t t-if="studioLocal">Manage access to the work in this menu. Shared definitions and administration live in Access Studio.</t><t t-else="">Profiles, roles and permissions — with a clear explanation for every person.</t></p></xpath>
    <xpath expr="//div[@class='pbva-bar']" position="before">
      <div class="pbva-studio-scope">
        <label t-if="!studioLocal">Access category <select class="pbva-in" aria-label="Access category" t-model="state.workspace" t-on-change="setWorkspace">
          <option t-foreach="studio.workspaces" t-as="ws" t-key="ws.key" t-att-value="ws.key" t-esc="ws.label"/>
        </select></label>
        <div t-else="" class="pbva-focus-areas" role="group" aria-label="Access for this work"><button t-foreach="studio.focuses || []" t-as="focus" t-key="focus.key" class="pbva-chip" t-att-class="{'is-on': focus.key === state.studioFocus}" t-att-aria-pressed="focus.key === state.studioFocus ? 'true' : 'false'" t-on-click="() => this.studioChooseFocus(focus)"><t t-esc="focus.label"/></button></div>
        <span><strong t-esc="studio.company"/><t t-if="!studioLocal"> · Shared access catalogue</t></span>
        <button t-if="studio.central_owner &amp;&amp; !studioLocal" class="pbim-btn ghost" t-on-click="studioOwners">Category owners</button>
        <button t-if="studioLocal" class="pbim-btn ghost" t-on-click="() => this.studioOpenCentral()">Open Access Studio</button>
      </div>
      <p t-if="studioLocal" class="pbva-hint"><t t-esc="studioFocus?.description"/> <span>Shared profiles retain their complete role list.</span> <button class="pbva-linkbtn" t-on-click="() => this.studioOpenCentral('reviews')">Requests &amp; reviews</button> · <button class="pbva-linkbtn" t-on-click="() => this.studioOpenCentral('studio_history')">History</button></p>
      <p t-if="state.studioError" class="pbva-studio-error" role="alert" t-esc="state.studioError"/>
    </xpath>
    <xpath expr="//div[@class='pbva-bar']/div[@class='pbva-chips']" position="replace"><p t-if="state.lens === 'roles' &amp;&amp; !studioCanManage &amp;&amp; !studioLocal" class="pbva-hint">Showing roles owned by the selected access category. Use the category selector to browse another area.</p></xpath>
    <xpath expr="//div[@class='pbva-bar']" position="after"><t t-call="biz_access.StudioPanels"/></xpath>
    <xpath expr="//div[@class='pbva-body' and @t-if=&quot;state.lens === 'roles'&quot;]" position="attributes"><attribute name="t-if">state.lens === 'roles' &amp;&amp; !studioCanManage &amp;&amp; !studioLocal</attribute></xpath>
    <xpath expr="//div[@class='pbva-bar']/label[contains(@class, 'pbva-field--search')]" position="attributes"><attribute name="t-if">state.lens === 'roles' &amp;&amp; !studioCanManage &amp;&amp; !studioLocal</attribute></xpath>
    <xpath expr="//button[@t-on-click=&quot;() => this.exportFile('roles')&quot;]" position="attributes"><attribute name="t-if">!studioLocal</attribute></xpath>
    <xpath expr="//button[@t-on-click='openRoleList']" position="replace"/>
    <xpath expr="//button[@data-coach='ac-newrole']" position="replace"/>
    <xpath expr="//button[@data-coach='ac-handover']" position="replace"/>
    <xpath expr="//button[@t-on-click='runRevert']" position="replace"/>
    <xpath expr="//button[@t-on-click=&quot;() => this.exportFile('history')&quot;]" position="replace"/>
    <xpath expr="//div[@class='pbva-comp-r']/p[@class='pbva-colhead']" position="replace"><p class="pbva-colhead">Menu preview · this role only</p><p class="pbva-hint">A read-only preview of this role’s contribution. People &amp; assignments shows each person’s combined access. Screens manages the shared menu.</p></xpath>
    <xpath expr="//div[contains(@class, 'pbva-access')]" position="inside"><t t-call="biz_access.StudioDialog"/></xpath>
    <xpath expr="//aside[@class='pbva-plist']" position="replace"><t t-call="biz_access.StudioPeopleList"/></xpath>
    <xpath expr="//div[@class='pbva-pass-actions']" position="inside">
      <button t-if="studioSelectedPerson &amp;&amp; studio.resources.length &amp;&amp; studioSelectedPerson.kind !== 'employee' &amp;&amp; studioSelectedPerson.in_company" class="pbim-btn ghost" t-on-click="() => this.studioExplain(studioSelectedPerson)">Explain access</button>
      <button t-if="studioCanAssignPerson" class="pbim-btn primary" t-on-click="() => this.studioAssign(studioSelectedPerson)">Assign profile</button>
      <button class="pbim-btn ghost" t-if="studioSelectedPerson?.kind !== 'employee' &amp;&amp; studioSelectedPerson?.in_company &amp;&amp; (studioCanManage || ph.is_me)" t-on-click="() => this.studioRequestExtra(studioSelectedPerson)">Request access</button>
    </xpath>
    <xpath expr="//div[@class='pbva-pass-actions']/button[@t-on-click='() => this.openPersonHistory(ph)']" position="attributes"><attribute name="t-if">!passport.restricted_preview &amp;&amp; !studioLocal</attribute></xpath>
    <xpath expr="//div[@class='pbva-pass-actions']/button[@t-on-click='() => this.openGiveRole(ph)']" position="attributes"><attribute name="class">pbim-btn ghost</attribute><attribute name="t-if">canManage &amp;&amp; !studioLocal</attribute></xpath>
    <xpath expr="//p[@class='pbva-pass-sees']" position="attributes"><attribute name="t-if">!passport.restricted_preview</attribute></xpath>
    <xpath expr="//span[@t-esc='rolesLine(ph)']" position="attributes"><attribute name="t-if">!passport.restricted_preview</attribute></xpath>
    <xpath expr="//div[@class='pbva-pass-roles']/p[@class='pbva-colhead']" position="before"><t t-call="biz_access.StudioPersonAssignments"/></xpath>
    <xpath expr="//div[@class='pbva-pass-roles']/p[@class='pbva-colhead']" position="attributes"><attribute name="t-if">!passport.restricted_preview</attribute></xpath>
    <xpath expr="//div[@class='pbva-pass-roles']/div[@t-elif='!passport.roles.length']" position="attributes"><attribute name="t-elif">!passport.roles.length &amp;&amp; !passport.restricted_preview</attribute></xpath>
    <xpath expr="//details[@class='pbva-pass-roles']" position="replace"/>
    <xpath expr="//div[@class='pbva-pass-roles']" position="inside"><details t-if="passport.equivalent_roles and passport.equivalent_roles.length" class="pbva-pass-roles"><summary>Equivalent permissions from other sources</summary><p class="pbva-col-note">These permissions already let them do the work. They are not assigned these roles and will not follow role edits automatically.</p><div t-foreach="passport.equivalent_roles" t-as="match" t-key="match.profile_id" class="pbva-verb"><span class="pbva-verb-tx"><b t-esc="match.name"/><small t-esc="match.description"/></span></div></details></xpath>
    <xpath expr="//div[@class='pbva-pass-rail']/PbMiniRail" position="before">
      <p class="pbva-hint">Read-only preview of this person's combined access. Expand a module to see the screens inside it.</p>
      <p t-if="passport.restricted_preview" class="pbva-studio-info">You can manage assignments in this workspace. A central access owner can inspect this person's full menu and account controls.</p>
    </xpath>
    <xpath expr="//div[@class='pbva-pass-rail']/p[@t-else]" position="replace"><p t-elif="!passport.restricted_preview" class="pbva-col-empty">There is no left menu written down on this system, so there is nothing to draw here yet.</p></xpath>
    <xpath expr="//div[@class='pbva-pass-rail']" position="inside">
      <button t-if="canManage &amp;&amp; passport.rail.length" class="pbim-btn ghost pbva-studio-menu-link" t-on-click="studioManageMenu">Manage screen visibility</button>
      <p t-if="canManage &amp;&amp; passport.rail.length" class="pbva-hint">Opens Screens to manage shared menu order and role gates.</p>
    </xpath>
  </t>

  <t t-name="biz_access.StudioPanels">
    <section t-if="state.lens === 'roles' &amp;&amp; studioLocal" class="pbva-studio-panel">
      <div class="pbva-studio-title"><div><h3>Roles for <t t-esc="studioFocus?.label"/></h3><p>These are shared roles. Their complete permissions are defined in Access Studio.</p></div></div>
      <input class="pbva-in" type="search" aria-label="Find a role" placeholder="Find a role" t-model="state.studioRoleSearch"/>
      <div class="pbva-studio-grid"><article t-foreach="studioRoleChoices" t-as="role" t-key="role.id" class="pbva-studio-card"><h4 t-esc="role.name"/><p t-esc="role.description"/><p class="pbva-hint">Access category: <t t-esc="studio.workspaces.find(w => w.key === role.workspace)?.label"/></p><button class="pbim-btn ghost" t-on-click="() => this.studioOpenCentral('roles', role)">View in Access Studio</button></article></div>
      <p t-if="!studioRoleChoices.length" class="pbva-hint">No roles match this area. Open Access Studio to browse the complete catalogue.</p>
    </section>
    <section t-if="state.lens === 'packages'" class="pbva-studio-panel">
      <div class="pbva-studio-title"><div><h3>Profiles</h3><p>Reusable packages of roles. Editing a role updates every profile that references it.</p></div><button t-if="studioCanManage &amp;&amp; !studioLocal" class="pbim-btn primary" t-on-click="() => this.studioOpenProfile()">New profile</button></div>
      <div class="pbva-studio-toolbar"><input class="pbva-in" aria-label="Search profiles" placeholder="Search profiles" t-model="state.studioProfileSearch"/><select class="pbva-in" aria-label="Profile status" t-model="state.studioStatus"><option value="active">Active profiles</option><option value="retired">Retired profiles</option><option value="all">All profiles</option></select></div>
      <div class="pbva-studio-grid"><article t-foreach="studioProfiles" t-as="profile" t-key="profile.id" class="pbva-studio-card">
        <div class="pbva-studio-cardhead"><h4 t-esc="profile.name"/><span class="pbva-badge" t-esc="profile.active ? 'Active' : 'Retired'"/></div><p t-esc="profile.description"/>
        <p><strong t-esc="profile.members"/> people · <strong t-esc="profile.role_ids.length"/> roles · Version <t t-esc="profile.revision"/></p>
        <div class="pbva-studio-tags"><span t-foreach="profile.roles" t-as="roleName" t-key="roleName" class="pbva-chip" t-esc="roleName"/></div>
        <p class="pbva-hint">Owner: <t t-esc="profile.owner"/> · Review <t t-esc="profile.review_date"/></p><p t-if="profile.auto_department">Automatic assignment: <t t-esc="profile.auto_department"/></p>
        <div class="pbva-studio-actions"><button t-if="studioCanManage &amp;&amp; profile.active &amp;&amp; !studioLocal" class="pbim-btn ghost" t-on-click="() => this.studioOpenProfile(profile)">Edit</button><button t-if="studioCanManage &amp;&amp; !studioLocal" class="pbim-btn ghost" t-on-click="() => this.studioOpenProfile(profile, true)">Clone</button><button t-if="studioLocal" class="pbim-btn ghost" t-on-click="() => this.studioOpenCentral('packages')">Manage in Access Studio</button><button class="pbim-btn ghost" t-on-click="() => this.studioCompare(profile)">Compare</button><button t-if="studioCanManage &amp;&amp; profile.active &amp;&amp; !studioLocal" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('retire', 'Retire profile', profile)">Retire</button></div>
      </article></div>
      <div t-if="!studioProfiles.length" class="pbim-empty"><h3>No profiles yet</h3><p>Create a named package from existing roles. People’s current assignments stay in place until a reviewed change is approved.</p></div>
    </section>

    <section t-if="state.lens === 'screens'" class="pbva-studio-info"><div class="pbva-studio-title"><div><strong>Screen administration · shared menu</strong><br/>Manage menu order, visibility and the roles that open each entry. Changes here affect the shared menu. To inspect a person’s combined access, open their passport under People &amp; assignments.</div><button t-if="state.studioMenuReturn" class="pbim-btn ghost" t-on-click="() => this.studioOpenPassport(state.studioMenuReturn)">Back to <t t-esc="state.studioMenuReturn.name"/>’s access</button></div></section>
    <section t-if="state.lens === 'handovers' &amp;&amp; canManage &amp;&amp; !studioLocal" class="pbva-studio-actions"><button class="pbim-btn ghost" t-on-click="runRevert">Take back expired access now</button></section>
    <section t-if="state.lens === 'roles' &amp;&amp; studioCanManage &amp;&amp; !studioLocal" class="pbva-studio-role-layout">
      <aside class="pbva-studio-role-list">
        <h3>Roles in this category</h3><input class="pbva-in" type="search" aria-label="Find a role" placeholder="Find a role" t-model="state.studioRoleSearch"/>
        <button t-foreach="studioRoleChoices" t-as="role" t-key="role.id" class="pbva-studio-role-choice" t-att-class="state.studioPolicy?.id === role.id ? 'is-on' : ''" t-on-click="() => this.studioOpenPolicy(role)"><strong t-esc="role.name"/><small>Policy version <t t-esc="role.revision"/></small></button>
        <p t-if="!studioRoleChoices.length" class="pbva-hint">No roles match this search.</p>
        <button t-if="canManage" class="pbim-btn ghost" t-on-click="() => this.openComposer(null)">+ New role</button>
      </aside>
      <section t-if="state.studioPolicy" class="pbva-studio-role-detail">
      <div class="pbva-studio-title"><div><h3 t-esc="state.studioPolicy.name"/><p t-esc="state.studioPolicy.description"/><p>Policy version <t t-esc="state.studioPolicy.revision"/> · <t t-esc="state.studioPolicy.people.length"/> assigned people · <t t-esc="state.studioPolicy.profiles.length"/> profiles</p></div><div class="pbva-studio-actions"><button t-if="canManage" class="pbim-btn ghost" t-on-click="() => this.openRoleEditor(state.studioPolicy.id)">Abilities &amp; menu preview</button><button t-if="studio.resources.length" class="pbim-btn primary" t-on-click="studioReviewPolicy">Review &amp; submit</button></div></div>
      <p class="pbva-hint">Profiles package roles. This page defines what a role permits. “All allowed records” still follows the application’s company and record rules.</p>
      <div t-if="!studio.resources.length" class="pbva-studio-info">This category uses the application’s existing permission controls. Use Abilities &amp; menu preview to review them.</div>
      <div t-if="studio.resources.length" class="pbva-studio-toolbar"><button t-foreach="[['permissions','Actions &amp; records'],['rules','Record rules'],['fields','Form fields']]" t-as="policyTab" t-key="policyTab[0]" class="pbva-chip" t-att-class="state.studioPolicyTab === policyTab[0] ? 'is-on' : ''" t-on-click="() => state.studioPolicyTab = policyTab[0]" t-esc="policyTab[1]"/></div>
      <t t-if="state.studioPolicyTab === 'permissions' &amp;&amp; studio.resources.length">
        <input class="pbva-in" type="search" aria-label="Find a resource" placeholder="Find a resource" t-model="state.studioResourceSearch"/>
        <div class="pbva-studio-tablewrap"><table class="pbva-studio-table pbva-studio-permissions"><thead><tr><th>Resource</th><th>View</th><th>Create</th><th>Edit</th><th>Delete</th><th>Details</th></tr></thead><tbody>
          <tr t-foreach="studioResourceChoices" t-as="resource" t-key="resource.key"><td><strong t-esc="resource.label"/><small t-esc="state.studioPolicy.policy[resource.key] ? 'Explicit policy' : 'Application defaults'"/></td><td t-foreach="[['read','View'],['create','Create'],['write','Edit'],['unlink','Delete']]" t-as="op" t-key="op[0]"><select class="pbva-in" t-att-aria-label="resource.label + ' ' + op[1] + ' scope'" t-on-change="ev => this.studioSetScope(resource, op[0], ev.target.value)"><option value="" disabled="disabled" t-att-selected="!studioPolicyCell(resource, op[0])">Application</option><option t-foreach="[['none','None'],['own','Own'],['team','Team'],['all','All allowed']]" t-as="scope" t-key="scope[0]" t-att-value="scope[0]" t-att-selected="studioPolicyCell(resource, op[0]) === scope[0]" t-esc="scope[1]"/></select></td><td><button class="pbva-linkbtn" t-on-click="() => this.studioSelectResource(resource, 'rules')">Rules</button><button class="pbva-linkbtn" t-on-click="() => this.studioSelectResource(resource, 'fields')">Fields</button></td></tr>
        </tbody></table></div><p class="pbva-hint">Own: the resource’s assigned owner. Team: you and your reporting hierarchy. Application: existing permissions, with no extra Studio restriction. Changes take effect after review.</p>
      </t>
      <t t-if="studio.resources.length &amp;&amp; state.studioPolicyTab !== 'permissions'">
      <div class="pbva-studio-toolbar"><label>Resource <select class="pbva-in" t-model="state.studioResource"><option t-foreach="studio.resources" t-as="resource" t-key="resource.key" t-att-value="resource.key" t-esc="resource.label"/></select></label><span t-if="studioCurrentResource" class="pbva-hint">Own = <t t-esc="studioCurrentResource.owner_label"/> · Team = you and your reporting hierarchy</span></div>
      <div t-if="!studioRule" class="pbim-empty"><h3>Uses the application’s existing permissions</h3><p>No additional policy has been set for this role and resource.</p><button class="pbim-btn primary" t-on-click="studioEnableResource">Add a policy</button></div>
      <t t-else="">
        <div class="pbva-studio-toolbar"><button class="pbim-btn ghost" t-on-click="studioRemoveResource">Return this resource to application defaults</button></div>
        <div t-if="state.studioPolicyTab === 'rules'">
          <h4>Business actions</h4><div class="pbva-studio-checks"><label t-foreach="[['export','Export records'],['download','Download attachments'],['archive','Archive'],['reassign','Reassign owner'],['approve','Approve / finalise'],['reveal','Reveal masked fields with a reason']]" t-as="business" t-key="business[0]"><input type="checkbox" t-att-disabled="business[0] === 'archive' &amp;&amp; !studioCurrentResource.can_archive || business[0] === 'approve' &amp;&amp; !studioCurrentResource.can_approve" t-att-checked="studioRule[business[0]]" t-on-change="(ev) => studioRule[business[0]] = ev.target.checked"/><span t-esc="business[1]"/></label></div>
          <p class="pbva-hint">Application workflow and approval requirements still apply. Approvals require Edit permission to update the workflow state. The application still prevents approving your own work. Unavailable actions are disabled for this resource.</p>
        </div>
        <div t-if="state.studioPolicyTab === 'rules'">
          <div class="pbva-studio-info">Company isolation always applies. Record scope is combined with the conditions below.</div>
          <label>Match <select class="pbva-in" t-model="studioRule.match"><option value="all">All conditions (AND)</option><option value="any">Any condition (OR)</option></select></label>
          <fieldset t-if="studioCurrentResource.department"><legend>Departments</legend><p class="pbva-hint">Leave empty for all departments allowed by the application.</p><label t-foreach="studio.departments" t-as="department" t-key="department.id"><input type="checkbox" t-att-checked="studioRule.department_ids.includes(department.id)" t-on-change="() => this.studioPolicyList('department_ids', department.id)"/><t t-esc="department.name"/></label></fieldset>
          <fieldset t-if="studioCurrentResource.states.length"><legend>Visible workflow stages</legend><p class="pbva-hint">Leave empty for all stages.</p><label t-foreach="studioCurrentResource.states" t-as="stage" t-key="stage.key"><input type="checkbox" t-att-checked="studioRule.states.includes(stage.key)" t-on-change="() => this.studioPolicyList('states', stage.key)"/><t t-esc="stage.label"/></label></fieldset>
          <fieldset t-if="studioCurrentResource.states.length"><legend>Stages that may be edited or deleted</legend><p class="pbva-hint">Leave empty to use the application workflow limits.</p><label t-foreach="studioCurrentResource.states" t-as="stage" t-key="stage.key"><input type="checkbox" t-att-checked="studioRule.write_states.includes(stage.key)" t-on-change="() => this.studioPolicyList('write_states', stage.key)"/><t t-esc="stage.label"/></label></fieldset>
        </div>
        <div t-if="state.studioPolicyTab === 'fields'" class="pbva-studio-tablewrap"><table class="pbva-studio-table"><thead><tr><th>Field</th><th>Existing record</th><th>May supply on create</th></tr></thead><tbody><tr t-foreach="studioCurrentResource.fields" t-as="field" t-key="field.key"><td><strong t-esc="field.label"/><small t-if="field.required">Required</small><small t-if="field.sensitive">Sensitive</small></td><td><select class="pbva-in" t-att-aria-label="field.label + ' permission'" t-on-change="ev => studioRule.fields[field.key] = ev.target.value"><option t-if="!field.required" value="hidden" t-att-selected="studioRule.fields[field.key] === 'hidden'">Hidden</option><option value="view" t-att-selected="studioRule.fields[field.key] === 'view'">View only</option><option t-if="!field.readonly" value="edit" t-att-selected="studioRule.fields[field.key] === 'edit'">View &amp; edit</option><option t-if="field.sensitive &amp;&amp; !field.required" value="masked" t-att-selected="studioRule.fields[field.key] === 'masked'">Masked; reasoned reveal only</option></select></td><td><input type="checkbox" t-att-aria-label="'Supply ' + field.label + ' on create'" t-att-disabled="field.readonly || field.required" t-att-checked="studioRule.create_fields.includes(field.key)" t-on-change="() => this.studioPolicyList('create_fields', field.key)"/></td></tr></tbody></table><p class="pbva-hint">Hidden and masked values are protected on the server. Required fields remain available. Masked values can be revealed individually only when the business action permits it.</p></div>
      </t>
      </t>
      </section><div t-else="" class="pbim-empty"><h3>Choose a role</h3><p>Review its actions, record rules and form fields in one place.</p></div>
    </section>

    <section t-if="state.lens === 'reviews'" class="pbva-studio-panel">
      <div class="pbva-studio-title"><div><h3>Requests &amp; reviews</h3><p>Review the exact change before it takes effect. You cannot approve your own request.</p></div><button class="pbim-btn ghost" t-on-click="() => this.studioRequestExtra()">Request access</button></div>
      <div class="pbva-studio-toolbar"><button class="pbva-chip" t-att-class="state.studioReview === 'requests' ? 'is-on' : ''" t-on-click="() => state.studioReview = 'requests'">Requests</button><button class="pbva-chip" t-att-class="state.studioReview === 'periodic' ? 'is-on' : ''" t-on-click="() => state.studioReview = 'periodic'">Access reviews <t t-esc="studioDue.length"/></button><select t-if="state.studioReview === 'requests'" class="pbva-in" aria-label="Request status" t-model="state.studioRequestFilter"><option value="pending">Awaiting review</option><option value="approved">Approved</option><option value="rejected">Rejected</option><option value="all">All requests</option></select></div>
      <t t-if="state.studioReview === 'requests'"><article t-foreach="studioRequests" t-as="request" t-key="request.id" class="pbva-studio-card pbva-studio-request"><div class="pbva-studio-cardhead"><h4 t-esc="request.name"/><span class="pbva-badge" t-esc="request.state"/></div><p>Requested by <strong t-esc="request.requester"/> · #<t t-esc="request.id"/></p><p t-esc="request.reason"/><p t-if="request.impact.people">People: <t t-esc="request.impact.people.join(', ') || 'No current assignments'"/></p><p t-if="request.impact.roles">Roles: <t t-esc="request.impact.roles.join(', ')"/></p><p t-if="request.impact.expires">Until <t t-esc="request.impact.expires"/></p><details><summary>Full change impact</summary><pre t-esc="studioJson(request.impact)"/></details><div class="pbva-studio-actions" t-if="studioCanManage &amp;&amp; request.state === 'pending'"><button class="pbim-btn primary" t-att-disabled="request.mine" t-on-click="() => this.studioConfirm('decide', 'Approve change', {...request, approve: true})">Approve</button><button class="pbim-btn ghost" t-att-disabled="request.mine" t-on-click="() => this.studioConfirm('decide', 'Reject change', {...request, approve: false})">Reject</button><small t-if="request.mine">Another access owner must decide this request.</small></div><p t-if="request.decision"><t t-esc="request.decider"/>: <t t-esc="request.decision"/></p></article><div t-if="!studioRequests.length" class="pbim-empty"><h3>No requests in this view</h3><p>Submitted changes will appear here for independent review.</p></div></t>
      <t t-else=""><article t-foreach="studioDue" t-as="review" t-key="review.id" class="pbva-studio-card pbva-studio-request"><h4 t-esc="review.user"/><p><t t-esc="review.profile"/> · Review due <t t-esc="review.review_date"/></p><button t-if="studioCanManage" class="pbim-btn primary" t-on-click="() => this.studioConfirm('review', 'Review access', {...review, retain: true})">Review assignment</button></article><div t-if="!studioDue.length" class="pbim-empty"><h3>No reviews due</h3><p>New profile assignments are reviewed after 90 days.</p></div></t>
    </section>

    <section t-if="state.lens === 'studio_history'" class="pbva-studio-panel"><div class="pbva-studio-title"><div><h3>History</h3><p>Published changes, decisions and reasoned reveals are retained.</p></div><div class="pbva-studio-actions"><button class="pbim-btn ghost" t-on-click="openHistory">Role &amp; delegation audit</button><button t-if="canManage" class="pbim-btn ghost" t-on-click="() => this.exportFile('history')">Export audit</button></div></div><article t-foreach="studio.history" t-as="event" t-key="event.id" class="pbva-studio-card pbva-studio-request"><h4 t-esc="event.name"/><small><t t-esc="event.actor"/> · <t t-esc="historyDate(event.date)"/></small><p t-esc="event.reason"/><details><summary>Details</summary><pre t-esc="studioJson(event.details)"/></details><button t-if="studioCanManage &amp;&amp; event.details.role_id &amp;&amp; event.details.after" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('restore', 'Review restoration', event)">Restore through review</button></article><div t-if="!studio.history.length" class="pbim-empty"><h3>No Studio changes yet</h3><p>Existing role and delegation history remains available above.</p></div></section>
  </t>
  <t t-name="biz_access.StudioDialog">
    <div t-if="state.studioDialog" class="pbva-studio-backdrop" t-on-click="closeStudio">
      <section class="pbva-studio-dialog" t-att-class="state.studioDialog.kind === 'explain' ? 'pbva-studio-drawer' : ''" role="dialog" aria-modal="true" t-att-aria-label="state.studioDialog.title" t-on-click.stop="() => {}">
        <t t-set="dialog" t-value="state.studioDialog"/><t t-set="form" t-value="dialog.form"/>
        <header><div><span class="pbva-hint" t-esc="studio.company"/><h3 t-esc="dialog.title"/></div><button class="pbim-btn ghost" aria-label="Close dialog" t-on-click="closeStudio">×</button></header>
        <div class="pbva-studio-dialogbody">
          <p t-if="dialog.error" class="pbva-studio-error" role="alert" t-esc="dialog.error"/>
          <t t-if="dialog.kind === 'profile'">
            <label>Profile name<input class="pbva-in" t-model="form.name" placeholder="For example, Recruiting team" required="required"/></label>
            <label>Purpose<textarea class="pbva-in" t-model="form.description" rows="2" placeholder="What is this profile for?"/></label>
            <div class="pbva-studio-matrix"><label>Profile owner<select class="pbva-in" t-model.number="form.owner_id"><option t-foreach="studioOwnerPeople" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/></select></label><label>Next review<input class="pbva-in" type="date" t-model="form.review_date"/></label></div>
            <fieldset><legend>Roles in this profile</legend><p class="pbva-hint">Shared roles remain references. Their definitions are owned by their original module.</p><div class="pbva-studio-toolbar"><input class="pbva-in" aria-label="Search roles in picker" placeholder="Search roles" t-model="dialog.roleSearch"/><label><input type="checkbox" t-model="dialog.includeOtherModules"/> Include other modules</label></div><label t-foreach="studioPickerRoles" t-as="role" t-key="role.id"><input type="checkbox" t-att-disabled="!role.allowed" t-att-checked="form.role_ids.includes(role.id)" t-on-change="() => this.studioToggleRole(role.id)"/><span><t t-esc="role.name"/><small t-esc="role.workspace === state.workspace ? '' : 'Shared from ' + role.workspace"/></span></label></fieldset>
            <details><summary>Automatic department assignment</summary><label>Assign on join or department change<select class="pbva-in" t-model.number="form.auto_department_id"><option value="0">Manual assignment only</option><option t-foreach="studio.departments" t-as="department" t-key="department.id" t-att-value="department.id" t-esc="department.name"/></select></label><p class="pbva-hint">After approval, future employee joins and moves into this department receive the profile. Moving out removes automatic assignments and flags manual assignments for review. Archiving an employee removes Studio grants; account deactivation remains part of offboarding.</p></details>
          </t>
          <t t-if="dialog.kind === 'assign'"><p>Assign to <strong t-esc="studioNames(form.users)"/>.</p><label>Profile<select class="pbva-in" t-model.number="form.profile_id"><option t-foreach="studioAssignable" t-as="profile" t-key="profile.id" t-att-value="profile.id" t-esc="profile.name"/></select></label><p><strong>This profile grants all of these roles:</strong> <t t-esc="studioAssignable.find(p => p.id === form.profile_id)?.roles.join(', ')"/></p><label>Expiry (optional)<input class="pbva-in" type="date" t-model="form.date_end"/></label><p class="pbva-studio-info">An independent owner reviews this assignment. Existing roles, other profiles and temporary grants are preserved.</p></t>
          <t t-if="dialog.kind === 'extra'"><label>Person<select class="pbva-in" t-model.number="form.user_id"><option t-foreach="studioRequestPeople" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/></select></label><label>Temporary role<select class="pbva-in" t-model.number="form.role_id"><option t-foreach="studioRoles" t-as="role" t-key="role.id" t-att-value="role.id" t-esc="role.name"/></select></label><label>End date<input class="pbva-in" type="date" t-model="form.date_end" required="required"/></label><p class="pbva-hint">This is an independent grant. Removing a profile will not remove it. It ends after the selected day.</p></t>
          <t t-if="dialog.kind === 'policy'"><p><strong t-esc="form.name"/> · Policy version <t t-esc="form.revision"/></p><p><strong t-esc="form.people.length"/> assigned people: <t t-esc="form.people.join(', ') || 'None'"/></p><p>Referenced by: <t t-esc="form.profiles.join(', ') || 'No profiles yet'"/></p><div class="pbva-studio-info">Changes remain a draft until an independent owner approves. A later role change will require a fresh review.</div><details><summary>Submitted policy</summary><pre t-esc="studioJson(form.policy)"/></details></t>
          <t t-if="dialog.kind === 'decide'"><h4 t-esc="form.name"/><p t-esc="form.reason"/><p t-if="form.impact.people">People: <t t-esc="form.impact.people.join(', ')"/></p><details open="open"><summary>Reviewed impact</summary><pre t-esc="studioJson(form.impact)"/></details><p class="pbva-hint">Your identity, current authority, conflicts and the submitted version are checked again when you decide.</p></t>
          <t t-if="dialog.kind === 'review'"><p>Profile: <strong t-esc="form.profile"/></p><label>Decision<select class="pbva-in" t-model="form.retain"><option t-att-value="true">Retain and review in 90 days</option><option t-att-value="false">Remove this profile assignment</option></select></label><p class="pbva-hint">Removing this assignment preserves independent roles, other profiles and temporary grants.</p></t>
          <p t-if="dialog.kind === 'retire'">Retire <strong t-esc="form.name"/>? The profile must have no active assignments. Its history will remain available.</p>
          <p t-if="dialog.kind === 'revoke_extra'">Revoke <strong t-esc="form.role"/>? Only this independent temporary grant will be removed.</p>
          <p t-if="dialog.kind === 'restore'">Submit this historical policy as a new change. The current role and all affected people will be reviewed before it takes effect.</p>
          <t t-if="dialog.kind === 'owner'"><p>Module owners can assign only the roles selected below. They cannot manage another module or grant platform administration.</p><label>Owner<select class="pbva-in" t-att-value="form.user_id" t-on-change="studioOwnerSelect"><option t-foreach="studioOwnerPeople" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/></select></label><label><input type="checkbox" t-model="form.active"/> Active module owner</label><fieldset><legend>Grant ceiling</legend><div class="pbva-studio-toolbar"><input class="pbva-in" aria-label="Search roles in picker" placeholder="Search roles" t-model="dialog.roleSearch"/><label><input type="checkbox" t-model="dialog.includeOtherModules"/> Include other modules</label></div><label t-foreach="studioPickerRoles" t-as="role" t-key="role.id"><input type="checkbox" t-att-checked="form.role_ids.includes(role.id)" t-on-change="() => this.studioToggleRole(role.id)"/><span t-esc="role.name"/></label></fieldset></t>
          <t t-if="dialog.kind === 'compare'"><h4 t-esc="form.profile.name"/><label>Compare with<select class="pbva-in" t-model.number="form.other_id"><option t-foreach="studio.profiles.filter(p => p.id !== form.profile.id)" t-as="profile" t-key="profile.id" t-att-value="profile.id" t-esc="profile.name"/></select></label><table class="pbva-studio-table"><thead><tr><th>Role</th><th>This profile</th><th>Other profile</th></tr></thead><tbody><tr t-foreach="studioComparison" t-as="row" t-key="row.id"><td t-esc="row.name"/><td t-esc="row.left ? 'Included' : '—'"/><td t-esc="row.right ? 'Included' : '—'"/></tr></tbody></table></t>
          <t t-if="dialog.kind === 'explain'">
            <h4 t-esc="form.user"/><p class="pbva-studio-info">Read-only preview. You remain signed in as yourself.</p>
            <label>Resource<select class="pbva-in" t-model="form.model"><option t-foreach="studio.resources" t-as="resource" t-key="resource.key" t-att-value="resource.key" t-esc="resource.label"/></select></label>
            <div class="pbva-studio-matrix"><label>Action<select class="pbva-in" t-model="form.action"><option value="read">View</option><option value="create">Create</option><option value="write">Edit</option><option value="unlink">Delete</option></select></label><label>Record ID (optional)<input class="pbva-in" type="number" min="1" t-model="form.record_id" placeholder="Check a specific record"/></label></div>
            <label>Field (optional)<select class="pbva-in" t-model="form.field_name"><option value="">Whole record</option><option t-foreach="studioFieldOptions()" t-as="field" t-key="field.key" t-att-value="field.key" t-esc="field.label"/></select></label>
            <label><input type="checkbox" t-model="form.without_profile"/> What if all profiles were removed?</label><button class="pbim-btn primary" t-on-click="studioRunExplain">Check access</button>
            <div t-if="dialog.result" class="pbva-studio-explanation"><h4 t-att-class="dialog.result.allowed ? 'pbva-studio-allowed' : 'pbva-studio-warning'" t-esc="dialog.result.allowed ? 'Allowed within matching record rules' : 'Not allowed by current access'"/><p>Company: <t t-esc="dialog.result.company"/></p><article t-foreach="dialog.result.sources" t-as="source" t-key="source.source + ':' + source.role_id" class="pbva-studio-assignment"><strong t-esc="source.name"/><span><t t-esc="source.source.startsWith('package:') ? 'From a profile' : source.source.startsWith('extra:') ? 'Independent temporary grant' : source.source.startsWith('loan:') ? 'Delegated' : 'Assigned or existing permission'"/> · <t t-esc="source.scope"/></span><small t-esc="source.matches ? 'Matches this check' : 'Does not match this check'"/><small t-if="source.field">Field: <t t-esc="source.field"/></small></article><p class="pbva-hint" t-esc="dialog.result.note"/></div>
            <button t-if="canManage || form.user_id === board.me.id" class="pbim-btn ghost" t-on-click="() => this.studioOpenPassport({id: form.user_id, name: form.user})">See their full menu</button>
            <button t-if="form.user_id === board.me.id &amp;&amp; form.record_id &amp;&amp; form.field_name" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('reveal', 'Reveal sensitive value', {...form})">Reveal with a reason</button>
          </t>
          <t t-if="dialog.kind === 'reveal'"><p>This reveals one value for your own signed-in account. Your reason is retained in the audit trail.</p><div t-if="dialog.result" class="pbva-studio-info"><strong t-esc="dialog.result.value"/><p>Audit receipt #<t t-esc="dialog.result.receipt"/></p></div></t>
          <label t-if="!['compare','explain'].includes(dialog.kind)">Reason<textarea class="pbva-in" rows="3" t-model="dialog.reason" placeholder="Explain why this change is needed" required="required"/></label>
        </div>
        <footer><button class="pbim-btn ghost" t-on-click="closeStudio" t-att-disabled="state.studioBusy">Close</button><button t-if="!['compare','explain'].includes(dialog.kind) &amp;&amp; !dialog.result" class="pbim-btn primary" t-att-disabled="state.studioBusy || !dialog.reason.trim()" t-on-click="studioSubmit"><t t-esc="state.studioBusy ? 'Saving…' : ['profile','assign','extra','policy','restore'].includes(dialog.kind) ? 'Submit for review' : 'Confirm'"/></button></footer>
      </section>
    </div>
  </t>

  <t t-name="biz_access.StudioPeopleList">
    <aside class="pbva-plist pbva-studio-directory">
      <div class="pbva-plist-head"><div><b>People &amp; assignments</b><small>Choose a person to see their access and profiles.</small></div>
        <div t-if="canManage &amp;&amp; !studioLocal" class="pbva-plist-acts">
          <button class="pbim-btn ghost pbim-btn-sm" t-on-click="openWorkers" title="Logins for people with no email, signing in with their employee code"><t t-out="ic('users',14)"/> Logins for workers</button>
          <button class="pbim-btn ghost pbim-btn-sm" t-on-click="openAddPerson"><t t-out="ic('plus',14)"/> Add a person</button>
        </div>
      </div>
      <label class="pbva-field pbva-plist-search"><input class="pbva-in" type="search" placeholder="Search name or login" aria-label="Search people in Access Studio" t-att-value="state.studioSearch" t-on-input="studioSearch"/></label>
      <select class="pbva-in" aria-label="People filter" t-att-value="state.studioPeopleFilter" t-on-change="studioFilterPeople">
        <option value="module">Assigned in this area</option><option value="all">All company people</option><option value="due">Review due</option><option t-if="canManage &amp;&amp; !studioLocal" value="directory">All companies · full directory</option>
      </select>
      <div t-if="studioCanManage &amp;&amp; state.studioPeopleFilter !== 'directory'" class="pbva-studio-bulk">
        <button class="pbva-linkbtn" t-on-click="studioToggleAll">Select visible</button>
        <button class="pbim-btn primary pbim-btn-sm" t-att-disabled="!state.studioSelected.length" t-on-click="() => this.studioAssign()">Assign profile <t t-esc="state.studioSelected.length || ''"/></button>
        <small t-if="state.studioSelected.length"><t t-esc="state.studioSelected.length"/> selected · up to 100 at once</small>
      </div>
      <div class="pbva-prows">
        <div t-foreach="studioPeople" t-as="person" t-key="person.id" class="pbva-studio-personrow">
          <input t-if="studioCanManage &amp;&amp; state.studioPeopleFilter !== 'directory' &amp;&amp; person.kind !== 'employee'" type="checkbox" t-att-aria-label="'Select ' + person.name" t-att-checked="state.studioSelected.includes(person.id)" t-on-change="() => this.studioTogglePerson(person.id)"/>
          <button t-attf-class="pbva-personrow {{ state.personId === person.id ? 'is-on' : '' }}" t-att-aria-pressed="state.personId === person.id ? 'true' : 'false'" t-on-click="() => this.loadPassport(person.id)">
            <img class="pbva-face" t-att-src="person.avatar" alt=""/>
            <span class="pbva-personrow-tx"><b><t t-esc="person.name"/> <span t-if="person.is_me" class="pbva-badge pbva-badge--mine">You</span></b><small t-esc="person.login"/></span>
            <span t-if="person.kind === 'employee'" class="pbva-badge pbva-badge--quiet">Employee</span>
            <span t-elif="person.assignments?.length" class="pbva-personrow-n"><t t-esc="person.assignments.length"/> profiles</span>
          </button>
        </div>
      </div>
      <p t-if="!studioPeople.length" class="pbva-hint">No people match. Try another filter or search.</p>
      <p t-if="studio.people_more" class="pbva-hint">Showing up to 200 people. Search by name or login to find someone else.</p>
      <p t-if="studioSelectedPerson &amp;&amp; !studioPeople.some(p => p.id === state.personId)" class="pbva-hint">The open passport is outside this list's filter. Your selection is kept.</p>
      <button t-if="!studioSelectedPerson" class="pbim-btn ghost" t-on-click="() => this.studioRequestExtra()">Request access</button>
      <label t-if="canManage &amp;&amp; !studioLocal &amp;&amp; state.leavers" class="pbva-leavers">
        <input type="checkbox" t-att-checked="state.leavers.on" t-on-change="toggleLeavers"/>
        <span>
          <b>Close leavers' logins</b>
          <small>The day after the last day on their employee record. Opened again if that date is cleared.</small>
        </span>
      </label>
    </aside>
  </t>
  <t t-name="biz_access.StudioPersonAssignments">
    <section t-if="studioSelectedPerson" class="pbva-studio-person-assignments" aria-label="Profile assignments">
      <p class="pbva-colhead"><t t-out="ic('layers',13)"/> Profiles · <t t-esc="studioLocal ? studioFocus?.label : studio.workspaces.find(w => w.key === state.workspace)?.label"/></p>
      <p t-if="!studioSelectedPerson.in_company" class="pbva-hint">Switch to this person's company to manage their profile assignments.</p>
      <p t-elif="studioSelectedPerson.kind === 'employee'" class="pbva-hint">Employee logins use self-service access. Staff profiles cannot be assigned to this account type.</p>
      <p t-elif="!studioSelectedPerson.assignments.length" class="pbva-hint">No profile assigned in this area. Existing roles and direct permissions may still provide access.</p>
      <article t-foreach="studioSelectedPerson.assignments" t-as="assignment" t-key="assignment.id" class="pbva-studio-assignment">
        <strong t-esc="assignment.profile"/><span><t t-esc="assignment.origin === 'automatic' ? 'Department rule' : 'Owner assignment'"/> · <t t-esc="assignment.date_end ? 'Until ' + assignment.date_end : 'No expiry'"/></span>
        <small t-att-class="assignment.due ? 'pbva-studio-warning' : ''">Review <t t-esc="assignment.review_date"/><t t-if="assignment.due"> · Due</t></small>
        <button t-if="studioCanManage" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('review', 'Review ' + assignment.profile, {...assignment, retain: true})">Review assignment</button>
      </article>
      <article t-foreach="studioSelectedPerson.extras" t-as="extra" t-key="extra.id" class="pbva-studio-assignment"><strong t-esc="extra.role"/><small>Independent grant · until <t t-esc="extra.date_end"/></small><button t-if="studioCanManage" class="pbim-btn ghost" t-on-click="() => this.studioConfirm('revoke_extra', 'Revoke temporary grant', extra)">Revoke grant</button></article>
    </section>
  </t>
</templates>
