<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- ONECHAT — PayAI's answer drawn from the safe block tree
         (`richBlocks` in ai_insight_chat.js): bold, italic, code, lists and
         line breaks. EVERY piece is printed with t-esc — never t-out — so
         nothing the model writes becomes a tag, a link or an image. The
         inline templates are written on one line: this file keeps its
         whitespace, and a stray space between two pieces would show. -->
    <t t-name="pb_payroll_ai_insights.RichLine"><t t-foreach="line" t-as="sp" t-key="sp_index"><code t-if="sp.code" class="payai-rich-code" t-esc="sp.text"/><strong t-elif="sp.b and sp.i"><em t-esc="sp.text"/></strong><strong t-elif="sp.b" t-esc="sp.text"/><em t-elif="sp.i" t-esc="sp.text"/><t t-else="" t-esc="sp.text"/></t></t>
    <t t-name="pb_payroll_ai_insights.RichLines"><t t-foreach="lines" t-as="line" t-key="line_index"><br t-if="line_index"/><t t-call="pb_payroll_ai_insights.RichLine"/></t></t>
    <t t-name="pb_payroll_ai_insights.RichList">
        <ol t-if="lst.kind === 'ol'" class="payai-rich-list" t-att-start="lst.start"><li t-foreach="lst.items" t-as="item" t-key="item_index"><t t-set="lines" t-value="item.lines"/><t t-call="pb_payroll_ai_insights.RichLines"/><t t-foreach="item.subs or []" t-as="sub" t-key="sub_index"><t t-call="pb_payroll_ai_insights.RichSubList"/></t></li></ol>
        <ul t-else="" class="payai-rich-list"><li t-foreach="lst.items" t-as="item" t-key="item_index"><t t-set="lines" t-value="item.lines"/><t t-call="pb_payroll_ai_insights.RichLines"/><t t-foreach="item.subs or []" t-as="sub" t-key="sub_index"><t t-call="pb_payroll_ai_insights.RichSubList"/></t></li></ul>
    </t>
    <t t-name="pb_payroll_ai_insights.RichSubList">
        <ol t-if="sub.kind === 'ol'" class="payai-rich-list" t-att-start="sub.start"><li t-foreach="sub.items" t-as="si" t-key="si_index"><t t-set="lines" t-value="si.lines"/><t t-call="pb_payroll_ai_insights.RichLines"/></li></ol>
        <ul t-else="" class="payai-rich-list"><li t-foreach="sub.items" t-as="si" t-key="si_index"><t t-set="lines" t-value="si.lines"/><t t-call="pb_payroll_ai_insights.RichLines"/></li></ul>
    </t>
    <t t-name="pb_payroll_ai_insights.RichText">
        <t t-foreach="rich" t-as="blk" t-key="blk_index">
            <p t-if="blk.kind === 'p'" class="payai-rich-p"><t t-set="lines" t-value="blk.lines"/><t t-call="pb_payroll_ai_insights.RichLines"/></p>
            <t t-else=""><t t-set="lst" t-value="blk"/><t t-call="pb_payroll_ai_insights.RichList"/></t>
        </t>
    </t>
    <t t-name="pb_payroll_ai_insights.AiInsightChat">
      <!-- LEARN v3: when the helper is installed this chat lives in its Ask
           tab, and this floating copy draws nothing. -->
      <t t-if="!hosted">
        <!-- Floating Pill Button -->
        <div class="payai-floating-pill" data-coach="payai-pill" t-on-click="togglePanel"
             t-att-class="{ 'payai-pill-active': state.isOpen }">
            <div class="payai-pill-avatar">
                <t t-if="state.aiIconUrl">
                    <img t-att-src="state.aiIconUrl" class="payai-ai-icon" alt="PayAI"/>
                </t>
                <t t-else="">
                    <i class="fa fa-bolt"/>
                </t>
                <div class="payai-pill-glow"/>
            </div>
            <div class="payai-pill-text">
                <span class="payai-pill-title">PayAI</span>
                <span class="payai-pill-status">
                    <span class="payai-status-dot"/>
                    Online
                </span>
            </div>
        </div>

        <!-- Backdrop (when panel is open) -->
        <div t-if="state.isOpen" class="payai-backdrop" t-on-click="closePanel"/>

        <!-- Chat Panel (Centered Modal) -->
        <div t-att-class="'payai-chat-panel ' + (state.isOpen ? 'payai-panel-open' : '')">
            <!-- Header -->
            <div class="payai-chat-header">
                <div class="payai-header-left">
                    <div class="payai-modal-avatar">
                        <div class="payai-avatar-core">
                            <t t-if="state.aiIconUrl">
                                <img t-att-src="state.aiIconUrl" class="payai-ai-icon" alt="PayAI"/>
                            </t>
                            <t t-else="">
                                <i class="fa fa-bolt"/>
                            </t>
                        </div>
                        <div class="payai-avatar-ring ring-1"/>
                        <div class="payai-avatar-ring ring-2"/>
                    </div>
                    <div class="payai-header-title-group">
                        <h3>PayAI</h3>
                        <div class="payai-header-status">
                            <span class="payai-status-dot"/>
                            Intelligent Payroll Analytics
                        </div>
                    </div>
                </div>
                <div class="payai-header-actions">
                    <button class="payai-btn-icon" t-on-click="clearHistory" title="Clear chat">
                        <i class="fa fa-trash-o"/>
                    </button>
                    <button class="payai-btn-icon" t-on-click="closePanel" title="Close">
                        <i class="fa fa-times"/>
                    </button>
                </div>
            </div>

            <!-- Chat Body -->
            <div class="payai-chat-body" t-ref="chatBody">
                <!-- Welcome + Suggestions -->
                <t t-if="state.showSuggestions and state.messages.length === 0">
                    <div class="payai-welcome">
                        <div class="payai-welcome-icon">
                            <i class="fa fa-magic fa-2x"/>
                        </div>
                        <h3>Welcome to PayAI</h3>
                        <p>Ask me anything about your payroll, attendance, leaves, or recruitment data:</p>
                        <div class="payai-suggestions">
                            <t t-foreach="suggestions" t-as="suggestion" t-key="suggestion_index">
                                <button class="payai-suggestion-chip"
                                        t-on-click="() => this.sendSuggestion(suggestion)">
                                    <t t-esc="suggestion"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Messages -->
                <t t-foreach="state.messages" t-as="msg" t-key="msg_index">
                    <div t-att-class="'payai-message payai-msg-' + msg.role">
                        <!-- Avatar -->
                        <div class="payai-avatar">
                            <div class="payai-msg-avatar">
                                <t t-if="msg.role === 'user'">
                                    <i class="fa fa-user"/>
                                </t>
                                <t t-else="">
                                    <t t-if="state.aiIconUrl">
                                        <img t-att-src="state.aiIconUrl" class="payai-ai-icon" alt="AI"/>
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-bolt"/>
                                    </t>
                                </t>
                            </div>
                        </div>

                        <!-- Message Content -->
                        <div class="payai-msg-content">
                            <div class="payai-msg-text" t-att-class="{'payai-rich': msg.role !== 'user'}"><t t-if="msg.role === 'user'" t-esc="msg.content"/><t t-else=""><t t-set="rich" t-value="richOf(msg.content)"/><t t-call="pb_payroll_ai_insights.RichText"/></t></div>

                            <!-- Chart (if present) -->
                            <t t-if="msg.chart">
                                <div class="payai-msg-chart">
                                    <ChartRenderer chartConfig="msg.chart" height="'260px'"
                                                   showToolbar="true"
                                                   drillDownModel="msg.drillDownModel || ''"/>
                                    <button class="payai-pin-btn"
                                            t-on-click="() => this.pinToDashboard(msg.chart)"
                                            title="Pin to Dashboard">
                                        <i class="fa fa-thumb-tack"/> Pin to Dashboard
                                    </button>
                                </div>
                            </t>

                            <!-- Insights -->
                            <t t-if="msg.insights and msg.insights.length">
                                <div class="payai-insights">
                                    <div class="payai-insights-title">
                                        <i class="fa fa-lightbulb-o"/> Key Insights
                                    </div>
                                    <t t-foreach="msg.insights" t-as="insight" t-key="insight_index">
                                        <div class="payai-insight-item">
                                            <span class="payai-insight-bullet">•</span>
                                            <t t-esc="insight"/>
                                        </div>
                                    </t>
                                </div>
                            </t>

                            <!-- "Show me" (AI offers to open a pb_learn lesson).
                                 One shape only: the server converts a legacy
                                 `start_tour` envelope and always emits
                                 `open_lesson`, so nothing else can arrive. -->
                            <t t-if="msg.action and (msg.action.type === 'open_lesson' or msg.action.type === 'open_walkthrough')">
                                <button class="payai-coach-action"
                                        t-on-click="() => this.runAction(msg.action)">
                                    <i class="fa fa-magic"/> <t t-esc="msg.action.label || 'Show me'"/>
                                </button>
                            </t>

                            <!-- Follow-up Questions -->
                            <t t-if="msg.followUpQuestions and msg.followUpQuestions.length">
                                <div class="payai-followups">
                                    <t t-foreach="msg.followUpQuestions" t-as="fq" t-key="fq_index">
                                        <button class="payai-followup-chip"
                                                t-on-click="() => this.sendSuggestion(fq)">
                                            <t t-esc="fq"/>
                                        </button>
                                    </t>
                                </div>
                            </t>

                            <!-- Read this answer aloud. The BROWSER speaks it:
                                 an answer with the names restored into it must
                                 not be posted to a speech endpoint to be read
                                 back. Drawn only where the device can speak. -->
                            <t t-if="msg.role === 'assistant' and ttsSupported and msg.content">
                                <button class="payai-tts-replay"
                                        t-on-click="() => this.speak(msg.content)"
                                        t-att-title="voiceCopy.listen_label || 'Read answers aloud'">
                                    <i class="fa fa-volume-up"/>
                                    <t t-esc="voiceCopy.listen_label || 'Read answers aloud'"/>
                                </button>
                            </t>

                            <!-- Timestamp -->
                            <div class="payai-msg-time" t-esc="formatTimestamp(msg.timestamp)"/>
                        </div>
                    </div>
                </t>

                <!-- Loading indicator -->
                <t t-if="state.isLoading">
                    <div class="payai-message payai-msg-assistant">
                        <div class="payai-avatar">
                            <div class="payai-msg-avatar">
                                <t t-if="state.aiIconUrl">
                                    <img t-att-src="state.aiIconUrl" class="payai-ai-icon" alt="AI"/>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-bolt"/>
                                </t>
                            </div>
                        </div>
                        <div class="payai-msg-content">
                            <div class="payai-typing">
                                <span class="payai-dot"/>
                                <span class="payai-dot"/>
                                <span class="payai-dot"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Input Area -->
            <div class="payai-chat-input-area">
                <!-- Recording Indicator -->
                <t t-if="state.isRecording">
                    <div class="payai-recording-indicator">
                        <span class="payai-rec-dot"/>
                        <span class="payai-rec-text">Recording <t t-esc="formatRecordingTime()"/></span>
                    </div>
                </t>
                <t t-else="">
                    <textarea
                        t-ref="chatInput"
                        class="payai-chat-input"
                        placeholder="Ask PayAI anything..."
                        t-att-value="state.inputText"
                        t-on-input="onInputChange"
                        t-on-keydown="onInputKeydown"
                        rows="1"
                    />
                </t>
                <div class="payai-input-actions">
                    <!-- READ ALOUD, on the device. Absent where the browser
                         cannot speak. -->
                    <t t-if="ttsSupported">
                        <button t-att-class="'payai-tts-btn ' + (state.ttsOn ? 'on' : '')"
                                t-on-click="toggleTts"
                                t-att-aria-pressed="state.ttsOn ? 'true' : 'false'"
                                t-att-title="voiceCopy.listen_label || 'Read answers aloud'">
                            <i t-att-class="state.ttsOn ? 'fa fa-volume-up' : 'fa fa-volume-off'"/>
                        </button>
                    </t>
                    <!-- THE MICROPHONE IS ABSENT, NOT DISABLED, when voice is
                         switched off for this tenant, unavailable on this
                         database, or refused by this user. Tap to talk (ONECHAT
                         OC3): tap to start, tap again to stop (a held press
                         stops on release); the text lands in the box above for
                         the learner to read before anything is sent. -->
                    <t t-if="voiceOffered">
                        <button t-att-class="'payai-mic-btn ' + ((state.isRecording or state.micStarting) ? 'recording' : '')"
                                t-on-pointerdown="onMicPointerDown"
                                t-on-pointerup="onMicPointerUp"
                                t-on-pointerleave="onMicPointerUp"
                                t-on-pointercancel="onMicPointerUp"
                                t-on-keydown="onMicKeyDown"
                                t-on-keyup="onMicKeyUp"
                                t-att-disabled="state.isLoading || state.voiceBusy"
                                t-att-title="voiceCopy.tap_hint || 'Tap to speak'">
                            <i t-att-class="state.voiceBusy ? 'fa fa-spinner fa-spin' : 'fa fa-microphone'"/>
                        </button>
                    </t>
                    <button class="payai-send-btn"
                            t-on-click="() => this.submitComposer()"
                            t-att-disabled="state.isLoading || state.isRecording || !state.inputText.trim()">
                        <i class="fa fa-paper-plane"/>
                    </button>
                </div>
            </div>
            <!-- What was heard, and what went wrong. Under the box, because
                 the thing it is about is IN the box. -->
            <t t-if="state.voiceHint">
                <div class="payai-voice-hint" t-esc="state.voiceHint"/>
            </t>
            <t t-if="state.voiceError">
                <div class="payai-voice-error" t-esc="state.voiceError"/>
            </t>
        </div>
      </t>
    </t>

    <!-- ONECHAT OC2 — THE ONE CHAT inside the helper drawer. One stream, one
         composer, no tabs. PayAI's answers and cards are drawn here; every
         turn the helper itself writes (a guide answer, a note, a practice
         turn, a choice, the context card, a history marker) is drawn by the
         drawer's own renderer (`helperTurn`), so the two read as one surface.
         Lucide icons from the sprite the drawer already mounts; no Font
         Awesome. The two anchors cards.xml extends — the text div and the
         message loop's div — are kept exactly. -->
    <t t-name="pb_payroll_ai_insights.AiInsightChatEmbedded">
        <div class="payai-embed">
            <div class="payai-embed-body" t-ref="chatBody" t-on-scroll="onBodyScroll"
                 role="log" aria-live="polite" t-att-aria-busy="state.isLoading ? 'true' : 'false'">
                <!-- Nothing said yet: the promise, then the context card. -->
                <t t-if="state.messages.length === 0">
                    <p class="lrn-dhonest" t-if="props.helper">
                        <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-shield-check"/></svg>
                        <span t-esc="bannerText"/>
                    </p>
                    <t t-if="props.helper" t-out="contextCard()"/>
                </t>

                <t t-foreach="state.messages" t-as="msg" t-key="msg.id || msg_index">
                    <div t-att-class="'payai-embed-msg ' + (msg.role === 'user' ? 'me' : 'ai')"
                         t-att-data-kind="msg.kind || msg.role" t-att-data-turn="msg.id"
                         t-att-data-new="msg.isNew ? '1' : '0'">
                        <!-- ONECHAT OC3 — the turn being read aloud carries its
                             own Stop. -->
                        <button type="button" class="payai-stop-read" t-if="state.speakingId and state.speakingId === msg.id"
                                t-on-click="stopReading" t-att-aria-label="t('stopReading', 'Stop reading')">
                            <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-volume-x"/></svg>
                            <t t-esc="t('stopReading', 'Stop reading')"/>
                        </button>
                        <t t-if="msg.kind and props.helper">
                            <t t-out="helperTurn(msg)"/>
                        </t>
                        <t t-else="">
                            <div class="payai-turn-src" t-if="sourceLabel(msg)">
                                <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-bar-chart"/></svg>
                                <span t-esc="sourceLabel(msg)"/>
                            </div>
                            <span class="payai-spoken" t-if="msg.role === 'user' and msg.spoken"
                                  t-att-aria-label="t('spoken', 'Spoken')" t-att-title="t('spoken', 'Spoken')">
                                <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-mic"/></svg>
                            </span>
                            <div class="payai-embed-text" t-att-class="{'payai-rich': msg.role !== 'user'}"><t t-if="msg.role === 'user'" t-esc="msg.content"/><t t-else=""><t t-set="rich" t-value="richOf(msg.content)"/><t t-call="pb_payroll_ai_insights.RichText"/></t></div>
                            <t t-if="msg.chart">
                                <div class="payai-embed-chart">
                                    <ChartRenderer chartConfig="msg.chart" height="'220px'"
                                                   showToolbar="true"
                                                   drillDownModel="msg.drillDownModel || ''"/>
                                    <button type="button" class="payai-embed-link"
                                            t-on-click="() => this.pinToDashboard(msg.chart)">
                                        <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-plus"/></svg>
                                        <t t-esc="t('pinDashboard', 'Pin to dashboard')"/>
                                    </button>
                                </div>
                            </t>
                            <t t-if="msg.insights and msg.insights.length">
                                <ul class="payai-embed-insights">
                                    <t t-foreach="msg.insights" t-as="insight" t-key="insight_index">
                                        <li t-esc="insight"/>
                                    </t>
                                </ul>
                            </t>
                            <div class="payai-embed-tools" t-if="msg.role === 'assistant' and (practiseFor(msg) or (msg.action and (msg.action.type === 'open_lesson' or msg.action.type === 'open_walkthrough')))">
                                <t t-if="msg.action and (msg.action.type === 'open_lesson' or msg.action.type === 'open_walkthrough')">
                                    <button type="button" class="payai-embed-action"
                                            t-on-click="() => this.runAction(msg.action)">
                                        <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-play"/></svg>
                                        <t t-esc="msg.action.label || t('showMe', 'Show me')"/>
                                    </button>
                                </t>
                                <t t-set="pchip" t-value="practiseFor(msg)"/>
                                <button type="button" class="payai-embed-action pri" t-if="pchip"
                                        t-on-click="() => this.practise(pchip.key, 'try')">
                                    <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-flask"/></svg>
                                    <t t-esc="t('practiseThis', 'Practise this')"/>
                                </button>
                            </div>
                            <t t-if="msg.followUpQuestions and msg.followUpQuestions.length">
                                <!-- Plain follow-ups go through the router like
                                     anything typed; a send that answers a card
                                     (a pending resolve) bypasses it (OC-R4). -->
                                <div class="lrn-tchips">
                                    <t t-foreach="msg.followUpQuestions" t-as="fq" t-key="fq_index">
                                        <button type="button" class="lrn-tchip"
                                                t-on-click="() => this.sendText(fq, { origin: 'followup' })">
                                            <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-message-circle"/></svg>
                                            <span t-esc="fq"/>
                                        </button>
                                    </t>
                                </div>
                            </t>
                            <t t-if="msg.extra and props.helper" t-out="extraChips(msg)"/>
                        </t>
                    </div>
                </t>

                <t t-if="state.isLoading">
                    <div class="payai-embed-msg ai payai-embed-typing" role="status"
                         t-att-aria-label="t('answering', 'PayAI is answering')">
                        <div class="payai-typing">
                            <span class="payai-dot"/><span class="payai-dot"/><span class="payai-dot"/>
                        </div>
                    </div>
                </t>
            </div>

            <button type="button" class="payai-jump" t-if="state.awayFromBottom and state.messages.length"
                    t-on-click="jumpToLatest">
                <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-arrow-down"/></svg>
                <t t-esc="t('jumpLatest', 'Jump to latest')"/>
            </button>

            <div class="payai-embed-input" t-att-data-voice="state.isRecording ? 'listening' : (state.micStarting ? 'starting' : (state.voiceBusy ? 'busy' : ''))">
                <!-- ONECHAT OC3 — TAP TO TALK. While the microphone is open the
                     recording bar takes the box's place: "Starting…" until the
                     recorder really runs, then the red dot, the live level
                     meter, the clock, Cancel (sends nothing) and Stop (sends
                     the recording to be turned into text). The words then wait
                     in the box for Send — never sent by themselves. -->
                <t t-if="state.isRecording or state.micStarting">
                    <div class="payai-recbar" role="status" aria-live="polite">
                        <span t-att-class="'payai-rec-dot' + (state.isRecording ? '' : ' wait')" aria-hidden="true"/>
                        <span class="payai-rec-text" t-esc="state.isRecording ? t('listening', 'Listening') : t('micStarting', 'Starting…')"/>
                        <span class="payai-meter" aria-hidden="true">
                            <t t-foreach="levelBars" t-as="bar" t-key="bar_index">
                                <i t-att-style="'height:' + (state.isRecording ? bar : 18) + '%'"/>
                            </t>
                        </span>
                        <span class="payai-rec-time" t-esc="recordingClock"/>
                        <button type="button" class="payai-recbtn"
                                t-on-click="() => this.cancelRecording()"
                                t-att-aria-label="t('micCancel', 'Cancel')" t-att-title="t('micCancel', 'Cancel')">
                            <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-x"/></svg>
                            <span t-esc="t('micCancel', 'Cancel')"/>
                        </button>
                    </div>
                </t>
                <t t-elif="state.voiceBusy">
                    <div class="payai-recbar busy" role="status" aria-live="polite">
                        <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-mic"/></svg>
                        <span class="payai-rec-text" t-esc="t('transcribing', 'Turning your words into text…')"/>
                    </div>
                </t>
                <t t-else="">
                    <textarea t-ref="chatInput" rows="1" data-coach="helper-composer"
                              t-att-class="state.hearAs ? 'heard' : ''"
                              t-att-placeholder="placeholder"
                              t-att-aria-label="placeholder"
                              t-att-value="state.inputText"
                              t-on-input="onInputChange"
                              t-on-keydown="onInputKeydown"/>
                </t>
                <!-- One microphone. While it is open the SAME button is Stop
                     (square, solid): the place you tapped is the place you tap
                     again, and a press held past 400 ms stops on release. -->
                <t t-if="voiceOffered">
                    <button type="button" data-coach="helper-mic"
                            t-att-class="'payai-embed-icon mic' + ((state.isRecording or state.micStarting) ? ' rec' : '')"
                            t-on-pointerdown="onMicPointerDown"
                            t-on-pointerup="onMicPointerUp"
                            t-on-pointerleave="onMicPointerUp"
                            t-on-pointercancel="onMicPointerUp"
                            t-on-keydown="onMicKeyDown"
                            t-on-keyup="onMicKeyUp"
                            t-on-contextmenu.prevent="() => {}"
                            t-att-disabled="(state.isLoading or state.voiceBusy) and !(state.isRecording or state.micStarting)"
                            t-att-aria-pressed="(state.isRecording or state.micStarting) ? 'true' : 'false'"
                            t-att-aria-label="(state.isRecording or state.micStarting) ? t('micStop', 'Stop') : t('micStart', 'Speak instead of typing')"
                            t-att-title="(state.isRecording or state.micStarting) ? t('micStop', 'Stop') : (voiceCopy.tap_hint || t('micStart', 'Speak instead of typing'))">
                        <svg class="lrn-ic" aria-hidden="true"><use t-att-href="(state.isRecording or state.micStarting) ? '#lrn-i-square' : '#lrn-i-mic'"/></svg>
                    </button>
                </t>
                <button type="button" class="payai-embed-icon send"
                        t-att-class="{ ready: !!state.inputText.trim() and !state.isLoading, pulse: state.sendPulse }"
                        t-on-click="() => this.submitComposer()"
                        t-att-disabled="state.isLoading || state.isRecording || state.micStarting || state.voiceBusy || !state.inputText.trim()"
                        t-att-aria-label="t('send', 'Send')" t-att-title="t('send', 'Send')">
                    <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-send"/></svg>
                </button>
            </div>
            <t t-if="state.voiceHint or state.hearAs">
                <div class="payai-voice-hint" aria-live="polite">
                    <span t-if="state.voiceHint" t-esc="state.voiceHint"/>
                    <button type="button" class="payai-hear-as" t-if="state.hearAs"
                            t-on-click="() => this.hearAs(state.hearAs)" t-att-disabled="state.voiceBusy">
                        <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-languages"/></svg>
                        <t t-esc="hearAsLabel"/>
                    </button>
                </div>
            </t>
            <t t-if="state.voiceError">
                <div class="payai-voice-error" role="alert" t-esc="state.voiceError"/>
            </t>
        </div>
    </t>
</templates>
