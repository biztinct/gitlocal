<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==========================================
             PAYAI PRIVILEGE (Odoo 19 Pattern)
             ========================================== -->

        <!-- Privilege — appears as dropdown label in user Access Rights -->
        <record id="res_groups_privilege_payai" model="res.groups.privilege">
            <field name="name">PayAI</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        </record>

        <!-- ==========================================
             GROUP DEFINITIONS
             ========================================== -->

        <!-- PayAI User Group -->
        <record id="group_payai_user" model="res.groups">
            <field name="name">PayAI User</field>
            <field name="privilege_id" ref="res_groups_privilege_payai"/>
            <field name="comment">Can use PayAI chat and view dashboards</field>
        </record>

        <!-- PayAI Manager Group -->
        <record id="group_payai_manager" model="res.groups">
            <field name="name">PayAI Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_payai"/>
            <field name="implied_ids" eval="[(4, ref('group_payai_user'))]"/>
            <field name="comment">Can configure PayAI settings and manage dashboards</field>
        </record>

        <!-- PayAI Admin Group -->
        <record id="group_payai_admin" model="res.groups">
            <field name="name">PayAI Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_payai"/>
            <field name="implied_ids" eval="[(4, ref('group_payai_manager'))]"/>
            <field name="comment">Full access to PayAI configuration and all data</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- ==========================================
             RECORD RULES
             ========================================== -->

        <!-- Conversations: users see only their own -->
        <record id="rule_conversation_user" model="ir.rule">
            <field name="name">PayAI: Own Conversations</field>
            <field name="model_id" ref="model_payroll_ai_conversation"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_payai_user'))]"/>
        </record>

        <!-- Dashboard: users see own + shared -->
        <record id="rule_dashboard_user" model="ir.rule">
            <field name="name">PayAI: Own + Shared Dashboards</field>
            <field name="model_id" ref="model_payroll_ai_dashboard"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('is_shared', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_payai_user'))]"/>
        </record>

        <!-- LEARNOS Phase 6 — voice consent is the user's own row and nobody
             else's business. Deliberately NOT extended to the PayAI manager
             rule below: a manager who can read this table can assemble the
             list of people who refused, and the same ruling was made for
             `learn.consent` in pb_learn (whose authors get no read rule on it
             either). Scoped to every internal user because the row is created
             by the person it is about. -->
        <record id="rule_payai_consent_own" model="ir.rule">
            <field name="name">PayAI: own consent row only</field>
            <field name="model_id" ref="model_payroll_ai_consent"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Managers see all -->
        <record id="rule_conversation_manager" model="ir.rule">
            <field name="name">PayAI: Manager sees all conversations</field>
            <field name="model_id" ref="model_payroll_ai_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_payai_manager'))]"/>
        </record>

    </data>

    <!-- Updatable: PayAI is a global copilot — every internal user (incl. demo/
         trial users) can chat with it. Kept out of the noupdate block above so
         the implication is (re)applied on upgrade. -->
    <data>
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_payai_user'))]"/>
        </record>
    </data>
</odoo>
