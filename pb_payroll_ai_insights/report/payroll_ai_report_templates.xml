<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb Report Action -->
    <record id="action_report_payai_executive" model="ir.actions.report">
        <field name="name">PayAI Executive Report</field>
        <field name="model">payroll.ai.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pb_payroll_ai_insights.report_payai_executive</field>
        <field name="report_file">pb_payroll_ai_insights.report_payai_executive</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>

    <!-- QWeb Report Template -->
    <template id="report_payai_executive">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="rd" t-value="doc.get_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; color: #1e1b4b;">

                        <!-- Report Header -->
                        <div style="text-align: center; padding: 20px 0 25px; border-bottom: 3px solid #4F46E5;">
                            <h1 style="color: #4F46E5; font-size: 26px; margin-bottom: 5px;">
                                <t t-esc="rd.get('title', 'PayAI Executive Report')"/>
                            </h1>
                            <p style="color: #6B7280; font-size: 13px; margin: 5px 0;">
                                <t t-esc="rd.get('company', '')"/>
                                ·
                                <t t-esc="rd.get('date_from', '')"/>
                                to
                                <t t-esc="rd.get('date_to', '')"/>
                            </p>
                            <p style="color: #9CA3AF; font-size: 11px;">
                                Generated on <t t-esc="rd.get('generated_at', '')"/>
                                by <t t-esc="rd.get('generated_by', '')"/>
                            </p>
                        </div>

                        <!-- Executive Summary -->
                        <div style="margin: 20px 0; padding: 15px 20px; background: #f0f0ff; border-left: 4px solid #4F46E5; border-radius: 4px;">
                            <h2 style="color: #4F46E5; font-size: 16px; margin: 0 0 10px 0;">
                                Executive Summary
                            </h2>
                            <p style="font-size: 13px; line-height: 1.7; color: #374151; margin: 0;">
                                <t t-esc="rd.get('executive_summary', 'No summary available.')"/>
                            </p>
                        </div>

                        <!-- Report Sections -->
                        <t t-foreach="rd.get('sections', [])" t-as="section">
                            <div style="margin: 20px 0; page-break-inside: avoid;">
                                <!-- Section Title -->
                                <h3 style="color: #1e1b4b; font-size: 15px; border-bottom: 2px solid #e5e7eb; padding-bottom: 6px; margin-bottom: 10px;">
                                    <t t-esc="section.get('title', '')"/>
                                </h3>

                                <!-- AI Narrative -->
                                <p style="font-size: 12px; line-height: 1.6; color: #374151; margin: 8px 0 12px 0;">
                                    <t t-esc="section.get('narrative', '')"/>
                                </p>

                                <!-- Data Table for list data -->
                                <t t-if="isinstance(section.get('data'), list) and section.get('data')">
                                    <table style="width: 100%; border-collapse: collapse; margin: 8px 0; font-size: 11px;">
                                        <thead>
                                            <tr style="background: #4F46E5; color: white;">
                                                <t t-foreach="list(section['data'][0].keys())[:6]" t-as="header">
                                                    <th style="padding: 6px 10px; text-align: left;">
                                                        <t t-esc="str(header).replace('_', ' ').title()"/>
                                                    </th>
                                                </t>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="section['data'][:15]" t-as="row">
                                                <tr t-att-style="'background: ' + ('#f9fafb' if row_index % 2 else 'white')">
                                                    <t t-foreach="list(row.keys())[:6]" t-as="col">
                                                        <td style="padding: 5px 10px; border-bottom: 1px solid #e5e7eb;">
                                                            <t t-esc="row[col]"/>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>

                                <!-- KV Data for dict data -->
                                <t t-if="isinstance(section.get('data'), dict) and section.get('data')">
                                    <table style="width: 60%; border-collapse: collapse; margin: 8px 0; font-size: 11px;">
                                        <t t-foreach="section['data'].items()" t-as="item">
                                            <t t-if="not isinstance(item[1], (list, dict))">
                                                <tr>
                                                    <td style="padding: 5px 10px; font-weight: 600; color: #374151; border-bottom: 1px solid #e5e7eb; width: 40%;">
                                                        <t t-esc="str(item[0]).replace('_', ' ').title()"/>
                                                    </td>
                                                    <td style="padding: 5px 10px; border-bottom: 1px solid #e5e7eb;">
                                                        <t t-esc="item[1]"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </table>
                                </t>
                            </div>
                        </t>

                        <!-- Footer -->
                        <div style="margin-top: 30px; padding-top: 12px; border-top: 2px solid #e5e7eb; text-align: center;">
                            <p style="color: #9CA3AF; font-size: 10px;">
                                Generated by PayAI — Intelligent Payroll Analytics | Powered by AI
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
