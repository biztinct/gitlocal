# Translation of Payobook (pb_payroll_ai_insights) into Vietnamese.
# Phase D1: PayAI's data queries run with the asker's access rights, so a
# refusal is now something a user READS, verbatim — no model rewrites it.
# Every sentence a refusal can print ships in both languages, and
# tests/test_data_access.py asserts that this file covers every one of them.
msgid ""
msgstr ""
"Project-Id-Version: Odoo Server 19.0\n"
"Report-Msgid-Bugs-To: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: vi_VN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "One thing I left out: I can't list individual salaries for your role. Reading a named person's pay needs the Payroll Manager or the Payroll Final Approver group; below that I answer in aggregate only. What you have above is the same payroll, without the names."
msgstr "Một điều tôi đã lược bớt: tôi không thể liệt kê lương của từng người với vai trò của bạn. Để xem lương đích danh của một người cần nhóm Quản lý lương (Payroll Manager) hoặc Người phê duyệt cuối (Payroll Final Approver); dưới mức đó tôi chỉ trả lời ở dạng tổng hợp. Phần trên vẫn là bảng lương đó, chỉ là không có tên."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "that payroll data"
msgstr "dữ liệu lương đó"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "Not available with your access"
msgstr "Không khả dụng với quyền của bạn"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "I can't answer that one for you — your role is not allowed to read %(topic)s, and PayAI answers with your own access rights rather than around them.\n\nIn Payobook this data sits behind the payroll roles — a Payroll Officer, a Payroll Manager or a Payroll Super Administrator can see it. Ask one of them for the figure, or ask whoever administers roles in your company to add you."
msgstr "Tôi không thể trả lời câu này cho bạn — vai trò của bạn không được phép xem %(topic)s, và PayAI trả lời theo đúng quyền của bạn chứ không đi vòng qua nó.\n\nTrong Payobook, dữ liệu này nằm sau các vai trò lương — Chuyên viên tính lương, Quản lý lương hoặc Quản trị viên cấp cao mới xem được. Hãy hỏi một trong những người đó để lấy con số, hoặc nhờ người phụ trách phân quyền trong công ty cấp quyền cho bạn."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "attendance records"
msgstr "dữ liệu chấm công"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "leave and time-off records"
msgstr "dữ liệu nghỉ phép"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the recruitment pipeline"
msgstr "quy trình tuyển dụng"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "timesheet entries"
msgstr "các dòng chấm giờ dự án"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the wages on employment contracts"
msgstr "mức lương ghi trên hợp đồng lao động"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the employee list"
msgstr "danh sách nhân viên"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the overtime lines on payslips"
msgstr "các dòng làm thêm giờ trên phiếu lương"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the deduction and contribution lines on payslips"
msgstr "các dòng khấu trừ và đóng góp trên phiếu lương"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "payslip totals"
msgstr "các số tổng trên phiếu lương"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the payslip history"
msgstr "lịch sử phiếu lương"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the department-level payroll summary"
msgstr "bảng tổng hợp lương theo phòng ban"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "individual employee salaries"
msgstr "lương của từng nhân viên"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the payroll overview"
msgstr "bức tranh tổng quan về lương"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_data_query
msgid "the payroll history a forecast is built from"
msgstr "dữ liệu lịch sử lương dùng để lập dự báo"

# LEARNOS Phase 6 — the voice seam. Same contract as the Phase D1
# refusals above: every sentence a user READS ships in both languages, and
# tests/test_egress.py::test_04d re-derives this list from the AST of
# payroll_ai_conversation.py rather than trusting it. test_04f then runs the
# register rules over both languages — short sentences, no jargon, and the
# Vietnamese rules the pb_learn gate enforces on its own content.
# ONE NAME FOR THE THIRD PARTY, in both languages: "an outside company's
# speech service" / "dịch vụ chuyển giọng nói thành chữ". Two names for one
# thing in a consent notice is a reader wondering how many there are.

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "PayAI Chat"
msgstr "Trò chuyện PayAI"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "Send recordings for transcription?"
msgstr "Gửi bản ghi âm đi để chuyển thành chữ?"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "Hold the microphone and speak. When you let go, the recording goes to an outside company's speech service, which turns it into text. The recording is audio: unlike text, we cannot take names out of it first. The text then waits in the box — nothing is asked or answered until you read it and press send. Say no and the microphone stays off. Everything else works the same."
msgstr "Bạn giữ nút micrô rồi nói. Khi bạn thả tay, bản ghi âm sẽ được gửi tới dịch vụ chuyển giọng nói thành chữ của một công ty bên ngoài. Đây là âm thanh: khác với chữ, chúng tôi không thể bỏ tên riêng ra trước khi gửi. Phần chữ nghe được sẽ nằm chờ trong ô nhập — không có câu hỏi nào được gửi đi cho tới khi bạn đọc lại rồi bấm gửi. Nếu bạn từ chối, micrô sẽ tắt. Mọi thứ khác vẫn hoạt động y như vậy."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "Yes, send my recordings"
msgstr "Đồng ý, gửi bản ghi âm của tôi"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "No, keep the microphone off"
msgstr "Không, tắt micrô"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "Hold to speak"
msgstr "Giữ để nói"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "This is what I heard. Edit it, then press send."
msgstr "Đây là phần tôi nghe được. Bạn sửa lại nếu cần, rồi bấm gửi."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "Read answers aloud"
msgstr "Đọc to câu trả lời"

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "I could not turn that into text. Please try typing."
msgstr "Tôi không chuyển được phần đó thành chữ. Bạn thử gõ giúp tôi nhé."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "Voice input is switched off for this database."
msgstr "Tính năng nhập bằng giọng nói đang tắt trên cơ sở dữ liệu này."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "Voice input needs your agreement first."
msgstr "Nhập bằng giọng nói cần bạn đồng ý trước."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "No speech service is set up here."
msgstr "Ở đây chưa cấu hình dịch vụ chuyển giọng nói thành chữ."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "That recording did not arrive in one piece."
msgstr "Bản ghi âm đó về không nguyên vẹn."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "That recording is too long. Try a shorter one."
msgstr "Bản ghi âm đó quá dài. Bạn thử ghi ngắn hơn nhé."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "That recording was empty."
msgstr "Bản ghi âm đó rỗng."

#. module: pb_payroll_ai_insights
#: model:ir.model,name:pb_payroll_ai_insights.model_payroll_ai_conversation
msgid "I did not catch anything in that recording."
msgstr "Tôi không nghe được gì trong bản ghi âm đó."
