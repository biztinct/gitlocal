<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PayAI Configuration Form View -->
    <record id="view_payroll_ai_config_form" model="ir.ui.view">
        <field name="name">payroll.ai.config.form</field>
        <field name="model">payroll.ai.config</field>
        <field name="arch" type="xml">
            <form string="PayAI Configuration">
                <header>
                    <button name="action_test_connection"
                            type="object"
                            string="🔌 Test Connection"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>PayAI Configuration</span>
                        </h1>
                    </div>
                    <group>
                        <group string="AI Provider Settings">
                            <field name="purpose"/>
                            <field name="provider_type"/>
                            <field name="model_name"/>
                            <field name="api_key" password="True"/>
                            <field name="base_url" placeholder="Leave empty for default"/>
                        </group>
                        <group string="Generation Settings">
                            <field name="max_tokens"/>
                            <field name="temperature" widget="float"/>
                            <field name="timeout"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Appearance">
                            <field name="ai_icon" widget="image" class="oe_avatar"/>
                            <p class="text-muted">Upload a custom avatar for the PayAI chat panel. 128×128px recommended.</p>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>💡 Quick Start:</strong>
                        <ol>
                            <li>Get an API key from <a href="https://platform.openai.com/api-keys" target="_blank">OpenAI</a></li>
                            <li>Paste your API key above</li>
                            <li>Click "Test Connection" to verify</li>
                            <li>Start chatting with PayAI!</li>
                        </ol>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- PayAI Configuration Tree View -->
    <record id="view_payroll_ai_config_tree" model="ir.ui.view">
        <field name="name">payroll.ai.config.tree</field>
        <field name="model">payroll.ai.config</field>
        <field name="arch" type="xml">
            <list string="PayAI Configurations">
                <field name="purpose"/>
                <field name="provider_type"/>
                <field name="model_name"/>
                <field name="is_active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- PayAI Configuration Action -->
    <record id="action_payroll_ai_config" model="ir.actions.act_window">
        <field name="name">PayAI Configuration</field>
        <field name="res_model">payroll.ai.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your AI provider to start using PayAI
            </p>
        </field>
    </record>
</odoo>
