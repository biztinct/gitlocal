<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- IA REDESIGN CYCLE 5 — this item is RETIRED by the rail cutover (see the
         record below). This file is `<odoo noupdate="1">`, so the `active` and
         `sequence` values below are what a FRESH install records and a plain
         `-u` cannot reach an existing database (W13.1: `ir_model_data.noupdate`
         is a stored per-record column Odoo never refreshes). Existing databases
         are moved by `pb_sidebar/migrations/19.0.3.0.0/post-migrate.py`, which
         owns the whole retirement list because the rail's shape belongs to
         pb_sidebar rather than to any one cockpit. -->
    <!-- COMPLIANCE › Young Workers (under-18 compliance guard, HR tier) -->
    <record id="item_young_workers" model="pb.sidebar.item">
        <field name="section_id" ref="pb_sidebar.sec_compliance"/>
        <field name="name">Young Workers</field>
        <field name="active" eval="False"/>
        <field name="icon">shield</field>
        <field name="sequence">952</field>
        <field name="action_xmlid">pb_young_worker.action_pb_young_worker</field>
        <field name="action_tag">pb_young_worker</field>
        <field name="match_action_tags">pb_young_worker</field>
        <field name="groups_id" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
    </record>
</odoo>
