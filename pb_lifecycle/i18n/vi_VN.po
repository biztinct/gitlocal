msgstr "Chưa có mẫu thư nào. Hãy tạo một mẫu trong thư viện thư trước."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "No announcement templates yet. Make one in Announcements first."
msgstr "Chưa có mẫu thông báo chung nào. Hãy tạo một mẫu trong Thông báo chung trước."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "It is made as a draft and never sent from here. A letter still needs its own approval to be sent; an announcement follows its own sign-off."
