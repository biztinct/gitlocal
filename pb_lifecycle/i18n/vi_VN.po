msgstr "Bạn chưa có giai đoạn riêng nào cho các hồ sơ này."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "You have no stages of your own in this process yet."
msgstr "Bạn chưa có giai đoạn riêng nào trong quy trình này."

