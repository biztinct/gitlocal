msgstr "Các quy trình khác bắt đầu cho các hồ sơ này"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/stages.js:0
msgid "I checked these; this workflow adds different work."
msgstr "Tôi đã kiểm tra; quy trình này thêm việc khác."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/stages.js:0
