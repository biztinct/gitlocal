#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Counted on the company’s working calendar, as task deadlines are."
msgstr "Tính theo lịch làm việc của công ty, giống hạn của các việc."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "What to write"
msgstr "Nội dung cần viết"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "To move between %(area)s’s own stages use: %(action)s."
msgstr "Để chuyển giữa các giai đoạn sẵn có của %(area)s, hãy dùng: %(action)s."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Use “%(action)s” instead"
msgstr "Dùng “%(action)s” thay thế"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "%(area)s’s own stages are moved by %(area)s."
msgstr "Giai đoạn sẵn có của %(area)s do %(area)s tự chuyển."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
