#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "The notice"
msgstr "Nội dung thông báo"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
