msgid ""
"<div style=\"margin:0;padding:24px 0;background:#f6f7fc;font-family:Inter,Segoe UI,Arial,sans-serif;color:#1f1d2b\">\n"
"  <div style=\"max-width:520px;margin:0 auto;background:#ffffff;border:1px solid #e6e4f2;border-radius:16px;padding:32px\">\n"
"    <p style=\"margin:0 0 4px;font-size:13px;color:#6b6880\" t-out=\"ctx.get('link_company') or ''\"/>\n"
"    <h1 style=\"margin:0 0 16px;font-size:22px;line-height:1.3;color:#1f1d2b\" t-out=\"object.name or ''\"/>\n"
"    <p style=\"margin:0 0 16px;font-size:15px;line-height:1.55\">\n"
"      <t t-if=\"ctx.get('link_name')\">Hello <t t-out=\"ctx.get('link_name')\"/>, </t>there is one thing for you to do. It takes a minute and you do not need to sign in.\n"
"    </p>\n"
"    <p t-if=\"ctx.get('link_due')\" style=\"margin:0 0 20px;font-size:14px;color:#6b6880\">Needed by <t t-out=\"ctx.get('link_due')\"/>.</p>\n"
"    <p style=\"margin:0 0 24px\">\n"
"      <a t-att-href=\"ctx.get('link_url')\" style=\"display:inline-block;background:#5A4BB0;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;padding:12px 22px;border-radius:10px\">Open it</a>\n"
"    </p>\n"
"    <p style=\"margin:0;font-size:12px;line-height:1.5;color:#6b6880\">\n"
"      This link is just for you and works until <t t-out=\"ctx.get('link_until') or ''\"/>. Please do not forward it. If you were not expecting this, you can ignore it.\n"
"    </p>\n"
"  </div>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:24px 0;background:#f6f7fc;font-family:Inter,Segoe UI,Arial,sans-serif;color:#1f1d2b\">\n"
