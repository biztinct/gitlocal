#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Send it back to"
msgstr "Trả lại về"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Runs again after the changes"
msgstr "Chạy lại sau khi sửa"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "%(steps)s would run twice. Send it back to a later step, or move that step after this one."
msgstr "%(steps)s sẽ chạy hai lần. Hãy trả lại về một bước sau hơn, hoặc chuyển bước đó ra sau bước này."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "%(steps)s would run twice. Send it back to a later step, or move those steps after this one."
msgstr "%(steps)s sẽ chạy hai lần. Hãy trả lại về một bước sau hơn, hoặc chuyển các bước đó ra sau bước này."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "%(steps)s would be sent again."
msgstr "%(steps)s sẽ được gửi lại."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "The person gets it again with the latest note. Answers they gave are kept. It can go back three times; after that someone is asked to look."
msgstr "Người đó nhận lại việc kèm ghi chú mới nhất. Câu trả lời họ đã đưa được giữ lại. Có thể trả lại tối đa ba lần; sau đó sẽ có người được nhờ xem xét."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "A new process has no record to update. Ask for the value in a form instead."
msgstr "Quy trình mới không có hồ sơ để cập nhật. Hãy hỏi giá trị này trong một biểu mẫu."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "%(area)s has not opened any values to workflows yet."
msgstr "%(area)s chưa mở giá trị nào cho quy trình."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Value to set"
msgstr "Giá trị cần đặt"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Set it to"
msgstr "Đặt thành"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "A fixed value"
msgstr "Một giá trị cố định"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "An earlier answer"
msgstr "Một câu trả lời trước đó"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Earlier answer"
msgstr "Câu trả lời trước đó"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "No earlier answer fits. Add a question to a form before this step."
msgstr "Không có câu trả lời trước đó nào phù hợp. Hãy thêm câu hỏi vào một biểu mẫu trước bước này."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Only values %(area)s marks as safe appear here. Its status and money are never in this list."
msgstr "Chỉ những giá trị %(area)s đánh dấu là an toàn mới hiện ở đây. Trạng thái và số tiền không bao giờ có trong danh sách này."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "What to create"
msgstr "Thứ cần tạo"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
msgid "Start from"
msgstr "Bắt đầu từ"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/steps.js:0
