#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "%(record)s has %(count)s %(lines)s: %(names)s."
msgstr "%(record)s có %(count)s %(lines)s: %(names)s."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "That is more than the %(cap)s this repeats for, so it would start none."
msgstr "Số đó vượt mức %(cap)s mà vòng lặp này cho phép, nên sẽ không bắt đầu cái nào."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Retry %(line)s"
msgstr "Thử lại %(line)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Each %(line)s"
msgstr "Từng %(line)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Hide lines"
msgstr "Ẩn các dòng"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Show lines"
msgstr "Hiện các dòng"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Counted once, with all its lines"
msgstr "Tính một lần, gồm tất cả các dòng"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Tried that line again."
msgstr "Đã thử lại dòng đó."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Add a step for each %(line)s"
msgstr "Thêm một bước cho mỗi %(line)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Approvals, stage moves, hand-overs and other once-per-record steps go before or after the repeat."
msgstr "Phê duyệt, chuyển giai đoạn, chuyển giao và các bước chỉ làm một lần cho mỗi hồ sơ được đặt trước hoặc sau vòng lặp."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "This workflow format is not supported."
msgstr "Định dạng quy trình này không được hỗ trợ."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "This workflow timing setting is not supported."
msgstr "Cài đặt thời điểm của quy trình này không được hỗ trợ."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use 1–40 sections and at most 200 steps."
msgstr "Dùng từ 1 đến 40 phần và tối đa 200 bước."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A step identifier is not valid."
msgstr "Mã nhận diện của một bước không hợp lệ."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Each step needs a unique identifier and supported type."
msgstr "Mỗi bước cần một mã nhận diện riêng và một loại được hỗ trợ."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Give the step a name and a section."
msgstr "Hãy đặt tên và chọn phần cho bước này."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use two to ten paths in a group."
msgstr "Dùng từ hai đến mười nhánh trong một nhóm."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Each path needs its own identifier and steps."
msgstr "Mỗi nhánh cần mã nhận diện và các bước riêng."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Only path groups can contain branches."
msgstr "Chỉ nhóm nhánh mới chứa được các nhánh."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Only a saved group can contain a step list."
msgstr "Chỉ nhóm bước đã lưu mới chứa được danh sách bước."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A saved group needs a list of steps."
msgstr "Nhóm bước đã lưu cần có danh sách bước."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A repeat needs a list of steps."
msgstr "Bước lặp lại cần có danh sách bước."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A path and a step cannot share an identifier."
msgstr "Một nhánh và một bước không được dùng chung mã nhận diện."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep one start at the beginning."
msgstr "Giữ đúng một điểm bắt đầu ở đầu quy trình."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A step reference is missing."
msgstr "Thiếu một bước được tham chiếu."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep grouped work in its group’s section."
msgstr "Giữ các việc trong nhóm ở cùng phần với nhóm đó."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Each step must belong to exactly one path."
msgstr "Mỗi bước phải thuộc đúng một nhánh."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A group cannot contain itself. Use at most twelve nested groups."
msgstr "Một nhóm không thể chứa chính nó. Dùng tối đa mười hai cấp nhóm lồng nhau."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep steps in their section order."
msgstr "Giữ các bước theo đúng thứ tự phần."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use up to four levels and 20 filters in a group. Remove an empty group."
msgstr "Dùng tối đa bốn cấp và 20 bộ lọc trong một nhóm. Hãy gỡ nhóm trống."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose an available value and comparison."
msgstr "Hãy chọn một giá trị và phép so sánh có sẵn."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose one or more values for this filter."
msgstr "Hãy chọn một hoặc nhiều giá trị cho bộ lọc này."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Start filters belong on Start. Approval decisions belong in the Approval Matrix."
msgstr "Bộ lọc khi bắt đầu đặt ở bước Bắt đầu. Quyết định phê duyệt thuộc về Ma trận phê duyệt."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Only a wait step can wait for a condition."
msgstr "Chỉ bước chờ mới có thể chờ một điều kiện."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose a deadline from 1 to 365 days."
msgstr "Hãy chọn hạn từ 1 đến 365 ngày."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Write what the person is asked to read and confirm."
msgstr "Hãy ghi nội dung người đó cần đọc và xác nhận."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Write the notice, in up to 1,000 characters."
msgstr "Hãy viết thông báo, tối đa 1.000 ký tự."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose the value to set."
msgstr "Hãy chọn giá trị cần đặt."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use an answer given earlier in this workflow."
msgstr "Hãy dùng một câu trả lời đã có trước đó trong quy trình này."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose what to create."
msgstr "Hãy chọn thứ cần tạo."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep the reason under 200 characters."
msgstr "Giữ lý do dưới 200 ký tự."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Send it back to an earlier task or form on the main path."
msgstr "Hãy trả lại về một việc hoặc biểu mẫu trước đó trên nhánh chính."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose an available record field for the prefill."
msgstr "Hãy chọn một trường có sẵn của hồ sơ để điền sẵn."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose what this approval step should do."
msgstr "Hãy chọn việc mà bước phê duyệt này cần làm."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose an existing email template."
msgstr "Hãy chọn một mẫu email có sẵn."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Set a wait of up to one year."
msgstr "Đặt thời gian chờ tối đa một năm."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose how long to wait and what happens when time runs out."
msgstr "Hãy chọn thời gian chờ và việc xảy ra khi hết thời gian."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose an available business action."
msgstr "Hãy chọn một thao tác nghiệp vụ có sẵn."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose the existing behaviour to reference."
msgstr "Hãy chọn hoạt động có sẵn để tham chiếu."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep one Otherwise path, last."
msgstr "Giữ một nhánh Trường hợp khác, đặt ở cuối."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose a join and add work to every parallel path."
msgstr "Hãy chọn cách gộp và thêm việc vào mọi nhánh song song."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use “Everyone finishes” for paths with approvals or automatic effects."
msgstr "Dùng “Tất cả đều xong” cho các nhánh có phê duyệt hoặc tác động tự động."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Add a step to this saved group."
msgstr "Hãy thêm một bước vào nhóm bước đã lưu này."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose whether the lines run together or one by one, and when to carry on."
msgstr "Hãy chọn các dòng chạy cùng lúc hay lần lượt, và khi nào thì tiếp tục."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Add the steps to do for each line."
msgstr "Hãy thêm các bước cần làm cho mỗi dòng."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use one Approval Matrix step."
msgstr "Chỉ dùng một bước Ma trận phê duyệt."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep required information before approval."
msgstr "Đặt thông tin bắt buộc trước bước phê duyệt."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose how the workflow filters should match."
msgstr "Hãy chọn cách các bộ lọc của quy trình cần khớp."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose the specific fields that start this workflow."
msgstr "Hãy chọn các trường cụ thể sẽ bắt đầu quy trình này."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Before-change filters need a field-change trigger."
msgstr "Bộ lọc trước khi thay đổi cần cách bắt đầu theo thay đổi trường."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose who gets this."
msgstr "Hãy chọn người nhận."
