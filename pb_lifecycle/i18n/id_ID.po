#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Do the same steps for every line"
msgstr "Kerjakan langkah yang sama untuk setiap baris"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "An approval cannot be repeated for each line: one record has one approval."
msgstr "Persetujuan tidak bisa diulang untuk setiap baris: satu catatan punya satu persetujuan."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Moving the record to a stage cannot be repeated for each line."
msgstr "Memindahkan catatan ke suatu tahap tidak bisa diulang untuk setiap baris."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Starting another workflow cannot be repeated for each line."
msgstr "Memulai alur kerja lain tidak bisa diulang untuk setiap baris."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "A repeat cannot sit inside another repeat."
msgstr "Pengulangan tidak bisa berada di dalam pengulangan lain."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Work in parallel cannot sit inside a repeat. Use “Together” on the repeat instead."
msgstr "Pekerjaan paralel tidak bisa berada di dalam pengulangan. Gunakan “Sekaligus” pada pengulangan."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "A saved group cannot sit inside a repeat. Add its steps one by one."
msgstr "Grup tersimpan tidak bisa berada di dalam pengulangan. Tambahkan langkahnya satu per satu."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "A module action cannot be repeated for each line."
msgstr "Aksi modul tidak bisa diulang untuk setiap baris."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Updating the record cannot be repeated for each line yet."
msgstr "Memperbarui catatan belum bisa diulang untuk setiap baris."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Existing work is shown once, outside the repeat."
msgstr "Pekerjaan yang sudah ada ditampilkan sekali, di luar pengulangan."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "For each %(line)s"
msgstr "Untuk setiap %(line)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "For each person on %(team)s"
msgstr "Untuk setiap orang di %(team)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "For each line of “%(question)s”"
msgstr "Untuk setiap baris dari “%(question)s”"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "For each answer to “%(question)s”"
msgstr "Untuk setiap jawaban atas “%(question)s”"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "One by one"
msgstr "Satu per satu"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Together"
msgstr "Sekaligus"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "carries on when the first is done"
msgstr "berlanjut saat yang pertama selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "carries on when every one is done"
msgstr "berlanjut saat semuanya selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "%(lines)s on this %(record)s"
msgstr "%(lines)s di %(record)s ini"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Choose what to repeat for"
msgstr "Pilih apa yang diulang"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Answers to “%(question)s”"
msgstr "Jawaban atas “%(question)s”"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "People on %(team)s"
msgstr "Orang di %(team)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "People on a team"
msgstr "Orang di sebuah tim"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "%(why)s Put it before or after “%(step)s”."
msgstr "%(why)s Letakkan sebelum atau sesudah “%(step)s”."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Keep “Repeat for each…” on the main path, not inside a path or group."
msgstr "Letakkan “Ulangi untuk setiap…” di jalur utama, bukan di dalam jalur atau grup."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Add “Repeat for each…” on the main path, not inside a path or group."
msgstr "Tambahkan “Ulangi untuk setiap…” di jalur utama, bukan di dalam jalur atau grup."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Add the steps to do for each %(line)s, or drag steps in."
msgstr "Tambahkan langkah yang dikerjakan untuk setiap %(line)s, atau seret langkah ke sini."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Carries on when the first one is done"
msgstr "Berlanjut saat yang pertama selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Carries on when every one is done"
msgstr "Berlanjut saat semuanya selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "First one done"
msgstr "Yang pertama selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Every one done"
msgstr "Semuanya selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Lines of this %(record)s"
msgstr "Baris di %(record)s ini"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Answers to a list question"
msgstr "Jawaban atas pertanyaan daftar"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "%(question)s (in “%(step)s”)"
msgstr "%(question)s (di “%(step)s”)"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Repeat for"
msgstr "Ulangi untuk"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Lines of this record, the answers to a list question asked earlier, or the people on a team."
msgstr "Baris di catatan ini, jawaban atas pertanyaan daftar yang diajukan sebelumnya, atau orang di sebuah tim."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Looking at an example…"
msgstr "Melihat contoh…"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "How the lines run"
msgstr "Cara baris dijalankan"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "The next %(line)s starts when the one before it is done."
msgstr "Setiap %(line)s berikutnya dimulai saat yang sebelumnya selesai."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Every %(line)s starts at once."
msgstr "Setiap %(line)s dimulai bersamaan."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Carry on"
msgstr "Lanjutkan"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "When every %(line)s is done"
msgstr "Saat setiap %(line)s selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "When the first %(line)s is done"
msgstr "Saat %(line)s pertama selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "The other lines stop when the first one is done."
msgstr "Baris lainnya berhenti saat yang pertama selesai."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "At most"
msgstr "Paling banyak"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Up to %(cap)s. With more than this, nothing starts and it says why."
msgstr "Hingga %(cap)s. Jika lebih dari ini, tidak ada yang dimulai dan alasannya ditampilkan."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "The %(lines)s are read when the repeat starts. One added later is not picked up."
msgstr "Daftar %(lines)s dibaca saat pengulangan dimulai. Yang ditambahkan kemudian tidak ikut."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Add the steps to do for each %(line)s with the + inside the frame, or drag steps in."
msgstr "Tambahkan langkah yang dikerjakan untuk setiap %(line)s dengan tanda + di dalam bingkai, atau seret langkah ke sini."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "%(n)s step for each %(line)s: %(steps)s"
msgstr "%(n)s langkah untuk setiap %(line)s: %(steps)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "%(n)s steps for each %(line)s: %(steps)s"
msgstr "%(n)s langkah untuk setiap %(line)s: %(steps)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Runs %(each)s. Line details can be used in its rules and words."
msgstr "Dijalankan %(each)s. Detail baris bisa dipakai di aturan dan teksnya."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "This %(line)s"
msgstr "%(line)s ini"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "name"
msgstr "nama"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "number"
msgstr "nomor"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "how many %(lines)s"
msgstr "jumlah %(lines)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "how many done"
msgstr "jumlah yang selesai"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "how many “%(answer)s”"
msgstr "jumlah “%(answer)s”"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "The %(lines)s come in when the question is answered, so there is no example yet."
msgstr "Daftar %(lines)s masuk saat pertanyaan dijawab, jadi belum ada contoh."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "%(record)s has no %(lines)s at the moment."
msgstr "%(record)s saat ini tidak punya %(lines)s."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "%(record)s has %(count)s %(lines)s: %(names)s."
msgstr "%(record)s punya %(count)s %(lines)s: %(names)s."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "That is more than the %(cap)s this repeats for, so it would start none."
msgstr "Itu lebih dari batas %(cap)s untuk pengulangan ini, jadi tidak ada yang dimulai."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Retry %(line)s"
msgstr "Coba lagi %(line)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Each %(line)s"
msgstr "Setiap %(line)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Hide lines"
msgstr "Sembunyikan baris"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Show lines"
msgstr "Tampilkan baris"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Counted once, with all its lines"
msgstr "Dihitung sekali, dengan semua barisnya"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Tried that line again."
msgstr "Baris itu sudah dicoba lagi."

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Add a step for each %(line)s"
msgstr "Tambahkan langkah untuk setiap %(line)s"

#. module: pb_lifecycle
#. odoo-javascript
#: code:addons/pb_lifecycle/static/workflow/repeat.js:0
msgid "Approvals, stage moves, hand-overs and other once-per-record steps go before or after the repeat."
msgstr "Persetujuan, perpindahan tahap, penyerahan, dan langkah lain yang hanya sekali per catatan diletakkan sebelum atau sesudah pengulangan."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "This workflow format is not supported."
msgstr "Format alur kerja ini tidak didukung."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "This workflow timing setting is not supported."
msgstr "Pengaturan waktu alur kerja ini tidak didukung."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use 1–40 sections and at most 200 steps."
msgstr "Gunakan 1–40 bagian dan paling banyak 200 langkah."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A step identifier is not valid."
msgstr "Pengenal sebuah langkah tidak valid."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Each step needs a unique identifier and supported type."
msgstr "Setiap langkah perlu pengenal yang unik dan jenis yang didukung."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Give the step a name and a section."
msgstr "Beri langkah ini nama dan bagian."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use two to ten paths in a group."
msgstr "Gunakan dua sampai sepuluh jalur dalam satu grup."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Each path needs its own identifier and steps."
msgstr "Setiap jalur perlu pengenal dan langkahnya sendiri."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Only path groups can contain branches."
msgstr "Hanya grup jalur yang boleh berisi cabang."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Only a saved group can contain a step list."
msgstr "Hanya grup tersimpan yang boleh berisi daftar langkah."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A saved group needs a list of steps."
msgstr "Grup tersimpan perlu daftar langkah."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A repeat needs a list of steps."
msgstr "Pengulangan perlu daftar langkah."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A path and a step cannot share an identifier."
msgstr "Jalur dan langkah tidak boleh memakai pengenal yang sama."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep one start at the beginning."
msgstr "Pertahankan satu awal di bagian paling depan."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A step reference is missing."
msgstr "Ada rujukan langkah yang hilang."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep grouped work in its group’s section."
msgstr "Simpan pekerjaan dalam grup di bagian grupnya."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Each step must belong to exactly one path."
msgstr "Setiap langkah harus berada di tepat satu jalur."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "A group cannot contain itself. Use at most twelve nested groups."
msgstr "Grup tidak boleh berisi dirinya sendiri. Gunakan paling banyak dua belas grup bertingkat."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep steps in their section order."
msgstr "Pertahankan urutan langkah sesuai bagiannya."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use up to four levels and 20 filters in a group. Remove an empty group."
msgstr "Gunakan paling banyak empat tingkat dan 20 filter dalam satu grup. Hapus grup yang kosong."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose an available value and comparison."
msgstr "Pilih nilai dan perbandingan yang tersedia."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose one or more values for this filter."
msgstr "Pilih satu atau beberapa nilai untuk filter ini."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Start filters belong on Start. Approval decisions belong in the Approval Matrix."
msgstr "Filter awal ditempatkan di Mulai. Keputusan persetujuan ada di Matriks Persetujuan."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Only a wait step can wait for a condition."
msgstr "Hanya langkah tunggu yang bisa menunggu suatu syarat."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose a deadline from 1 to 365 days."
msgstr "Pilih tenggat 1 sampai 365 hari."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Write what the person is asked to read and confirm."
msgstr "Tulis apa yang perlu dibaca dan dikonfirmasi orang tersebut."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Write the notice, in up to 1,000 characters."
msgstr "Tulis pemberitahuan, paling banyak 1.000 karakter."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose the value to set."
msgstr "Pilih nilai yang akan diisi."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use an answer given earlier in this workflow."
msgstr "Gunakan jawaban yang diberikan sebelumnya di alur kerja ini."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose what to create."
msgstr "Pilih apa yang akan dibuat."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep the reason under 200 characters."
msgstr "Buat alasan kurang dari 200 karakter."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Send it back to an earlier task or form on the main path."
msgstr "Kembalikan ke tugas atau formulir sebelumnya di jalur utama."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose an available record field for the prefill."
msgstr "Pilih kolom catatan yang tersedia untuk isian awal."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose what this approval step should do."
msgstr "Pilih apa yang harus dilakukan langkah persetujuan ini."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose an existing email template."
msgstr "Pilih templat email yang sudah ada."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Set a wait of up to one year."
msgstr "Atur waktu tunggu paling lama satu tahun."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose how long to wait and what happens when time runs out."
msgstr "Pilih berapa lama menunggu dan apa yang terjadi saat waktu habis."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose an available business action."
msgstr "Pilih tindakan bisnis yang tersedia."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose the existing behaviour to reference."
msgstr "Pilih perilaku yang sudah ada untuk dirujuk."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep one Otherwise path, last."
msgstr "Pertahankan satu jalur Selain itu, di urutan terakhir."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose a join and add work to every parallel path."
msgstr "Pilih cara penggabungan dan tambahkan pekerjaan ke setiap jalur paralel."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use “Everyone finishes” for paths with approvals or automatic effects."
msgstr "Gunakan “Semua orang selesai” untuk jalur dengan persetujuan atau efek otomatis."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Add a step to this saved group."
msgstr "Tambahkan langkah ke grup tersimpan ini."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose whether the lines run together or one by one, and when to carry on."
msgstr "Pilih apakah baris berjalan bersamaan atau satu per satu, dan kapan dilanjutkan."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Add the steps to do for each line."
msgstr "Tambahkan langkah yang dikerjakan untuk setiap baris."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Use one Approval Matrix step."
msgstr "Gunakan satu langkah Matriks Persetujuan."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Keep required information before approval."
msgstr "Letakkan informasi wajib sebelum persetujuan."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose how the workflow filters should match."
msgstr "Pilih bagaimana filter alur kerja harus cocok."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose the specific fields that start this workflow."
msgstr "Pilih kolom tertentu yang memulai alur kerja ini."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Before-change filters need a field-change trigger."
msgstr "Filter sebelum perubahan memerlukan pemicu perubahan kolom."

#. module: pb_lifecycle
#. odoo-python
#: code:addons/pb_lifecycle/models/workflow_definition.py:0
msgid "Choose who gets this."
msgstr "Pilih siapa yang menerima ini."
