<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         THE LADDER. Cloned from pb_hr_workforce_planning/security, which is
         the Odoo 19 shape: a privilege record instead of `category_id` on
         the group (that field no longer exists), and each tier implying the
         one below it so a manager never has to be granted the user tier by
         hand.

           user     look at the journeys of the companies you work in, and
                    finish the steps you own
           manager  run journeys: open, hold, reassign, add a step, record a
                    check-in, ask for feedback
           admin    change the checklists and the letters everyone else uses

         Nobody is hardcoded into a group here. The administrator reaches
         admin through `base.user_admin`, exactly as the planning module does,
         and every other membership is a deliberate act on the user's record.
         ================================================================== -->

    <record id="module_category_lifecycle" model="ir.module.category">
        <field name="name">Employee Lifecycle</field>
        <field name="sequence">52</field>
    </record>

    <record id="res_groups_privilege_lifecycle" model="res.groups.privilege">
        <field name="name">Employee Lifecycle</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_lifecycle"/>
    </record>

    <record id="group_lifecycle_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_lifecycle"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">See the journeys running in your companies and finish the steps you own.</field>
    </record>

    <record id="group_lifecycle_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_lifecycle"/>
        <field name="implied_ids" eval="[(4, ref('group_lifecycle_user'))]"/>
        <field name="comment">Start and run journeys, reassign steps, record check-ins, ask for feedback and prepare letters.</field>
    </record>

    <record id="group_lifecycle_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_lifecycle"/>
        <field name="implied_ids" eval="[(4, ref('group_lifecycle_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Change the checklists and the letter templates everyone else uses.</field>
    </record>

<data noupdate="1">

    <!-- ==================================================================
         COMPANY SCOPE. The same domain every Payobook model uses, so a
         record with no company is shared and everything else is scoped to
         the companies the reader is actually working in.
         ================================================================== -->

    <record id="rule_journey_template_company" model="ir.rule">
        <field name="name">Journey checklist: company</field>
        <field name="model_id" ref="model_pb_journey_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_journey_template_step_company" model="ir.rule">
        <field name="name">Journey step: company</field>
        <field name="model_id" ref="model_pb_journey_template_step"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_journey_case_company" model="ir.rule">
        <field name="name">Journey: company</field>
        <field name="model_id" ref="model_pb_journey_case"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_journey_task_company" model="ir.rule">
        <field name="name">Journey step (running): company</field>
        <field name="model_id" ref="model_pb_journey_task"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_checkin_company" model="ir.rule">
        <field name="name">Check-in: company</field>
        <field name="model_id" ref="model_pb_employee_checkin"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_feedback_company" model="ir.rule">
        <field name="name">Feedback request: company</field>
        <field name="model_id" ref="model_pb_feedback_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_letter_template_company" model="ir.rule">
        <field name="name">Letter template: company</field>
        <field name="model_id" ref="model_pb_letter_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hr_letter_company" model="ir.rule">
        <field name="name">Letter: company</field>
        <field name="model_id" ref="model_pb_hr_letter"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ==================================================================
         WHAT A PLAIN USER MAY SEE OF THE RUNNING STEPS.

         A step is somebody's private to-do list until it is theirs: the user
         tier sees the steps it OWNS and the steps on its OWN journey, and
         nothing else. Managers get the permissive rule, which is what makes
         the board a board.

         Both rules are `global=False` (group rules), and Odoo ORs group rules
         together — so a manager who also holds the user tier is not narrowed
         by the tighter one.
         ================================================================== -->

    <record id="rule_journey_task_own" model="ir.rule">
        <field name="name">Journey step: mine</field>
        <field name="model_id" ref="model_pb_journey_task"/>
        <field name="groups" eval="[(4, ref('group_lifecycle_user'))]"/>
        <field name="domain_force">['|', ('assignee_user_id', '=', user.id), ('case_id.employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_journey_task_all" model="ir.rule">
        <field name="name">Journey step: the lifecycle team</field>
        <field name="model_id" ref="model_pb_journey_task"/>
        <field name="groups" eval="[(4, ref('group_lifecycle_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_journey_case_own" model="ir.rule">
        <field name="name">Journey: mine</field>
        <field name="model_id" ref="model_pb_journey_case"/>
        <field name="groups" eval="[(4, ref('group_lifecycle_user'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('task_ids.assignee_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_journey_case_all" model="ir.rule">
        <field name="name">Journey: the lifecycle team</field>
        <field name="model_id" ref="model_pb_journey_case"/>
        <field name="groups" eval="[(4, ref('group_lifecycle_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</data>
</odoo>
