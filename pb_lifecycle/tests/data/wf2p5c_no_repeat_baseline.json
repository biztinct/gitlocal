 {
  "definition": {
   "name": "Receipts check",
   "nodes": [
    {
     "id": "trigger",
     "stage": 0,
     "title": "Start",
     "type": "trigger"
    },
    {
     "due": 2,
     "form": {
      "fields": [
       {
        "id": "purpose",
        "label": "Purpose",
        "required": true,
        "type": "text"
       },
       {
        "bind": "amount",
        "id": "amount",
        "label": "Amount",
        "type": "number"
       }
      ]
     },
     "id": "details",
     "owner": {
      "kind": "initiator"
     },
     "stage": 0,
     "title": "Receipt details",
     "type": "input"
    },
    {
     "buttons": [
      {
       "key": "fine",
       "label": "Looks fine"
      },
      {
       "key": "missing",
       "label": "Paper receipt missing"
      }
     ],
     "due": 2,
     "id": "check",
     "owner": {
      "id": 7,
      "kind": "user"
     },
     "stage": 0,
     "title": "check",
     "type": "task"
    },
    {
     "branches": [
      {
       "condition": {
        "match": "all",
        "rules": [
         {
          "field": "step.check.outcome",
          "op": "eq",
          "value": "missing"
         }
        ]
       },
       "id": "p_missing",
       "label": "Missing",
       "steps": [
        "back"
       ]
      },
      {
       "id": "p_else",
       "label": "Otherwise",
       "steps": [
        "tell"
       ]
      }
     ],
     "id": "route",
     "stage": 0,
     "title": "Route",
     "type": "branch"
    },
    {
     "id": "back",
     "stage": 0,
     "target": "details",
     "title": "Back to details",
     "type": "send_back"
    },
    {
     "id": "tell",
     "owner": {
      "kind": "initiator"
     },
     "stage": 0,
     "text": "Thanks {{step.details.purpose}}",
     "title": "Tell them",
     "type": "notify"
    }
   ],
   "order": [
    "trigger",
    "details",
    "check",
    "route"
   ],
   "schema": "payobook.workflow/1",
   "scope": {
    "match": "all",
    "rules": []
   },
   "stages": [
    {
     "name": "Prepare"
    },
    {
     "name": "Do the work"
    },
