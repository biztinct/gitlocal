<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The page of a document (contract C3, pb_doc_studio.page_frame) learns
         how a contract lays out its two-column clauses (local language left,
         English right) and the two signature columns. Plain CSS the PDF
         engine (an old WebKit) understands; it only touches tables carrying
         these two classes, so every other document prints exactly as before.
         `!important` because the company's report layout (o_table_standard
         and friends) draws its own table borders on PDFs. -->
    <template id="page_frame_contract" inherit_id="pb_doc_studio.page_frame">
        <xpath expr="//style" position="after">
            <style>
.pbds-page table.pbdc-bi { table-layout: fixed; margin: 0; border: none !important; }
.pbds-page table.pbdc-bi tbody, .pbds-page table.pbdc-bi tr { border: none !important; }
.pbds-page table.pbdc-bi tr { page-break-inside: avoid; }
.pbds-page table.pbdc-bi td { width: 50%; border: none !important; border-top: 1px solid #e2e4ee !important; padding: 7px 12px 5px 0; }
.pbds-page table.pbdc-bi td + td { padding: 7px 0 5px 12px; border-left: 1px solid #e2e4ee !important; color: #3f4a5c; }
.pbds-page table.pbdc-bi p { margin: 0 0 0.45em; }
.pbds-page table.pbdc-sign { table-layout: fixed; margin-top: 30px; page-break-inside: avoid; border: none !important; }
.pbds-page table.pbdc-sign tbody, .pbds-page table.pbdc-sign tr { border: none !important; }
.pbds-page table.pbdc-sign td { width: 50%; border: none !important; padding: 0 14px 0 0; }
.pbds-page table.pbdc-sign p { margin: 0 0 0.3em; }
.pbds-page table.pbdc-sign td > p:nth-child(3) { border-bottom: 1px solid #94a3b8; width: 75%; margin-bottom: 0.5em; }
            </style>
        </xpath>
    </template>
</odoo>
