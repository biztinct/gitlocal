#. module: pb_hr_payroll_singapore
#: model:ir.ui.view,string:pb_hr_payroll_singapore.view_payroll_dashboard_singapore
msgid "Singapore Payroll Dashboard"
msgstr "ផ្ទាំងគ្រប់គ្រងប៉ាវរូលឆ្ងាយឆ្ងាយ"

#: model:ir.ui.menu,name:pb_hr_payroll_singapore.menu_singapore_dashboard
msgid "Singapore Dashboard"
msgstr "ផ្ទាំងគ្រប់គ្រងឆ្ងាយឆ្ងាយ"

#: model:ir.ui.menu,name:pb_hr_payroll_singapore.menu_singapore_cpf
msgid "Singapore CPF Submission"
msgstr "ដាក់ស្នើ CPF ឆ្ងាយឆ្ងាយ"

#: field:hr.payslip,singapore_cpf_employee:0
msgid "CPF - Employee"
msgstr "CPF - និយោជក"

#: field:hr.payslip,singapore_cpf_company:0
msgid "CPF - Company"
msgstr "CPF - ក្រុមហ៊ុន"

#: field:hr.payslip,singapore_sdl:0
msgid "Skills Development Levy"
msgstr "អាករលម្អិតលម្អិតមូលនិធិលម្អិត"

#: field:hr.payslip,singapore_fwl:0
msgid "Foreign Worker Levy"
msgstr "អាករកម្មករបរទេស"

#: button:hr.payslip,action_compute_singapore_tax:0
msgid "Compute Singapore Tax"
msgstr "គណនាពន្ធឆ្ងាយឆ្ងាយ"

#: view:hr.payslip:0
msgid "Singapore Payslip"
msgstr "ឯកសារប៉ាវរូលឆ្ងាយឆ្ងាយ"

#: view:hr.payslip:0
msgid "Singapore Salary Rules"
msgstr "ច្បាប់លម្អិតលម្អិតឆ្ងាយឆ្ងាយ"

#: view:hr.payslip:0
msgid "Singapore CPF Components"
msgstr "សមាសភាគ CPF ឆ្ងាយឆ្ងាយ"

#: code:addons/pb_hr_payroll_singapore/models/hr_payslip_singapore.py:50
msgid "Singapore tax computed successfully"
msgstr "ពន្ធឆ្ងាយឆ្ងាយបានគណនាដោយជោគជ័យ"

#: code:addons/pb_hr_payroll_singapore/models/hr_payslip_singapore.py:60
msgid "Error computing Singapore tax: %s"
msgstr "កំហុសក្នុងការគណនាពន្ធឆ្ងាយឆ្ងាយ៖ %s"

#: help:hr.payslip,singapore_cpf_employee:0
msgid "CPF contribution deducted from employee salary"
msgstr "ការរួមបង្កើត CPF ត្រូវបានកាត់ចេញពីលម្អិតលម្អិតនិយោជក"

#: help:hr.payslip,singapore_cpf_company:0
msgid "CPF contribution paid by company"
msgstr "ការរួមបង្កើត CPF ត្រូវបានបង់ដោយក្រុមហ៊ុន"

#: help:hr.payslip,singapore_sdl:0
msgid "0.25% Skills Development Levy (if payroll > S$30,000 annually)"
msgstr "អាករលម្អិតលម្អិតមូលនិធិលម្អិត 0.25% (ប្រសិនបើប៉ាវរូល > S$30.000 ក្នុងមួយឆ្នាំ)"

#: res.groups,name:pb_hr_payroll_singapore.group_singapore_payroll_officer
msgid "Singapore Payroll Officer"
msgstr "មន្ត្រីប៉ាវរូលឆ្ងាយឆ្ងាយ"

#: button:payroll.dashboard,action_process_singapore_payroll:0
msgid "Process Singapore Payroll"
msgstr "ដំណើរការប៉ាវរូលឆ្ងាយឆ្ងាយ"

#: button:payroll.dashboard,action_submit_cpf:0
msgid "Submit CPF"
msgstr "ដាក់ស្នើ CPF"

#: button:payroll.dashboard,action_export_singapore_data:0
msgid "Export Singapore Data"
msgstr "នាំចេញទិន្នន័យឆ្ងាយឆ្ងាយ"

#: dashboard.payroll:0
msgid "Singapore Payroll Management System"
msgstr "ប្រព័ន្ធគ្រប់គ្រងប៉ាវរូលឆ្ងាយឆ្ងាយ"

#: dashboard.payroll:0
msgid "CPF Management and Submission"
msgstr "គ្រប់គ្រង និង ដាក់ស្នើ CPF"

#: dashboard.payroll:0
msgid "SDL and FWL Management"
msgstr "គ្រប់គ្រង SDL និង FWL"

#: dashboard.payroll:0
msgid "Monthly Payroll Processing"
msgstr "ដំណើរការប៉ាវរូលប្រចាំខែ"
