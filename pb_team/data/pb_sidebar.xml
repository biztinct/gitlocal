<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Workforce section. Visible to every internal user (the cockpit shows a
         friendly empty-state when the user has no direct reports); managers see
         their queue.

         RENAMED by Workforce P1b: "My Team" -> "Approvals", icon `inbox`, and
         moved from the top of the rail (5) to 70. The name now says what the
         surface is FOR — it is the manager's decision queue, not a directory —
         and the rail reads as the week's loop with the queue near its end
         rather than as an org chart at its top. Label/icon/sequence only. -->
    <record id="item_my_team" model="pb.sidebar.item">
        <field name="section_id" ref="pb_sidebar.sec_workforce"/>
        <field name="name">Approvals</field>
        <field name="icon">inbox</field>
        <field name="sequence">70</field>
        <field name="action_xmlid">pb_team.action_pb_team</field>
        <field name="action_tag">pb_team</field>
        <field name="match_action_tags">pb_team</field>
    </record>
</odoo>
