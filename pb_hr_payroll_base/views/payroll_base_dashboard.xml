<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Base Dashboard Form View -->
    <record id="view_payroll_dashboard_form_base" model="ir.ui.view">
        <field name="name">payroll.dashboard.form.base</field>
        <field name="model">payroll.dashboard</field>
        <field name="arch" type="xml">
            <form string="Payroll Dashboard" create="false" edit="false" delete="false">
                <header>
                    <button name="action_get_employee_data" type="object" string="Get Employee Data" 
                            class="btn-primary" icon="fa-download"/>
                    <button name="action_edit_spreadsheet" type="object" string="Edit Spreadsheet" 
                            class="btn-secondary" icon="fa-table"/>
                    <button name="action_import_spreadsheet" type="object" string="Import Spreadsheet" 
                            class="btn-info" icon="fa-upload"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="country" widget="badge" readonly="1"/>
                        </h3>
                    </div>
                    
                    <!-- Statistics Dashboard -->
                    <div class="row">
                        <div class="col-lg-3 col-6">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <h3 class="mb-2"><field name="total_employees" readonly="1"/></h3>
                                            <p class="mb-0">Total Employees</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa fa-users fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-3 col-6">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <h3 class="mb-2"><field name="active_contracts" readonly="1"/></h3>
                                            <p class="mb-0">Active Contracts</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa fa-file-text fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-3 col-6">
                            <div class="card bg-warning text-white">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <h3 class="mb-2"><field name="pending_payslips" readonly="1"/></h3>
                                            <p class="mb-0">Pending Payslips</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa fa-clock-o fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-lg-3 col-6">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <div class="flex-grow-1">
                                            <h3 class="mb-2"><field name="currency_id" readonly="1"/></h3>
                                            <p class="mb-0">Currency</p>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa fa-money fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Quick Actions -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5>Quick Actions</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <button name="action_view_employees" type="object" 
                                                    string="View Employees" class="btn btn-outline-primary btn-block"
                                                    icon="fa-users"/>
                                        </div>
                                        <div class="col-md-4">
                                            <button name="action_view_payslips" type="object" 
                                                    string="View Payslips" class="btn btn-outline-secondary btn-block"
                                                    icon="fa-file-text"/>
                                        </div>
                                        <div class="col-md-4">
                                            <button name="%(action_payroll_country_selector)d" type="action" 
                                                    string="Switch Country" class="btn btn-outline-info btn-block"
                                                    icon="fa-globe"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Configuration Information -->
                    <group string="Configuration">
                        <group>
                            <field name="structure_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Base Dashboard Tree View -->
    <record id="view_payroll_dashboard_tree_base" model="ir.ui.view">
        <field name="name">payroll.dashboard.tree.base</field>
        <field name="model">payroll.dashboard</field>
        <field name="arch" type="xml">
            <tree string="Payroll Dashboards" create="false" delete="false">
                <field name="name"/>
                <field name="country"/>
                <field name="total_employees"/>
                <field name="active_contracts"/>
                <field name="pending_payslips"/>
                <field name="currency_id"/>
            </tree>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_payroll_dashboard_base" model="ir.actions.act_window">
        <field name="name">Payroll Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form,tree</field>
        <field name="view_id" ref="view_payroll_dashboard_form_base"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>