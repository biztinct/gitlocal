<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Country Selector Form View -->
    <record id="view_payroll_country_selector_form" model="ir.ui.view">
        <field name="name">payroll.country.selector.form</field>
        <field name="model">payroll.country.selector</field>
        <field name="arch" type="xml">
            <form string="Select Payroll Country">
                <sheet>
                    <div class="oe_title">
                        <h1>Select Payroll Country</h1>
                        <p>Choose the country for payroll management</p>
                    </div>
                    
                    <group>
                        <field name="country" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_select_country" type="object" string="Open Dashboard" 
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Country Selector Action -->
    <record id="action_payroll_country_selector" model="ir.actions.act_window">
        <field name="name">Select Payroll Country</field>
        <field name="res_model">payroll.country.selector</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_country_selector_form"/>
        <field name="target">new</field>
    </record>

    <!-- Country Selector Wizard Form -->
    <record id="view_country_selector_wizard_form" model="ir.ui.view">
        <field name="name">country.selector.wizard.form</field>
        <field name="model">country.selector.wizard</field>
        <field name="arch" type="xml">
            <form string="Country Selector">
                <sheet>
                    <div class="oe_title">
                        <h1>Multi-Country Payroll</h1>
                        <p>Select your payroll country to get started</p>
                    </div>
                    
                    <div class="row">
                        <div class="col-12">
                            <field name="country" widget="radio" options="{'horizontal': false}"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button name="action_open_country_payroll" type="object" string="Open Payroll" 
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Country Selector Wizard Action -->
    <record id="action_country_selector_wizard" model="ir.actions.act_window">
        <field name="name">Payroll Country Selector</field>
        <field name="res_model">country.selector.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_country_selector_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>