<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full Enhanced Dashboard Views with Animations and All Features -->
    
    <!-- Enhanced Base Dashboard Form View -->
    <record id="view_payroll_dashboard_form_enhanced" model="ir.ui.view">
        <field name="name">payroll.dashboard.form.enhanced</field>
        <field name="model">payroll.dashboard</field>
        <field name="arch" type="xml">
            <form string="Enhanced Payroll Dashboard" class="payroll_dashboard_enhanced">
                <!-- Full Enhanced Header -->
                <header>
                    <button string="Refresh Analytics" name="action_refresh_analytics" type="object" class="btn-primary"/>
                    <button string="Export Report" name="action_export_dashboard" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,maintenance,inactive"/>
                </header>
                
                <sheet>

                    <!-- Enhanced Dashboard Header -->
                    <div class="dashboard-header-enhanced">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2>Professional Multi-Country Payroll Management System</h2>
                    </div>

                    <!-- Enhanced Dashboard Content -->
                    <notebook>
                        <page string="Dashboard Overview" name="dashboard_overview">
                            <div class="dashboard-container-enhanced">
                                
                                <!-- Enhanced Key Metrics Section with Animations -->
                                <div class="metrics-grid-enhanced">
                                    <div class="metric-item-enhanced metric-employees fade-in-enhanced">
                                        <i class="fa fa-users metric-icon-enhanced"/>
                                        <div class="metric-value-enhanced"><field name="total_employees" readonly="1"/></div>
                                        <div class="metric-label-enhanced">Total Employees</div>
                                    </div>
                                    
                                    <div class="metric-item-enhanced metric-payroll fade-in-enhanced">
                                        <i class="fa fa-money metric-icon-enhanced"/>
                                        <div class="metric-value-enhanced"><field name="total_payroll" readonly="1"/></div>
                                        <div class="metric-label-enhanced">Total Payroll</div>
                                    </div>
                                    
                                    <div class="metric-item-enhanced metric-average fade-in-enhanced">
                                        <i class="fa fa-trending-up metric-icon-enhanced"/>
                                        <div class="metric-value-enhanced"><field name="average_salary" readonly="1"/></div>
                                        <div class="metric-label-enhanced">Average Salary</div>
                                    </div>
                                    
                                    <div class="metric-item-enhanced metric-calendar fade-in-enhanced">
                                        <i class="fa fa-calendar metric-icon-enhanced"/>
                                        <div class="metric-value-enhanced"><field name="last_payroll_date" readonly="1"/></div>
                                        <div class="metric-label-enhanced">Last Payroll</div>
                                    </div>
                                </div>

                                <!-- Enhanced Action Cards Grid with Animations -->
                                <div class="dashboard-cards-grid-enhanced">
                                    
                                    <!-- Employee Data Management Card -->
                                    <div class="dashboard-card-enhanced slide-in-left">
                                        <div class="card-content-enhanced">
                                            <i class="fa fa-users fa-3x card-icon-enhanced"/>
                                            <h4 class="card-title-enhanced">Employee Data Management</h4>
                                            <p class="card-description-enhanced">
                                                Import and manage employee information from Zoho People system with automated data synchronization and validation.
                                            </p>
                                            <button name="action_import_employee_data" type="object" class="dashboard-btn-enhanced">
                                                <i class="fa fa-download"/> Import Employee Data
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Payroll Processing Card -->
                                    <div class="dashboard-card-enhanced slide-in-right">
                                        <div class="card-content-enhanced">
                                            <i class="fa fa-calculator fa-3x card-icon-enhanced"/>
                                            <h4 class="card-title-enhanced">Payroll Processing</h4>
                                            <p class="card-description-enhanced">
                                                Process monthly payroll with automated calculations, tax deductions, compliance validation, and audit trails.
                                            </p>
                                            <button name="action_process_payroll" type="object" class="dashboard-btn-enhanced">
                                                <i class="fa fa-play"/> Process Payroll
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Payroll Spreadsheet Card -->
                                    <div class="dashboard-card-enhanced slide-in-left">
                                        <div class="card-content-enhanced">
                                            <i class="fa fa-table fa-3x card-icon-enhanced"/>
                                            <h4 class="card-title-enhanced">Interactive Spreadsheet</h4>
                                            <p class="card-description-enhanced">
                                                Access interactive payroll spreadsheet for detailed salary component management, calculations, and data analysis.
                                            </p>
                                            <button name="action_open_payroll_spreadsheet" type="object" class="dashboard-btn-enhanced secondary">
                                                <i class="fa fa-external-link"/> Open Spreadsheet
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Analytics and Reports Card -->
                                    <div class="dashboard-card-enhanced slide-in-right">
                                        <div class="card-content-enhanced">
                                            <i class="fa fa-bar-chart fa-3x card-icon-enhanced"/>
                                            <h4 class="card-title-enhanced">Advanced Analytics</h4>
                                            <p class="card-description-enhanced">
                                                Comprehensive payroll analytics with month-over-month comparisons, trend analysis, and detailed reporting capabilities.
                                            </p>
                                            <button name="action_view_analytics" type="object" class="dashboard-btn-enhanced info">
                                                <i class="fa fa-chart-line"/> View Analytics
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Bank Export Card -->
                                    <div class="dashboard-card-enhanced slide-in-left">
                                        <div class="card-content-enhanced">
                                            <i class="fa fa-bank fa-3x card-icon-enhanced"/>
                                            <h4 class="card-title-enhanced">Bank File Export</h4>
                                            <p class="card-description-enhanced">
                                                Export payroll data to bank format for automated salary disbursement and payment processing with validation.
                                            </p>
                                            <button name="action_export_bank_file" type="object" class="dashboard-btn-enhanced success">
                                                <i class="fa fa-upload"/> Export Bank File
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Approval Workflow Card -->
                                    <div class="dashboard-card-enhanced slide-in-right">
                                        <div class="card-content-enhanced">
                                            <i class="fa fa-check-circle fa-3x card-icon-enhanced"/>
                                            <h4 class="card-title-enhanced">Approval Workflow</h4>
                                            <p class="card-description-enhanced">
                                                Manage payroll approvals with multi-level review process, audit trail tracking, and automated notifications.
                                            </p>
                                            <button name="action_approval_dashboard" type="object" class="dashboard-btn-enhanced warning">
                                                <i class="fa fa-tasks"/> Approval Dashboard
                                            </button>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </page>

                        <page string="Country Configuration" name="country_config">
                            <group>
                                <group string="Basic Information">
                                    <field name="country"/>
                                    <field name="currency_id"/>
                                    <field name="active"/>
                                    <field name="sequence"/>
                                    <field name="state"/>
                                </group>
                                <group string="Enhanced Statistics">
                                    <field name="employee_count"/>
                                    <field name="total_payroll"/>
                                    <field name="average_salary"/>
                                    <field name="last_payroll_date"/>
                                </group>
                            </group>
                            
                            <group string="Integration and Analytics">
                                <group string="Zoho Integration">
                                    <field name="zoho_connection_status"/>
                                    <field name="last_sync_date"/>
                                    <field name="auto_sync_enabled"/>
                                </group>
                                
                                <group string="Analytics Configuration">
                                    <field name="analytics_enabled"/>
                                </group>
                            </group>
                        </page>

                        <page string="System Information" name="system_info">
                            <group string="Record Information">
                                <field name="create_date" readonly="1"/>
                                <field name="write_date" readonly="1"/>
                                <field name="create_uid" readonly="1"/>
                                <field name="write_uid" readonly="1"/>
                            </group>
                            
                            <div class="alert alert-info mt-3">
                                <h5><i class="fa fa-info-circle mr-2"/>Enhanced Payroll Framework</h5>
                                <p>This enhanced framework provides:</p>
                                <ul>
                                    <li>Professional Indonesia theme integration (#21435F color scheme)</li>
                                    <li>Animated country selector with permission management</li>
                                    <li>Mobile-responsive design with modern animations</li>
                                    <li>Optimized asset loading and improved performance</li>
                                    <li>Multi-country support with extensible architecture</li>
                                    <li>Advanced analytics and reporting capabilities</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Enhanced Kanban View with Large Animated Flags -->
    <record id="view_payroll_dashboard_kanban_enhanced" model="ir.ui.view">
        <field name="name">payroll.dashboard.kanban.enhanced</field>
        <field name="model">payroll.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard_payroll_enhanced" create="false" edit="false">
                <field name="name"/>
                <field name="country"/>
                <field name="currency_id"/>
                <field name="active"/>
                <field name="total_employees"/>
                <field name="total_payroll"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="payroll-country-card-enhanced fade-in-enhanced" t-att-data-country="record.country.raw_value">
                            <div class="country-card-header-enhanced">
                                <!-- Large Animated Country Flag -->
                                <div class="country-flag-large">
                                    <t t-if="record.country.raw_value == 'VN'">🇻🇳</t>
                                    <t t-if="record.country.raw_value == 'ID'">🇮🇩</t>
                                    <t t-if="record.country.raw_value == 'IN'">🇮🇳</t>
                                    <t t-if="record.country.raw_value == 'SG'">🇸🇬</t>
                                    <t t-if="record.country.raw_value == 'MY'">🇲🇾</t>
                                    <t t-if="record.country.raw_value == 'TH'">🇹🇭</t>
                                    <t t-if="record.country.raw_value == 'KH'">🇰🇭</t>
                                    <t t-if="record.country.raw_value == 'PH'">🇵🇭</t>
                                </div>
                                
                                <!-- Enhanced Access Status Badge with Animation -->
                                <div class="access-status-badge">
                                    <span class="access-tick">✓</span>
                                </div>
                                
                                <!-- Country Title -->
                                <h3 class="country-title" t-esc="record.name.value"/>
                                
                                <!-- State Badge -->
                                <div class="state-badge">
                                    <span t-attf-class="badge badge-#{record.state.raw_value == 'active' ? 'success' : record.state.raw_value == 'maintenance' ? 'warning' : 'secondary'}" 
                                          t-esc="record.state.value"/>
                                </div>
                            </div>
                            
                            <!-- Enhanced Country Card Content -->
                            <div class="country-card-content-enhanced">
                                <div class="country-stats">
                                    <div class="stat-item">
                                        <i class="fa fa-users"/>
                                        <span class="stat-value" t-esc="record.total_employees.value"/>
                                        <span class="stat-label">Employees</span>
                                    </div>
                                    <div class="stat-item">
                                        <i class="fa fa-money"/>
                                        <span class="stat-value">
                                            <!-- FIXED: Show correct currency symbol based on country -->
                                            <t t-if="record.country.raw_value == 'VN'">₫ <t t-esc="record.total_payroll.raw_value"/></t>
                                            <t t-if="record.country.raw_value == 'ID'">Rp <t t-esc="record.total_payroll.raw_value"/></t>
                                            <t t-if="record.country.raw_value == 'IN'">₹ <t t-esc="record.total_payroll.raw_value"/></t>
                                            <t t-if="record.country.raw_value == 'SG'">S$ <t t-esc="record.total_payroll.raw_value"/></t>
                                            <t t-if="record.country.raw_value == 'MY'">RM <t t-esc="record.total_payroll.raw_value"/></t>
                                            <t t-if="record.country.raw_value == 'TH'">฿ <t t-esc="record.total_payroll.raw_value"/></t>
                                            <t t-if="record.country.raw_value == 'KH'">៛ <t t-esc="record.total_payroll.raw_value"/></t>
                                            <t t-if="record.country.raw_value == 'PH'">₱ <t t-esc="record.total_payroll.raw_value"/></t>
                                        </span>
                                        <span class="stat-label">Payroll</span>
                                    </div>
                                </div>
                                <!--
                                <div class="last-updated-enhanced">
                                    <span class="status-indicator status-active"/>
                                    Enhanced framework with animations
                                </div>
                                -->
                            </div>
                            
                            <!-- Enhanced Action Buttons -->
                            <div class="country-card-actions-enhanced">
                                <!-- New workflow button to open HR Flow dashboard -->
                                <button type="object"
                                        name="action_open_hr_flow_wizard"
                                        class="btn btn-secondary dashboard-access-btn">
                                    <i class="fa fa-sitemap"/> Dashboard
                                </button>
                                <button name="action_refresh_analytics" type="object" class="btn btn-outline-secondary btn-sm">
                                    <i class="fa fa-refresh"/> Refresh
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Enhanced Tree View -->
    <record id="view_payroll_dashboard_tree_enhanced" model="ir.ui.view">
        <field name="name">payroll.dashboard.tree.enhanced</field>
        <field name="model">payroll.dashboard</field>
        <field name="arch" type="xml">
            <tree string="Enhanced Payroll Dashboards" 
                  decoration-success="state=='active'" 
                  decoration-warning="state=='maintenance'"
                  decoration-muted="state=='inactive'">
                <field name="name"/>
                <field name="country"/>
                <field name="total_employees"/>
                <field name="total_payroll"/>
                <field name="state"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="active"/>
                <field name="write_date" string="Last Modified"/>
            </tree>
        </field>
    </record>

    <!-- Enhanced Search View -->
    <record id="view_payroll_dashboard_search_enhanced" model="ir.ui.view">
        <field name="name">payroll.dashboard.search.enhanced</field>
        <field name="model">payroll.dashboard</field>
        <field name="arch" type="xml">
            <search string="Search Enhanced Payroll Dashboards">
                <field name="name" string="Dashboard Name"/>
                <field name="country" string="Country"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Active Status" name="state_active" domain="[('state', '=', 'active')]"/>
                <filter string="Maintenance" name="state_maintenance" domain="[('state', '=', 'maintenance')]"/>
                <filter string="Has Employees" name="has_employees" domain="[('total_employees', '>', 0)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'country'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Currency" name="group_currency" context="{'group_by': 'currency_id'}"/>
                    <filter string="Status" name="group_active" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Enhanced Actions -->
    <record id="action_payroll_dashboard_enhanced" model="ir.actions.act_window">
        <field name="name">Enhanced Multi-Country Payroll Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_payroll_dashboard_kanban_enhanced"/>
        <field name="context">{'create': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Welcome to Enhanced Multi-Country Payroll System!
            </p>
            <p>
                Create professional dashboards for each country with animated flags, advanced analytics, 
                and comprehensive payroll management capabilities.
            </p>
            <ul>
                <li>🇻🇳 Vietnam - Full payroll management with VND currency</li>
                <li>🇮🇩 Indonesia - BPJS, PPh 21, THR payments with IDR currency</li>
                <li>🇮🇳 India - PF, ESI, Professional Tax with INR currency</li>
                <li>🇹🇭 Thailand - SSF, Provident Fund with THB currency</li>
                <li>🇰🇭 Cambodia - NSSF management with KHR currency</li>
                <li>🇲🇾 Malaysia - EPF, SOCSO, EIS with MYR currency</li>
                <li>🇸🇬 Singapore - CPF and SGD support</li>
            </ul>
        </field>
    </record>

    <!-- Enhanced Country Selector Action -->
    <record id="action_enhanced_country_selector" model="ir.actions.act_window">
        <field name="name">Country Selector</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_payroll_dashboard_kanban_enhanced"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'enhanced_selector': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Select Your Payroll Region
            </p>
            <p>
                Choose your country to access the appropriate payroll dashboard.
            </p>
        </field>
    </record>

</odoo>
