<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enhanced Zoho Integration Menu Structure -->
    
    <!-- Make sure the parent menu exists first - Create it if it doesn't exist -->
    
    <menuitem id="menu_payroll_zoho" 
              name="Zoho Integration" 
              parent="pb_hr_payroll_base.menu_payroll_backup_root"
              sequence="70"/>
    


    <!-- Processing Actions -->
    <record id="action_process_staging_batch" model="ir.actions.server">
        <field name="name">Process Staging Batch</field>
        <field name="model_id" ref="om_hr_payroll.model_zoho_staging_data"/>
        <field name="binding_model_id" ref="om_hr_payroll.model_zoho_staging_data"/>
        <field name="state">code</field>
        <field name="code">
            for record in records:
                if hasattr(record, 'processing_status') and record.processing_status == 'draft':
                    if hasattr(record, 'action_process_to_employee'):
                        record.action_process_to_employee()
        </field>
    </record>

    <!-- Dashboard Integration -->
    <record id="action_payroll_dashboard_country" model="ir.actions.act_window">
        <field name="name">Country Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up country dashboards
            </p>
            <p>
                Create dashboards for each country to track payroll statistics and performance.
            </p>
        </field>
    </record>

    <!-- Removed redundant Country Dashboards and Country Navigator menus -->
    <!-- Individual country dashboards are now properly organized under Dashboard section -->
</odoo>