<!-- Country Selector Action - Dashboard Kanban (RECOMMENDED) -->
<record id="action_country_selector_dashboard" model="ir.actions.act_window">
    <field name="name">Select Country Dashboard</field>
    <field name="res_model">payroll.dashboard</field>
    <field name="view_mode">kanban</field>
    <field name="target">current</field>
    <field name="context">{'create': False}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Welcome to Multi-Country Payroll!
        </p>
        <p>
            Create dashboards for each country to manage payroll operations.
        </p>
    </field>
</record>

<menuitem id="menu_country_selector" 
          name="Country Navigator" 
          parent="menu_payroll_main"
          action="action_country_selector_dashboard"
          sequence="5"/>
</odoo>