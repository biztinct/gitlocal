<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-Country Payroll privilege under PAYROLL category -->
        <record id="res_groups_privilege_multi_country" model="res.groups.privilege">
            <field name="name">Multi-Country Payroll</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="om_hr_payroll.module_category_payroll"/>
        </record>

        <!-- Multi-Country Payroll Groups -->
        <record id="group_multi_country_payroll_user" model="res.groups">
            <field name="name">Multi-Country Payroll User</field>
            <field name="privilege_id" ref="res_groups_privilege_multi_country"/>
            <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
        </record>

        <record id="group_multi_country_payroll_manager" model="res.groups">
            <field name="name">Multi-Country Payroll Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_multi_country"/>
            <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager')), (4, ref('group_multi_country_payroll_user'))]"/>
        </record>

        <!-- Record Rules for pb_hr_payroll_base models only -->
        <record id="payroll_dashboard_rule" model="ir.rule">
            <field name="name">Payroll Dashboard: Access All</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_multi_country_payroll_user'))]"/>
        </record>

        <record id="payroll_country_selector_rule" model="ir.rule">
            <field name="name">Payroll Country Selector: Access All</field>
            <field name="model_id" ref="model_payroll_country_selector"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_multi_country_payroll_user'))]"/>
        </record>

        <!-- Enhanced Zoho Staging Data Rule -->
        <record id="zoho_staging_data_rule" model="ir.rule">
            <field name="name">Zoho Staging Data: Multi-Country Access</field>
            <field name="model_id" ref="om_hr_payroll.model_zoho_staging_data"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_multi_country_payroll_user'))]"/>
        </record>

        <!-- Wizard Models Security -->
        <record id="country_selector_wizard_rule" model="ir.rule">
            <field name="name">Country Selector Wizard: Access All</field>
            <field name="model_id" ref="model_country_selector_wizard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_multi_country_payroll_user'))]"/>
        </record>

        <record id="zoho_staging_import_wizard_rule" model="ir.rule">
            <field name="name">Zoho Staging Import Wizard: Access All</field>
            <field name="model_id" ref="model_zoho_staging_import_wizard"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_multi_country_payroll_user'))]"/>
        </record>
    </data>
</odoo>