<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Enhanced Security Groups -->
        
        <!-- Base Payroll Groups -->
        <record id="group_payroll_base_user" model="res.groups">
            <field name="name">Payroll Base User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Basic payroll access for viewing own payslips and basic information</field>
        </record>

        <record id="group_payroll_base_officer" model="res.groups">
            <field name="name">Payroll Officer</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Can process payroll, generate payslips, and manage employee data</field>
        </record>

        <record id="group_payroll_base_manager" model="res.groups">
            <field name="name">Payroll Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="comment">Full payroll management including salary rules, structures, and analytics</field>
        </record>

        <record id="group_payroll_super_admin" model="res.groups">
            <field name="name">Payroll Super Administrator</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_manager'))]"/>
            <field name="comment">Full access to all payroll systems and multi-country management</field>
        </record>

        <!-- Country-Specific Groups -->
        <record id="group_payroll_vietnam" model="res.groups">
            <field name="name">Vietnam Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Vietnam payroll system</field>
        </record>

        <record id="group_payroll_indonesia" model="res.groups">
            <field name="name">Indonesia Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Indonesia payroll system including THR processing</field>
        </record>

        <record id="group_payroll_india" model="res.groups">
            <field name="name">India Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to India payroll system including PF and ESI</field>
        </record>

        <record id="group_payroll_singapore" model="res.groups">
            <field name="name">Singapore Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Singapore payroll system</field>
        </record>

        <record id="group_payroll_malaysia" model="res.groups">
            <field name="name">Malaysia Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Malaysia payroll system</field>
        </record>

        <!-- Analytics and Reporting Groups -->
        <record id="group_payroll_analytics_user" model="res.groups">
            <field name="name">Payroll Analytics User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Can view payroll analytics and reports</field>
        </record>

        <record id="group_payroll_analytics_manager" model="res.groups">
            <field name="name">Payroll Analytics Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_analytics_user')), (4, ref('group_payroll_base_manager'))]"/>
            <field name="comment">Can generate, approve, and export payroll analytics</field>
        </record>

        <!-- Data Integration Groups -->
        <record id="group_payroll_integration_user" model="res.groups">
            <field name="name">Payroll Integration User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="comment">Can import/export payroll data and manage integrations</field>
        </record>

        <!-- Record Rules for Data Security -->
        
        <!-- Dashboard Access Rules -->
        <record id="rule_payroll_dashboard_country_access" model="ir.rule">
            <field name="name">Payroll Dashboard: Country Access</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">['|', '|', '|', '|', '|',
                ('country', '=', 'VN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_vietnam')]),
                ('country', '=', 'ID'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_indonesia')]),
                ('country', '=', 'IN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_india')]),
                ('country', '=', 'SG'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_singapore')]),
                ('country', '=', 'MY'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_malaysia')]),
                (1, '=', 1) # Super admin access
            ]</field>
        </record>

        <!-- Manager Access to All Dashboards -->
        <record id="rule_payroll_dashboard_manager_access" model="ir.rule">
            <field name="name">Payroll Dashboard: Manager Full Access</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Analytics Access Rules -->
        <record id="rule_payroll_analytics_country_access" model="ir.rule">
            <field name="name">Payroll Analytics: Country Access</field>
            <field name="model_id" ref="model_payroll_analytics"/>
            <field name="groups" eval="[(4, ref('group_payroll_analytics_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                '|', '|', '|', '|',
                '&amp;', ('country_code', '=', 'VN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_vietnam')]),
                '&amp;', ('country_code', '=', 'ID'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_indonesia')]),
                '&amp;', ('country_code', '=', 'IN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_india')]),
                '&amp;', ('country_code', '=', 'SG'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_singapore')]),
                '&amp;', ('country_code', '=', 'MY'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_malaysia')])
            ]</field>
        </record>

        <!-- Analytics Manager Full Access -->
        <record id="rule_payroll_analytics_manager_access" model="ir.rule">
            <field name="name">Payroll Analytics: Manager Full Access</field>
            <field name="model_id" ref="model_payroll_analytics"/>
            <field name="groups" eval="[(4, ref('group_payroll_analytics_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Confidential Analytics Protection -->
        <record id="rule_payroll_analytics_confidential" model="ir.rule">
            <field name="name">Payroll Analytics: Confidential Data Protection</field>
            <field name="model_id" ref="model_payroll_analytics"/>
            <field name="groups" eval="[(4, ref('group_payroll_analytics_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                '|',
                ('is_confidential', '=', False),
                ('approver_ids', 'in', [user.id])
            ]</field>
        </record>

        <!-- Enhanced Payslip Access Rules -->
        <record id="rule_payslip_country_access" model="ir.rule">
            <field name="name">Payslips: Country-based Access</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[
                '|', '|', '|', '|',
                '&amp;', ('contract_id.payroll_country_code', '=', 'VN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_vietnam')]),
                '&amp;', ('contract_id.payroll_country_code', '=', 'ID'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_indonesia')]),
                '&amp;', ('contract_id.payroll_country_code', '=', 'IN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_india')]),
                '&amp;', ('contract_id.payroll_country_code', '=', 'SG'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_singapore')]),
                '&amp;', ('contract_id.payroll_country_code', '=', 'MY'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_malaysia')])
            ]</field>
        </record>

        <!-- Employee Self-Service Access -->
        <record id="rule_payslip_employee_self_service" model="ir.rule">
            <field name="name">Payslips: Employee Self-Service</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Contract Country Access Rules -->
        <record id="rule_contract_country_access" model="ir.rule">
            <field name="name">Contracts: Country-based Access</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                '|', '|', '|', '|',
                '&amp;', ('payroll_country_code', '=', 'VN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_vietnam')]),
                '&amp;', ('payroll_country_code', '=', 'ID'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_indonesia')]),
                '&amp;', ('payroll_country_code', '=', 'IN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_india')]),
                '&amp;', ('payroll_country_code', '=', 'SG'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_singapore')]),
                '&amp;', ('payroll_country_code', '=', 'MY'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_malaysia')])
            ]</field>
        </record>

        <!-- Salary Rule Country Access -->
        <record id="rule_salary_rule_country_access" model="ir.rule">
            <field name="name">Salary Rules: Country-based Access</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_salary_rule"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                '|',
                ('payroll_country_code', '=', False),  # Global rules
                '|', '|', '|', '|',
                '&amp;', ('payroll_country_code', '=', 'VN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_vietnam')]),
                '&amp;', ('payroll_country_code', '=', 'ID'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_indonesia')]),
                '&amp;', ('payroll_country_code', '=', 'IN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_india')]),
                '&amp;', ('payroll_country_code', '=', 'SG'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_singapore')]),
                '&amp;', ('payroll_country_code', '=', 'MY'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_malaysia')])
            ]</field>
        </record>

        <!-- Employee Data Access by Country -->
        <record id="rule_employee_country_access" model="ir.rule">
            <field name="name">Employees: Country-based Access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                '|', '|', '|', '|', '|',
                ('country_id.code', '=', False),  # No country specified
                '&amp;', ('country_id.code', '=', 'VN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_vietnam')]),
                '&amp;', ('country_id.code', '=', 'ID'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_indonesia')]),
                '&amp;', ('country_id.code', '=', 'IN'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_india')]),
                '&amp;', ('country_id.code', '=', 'SG'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_singapore')]),
                '&amp;', ('country_id.code', '=', 'MY'), ('user', 'in', [user.id for user in user.groups_id if user.has_group('pb_hr_payroll_base.group_payroll_malaysia')])
            ]</field>
        </record>

        <!-- Super Admin Override Rules -->
        <record id="rule_super_admin_all_access" model="ir.rule">
            <field name="name">Super Admin: All Data Access</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="groups" eval="[(4, ref('group_payroll_super_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_super_admin_analytics_access" model="ir.rule">
            <field name="name">Super Admin: All Analytics Access</field>
            <field name="model_id" ref="model_payroll_analytics"/>
            <field name="groups" eval="[(4, ref('group_payroll_super_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Integration Security Rules -->
        <record id="rule_integration_data_access" model="ir.rule">
            <field name="name">Integration: Data Import/Export Access</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('group_payroll_integration_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Portal/Employee Self-Service Rules -->
        <record id="rule_portal_employee_payslip_access" model="ir.rule">
            <field name="name">Portal: Employee Own Payslips</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id),
                ('state', 'in', ['done', 'paid'])
            ]</field>
        </record>

        <!-- Audit and Compliance Rules -->
        <record id="rule_audit_trail_access" model="ir.rule">
            <field name="name">Audit Trail: Manager Access Only</field>
            <field name="model_id" ref="mail.model_mail_message"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                ('model', 'in', ['hr.payslip', 'hr.salary.rule', 'hr.payroll.structure', 'payroll.analytics'])
            ]</field>
        </record>

        <!-- Time-based Access Rules -->
        <record id="rule_payroll_period_access" model="ir.rule">
            <field name="name">Payroll Period: Current and Future Only</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[
                '|',
                ('state', 'in', ['draft', 'verify']),
                ('date_from', '&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-%m-%d'))
            ]</field>
        </record>

        <!-- Multi-tenancy Support (if needed) -->
        <record id="rule_company_isolation" model="ir.rule">
            <field name="name">Company Data Isolation</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
        </record>

        <!-- Bank Export Security -->
        <record id="rule_bank_export_access" model="ir.rule">
            <field name="name">Bank Export: Manager Only</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                ('state', '=', 'done')
            ]</field>
        </record>

    </data>

    <!-- Model Access Rights -->
    <data noupdate="0">
        
        <!-- Payroll Dashboard Access Rights -->
        <record id="access_payroll_dashboard_user" model="ir.model.access">
            <field name="name">payroll.dashboard.user</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="group_id" ref="group_payroll_base_user"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="access_payroll_dashboard_officer" model="ir.model.access">
            <field name="name">payroll.dashboard.officer</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="group_id" ref="group_payroll_base_officer"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="access_payroll_dashboard_manager" model="ir.model.access">
            <field name="name">payroll.dashboard.manager</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="group_id" ref="group_payroll_base_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Payroll Analytics Access Rights -->
        <record id="access_payroll_analytics_user" model="ir.model.access">
            <field name="name">payroll.analytics.user</field>
            <field name="model_id" ref="model_payroll_analytics"/>
            <field name="group_id" ref="group_payroll_analytics_user"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="access_payroll_analytics_manager" model="ir.model.access">
            <field name="name">payroll.analytics.manager</field>
            <field name="model_id" ref="model_payroll_analytics"/>
            <field name="group_id" ref="group_payroll_analytics_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Country-Specific Access Rights -->
        
        <!-- Vietnam -->
        <record id="access_payroll_dashboard_vietnam" model="ir.model.access">
            <field name="name">payroll.dashboard.vietnam</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="group_id" ref="group_payroll_vietnam"/>
            <field name="perm_read" eval="True"/>
