<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Enhanced Security Groups -->
        
        <!-- Base Payroll Groups -->
        <record id="group_payroll_base_user" model="res.groups">
            <field name="name">Payroll Base User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Basic payroll access for viewing own payslips and basic information</field>
        </record>

        <record id="group_payroll_base_officer" model="res.groups">
            <field name="name">Payroll Officer</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Can process payroll, generate payslips, and manage employee data</field>
        </record>

        <record id="group_payroll_base_manager" model="res.groups">
            <field name="name">Payroll Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="comment">Full payroll management including salary rules, structures, and analytics</field>
        </record>

        <record id="group_payroll_super_admin" model="res.groups">
            <field name="name">Payroll Super Administrator</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_manager'))]"/>
            <field name="comment">Full access to all payroll systems and multi-country management</field>
        </record>

        <!-- Country-Specific Groups -->
        <record id="group_payroll_vietnam" model="res.groups">
            <field name="name">Vietnam Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Vietnam payroll system</field>
        </record>

        <record id="group_payroll_indonesia" model="res.groups">
            <field name="name">Indonesia Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Indonesia payroll system</field>
        </record>

        <record id="group_payroll_india" model="res.groups">
            <field name="name">India Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to India payroll system</field>
        </record>

        <record id="group_payroll_singapore" model="res.groups">
            <field name="name">Singapore Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Singapore payroll system</field>
        </record>

        <record id="group_payroll_malaysia" model="res.groups">
            <field name="name">Malaysia Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Malaysia payroll system</field>
        </record>

        <record id="group_payroll_thailand" model="res.groups">
            <field name="name">Thailand Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Thailand payroll system</field>
        </record>

        <record id="group_payroll_cambodia" model="res.groups">
            <field name="name">Cambodia Payroll Access</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="comment">Access to Cambodia payroll system</field>
        </record>

        <!-- Analytics groups are now defined in payroll_analytics_approval module -->

        <record id="group_payroll_integration_user" model="res.groups">
            <field name="name">Payroll Integration User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="comment">Can import/export payroll data and manage integrations</field>
        </record>

        <!-- Record Rules for Data Security -->
        
        <!-- Dashboard Access Rules - SIMPLIFIED DOMAINS -->
        <record id="rule_payroll_dashboard_country_access" model="ir.rule">
            <field name="name">Payroll Dashboard: Country Access</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Manager Access to All Dashboards -->
        <record id="rule_payroll_dashboard_manager_access" model="ir.rule">
            <field name="name">Payroll Dashboard: Manager Full Access</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Analytics Access Rules - SIMPLIFIED -->
        <record id="rule_payroll_analytics_user_access" model="ir.rule">
            <field name="name">Payroll Analytics: User Access</field>
            <field name="model_id" ref="model_payroll_analytics"/>
            <field name="groups" eval="[(4, ref('group_payroll_analytics_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Analytics Manager Full Access -->
        <record id="rule_payroll_analytics_manager_access" model="ir.rule">
            <field name="name">Payroll Analytics: Manager Full Access</field>
            <field name="model_id" ref="model_payroll_analytics"/>
            <field name="groups" eval="[(4, ref('group_payroll_analytics_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Enhanced Payslip Access Rules - SIMPLIFIED -->
        <record id="rule_payslip_country_access" model="ir.rule">
            <field name="name">Payslips: Officer Access</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Employee Self-Service Access -->
        <record id="rule_payslip_employee_self_service" model="ir.rule">
            <field name="name">Payslips: Employee Self-Service</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Contract Access Rules - SIMPLIFIED -->
        <record id="rule_contract_officer_access" model="ir.rule">
            <field name="name">Contracts: Officer Access</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Salary Rule Access - SIMPLIFIED -->
        <record id="rule_salary_rule_officer_access" model="ir.rule">
            <field name="name">Salary Rules: Officer Access</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_salary_rule"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Employee Data Access - SIMPLIFIED -->
        <record id="rule_employee_officer_access" model="ir.rule">
            <field name="name">Employees: Officer Access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="groups" eval="[(4, ref('group_payroll_base_officer'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Super Admin Override Rules -->
        <record id="rule_super_admin_all_access" model="ir.rule">
            <field name="name">Super Admin: All Data Access</field>
            <field name="model_id" ref="model_payroll_dashboard"/>
            <field name="groups" eval="[(4, ref('group_payroll_super_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Integration Security Rules -->
        <record id="rule_integration_data_access" model="ir.rule">
            <field name="name">Integration: Data Import/Export Access</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('group_payroll_integration_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Portal/Employee Self-Service Rules -->
        <record id="rule_portal_employee_payslip_access" model="ir.rule">
            <field name="name">Portal: Employee Own Payslips</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[
                ('employee_id.user_id', '=', user.id),
                ('state', 'in', ['done', 'paid'])
            ]</field>
        </record>

    </data>
</odoo>