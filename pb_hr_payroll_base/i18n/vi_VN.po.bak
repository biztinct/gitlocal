#. module: pb_hr_payroll_base
#: model_terms:ir.ui.view,arch_db:pb_hr_payroll_base.view_custom_field_mapping_form
msgid ""
"<strong>Transformation Rules Examples:</strong><br/>\n"
"                        • <code>value.upper()</code> - Convert to uppercase<br/>\n"
"                        • <code>value.replace(' ', '_')</code> - Replace spaces with underscores<br/>\n"
"                        • <code>datetime.strptime(value, '%d/%m/%Y')</code> - Parse date format<br/>\n"
"                        • <code>float(value) * 1000</code> - Convert currency units<br/>"
msgstr ""
"<strong>Chuyển đổi Quy tắc Examples:</strong><br/>\n"
" • <code>giá trị.upper()</code> - Chuyển đổi để uppercase<br/>\n"
" • <code>giá trị.thay thế(' ', '_')</code> - Thay thế spaces với underscores<br/>\n"
" • <code>datetime.strptime(giá trị, '%d/%m/%Y')</code> - Phân tích ngày định dạng<br/>\n"
" • <code>float(giá trị) * 1000</code> - Chuyển đổi tiền tệ units<br/>"

#. module: pb_hr_payroll_base
#: model_terms:ir.ui.view,arch_db:pb_hr_payroll_base.view_payroll_setup_guide
