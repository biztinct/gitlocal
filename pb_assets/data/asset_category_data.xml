<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ==================================================================
         THE STARTING CATEGORIES.

         Six physical things and four digital ones — the list a company
         actually hands out on somebody's first day. HR can add, rename or
         retire any of them; these exist so the register is usable the
         minute it is switched on rather than being an empty form.

         EVERY ROW IS COMPANY-LESS (`company_id` eval="False"). A seed takes
         the loading user's company by default, and the company rule then
         hides it from everybody else — the register would look empty on a
         database that is full (R8).

         The code is what appears in the middle of an asset code, so it is
         chosen to be readable rather than clever: LT is a laptop.
         ================================================================== -->

    <record id="cat_laptop" model="pb.asset.category">
        <field name="name">Laptop</field>
        <field name="code">LT</field>
        <field name="kind">tangible</field>
        <field name="icon">laptop</field>
        <field name="auto_assign_at_joining" eval="True"/>
        <field name="sequence">10</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_phone" model="pb.asset.category">
        <field name="name">Phone</field>
        <field name="code">PH</field>
        <field name="kind">tangible</field>
        <field name="icon">smartphone</field>
        <field name="sequence">20</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_sim" model="pb.asset.category">
        <field name="name">SIM card</field>
        <field name="code">SM</field>
        <field name="kind">tangible</field>
        <field name="icon">creditCard</field>
        <field name="sequence">30</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_idcard" model="pb.asset.category">
        <field name="name">ID card</field>
        <field name="code">ID</field>
        <field name="kind">tangible</field>
        <field name="icon">idCard</field>
        <field name="auto_assign_at_joining" eval="True"/>
        <field name="sequence">40</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_credit_card" model="pb.asset.category">
        <field name="name">Company card</field>
        <field name="code">CC</field>
        <field name="kind">tangible</field>
        <field name="icon">creditCard</field>
        <field name="sequence">50</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_monitor" model="pb.asset.category">
        <field name="name">Monitor</field>
        <field name="code">MN</field>
        <field name="kind">tangible</field>
        <field name="icon">monitor</field>
        <field name="sequence">60</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_email" model="pb.asset.category">
        <field name="name">Email account</field>
        <field name="code">EM</field>
        <field name="kind">digital</field>
        <field name="icon">mail</field>
        <field name="auto_assign_at_joining" eval="True"/>
        <field name="sequence">70</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_login" model="pb.asset.category">
        <field name="name">System login</field>
        <field name="code">LG</field>
        <field name="kind">digital</field>
        <field name="icon">key</field>
        <field name="auto_assign_at_joining" eval="True"/>
        <field name="sequence">80</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_software" model="pb.asset.category">
        <field name="name">Software licence</field>
        <field name="code">SW</field>
        <field name="kind">digital</field>
        <field name="icon">appWindow</field>
        <field name="sequence">90</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cat_phone_number" model="pb.asset.category">
        <field name="name">Phone number</field>
        <field name="code">PN</field>
        <field name="kind">digital</field>
        <field name="icon">smartphone</field>
        <field name="sequence">100</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- The request reference. Company-less, for the same reason. -->
    <record id="seq_asset_request" model="ir.sequence">
        <field name="name">Asset requests</field>
        <field name="code">pb.asset.request</field>
        <field name="prefix">AR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

</data>
</odoo>
