<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==========================================
             PAYROLL CATEGORY & PRIVILEGE (Odoo 19)
             ========================================== -->

        <!-- Module category — appears as section header in user Access Rights -->
        <record id="module_category_payroll" model="ir.module.category">
            <field name="name">Payroll</field>
            <field name="description">Payroll management and processing</field>
            <field name="sequence">20</field>
        </record>

        <!-- Privilege — appears as dropdown label under "PAYROLL" section -->
        <record id="res_groups_privilege_payroll" model="res.groups.privilege">
            <field name="name">Payroll</field>
            <field name="sequence">5</field>
            <field name="category_id" ref="module_category_payroll"/>
        </record>

        <!-- Group definitions with privilege_id (Odoo 19 pattern) -->
        <record id="group_hr_payroll_user" model="res.groups">
            <field name="name">Payroll Officer</field>
            <field name="privilege_id" ref="res_groups_privilege_payroll"/>
            <field name="implied_ids"
                   eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_contract.group_hr_contract_manager'))]"/>
        </record>

        <record id="group_hr_payroll_manager" model="res.groups">
            <field name="name">Payroll Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_payroll"/>
            <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- base.default_user removed - does not exist in Odoo 19 -->
        <record id="hr_payroll_rule_officer" model="ir.rule">
            <field name="name">Officer and subordinates Payslip</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="domain_force">['|','|', ('employee_id.user_id', '=', user.id), ('employee_id.department_id',
                '=', False), ('employee_id.department_id.manager_id.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
        </record>

        <record id="hr_payslip_rule_manager" model="ir.rule">
            <field name="name">All Payslip</field>
            <field name="model_id" ref="model_hr_payslip"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
        </record>

    </data>
</odoo>
