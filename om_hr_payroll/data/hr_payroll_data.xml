<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">

        <!-- Payroll Chart of Accounts -->
        <record id="account_payroll_salaries" model="account.account" forcecreate="True">
            <field name="code">520001</field>
            <field name="name">Salaries Expense</field>
            <field name="account_type">expense</field>
            <field name="reconcile">False</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="account_payroll_allowances" model="account.account" forcecreate="True">
            <field name="code">520002</field>
            <field name="name">Allowances Expense</field>
            <field name="account_type">expense</field>
            <field name="reconcile">False</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="account_salary_payable" model="account.account" forcecreate="True">
            <field name="code">210001</field>
            <field name="name">Salary Payable</field>
            <field name="account_type">liability_current</field>
            <field name="reconcile">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="account_payroll_clearing" model="account.account" forcecreate="True">
            <field name="code">210002</field>
            <field name="name">Payroll Clearing Account</field>
            <field name="account_type">liability_current</field>
            <field name="reconcile">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Salary Rules (accounting fields handled by om_hr_payroll_account module) -->
        <record id="hr_rule_basic" model="hr.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="sequence" eval="1"/>
            <field name="code">BASIC</field>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_taxable" model="hr.salary.rule">
            <field name="name">Gross</field>
            <field name="sequence" eval="100"/>
            <field name="code">GROSS</field>
            <field name="category_id" ref="om_hr_payroll.GROSS"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

<!--        <record id="hr_rule_unpaid" model="hr.salary.rule">-->
<!--            <field name="name">Unpaid Leave</field>-->
<!--            <field name="sequence" eval="100"/>-->
<!--            <field name="code">UNP</field>-->
<!--            <field name="category_id" ref="om_hr_payroll.DED"/>-->
<!--            <field name="condition_select">none</field>-->
<!--            <field name="amount_select">code</field>-->
<!--            <field name="amount_python_compute">result=-(contract.wage / worked_days.WORK100.number_of_days) *-->
<!--                worked_days.Unpaid.number_of_days-->
<!--            </field>-->
<!--        </record>-->

        <record id="hr_rule_hra" model="hr.salary.rule">
            <field name="name">House Rent Allowance</field>
            <field name="sequence" eval="3"/>
            <field name="code">HRA</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_da" model="hr.salary.rule">
            <field name="name">Dearness Allowance</field>
            <field name="sequence" eval="5"/>
            <field name="code">DA</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_travel" model="hr.salary.rule">
            <field name="name">Travel Allowance</field>
            <field name="sequence" eval="7"/>
            <field name="code">Travel</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_meal" model="hr.salary.rule">
            <field name="name">Meal Allowance</field>
            <field name="sequence" eval="9"/>
            <field name="code">Meal</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_medical" model="hr.salary.rule">
            <field name="name">Medical Allowance</field>
            <field name="sequence" eval="11"/>
            <field name="code">Medical</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_net" model="hr.salary.rule">
            <field name="name">Net Salary</field>
            <field name="sequence" eval="200"/>
            <field name="code">NET</field>
            <field name="category_id" ref="om_hr_payroll.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
            <field name="register_id" ref="contrib_register_employees"/>
        </record>

        <!-- Vietnam-specific Salary Rules -->
        <record id="hr_rule_transport_allowance" model="hr.salary.rule">
            <field name="name">Transport Allowance</field>
            <field name="sequence" eval="13"/>
            <field name="code">TRANSPORT</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_social_insurance_employee" model="hr.salary.rule">
            <field name="name">Social Insurance (Employee)</field>
            <field name="sequence" eval="101"/>
            <field name="code">SI_EMP</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_health_insurance_employee" model="hr.salary.rule">
            <field name="name">Health Insurance (Employee)</field>
            <field name="sequence" eval="102"/>
            <field name="code">HI_EMP</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_unemployment_insurance_employee" model="hr.salary.rule">
            <field name="name">Unemployment Insurance (Employee)</field>
            <field name="sequence" eval="103"/>
            <field name="code">UI_EMP</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_personal_income_tax" model="hr.salary.rule">
            <field name="name">Personal Income Tax</field>
            <field name="sequence" eval="104"/>
            <field name="code">PIT</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <!-- Social Insurance Company Contributions (for analytics) -->
        <record id="hr_rule_social_insurance_company" model="hr.salary.rule">
            <field name="name">Social Insurance (Company)</field>
            <field name="sequence" eval="201"/>
            <field name="code">SI_COMP</field>
            <field name="category_id" ref="om_hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_health_insurance_company" model="hr.salary.rule">
            <field name="name">Health Insurance (Company)</field>
            <field name="sequence" eval="202"/>
            <field name="code">HI_COMP</field>
            <field name="category_id" ref="om_hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_unemployment_insurance_company" model="hr.salary.rule">
            <field name="name">Unemployment Insurance (Company)</field>
            <field name="sequence" eval="203"/>
            <field name="code">UI_COMP</field>
            <field name="category_id" ref="om_hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <record id="hr_rule_total_cost_employer" model="hr.salary.rule">
            <field name="name">Total Cost to Employer</field>
            <field name="sequence" eval="300"/>
            <field name="code">TCTE</field>
            <field name="category_id" ref="om_hr_payroll.GROSS"/>
            <field name="condition_select">none</field>
            <field name="amount_select">fix</field>
            <field name="amount_fix">0.00</field>
        </record>

        <!-- Salary Structures -->

        <record id="structure_base" model="hr.payroll.structure">
            <field name="code">BASE</field>
            <field name="name">Base for new structures</field>
            <field eval="[(6, 0, [ref('hr_rule_basic'), ref('hr_rule_taxable'),ref('hr_rule_net')])]" name="rule_ids"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="structure_vietnam" model="hr.payroll.structure">
            <field name="code">VN_STD</field>
            <field name="name">Vietnam Standard Payroll</field>
            <field eval="[(6, 0, [
                ref('hr_rule_basic'), 
                ref('hr_rule_hra'), 
                ref('hr_rule_da'), 
                ref('hr_rule_travel'), 
                ref('hr_rule_meal'), 
                ref('hr_rule_medical'),
                ref('hr_rule_transport_allowance'),
                ref('hr_rule_taxable'),
                ref('hr_rule_social_insurance_employee'),
                ref('hr_rule_health_insurance_employee'),
                ref('hr_rule_unemployment_insurance_employee'),
                ref('hr_rule_personal_income_tax'),
                ref('hr_rule_net'),
                ref('hr_rule_social_insurance_company'),
                ref('hr_rule_health_insurance_company'),
                ref('hr_rule_unemployment_insurance_company'),
                ref('hr_rule_total_cost_employer')
            ])]" name="rule_ids"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Decimal Precision -->

        <record forcecreate="True" id="decimal_payroll" model="decimal.precision">
            <field name="name">Payroll</field>
            <field name="digits">2</field>
        </record>

        <record forcecreate="True" id="decimal_payroll_rate" model="decimal.precision">
            <field name="name">Payroll Rate</field>
            <field name="digits">4</field>
        </record>

    </data>
</odoo>
