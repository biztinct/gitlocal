    <!-- Contract View -->
    <record id="hr_contract_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.view.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <!-- NOT required: payroll here is defined by a scheme, and a
                     contract on such a tenant has no salary structure to pick.
                     Demanding one made the contract form unsaveable on any
                     database whose payroll does not use structures — which is
                     every one of them except where a structure is deliberately
                     in use. Where structures ARE used, the field is still here
                     and still the thing the standard engine reads. -->
                <field name="struct_id"/>
                <field name="type_id" required="1"/>
            </xpath>
            <xpath expr="//field[@name='job_id']" position="before">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currency_id" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="schedule_pay"/>

            </xpath>

            <xpath expr="//page[@name='information']" position="after">
                <page name="other" position="move"/>
            </xpath>

            <xpath expr="//group[@name='salary']" position="after">
                <group> 
                        <field name="tupart" widget="radio"  options="{'horizontal':true}" />
                        <field name="shuipart" widget="radio"  options="{'horizontal':true}" />
                </group>

                    <group>
                        <field name="dependents"/>                 
                        <field name="location"/>
                        <field name="costcenter"/>
                    </group>
                    <group>
                        <field name="hirestatus"/>                 
                    </group>



                <separator string="Contract Components" />
                <field name="advantages_ids">
                    <list editable="bottom">
                        <field
                            name="advantage_template_id"
                            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"
                        />
                        <field name="advantage_template_code" />
                        <field name="advantage_lower_bound" />
                        <field name="advantage_upper_bound" />
                        <field name="amount" />
                    </list>
                </field>
            </xpath>
            
            <!-- Biztint-->
            <!--
            <xpath expr="//group[@name='salary_info']" position="after">
