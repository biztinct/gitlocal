                                            <field name="credit_note" widget="boolean"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        -->




        <!-- Biztinct Kanaban modifications-->

        <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
            <field name="name">hr.payslip.run.kanban</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" default_order="date_end desc" create="true" quick_create="false">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="state"/>
                    <field name="credit_note"/>
                    <templates>
                        <t t-name="card">
                            <field name="name" class="fw-bold fs-5"/>
                            <div class="text-muted">
                                <i class="fa fa-calendar"/> <field name="date_start"/> to <field name="date_end"/>
                            </div>
                            <div t-if="record.credit_note.raw_value" class="mt-2">
                                <span class="badge text-bg-warning">Credit Note</span>
                            </div>
                            <footer>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'secondary', 'level1': 'info', 'level2': 'warning', 'done': 'success', 'cancel': 'danger'}}"/>
                            </footer>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>




        <record id="hr_payslip_run_form" model="ir.ui.view">
            <field name="name">hr.payslip.run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <form string="Payslips Batches">
                    <header>
                        <button string="Download Excel" name="action_download_payslip_xlsx" type="object" class="oe_highlight" icon="fa-download"/>
                        <button name="%(action_hr_payslip_by_employees)d" type="action" invisible="state != 'draft'"
                                string="Generate Payslips" class="oe_highlight"/>
                        <button string="Set to Draft" name="draft_payslip_run" type="object" invisible="state != 'done'"/>
                        <button string="Submit for HR Manager" name="done_payslip_run" type="object" invisible="state != 'draft'"
                                class="oe_highlight"/>
                        <button name="action_payslip_run_level1_done" type="object" string="HR Manager Approve" invisible="state != 'level1'"
                            class="oe_highlight"/>
                        <button name="action_payslip_run_level2_done" type="object" string="General Manager Approve" invisible="state != 'level2'"
                            class="oe_highlight"/>
                        <button name="action_payslip_run_cancel" type="object" string="Reject" invisible="state not in ('draft', 'level1', 'level2')"/> 
                        <!--<button name="close_payslip_run" type="object" string="Close" invisible="state not in ('draft', 'done')"/>-->
                        <button string="Mail Batch Payslips" name="action_send_email_all" type="object" class="oe_highlight" invisible="state != 'done'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                        <group col="4">
                            <label for="date_start" string="Period"/>
                            <div>
                                <field name="date_start" class="oe_inline"/>
                                -
                                <field name="date_end" class="oe_inline"/>
                            </div>
                            <field name="credit_note"/>
                        </group>
                        <separator string="Payslips"/>
                        <field name="slip_ids" invisible="not slip_ids"/> 
                    </sheet>
                </form>
            </field>
        </record>
