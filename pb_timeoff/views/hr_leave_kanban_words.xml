<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WF2 P5a (leftover of D22, owner 11 Nov): the corner ribbon on the
         staff time-off cards used the stock words "To Approve" / "To
         Validate" while every other time-off screen now says "Waiting for
         approval" / "Second approval". Words only; same colours, same
         conditions. vi/id: this module's i18n files. -->
    <record id="hr_leave_view_kanban_pb_words" model="ir.ui.view">
        <field name="name">hr.leave.kanban: same status words as the form</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon'][@invisible=&quot;state != 'confirm'&quot;]" position="attributes">
                <attribute name="title">Waiting for approval</attribute>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][@invisible=&quot;state != 'validate1'&quot;]" position="attributes">
                <attribute name="title">Second approval</attribute>
            </xpath>
        </field>
    </record>
</odoo>
