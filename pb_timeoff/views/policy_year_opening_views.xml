<odoo>
    <record id="policy_year_opening_company" model="ir.rule"><field name="name">Year openings: allowed companies</field><field name="model_id" ref="model_pb_leave_policy_year_opening"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
    <record id="policy_year_opening_access" model="ir.model.access"><field name="name">Manage annual openings</field><field name="model_id" ref="model_pb_leave_policy_year_opening"/><field name="group_id" ref="hr_holidays.group_hr_holidays_manager"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/></record>
    <record id="policy_year_opening_list" model="ir.ui.view"><field name="name">pb.leave.policy.year.opening.list</field><field name="model">pb.leave.policy.year.opening</field><field name="arch" type="xml"><list decoration-danger="state == 'blocked'"><field name="employee_id"/><field name="edition_id"/><field name="year"/><field name="leave_type_id"/><field name="state"/><field name="result"/></list></field></record>
    <record id="policy_year_opening_form" model="ir.ui.view"><field name="name">pb.leave.policy.year.opening.form</field><field name="model">pb.leave.policy.year.opening</field><field name="arch" type="xml"><form><header><button name="action_schedule" type="object" string="Authorize January opening" class="btn-primary" invisible="state != 'draft'"/><button name="action_retry" type="object" string="Retry after resolving records" invisible="state != 'blocked'"/><field name="state" widget="statusbar"/></header><sheet><div class="alert alert-info">Schedule an employee’s future January opening. The daily job carries forward the reconciled prior balance within the policy cap, then grants the annual entitlement once. Pending leave or unreconciled allocations require HR review.</div><group><field name="employee_id" readonly="state != 'draft'"/><field name="edition_id" readonly="state != 'draft'"/><field name="leave_type_id" readonly="state != 'draft'"/><field name="year" readonly="state != 'draft'"/><field name="employment_start" readonly="state != 'draft'"/><field name="review_reference" readonly="state != 'draft'"/><field name="authorized_by"/><field name="authorized_at"/><field name="completed_at"/><field name="result"/></group></sheet></form></field></record>
    <record id="action_policy_year_opening" model="ir.actions.act_window"><field name="name">Scheduled annual openings</field><field name="res_model">pb.leave.policy.year.opening</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_policy_year_opening" name="Scheduled annual openings" parent="hr_holidays.menu_hr_holidays_management" action="action_policy_year_opening" sequence="82" groups="hr_holidays.group_hr_holidays_manager"/>
    <data noupdate="1"><record id="cron_policy_year_opening" model="ir.cron"><field name="name">Process authorized annual leave openings</field><field name="model_id" ref="model_pb_leave_policy_year_opening"/><field name="state">code</field><field name="code">model._cron_open_year()</field><field name="interval_number">1</field><field name="interval_type">days</field><field name="active" eval="True"/><field name="user_id" ref="base.user_root"/></record></data>
</odoo>
