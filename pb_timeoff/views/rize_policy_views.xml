<odoo>
  <record id="policy_edition_list" model="ir.ui.view"><field name="name">pb.leave.policy.edition.list</field><field name="model">pb.leave.policy.edition</field><field name="arch" type="xml">
    <list><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="country_id"/><field name="effective_from"/><field name="effective_to"/><field name="state" widget="badge"/></list>
  </field></record>
  <record id="policy_edition_form" model="ir.ui.view"><field name="name">pb.leave.policy.edition.form</field><field name="model">pb.leave.policy.edition</field><field name="arch" type="xml">
    <form string="Absence policy"><header><button name="action_publish" type="object" string="Publish edition" class="btn-primary" invisible="state != 'draft'" groups="hr_holidays.group_hr_holidays_manager"/><field name="state" widget="statusbar"/></header><sheet>
      <div class="alert alert-info">Published rules are frozen. Duplicate an edition to change policy prospectively. Unresolved clauses block only affected requests or payroll inputs; native allocations remain the leave balance.</div>
      <group><group><field name="name" readonly="state == 'published'"/><field name="code" readonly="state == 'published'"/><field name="company_id" readonly="state == 'published'"/><field name="country_id" readonly="state == 'published'"/><field name="full_time_only" readonly="state == 'published'"/></group><group><field name="effective_from" readonly="state == 'published'"/><field name="effective_to"/><field name="source_effective_date" readonly="state == 'published'"/><field name="source_reference" readonly="state == 'published'"/><field name="published_by"/><field name="published_at"/></group></group>
      <notebook><page string="Rules"><field name="rule_ids" readonly="state == 'published'"><list editable="bottom"><field name="name"/><field name="category"/><field name="quantity"/><field name="counting"/><field name="limit_period"/><field name="pay_treatment"/><field name="paid_fraction"/><field name="pay_funding"/><field name="employer_paid_fraction"/><field name="max_request_days" optional="hide"/><field name="medical_after_days" optional="hide"/><field name="event_evidence_required" optional="hide"/><field name="source_pages" optional="hide"/><field name="review_reason" optional="show"/></list></field></page>
      <page string="Overtime"><group><field name="overtime_policy_enabled" readonly="state == 'published'"/><field name="overtime_monthly_limit" readonly="state == 'published'"/><field name="overtime_annual_limit" readonly="state == 'published'"/><field name="overtime_extended_limit_authority" readonly="state == 'published'"/></group><div class="alert alert-info">When enabled, payroll requires prior employee and manager approval evidence, monthly timesheet evidence, and policy-compatible rates. Hours above a limit cannot be relabelled as bonus hours. Night and extended categories need a reviewed policy treatment.</div></page><page string="Entitlement and workflow"><group><group><field name="annual_days" readonly="state == 'published'"/><field name="carry_cap" readonly="state == 'published'"/><field name="joiner_proration" readonly="state == 'published'"/><field name="exit_divisor" readonly="state == 'published'"/><field name="exit_cashout_cap" readonly="state == 'published'"/></group><group><field name="workflow_mode" readonly="state == 'published'"/><field name="workflow_authority_ref" readonly="state == 'published'"/></group></group><field name="interpretation_notes" readonly="state == 'published'"/></page></notebook>
    </sheet></form>
  </field></record>
  <record id="policy_posting_list" model="ir.ui.view"><field name="name">pb.leave.policy.posting.list</field><field name="model">pb.leave.policy.posting</field><field name="arch" type="xml">
    <list create="0" edit="0" delete="0"><field name="employee_id"/><field name="leave_type_id"/><field name="year"/><field name="kind"/><field name="days"/><field name="lapsed_days"/><field name="allocation_id"/><field name="allocation_state"/></list>
  </field></record>
  <record id="policy_posting_form" model="ir.ui.view"><field name="name">pb.leave.policy.posting.form</field><field name="model">pb.leave.policy.posting</field><field name="arch" type="xml">
    <form create="0" edit="0" delete="0"><sheet><group><field name="edition_id"/><field name="employee_id"/><field name="leave_type_id"/><field name="year"/><field name="kind"/><field name="posting_key"/><field name="allocation_id"/><field name="allocation_state"/><field name="days"/><field name="source_days"/><field name="lapsed_days"/><field name="cutover_date"/><field name="opening_carried_days"/><field name="opening_taken_days"/><field name="review_reference"/><field name="source_allocation_ids" widget="many2many_tags"/></group></sheet></form>
  </field></record>
  <record id="policy_operation_form" model="ir.ui.view"><field name="name">pb.leave.policy.operation.form</field><field name="model">pb.leave.policy.operation</field><field name="arch" type="xml">
    <form string="Entitlement and exit operations"><group><field name="edition_id"/><field name="employee_id"/><field name="leave_type_id"/><field name="operation"/><field name="on_date"/><field name="employment_start" invisible="operation not in ['annual', 'exit']" required="operation in ['annual', 'exit']"/><field name="review_reference"/><field name="reviewed_quantity" invisible="operation not in ['annual', 'exit']"/><field name="reviewed_days" invisible="operation != 'annual' or not reviewed_quantity"/><field name="reviewed_months" invisible="operation != 'exit' or not reviewed_quantity"/><field name="available_days" invisible="operation != 'opening'"/><field name="carried_days" invisible="operation != 'opening'"/><field name="taken_year_to_date" invisible="operation != 'opening'"/><field name="gross_salary" invisible="operation != 'exit'"/></group>
    <div class="alert alert-info">Annual credits and rollover use native allocation approval. Exit assessment does not release payment or debit leave: it must be reviewed in the final settlement. Opening balances require reconciled legacy allocations.</div><field name="result" invisible="not result"/><footer><button name="action_execute" type="object" string="Execute / assess" class="btn-primary"/><button string="Close" special="cancel"/></footer></form>
  </field></record>
  <record id="policy_type_form" model="ir.ui.view"><field name="name">hr.leave.type.policy.form</field><field name="model">hr.leave.type</field><field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/><field name="arch" type="xml">
    <xpath expr="//group[@name='leave_validation']" position="after"><group string="Payroll and policy" groups="hr_holidays.group_hr_holidays_manager"><field name="pb_policy_category"/><field name="pb_policy_country_id"/><field name="pb_pay_treatment"/><field name="pb_paid_fraction" invisible="pb_pay_treatment != 'partial'"/><field name="pb_pay_funding"/><field name="pb_employer_paid_fraction" invisible="pb_pay_funding != 'mixed'"/></group></xpath>
  </field></record>
  <record id="policy_request_form" model="ir.ui.view"><field name="name">hr.leave.policy.form</field><field name="model">hr.leave</field><field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/><field name="arch" type="xml">
    <xpath expr="//sheet" position="inside"><group string="Policy and evidence"><field name="pb_policy_rule_id"/><field name="pb_policy_evidence_ref"/><field name="pb_policy_event_key"/><field name="pb_policy_event_date"/><field name="pb_policy_expected_delivery"/><field name="pb_policy_child_birth_date"/><field name="pb_policy_child_country_id"/><field name="pb_policy_surviving_children"/><field name="pb_policy_children_in_birth"/><field name="pb_policy_employment_start"/><field name="pb_policy_eligibility_verified" groups="hr_holidays.group_hr_holidays_manager"/><field name="pb_policy_medical_ref" groups="hr_holidays.group_hr_holidays_manager"/></group><group string="Authorized exception" groups="hr_holidays.group_hr_holidays_manager"><field name="pb_policy_exception_ref"/><field name="pb_policy_exception_authority"/><field name="pb_policy_exception_by"/><field name="pb_policy_exception_at"/><button name="action_record_policy_exception" type="object" string="Record authority evidence"/></group></xpath>
  </field></record>
  <record id="policy_employee_form" model="ir.ui.view"><field name="name">hr.employee.absence.policy</field><field name="model">hr.employee</field><field name="inherit_id" ref="hr.view_employee_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Absence policy assignment" groups="hr_holidays.group_hr_holidays_manager"><field name="pb_leave_policy_id"/><field name="pb_policy_full_time_confirmed"/><field name="pb_policy_eligibility_review_ref"/></group></xpath></field></record>
  <record id="action_policy_editions" model="ir.actions.act_window"><field name="name">Absence Policy Editions</field><field name="res_model">pb.leave.policy.edition</field><field name="view_mode">list,form</field></record>
  <record id="action_policy_postings" model="ir.actions.act_window"><field name="name">Entitlement Posting Audit</field><field name="res_model">pb.leave.policy.posting</field><field name="view_mode">list,form</field></record>
  <record id="policy_settlement_list" model="ir.ui.view"><field name="name">pb.leave.policy.settlement.list</field><field name="model">pb.leave.policy.settlement</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="employee_id"/><field name="closed_on"/><field name="leave_type_id"/><field name="cashout_days"/><field name="lapsed_days"/><field name="period_input_reference"/></list></field></record>
  <record id="policy_settlement_form" model="ir.ui.view"><field name="name">pb.leave.policy.settlement.form</field><field name="model">pb.leave.policy.settlement</field><field name="arch" type="xml"><form create="false" edit="false" delete="false"><sheet><group><field name="employee_id"/><field name="edition_id"/><field name="leave_type_id"/><field name="closed_on"/><field name="cashout_days"/><field name="lapsed_days"/><field name="exit_reference"/><field name="period_input_reference"/><field name="posted_by"/><field name="posted_at"/><field name="allocation_ids" widget="many2many_tags"/></group><group string="Original allocation validity and balance"><field name="allocation_audit_json" nolabel="1"/></group><group string="Approved assessment"><field name="assessment_json" nolabel="1"/></group></sheet></form></field></record>
  <record id="action_policy_settlements" model="ir.actions.act_window"><field name="name">Terminal Leave Settlements</field><field name="res_model">pb.leave.policy.settlement</field><field name="view_mode">list,form</field></record>
  <record id="action_policy_operations" model="ir.actions.act_window"><field name="name">Entitlement and Exit Operations</field><field name="res_model">pb.leave.policy.operation</field><field name="view_mode">form</field><field name="target">new</field></record>
  <menuitem id="menu_policy_editions" name="Absence Policy Editions" parent="hr_holidays.menu_hr_holidays_configuration" action="action_policy_editions" sequence="70" groups="hr_holidays.group_hr_holidays_manager"/>
  <menuitem id="menu_policy_operations" name="Entitlement and Exit Operations" parent="hr_holidays.menu_hr_holidays_management" action="action_policy_operations" sequence="80" groups="hr_holidays.group_hr_holidays_manager"/>
  <menuitem id="menu_policy_postings" name="Entitlement Posting Audit" parent="hr_holidays.menu_hr_holidays_management" action="action_policy_postings" sequence="81" groups="hr_holidays.group_hr_holidays_user"/>
  <menuitem id="menu_policy_settlements" name="Terminal Leave Settlements" parent="hr_holidays.menu_hr_holidays_management" action="action_policy_settlements" sequence="82" groups="hr_holidays.group_hr_holidays_manager"/>
</odoo>
