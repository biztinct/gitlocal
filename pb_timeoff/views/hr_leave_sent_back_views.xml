<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WF2 P6c (owner decision D36, 16 Nov): the standard time-off form
         keeps "Refused" in its status bar (the request IS refused
         underneath, so no day is held) and says, in one plain line, that it
         was sent back to the employee and why. The two link fields name the
         request that asked it again, or the one this request asks again.
         vi/id: this module's i18n files. -->
    <record id="hr_leave_view_form_pb_sent_back" model="ir.ui.view">
        <field name="name">hr.leave.form: sent back, not refused</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='dashboard_warning_message']" position="before">
                <field name="pb_sent_back_note" class="alert alert-warning d-flex mt-2 mb-1" role="status"
                       readonly="1" invisible="not pb_sent_back_note"/>
                <group name="pb_again" invisible="not pb_again_of_id and not pb_again_id" class="mt-0 mb-1">
                    <field name="pb_again_of_id" readonly="1" invisible="not pb_again_of_id"
                           options="{'no_create': True, 'no_open': False}"/>
                    <field name="pb_again_id" readonly="1" invisible="not pb_again_id"
                           options="{'no_create': True, 'no_open': False}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
