<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!-- ==================================================================
         A SEAT IS ALSO A READ (approval matrix, ledger AM60).

         Time off travels a published route now, and a route may name anybody
         as the HR lead — somebody who holds no time-off role at all. The
         engine re-checks that a decider can READ the record before it accepts
         a decision, so without this the step would be handed to a person the
         ORM then refuses, which is a dead end rather than a decision.

         READ ONLY. Being asked to decide a leave has never been permission to
         change one: recording it is still the time-off module's own action,
         which asks its own question about who may.
         ================================================================== -->

    <record id="leave_rule_seat" model="ir.rule">
        <field name="name">Time off: the people a route asked to decide it</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('seat_user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ==================================================================
         THE CARRY-FORWARD LOG, AND WHY THERE ARE TWO RULES AND NOT ONE.

         `ir.rule` group rules are ORed over the rules that APPLY, so a narrow
         rule shipped ALONE is a narrowing for everybody who holds the group
         it names (R60/R65) — and every officer also holds `base.group_user`.
         The pair is therefore the whole design: everybody may see the
         warnings that are about THEM, and the time-off team may see every
         warning in the companies they are in.
         ================================================================== -->

    <record id="carry_rule_mine" model="ir.rule">
        <field name="name">Carry-forward warnings: my own</field>
        <field name="model_id" ref="model_pb_timeoff_carry_log"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="carry_rule_officer" model="ir.rule">
        <field name="name">Carry-forward warnings: the time-off team</field>
        <field name="model_id" ref="model_pb_timeoff_carry_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('hr_holidays.group_hr_holidays_user')), (4, ref('hr_holidays.group_hr_holidays_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</data>
</odoo>
