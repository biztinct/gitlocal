<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- WORKFORCE › Leave (Leave Command Center — HR/officer persona).
         noupdate="0": sidebar item records are program-managed (W8/W13); the
         sequence collided with Timecards (30) until P0 moved it to 32. -->
    <record id="item_leave_center" model="pb.sidebar.item">
        <field name="section_id" ref="pb_sidebar.sec_workforce"/>
        <field name="name">Leave</field>
        <field name="icon">calendar</field>
        <field name="sequence">32</field>
        <field name="action_xmlid">pb_timeoff.action_pb_timeoff</field>
        <field name="action_tag">pb_timeoff</field>
        <field name="match_action_tags">pb_timeoff</field>
        <field name="groups_id" eval="[(6, 0, [ref('hr_holidays.group_hr_holidays_user'), ref('hr.group_hr_manager'), ref('om_hr_payroll.group_hr_payroll_manager')])]"/>
    </record>
</odoo>
