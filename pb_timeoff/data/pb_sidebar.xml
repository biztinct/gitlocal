<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- WORKFORCE › Time Off (Leave Command Center — HR/officer persona).
         noupdate="0": sidebar item records are program-managed (W8/W13); the
         sequence collided with Timecards (30) until P0 moved it to 32, and P1b
         renumbered the whole section to the Option-A rail (40).

         Renamed "Leave" -> "Time Off" so the rail speaks the market's language
         (Deputy/Homebase/BambooHR all say Time Off); the cockpit, its action and
         its gate are untouched. Icon `umbrella` rather than `calendar`, which
         Schedule now owns — two rail items with the same glyph are two items an
         officer has to read to tell apart. -->
    <!-- RETIRED by Workforce P3a: the Leave Command Center is now the Time Off
         LENS of Mission Control (pb_mission mounts this component with
         embedded="true", W17 — its month nav travels with it, because the month
         is this cockpit's own dimension and the shell has no opinion about it).
         The action survives; only the rail entry goes, into the 900 band (W18).
         This record was the program's FIRST W13.1 casualty (frozen until P0),
         which is why the file above is noupdate="0" and this edit just lands. -->
    <record id="item_leave_center" model="pb.sidebar.item">
        <field name="section_id" ref="pb_sidebar.sec_workforce"/>
        <field name="name">Time Off</field>
        <field name="icon">umbrella</field>
        <field name="sequence">909</field>
        <field name="active" eval="False"/>
        <field name="action_xmlid">pb_timeoff.action_pb_timeoff</field>
        <field name="action_tag">pb_timeoff</field>
        <field name="match_action_tags">pb_timeoff</field>
        <field name="groups_id" eval="[(6, 0, [ref('hr_holidays.group_hr_holidays_user'), ref('hr.group_hr_manager'), ref('om_hr_payroll.group_hr_payroll_manager')])]"/>
    </record>
</odoo>
