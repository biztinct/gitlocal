<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- ==================================================================
         THE DIALS, each with the value it ships with.

         `noupdate="1"` because these are the business's numbers the moment
         somebody changes one, and an upgrade must never put a decision back.

         pb_timeoff.escalate_days   2     days past a step's deadline before
                                          the HR lead is told. Read by the
                                          route seed and its migration; the
                                          engine's own late block does the
                                          chasing, never a cron of ours.
         pb_timeoff.lock_past       1     a leave that has started cannot be
                                          changed by the person who asked for
                                          it. 0 puts the stock behaviour back.
         pb_timeoff.carry_watch     1     1 warns, 0 counts and logs the
                                          number it would have warned (R54).
         pb_timeoff.carry_cutoff    12-31 the day a balance stops counting.
         pb_timeoff.carry_warn_months 6   how long before the cut-off the
                                          warning window opens.
         ================================================================== -->

    <record id="param_escalate_days" model="ir.config_parameter">
      <field name="key">pb_timeoff.escalate_days</field>
      <field name="value">2</field>
    </record>

    <record id="param_lock_past" model="ir.config_parameter">
      <field name="key">pb_timeoff.lock_past</field>
      <field name="value">1</field>
    </record>

    <record id="param_carry_watch" model="ir.config_parameter">
      <field name="key">pb_timeoff.carry_watch</field>
      <field name="value">1</field>
    </record>

    <record id="param_carry_cutoff" model="ir.config_parameter">
      <field name="key">pb_timeoff.carry_cutoff</field>
      <field name="value">12-31</field>
    </record>

    <record id="param_carry_warn_months" model="ir.config_parameter">
      <field name="key">pb_timeoff.carry_warn_months</field>
      <field name="value">6</field>
    </record>

    <!-- ==================================================================
         The monthly job. `numbercall` and `doall` were REMOVED from ir.cron
         on Odoo 19 and including either aborts the whole module load; there
         are no eval expressions for `nextcall` in a data file either, so the
         first run is a literal date in the near future and the job walks on
         from there by itself.
         ================================================================== -->
    <record id="cron_carry_watch" model="ir.cron">
      <field name="name">Time off: days to use before the cut-off</field>
      <field name="model_id" ref="model_pb_timeoff_carry_watch"/>
      <field name="state">code</field>
      <field name="code">model.cron_carry_watch()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">months</field>
      <field name="nextcall">2026-10-01 06:00:00</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
