<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A company's own rule is seen only in that company; a rule with no
         company is shared by every company in its country. -->
    <record id="rule_pb_contract_rule_company" model="ir.rule">
        <field name="name">Fixed-term rule: shared or this company</field>
        <field name="model_id" ref="model_pb_contract_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
