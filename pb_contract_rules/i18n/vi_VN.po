#. module: pb_contract_rules
#: model:ir.model.fields,help:pb_contract_rules.field_pb_contract_rule__max_months_each
msgid "0 = no limit on one contract."
msgstr "0 = không giới hạn cho một hợp đồng."

#. module: pb_contract_rules
#: model:ir.model.fields,field_description:pb_contract_rules.field_pb_contract_rule__gap_days
msgid "A break longer than this starts a new row (days)"
