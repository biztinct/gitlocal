#. module: pb_contract_rules
#: model_terms:ir.actions.act_window,help:pb_contract_rules.action_pb_contract_rule
msgid "Add one per country: how many fixed-term contracts may follow each other, and how long they may run in total."
msgstr "Thêm một quy định cho mỗi quốc gia: bao nhiêu hợp đồng xác định thời hạn được ký liên tiếp, và tổng thời gian tối đa."

#. module: pb_contract_rules
#: model:ir.model.fields,help:pb_contract_rules.field_pb_contract_rule__max_months_total
msgid "All fixed-term contracts in a row together, extensions included. 0 = no limit."
msgstr "Tổng các hợp đồng xác định thời hạn liên tiếp, kể cả gia hạn. 0 = không giới hạn."

#. module: pb_contract_rules
