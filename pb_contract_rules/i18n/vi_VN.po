#. module: pb_contract_rules
#: model:pb.contract.rule,name:pb_contract_rules.rule_id
msgid "Indonesia rule"
msgstr "Quy định Indonesia"

#. module: pb_contract_rules
#: model:pb.contract.rule,source_note:pb_contract_rules.rule_vn
msgid "Labour Code 2019, article 20: a fixed-term contract runs at most 36 months; when it ends, one more fixed-term contract may be signed, and after that the contract should be permanent. There are exceptions (older workers, foreign workers, some union officials and state-enterprise managers). To confirm with an adviser."
msgstr "Bộ luật Lao động 2019, điều 20: hợp đồng xác định thời hạn tối đa 36 tháng; khi hết hạn chỉ được ký thêm một lần hợp đồng xác định thời hạn, sau đó phải ký hợp đồng không xác định thời hạn. Có ngoại lệ (người cao tuổi, lao động nước ngoài, một số cán bộ công đoàn và người quản lý doanh nghiệp nhà nước). Cần xác nhận với chuyên gia tư vấn."

#. module: pb_contract_rules
#: model:ir.model.fields,help:pb_contract_rules.field_pb_contract_rule__company_id
