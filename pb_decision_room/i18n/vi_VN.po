#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid " Joining and leaving costs land here."
msgstr " Chi phí tuyển dụng và nghỉ việc rơi vào tháng này."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid " The yearly bonus is paid this month."
msgstr " Thưởng hằng năm được trả trong tháng này."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
" This team does not earn revenue in this model, so adding people here "
"changes cost only."
msgstr ""
" Bộ phận này không tạo doanh thu trong mô hình này, nên thêm người ở đây chỉ"
" làm tăng chi phí."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid " and "
msgstr " và "

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid " in steps of %s people"
msgstr " theo bước %s người"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid " or "
msgstr " hoặc "

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid " with %s smaller changes"
msgstr " cùng %s thay đổi nhỏ hơn"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid " with 1 smaller change"
msgstr " cùng 1 thay đổi nhỏ hơn"

#. module: pb_decision_room
#. odoo-python
#: code:addons/pb_decision_room/models/pb_decision_room.py:0
msgid "\"%(label)s\" has to be between %(low)s and %(high)s."
msgstr "\"%(label)s\" phải nằm trong khoảng %(low)s đến %(high)s."

#. module: pb_decision_room
#. odoo-python
#: code:addons/pb_decision_room/models/pb_decision_room.py:0
msgid "\"%s\" cannot be negative."
msgstr "\"%s\" không được là số âm."

#. module: pb_decision_room
#. odoo-python
#: code:addons/pb_decision_room/models/pb_decision_room.py:0
msgid "\"%s\" needs to be a number."
msgstr "\"%s\" phải là một con số."

#. module: pb_decision_room
#. odoo-python
#: code:addons/pb_decision_room/models/pb_decision_room.py:0
msgid ""
"\"%s\" was saved by %s. Ask them to replace it, or save yours under another "
"name."
msgstr ""
"\"%s\" do %s lưu. Hãy đề nghị họ thay thế, hoặc lưu kế hoạch của bạn với tên"
" khác."

#. module: pb_decision_room
#. odoo-python
#: code:addons/pb_decision_room/models/pb_decision_room.py:0
msgid "\"%s\" was saved by %s. Only they, or your HR lead, can remove it."
msgstr "\"%s\" do %s lưu. Chỉ họ hoặc phụ trách nhân sự của bạn mới xoá được."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(bound)s %(target)s · %(gap)s"
msgstr "%(bound)s %(target)s · %(gap)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
"%(cost)s of workforce cost for the year, %(perhead)s for each person on "
"average. Add a revenue target and profit appears."
msgstr ""
"%(cost)s chi phí nhân sự cho cả năm, trung bình %(perhead)s mỗi người. Nhập "
"mục tiêu doanh thu và lợi nhuận sẽ hiện ra."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(delta)s against %(name)s. %(tail)s"
msgstr "%(delta)s so với %(name)s. %(tail)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
"%(delta)s of yearly profit against your previous plan. %(met)s of %(all)s "
"goals met. Your previous plan is kept until you choose."
msgstr ""
"%(delta)s lợi nhuận cả năm so với kế hoạch trước của bạn. Đạt %(met)s trên "
"%(all)s mục tiêu. Kế hoạch cũ vẫn được giữ cho tới khi bạn quyết định."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(delta)s vs %(name)s"
msgstr "%(delta)s so với %(name)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
"%(evening)s of the people who earn revenue work evenings and %(night)s work "
"nights, paid %(eu)s and %(nu)s above base pay. The work itself arrives "
"%(dd)s during the day, %(de)s in the evening and %(dn)s at night — a shift "
"can only serve the work that arrives on it."
msgstr ""
"%(evening)s số người tạo doanh thu làm ca chiều và %(night)s làm ca đêm, "
"được trả thêm %(eu)s và %(nu)s trên lương cơ bản. Công việc đến %(dd)s vào "
"ban ngày, %(de)s vào buổi chiều tối và %(dn)s vào ban đêm — mỗi ca chỉ phục "
"vụ được phần công việc đến trong ca đó."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(fixed)s a month, plus %(pct)s of whatever you sell."
msgstr "%(fixed)s mỗi tháng, cộng %(pct)s trên những gì bạn bán ra."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(gaps)s. %(keeps)s"
msgstr "%(gaps)s. %(keeps)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
"%(gaps)s. Adding people, hours or productive time only moves the plan "
"further away, so the search came back to where you started. Ease a goal, "
"change the revenue target, or look at what the work itself is worth."
msgstr ""
"%(gaps)s. Thêm người, thêm giờ hay thêm thời gian làm việc hiệu quả chỉ "
"khiến kế hoạch xa mục tiêu hơn, nên cuộc tìm kiếm quay lại đúng nơi bạn bắt "
"đầu. Hãy nới một mục tiêu, đổi mục tiêu doanh thu, hoặc xem lại giá trị của "
"chính công việc đó."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%(lead)s adds %(money)s of profit for the year%(rest)s."
msgstr "%(lead)s làm tăng %(money)s lợi nhuận cả năm%(rest)s."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%(lead)s costs %(money)s of profit for the year%(rest)s."
msgstr "%(lead)s làm giảm %(money)s lợi nhuận cả năm%(rest)s."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(met)s of %(all)s goals met. Let us close the gaps."
msgstr "Đạt %(met)s trên %(all)s mục tiêu. Hãy cùng thu hẹp khoảng cách."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(met)s of %(all)s goals met. Room to think bigger."
msgstr "Đạt %(met)s trên %(all)s mục tiêu. Vẫn còn dư địa để nghĩ lớn hơn."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(month)s is your %(measure)s month at %(value)s.%(extra)s"
msgstr "%(month)s là tháng %(measure)s của bạn, ở mức %(value)s.%(extra)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%(month)s loses money (%(money)s) — %(why)s."
msgstr "%(month)s bị lỗ (%(money)s) — %(why)s."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(month)s: %(cost)s of workforce cost"
msgstr "%(month)s: %(cost)s chi phí nhân sự"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(month)s: %(now)s (was %(was)s)"
msgstr "%(month)s: %(now)s (trước là %(was)s)"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(month)s: %(profit)s profit, %(served)s of demand served"
msgstr "%(month)s: lợi nhuận %(profit)s, đáp ứng %(served)s công việc"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(months)s of pay, in %(month)s."
msgstr "%(months)s tiền lương, vào %(month)s."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%(n)s fewer people in %(team)s from %(month)s"
msgstr "ít hơn %(n)s người ở %(team)s từ %(month)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%(n)s fewer person in %(team)s from %(month)s"
msgstr "ít hơn %(n)s người ở %(team)s từ %(month)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)s goal%(s)s still missed"
msgstr "còn %(n)s mục tiêu chưa đạt%(s)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)s h"
msgstr "%(n)s giờ"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%(n)s h a month"
msgstr "%(n)s giờ mỗi tháng"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)s in %(team)s"
msgstr "%(n)s ở %(team)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)s more in %(team)s · preview"
msgstr "thêm %(n)s người ở %(team)s · xem thử"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)s more in %(where)s · preview"
msgstr "thêm %(n)s người ở %(where)s · xem thử"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)s more people in %(team)s from %(month)s"
msgstr "thêm %(n)s người ở %(team)s từ %(month)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)s more people in %(team)s would add %(money)s of profit."
msgstr "Thêm %(n)s người ở %(team)s sẽ tăng %(money)s lợi nhuận."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)s more people in %(team)s would cost %(money)s of profit."
msgstr "Thêm %(n)s người ở %(team)s sẽ mất %(money)s lợi nhuận."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%(n)s more person in %(team)s from %(month)s"
msgstr "thêm %(n)s người ở %(team)s từ %(month)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid ""
"%(n)s new people is a lot to recruit at once — roughly %(months)s recruiter-"
"months of work. Spreading them over two or three months is kinder to "
"everyone."
msgstr ""
"%(n)s người mới là rất nhiều để tuyển cùng lúc — khoảng %(months)s tháng "
"công của người tuyển dụng. Chia ra hai hoặc ba tháng sẽ nhẹ nhàng hơn cho "
"tất cả."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_format.js:0
msgid "%(n)s people"
msgstr "%(n)s người"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
"%(n)s people arrive during the year, paid in full from their first day and "
"about half as productive while they learn. Recruiting them costs %(cost)s, "
"once."
msgstr ""
"%(n)s người vào làm trong năm, được trả lương đầy đủ từ ngày đầu tiên và làm"
" được khoảng một nửa năng suất trong lúc học việc. Tuyển họ tốn %(cost)s, "
"một lần."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_format.js:0
msgid "%(n)s person"
msgstr "%(n)s người"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)sk h"
msgstr "%(n)s nghìn giờ"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(n)sm h"
msgstr "%(n)s triệu giờ"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(name)s %(before)s → your plan %(after)s. %(tail)s"
msgstr "%(name)s %(before)s → kế hoạch của bạn %(after)s. %(tail)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(name)s: %(heads)s people, comparison %(was)s"
msgstr "%(name)s: %(heads)s người, mốc so sánh %(was)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
"%(people)s people in %(teams)s teams, as they stood on %(date)s. Pay is the "
"monthly salary on each open contract."
msgstr ""
"%(people)s người trong %(teams)s bộ phận, tính đến ngày %(date)s. Lương là "
"mức lương tháng trên từng hợp đồng đang hiệu lực."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(range)s more people in %(where)s"
msgstr "thêm %(range)s người ở %(where)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
"%(rev)s of revenue − %(people)s of workforce − %(other)s of other costs = "
"%(profit)s of operating profit. Margin %(margin)s."
msgstr ""
"%(rev)s doanh thu − %(people)s chi phí nhân sự − %(other)s chi phí khác = "
"%(profit)s lợi nhuận hoạt động. Biên lợi nhuận %(margin)s."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%(role)s in %(team)s"
msgstr "%(role)s ở %(team)s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%(share)s of demand goes unserved — %(money)s left on the table."
msgstr "%(share)s công việc không được đáp ứng — bỏ lỡ %(money)s."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_format.js:0
msgid "%(value)s pp"
msgstr "%(value)s điểm %"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s a month"
msgstr "%s mỗi tháng"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid ""
"%s fewer roles than the comparison. Nothing here changes anybody's job — it "
"is a picture, not a decision."
msgstr ""
"Ít hơn %s vị trí so với mốc so sánh. Không có gì ở đây thay đổi công việc "
"của ai — đây là một bức tranh, không phải một quyết định."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s h a month"
msgstr "%s giờ mỗi tháng"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s hours"
msgstr "%s giờ"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid ""
"%s hours of overtime a person brushes the legal monthly cap for factory "
"roles. Hiring may cost less."
msgstr ""
"%s giờ làm thêm mỗi người đã chạm trần luật định hằng tháng cho công việc "
"nhà máy. Tuyển thêm người có thể rẻ hơn."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%s hours of overtime per person"
msgstr "%s giờ làm thêm mỗi người"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s month"
msgstr "%s tháng"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s months"
msgstr "%s tháng"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%s months of bonus"
msgstr "thưởng %s tháng lương"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s of demand goes unserved this year."
msgstr "%s công việc không được đáp ứng trong năm nay."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s of demand is left on the table."
msgstr "Bỏ lỡ %s công việc."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_engine.js:0
msgid "%s of demand still goes unserved."
msgstr "%s công việc vẫn không được đáp ứng."

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s of room left"
msgstr "còn dư %s"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s of the hours this team can work"
msgstr "%s số giờ bộ phận này có thể làm"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s of the work served"
msgstr "đáp ứng %s công việc"

#. module: pb_decision_room
#. odoo-javascript
#: code:addons/pb_decision_room/static/src/js/decision_room.js:0
msgid "%s of work goes unserved on this shift"
msgstr "%s công việc không được đáp ứng trong ca này"

#. module: pb_decision_room
