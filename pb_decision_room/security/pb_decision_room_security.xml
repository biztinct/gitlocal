<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         THE LADDER. Two tiers, in the Odoo 19 shape (a privilege record,
         not `category_id` on the group, which no longer exists):

           plan         open the room, save and remove your own plans
           assumptions  everything above, plus the numbers behind the
                        picture and anyone's plan

         Who gets the first tier without being given it by hand:
           * the HR manager — a data record here, `hr` is a dependency;
           * every Workforce Planning tier — linked by `post_init_hook`
             instead, because a database that ever dropped that module
             would fail to INSTALL on a data record naming its group.
         ================================================================== -->

    <record id="module_category_decision_room" model="ir.module.category">
        <field name="name">Decision Room</field>
        <field name="sequence">54</field>
    </record>

    <record id="res_groups_privilege_decision_room" model="res.groups.privilege">
        <field name="name">Decision Room</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_decision_room"/>
    </record>

    <record id="group_decision_user" model="res.groups">
        <field name="name">Plan</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_decision_room"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Open the Decision Room, explore the year and keep your own plans.</field>
    </record>

    <record id="group_decision_manager" model="res.groups">
        <field name="name">Assumptions</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_decision_room"/>
        <field name="implied_ids" eval="[(4, ref('group_decision_user'))]"/>
        <field name="comment">Change the numbers behind the picture, and remove anyone's plan.</field>
    </record>

    <!-- Additive: this only ADDS an implication to a group somebody else
         owns, it never restates that group. -->
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pb_decision_room.group_decision_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pb_decision_room.group_decision_manager'))]"/>
    </record>

<data noupdate="1">

    <!-- ==================================================================
         COMPANY SCOPE. A plan and a set of assumptions belong to the
         company they were written for, and to nobody else.
         ================================================================== -->

    <record id="rule_decision_plan_company" model="ir.rule">
        <field name="name">Decision Room plan: company</field>
        <field name="model_id" ref="model_pb_decision_plan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_decision_assumptions_company" model="ir.rule">
        <field name="name">Decision Room assumptions: company</field>
        <field name="model_id" ref="model_pb_decision_assumptions"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ==================================================================
         WHOSE PLAN IS IT. Everyone in the company READS every plan — that
         is the point of saving it on the server. CHANGING one is the
         author's, and the planning lead's. Group rules are OR'd, so the
         lead's `1=1` below re-opens what this one narrows.
         ================================================================== -->

    <record id="rule_decision_plan_mine" model="ir.rule">
        <field name="name">Decision Room plan: mine to change</field>
        <field name="model_id" ref="model_pb_decision_plan"/>
        <field name="groups" eval="[(4, ref('group_decision_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_decision_plan_lead" model="ir.rule">
        <field name="name">Decision Room plan: the planning lead</field>
        <field name="model_id" ref="model_pb_decision_plan"/>
        <field name="groups" eval="[(4, ref('group_decision_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</data>

<!-- ======================================================================
     GROUP P7 — WHO SEES WHAT.

     The same two-branch shape as `pb_group.rule_division_link_visibility`,
     and the reasoning is written out once there:

       * `user.pb_vis_kind` is empty for everybody who has not been given a
         visibility row, and the domain is then `[(1, '=', 1)]` — no
         narrowing at all. Nothing changes for anyone until an administrator
         says it should.
       * A DIVISION scope filters on the division, which already implies the
         companies its departments sit in.
       * Every other scope filters on the company.

     The three fields are computed and NOT stored on `res.users`
     (`pb_group/models/pb_group_visibility.py`), so this is plain attribute
     access, exactly like every rule the platform ships.

     A GLOBAL rule, and deliberately not `noupdate`: it is plumbing, and a
     correction has to reach a database that already carries yesterday's
     version (GR25).
     ====================================================================== -->

<record id="rule_decision_plan_visibility" model="ir.rule">
    <field name="name">Decision Room plan: who sees what</field>
    <field name="model_id" ref="model_pb_decision_plan"/>
    <field name="global" eval="True"/>
    <field name="domain_force">[(1, '=', 1)] if not user.pb_vis_kind else ([('pb_division_id', 'in', user.pb_vis_division_ids.ids)] if user.pb_vis_division_ids else ['|', ('company_id', 'in', user.pb_vis_company_ids.ids), ('company_ids', 'in', user.pb_vis_company_ids.ids)])</field>
</record>


</odoo>
