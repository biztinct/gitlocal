<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Malaysia Dashboard Actions -->
    <record id="action_malaysia_dashboard_window" model="ir.actions.act_window">
        <field name="name">Open Malaysia Payroll Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_malaysia"/>
        <field name="target">current</field>
        <field name="res_id" ref="malaysia_payroll_dashboard"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'MY'}</field>
        <field name="domain">[('country', '=', 'MY')]</field>
    </record>
    
    <record id="action_payroll_dashboard_malaysia" model="ir.actions.act_window">
        <field name="name">Malaysia Payroll Dashboard Professional</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_malaysia"/>
        <field name="target">current</field>
        <field name="res_id" ref="malaysia_payroll_dashboard"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'MY', 'force_view': True}</field>
        <field name="domain">[('country', '=', 'MY')]</field>
    </record>

    <!-- Malaysia spreadsheet actions -->
    <record id="action_malaysia_edit_spreadsheet" model="ir.actions.server">
        <field name="name">Edit Malaysia Payroll Spreadsheet</field>
        <field name="model_id" ref="spreadsheet_oca.model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.client',
    'tag': 'action_spreadsheet_oca',
    'params': {
        'spreadsheet_id': env.ref('__custom__.payrollstaging_malaysia', raise_if_not_found=False).id if env.ref('__custom__.payrollstaging_malaysia', raise_if_not_found=False) else False,
    },
    'context': {'payroll_country': 'MY'}
}
        </field>
    </record>
    
    <record id="action_malaysia_import_spreadsheet" model="ir.actions.server">
        <field name="name">Import Malaysia Spreadsheet</field>
        <field name="model_id" ref="spreadsheet_oca.model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
spreadsheet = env.ref('__custom__.payrollstaging_malaysia', raise_if_not_found=False)
if spreadsheet:
    action = spreadsheet.with_context(payroll_country='MY').import_json_data()
else:
    raise UserError('Malaysia payroll spreadsheet not found. Please create it with external ID __custom__.payrollstaging_malaysia')
        </field>
    </record>
    
    <!-- EPF Action for Malaysia -->
    <record id="action_epf_wizard" model="ir.actions.act_window">
        <field name="name">Employees Provident Fund Wizard</field>
        <field name="res_model">epf.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_payroll_country': 'MY'}</field>
    </record>
    
    <!-- Malaysia Dashboard Menu under base dashboard section -->
    <menuitem id="menu_malaysia_dashboard"
              name="Malaysia Dashboard"
              parent="pb_hr_payroll_base.menu_payroll_dashboard_section"
              action="action_malaysia_dashboard_window"
              sequence="70"
              groups="pb_hr_payroll_base.group_payroll_malaysia"/>
    
    <!-- Malaysia EPF Menu under original Payroll menu -->
    <menuitem id="menu_malaysia_epf"
              name="Malaysia EPF Reporting"
              parent="pb_hr_payroll_base.menu_payroll_backup_root"
              action="action_epf_wizard"
              sequence="70"
              groups="pb_hr_payroll_base.group_payroll_malaysia"/>
    
</odoo>