<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily license re-validation cron -->
    <record id="cron_license_check" model="ir.cron">
        <field name="name">Vendor License: Daily Validation</field>
        <field name="model_id" ref="vendor_license_core.model_vendor_license_state"/>
        <field name="state">code</field>
        <field name="code">model.check_license()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
