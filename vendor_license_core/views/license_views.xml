<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- License Status Form View -->
    <record id="view_vendor_license_state_form" model="ir.ui.view">
        <field name="name">vendor.license.state.form</field>
        <field name="model">vendor.license.state</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="check_license" type="object"
                            string="Re-check License Now"
                            class="btn-primary"
                            groups="base.group_system"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Valid"
                            bg_color="bg-success"
                            invisible="status != 'valid'"/>
                    <widget name="web_ribbon" title="Grace Period"
                            bg_color="bg-warning"
                            invisible="status != 'grace'"/>
                    <widget name="web_ribbon" title="Expired"
                            bg_color="bg-danger"
                            invisible="status not in ('expired', 'missing', 'tampered', 'fingerprint_mismatch', 'invalid', 'over_employee_limit')"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="License Details">
                            <field name="status"/>
                            <field name="customer"/>
                            <field name="license_id"/>
                            <field name="expiry"/>
                            <field name="max_employees_display"/>
                            <field name="current_employees"/>
                            <field name="grace_days_left"
                                   invisible="status != 'grace'"/>
                        </group>
                        <group string="Server Info">
                            <field name="fingerprint" widget="char"/>
                            <field name="last_check"/>
                        </group>
                    </group>
                    <separator string="Details"/>
                    <field name="message" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- License Status Action -->
    <record id="action_vendor_license_state" model="ir.actions.act_window">
        <field name="name">License Status</field>
        <field name="res_model">vendor.license.state</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="limit">1</field>
    </record>

    <!-- License Audit Log List View -->
    <record id="view_vendor_license_log_list" model="ir.ui.view">
        <field name="name">vendor.license.log.list</field>
        <field name="model">vendor.license.log</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="create_date" string="Date"/>
                <field name="event_type"/>
                <field name="details"/>
                <field name="fingerprint_hash"/>
            </list>
        </field>
    </record>

    <!-- License Audit Log Action -->
    <record id="action_vendor_license_log" model="ir.actions.act_window">
        <field name="name">License Audit Log</field>
        <field name="res_model">vendor.license.log</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- Menu under Settings > Technical -->
    <menuitem id="menu_vendor_license_root"
              name="Vendor License"
              parent="base.menu_custom"
              sequence="100"
              groups="base.group_system"/>

    <menuitem id="menu_vendor_license_status"
              name="License Status"
              parent="menu_vendor_license_root"
              action="action_vendor_license_state"
              sequence="10"/>

    <menuitem id="menu_vendor_license_log"
              name="Audit Log"
              parent="menu_vendor_license_root"
              action="action_vendor_license_log"
              sequence="20"/>

</odoo>
