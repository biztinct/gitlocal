#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/js/plan_hiring.js:0
msgid "%(made)s of %(lines)s hires have a request"
msgstr "%(made)s trên %(lines)s vị trí cần tuyển đã có yêu cầu"

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "Anyone in the team"
msgstr "Bất kỳ ai trong nhóm"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid "Close"
msgstr "Đóng"

#. module: pb_plan_hiring
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_decision_plan__display_name
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_decision_room__display_name
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_hiring__display_name
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_hiring_requisition__display_name
msgid "Display Name"
msgstr "Tên hiển thị"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/js/plan_hiring.js:0
msgid "Draft hiring requests made: %s. Nothing has been sent in."
msgstr "Yêu cầu tuyển dụng nháp đã tạo: %s. Chưa có yêu cầu nào được gửi đi."

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid ""
"Each line you tick becomes a draft hiring request for that team, with the "
"month as the date wanted. Nothing is sent in: the manager finishes each "
"request and sends it in as usual."
msgstr ""
"Mỗi dòng bạn đánh dấu sẽ thành một yêu cầu tuyển dụng nháp cho nhóm đó, với "
"tháng là ngày cần người. Không có gì được gửi đi: quản lý hoàn thiện từng "
"yêu cầu và gửi như thường lệ."

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "From the approved plan \"%s\"."
msgstr "Từ kế hoạch đã duyệt \"%s\"."

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid "From the approved plan:"
msgstr "Từ kế hoạch đã duyệt:"

#. module: pb_plan_hiring
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_hiring_requisition__pb_plan_id
msgid "From the plan"
msgstr "Từ kế hoạch"

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "Give a job title for %(team)s, %(month)s."
msgstr "Hãy nhập chức danh cho %(team)s, %(month)s."

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "Has a hiring request"
msgstr "Đã có yêu cầu tuyển dụng"

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "Hiring is paused for this team."
msgstr "Đang tạm dừng tuyển dụng cho nhóm này."

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "Hiring is paused for this team: %s"
msgstr "Đang tạm dừng tuyển dụng cho nhóm này: %s"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_decision_plan__pb_requisition_ids
msgid "Hiring requests"
msgstr "Yêu cầu tuyển dụng"

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid ""
"Hiring requests are made by whoever runs that part of the business, or by "
"the hiring team. Ask one of them to press this."
msgstr ""
"Yêu cầu tuyển dụng do người phụ trách bộ phận đó hoặc nhóm tuyển dụng tạo. "
"Hãy nhờ một người trong số họ bấm nút này."

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid "Hiring requests from the plan"
msgstr "Yêu cầu tuyển dụng từ kế hoạch"

#. module: pb_plan_hiring
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_decision_plan__id
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_decision_room__id
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_hiring__id
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_hiring_requisition__id
msgid "ID"
msgstr "ID"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid "Job title, for example Store assistant"
msgstr "Chức danh, ví dụ Nhân viên cửa hàng"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/js/plan_hiring.js:0
msgid "Leaving: %s"
msgstr "Nghỉ việc: %s"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/js/plan_hiring.js:0
msgid "Make draft requests (%s)"
msgstr "Tạo yêu cầu nháp (%s)"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid "Not handled here"
msgstr "Không xử lý ở đây"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid "Nothing to make"
msgstr "Không có gì để tạo"

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "Only an approved plan makes hiring requests. Approve it first."
msgstr ""
"Chỉ kế hoạch đã duyệt mới tạo được yêu cầu tuyển dụng. Hãy duyệt trước."

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "Other roles"
msgstr "Vị trí khác"

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "People leaving are not handled here"
msgstr "Người nghỉ việc không được xử lý ở đây"

#. module: pb_plan_hiring
#: model:ir.model.fields,field_description:pb_plan_hiring.field_pb_hiring_requisition__pb_plan_line_key
msgid "Plan line"
msgstr "Dòng kế hoạch"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid "Reading the plan…"
msgstr "Đang đọc kế hoạch…"

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/js/plan_hiring.js:0
msgid "That did not work. Try again in a moment."
msgstr "Không thực hiện được. Hãy thử lại sau giây lát."

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "That hiring request is no longer there."
msgstr "Yêu cầu tuyển dụng đó không còn nữa."

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "That hiring request is not open to you."
msgstr "Bạn không xem được yêu cầu tuyển dụng đó."

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid "That plan is no longer there."
msgstr "Kế hoạch đó không còn nữa."

#. module: pb_plan_hiring
#: model:ir.model.fields,help:pb_plan_hiring.field_pb_hiring_requisition__pb_plan_id
msgid "The approved Decision Room plan this request was made from."
msgstr ""
"Kế hoạch đã duyệt trong Phòng quyết định mà yêu cầu này được tạo từ đó."

#. module: pb_plan_hiring
#. odoo-python
#: code:addons/pb_plan_hiring/models/plan_hiring.py:0
msgid ""
"This line covers several small teams. Make the request on the Hiring board "
"and choose the team there."
msgstr ""
"Dòng này gồm nhiều nhóm nhỏ. Hãy tạo yêu cầu trên bảng Tuyển dụng và chọn "
"nhóm ở đó."

#. module: pb_plan_hiring
#: model:ir.model.constraint,message:pb_plan_hiring.constraint_pb_hiring_requisition_pb_plan_line_unique
msgid "This line of the plan already has a hiring request."
msgstr "Dòng này của kế hoạch đã có yêu cầu tuyển dụng."

#. module: pb_plan_hiring
#. odoo-javascript
#: code:addons/pb_plan_hiring/static/src/xml/plan_hiring.xml:0
msgid "This plan adds nobody, so there is nothing to ask for."
msgstr "Kế hoạch này không thêm ai, nên không có gì để yêu cầu."
