<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A person reads their own PayAI requests. -->
    <record id="rule_payai_task_own" model="ir.rule">
        <field name="name">PayAI requests: own</field>
        <field name="model_id" ref="model_payai_task"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!-- A payroll manager reads every request made in their companies
         (the Audit console's PayAI source). -->
    <record id="rule_payai_task_manager" model="ir.rule">
        <field name="name">PayAI requests: payroll manager, own companies</field>
        <field name="model_id" ref="model_payai_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
    </record>
</odoo>
