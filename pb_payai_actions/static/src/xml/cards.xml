<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ===================================================== the PayAI card
       ONE template, called from both chat variants (floating pill and the
       helper drawer's Ask tab). It draws only what the server sent: the
       client never decides a tier or a right. -->
  <t t-name="pb_payai_actions.Card">
    <t t-set="card" t-value="msg.card"/>
    <div t-attf-class="payai-card payai-card--{{ card.kind }} payai-tier--{{ card.tier }} {{ this.payaiCompact(card) ? 'is-compact' : '' }} {{ card.state ? 'is-' + card.state : '' }} {{ card.superseded ? 'is-superseded' : '' }} {{ card.busy ? 'is-busy' : '' }}"
         role="group" t-att-aria-label="card.title" t-att-aria-busy="card.state === 'running' ? 'true' : 'false'">
      <div class="payai-card__head">
        <span t-attf-class="payai-card__badge payai-tone--{{ this.payaiTone(card) }}"
              t-out="this.payaiSvg(this.payaiCardIcon(card))"/>
        <div class="payai-card__ht">
          <div class="payai-card__title" t-esc="card.title"/>
          <div class="payai-card__sub" t-if="card.subtitle" t-esc="card.subtitle"/>
        </div>
        <t t-if="this.payaiCompact(card)">
          <t t-foreach="card.actions" t-as="act" t-key="act_index">
            <button type="button" class="payai-card__mini"
                    t-on-click="() => this.payaiAct(msg, act)"
                    t-att-title="act.label">
              <t t-out="this.payaiSvg(act.id === 'download' ? 'download' : 'arrow')"/>
            </button>
          </t>
        </t>
      </div>

      <div class="payai-card__body" t-if="!this.payaiCompact(card)">
        <div class="payai-card__slots" t-if="card.slots and card.slots.length">
          <t t-foreach="card.slots" t-as="slot" t-key="slot.key">
            <span class="payai-card__k" t-esc="slot.label"/>
            <span class="payai-card__v">
              <span t-esc="slot.value_label"/>
              <span t-attf-class="payai-src payai-src--{{ slot.origin }}" t-esc="slot.origin_label or this.payaiOrigin(slot.origin)"/>
              <button type="button" class="payai-card__edit"
                      t-if="slot.editable and card.state === 'planned' and (card.actions or []).length"
                      t-att-aria-label="this.payaiEditLabel(slot)" t-att-title="this.payaiEditLabel(slot)"
                      t-on-click="() => this.payaiEdit(msg, slot)">
                <t t-out="this.payaiSvg('pencil')"/>
              </button>
            </span>
          </t>
        </div>

        <!-- No total yet = an indeterminate bar: no valuemax/valuenow at all
             (false drops the attribute). The words are a polite live region. -->
        <div class="payai-card__prog" t-if="card.progress and card.kind === 'plan' and card.state !== 'planned'"
             role="progressbar" t-att-aria-label="card.progress.label or card.title"
             aria-valuemin="0"
             t-att-aria-valuemax="card.progress.total ? card.progress.total : false"
             t-att-aria-valuenow="card.progress.total ? (card.progress.done or 0) : false">
          <div class="payai-card__progtext" aria-live="polite">
            <span t-esc="card.progress.label"/>
            <span class="payai-card__progn" t-if="card.progress.total">
              <t t-esc="this.payaiNum(card.progress.done)"/> / <t t-esc="this.payaiNum(card.progress.total)"/>
            </span>
          </div>
          <div class="payai-card__bar"><i t-attf-style="width: {{ this.payaiPct(card) }}%"/></div>
        </div>

        <div class="payai-card__tiles" t-if="card.result and card.result.length">
          <t t-foreach="card.result" t-as="tile" t-key="tile_index">
            <div class="payai-card__tile">
              <b t-esc="tile.value"/>
              <small t-esc="tile.label"/>
            </div>
          </t>
        </div>

        <t t-foreach="card.notes or []" t-as="note" t-key="note_index">
          <div t-attf-class="payai-card__note payai-tone--{{ note.tone }}">
            <t t-out="this.payaiSvg(this.payaiNoteIcon(note.tone))"/>
            <span t-esc="note.text"/>
          </div>
        </t>

        <t t-foreach="card.groups or []" t-as="grp" t-key="grp_index">
          <div t-attf-class="payai-card__group payai-tone--{{ grp.tone }}">
            <div class="payai-card__glabel">
              <span class="payai-card__dot"/>
              <span t-esc="grp.label"/>
            </div>
            <t t-foreach="grp.items" t-as="item" t-key="item_index">
              <button type="button" class="payai-card__gitem"
                      t-att-disabled="grp.tone !== 'ok'"
                      t-on-click="() => this.payaiAsk(item.example)">
                <span class="payai-card__gname" t-esc="item.label"/>
                <span class="payai-card__gex" t-if="item.example">“<t t-esc="item.example"/>”</span>
              </button>
            </t>
          </div>
        </t>

        <div class="payai-card__chips" t-if="card.chips and card.chips.length">
          <t t-foreach="card.chips" t-as="chip" t-key="chip_index">
            <button type="button"
                    t-attf-class="payai-chip {{ this.payaiChipOn(card, chip) ? 'is-on' : '' }}"
                    t-att-disabled="this.payaiChipOff(card, chip) ? 'disabled' : false"
                    t-on-click="() => this.payaiPick(msg, chip)">
              <span t-esc="chip.label"/>
              <small t-if="chip.sublabel" t-esc="chip.sublabel"/>
            </button>
          </t>
        </div>

        <!-- P3 Red: the typed word sits ABOVE the other buttons. -->
        <t t-set="typedAct" t-value="card.state === 'planned' ? this.payaiTypedAct(card) : null"/>
        <PayaiTypedConfirm t-if="typedAct" act="typedAct" card="card"
                           onSubmit="(word, note) => this.payaiTypedDo(msg, word, note)"/>

        <div class="payai-card__actions" t-if="card.actions and card.actions.some((a) => a.id !== 'typed')">
          <t t-foreach="card.actions" t-as="act" t-key="act_index">
            <t t-if="act.id !== 'typed'">
            <span class="payai-card__spacer" t-if="act.id === 'cancel'"/>
            <button type="button"
                    t-attf-class="payai-btn payai-btn--{{ act.style or 'outline' }} {{ act.id === 'do' ? 'payai-btn--do' : '' }}"
                    t-att-disabled="card.busy ? 'disabled' : false"
                    t-on-click="() => this.payaiAct(msg, act)">
              <t t-if="act.id === 'do' and card.busy" t-out="this.payaiSvg('loader')"/>
              <t t-elif="act.id !== 'do'" t-out="this.payaiSvg(this.payaiActIcon(act))"/>
              <span t-esc="act.label"/>
            </button>
            </t>
          </t>
        </div>

        <div t-attf-class="payai-card__undo {{ card.undo.can ? '' : 'is-off' }}" t-if="card.undo and card.state === 'done'">
          <t t-out="this.payaiSvg('undo')"/>
          <span class="payai-card__undotext">
            <t t-esc="card.undo.note"/>
            <t t-if="card.undo.can and card.undo.until_iso">
              <b class="payai-card__clock"><PayaiCountdown until="card.undo.until_iso" onExpire="() => this.payaiUndoExpired(msg)"/></b>
            </t>
          </span>
          <button type="button" class="payai-btn payai-btn--ghost" t-if="card.undo.can"
                  t-att-disabled="card.busy ? 'disabled' : false"
                  t-on-click="() => this.payaiUndo(msg)">
            <t t-esc="card.undo.label"/>
          </button>
        </div>

        <div class="payai-card__audit" t-if="card.audit_line">
          <t t-out="this.payaiSvg('scroll')"/>
          <span t-esc="card.audit_line"/>
        </div>
      </div>
      <div class="payai-card__audit is-compact" t-if="this.payaiCompact(card) and card.audit_line">
        <span t-esc="card.audit_line"/>
      </div>
    </div>
  </t>

  <t t-name="pb_payai_actions.Countdown"><t t-esc="left"/> left</t>

  <!-- P3 — the typed-word confirm. The word is in the hint, the box is
       focused on arrival, the button lights the instant the word matches,
       Enter submits; a wrong word is an inline hint (role=alert). -->
  <t t-name="pb_payai_actions.TypedConfirm">
    <div t-attf-class="payai-typed {{ ok ? 'is-ok' : '' }} {{ props.card.typed_error ? 'is-bad' : '' }}">
      <label class="payai-typed__notefield" t-if="props.act.note">
        <span class="payai-typed__k" t-esc="props.act.note.label"/>
        <input type="text" class="payai-typed__note" maxlength="2000"
               t-att-placeholder="props.act.note.placeholder" t-model="state.note"
               t-att-disabled="props.card.busy"/>
      </label>
      <div class="payai-typed__hint" t-att-id="uid + '-hint'">
        <t t-out="icon('keyboard')"/>
        <span t-esc="props.act.hint"/>
      </div>
      <div class="payai-typed__row">
        <input type="text" t-ref="word" class="payai-typed__input"
               autocomplete="off" autocapitalize="characters" spellcheck="false"
               t-att-placeholder="props.act.word"
               t-att-aria-label="props.act.hint"
               t-att-aria-describedby="uid + '-hint'"
               t-att-aria-invalid="props.card.typed_error ? 'true' : 'false'"
               t-att-disabled="props.card.busy"
               t-on-input="onInput" t-on-keydown="onKey"/>
        <button type="button" t-attf-class="payai-btn payai-btn--{{ props.act.style or 'primary' }} payai-btn--typed"
                t-att-disabled="!ok or props.card.busy ? 'disabled' : false"
                t-on-click="() => this.submit()">
          <t t-if="props.card.busy" t-out="icon('loader')"/>
          <t t-else="" t-out="icon(ok ? 'check' : (props.act.icon or 'check'))"/>
          <span t-esc="props.act.label"/>
        </button>
      </div>
      <div class="payai-typed__error" role="alert" t-if="props.card.typed_error">
        <t t-out="icon('alert')"/>
        <span t-esc="props.card.typed_error"/>
      </div>
    </div>
  </t>

  <!-- The floating pill: the card follows the text; the text is the card's
       own title, so it is not drawn twice. -->
  <t t-inherit="pb_payroll_ai_insights.AiInsightChat" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('payai-msg-text')]" position="attributes">
      <attribute name="t-if">!msg.card</attribute>
    </xpath>
    <xpath expr="//div[hasclass('payai-msg-text')]" position="after">
      <t t-if="msg.card" t-call="pb_payai_actions.Card"/>
    </xpath>
    <xpath expr="//t[@t-foreach='state.messages']/div" position="attributes">
      <attribute name="t-att-class">'payai-message payai-msg-' + msg.role + (msg.card ? ' payai-has-card' : '')</attribute>
    </xpath>
  </t>

  <!-- The helper drawer's Ask tab: same card, same place. -->
  <t t-inherit="pb_payroll_ai_insights.AiInsightChatEmbedded" t-inherit-mode="extension">
    <xpath expr="//div[hasclass('payai-embed-text')]" position="attributes">
      <attribute name="t-if">!msg.card</attribute>
    </xpath>
    <xpath expr="//div[hasclass('payai-embed-text')]" position="after">
      <t t-if="msg.card" t-call="pb_payai_actions.Card"/>
    </xpath>
    <xpath expr="//t[@t-foreach='state.messages']/div" position="attributes">
      <attribute name="t-att-class">'payai-embed-msg ' + (msg.role === 'user' ? 'me' : 'ai') + (msg.card ? ' payai-has-card' : '')</attribute>
    </xpath>
  </t>

</templates>
