<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_thr_payment_wizard" model="ir.ui.view">
        <field name="name">thr.payment.wizard.form</field>
        <field name="model">thr.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Process THR Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="payment_date"/>
                            <field name="religious_holiday"/>
                        </group>
                    </group>
                    <group string="Employees">
                        <field name="employee_ids" nolabel="1">
                            <tree>
                                <field name="name"/>
                                <field name="employee_id"/>
                                <field name="department_id"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="process_thr_payment" string="Generate THR Payslips" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_thr_payment_wizard" model="ir.actions.act_window">
        <field name="name">Process THR Payment</field>
        <field name="res_model">thr.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <menuitem id="menu_thr_payment"
              name="THR Payment"
              parent="pb_hr_payroll_base.menu_payroll_backup_root"
              action="action_thr_payment_wizard"
              sequence="15"/>
    
</odoo>
