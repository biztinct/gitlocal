<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Security Groups for Each Country -->
    <record id="group_indonesia_payroll_user" model="res.groups">
        <field name="name">Indonesia Payroll User</field>
        <field name="category_id" ref="base.module_category_human_resources_payroll"/>
        <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user')), (4, ref('pb_hr_payroll_base.group_payroll_indonesia'))]"/>
    </record>
    
    
    <!-- Actions Definition First (before menu items that reference them) -->
    
    <!-- Action for Country Selector -->
    <record id="action_open_country_selector" model="ir.actions.act_url">
        <field name="name">Select Payroll Country</field>
        <field name="url">/payroll/country-selector</field>
        <field name="target">self</field>
    </record>
    
    <!-- Server Actions for Dashboard (must be defined before menu items reference them) -->
    <record id="action_indonesia_dashboard_window" model="ir.actions.act_window">
        <field name="name">Open Indonesia Payroll Dashboard</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_indonesia"/>
        <field name="target">current</field>
        <field name="res_id" ref="indonesia_payroll_dashboard"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'ID'}</field>
        <field name="domain">[('country', '=', 'ID')]</field>
    </record>
    
    <!-- Country Selector Expected Action for Indonesia -->
    <record id="action_payroll_dashboard_indonesia" model="ir.actions.act_window">
        <field name="name">Indonesia Payroll Dashboard Professional</field>
        <field name="res_model">payroll.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_payroll_dashboard_indonesia"/>
        <field name="target">current</field>
        <field name="res_id" ref="indonesia_payroll_dashboard"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'default_country': 'ID', 'force_view': True}</field>
        <field name="domain">[('country', '=', 'ID')]</field>
    </record>

    
    <!-- Indonesia Specific Actions -->
    <record id="action_zoho_staging_importer_indonesia" model="ir.actions.act_window">
        <field name="name">Get Employee Data - Indonesia</field>
        <field name="res_model">zoho.staging.importer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_payroll_country': 'ID'}</field>
    </record>
    
    <!-- Indonesia spreadsheet actions -->
    <record id="action_indonesia_edit_spreadsheet" model="ir.actions.server">
        <field name="name">Edit Indonesia Payroll Spreadsheet</field>
        <field name="model_id" ref="spreadsheet_oca.model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
# Indonesia-specific spreadsheet configuration
spreadsheet_ref = env.ref('pb_hr_payroll_indonesia.payrollstaging_indonesia', raise_if_not_found=False)
if not spreadsheet_ref:
    # Fallback: create a notification if spreadsheet doesn't exist
    action = {
        'type': 'ir.actions.client',
        'tag': 'display_notification',
        'params': {
            'message': 'Indonesia payroll spreadsheet not found. Please create the spreadsheet first.',
            'type': 'warning',
            'sticky': True,
        }
    }
else:
    action = {
        'type': 'ir.actions.client',
        'tag': 'action_spreadsheet_oca',
        'params': {
            'spreadsheet_id': spreadsheet_ref.id,
        },
        'context': {'payroll_country': 'ID'}
    }
        </field>
    </record>
    
    <record id="action_indonesia_import_spreadsheet" model="ir.actions.server">
        <field name="name">Import Indonesia Spreadsheet</field>
        <field name="model_id" ref="spreadsheet_oca.model_spreadsheet_spreadsheet"/>
        <field name="state">code</field>
        <field name="code">
spreadsheet = env.ref('__custom__.payrollstaging_indonesia', raise_if_not_found=False)
if spreadsheet:
    action = spreadsheet.with_context(payroll_country='ID').import_json_data()
else:
    raise UserError('Indonesia payroll spreadsheet not found. Please create it with external ID __custom__.payrollstaging_indonesia')
        </field>
    </record>
    
    <!-- THR Payment Action for Indonesia -->
    <record id="action_thr_payment_wizard" model="ir.actions.act_window">
        <field name="name">THR Payment Wizard</field>
        <field name="res_model">thr.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_payroll_country': 'ID'}</field>
    </record>
    
    <!-- Indonesia Dashboard Menu under base dashboard section -->
    <menuitem id="menu_indonesia_dashboard"
              name="Indonesia Dashboard"
              parent="pb_hr_payroll_base.menu_payroll_dashboard_section"
              action="action_indonesia_dashboard_window"
              sequence="20"
              groups="pb_hr_payroll_base.group_payroll_indonesia"/>
    
    <!-- Indonesia THR Menu under original Payroll menu -->
    <menuitem id="menu_indonesia_thr"
              name="Indonesia THR Payments"
              parent="om_hr_payroll.menu_hr_payroll_root"
              action="action_thr_payment_wizard"
              sequence="25"
              groups="pb_hr_payroll_base.group_payroll_indonesia"/>
    
</odoo>