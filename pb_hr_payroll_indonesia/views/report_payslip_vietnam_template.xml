<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_vietnam">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-if="o.company_id.logo">
                            <div style="text-align: center; margin-bottom: 8px;">
                                <img t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 80px;" alt="Company Logo"/>
                            </div>
                        </t>

                        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                            <colgroup>
                                <col style="width: 45%;"/>
                                <col style="width: 35%;"/>
                                <col style="width: 20%;"/>
                            </colgroup>
                            <tr>
                                <th colspan="3" style="border: 1px solid #000; background: #1f6f7a; color: #fff; padding: 6px; text-align: center;">
                                    THÔNG TIN LƯƠNG THÁNG
                                    <t t-esc="(o.date_to or o.date_from).strftime('%m/%Y') if (o.date_to or o.date_from) else ''"/>
                                </th>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">MÃ SỐ NHÂN VIÊN</td>
                                <td style="border: 1px solid #000; padding: 4px;">Employee ID</td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="o.employee_id.employee_id or o.employee_id.identification_id or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">HỌ TÊN</td>
                                <td style="border: 1px solid #000; padding: 4px;">Full name</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o.employee_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Ngày công tiêu chuẩn trong tháng</td>
                                <td style="border: 1px solid #000; padding: 4px;">Standard working days in month</td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="o._report_fmt_amount(o._report_get_work_value('WORK100', 'STANDARD', 'STDWORK', 'NGAYCONG'))"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px; text-align: left; font-weight: bold;">I. LƯƠNG &amp; PHỤ CẤP</td>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px; text-align: left; font-weight: bold;">I. SALARY &amp; ALLOWANCES</td>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px;"></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Ngạch lương</td>
                                <td style="border: 1px solid #000; padding: 4px;">Salary grade</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('PAYGRADE', 'GRADE', 'NGACHLUONG', 'NGACH_LUONG', 'NGẠCH LƯƠNG', 'NGACH LUONG'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương cơ bản</td>
                                <td style="border: 1px solid #000; padding: 4px;">Basic salary</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('BASICSALARY', 'BASIC', 'BASESALARY', 'BASIC_SALARY', 'WAGE', 'ACTBASIC', 'ACTBASE', 'LƯƠNG CƠ BẢN', 'LUONG CO BAN'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">PC Thâm niên</td>
                                <td style="border: 1px solid #000; padding: 4px;">Seniority allowance</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('SENIORITY', 'SENIORITYALLOW', 'PC_THAMNIEN', 'THAMNIEN', 'PHỤ CẤP THÂM NIÊN', 'PHU CAP THAM NIEN'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">PC Chức danh</td>
                                <td style="border: 1px solid #000; padding: 4px;">Title allowance</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('TITLEALLOW', 'POSITIONALLOW', 'PC_CHUCDANH', 'CHUCDANH', 'PHỤ CẤP CHỨC DANH', 'PHU CAP CHUC DANH'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">PC Kiêm nhiệm</td>
                                <td style="border: 1px solid #000; padding: 4px;">Concurrent position allowance</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('KIEMNHIEM', 'CONCURRENT', 'PC_KIEMNHIEM', 'ADDITIONALROLE', 'PHỤ CẤP KIÊM NHIỆM', 'PHU CAP KIEM NHIEM'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Thưởng hiệu quả công việc</td>
                                <td style="border: 1px solid #000; padding: 4px;">Performance bonus</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('EFFICIENCYSALARY', 'EFFICIENCY', 'PERFORMANCEBONUS', 'HQCV', 'BONUS_EFF', 'THƯỞNG HIỆU QUẢ CÔNG VIỆC', 'THUONG HIEU QUA CONG VIEC'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px; text-align: left; font-weight: bold;">II. TỔNG THU NHẬP TRONG THÁNG</td>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px; text-align: left; font-weight: bold;">II. TOTAL INCOME IN MONTH</td>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px;"></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Tỷ lệ % HQCV tháng</td>
                                <td style="border: 1px solid #000; padding: 4px;">Performance rate (%)</td>
                                <td style="border: 1px solid #000; padding: 4px;">
                                    <t t-esc="o._report_fmt_percent(o._report_get_line_total_by_keys('HQCVRATE', 'PERFORMANCE_RATE', 'TYLEHQCV', 'HQCV_PERCENT', 'TỶ LỆ HQCV', 'TY LE HQCV'))"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold;">1. Lương theo ngày công</td>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold;">1. Daily wages</td>
                                <td style="border: 1px solid #000; padding: 4px;"></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương ngày thường</td>
                                <td style="border: 1px solid #000; padding: 4px;">Regular day salary</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('NORMALDAY', 'WORKDAY', 'LUONGNGAYTHUONG', 'REGULARPAY', 'LƯƠNG NGÀY THƯỜNG', 'LUONG NGAY THUONG'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương ngày nghỉ chế độ</td>
                                <td style="border: 1px solid #000; padding: 4px;">Paid leave salary</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('PAIDLEAVE', 'NGHIPHEP', 'NGHICHE', 'PAID_LEAVE', 'LƯƠNG NGÀY NGHỈ CHẾ ĐỘ', 'LUONG NGAY NGHI CHE DO'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương nghỉ Lễ Tết</td>
                                <td style="border: 1px solid #000; padding: 4px;">Holiday salary</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('HOLIDAYPAY', 'LETPAY', 'NGHILE', 'HOLIDAY', 'LƯƠNG NGHỈ LỄ TẾT', 'LUONG NGHI LE TET'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương nghỉ phép năm</td>
                                <td style="border: 1px solid #000; padding: 4px;">Annual leave salary</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('ANNUALLEAVE', 'LEAVEPAY', 'PHEPNAM', 'LƯƠNG NGHỈ PHÉP NĂM', 'LUONG NGHI PHEP NAM'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương nghỉ bất khả kháng</td>
                                <td style="border: 1px solid #000; padding: 4px;">Force majeure leave salary</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('FORCELEAVE', 'BATKHAKHANG', 'LƯƠNG NGHỈ BẤT KHẢ KHÁNG', 'LUONG NGHI BAT KHA KHANG'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương ngày Tạm ngừng việc</td>
                                <td style="border: 1px solid #000; padding: 4px;">Work suspension day salary</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('SUSPENDPAY', 'TAMNGUNG', 'LƯƠNG NGÀY TẠM NGỪNG VIỆC', 'LUONG NGAY TAM NGUNG VIEC'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương tăng ca ngày thường</td>
                                <td style="border: 1px solid #000; padding: 4px;">Weekday overtime pay</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('OT_NORMAL', 'OTDAY', 'OT15', 'OTNORMAL', 'LƯƠNG TĂNG CA NGÀY THƯỜNG', 'LUONG TANG CA NGAY THUONG'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương tăng ca ngày nghỉ</td>
                                <td style="border: 1px solid #000; padding: 4px;">Weekend overtime pay</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('OT_WEEKEND', 'OT2', 'OT200', 'OTDAYOFF', 'LƯƠNG TĂNG CA NGÀY NGHỈ', 'LUONG TANG CA NGAY NGHI'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương tăng ca lễ</td>
                                <td style="border: 1px solid #000; padding: 4px;">Holiday overtime pay</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('OT_HOLIDAY', 'OT3', 'OT300', 'LƯƠNG TĂNG CA LỄ', 'LUONG TANG CA LE'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương làm việc ngày Bảy được nghỉ</td>
                                <td style="border: 1px solid #000; padding: 4px;">Saturday work (compensatory leave) pay</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('SATURDAYPAY', 'SATURDAYOFF', 'L7NGHI', 'LƯƠNG LÀM VIỆC NGÀY BẢY ĐƯỢC NGHỈ', 'LUONG LAM VIEC NGAY BAY DUOC NGHI'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Tạm ứng Thưởng HQCV tháng</td>
                                <td style="border: 1px solid #000; padding: 4px;">Performance bonus advance</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('ADV_HQCV', 'HQCV_ADV', 'TAMUNGHQCV', 'TẠM ỨNG THƯỞNG HQCV', 'TAM UNG THUONG HQCV'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold;">2. Các khoản thu nhập khác</td>
                                <td style="border: 1px solid #000; padding: 4px; font-weight: bold;">2. Other income</td>
                                <td style="border: 1px solid #000; padding: 4px;"></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Lương quyết toán phép năm NV nghỉ việc</td>
                                <td style="border: 1px solid #000; padding: 4px;">Annual leave settlement (resigned)</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('LEAVESETTLEMENT', 'PHEPQT', 'QUYETTOANPHEP', 'LƯƠNG QUYẾT TOÁN PHÉP NĂM', 'LUONG QUYET TOAN PHEP NAM'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Tiền cơm tháng</td>
                                <td style="border: 1px solid #000; padding: 4px;">Meal allowance</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('MEAL', 'MEALALLOW', 'MEALALLOWANCE', 'TIENCOM', 'TIỀN CƠM', 'TIEN COM'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Truy lãnh (+)/ Truy thu lương (-)</td>
                                <td style="border: 1px solid #000; padding: 4px;">Back pay (+) / salary recovery (-)</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('RETRO', 'TRUYLANH', 'TRUYTHU', 'TRUY LÃNH', 'TRUY LANH'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Hỗ trợ nhà ở</td>
                                <td style="border: 1px solid #000; padding: 4px;">Housing support</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('HOUSING', 'HOUSE', 'NHARO', 'HỖ TRỢ NHÀ Ở', 'HO TRO NHA O'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Bồi dưỡng PHSK</td>
                                <td style="border: 1px solid #000; padding: 4px;">Health recovery allowance (PHSK)</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('PHSK', 'HEALTHALLOW', 'BOIDUONG', 'BỒI DƯỠNG PHSK', 'BOI DUONG PHSK'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px; text-align: left; font-weight: bold;">III. CÁC KHOẢN TRỪ</td>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px; text-align: left; font-weight: bold;">III. DEDUCTIONS</td>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px;"></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">1. BHXH-BHYT-BHTN tháng</td>
                                <td style="border: 1px solid #000; padding: 4px;">Social/Health/Unemployment insurance</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_sum('BHXH', 'BHYT', 'BHTN', 'SI', 'HI', 'UI', 'INSURANCE'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">2. Phí công đoàn</td>
                                <td style="border: 1px solid #000; padding: 4px;">Union fee</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('UNION', 'CONGDOAN', 'TU', 'PHÍ CÔNG ĐOÀN', 'PHI CONG DOAN'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">3. Điện thoại vượt mức tháng</td>
                                <td style="border: 1px solid #000; padding: 4px;">Excess phone charge</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('PHONEEXCESS', 'DIENTHOAI', 'DIEN THOAI', 'ĐIỆN THOẠI VƯỢT MỨC', 'DIEN THOAI VUOT MUC'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">4. Thu phí KBT</td>
                                <td style="border: 1px solid #000; padding: 4px;">KBT fee</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('KBT', 'THU PHI KBT'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">5. Cấn trừ mua xe ô tô</td>
                                <td style="border: 1px solid #000; padding: 4px;">Car purchase deduction</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('CARDEDUCT', 'MUAXE', 'CANTRUXE', 'CẤN TRỪ MUA XE Ô TÔ', 'CAN TRU MUA XE O TO'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">6. Phụng điều (0 tin buôn)</td>
                                <td style="border: 1px solid #000; padding: 4px;">Phung Dieu (0 rumors)</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('PHUNGDIEU', 'PHUNG_DIEU', 'PHỤNG ĐIỀU', 'PHUNG DIEU'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">7. Thuế TNCN trong tháng</td>
                                <td style="border: 1px solid #000; padding: 4px;">Personal income tax</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('PIT', 'TNCN', 'TAX', 'THUẾ TNCN', 'THUE TNCN'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">- Số người phụ thuộc</td>
                                <td style="border: 1px solid #000; padding: 4px;">Number of dependents</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o.contract_id.dependents or 0"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px; text-align: left; font-weight: bold;">V. TỔNG THỰC NHẬN TRONG THÁNG</td>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px; text-align: left; font-weight: bold;">V. TOTAL TAKE-HOME IN MONTH</td>
                                <td style="border: 1px solid #000; background: #e4f0f2; padding: 6px;"></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Thực nhận kỳ 1</td>
                                <td style="border: 1px solid #000; padding: 4px;">Net pay period 1</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('NET1', 'NETPERIOD1', 'TAKEHOME1', 'THỰC NHẬN KỲ 1', 'THUC NHAN KY 1'))"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 4px;">Thực nhận kỳ 2</td>
                                <td style="border: 1px solid #000; padding: 4px;">Net pay period 2</td>
                                <td style="border: 1px solid #000; padding: 4px;"><t t-esc="o._report_fmt_amount(o._report_get_line_total_by_keys('NET2', 'NETPERIOD2', 'TAKEHOME2', 'THỰC NHẬN KỲ 2', 'THUC NHAN KY 2'))"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
