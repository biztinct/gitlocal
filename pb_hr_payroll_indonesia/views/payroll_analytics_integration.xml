<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    
    <!-- Extend Indonesia Dashboard with Analytics Integration (when payroll_analytics_approval is installed) -->
    <record id="view_payroll_dashboard_indonesia_analytics" model="ir.ui.view">
        <field name="name">Indonesia Payroll Dashboard with Analytics</field>
        <field name="model">payroll.dashboard</field>
        <field name="inherit_id" ref="pb_hr_payroll_indonesia.view_payroll_dashboard_indonesia"/>
        <field name="arch" type="xml">
            <!-- js_class removed - not compatible with Odoo 19 -->
            
            <!-- Update header background to light variation of 21435F -->
            <xpath expr="//div[@class='dashboard-header']" position="attributes">
                <attribute name="style">background: #f8f9fb; padding: 24px; border-radius: 8px; margin-bottom: 24px; border-left: 4px solid #21435F;</attribute>
            </xpath>
            
            <!-- Update header title color to black -->
            <xpath expr="//h1[@class='dashboard-title']" position="attributes">
                <attribute name="style">color: #2c3e50;</attribute>
            </xpath>
            
            <!-- Add new tiles after existing dashboard cards - Indonesia uses col-lg-4 -->
            <xpath expr="//div[@class='dashboard-container']/div[@class='row'][last()]" position="after">
                
                <!-- Analytics Row for Indonesia -->
                <div class="row">
                    <div class="col-lg-4">
                        <div class="dashboard-card">
                            <div>
                                <i class="fa fa-bar-chart-o fa-3x card-icon"/>
                                <h4 class="card-title">Approval Dashboard</h4>
                                <p class="card-description">Review and approve payroll with detailed analytics</p>
                            </div>
                            <button name="action_open_analytics_dashboard" 
                                    type="object" 
                                    class="dashboard-btn"
                                    context="{'default_country': 'ID'}">
                                Open Dashboard
                            </button>
                        </div>
                    </div>
                    
                    <div class="col-lg-4">
                        <div class="dashboard-card">
                            <div>
                                <i class="fa fa-line-chart fa-3x card-icon"/>
                                <h4 class="card-title">Payroll Comparisons</h4>
                                <p class="card-description">Compare payroll data across periods and analyze trends</p>
                            </div>
                            <button name="action_view_analytics" 
                                    type="object" 
                                    class="dashboard-btn"
                                    context="{'default_country': 'ID'}">
                                View Comparisons
                            </button>
                        </div>
                    </div>
                    
                    <div class="col-lg-4">
                        <div class="dashboard-card" style="opacity: 0.7;">
                            <div>
                                <i class="fa fa-info-circle fa-3x card-icon" style="color: #6c757d;"/>
                                <h4 class="card-title" style="color: #6c757d;">Analytics Info</h4>
                                <p class="card-description">Additional analytics features for Indonesia payroll</p>
                            </div>
                            <button name="dummy_analytics_button" 
                                    type="button" 
                                    class="dashboard-btn" 
                                    style="background: #6c757d; cursor: not-allowed;" 
                                    disabled="disabled">
                                Coming Soon
                            </button>
                        </div>
                    </div>
                </div>
                
            </xpath>
        </field>
    </record>

    </data>
</odoo>