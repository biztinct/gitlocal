<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <t t-name="pb_import.PbImport">
    <div class="pbm">
      <div t-if="!state.loaded" class="pbm-loading"><div class="pbm-spinner"/><span>Loading import data…</span></div>

      <div t-else="" class="pbm-wrap">
        <!-- W17: the hub owns the title row. -->
        <div class="pbm-head" t-if="!props.embedded">
          <div>
            <h1>Import Data</h1>
            <p class="pbm-sub">Bring payroll data in from files and connected HR systems — map, validate, then commit.</p>
          </div>
        </div>

        <!-- KPI strip -->
        <div class="pbm-kpis" data-coach="im-kpis">
          <div class="pbm-kpi"><span class="pbm-kpi-ic"><t t-out="ic('upload',21)"/></span><div class="tx"><span class="v" t-esc="state.kpis.total_batches"/><span class="l">Import batches</span></div></div>
          <div class="pbm-kpi"><span class="pbm-kpi-ic green"><t t-out="ic('checkCircle',21)"/></span><div class="tx"><span class="v green" t-esc="state.kpis.done"/><span class="l">Completed</span></div></div>
          <div class="pbm-kpi"><span class="pbm-kpi-ic blue"><t t-out="ic('refresh',21)"/></span><div class="tx"><span class="v indigo" t-esc="state.kpis.in_progress"/><span class="l">In progress</span></div></div>
          <div class="pbm-kpi"><span class="pbm-kpi-ic rose"><t t-out="ic('alert',21)"/></span><div class="tx"><span t-attf-class="v {{ state.kpis.errors ? 'rose' : '' }}" t-esc="state.kpis.errors"/><span class="l">With errors</span></div></div>
        </div>

        <!-- hero CTA: guided import -->
        <div class="pbm-cta" data-coach="im-cta">
          <span class="ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
          </span>
          <div class="tx">
            <div class="lb">Start an import</div>
            <div class="ds">A guided flow — upload your file, review matches, fix any issues, then commit.</div>
          </div>
          <button class="go" t-on-click="startWizard">
            Start import
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>

        <!-- secondary launches -->
        <div class="pbm-launches" data-coach="im-launches" t-if="secondaryLaunches.length">
          <button t-foreach="secondaryLaunches" t-as="l" t-key="l.xmlid"
                  class="pbm-launch" t-on-click="() => this.launch(l.xmlid)">
            <span class="pbm-launch-ic"><t t-out="tileIcon(l.icon)"/></span>
            <span class="tx">
              <span class="lb" t-esc="l.label"/>
              <span class="ds" t-esc="l.desc"/>
            </span>
            <span class="ar"><t t-out="pipeIcon()"/></span>
          </button>
        </div>

        <!-- pipeline -->
        <div class="pbm-panel">
          <div class="pbm-panel-h"><h2>Import pipeline</h2><span class="pbm-tag">map → validate → commit</span></div>
          <div class="pbm-pipe" data-coach="im-pipe">
            <t t-foreach="state.pipeline" t-as="p" t-key="p.key">
              <button class="pbm-pipe-step" t-on-click="() => this.pipeClick(p.key)"
                      t-att-title="'Show ' + p.label + ' batches'">
                <div t-attf-class="pbm-pipe-num {{ p.count ? 'on' : '' }}" t-esc="p.count"/>
                <div class="pbm-pipe-lbl" t-esc="p.label"/>
              </button>
              <div t-if="!p_last" class="pbm-pipe-arrow">→</div>
            </t>
          </div>
        </div>

        <!-- ==== the one door to connectors ====
             Deliberately a quiet LINK ROW, not a tile and not a panel. Import's
             own tiles all start something here; this one leaves, and the
             difference has to be legible before the click. It carries a back
             chip, so it is a deep link rather than an exit (W5). -->
        <div t-if="canManageConnectors" class="pbm-conndoor" data-coach="im-connectors">
          <span class="ic"><t t-out="ic('plug',16)"/></span>
          <span class="tx">Connectors live in Settings · Integrations</span>
          <span class="n" t-esc="state.connectors"/>
          <button class="go" t-on-click="manageConnectors">
            Manage connectors <t t-out="pipeIcon()"/>
          </button>
        </div>

        <div class="pbm-cols">
          <!-- recent batches -->
          <div class="pbm-panel pbm-grow" data-coach="im-batches">
            <div class="pbm-panel-h">
              <h2>Recent batches</h2>
              <div class="pbm-filters">
                <button t-foreach="['all','draft','in_progress','done','errors']" t-as="f" t-key="f"
                        t-attf-class="pbm-fchip {{ state.filter === f ? 'on' : '' }}" t-on-click="() => this.setFilter(f)">
                  <t t-esc="{all:'All',draft:'Draft',in_progress:'In progress',done:'Done',errors:'Errors'}[f]"/>
                  <span class="c" t-esc="countFor(f)"/>
                </button>
              </div>
            </div>
            <div t-if="filteredBatches.length" class="pbm-table">
              <div class="pbm-tr head">
                <span class="c-nm">Batch</span><span class="c-src">Source</span>
                <span class="c-st">Status</span><span class="c-ct">Lines</span>
                <span class="c-ct">Matched</span><span class="c-ct">Errors</span><span class="c-dt">Date</span>
              </div>
              <div t-foreach="filteredBatches" t-as="b" t-key="b.id" class="pbm-tr" t-on-click="() => this.openBatch(b.id)">
                <span class="c-nm" t-esc="b.name"/>
                <span class="c-src" t-esc="b.source"/>
                <span class="c-st"><span t-attf-class="pbm-badge {{ stateCls(b.state) }}"><span class="d"/><t t-esc="b.state_label"/></span></span>
                <span class="c-ct" t-esc="b.total_lines"/>
                <span class="c-ct" t-esc="b.matched"/>
                <span t-attf-class="c-ct {{ b.errors ? 'rose' : '' }}" t-esc="b.errors"/>
                <span class="c-dt" t-esc="b.date"/>
              </div>
            </div>
            <div t-else="" class="pbm-empty">No batches match this filter.</div>
          </div>
        </div>
      </div>
    </div>
  </t>

</templates>
