#. module: pb_import
#. odoo-javascript
#: code:addons/pb_import/static/src/xml/import.xml:0
msgid ""
"A guided flow — upload your file, review matches, fix any issues, then commit. The "
"tiles below set a scheme up; this one runs a period."
msgstr ""
"Quy trình được hướng dẫn — tải tệp của bạn lên, xem xét kết quả phù hợp, khắc phục mọi"
" sự cố rồi cam kết. Các ô bên dưới thiết lập sơ đồ; cái này chạy một khoảng thời gian."

