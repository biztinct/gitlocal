<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- A seat is also a read (ledger AM60). -->

    <record id="rule_month_proposal_seat" model="ir.rule">
        <field name="name">Reopen a month: the ones I was asked to decide</field>
        <field name="model_id" ref="model_pb_month_proposal"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|',
            ('seat_user_ids', 'in', [user.id]),
            ('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_month_proposal_payroll" model="ir.rule">
        <field name="name">Reopen a month: payroll</field>
        <field name="model_id" ref="model_pb_month_proposal"/>
        <field name="groups" eval="[
            (4, ref('om_hr_payroll.group_hr_payroll_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
