#. module: pb_comp_ben
msgid "%(what)s · %(who)s"
msgstr "%(what)s · %(who)s"

#. module: pb_comp_ben
msgid "Amount"
msgstr "Số tiền"

#. module: pb_comp_ben
msgid "Country director"
msgstr "Giám đốc quốc gia"

#. module: pb_comp_ben
msgid "Finance approver"
msgstr "Người duyệt tài chính"

#. module: pb_comp_ben
msgid "Finance controller"
msgstr "Kiểm soát tài chính"

#. module: pb_comp_ben
msgid "HR lead"
msgstr "Trưởng nhân sự"

#. module: pb_comp_ben
msgid "HR lifecycle team"
msgstr "Nhóm vòng đời nhân sự"

#. module: pb_comp_ben
msgid "Head of pay"
msgstr "Trưởng bộ phận lương thưởng"

#. module: pb_comp_ben
msgid "Payroll manager"
msgstr "Trưởng bộ phận tiền lương"

#. module: pb_comp_ben
msgid "People"
msgstr "Số người"

#. module: pb_comp_ben
msgid "Platform owner"
msgstr "Chủ sở hữu nền tảng"

#. module: pb_comp_ben
msgid "Reopen %s"
msgstr "Mở lại %s"

#. module: pb_comp_ben
msgid "Reopened after approval %(ref)s. Reason: %(why)s"
msgstr "Đã mở lại sau phê duyệt %(ref)s. Lý do: %(why)s"

#. module: pb_comp_ben
msgid "Reopening a closed month needs a reason — it is the only account anybody reviewing this payroll will have of why the month was taken back."
msgstr "Mở lại một tháng đã chốt cần có lý do — đó là căn cứ duy nhất để người rà soát bảng lương hiểu vì sao tháng đó bị lấy lại."

#. module: pb_comp_ben
msgid "Sent for approval"
msgstr "Đã gửi phê duyệt"

#. module: pb_comp_ben
msgid "Sent for approval — %s"
msgstr "Đã gửi phê duyệt — %s"

#. module: pb_comp_ben
msgid "Sent for approval."
msgstr "Đã gửi phê duyệt."

#. module: pb_comp_ben
msgid "That month is already open."
msgstr "Tháng đó đã mở rồi."

#. module: pb_comp_ben
msgid "That month is no longer in the calendar."
msgstr "Tháng đó không còn trong lịch."

#. module: pb_comp_ben
msgid "Their manager"
msgstr "Quản lý của họ"

#. module: pb_comp_ben
msgid "Whole company"
msgstr "Toàn công ty"

#. module: pb_comp_ben
msgid "Yes"
msgstr "Có"

#. module: pb_comp_ben
msgid "its approver"
msgstr "người phê duyệt của nó"

#. module: pb_comp_ben
msgid "none given"
msgstr "không nêu"

#. module: pb_comp_ben
msgid "your approver"
msgstr "người phê duyệt của bạn"
