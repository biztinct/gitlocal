#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "Put awards into a pay run"
msgstr "Đưa khoản thưởng vào đợt lương"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "Which pay run"
msgstr "Đợt lương nào"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "There is no pay run still being prepared. Awards can only be put\n                  into a run that has not been sent for approval yet."
msgstr "Không có đợt lương nào đang được chuẩn bị. Chỉ có thể đưa khoản thưởng\n                  vào đợt lương chưa được gửi duyệt."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "The pay scheme “"
msgstr "Chương trình lương “"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "” has a pay\n                      item called"
msgstr "” có khoản mục\n                      lương tên"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid ", so the money will\n                      show on the payslip."
msgstr ", nên số tiền sẽ\n                      hiện trên phiếu lương."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "Goes in"
msgstr "Được đưa vào"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "of these will be added to\n                    “"
msgstr "khoản trong số này sẽ được thêm vào\n                    “"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "”, worth"
msgstr "”, tổng cộng"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "in total. Nothing is written\n                    to anybody's record — the amount is added to this run and this\n                    run only."
msgstr "Không ghi gì vào hồ sơ của ai — số tiền chỉ được thêm vào đợt lương này\n                    và chỉ đợt này."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/xml/incentives_board.xml:0
msgid "Add them to the run"
msgstr "Thêm vào đợt lương"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "Switch off"
msgstr "Tắt"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "Switch on"
msgstr "Bật"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "The payroll calendar could not be read just now."
msgstr "Chưa đọc được lịch lương lúc này."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "Nothing is planned ahead — build the year to see a countdown here."
msgstr "Chưa lên lịch gì phía trước — hãy lập lịch cả năm để thấy đếm ngược ở đây."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "Changes close today."
msgstr "Hôm nay chốt nhận thay đổi."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "Changes close tomorrow."
msgstr "Ngày mai chốt nhận thay đổi."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "%s days until changes close for %s."
msgstr "Còn %s ngày nữa là chốt nhận thay đổi cho %s."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "That could not be saved."
msgstr "Chưa lưu được."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "1 month added. %s were already there."
msgstr "Đã thêm 1 tháng. %s tháng đã có sẵn."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "%s months added. %s were already there."
msgstr "Đã thêm %s tháng. %s tháng đã có sẵn."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "The year could not be built."
msgstr "Chưa lập được lịch cả năm."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "Reminders are on. People will be emailed before each closing date."
msgstr "Lời nhắc đang bật. Mọi người sẽ được gửi email trước mỗi ngày chốt."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "Reminders are off. Nothing will be emailed."
msgstr "Lời nhắc đang tắt. Sẽ không có email nào được gửi."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "Reminders are switched off. %s would have gone out today."
msgstr "Lời nhắc đang tắt. Lẽ ra hôm nay đã có %s lời nhắc được gửi."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "1 reminder went out."
msgstr "Đã gửi 1 lời nhắc."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "%s reminders went out."
msgstr "Đã gửi %s lời nhắc."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/paycal_board.js:0
msgid "That could not be run just now."
msgstr "Chưa chạy được lúc này."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/comp_ben_palette.js:0
msgid "Pay Run Hub"
msgstr "Trung tâm đợt lương"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/comp_ben_palette.js:0
msgid "Pay & benefits"
msgstr "Lương & phúc lợi"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/comp_ben_palette.js:0
msgid "Your own page"
msgstr "Trang của riêng bạn"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Where every award is"
msgstr "Các khoản thưởng đang ở đâu"

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "The awards could not be read just now."
msgstr "Chưa đọc được các khoản thưởng lúc này."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Pick who the award is for."
msgstr "Hãy chọn người được thưởng."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Award raised. Send it for approval when you are ready."
msgstr "Đã tạo khoản thưởng. Hãy gửi duyệt khi bạn sẵn sàng."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "The award could not be raised."
msgstr "Chưa tạo được khoản thưởng."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "That could not be done."
msgstr "Chưa thực hiện được."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Approved. The award letter has been prepared and emailed."
msgstr "Đã phê duyệt. Thư thưởng đã được chuẩn bị và gửi email."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Approved. The award letter is prepared and filed — emailing letters is switched off."
msgstr "Đã phê duyệt. Thư thưởng đã được chuẩn bị và lưu — chức năng gửi thư qua email đang tắt."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Marked as not approved."
msgstr "Đã đánh dấu là không phê duyệt."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "The letter has been prepared again."
msgstr "Thư đã được chuẩn bị lại."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Nothing could be read."
msgstr "Không đọc được gì."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Done."
msgstr "Xong."

#. module: pb_comp_ben
#. odoo-javascript
#: code:addons/pb_comp_ben/static/src/js/incentives_board.js:0
msgid "Nothing was put into the pay run."
msgstr "Chưa đưa được gì vào đợt lương."
