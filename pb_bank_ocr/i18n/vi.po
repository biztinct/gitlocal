#. module: pb_bank_ocr
#: code:addons/pb_bank_ocr/models/pb_bank_change_request.py:0
msgid ""
"This account collides with another employee. HR must tick 'Duplicate "
"Verified' before this request can be submitted."
msgstr ""
"Tài khoản này trùng với một nhân viên khác. Nhân sự phải tích 'Đã xác minh "
"trùng lặp' trước khi gửi yêu cầu này."

#. module: pb_bank_ocr
#: code:addons/pb_bank_ocr/models/pb_bank_change_request.py:0
msgid "An account number is required to submit."
msgstr "Cần có số tài khoản để gửi."

#. module: pb_bank_ocr
#: code:addons/pb_bank_ocr/models/pb_bank_change_request.py:0
msgid "Account number must be 6-19 digits."
msgstr "Số tài khoản phải có 6-19 chữ số."

#. module: pb_bank_ocr
#: code:addons/pb_bank_ocr/models/pb_bank_change_request.py:0
msgid "SWIFT/BIC format looks invalid."
msgstr "Định dạng SWIFT/BIC có vẻ không hợp lệ."

#. module: pb_bank_ocr
#: code:addons/pb_bank_ocr/models/pb_bank_change_request.py:0
msgid "Bank not recognised in the registry."
msgstr "Ngân hàng không có trong danh mục."

#. module: pb_bank_ocr
#: code:addons/pb_bank_ocr/models/pb_bank_change_request.py:0
msgid "All format checks passed."
msgstr "Tất cả kiểm tra định dạng đều đạt."

#. module: pb_bank_ocr
#: model:ir.model.fields,field_description:pb_bank_ocr.field_pb_bank_change_request__duplicate_ack
msgid "Duplicate Verified"
msgstr "Đã xác minh trùng lặp"

#. module: pb_bank_ocr
#: model:ir.model.fields,field_description:pb_bank_ocr.field_pb_bank_change_request__name_match_score
