#. module: pb_bank_ocr
#. odoo-python
#: code:addons/pb_bank_ocr/models/pb_bank_self_service.py:0
msgid "This account number is already on file for somebody else, so it cannot be sent from here. Ask HR to check it with you."
msgstr "Nomor rekening ini sudah tercatat untuk orang lain, jadi tidak dapat dikirim dari sini. Minta HR memeriksanya bersama Anda."

#. module: pb_bank_ocr
#. odoo-python
#: code:addons/pb_bank_ocr/models/pb_bank_self_service.py:0
