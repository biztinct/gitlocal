msgstr "Perubahan ini sudah dikirim. Tarik kembali dulu untuk mengubahnya."

#. module: pb_bank_ocr
#. odoo-python
#: code:addons/pb_bank_ocr/models/pb_bank_self_service.py:0
msgid "This login cannot approve bank details. One of the company's own people has to approve them."
msgstr "Akun ini tidak dapat menyetujui data bank. Harus disetujui oleh orang perusahaan sendiri."

#. module: pb_bank_ocr
#. odoo-python
#: code:addons/pb_bank_ocr/models/pb_bank_self_service.py:0
msgid "Type the account number before sending."
msgstr "Ketik nomor rekening sebelum mengirim."

#. module: pb_bank_ocr
#: model:ir.model.fields.selection,name:pb_bank_ocr.selection__pb_employee_bank_history__change_source__updates
msgid "Updates or Records"
msgstr "Pembaruan atau Catatan"

#. module: pb_bank_ocr
#. odoo-python
#: code:addons/pb_bank_ocr/models/pb_bank_self_service.py:0
msgid "Waiting for a second person. Nobody else in %s can approve bank details yet — add one in Access."
msgstr "Menunggu orang kedua. Belum ada orang lain di %s yang dapat menyetujui data bank — tambahkan di Akses."

#. module: pb_bank_ocr
#. odoo-python
#: code:addons/pb_bank_ocr/models/pb_bank_self_service.py:0
msgid "Waiting for a second person. Nobody else named to approve bank details in %s can approve this yet — add a person to the bank details route in Settings › Approval Matrix."
msgstr "Menunggu orang kedua. Belum ada orang lain yang ditunjuk menyetujui data bank di %s yang dapat menyetujui ini — tambahkan orang ke alur data bank di Pengaturan › Matriks Persetujuan."

#. module: pb_bank_ocr
#: model:ir.model.fields,help:pb_bank_ocr.field_pb_bank_change_request__pb_decision_note
msgid "What the approver wrote when they sent it back or turned it down. The employee sees it on My Payobook."
msgstr "Yang ditulis penyetuju saat mengembalikan atau menolaknya. Karyawan melihatnya di My Payobook."

#. module: pb_bank_ocr
#. odoo-python
#: code:addons/pb_bank_ocr/models/pb_bank_self_service.py:0
