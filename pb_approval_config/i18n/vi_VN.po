#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid " and "
msgstr " và "

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/inbox_facade.py:0
msgid " or "
msgstr " hoặc "

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid " when the amount is %s or more"
msgstr " khi số tiền từ %s trở lên"

#. module: pb_approval_config
#: model:biz.approval.process,name:pb_approval_config.process_runonly
msgid "\"This run only\" pay data"
msgstr "Dữ liệu lương \"chỉ cho đợt này\""

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%(a)s is covering for %(b)s"
msgstr "%(a)s đang trực thay cho %(b)s"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/inbox_facade.py:0
msgid "%(done)s of %(total)s approvals received"
msgstr "Đã nhận %(done)s trên %(total)s lượt phê duyệt"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/builder.js:0
msgid "%(from)s to %(to)s"
msgstr "Từ %(from)s đến %(to)s"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/inbox_facade.py:0
msgid "%(name)s · v%(rev)s"
msgstr "%(name)s · b%(rev)s"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/people_tab.js:0
msgid "%(role)s for %(scope)s"
msgstr "%(role)s cho %(scope)s"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "%(who)s (%(amount)s and above)"
msgstr "%(who)s (từ %(amount)s trở lên)"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%(who)s left \"%(role)s\" for %(where)s with nobody in it"
msgstr "%(who)s đã để trống \"%(role)s\" của %(where)s"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%(who)s made %(name)s the %(role)s for %(where)s"
msgstr "%(who)s đã giao %(name)s làm %(role)s của %(where)s"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%(who)s put %(where)s back on the route the rest of the company uses"
msgstr "%(who)s đã đưa %(where)s trở lại lộ trình mà cả công ty đang dùng"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%(who)s put %(where)s on \"%(name)s\""
msgstr "%(who)s đã đưa %(where)s sang \"%(name)s\""

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%(who)s started \"%(name)s\" as a draft"
msgstr "%(who)s đã tạo \"%(name)s\" ở dạng bản nháp"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/inbox_facade.py:0
msgid "%(who)s, covering for %(whose)s"
msgstr "%(who)s, trực thay cho %(whose)s"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/builder.js:0
msgid "%s and above"
msgstr "%s trở lên"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%s does not work in this company."
msgstr "%s không làm việc trong công ty này."

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%s exception"
msgstr "%s ngoại lệ"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%s exceptions"
msgstr "%s ngoại lệ"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "%s for this part of the business"
msgstr "%s của bộ phận này"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "%s is no"
msgstr "%s là không"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/matrix_room.js:0
msgid ""
"%s is not wired up to approvals yet. You can write its route now; publishing"
" waits until it is."
msgstr ""
"%s chưa được nối với phần phê duyệt. Bạn vẫn viết được lộ trình ngay bây "
"giờ; việc ban hành sẽ chờ đến khi nối xong."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "%s is yes"
msgstr "%s là có"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/builder.js:0
msgid "%s place(s) need somebody named before this can be used."
msgstr "Có %s nơi cần chỉ định người trước khi dùng được."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "%s · any one"
msgstr "%s · bất kỳ một người"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "%s · everyone"
msgstr "%s · tất cả mọi người"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "%s · whole company"
msgstr "%s · toàn công ty"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%s — everywhere"
msgstr "%s — mọi nơi"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "%s — the route everywhere here"
msgstr "%s — lộ trình dùng cho mọi nơi tại đây"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/scheme_panel.xml:0
msgid "(not published yet)"
msgstr "(chưa ban hành)"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid ", only when %s"
msgstr ", chỉ khi %s"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid ", which is the one in use now."
msgstr ", đây là bản đang được dùng."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid ""
". Every part of the business follows it unless one is given a route of its "
"own, which is done from the Matrix row rather than here."
msgstr ""
". Mọi bộ phận đều đi theo lộ trình này, trừ khi một bộ phận được giao lộ "
"trình riêng — việc đó làm ở dòng tương ứng trong Ma trận chứ không phải ở "
"đây."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/people.xml:0
msgid ""
". Requests from those places cannot be sent in until somebody is named."
msgstr ""
". Yêu cầu từ những nơi đó không gửi đi được cho đến khi có người được chỉ "
"định."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/inbox.xml:0
msgid ". Their requests show as your turn, marked \"covering for\"."
msgstr ". Yêu cầu của họ sẽ hiện là đến lượt bạn, có ghi \"trực thay cho\"."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/inbox.xml:0
msgid ". You can read everything; the decision is theirs."
msgstr ". Bạn xem được mọi thứ; quyền quyết định thuộc về họ."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/inbox.xml:0
msgid ""
". You still see everything; they can decide it, and both names are recorded."
msgstr ""
". Bạn vẫn xem được mọi thứ; họ quyết định thay, và cả hai tên đều được ghi "
"lại."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "1 · wins"
msgstr "1 · thắng"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/matrix_room.xml:0
msgid "2 people suggested"
msgstr "Nên có 2 người"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/matrix_room.xml:0
msgid ""
"; the row says so out loud and every use is still recorded. Suggestions such"
" as \"2 people\" are advice you confirm when you publish, never a lock."
msgstr ""
"; dòng đó sẽ ghi rõ như vậy và mọi lần dùng vẫn được lưu lại. Những gợi ý "
"kiểu \"2 người\" là lời khuyên bạn xác nhận khi ban hành, không bao giờ là "
"khoá chặn."

#. module: pb_approval_config
#: model:biz.approval.process,description:pb_approval_config.process_awards
msgid "A bonus or a prize given for good work."
msgstr "Tiền thưởng hoặc phần thưởng cho thành tích tốt."

#. module: pb_approval_config
#: model:biz.approval.process,description:pb_approval_config.process_scheme
msgid "A change to how pay is worked out."
msgstr "Thay đổi cách tính lương."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/builder.js:0
msgid "A document"
msgstr "Một tài liệu"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/matrix_room.js:0
msgid "A draft was created. Nothing is published until you say so."
msgstr "Đã tạo bản nháp. Chưa có gì được ban hành cho đến khi bạn đồng ý."

#. module: pb_approval_config
#: model:biz.approval.process,description:pb_approval_config.process_runonly
msgid "A figure entered for one pay run and nothing else."
msgstr ""
"Một con số chỉ nhập cho một đợt trả lương, không dùng cho đợt nào khác."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/picker_drawer.js:0
msgid "A fixed list, such as who may sign at the bank."
msgstr "Một danh sách cố định, ví dụ những người được ký ở ngân hàng."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/people.xml:0
msgid "A group — any one of them may decide"
msgstr "Một nhóm — bất kỳ ai trong nhóm cũng quyết định được"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid ""
"A late request is never approved by itself. Nothing in this app approves "
"anything on its own."
msgstr ""
"Yêu cầu trễ hạn không bao giờ tự được duyệt. Không có gì trong ứng dụng này "
"tự phê duyệt điều gì cả."

#. module: pb_approval_config
#: model:biz.approval.process,description:pb_approval_config.process_contract
msgid "A new contract, or a change to the terms of one."
msgstr "Hợp đồng mới, hoặc thay đổi điều khoản của hợp đồng."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/matrix_room.xml:0
msgid ""
"A preset stays a draft until you finish it. Choosing one publishes nothing."
msgstr ""
"Mẫu có sẵn vẫn là bản nháp cho đến khi bạn hoàn tất. Chọn một mẫu không ban "
"hành gì cả."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid ""
"A report this app generates is locked to the request. Replacing one after it"
" has been sent in starts the approvals again."
msgstr ""
"Báo cáo do ứng dụng này tạo ra sẽ được khoá vào yêu cầu. Thay báo cáo sau "
"khi đã gửi đi sẽ bắt đầu lại việc phê duyệt."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/people.xml:0
msgid ""
"A responsibility is a job, not a permission. Naming somebody here never "
"gives them access; the picker says when a person still needs it."
msgstr ""
"Trách nhiệm là một công việc, không phải một quyền truy cập. Chỉ định ai đó "
"ở đây không hề cấp quyền cho họ; ô chọn người sẽ báo khi một người vẫn còn "
"thiếu quyền."

#. module: pb_approval_config
#: model:biz.approval.process,description:pb_approval_config.process_paychange
msgid "A rise, a cut or a move to a different pay level."
msgstr "Tăng lương, giảm lương hoặc chuyển sang bậc lương khác."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/matrix_room.xml:0
msgid "A row is"
msgstr "Một dòng chỉ là"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/matrix_room.xml:0
msgid ""
"A setup workbook can fill this in for you: its approvals sheet becomes "
"drafts, one per process, for this company only. People stay suggestions "
"until a real account is chosen for each one. That door is being built; until"
" it opens, a preset below is the quickest start."
msgstr ""
"Tệp thiết lập có thể điền giúp bạn phần này: trang phê duyệt trong tệp sẽ "
"thành các bản nháp, mỗi quy trình một bản, và chỉ cho công ty này. Tên người"
" vẫn chỉ là đề xuất cho đến khi chọn được tài khoản thật cho từng người. Cửa"
" đó đang được làm; trong lúc chờ, một mẫu có sẵn bên dưới là cách bắt đầu "
"nhanh nhất."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/builder.js:0
msgid "A step that applies in some cases and not others."
msgstr "Một bước chỉ áp dụng trong vài trường hợp."

#. module: pb_approval_config
#: model:biz.approval.process,description:pb_approval_config.process_payrun
msgid "A whole pay run, before its payslips are confirmed."
msgstr "Cả một đợt trả lương, trước khi xác nhận phiếu lương."

#. module: pb_approval_config
#: model:biz.approval.role,name:pb_approval_config.role_access
msgid "Access team"
msgstr "Bộ phận cấp quyền"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Add a step"
msgstr "Thêm một bước"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Added"
msgstr "Đã thêm"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/matrix_room.xml:0
msgid "Advice, not a rule"
msgstr "Lời khuyên, không phải quy định"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "After it is sent in, %s."
msgstr "Sau khi gửi đi, %s."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/inbox.js:0
msgid "All I can see"
msgstr "Tất cả tôi xem được"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/matrix_room.xml:0
msgid "All areas"
msgstr "Mọi mảng"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Allow it, with a written reason each time"
msgstr "Cho phép, kèm lý do viết ra mỗi lần"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Allow named exceptions to that rule"
msgstr "Cho phép những ngoại lệ đã chỉ định với quy tắc này"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Already under way"
msgstr "Đang thực hiện dở"

#. module: pb_approval_config
#. odoo-javascript
#. odoo-python
#: code:addons/pb_approval_config/models/inbox_facade.py:0
#: code:addons/pb_approval_config/models/matrix_facade.py:0
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Amount"
msgstr "Số tiền"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Amount taken from"
msgstr "Số tiền lấy từ"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/inbox.xml:0
msgid "Amount, if any"
msgstr "Số tiền, nếu có"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid ""
"Amounts are compared in the money the request is in. Requests in different "
"currencies are never added together."
msgstr ""
"Số tiền được so sánh theo đúng loại tiền của yêu cầu. Yêu cầu ở các loại "
"tiền khác nhau không bao giờ bị cộng chung."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/inbox.xml:0
msgid "Amounts are never added across currencies."
msgstr "Số tiền không bao giờ được cộng chung giữa các loại tiền."

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/inbox_facade.py:0
msgid "An exception was used"
msgstr "Đã dùng một ngoại lệ"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "And if it is late?"
msgstr "Còn nếu trễ hạn thì sao?"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/people.xml:0
msgid "Annual leave"
msgstr "Nghỉ phép năm"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Answer in your own words. Everything can change later."
msgstr "Trả lời bằng lời của bạn. Mọi thứ đều sửa lại được sau."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/builder.js:0
msgid "Any amount"
msgstr "Mọi số tiền"

#. module: pb_approval_config
#. odoo-python
#: code:addons/pb_approval_config/models/matrix_facade.py:0
msgid "Any kind"
msgstr "Mọi loại"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/people.xml:0
msgid "Any one of"
msgstr "Bất kỳ ai trong"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/sentence.js:0
msgid "Any one of %s"
msgstr "Bất kỳ ai trong %s"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/builder.js:0
msgid "Any one of a team"
msgstr "Bất kỳ ai trong một nhóm"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "Any one of them"
