msgid "Turned down. Whoever sent it in is told, with your reason."
msgstr "Đã từ chối. Người gửi được báo tin, kèm lý do của bạn."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/js/builder.js:0
msgid "Under %s"
msgstr "Dưới %s"

#. module: pb_approval_config
