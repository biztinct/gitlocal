msgstr "Bạn đang xin điều gì?"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/people.xml:0
msgid "What changed, and who did it"
msgstr "Điều gì đã thay đổi, và ai đã làm"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
msgid "What changes"
msgstr "Những gì thay đổi"

#. module: pb_approval_config
#: model:biz.approval.process,description:pb_approval_config.process_bands
msgid "What each job is meant to pay, and the limits on a rise."
msgstr "Mức lương dự kiến cho từng vị trí, và giới hạn khi tăng lương."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/inbox.xml:0
msgid "What has been decided"
msgstr "Những gì đã được quyết định"

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/inbox.xml:0
msgid "What has to be attached"
msgstr "Những gì phải đính kèm"

#. module: pb_approval_config
#: model:biz.approval.process,description:pb_approval_config.process_filing
msgid "What is declared to the authorities each period."
msgstr "Những gì được khai báo với cơ quan nhà nước mỗi kỳ."

#. module: pb_approval_config
#. odoo-javascript
#: code:addons/pb_approval_config/static/src/xml/builder.xml:0
