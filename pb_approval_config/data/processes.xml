<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ==================================================================
         THE CATALOGUE: every process that can need a sign-off.

         A row names the business object it approves where one exists. It is
         NOT a claim that the object is wired up: "Wired up" is worked out by
         the engine from the object itself, so a row can never pretend to be
         protecting something it is not. Until the owning module signs the
         adapter contract the row reads "Not connected yet" and can be
         drafted but never published.

         `money` marks the processes where money leaves the company. It never
         blocks anything: publishing a one-person route for one of them raises
         a warning the publisher confirms, and the confirmation is recorded.
         ================================================================== -->

    <!-- ============================================================ Pay -->
    <record id="process_payrun" model="biz.approval.process">
        <field name="key">payrun</field>
        <field name="name">Pay run</field>
        <field name="area">pay</field>
        <field name="model_name">hr.payslip.run</field>
        <field name="description">A whole pay run, before its payslips are confirmed.</field>
        <field name="sequence">10</field>
    </record>

    <record id="process_reopen" model="biz.approval.process">
        <field name="key">reopen</field>
        <field name="name">Reopen an approved run</field>
        <field name="area">pay</field>
        <field name="description">Taking an already approved pay run back to draft.</field>
