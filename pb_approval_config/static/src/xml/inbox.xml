<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ====================================================================
       The one Approvals inbox, and the drawer one request opens into.

       Comments are ruled with `=`, never a doubled hyphen. `t-if` / `t-elif`
       / `t-else` are ADJACENT siblings, and every negation is `!`.

       No loop variable is named lt / gt / lte / gte / and / or / not / in:
       the card loop is `cd`, the tab loop is `tb`, the step loop is `st`,
       the seat loop is `se`, the fact loop is `ft`, the evidence loop is
       `ev`, the area loop is `ar`, the badge loop is `bg`, the money loop is
       `mn`, the decision loop is `dc`.
       ==================================================================== -->

  <t t-name="pb_approval_config.PbInbox">
    <div class="pbim pbam-inbox" t-att-class="{ 'pbim-page': !props.embedded }">
      <div class="pbim-wrap">

        <!-- ============================================ the hero -->
        <div t-if="!props.embedded" class="pbim-hero">
          <div class="pbim-hero-id">
            <div class="pbim-eyebrow"><t t-out="ic('inbox',13)"/> <span>Approvals</span></div>
            <h1 class="pbim-h1">Waiting for a decision</h1>
            <p class="pbim-sub">Everything from every part of the product, in one place — whoever you are.</p>
          </div>
          <div class="pbam-hero-actions">
            <button class="pbim-btn ghost" t-on-click="() => this.openAsk()">
              <t t-out="ic('plus',15)"/> <span>Ask for a sign-off</span>
            </button>
            <button t-if="data.can_config" class="pbim-btn ghost"
                    t-on-click="() => this.openMatrix()">
              <t t-out="ic('workflow',15)"/> <span>Workflows</span>
            </button>
          </div>
        </div>

        <div t-else="" class="pbam-embedded-actions">
          <button class="pbim-btn ghost pbim-btn-sm" t-on-click="() => this.openAsk()">
            <t t-out="ic('plus',14)"/> <span>Ask for a sign-off</span>
          </button>
          <button t-if="data.can_config" class="pbim-btn ghost pbim-btn-sm"
                  t-on-click="() => this.openMatrix()">
            <t t-out="ic('workflow',14)"/> <span>Workflows</span>
          </button>
          <span class="pbam-sp"/>
          <button class="pbim-btn ghost pbim-btn-sm" t-on-click="() => this.refresh()">
            <t t-out="ic('refresh',14)"/> <span>Refresh</span>
          </button>
        </div>

        <div t-if="state.failed" class="pbim-empty pbam-empty">
          <div class="pbam-empty-ic"><t t-out="ic('alert',30)"/></div>
          <h3>Your approvals could not be read</h3>
          <p t-esc="state.failed"/>
          <button class="pbim-btn primary" t-on-click="() => this.load()">Try again</button>
        </div>

        <t t-else="">

          <div t-if="data.covered_by and data.covered_by.length" class="pbam-attn pbam-attn-info">
            <t t-out="ic('plane',18)"/>
            <span>
              <t t-esc="data.covered_by[0].name"/> is holding your seats until <t t-esc="data.covered_by[0].until"/>. You still see everything; they can decide it, and both names are recorded.
            </span>
          </div>

          <div t-if="data.covering_for and data.covering_for.length" class="pbam-attn pbam-attn-info">
            <t t-out="ic('plane',18)"/>
            <span>
              You are covering for <t t-esc="data.covering_for[0].name"/> until <t t-esc="data.covering_for[0].until"/>. Their requests show as your turn, marked "covering for".
            </span>
          </div>

          <div class="pbam-tabs">
            <button t-foreach="tabs" t-as="tb" t-key="tb.key"
                    class="pbam-tab" t-att-class="{ 'is-on': state.tab === tb.key }"
                    t-on-click="() => this.setTab(tb.key)">
              <span t-esc="tb.label"/>
              <span class="pbam-count" t-esc="tb.count"/>
            </button>
          </div>

          <div t-if="state.tab === 'mine' and moneyLine" class="pbam-moneyline">
            <t t-out="ic('banknote',13)"/>
            <span>
              <t t-esc="cards.length"/> waiting for you · <t t-esc="moneyLine"/>
            </span>
            <span class="pbim-sub">Amounts are never added across currencies.</span>
          </div>

          <div class="pbam-filters">
            <div class="pbim-chips">
              <button class="pbim-fchip" t-att-class="{ 'is-on': !state.area }"
                      t-on-click="() => this.setArea('')">Everything</button>
              <button t-foreach="data.areas" t-as="ar" t-key="ar.key"
                      class="pbim-fchip" t-att-class="{ 'is-on': state.area === ar.key }"
                      t-on-click="() => this.setArea(ar.key)">
                <t t-out="ic(ar.icon,12)"/> <span t-esc="ar.label"/>
              </button>
            </div>
            <div class="pbim-chips">
              <button class="pbim-fchip" t-att-class="{ 'is-on': state.due === 'today' }"
                      t-on-click="() => this.setDue('today')">Due today</button>
              <button class="pbim-fchip" t-att-class="{ 'is-on': state.due === 'late' }"
                      t-on-click="() => this.setDue('late')">Late</button>
            </div>
          </div>

          <div t-if="state.loading" class="pbim-busy">
            <div class="pbim-spin"/><span>Reading your approvals…</span>
          </div>

          <div t-elif="!cards.length" class="pbim-empty pbam-empty">
            <div class="pbam-empty-ic"><t t-out="ic('checkCircle',28)"/></div>
            <h3 t-esc="emptyCopy.title"/>
            <p t-esc="emptyCopy.sub"/>
          </div>

          <div t-else="" class="pbam-reqs">
            <div t-foreach="cards" t-as="cd" t-key="cd.id"
                 class="pbam-req"
                 t-att-class="{ 'is-mine': cd.mine, 'is-dim': cd.state === 'applied' or cd.state === 'approved' }"
                 t-on-click="() => this.open(cd)">
              <span class="pbam-icsq"
                    t-att-class="{ 'pbam-icsq-rose': cd.blocked, 'pbam-icsq-amber': cd.state === 'returned' }">
                <t t-out="ic(cd.icon,17)"/>
              </span>
              <div class="pbam-reqmain">
                <div class="pbam-reqt">
                  <span t-esc="cd.title"/>
                  <span t-if="cd.mine" class="pbim-badge pbam-info">Your turn</span>
                  <span t-elif="cd.blocked" class="pbim-badge pbam-err">Stuck</span>
                  <span t-elif="cd.state === 'returned'" class="pbim-badge pbam-warn">Sent back</span>
                  <span t-elif="cd.state === 'applied'" class="pbim-badge pbam-ok">Done</span>
                  <span t-elif="cd.state === 'approved'" class="pbim-badge pbam-ok">Approved</span>
                  <span t-elif="cd.state === 'rejected'" class="pbim-badge pbam-err">Turned down</span>
                  <span t-elif="cd.state === 'cancelled'" class="pbim-badge pbam-muted">Withdrawn</span>
                  <span t-foreach="cd.badges" t-as="bg" t-key="bg_index"
                        class="pbim-badge pbam-warn" t-esc="bg"/>
                </div>
                <div class="pbam-reqs2">
                  <span t-esc="cd.process"/> · <span t-esc="cd.sub"/> ·
                  sent in by <span t-esc="cd.submitted_by"/>, <span t-esc="when(cd.submitted_at)"/>
                </div>
                <div class="pbam-facts">
                  <span class="pbam-f">
                    <t t-out="ic('workflow',12)"/> <span t-esc="cd.workflow"/>
                  </span>
                  <span t-if="cd.blocked" class="pbam-f pbam-f-bad">
                    <t t-out="ic('userX',12)"/> <span t-esc="cd.block_reason"/>
                  </span>
                  <span t-elif="cd.state === 'returned'" class="pbam-f">
                    <t t-out="ic('undo',12)"/> <span t-esc="cd.return_note"/>
                  </span>
                  <span t-elif="cd.waiting_for" class="pbam-f">
                    <t t-out="ic('user',12)"/>
                    <span>Waiting for <b t-esc="cd.waiting_for"/></span>
                  </span>
                </div>
                <div class="pbam-rt">
                  <t t-foreach="cd.route" t-as="st" t-key="st_index">
                    <span t-if="st_index" class="pbam-rline"/>
                    <span class="pbam-rdot" t-att-class="'pbam-rdot-' + st.status">
                      <i/><span t-esc="st.title"/>
                    </span>
                  </t>
                </div>
              </div>
              <div class="pbam-reqright">
                <div t-if="cd.amount" class="pbam-amt" t-esc="money(cd.amount, cd.currency)"/>
                <!-- How big it is, in the units the thing is counted in, and
                     what kind of thing it is. Both come off the frozen facts,
                     so a card never says something the decision was not made
                     on. -->
                <div t-if="cd.count" class="pbam-cnt" t-esc="cd.count"/>
                <div t-if="cd.kind" class="pbam-kind" t-esc="cd.kind"/>
                <div t-if="cd.due_at" class="pbam-due" t-att-class="{ 'is-late': cd.late }">
                  <t t-out="ic('clock',11)"/> <span>Due <t t-esc="when(cd.due_at)"/></span>
                </div>
              </div>
            </div>
          </div>
        </t>
      </div>

      <!-- ======================================= the request drawer -->
      <t t-if="state.openId">
        <div class="pbam-scrim" t-on-click="() => this.close()"/>
        <RequestDrawer requestId="state.openId"
                       onClose="() => this.close()"
                       onChanged="() => this.refresh()"
                       onOpenMatrix="() => this.openMatrix()"/>
      </t>

      <!-- ======================================= ask for a sign-off -->
      <t t-if="state.asking">
        <div class="pbam-scrim" t-on-click="() => this.closeAsk()"/>
        <aside class="pbam-drawer">
          <div class="pbam-dh">
            <div>
              <h2>Ask for a sign-off</h2>
              <p class="pbim-sub">For anything that has no process of its own. It follows the route your company published for exactly this, and it is recorded the same way as everything else.</p>
            </div>
            <button class="pbam-x" aria-label="Close" t-on-click="() => this.closeAsk()">
              <t t-out="ic('x',18)"/>
            </button>
          </div>
          <div class="pbam-db">
            <div class="pbam-field">
              <label>What are you asking for?</label>
              <input class="pbam-input" placeholder="Say it in one line"
                     t-on-input="(ev) => this.setAsk('name', ev)"/>
            </div>
            <div class="pbam-field">
              <label>Why</label>
              <textarea class="pbam-input pbam-textarea"
                        placeholder="Anything the person deciding will need to know."
                        t-on-input="(ev) => this.setAsk('description', ev)"/>
            </div>
            <div class="pbam-form2">
              <div class="pbam-field">
                <label>
                  Amount, if any
                  <t t-if="state.askOptions and state.askOptions.currency_name">
                    (<t t-esc="state.askOptions.currency_name"/>)
                  </t>
                </label>
                <input class="pbam-input" type="number" min="0"
                       t-on-change="(ev) => this.setAsk('amount', ev)"/>
              </div>
              <div t-if="state.askOptions and state.askOptions.areas.length" class="pbam-field">
                <label>Part of the business</label>
                <select class="pbam-input" t-on-change="(ev) => this.setAsk('area_key', ev)">
                  <option value="">The whole company</option>
                  <option t-foreach="state.askOptions.areas" t-as="ar" t-key="ar.key"
                          t-att-value="ar.key" t-esc="ar.label"/>
                </select>
              </div>
            </div>
            <div class="pbim-note pbam-note">
              <t t-out="ic('info',13)"/>
              <span>It goes straight to whoever your company named for this. If nobody has been named yet, you will be told exactly that rather than left waiting.</span>
            </div>
          </div>
          <div class="pbam-df">
            <button class="pbim-btn ghost" t-on-click="() => this.closeAsk()">Cancel</button>
            <button class="pbim-btn primary" t-att-disabled="!canAsk or state.busy"
                    t-on-click="() => this.sendAsk()">Send it</button>
          </div>
        </aside>
      </t>

    </div>
  </t>

  <!-- ==================================================================== -->

  <t t-name="pb_approval_config.RequestDrawer">
    <aside class="pbam-drawer pbam-drawer-wide">

      <div t-if="state.loading" class="pbim-busy">
        <div class="pbim-spin"/><span>Opening it…</span>
      </div>

      <div t-elif="state.failed" class="pbam-db">
        <div class="pbim-note pbam-note-rose">
          <t t-out="ic('alert',14)"/> <span t-esc="state.failed"/>
        </div>
        <button class="pbim-btn ghost" t-on-click="() => this.props.onClose()">Close</button>
      </div>

      <t t-else="">
        <div class="pbam-dh">
          <span class="pbam-icsq"><t t-out="ic(request.icon,17)"/></span>
          <div>
            <h2 t-esc="request.title"/>
            <p class="pbim-sub">
              <t t-esc="request.process"/> · <t t-esc="request.workflow"/>
            </p>
          </div>
          <button class="pbam-x" aria-label="Close" t-on-click="() => this.props.onClose()">
            <t t-out="ic('x',18)"/>
          </button>
        </div>

        <div class="pbam-db">

          <div t-if="mustUseException" class="pbim-note pbam-note-amber">
            <t t-out="ic('flag',14)"/>
            <span>
              <b t-esc="conflict.text"/> <t t-esc="conflict.note"/>
            </span>
          </div>

          <div t-elif="isStuckOnMe" class="pbim-note pbam-note-amber">
            <t t-out="ic('alert',14)"/>
            <span>
              <b t-esc="conflict.text"/> <t t-esc="conflict.note"/>
            </span>
          </div>

          <div t-if="request.blocked" class="pbim-note pbam-note-rose">
            <t t-out="ic('userX',14)"/>
            <span>
              <b>This cannot move.</b> <t t-esc="request.block_reason"/>
              Mend it and the route carries on; nothing has to be sent in again.
            </span>
          </div>

          <div t-if="request.state === 'returned'" class="pbim-note pbam-note-amber">
            <t t-out="ic('undo',14)"/>
            <span><b>Sent back:</b> <t t-esc="request.return_note"/></span>
          </div>

          <div t-if="request.facts.length">
            <div class="pbam-k">The facts, as they were when it was sent in</div>
            <div class="pbam-factgrid">
              <div t-foreach="request.facts" t-as="ft" t-key="ft.key" class="pbam-fact">
                <div class="pbam-fact-k" t-esc="ft.label"/>
                <div class="pbam-fact-v">
                  <span t-esc="ft.value"/>
                  <span t-if="ft.unit" class="pbam-fact-u" t-esc="ft.unit"/>
                </div>
              </div>
            </div>
          </div>

          <!-- An adapter may offer ONE small table under the facts. The shape
               is generic (heading, columns, rows, chips), so this markup never
               learns what a week or a run is. -->
          <div t-if="request.detail">
            <div class="pbam-k" t-esc="request.detail.title"/>
            <div t-if="request.detail.rows.length" class="pbam-detail-wrap">
              <table class="pbam-detail">
                <thead>
                  <tr>
                    <th/>
                    <th t-foreach="request.detail.columns" t-as="col" t-key="col_index" t-esc="col"/>
                  </tr>
                </thead>
                <tbody>
                  <tr t-foreach="request.detail.rows" t-as="dr" t-key="dr_index"
                      t-att-class="dr.tone === 'off' ? 'pbam-dr-off' : ''">
                    <th>
                      <span class="pbam-dr-h" t-esc="dr.head"/>
                      <span class="pbam-dr-s" t-esc="dr.sub"/>
                    </th>
                    <td t-foreach="dr.cells" t-as="cell" t-key="cell_index" t-esc="cell"/>
                  </tr>
                </tbody>
              </table>
            </div>
            <div t-if="request.detail.chips.length" class="pbam-detail-chips">
              <span t-foreach="request.detail.chips" t-as="ch" t-key="ch_index"
                    class="pbim-badge pbam-muted">
                <t t-esc="ch.label"/>: <b t-esc="ch.value"/>
              </span>
            </div>
            <div t-if="request.detail.note" class="pbam-ms" t-esc="request.detail.note"/>
          </div>

          <div t-if="request.evidence.length">
            <div class="pbam-k">What has to be attached</div>
            <div class="pbam-evid">
              <div t-foreach="request.evidence" t-as="ev" t-key="ev_index" class="pbam-evrow2">
                <t t-if="ev.required" t-out="ic('paperclip',14)"/>
                <t t-else="" t-out="ic('minus',14)"/>
                <div>
                  <div class="pbam-mt" t-esc="ev.name"/>
                  <div class="pbam-ms" t-esc="ev.when"/>
                </div>
                <span t-if="!ev.required" class="pbim-badge pbam-muted">Not needed here</span>
                <span t-elif="ev.ok" class="pbim-badge pbam-ok">Attached</span>
                <span t-else="" class="pbim-badge pbam-warn">Still missing</span>
              </div>
            </div>
          </div>

          <div>
            <div class="pbam-k">The route</div>
            <div class="pbam-tl">
              <div t-foreach="request.steps" t-as="st" t-key="st.key"
                   class="pbam-tlrow" t-att-class="'pbam-tl-' + st.status_label">
                <div class="pbam-tldot">
                  <t t-if="st.status === 'done'" t-out="ic('check',13)"/>
                  <t t-elif="st.status === 'active'" t-out="ic('circleDot',13)"/>
                  <t t-elif="st.status === 'blocked' or st.status === 'returned'" t-out="ic('x',13)"/>
                  <t t-elif="st.status === 'skipped'" t-out="ic('minus',13)"/>
                  <t t-else="" t-esc="st_index + 1"/>
                </div>
                <div>
                  <div class="pbam-mt">
                    <span t-esc="st.title"/>
                    <span t-if="st.joint" class="pbim-badge pbam-info">Everyone must approve</span>
                  </div>
                  <div t-if="st.reason" class="pbam-ms" t-esc="st.reason"/>
                  <div t-if="st.block_reason" class="pbam-ms pbam-ms-bad" t-esc="st.block_reason"/>
                  <div class="pbam-by">
                    <span t-foreach="st.seats" t-as="se" t-key="se.key" class="pbam-person">
                      <span class="pbam-av pbam-av-sm" t-esc="initials(se.name)"/>
                      <span>
                        <span class="pbam-pname" t-esc="se.name"/>
                        <span t-if="se.covering_for" class="pbim-badge pbam-warn">
                          <t t-out="ic('plane',10)"/>
                          <span>covering for <t t-esc="se.covering_for"/></span>
                        </span>
                        <span t-if="se.status === 'approved'" class="pbim-badge pbam-ok">approved</span>
                      </span>
                    </span>
                  </div>
                  <div t-if="st.due_at" class="pbam-ms">
                    <t t-out="ic('clock',11)"/> <span>Due <t t-esc="when(st.due_at)"/></span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div t-if="request.decisions.length">
            <div class="pbam-k">What has been decided</div>
            <div class="pbam-decisions">
              <div t-foreach="request.decisions" t-as="dc" t-key="dc_index" class="pbam-drow">
                <span class="pbam-av pbam-av-sm" t-esc="initials(dc.who)"/>
                <div>
                  <div class="pbam-mt">
                    <t t-esc="dc.who"/> <t t-esc="dc.action_label"/>
                    <span t-if="dc.exception" class="pbim-badge pbam-warn">
                      <t t-out="ic('flag',10)"/> <span>an exception was used</span>
                    </span>
                  </div>
                  <div t-if="dc.reason" class="pbam-ms" t-esc="dc.reason"/>
                  <div class="pbam-ms" t-esc="when(dc.when)"/>
                </div>
              </div>
            </div>
          </div>

          <p class="pbim-sub" t-esc="request.submitted_note"/>
        </div>

        <div class="pbam-df">
          <t t-if="request.can_repair">
            <button class="pbim-btn primary" t-att-disabled="state.busy"
                    t-on-click="() => this.repair()">
              <t t-out="ic('refresh',14)"/> <span>Try again now it is set up</span>
            </button>
            <button t-if="props.onOpenMatrix" class="pbim-btn ghost"
                    t-on-click="() => this.openMatrix()">Open the Matrix</button>
          </t>
          <t t-elif="canApprove">
            <button class="pbim-btn danger" t-on-click="() => this.openModal('reject')">
              Turn it down
            </button>
            <button class="pbim-btn ghost" t-on-click="() => this.openModal('sendback')">
              <t t-out="ic('undo',14)"/> <span>Send it back</span>
            </button>
            <button t-if="mustUseException" class="pbim-btn primary"
                    t-on-click="() => this.openModal('exception')">
              <t t-out="ic('flag',14)"/> <span>Approve with an exception</span>
            </button>
            <button t-elif="isStuckOnMe" class="pbim-btn primary" disabled="1"
                    t-att-title="conflict.note">
              <t t-out="ic('ban',14)"/> <span>You cannot approve this one</span>
            </button>
            <button t-else="" class="pbim-btn primary" t-att-disabled="state.busy"
                    t-on-click="() => this.approve()">
              <t t-out="ic('check',14)"/> <span>Approve</span>
            </button>
          </t>
          <t t-else="">
            <span class="pbim-sub pbam-waitnote">
              <t t-if="request.waiting_for">
                Waiting for <t t-esc="request.waiting_for"/>. You can read everything; the decision is theirs.
              </t>
              <t t-else="">This one is finished.</t>
            </span>
            <button t-if="request.can_cancel" class="pbim-btn ghost"
                    t-att-disabled="state.busy" t-on-click="() => this.cancel()">Withdraw it</button>
            <button class="pbim-btn ghost" t-on-click="() => this.props.onClose()">Close</button>
          </t>
        </div>
      </t>

      <!-- =========================================== the reason gate -->
      <t t-if="state.modal">
        <div class="pbam-modal">
          <div class="pbam-modalbox">
            <h2 t-esc="modalCopy.title"/>
            <div class="pbim-note" t-att-class="'pbam-note-' + modalCopy.tone">
              <span t-if="modalCopy.note"><b t-esc="modalCopy.note"/> </span>
              <span t-esc="modalCopy.body"/>
            </div>
            <div class="pbam-field">
              <label t-esc="modalCopy.label"/>
              <textarea class="pbam-input pbam-textarea" t-att-placeholder="modalCopy.hint"
                        t-on-input="setReason"/>
              <span t-if="!reasonOk" class="pbim-sub">
                At least <t t-esc="minLength"/> characters, so it means something to whoever reads it.
              </span>
            </div>
            <div class="pbam-mf">
              <button class="pbim-btn ghost" t-on-click="() => this.closeModal()">Cancel</button>
              <button t-if="state.modal === 'exception'" class="pbim-btn primary"
                      t-att-disabled="!reasonOk or state.busy"
                      t-on-click="() => this.approveWithException()" t-esc="modalCopy.confirm"/>
              <button t-elif="state.modal === 'sendback'" class="pbim-btn primary"
                      t-att-disabled="!reasonOk or state.busy"
                      t-on-click="() => this.sendBack()" t-esc="modalCopy.confirm"/>
              <button t-else="" class="pbim-btn danger"
                      t-att-disabled="!reasonOk or state.busy"
                      t-on-click="() => this.reject()" t-esc="modalCopy.confirm"/>
            </div>
          </div>
        </div>
      </t>

    </aside>
  </t>

</templates>
