<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ==================================================================
         COMPANY SCOPE, the same domain every Payobook model uses: a record
         with no company is shared, everything else is scoped to the
         companies the reader is actually working in.

         NO NEW GROUP LADDER. Onboarding is not a separate permission from
         the rest of the employee lifecycle — the board lives inside the
         Lifecycle hub and answers the same question about the same cases —
         so these models ride P0's user / manager / administrator tiers. A
         fourth ladder would be a group nobody would know to grant, and the
         first symptom would be an empty board on a database full of joiners.
         ================================================================== -->

    <record id="rule_hrbp_rule_company" model="ir.rule">
        <field name="name">HR partner rule: company</field>
        <field name="model_id" ref="model_pb_hrbp_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_orientation_batch_company" model="ir.rule">
        <field name="name">Welcome session: company</field>
        <field name="model_id" ref="model_pb_orientation_batch"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_newhire_pulse_company" model="ir.rule">
        <field name="name">New joiner check: company</field>
        <field name="model_id" ref="model_pb_newhire_pulse"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_buddy_nomination_company" model="ir.rule">
        <field name="name">Buddy nomination: company</field>
        <field name="model_id" ref="model_pb_buddy_nomination"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ==================================================================
         WHAT A PLAIN USER SEES OF THE ANSWERS.

         A new joiner's check is a private thing — "I am struggling" is not
         a sentence that belongs on a colleague's screen. The user tier sees
         its OWN checks and the ones for people it is the HR partner or the
         buddy of; the manager tier, which is the HR team, sees the board.

         Both are group rules and Odoo ORs those together, so somebody who
         holds both tiers is not narrowed by the tighter one.
         ================================================================== -->

    <record id="rule_newhire_pulse_own" model="ir.rule">
        <field name="name">New joiner check: mine and my people's</field>
        <field name="model_id" ref="model_pb_newhire_pulse"/>
        <field name="groups" eval="[(4, ref('pb_lifecycle.group_lifecycle_user'))]"/>
        <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('employee_id.hrbp_user_id', '=', user.id), ('employee_id.buddy_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_newhire_pulse_all" model="ir.rule">
        <field name="name">New joiner check: the HR team</field>
        <field name="model_id" ref="model_pb_newhire_pulse"/>
        <field name="groups" eval="[(4, ref('pb_lifecycle.group_lifecycle_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</data>
</odoo>
