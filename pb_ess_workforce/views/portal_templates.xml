<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================= -->
  <!--  Icons (Lucide paths, inline: the portal bundle carries no JS) -->
  <!--  W2: Lucide only, never Font Awesome, never emoji.             -->
  <!-- ============================================================= -->
  <!-- Call sites pass the name with t-value="'name'", NEVER as a t-set BODY.
       A body is rendered QWeb, and on a `website=True` page the editor's
       inherit_branding wraps rendered text in `data-oe-*` markup — so
       `<t t-set="icon">calendar</t>` arrives here as Markup carrying branding
       attributes, every `icon == '...'` comparison is False, and every icon in
       the module silently falls through to the else-branch. Found live: four
       nav pills rendering as identical empty circles, with no error anywhere.
       A t-value is a plain string and cannot be branded. -->
  <template id="work_icon" name="My Work icon">
    <t t-set="isz" t-value="isz or 18"/>
    <svg t-att-width="isz" t-att-height="isz" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round"
         stroke-linejoin="round" class="pbew-ic">
      <t t-if="icon == 'calendar'"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></t>
      <t t-elif="icon == 'clock'"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></t>
      <t t-elif="icon == 'sun'"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></t>
      <t t-elif="icon == 'zap'"><path d="M4 14h7l-1 8 10-12h-7l1-8z"/></t>
      <t t-elif="icon == 'check'"><path d="M20 6 9 17l-5-5"/></t>
      <t t-elif="icon == 'check-circle'"><path d="M21.8 10A10 10 0 1 1 17 3.34"/><path d="m9 11 3 3L22 4"/></t>
      <t t-elif="icon == 'alert'"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></t>
      <t t-elif="icon == 'wrench'"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></t>
      <t t-elif="icon == 'arrow-left'"><path d="m12 19-7-7 7-7M19 12H5"/></t>
      <t t-elif="icon == 'arrow-right'"><path d="M5 12h14M12 5l7 7-7 7"/></t>
      <t t-elif="icon == 'timer'"><path d="M10 2h4"/><path d="m12 14 3-3"/><circle cx="12" cy="14" r="8"/></t>
      <t t-elif="icon == 'log-in'"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="m10 17 5-5-5-5"/><path d="M15 12H3"/></t>
      <t t-elif="icon == 'log-out'"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></t>
      <t t-elif="icon == 'map-pin'"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></t>
      <t t-elif="icon == 'history'"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></t>
      <t t-elif="icon == 'paperclip'"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></t>
      <t t-elif="icon == 'undo'"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></t>
      <t t-elif="icon == 'x'"><path d="M18 6 6 18M6 6l12 12"/></t>
      <t t-elif="icon == 'file-up'"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 12v6M15 15l-3-3-3 3"/></t>
      <t t-elif="icon == 'camera'"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></t>
      <t t-else=""><circle cx="12" cy="12" r="10"/></t>
    </svg>
  </template>

  <!-- ============================================================= -->
  <!--  Breadcrumbs                                                   -->
  <!-- ============================================================= -->
  <template id="portal_work_breadcrumbs" name="My Work breadcrumbs"
            inherit_id="portal.portal_breadcrumbs" priority="36">
    <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
      <li t-if="page_name == 'work_schedule'" class="breadcrumb-item active">My Schedule</li>
      <li t-if="page_name == 'work_timesheet'" class="breadcrumb-item active">My Timesheet</li>
      <li t-if="page_name == 'work_leave'" class="breadcrumb-item active">My Leave</li>
      <li t-if="page_name == 'work_overtime'" class="breadcrumb-item active">My Overtime</li>
      <li t-if="page_name == 'work_clock'" class="breadcrumb-item active">Clock in / out</li>
    </xpath>
  </template>

  <!-- ============================================================= -->
  <!--  /my home: the "My Work" cards                                 -->
  <!-- ============================================================= -->
  <template id="portal_my_home_work" name="My Work home cards"
            inherit_id="portal.portal_my_home" customize_show="True" priority="22">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
      <!-- TIERS T3b: the Clock tile, only for an employee whose company
           has the switch on (the home's week card already read the clock) -->
      <t t-if="pbme_home and ((pbme_home.get('week') or {}).get('clock') or {}).get('enabled')" t-call="portal.portal_docs_entry">
        <t t-set="title">Clock in / out</t>
        <t t-set="text">Start and end your day</t>
        <t t-set="url" t-value="'/my/work/clock'"/>
        <t t-set="config_card" t-value="True"/>
      </t>
      <t t-call="portal.portal_docs_entry">
        <t t-set="title">My Schedule</t>
        <t t-set="text">Your shifts for this week and next — confirm the ones you have seen</t>
        <t t-set="url" t-value="'/my/work/schedule'"/>
        <t t-set="config_card" t-value="True"/>
        <t t-set="placeholder_count" t-value="'work_shift_count'"/>
      </t>
      <t t-call="portal.portal_docs_entry">
        <t t-set="title">My Timesheet</t>
        <t t-set="text">Hours scheduled against hours worked, day by day</t>
        <t t-set="url" t-value="'/my/work/timesheet'"/>
        <t t-set="config_card" t-value="True"/>
      </t>
      <t t-call="portal.portal_docs_entry">
        <t t-set="title">My Leave</t>
        <t t-set="text">Your balances, and a form to request time off</t>
        <t t-set="url" t-value="'/my/work/leave'"/>
        <t t-set="config_card" t-value="True"/>
        <t t-set="placeholder_count" t-value="'work_leave_count'"/>
      </t>
      <t t-call="portal.portal_docs_entry">
        <t t-set="title">My Overtime</t>
        <t t-set="text">What was recorded, what was approved, and at which rate</t>
        <t t-set="url" t-value="'/my/work/overtime'"/>
        <t t-set="config_card" t-value="True"/>
        <t t-set="placeholder_count" t-value="'work_overtime_count'"/>
      </t>
    </xpath>
  </template>

  <!-- ============================================================= -->
  <!--  Shared: sub-navigation across the four pages                  -->
  <!-- ============================================================= -->
  <template id="work_nav" name="My Work nav">
    <div class="pbew-nav">
      <a t-if="request.env['pb.ess.workforce'].portal_clock_enabled()" t-attf-class="pbew-nav__i #{page_name == 'work_clock' and 'is-on' or ''}" href="/my/work/clock">
        <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'timer'"/><t t-set="isz" t-value="15"/></t><span>Clock</span>
      </a>
      <a t-attf-class="pbew-nav__i #{page_name == 'work_schedule' and 'is-on' or ''}" href="/my/work/schedule">
        <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'calendar'"/><t t-set="isz" t-value="15"/></t><span>Schedule</span>
      </a>
      <a t-attf-class="pbew-nav__i #{page_name == 'work_timesheet' and 'is-on' or ''}" href="/my/work/timesheet">
        <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'clock'"/><t t-set="isz" t-value="15"/></t><span>Timesheet</span>
      </a>
      <a t-attf-class="pbew-nav__i #{page_name == 'work_leave' and 'is-on' or ''}" href="/my/work/leave">
        <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'sun'"/><t t-set="isz" t-value="15"/></t><span>Leave</span>
      </a>
      <a t-attf-class="pbew-nav__i #{page_name == 'work_overtime' and 'is-on' or ''}" href="/my/work/overtime">
        <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'zap'"/><t t-set="isz" t-value="15"/></t><span>Overtime</span>
      </a>
    </div>
  </template>

  <template id="work_flash" name="My Work flash">
    <div t-if="flash" class="pbew-flash">
      <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'check-circle'"/><t t-set="isz" t-value="16"/></t>
      <span t-esc="flash"/>
    </div>
  </template>

  <!-- ============================================================= -->
  <!--  My Schedule                                                   -->
  <!-- ============================================================= -->
  <template id="portal_my_work_schedule" name="My Schedule (ESS)">
    <t t-call="portal.portal_layout">
      <div class="pbme pbew">
        <t t-call="pb_me_portal.ess_hero">
          <t t-set="hero_eyebrow">My Work</t>
          <t t-set="hero_title">My Schedule</t>
          <t t-set="hero_sub">Your published shifts. Confirm the ones you have seen so your manager knows the roster landed.</t>
        </t>
        <t t-call="pb_ess_workforce.work_nav"/>
        <t t-call="pb_ess_workforce.work_flash"/>

        <!-- ==== the anonymous shift pulse ====
             Shown only after a shift the person actually worked has ENDED
             today, and only until they answer or dismiss. The five faces ARE
             the rating control — they are the data, not chrome, which is the
             one place W2's no-emoji rule does not apply. -->
        <div t-if="pulse and pulse.get('show')" class="pbew-pulse">
          <div class="pbew-pulse__q">
            <div class="t">How did your shift go?</div>
            <div class="s"><t t-esc="pulse['shift']"/></div>
            <div class="s">Your answer is anonymous — it is never linked to your name.</div>
          </div>
          <form action="/my/work/pulse" method="post" class="pbew-pulse__row">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <button type="submit" name="rating" value="1" class="pbew-face" title="Bad">😞</button>
            <button type="submit" name="rating" value="2" class="pbew-face" title="Not great">🙁</button>
            <button type="submit" name="rating" value="3" class="pbew-face" title="OK">😐</button>
            <button type="submit" name="rating" value="4" class="pbew-face" title="Good">🙂</button>
            <button type="submit" name="rating" value="5" class="pbew-face" title="Great">😄</button>
          </form>
          <form action="/my/work/pulse/dismiss" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <button type="submit" class="pbew-pulse__skip">Not now</button>
          </form>
        </div>

        <div class="pbew-weeknav">
          <a class="pbme-btn pbme-btn--ghost" t-attf-href="/my/work/schedule?week=#{sched['prev_week']}">
            <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'arrow-left'"/><t t-set="isz" t-value="14"/></t>Earlier
          </a>
          <span t-attf-class="pbew-weeknav__l #{sched['pending'] and '' or 'pbew-ok'}"
                t-esc="sched['pending_label']"/>
          <a class="pbme-btn pbme-btn--ghost" t-attf-href="/my/work/schedule?week=#{sched['next_week']}">
            Later<t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'arrow-right'"/><t t-set="isz" t-value="14"/></t>
          </a>
        </div>

        <t t-foreach="sched['weeks']" t-as="w">
          <div class="pbme-card pbew-week">
            <div class="pbew-week__h">
              <div>
                <h3 class="pbme-card-title"><t t-esc="w['label']"/></h3>
                <div class="pbme-muted" t-esc="w['hours_label']"/>
              </div>
              <form t-if="w['pending']" action="/my/work/schedule/ack" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="week_start" t-att-value="w['week_start']"/>
                <button type="submit" class="pbme-btn pbme-btn--primary">
                  <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'check'"/><t t-set="isz" t-value="15"/></t>
                  <t t-esc="w['confirm_label']"/>
                </button>
              </form>
              <span t-elif="w['all_acked']" class="pbew-chip pbew-chip--ok">
                <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'check'"/><t t-set="isz" t-value="13"/></t>All confirmed
              </span>
              <span t-else="" class="pbew-chip pbew-chip--muted" t-esc="w['ack_label']"/>
            </div>

            <div class="pbew-days">
              <t t-foreach="w['days']" t-as="d">
                <div t-attf-class="pbew-day #{d['is_today'] and 'is-today' or ''} #{d['is_past'] and 'is-past' or ''} #{d['is_weekend'] and 'is-weekend' or ''}">
                  <div class="pbew-day__h">
                    <span class="dw" t-esc="d['label']"/>
                    <span class="dd"><t t-esc="d['day_num']"/> <t t-esc="d['month']"/></span>
                  </div>
                  <div t-if="d['leave']" class="pbew-leavechip"><t t-esc="d['leave']"/></div>
                  <t t-foreach="d['shifts']" t-as="s">
                    <div t-attf-class="pbew-shift pbew-shift--#{s['ack_state']}">
                      <div class="pbew-shift__t"><t t-esc="s['start']"/> – <t t-esc="s['end']"/></div>
                      <div class="pbew-shift__n"><t t-esc="s['name']"/></div>
                      <div class="pbew-shift__h" t-esc="s['hours_label']"/>
                      <t t-if="s['ack_state'] == 'acked'">
                        <span class="pbew-chip pbew-chip--ok">
                          <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'check'"/><t t-set="isz" t-value="12"/></t>Confirmed
                        </span>
                      </t>
                      <t t-elif="s['can_ack']">
                        <form action="/my/work/schedule/ack" method="post">
                          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                          <input type="hidden" name="shift_id" t-att-value="s['id']"/>
                          <button type="submit" class="pbew-ackbtn">Confirm</button>
                        </form>
                      </t>
                      <span t-else="" class="pbew-chip pbew-chip--muted">Past</span>
                    </div>
                  </t>
                  <div t-if="not d['shifts'] and not d['leave']" class="pbew-day__none">—</div>
                </div>
              </t>
            </div>
          </div>
        </t>
      </div>
    </t>
  </template>

  <!-- ============================================================= -->
  <!--  My Timesheet                                                  -->
  <!-- ============================================================= -->
  <template id="portal_my_work_timesheet" name="My Timesheet (ESS)">
    <t t-call="portal.portal_layout">
      <div class="pbme pbew">
        <t t-call="pb_me_portal.ess_hero">
          <t t-set="hero_eyebrow">My Work</t>
          <t t-set="hero_title">My Timesheet</t>
          <t t-set="hero_sub">What was scheduled, what you actually worked, and the difference. Something wrong? Ask for a fix.</t>
        </t>
        <t t-call="pb_ess_workforce.work_nav"/>
        <t t-call="pb_ess_workforce.work_flash"/>

        <t t-if="not wk">
          <div class="pbme-empty">
            <div class="pbme-empty-ic"><t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'clock'"/><t t-set="isz" t-value="26"/></t></div>
            <h3>No week to show</h3>
            <p>Your timesheet appears once your attendance is set up.</p>
          </div>
        </t>

        <t t-else="">
          <div class="pbew-weeknav">
            <a class="pbme-btn pbme-btn--ghost" t-attf-href="/my/work/timesheet?week=#{wk['prev_week']}">
              <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'arrow-left'"/><t t-set="isz" t-value="14"/></t>Previous week
            </a>
            <span class="pbew-weeknav__l"><t t-esc="wk['week_start']"/> → <t t-esc="wk['week_end']"/></span>
            <a class="pbme-btn pbme-btn--ghost" t-attf-href="/my/work/timesheet?week=#{wk['next_week']}">
              Next week<t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'arrow-right'"/><t t-set="isz" t-value="14"/></t>
            </a>
          </div>

          <div class="pbme-tiles">
            <div class="pbme-tile"><div class="pbme-tile-l">Scheduled</div><div class="pbme-tile-v"><t t-esc="wk['totals']['sched']"/> h</div></div>
            <div class="pbme-tile"><div class="pbme-tile-l">Worked</div><div class="pbme-tile-v"><t t-esc="wk['totals']['entered']"/> h</div></div>
            <div class="pbme-tile"><div class="pbme-tile-l">Difference</div><div class="pbme-tile-v"><t t-esc="wk['totals']['delta']"/> h</div></div>
          </div>

          <div class="pbme-card pbme-tablewrap">
            <table class="pbew-wk">
              <thead>
                <tr><th>Day</th><th class="pbme-num">Scheduled</th><th class="pbme-num">Worked</th><th class="pbme-num">Difference</th><th>Fix</th></tr>
              </thead>
              <tbody>
                <t t-foreach="wk['days']" t-as="d">
                  <tr t-attf-class="#{d['is_today'] and 'is-today' or ''}">
                    <td><b t-esc="d['label']"/></td>
                    <td class="pbme-num"><t t-if="d['planned']"><t t-esc="d['sched']"/></t><t t-else="">—</t></td>
                    <td class="pbme-num"><t t-esc="d['entered']"/></td>
                    <td t-attf-class="pbme-num #{d['delta'] &lt; 0 and 'pbew-neg' or ''}"><t t-esc="d['delta']"/></td>
                    <td>
                      <t t-if="d['fix']">
                        <span t-attf-class="pbme-badge pbme-badge--#{d['fix']['state']}"><t t-esc="d['fix']['state']"/></span>
                      </t>
                      <t t-elif="d['can_fix']">
                        <a class="pbew-fixlink" t-attf-href="#fix-#{d['date']}">Request a fix</a>
                      </t>
                    </td>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>

          <div class="pbme-card pbew-fixform">
            <h3 class="pbme-card-title">
              <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'wrench'"/><t t-set="isz" t-value="16"/></t>
              Something wrong? Request a fix
            </h3>
            <p class="pbme-muted">This goes to your manager as an attendance correction. It is filed for you and nobody else — you cannot file one for a colleague.</p>
            <form action="/my/work/timesheet/fix" method="post">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <input type="hidden" name="week" t-att-value="wk['week_start']"/>
              <div class="pbme-form-grid">
                <label><span>Day</span>
                  <select name="day" required="required">
                    <t t-foreach="wk['days']" t-as="d">
                      <option t-if="d['can_fix']" t-att-value="d['date']"><t t-esc="d['label']"/></option>
                    </t>
                  </select>
                </label>
                <label><span>Check-in (HH:MM, optional)</span><input type="text" name="check_in" placeholder="08:00"/></label>
                <label><span>Check-out (HH:MM, optional)</span><input type="text" name="check_out" placeholder="17:00"/></label>
                <label class="pbme-form-wide"><span>What happened?</span>
                  <textarea name="reason" rows="2" required="required" placeholder="e.g. the badge reader did not register my arrival"/></label>
              </div>
              <button type="submit" class="pbme-btn pbme-btn--primary">Send to my manager</button>
            </form>
          </div>
          <!-- ETP E3 (D8): the other kind of time, one line, only when that page is on for this person. -->
          <p t-if="'pb.me.project.time' in request.env and request.env['pb.me.project.time'].session_state() == 'ok'"
             class="pbme-muted pbew-crosslink">
            <a href="/my/project-time">Looking for the hours you spent on each project? That is Project time.</a>
          </p>
        </t>
      </div>
    </t>
  </template>

  <!-- ============================================================= -->
  <!--  My Leave                                                      -->
  <!-- ============================================================= -->
  <template id="portal_my_work_leave" name="My Leave (ESS)">
    <t t-call="portal.portal_layout">
      <div class="pbme pbew">
        <t t-call="pb_me_portal.ess_hero">
          <t t-set="hero_eyebrow">My Work</t>
          <t t-set="hero_title">My Leave</t>
          <t t-set="hero_sub">Your balances and your requests, in the same approval flow HR uses.</t>
        </t>
        <t t-call="pb_ess_workforce.work_nav"/>
        <t t-call="pb_ess_workforce.work_flash"/>

        <div class="pbme-card pbew-nobal" t-if="not lv['balances']">
          <p class="pbme-muted">You have no leave allocations yet. Your balances appear here once HR grants them.</p>
        </div>

        <div class="pbme-tiles" t-else="">
          <t t-foreach="lv['balances']" t-as="b">
            <div class="pbme-tile">
              <div class="pbme-tile-l"><t t-esc="b['name']"/></div>
              <div t-attf-class="pbme-tile-v #{b['low'] and 'pbew-low' or ''}" t-esc="b['balance_label']"/>
              <div class="pbme-tile-y" t-esc="b['used_label']"/>
              <!-- WDGAP QF3: what is asked for but not yet approved, quietly -->
              <div t-if="b.get('pending')" class="pbew-tile-wait">
                <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'clock'"/><t t-set="isz" t-value="13"/></t>
                <span t-esc="b['pending_label']"/>
              </div>
            </div>
          </t>
        </div>

        <div class="pbme-detail">
          <div class="pbme-detail-main">
            <div class="pbme-card">
              <h3 class="pbme-card-title">My requests</h3>
              <t t-if="not lv['requests']">
                <p class="pbme-muted">You have not requested any leave yet.</p>
              </t>
              <t t-else="">
                <p class="pbew-lv-help">To change a request, withdraw or cancel it and ask again.</p>
                <ul class="pbew-lvlist">
                  <li t-foreach="lv['requests']" t-as="r" class="pbew-lv" t-att-data-pbew-leave="r['id']">
                    <div class="pbew-lv-main">
                      <div class="pbew-lv-top">
                        <b class="pbew-lv-type" t-esc="r['type']"/>
                        <span t-attf-class="pbme-badge pbme-badge--#{r['state']}"><t t-esc="r['state_label']"/></span>
                      </div>
                      <div class="pbew-lv-when">
                        <span t-esc="r['date_from']"/><t t-if="r['date_to'] and r['date_to'] != r['date_from']"> to <span t-esc="r['date_to']"/></t>
                        <span class="pbew-lv-dot">·</span><span t-esc="r['length_label']"/>
                        <t t-if="r['period_label']"><span class="pbew-lv-dot">·</span><span class="pbew-lv-part" t-esc="r['period_label']"/></t>
                      </div>
                      <div t-if="r['files']" class="pbew-lv-files">
                        <a t-foreach="r['files']" t-as="f" class="pbew-doc" t-att-href="f['url']" target="_blank" rel="noopener">
                          <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'paperclip'"/><t t-set="isz" t-value="13"/></t>
                          <span class="pbew-doc-n" t-esc="f['name']"/>
                        </a>
                      </div>
                    </div>
                    <div t-if="r['can_withdraw'] or r['can_cancel'] or r['can_add_document']" class="pbew-lv-acts">
                      <form t-if="r['can_withdraw']" t-attf-action="/my/work/leave/#{r['id']}/withdraw" method="post" class="pbew-lv-form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="pbme-btn pbme-btn--ghost pbew-btn-sm">
                          <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'undo'"/><t t-set="isz" t-value="14"/></t>
                          <span>Withdraw</span>
                        </button>
                      </form>
                      <details t-if="r['can_cancel']" class="pbew-lvx">
                        <summary class="pbme-btn pbme-btn--ghost pbew-btn-sm">
                          <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'x'"/><t t-set="isz" t-value="14"/></t>
                          <span>Cancel</span>
                        </summary>
                        <form t-attf-action="/my/work/leave/#{r['id']}/cancel" method="post" class="pbew-lvx-body">
                          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                          <label class="pbme-flabel">Why are you cancelling it? Your manager will see this.
                            <input type="text" name="reason" required="required" maxlength="500"/>
                          </label>
                          <button type="submit" class="pbme-btn pbme-btn--primary pbew-btn-sm">Cancel this leave</button>
                        </form>
                      </details>
                      <details t-if="r['can_add_document']" class="pbew-lvx">
                        <summary class="pbme-btn pbme-btn--ghost pbew-btn-sm">
                          <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'paperclip'"/><t t-set="isz" t-value="14"/></t>
                          <span>Add a document</span>
                        </summary>
                        <form t-attf-action="/my/work/leave/#{r['id']}/document" method="post" enctype="multipart/form-data" class="pbew-lvx-body" data-pbew-docform="">
                          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                          <t t-call="pb_ess_workforce.leave_doc_inputs"/>
                          <button type="submit" class="pbme-btn pbme-btn--primary pbew-btn-sm">Add it</button>
                        </form>
                      </details>
                    </div>
                  </li>
                </ul>
              </t>
            </div>
          </div>

          <div class="pbme-detail-side">
            <div class="pbme-card">
              <h3 class="pbme-card-title">Request time off</h3>
              <form action="/my/work/leave/apply" method="post" enctype="multipart/form-data" class="pbew-lvform" data-pbew-leave-form="">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <label class="pbme-flabel">Type
                  <select name="type_id" required="required" data-pbew-type="">
                    <t t-foreach="lv['types']" t-as="t"><option t-att-value="t['id']" t-att-data-unit="t['unit']" t-att-data-doc="'1' if t['needs_document'] else '0'"><t t-esc="t['name']"/></option></t>
                  </select>
                </label>
                <div class="pbew-lvform-dates">
                  <label class="pbme-flabel">First day<input type="date" name="date_from" required="required" data-pbew-from=""/></label>
                  <label class="pbme-flabel">Last day<input type="date" name="date_to" required="required" data-pbew-to=""/></label>
                </div>
                <!-- Half days: only for a kind counted in half days. Without
                     scripts both blocks show and the server ignores the one
                     that does not apply ("Full day" / empty times). -->
                <div t-if="lv.get('has_half_day')" class="pbew-part" data-pbew-part="half_day">
                  <p class="pbew-part-h">For leave taken in half days</p>
                  <div class="pbew-lvform-dates">
                    <label class="pbme-flabel"><span data-pbew-one="">The day</span><span class="d-none" data-pbew-many="">First day</span>
                      <select name="period_from" data-pbew-pfrom="">
                        <option value="full">Full day</option>
                        <option value="am" data-pbew-oneonly="">Morning</option>
                        <option value="pm">Afternoon</option>
                      </select>
                    </label>
                    <label class="pbme-flabel" data-pbew-many="">Last day
                      <select name="period_to" data-pbew-pto="">
                        <option value="full">Full day</option>
                        <option value="am">Morning only</option>
                      </select>
                    </label>
                  </div>
                </div>
                <div t-if="lv.get('has_hours')" class="pbew-part" data-pbew-part="hour">
                  <p class="pbew-part-h">For leave counted in hours (one day)</p>
                  <div class="pbew-lvform-dates">
                    <label class="pbme-flabel">From<input type="time" name="hour_from" data-pbew-hfrom=""/></label>
                    <label class="pbme-flabel">To<input type="time" name="hour_to" data-pbew-hto=""/></label>
                  </div>
                </div>
                <label class="pbme-flabel">Reason (optional)<input type="text" name="note"/></label>

                <div class="pbew-lvdocs" data-pbew-docs="">
                  <p class="pbew-part-h">
                    <span data-pbew-docopt="">Add a document (optional)</span>
                    <span class="d-none pbew-docneed" data-pbew-docneed="">
                      <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'paperclip'"/><t t-set="isz" t-value="14"/></t>
                      A document is needed for this kind of leave
                    </span>
                  </p>
                  <p t-if="lv.get('doc_types')" class="pbew-lv-help" data-pbew-docstatic="">A document is needed for: <t t-esc="', '.join(lv['doc_types'])"/>. You can also add it later.</p>
                  <t t-call="pb_ess_workforce.leave_doc_inputs"/>
                </div>

                <!-- the live "after this request" line (scripts only) -->
                <div class="pbew-prev d-none" data-pbew-preview="" aria-live="polite">
                  <p class="pbew-prev-amount" data-pbew-amount=""/>
                  <p class="pbew-prev-after" data-pbew-after=""/>
                  <p class="pbew-prev-warn d-none" data-pbew-warn=""/>
                  <p class="pbew-prev-err d-none" data-pbew-err=""/>
                </div>

                <button type="submit" class="pbme-btn pbme-btn--primary pbme-btn--block">Send for approval</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

  <!-- WDGAP QF3: the two document inputs (choose a file / take a photo),
       cloned from the expense receipt. Up to 5 per request, 10 MB each,
       photos or PDF — the server decides from the file itself. -->
  <template id="leave_doc_inputs" name="My Leave document inputs">
    <div class="pbew-docin">
      <label class="pbew-docbtn">
        <input type="file" name="doc" multiple="multiple" accept="image/*,.pdf,application/pdf" class="pbew-docfile" data-pbew-file=""/>
        <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'file-up'"/><t t-set="isz" t-value="16"/></t>
        <span>Choose a file</span>
      </label>
      <label class="pbew-docbtn">
        <input type="file" name="doc_cam" accept="image/*" capture="environment" class="pbew-docfile" data-pbew-file=""/>
        <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'camera'"/><t t-set="isz" t-value="16"/></t>
        <span>Take a photo</span>
      </label>
    </div>
    <p class="pbew-docnames d-none" data-pbew-docnames=""/>
    <p class="pbew-lv-hint">A photo or a PDF, up to 10 MB each, up to 5 per request.</p>
    <p class="pbew-prev-warn d-none" data-pbew-docwarn="size">That file is over 10 MB. Try a smaller photo, or a PDF of the page.</p>
    <p class="pbew-prev-warn d-none" data-pbew-docwarn="type">A document can be a photo (JPG, PNG or WEBP) or a PDF. Choose another file.</p>
  </template>

  <!-- ============================================================= -->
  <!--  My Overtime                                                   -->
  <!-- ============================================================= -->
  <template id="portal_my_work_overtime" name="My Overtime (ESS)">
    <t t-call="portal.portal_layout">
      <div class="pbme pbew">
        <t t-call="pb_me_portal.ess_hero">
          <t t-set="hero_eyebrow">My Work</t>
          <t t-set="hero_title">My Overtime</t>
          <t t-set="hero_sub">Overtime is recorded and approved by your manager. This is the record.</t>
        </t>
        <t t-call="pb_ess_workforce.work_nav"/>
        <t t-call="pb_ess_workforce.work_flash"/>

        <t t-if="not ot['rows']">
          <div class="pbme-empty">
            <div class="pbme-empty-ic"><t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'zap'"/><t t-set="isz" t-value="26"/></t></div>
            <h3>No overtime recorded</h3>
            <p>When your manager records overtime for you, it shows up here.</p>
          </div>
        </t>

        <t t-else="">
          <div class="pbme-tiles">
            <div class="pbme-tile"><div class="pbme-tile-l">Approved hours</div><div class="pbme-tile-v"><t t-esc="ot['total_approved']"/> h</div></div>
            <div class="pbme-tile"><div class="pbme-tile-l">Awaiting approval</div><div class="pbme-tile-v"><t t-esc="ot['pending']"/></div></div>
          </div>
          <div class="pbme-card pbme-tablewrap">
            <table class="pbew-wk">
              <thead><tr><th>Date</th><th>Type</th><th>Rate</th><th class="pbme-num">Planned</th><th class="pbme-num">Actual</th><th class="pbme-num">Approved</th><th>Status</th></tr></thead>
              <tbody>
                <t t-foreach="ot['rows']" t-as="r">
                  <tr>
                    <td><b t-esc="r['date']"/></td>
                    <td><t t-esc="r['type_label']"/></td>
                    <td><t t-esc="r['rate']"/></td>
                    <td class="pbme-num"><t t-esc="r['planned']"/></td>
                    <td class="pbme-num"><t t-esc="r['actual']"/></td>
                    <td class="pbme-num"><b t-esc="r['approved']"/></td>
                    <td><span t-attf-class="pbme-badge pbme-badge--#{r['state']}"><t t-esc="r['state']"/></span></td>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
        </t>
      </div>
    </t>
  </template>

  <!-- ============================================================= -->
  <!--  TIERS T3b — Clock in / out                                    -->
  <!-- ============================================================= -->
  <!-- The hero is ONE large round button. At rest it reads "Clock in";
       once in, it becomes a live timer ("3 h 12 m", "since 08:02") inside a
       closed ring that breathes softly. The first press animates the ring
       closed (`is-just-in`, set when the page comes back from the punch, and
       `is-pressing`, set by the script the moment the button is pressed);
       a clock-out unwinds it. Beside it: today's total and the last seven
       days as a strip of bars. Every word is here; the script only changes
       numbers (static/src/interactions/clock.js). The whole page works
       without the script: the button is a form POST. -->
  <template id="portal_my_work_clock" name="Clock in / out (ESS)">
    <t t-call="portal.portal_layout">
      <t t-set="is_in" t-value="clock['state'] == 'in'"/>
      <t t-set="open_m" t-value="clock.get('open_minutes') or 0"/>
      <t t-set="today_m" t-value="clock.get('today_minutes') or 0"/>
      <t t-set="today_cell" t-value="(clock.get('week') or [{}])[-1]"/>
      <div t-att-class="'pbme pbew pbew-clockpage is-%s' % clock['state']">
        <t t-call="pb_me_portal.ess_hero">
          <t t-set="hero_eyebrow">My Work</t>
          <t t-set="hero_title">Clock in / out</t>
          <t t-set="hero_sub">Start and end your day here. Your hours reach your timesheet straight away.</t>
        </t>
        <t t-call="pb_ess_workforce.work_nav"/>

        <div t-if="done" class="pbew-toast" role="status" aria-live="polite">
          <span class="pbew-toast__ic"><t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'check'"/><t t-set="isz" t-value="16"/></t></span>
          <span t-if="done == 'in'">You are clocked in. Have a good day.</span>
          <span t-elif="done == 'out'">You are clocked out. Your hours are on your timesheet.</span>
          <span t-elif="done == 'changed'">Your clock changed since this page opened. Check the current status below and try again.</span>
          <span t-elif="clock['state'] == 'in'">You are already clocked in.</span>
          <span t-else="">You are already clocked out.</span>
        </div>

        <div t-if="error" class="pbew-alert" role="alert">
          <span class="pbew-alert__ic"><t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'alert'"/><t t-set="isz" t-value="18"/></t></span>
          <div class="pbew-alert__body">
            <b>That did not go through.</b>
            <span class="pbew-alert__why" t-out="error"/>
            <span>If it keeps happening, ask your manager for a fix on your timesheet.</span>
            <a class="pbme-lab-link" href="/my/work/timesheet">Open my timesheet</a>
          </div>
        </div>

        <div t-if="not clock['enabled']" class="pbme-empty pbew-clock-off">
          <div class="pbme-empty-ic"><t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'timer'"/><t t-set="isz" t-value="26"/></t></div>
          <h3>Clocking in here is off for your company</h3>
          <p>Use your usual device or the field app. Your hours still reach your timesheet, and you can check them there.</p>
          <a href="/my/work/timesheet" class="pbme-btn pbme-btn--primary">Open my timesheet</a>
        </div>

        <section t-else="" class="pbew-clock" data-pbew-live=""
                 t-att-data-state="clock['state']"
                 t-att-data-since-ms="clock.get('since_ms') or 0"
                 t-att-data-server-now-ms="clock.get('server_now_ms') or 0"
                 t-att-data-today-closed="clock.get('today_closed_minutes') or 0"
                 t-att-data-since-today="'1' if clock.get('since_days_ago', 0) == 0 else '0'"
                 aria-labelledby="pbew-clock-h">
          <h2 class="visually-hidden" id="pbew-clock-h">Your clock</h2>
          <div class="pbew-clock__stage">
            <form action="/my/work/clock/toggle" method="post" class="pbew-clock__form" data-pbew-clock-form=""
                  t-att-data-tracking="'1' if clock.get('tracking') else '0'">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <input type="hidden" name="lat" value=""/>
              <input type="hidden" name="lng" value=""/>
              <input type="hidden" name="accuracy" value=""/>
              <input type="hidden" name="action" t-att-value="'out' if is_in else 'in'"/>
              <input type="hidden" name="attendance_id" t-att-value="str(clock.get('attendance_id', 0))"/>
              <button type="submit"
                      t-att-class="'pbew-clockbtn is-%s%s' % (clock['state'], ' is-just-in' if done == 'in' else (' is-just-out' if done == 'out' else ''))"
                      t-att-aria-describedby="'pbew-clock-status'">
                <svg class="pbew-ring" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
                  <circle class="pbew-ring__track" cx="60" cy="60" r="56"/>
                  <circle class="pbew-ring__arc" cx="60" cy="60" r="56" pathLength="100"/>
                </svg>
                <span class="pbew-ring__breath" aria-hidden="true"/>
                <span class="pbew-clockbtn__face">
                  <t t-if="is_in">
                    <span class="pbew-clockbtn__timer" data-pbew-elapsed="">
                      <span t-att-class="'pbew-clockbtn__part%s' % ('' if open_m &gt;= 60 else ' d-none')" data-pbew-hwrap=""><b data-pbew-h="" t-out="open_m // 60"/> h</span>
                      <span class="pbew-clockbtn__part"><b data-pbew-m="" t-out="open_m % 60"/> m</span>
                      <span class="pbew-clockbtn__part"><b data-pbew-s="" t-out="'%02d' % (clock.get('open_seconds', 0) % 60)"/> s</span>
                    </span>
                    <span class="pbew-clockbtn__since">since <t t-out="clock.get('since_label')"/></span>
                    <span class="pbew-clockbtn__cta"><t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'log-out'"/><t t-set="isz" t-value="15"/></t>Clock out</span>
                  </t>
                  <t t-else="">
                    <span class="pbew-clockbtn__ic"><t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'log-in'"/><t t-set="isz" t-value="30"/></t></span>
                    <span class="pbew-clockbtn__word">Clock in</span><span class="pbew-clockbtn__hint">Tap to start your day</span>
                  </t>
                </span>
              </button>
            </form>

            <div class="pbew-clock__status" id="pbew-clock-status" aria-live="polite">
              <t t-if="is_in and clock.get('since_days_ago', 0) &gt;= 1">
                <p class="pbew-clock__warn">
                  <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'alert'"/><t t-set="isz" t-value="15"/></t>
                  <span t-out="stale"/>
                </p>
                <a class="pbme-lab-link" href="/my/work/timesheet">Ask for a fix</a>
              </t>
              <p t-elif="is_in" class="pbew-clock__live"><i class="pbew-livedot" aria-hidden="true"/>You are clocked in. The timer keeps going until you clock out.</p>
              <p t-elif="clock.get('last_punch') and clock['last_punch'].get('kind') == 'out' and clock['last_punch'].get('is_today')" class="pbew-clock__last">Last clocked out today at <b t-out="clock['last_punch']['when']"/>.</p>
              <p t-elif="clock.get('last_punch') and clock['last_punch'].get('kind') == 'out'" class="pbew-clock__last">Last clocked out on <b t-out="clock['last_punch']['date']" t-options="{'widget': 'date', 'format': 'EEEE d MMMM'}"/> at <b t-out="clock['last_punch']['when']"/>.</p>
              <p t-else="" class="pbew-clock__last">Not clocked in yet. Your first tap starts today's count.</p>
            </div>
            <p t-if="clock.get('tracking')" class="pbew-clock__geo">
              <t t-call="pb_ess_workforce.work_icon"><t t-set="icon" t-value="'map-pin'"/><t t-set="isz" t-value="14"/></t>
              <span>Your company keeps the place of each punch. If you say no when your browser asks, the punch still goes through.</span>
            </p>
          </div>

          <div class="pbew-clock__side">
            <t t-call="pb_me_portal.pbme_clock_locations"/>
            <div class="pbme-card pbew-today">
              <div class="pbew-today__l">Today</div>
              <div class="pbew-today__v" data-pbew-today="">
                <span t-att-class="'pbew-today__part%s' % ('' if today_m &gt;= 60 else ' d-none')" data-pbew-today-hwrap=""><b data-pbew-today-h="" t-out="today_m // 60"/> h</span>
                <span class="pbew-today__part"><b data-pbew-today-m="" t-out="today_m % 60"/> m</span>
              </div>
              <div class="pbew-today__sub">
                <t t-if="today_cell.get('first_in') and today_cell.get('last_out') and not today_cell.get('open')">In at <b t-out="today_cell['first_in']"/>, out at <b t-out="today_cell['last_out']"/></t>
                <t t-elif="today_cell.get('first_in')">In at <b t-out="today_cell['first_in']"/></t>
                <t t-else="">Nothing recorded yet today</t>
              </div>
            </div>

            <div class="pbme-card pbew-strip">
              <div class="pbew-strip__h">
                <span class="pbew-strip__t">Last 7 days</span>
                <span class="pbew-strip__sum"><b t-out="env['pb.me.home'].fmt_num((clock.get('week_minutes') or 0) / 60.0)"/> h</span>
              </div>
              <ol class="pbew-strip__days">
                <t t-set="wmax" t-value="clock.get('week_max') or 0"/>
                <li t-foreach="clock.get('week') or []" t-as="d"
                    t-att-class="'pbew-strip__d%s%s%s' % (' is-today' if d['is_today'] else '', ' is-open' if d['open'] else '', ' is-zero' if not d['minutes'] else '')"
                    t-att-title="(d['first_in'] and ('%s – %s' % (d['first_in'], d['last_out'] or '…'))) or None">
                  <span class="pbew-strip__bar" aria-hidden="true"><i t-att-style="'--pbew-h: %g' % (round(d['minutes'] * 100.0 / wmax, 1) if wmax else 0) + '%'"/></span>
                  <span class="pbew-strip__v"><t t-if="d['minutes'] &gt;= 60"><t t-out="env['pb.me.home'].fmt_num(d['minutes'] / 60.0)"/> h</t><t t-elif="d['minutes']"><t t-out="d['minutes']"/> m</t><t t-else="">–</t></span>
                  <span class="pbew-strip__n" t-out="d['iso']" t-options="{'widget': 'date', 'format': 'EEE'}"/>
                </li>
              </ol>
              <a class="pbme-lab-link" href="/my/work/timesheet">See the full timesheet</a>
            </div>
          </div>
        </section>
      </div>
