#  The login-less acknowledgment page and its email
# ===========================================================================

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid "Confirm your shift"
msgstr "Xác nhận ca làm của bạn"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid "Yes, I have seen it"
msgstr "Vâng, tôi đã xem"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_mail_body
msgid "This link works once and only for this shift."
msgstr "Liên kết này chỉ dùng được một lần và chỉ cho ca làm này."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid "Thank you"
msgstr "Cảm ơn bạn"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid "Your manager can now see that you have this shift."
msgstr "Quản lý của bạn đã thấy rằng bạn nhận ca này."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid "Already confirmed"
msgstr "Đã xác nhận trước đó"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid "This shift has already started"
msgstr "Ca làm này đã bắt đầu"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid ""
"Confirmations close when a shift begins. Speak to your manager if something "
"is wrong."
msgstr ""
"Việc xác nhận đóng lại khi ca bắt đầu. Hãy trao đổi với quản lý nếu có gì "
"chưa đúng."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid "This shift has changed"
msgstr "Ca làm này đã thay đổi"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid ""
"It was withdrawn or rescheduled after this link was sent. Your manager will "
"send a new one."
msgstr ""
"Ca đã bị rút lại hoặc xếp lại sau khi liên kết này được gửi. Quản lý sẽ gửi "
"cho bạn liên kết mới."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid "This link is not valid"
msgstr "Liên kết này không hợp lệ"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_token_page
msgid ""
"Check that you copied the whole address, or ask your manager to send it "
"again."
msgstr ""
"Hãy kiểm tra bạn đã sao chép đủ địa chỉ, hoặc đề nghị quản lý gửi lại."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_mail_body
msgid "Your shift has been published:"
msgstr "Ca làm của bạn đã được công bố:"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_mail_body
msgid "Time"
msgstr "Giờ"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_mail_body
msgid "Please confirm you have seen it:"
msgstr "Vui lòng xác nhận bạn đã xem:"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.ack_mail_body
msgid "Confirm this shift"
msgstr "Xác nhận ca làm này"
