#. module: pb_ess_workforce
#. odoo-python
#: code:addons/pb_ess_workforce/models/ess_workforce.py:0
msgid "Sent back"
msgstr "Dikembalikan"

#. module: pb_ess_workforce
#. odoo-python
#: code:addons/pb_ess_workforce/models/ess_workforce.py:0
msgid "Only a request that was sent back can be asked again."
msgstr "Hanya permintaan yang dikembalikan yang dapat diajukan lagi."

#. module: pb_ess_workforce
#. odoo-python
#: code:addons/pb_ess_workforce/models/ess_workforce.py:0
msgid "This request was already asked again."
msgstr "Permintaan ini sudah diajukan lagi."

#. module: pb_ess_workforce
#. odoo-python
#: code:addons/pb_ess_workforce/controllers/portal.py:0
msgid "Asked again. Your new request is waiting for approval."
msgstr "Sudah diajukan lagi. Permintaan baru Anda menunggu persetujuan."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "Your approver sent this back to you. It was not refused, and no days were taken."
msgstr "Penyetuju mengembalikan permintaan ini kepada Anda. Permintaan ini tidak ditolak, dan tidak ada hari yang terpakai."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "<span>Ask again</span>"
msgstr "<span>Ajukan lagi</span>"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "Ask again"
msgstr "Ajukan lagi"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "<b>Filled in from your request that was sent back</b>"
msgstr "<b>Diisi dari permintaan Anda yang dikembalikan</b>"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "<span class=\"pbew-again-k\">Why it was sent back</span>"
msgstr "<span class=\"pbew-again-k\">Alasan dikembalikan</span>"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "Change what is needed, then send it. It goes for approval like any new request."
msgstr "Ubah yang perlu, lalu kirim. Permintaan ini akan melalui persetujuan seperti permintaan baru lainnya."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "Documents are not copied. Add them again below if they are still needed."
msgstr "Dokumen tidak disalin. Tambahkan lagi di bawah jika masih diperlukan."

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "Start an empty request instead"
msgstr "Mulai permintaan kosong saja"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "<span data-pbew-one=\"\">The day</span><span class=\"d-none\" data-pbew-many=\"\">First day</span>"
msgstr "<span data-pbew-one=\"\">Hari itu</span><span class=\"d-none\" data-pbew-many=\"\">Hari pertama</span>"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "<option value=\"full\">Full day</option>"
msgstr "<option value=\"full\">Sehari penuh</option>"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "Morning"
msgstr "Pagi"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "Afternoon"
msgstr "Siang"

#. module: pb_ess_workforce
#: model_terms:ir.ui.view,arch_db:pb_ess_workforce.portal_my_work_leave
msgid "Morning only"
msgstr "Pagi saja"
