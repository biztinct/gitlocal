<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- Nightly: settle whatever the day's edits made stale.

         Every edit that could change who pays whom — a line on the map, a
         department joining a division, somebody moving team, a scheme
         switched off — marks the affected company's people in ONE statement
         and stops there. This job is what turns that mark back into an
         answer, so no screen and no edit ever pays for a 4,500-person
         recompute while somebody waits.

         Odoo 19: `numbercall` and `doall` are gone from `ir.cron`. -->

    <record id="cron_recompute_paid_by" model="ir.cron">
        <field name="name">Payroll: work out who is paid by what</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <!-- Guarded on the REGISTRY and not on the method, because during an
             install the cron row lands in the database before every running
             worker has the code that answers it — and the one that fires
             first logs a failure nobody can act on (gotcha GR14). -->
        <field name="code">model._pb_cron_recompute_paid_by() if 'pb.scheme.map' in env else None</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</data>
</odoo>
