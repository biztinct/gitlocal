#. module: pb_pay_delivery
#: model:mail.template,body_html:pb_pay_delivery.mail_template_payslip_delivery
msgid ""
"<div style=\"margin:0; padding:0;\">\n"
"                    <p>Dear <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"                    <p>Please find attached your payslip for the period\n"
"                        <t t-out=\"object.date_from or ''\"/> — <t t-out=\"object.date_to or ''\"/>.</p>\n"
"                    <p>The attachment is password-protected for your privacy. If you are\n"
"                        unsure of the password, please contact your HR/payroll team.</p>\n"
"                    <br/>\n"
"                    Best regards,<br/>\n"
"                    HR &amp; Payroll Team<br/>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin:0; padding:0;\">\n"
"                    <p>DKính gửi <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"                    <p>Vui lòng xem phiếu lương đính kèm của bạn trong kỳ\n"
"                        <t t-out=\"object.date_from or ''\"/> — <t t-out=\"object.date_to or ''\"/>.</p>\n"
"                    <p>Tệp đính kèm được bảo vệ bằng mật khẩu để đảm bảo quyền riêng tư của bạn. Nếu bạn là\n"
"                        không chắc chắn về mật khẩu, vui lòng liên hệ với nhóm nhân sự/nhân sự của bạn.</p>\n"
"                    <br/>\n"
"                    Trân trọng,<br/>\n"
"                    Nhóm nhân sự &amp;<br/>\n"
"                </div>\n"
"            "

