<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- IA REDESIGN CYCLE 5 — this item is RETIRED by the rail cutover (see the
         record below). This file is `<odoo noupdate="1">`, so the `active` and
         `sequence` values below are what a FRESH install records and a plain
         `-u` cannot reach an existing database (W13.1: `ir_model_data.noupdate`
         is a stored per-record column Odoo never refreshes). Existing databases
         are moved by `pb_sidebar/migrations/19.0.3.0.0/post-migrate.py`, which
         owns the whole retirement list because the rail's shape belongs to
         pb_sidebar rather than to any one cockpit. -->
    <!-- PAY RUN › Pay & Deliver. Primary launch is the "Pay & Deliver" button on
         a Done run card; this sidebar item opens the experience directly (it asks
         for a run inside when launched without one). Gated to the pay tier. -->
    <record id="item_pay_deliver" model="pb.sidebar.item">
        <field name="section_id" ref="pb_sidebar.sec_payrun"/>
        <field name="name">Pay &amp; Deliver</field>
        <field name="active" eval="False"/>
        <field name="icon">send</field>
        <field name="sequence">919</field>
        <field name="action_xmlid">pb_pay_delivery.action_pb_pay_delivery</field>
        <field name="action_tag">pb_pay_delivery</field>
        <field name="match_action_tags">pb_pay_delivery</field>
        <!-- Same set as the facade's _PAY_GROUPS (rail 3): manager OR finance. -->
        <field name="groups_id" eval="[(6, 0, [ref('om_hr_payroll.group_hr_payroll_manager'),
                                               ref('account.group_account_invoice'),
                                               ref('account.group_account_user')])]"/>
    </record>
</odoo>
