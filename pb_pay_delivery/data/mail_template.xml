<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Themed-payslip delivery template. Clones om_hr_payroll.mail_template_payslip
             but the encrypted PDF is attached dynamically at send time (email_values),
             NOT via a report_template — the attachment is the per-employee
             password-protected file, never a report render config. Outgoing
             debrand rides automatically (biz_mail_debrand send-time hook). -->
        <record id="mail_template_payslip_delivery" model="mail.template">
            <field name="name">Payslip Delivery (Password PDF)</field>
            <field name="model_id" ref="om_hr_payroll.model_hr_payslip"/>
            <field name="email_from">{{ (user.email_formatted) }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="subject">{{ object.name }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div style="margin:0; padding:0;">
                    <p>Dear <t t-out="object.employee_id.name or ''"/>,</p>
                    <p>Please find attached your payslip for the period
                        <t t-out="object.date_from or ''"/> — <t t-out="object.date_to or ''"/>.</p>
                    <p>The attachment is password-protected for your privacy. If you are
                        unsure of the password, please contact your HR/payroll team.</p>
                    <br/>
                    Best regards,<br/>
                    HR &amp; Payroll Team<br/>
                </div>
            </field>
        </record>
    </data>
</odoo>
