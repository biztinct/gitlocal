<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- =====================================================================
         Phase F bank-file layouts — DATA (C18.42b). Adding a bank = a data
         file, zero code. Column vocabulary: bank_export_wizard.COLUMN_SOURCES.

         PROVENANCE: these are best-effort layouts modelled on common VN bulk
         salary-transfer templates (VCB-Money / BIDV iBank / TCB Business /
         MB eBank / VietinBank eFAST / ACB Online). They are INFERRED and must
         be confirmed against each bank's current import template before a live
         run (report-back §8.2). The engine is data-driven — corrections are a
         one-record edit, no code change.
         ===================================================================== -->

    <!-- Generic CSV -->
    <record id="layout_generic" model="pb.bank.file.layout">
        <field name="name">Generic CSV</field>
        <field name="bank_format">generic</field>
        <field name="file_type">csv</field>
        <field name="encoding">utf-8-sig</field>
        <field name="with_header" eval="True"/>
        <field name="note">Neutral CSV — account, holder, bank, amount, description.</field>
    </record>
    <record id="col_generic_1" model="pb.bank.file.column">
        <field name="layout_id" ref="layout_generic"/>
        <field name="sequence">10</field><field name="header">No</field>
        <field name="source">row_number</field>
    </record>
    <record id="col_generic_2" model="pb.bank.file.column">
        <field name="layout_id" ref="layout_generic"/>
        <field name="sequence">20</field><field name="header">Account Number</field>
        <field name="source">account_number</field>
    </record>
    <record id="col_generic_3" model="pb.bank.file.column">
        <field name="layout_id" ref="layout_generic"/>
        <field name="sequence">30</field><field name="header">Account Name</field>
        <field name="source">account_name</field>
    </record>
    <record id="col_generic_4" model="pb.bank.file.column">
        <field name="layout_id" ref="layout_generic"/>
        <field name="sequence">40</field><field name="header">Bank</field>
        <field name="source">bank_name</field>
    </record>
    <record id="col_generic_5" model="pb.bank.file.column">
        <field name="layout_id" ref="layout_generic"/>
        <field name="sequence">50</field><field name="header">Amount</field>
        <field name="source">net_amount</field><field name="number_format">int</field>
    </record>
    <record id="col_generic_6" model="pb.bank.file.column">
        <field name="layout_id" ref="layout_generic"/>
        <field name="sequence">60</field><field name="header">Description</field>
        <field name="source">literal</field><field name="literal_value">Salary</field>
    </record>

