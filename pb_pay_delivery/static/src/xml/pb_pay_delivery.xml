<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- One status line, three lanes. Whatever a lane is waiting for, it says
       so in the same shape: a chip, the person it is with, and the door. -->
  <t t-name="pb_pay_delivery.RouteStrip">
    <div t-if="route.exists" class="pbpd-route">
      <span t-attf-class="pbpd-chip {{ toneOf(route.state) }}" t-esc="route.state_label"/>
      <span t-if="route.with_whom" class="who">
        <t t-out="ic('user',13)"/> <t t-esc="route.with_whom"/>
      </span>
      <button t-if="route.request_id" class="pbpd-link"
              t-on-click="() => this.openRequest(route.request_id)">
        <t t-out="ic('external',13)"/> <span>See the request</span>
      </button>
    </div>
    <div t-if="route.exists and route.block_reason" class="pbpd-block">
      <span t-out="ic('alert',14)"/> <span t-esc="route.block_reason"/>
    </div>
    <div t-if="route.exists and route.route.length" class="pbpd-steps">
      <div t-foreach="route.route" t-as="st" t-key="st_index"
           t-attf-class="st {{ stepTone(st.status) }}">
        <span class="t" t-esc="st.title"/>
        <span class="p" t-esc="st.people.join(', ')"/>
      </div>
    </div>
  </t>

  <t t-name="pb_pay_delivery.PbPayDelivery">
    <div class="pbpd pbim">

      <!-- A way back to whatever sent us here. Only shown when something did. -->
      <button class="pbpd-back" t-if="back" t-on-click="goBack">
        <t t-out="ic('back', 14)"/> <t t-esc="back.label"/>
      </button>

      <!-- ============================ loading ============================ -->
      <div t-if="!state.loaded" class="pbpd-loading">
        <div class="pbpd-spin"/><span>Loading Pay &amp; Deliver…</span>
      </div>

      <!-- ============================ run picker ======================== -->
      <div t-elif="state.picking" class="pbpd-picker">
        <div class="pbpd-picker-head">
          <h1 t-if="!props.embedded">Pay &amp; Deliver</h1>
          <p>Choose a pay run to send its money files and payslips.</p>
        </div>
        <div t-if="!state.runs.length" class="pbpd-empty">
          <span class="i" t-out="ic('layers',26)"/>
          <div class="t">No pay runs yet</div>
          <div class="s">Run payroll first — completed runs appear here to pay and deliver.</div>
        </div>
        <div class="pbpd-run-grid">
          <div t-foreach="state.runs" t-as="r" t-key="r.id"
               class="pbpd-run-card" t-on-click="() => this.pickRun(r.id)">
            <div class="nm" t-esc="r.name"/>
            <div class="pd" t-esc="r.period"/>
            <div class="meta">
              <span class="hc"><t t-esc="r.headcount"/> payslips</span>
              <span t-if="r.paid" class="badge ok">Paid</span>
              <span t-elif="r.state === 'done'" class="badge">Approved</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================ experience ======================== -->
      <div t-elif="state.data" class="pbpd-wrap">

        <!-- cinematic hero -->
        <div class="pbpd-hero">
          <button class="pbpd-back" t-on-click="backToRuns" t-out="ic('back',18)"/>
          <div class="pbpd-hero-main">
            <!-- the h1 is the RUN, i.e. data; only the eyebrow repeats what the
                 hub's brand and lens rail already say (W17). -->
            <div class="eyebrow" t-if="!props.embedded">Pay &amp; Deliver</div>
            <h1 t-esc="state.data.run.name"/>
            <div class="sub">
              <span t-esc="state.data.run.period"/>
              <span class="dot">•</span>
              <span><t t-esc="state.data.run.headcount"/> payslips</span>
              <span t-if="state.data.run.paid" class="pbpd-chip ok">Paid</span>
            </div>
          </div>
          <div class="pbpd-hero-net">
            <div class="l">Total net</div>
            <div class="v" t-esc="money(state.netShown)"/>
            <div t-if="state.data.validation.excluded_count" class="ready">
              <b t-esc="money(state.data.run.bank_ready_net)"/>
              <span>ready for the bank file</span>
              <span class="dot">•</span>
              <a href="#" t-on-click.prevent="toggleExcl"
                 title="See who is left out and why"><t t-esc="state.data.validation.excluded_count"/> <span>left out</span></a>
            </div>
            <!-- WDGAP PR-C: the run's take-home, taken apart, one currency
                 at a time (never added across currencies). Said only once
                 something is on hold or paid. -->
            <div t-foreach="moneySplit" t-as="m" t-key="m.currency" class="pbpd-split">
              <span t-if="moneyRows.length &gt; 1" class="cur" t-esc="m.currency"/>
              <span t-if="m.held" class="pt hold">
                <t t-out="ic('pause',12)"/> <b t-esc="money(m.held, m.symbol)"/> <span>on hold</span>
              </span>
              <span t-if="m.paid" class="pt paid">
                <t t-out="ic('checkCircle',12)"/> <b t-esc="money(m.paid, m.symbol)"/> <span>paid</span>
              </span>
              <span t-attf-class="pt {{ m.to_pay ? 'due' : 'zero' }}">
                <t t-out="ic('clock',12)"/> <b t-esc="money(m.to_pay, m.symbol)"/> <span>still to pay</span>
              </span>
            </div>
            <div t-foreach="otherCurrencies" t-as="m" t-key="m.currency" class="pbpd-split other">
              <span class="cur" t-esc="m.currency"/>
              <span class="pt"><b t-esc="money(m.total, m.symbol)"/> <span>also in this run</span></span>
              <span class="pt" t-esc="peopleLabel(m.count)"/>
            </div>
          </div>
        </div>

        <!-- The one thing that stops everything else. Said once, at the top. -->
        <div t-if="!state.data.run.approved" class="pbpd-warn">
          <span t-out="ic('alert',18)"/>
          <div>
            <div class="t">This pay run has not been approved yet</div>
            <div class="s">A bank file can only be prepared from an approved pay run.
              Send the run in for approval first — everything here waits for that.</div>
          </div>
        </div>

        <div class="pbpd-lanes">

          <!-- ===================== LANE 1 · MONEY OUT ==================== -->
          <section class="pbpd-lane money">
            <div class="lane-h">
              <span class="ico" t-out="ic('landmark',20)"/>
              <div>
                <div class="ttl">Money out</div>
                <div class="sub">The file the bank pays from, and the go-ahead to send it</div>
              </div>
            </div>

            <!-- ================ card 1 · the bank file ================ -->
            <div class="pbpd-card" data-coach="dl-bank">
              <div class="card-h">
                <span class="ico" t-out="ic('fileText',18)"/>
                <div class="ttl">Bank file</div>
              </div>

              <!-- live counters -->
              <div class="pbpd-counts">
                <div class="c ok">
                  <span class="n" t-esc="state.data.validation.eligible"/>
                  <span class="l">payslips ready</span>
                </div>
                <div t-attf-class="c excl {{ state.data.validation.excluded_count ? 'hot' : '' }}"
                     t-on-click="toggleExcl">
                  <span class="n" t-esc="state.data.validation.excluded_count"/>
                  <span class="l">left out<t t-if="state.data.validation.excluded_count"> — view</t></span>
                </div>
              </div>

              <!-- exclusion drawer -->
              <!-- WDGAP PR-C: the people on hold, apart from the people the bank
                   details leave out — who, why, by whom, how much, and the
                   one action that lets them be paid. Shown whenever anyone is
                   on hold (the drawer below stays behind its counter). -->
              <div t-if="holds.count" class="pbpd-holds">
                <div class="gh">
                  <span class="ico" t-out="ic('pause',15)"/>
                  <span class="t" t-esc="holdsTitle"/>
                  <span class="s">Left out of the bank file and the payslip send-out until released</span>
                </div>
                <div t-foreach="holds.people" t-as="p" t-key="p.slip_id" class="hrow">
                  <div class="who">
                    <button class="emp link" t-on-click="() => this.openEmployeeBank(p.employee_id)"
                            title="Open the employee record">
                      <t t-esc="p.employee"/>
                    </button>
                    <span class="pbpd-chip hold">On hold</span>
                  </div>
                  <div class="why" t-esc="p.reason"/>
                  <div class="meta">
                    <span t-if="p.by">Held by <t t-esc="p.by"/></span>
                    <span t-if="p.on_date" class="dot">•</span>
                    <span t-if="p.on_date" t-esc="shortDate(p.on_date)"/>
                  </div>
                  <div class="amt" t-esc="money(p.amount, p.symbol)"/>
                  <button t-if="p.can_release" class="pbpd-btn ghost sm"
                          t-att-disabled="state.busy"
                          t-on-click="() => this.releaseHold(p)">
                    <span t-out="ic('play',13)"/><span>Release hold</span>
                  </button>
                </div>
              </div>

              <div t-if="state.showExcl and state.data.validation.excluded.length" class="pbpd-excl">
                <div t-foreach="state.data.validation.excluded" t-as="x" t-key="x.employee_id"
                     class="row">
                  <button class="emp link" t-on-click="() => this.openEmployeeBank(x.employee_id)"
                          title="Open the employee record to fix the bank account">
                    <t t-esc="x.employee"/>
                    <span class="go" t-out="ic('external',13)"/>
                  </button>
                  <span class="reasons">
                    <span t-foreach="x.reasons" t-as="rs" t-key="rs_index" class="chip" t-esc="rs"/>
                  </span>
                </div>
              </div>

              <!-- where this one is -->
              <t t-call="pb_pay_delivery.RouteStrip">
                <t t-set="route" t-value="bankFile"/>
              </t>

              <!-- the stored file -->
              <div t-if="bankFile.exists" class="pbpd-file">
                <div class="ico" t-out="ic('fileText',26)"/>
                <div class="meta">
                  <div class="nm" t-esc="bankFile.filename"/>
                  <div class="sub">
                    <t t-esc="bankFile.row_count"/> payments
                    <span class="dot">•</span>
                    <t t-esc="fileSize(bankFile.byte_size)"/>
                    <span class="dot">•</span>
                    <t t-esc="money(bankFile.control_total)"/>
                  </div>
                  <div t-if="bankFile.excluded_count" class="warn">
                    <t t-esc="bankFile.excluded_count"/> person(s) not in this file
                  </div>
                  <div t-if="bankFile.total_sentence" class="sum" t-esc="bankFile.total_sentence"/>
                  <div t-if="bankFile.follow_up or bankFile.released" class="tags">
                    <span t-if="bankFile.follow_up" class="pbpd-chip muted">Follow-up file</span>
                    <span t-if="bankFile.released" class="pbpd-chip ok">Money released</span>
                  </div>
                </div>
                <button t-if="bankFile.downloadable" class="pbpd-btn primary"
                        t-att-disabled="state.busy" t-on-click="downloadFile">
                  <span t-out="ic('download',16)"/><span>Download approved file</span>
                </button>
              </div>

              <!-- bank chips + debit account, only while choosing -->
              <div class="pbpd-banks">
                <button t-foreach="state.data.banks" t-as="b" t-key="b.key"
                        t-attf-class="chip {{ state.bank === b.key ? 'active' : '' }}"
                        t-on-click="() => this.selectBank(b.key)">
                  <span class="dot" t-out="ic('landmark',16)"/>
                  <span class="nm" t-esc="b.name"/>
                </button>
              </div>

              <label class="pbpd-field">
                <span>Company debit account <em>(optional)</em></span>
                <input type="text" t-att-value="state.companyAccount"
                       t-on-input="onCompanyAccount" placeholder="e.g. 0011000123456"/>
              </label>

              <!-- WDGAP PR-C: a file prepared before somebody in it was held -->
              <div t-if="bankFile.held_since and bankFile.held_since.length" class="pbpd-block">
                <span t-out="ic('alert',14)"/> <span t-esc="heldSinceText"/>
              </div>

              <!-- WDGAP PR-C: after money went out, the people still to pay -->
              <div t-if="followUp.offer and bankFile.released" class="pbpd-followup">
                <span class="ico" t-out="ic('repeat',16)"/>
                <div>
                  <div class="t" t-esc="followUpTitle"/>
                  <div class="s">A follow-up file pays only them, with its own approval and release. The file already released stays as it is.</div>
                </div>
              </div>

              <div t-if="paidUp" class="pbpd-empty small done">
                <span class="i" t-out="ic('checkCircle',22)"/>
                <div class="t">Everybody who can be paid has been paid</div>
                <div t-if="holds.count" class="s">Release a hold above to pay that person with a follow-up file.</div>
              </div>
              <div t-elif="allHeld" class="pbpd-empty small">
                <span class="i" t-out="ic('pause',22)"/>
                <div class="t">Everybody left to pay is on hold</div>
                <div class="s">Release a hold above, then prepare the file.</div>
              </div>
              <div t-elif="!state.data.validation.eligible" class="pbpd-empty small">
                <span class="i" t-out="ic('alert',22)"/>
                <div class="t">No payable rows</div>
                <div class="s">Every payslip failed validation — fix the bank accounts left out above, then prepare the file.</div>
              </div>
              <button t-else="" t-attf-class="pbpd-btn {{ bankFile.downloadable and !followUp.offer ? 'ghost' : 'primary' }}"
                      t-att-disabled="state.busy or !state.data.run.approved
                                      or bankFile.state === 'pending'"
                      t-on-click="prepareBankFile">
                <span t-out="ic('upload',18)"/>
                <span t-esc="prepareLabel"/>
              </button>
              <div t-if="bankFile.state === 'approved' and !bankFile.released" class="pbpd-note">
                Preparing it again replaces this file and asks for approval afresh.
              </div>
            </div>

            <!-- ================ card 2 · the release ================ -->
            <div class="pbpd-card" data-coach="dl-release">
              <div class="card-h">
                <span class="ico" t-out="ic('banknote',18)"/>
                <div class="ttl">Payment release</div>
              </div>

              <!-- WDGAP PR-C: money that already went out for this run, by
                   file — the first file and any follow-up stay on record. -->
              <div t-foreach="releasedBefore" t-as="h" t-key="h.id" class="pbpd-released">
                <span class="ico" t-out="ic('checkCircle',16)"/>
                <div class="meta">
                  <div class="nm">
                    Money released
                    <span t-if="h.follow_up" class="pbpd-chip muted">Follow-up file</span>
                  </div>
                  <div class="sub">
                    <t t-esc="money(h.amount, h.symbol)"/>
                    <span class="dot">•</span>
                    <t t-esc="peopleLabel(h.beneficiaries)"/>
                    <t t-if="h.bank_reference">
                      <span class="dot">•</span>
                      <t t-esc="h.bank_reference"/>
                    </t>
                    <span class="dot">•</span>
                    <t t-esc="shortDate(h.released_on)"/>
                  </div>
                </div>
              </div>

              <div t-if="!bankFile.downloadable and release.state !== 'released'"
                   class="pbpd-empty small">
                <span class="i" t-out="ic('lock',22)"/>
                <div class="t">Waiting for the bank file</div>
                <div class="s">The money can be released once the bank file above has been approved.</div>
              </div>

              <t t-else="">
                <t t-call="pb_pay_delivery.RouteStrip">
                  <t t-set="route" t-value="release"/>
                </t>

                <div t-if="release.state === 'released'" class="pbpd-file">
                  <div class="ico" t-out="ic('check',26)"/>
                  <div class="meta">
                    <div class="nm">Money released</div>
                    <div class="sub">
                      <t t-esc="money(release.amount)"/>
                      <span class="dot">•</span>
                      <t t-esc="release.beneficiaries"/> people
                      <t t-if="release.bank_reference">
                        <span class="dot">•</span>
                        <t t-esc="release.bank_reference"/>
                      </t>
                    </div>
                    <div class="sub" t-esc="release.released_on"/>
                  </div>
                </div>

                <t t-else="">
                  <label class="pbpd-field">
                    <span>Bank reference <em>(optional)</em></span>
                    <input type="text" t-att-value="state.bankReference"
                           t-on-input="onBankReference"
                           placeholder="What the bank called this transfer"/>
                  </label>
                  <button class="pbpd-btn primary"
                          t-att-disabled="state.busy or release.state === 'pending'"
                          t-on-click="requestRelease">
                    <span t-out="ic('send',18)"/>
                    <span t-esc="releaseLabel"/>
                  </button>
                </t>
              </t>
            </div>
          </section>

          <!-- ===================== LANE 2 · PAYSLIPS OUT ================= -->
          <section class="pbpd-lane deliver" data-coach="dl-slips">
            <div class="lane-h">
              <span class="ico" t-out="ic('mail',20)"/>
              <div>
                <div class="ttl">Payslips out</div>
                <div class="sub">Password-protected PDFs by email</div>
              </div>
            </div>

            <!-- recipient preview -->
            <div class="pbpd-recips">
              <div class="avatars">
                <img t-foreach="state.data.recipients.avatars" t-as="a" t-key="a_index"
                     class="av" t-att-src="a" alt=""/>
              </div>
              <div class="txt">
                <strong t-esc="state.data.recipients.count"/> recipients
                <span t-if="state.data.recipients.no_email_count" class="warn">
                  · <t t-esc="state.data.recipients.no_email_count"/> without email
                </span>
                <span t-if="state.data.recipients.held_count" class="hold">
                  · <t t-esc="state.data.recipients.held_count"/> on hold, not sent
                </span>
              </div>
            </div>

            <!-- no-email list -->
            <div t-if="state.data.recipients.no_email_count" class="pbpd-noemail">
              <div class="h"><span t-out="ic('alert',14)"/> Skipped — no work email</div>
              <div t-foreach="state.data.recipients.no_email" t-as="n" t-key="n_index"
                   class="row" t-esc="n.employee"/>
            </div>

            <!-- password explainer -->
            <div class="pbpd-pwd">
              <span class="ico" t-out="ic('lock',18)"/>
              <div>
                <div class="t">Each PDF is locked with a per-employee password</div>
                <code t-esc="state.data.password_pattern"/>
                <div class="s">Resolved privately per employee — never shown, logged, or stored.</div>
              </div>
            </div>

            <t t-call="pb_pay_delivery.RouteStrip">
              <t t-set="route" t-value="delivery"/>
            </t>

            <!-- send actions -->
            <div class="pbpd-send-row">
              <button class="pbpd-btn primary"
                      t-att-disabled="state.busy or delivery.state === 'pending'"
                      t-on-click="() => this.send(false)">
                <span t-out="ic('upload',18)"/>
                <span t-esc="sendLabel"/>
              </button>
              <button t-if="delivery.held_ready"
                      class="pbpd-btn ghost" t-att-disabled="state.busy"
                      t-on-click="() => this.send(false)">
                <span t-out="ic('send',16)"/><span t-esc="sendHeldLabel"/>
              </button>
              <button t-if="delivery.failed"
                      class="pbpd-btn ghost" t-att-disabled="state.busy"
                      t-on-click="() => this.send(false)">
                <span t-out="ic('refresh',16)"/><span>Resend failures</span>
              </button>
              <button t-if="delivery.exists"
                      class="pbpd-btn ghost subtle" t-att-disabled="state.busy"
                      t-on-click="() => this.send(true)">
                <span t-out="ic('rotate',16)"/><span>Send to everybody again</span>
              </button>
            </div>

            <!-- delivery summary + pills -->
            <div t-if="delivery.exists and delivery.lines.length" class="pbpd-result">
              <div class="summary">
                <div class="s ok"><b t-esc="delivery.sent"/><span>sent</span></div>
                <div class="s bad"><b t-esc="delivery.failed"/><span>failed</span></div>
                <div class="s warn"><b t-esc="delivery.skipped"/><span>skipped</span></div>
                <div t-if="delivery.held" class="s hold"><b t-esc="delivery.held"/><span>not sent: pay on hold</span></div>
              </div>
              <div class="pills">
                <div t-foreach="delivery.lines" t-as="l" t-key="l_index"
                     t-attf-class="pill {{ pillClass(l.state) }}">
                  <span class="e" t-esc="l.employee"/>
                  <span class="st" t-esc="pillLabel(l.state)"/>
                </div>
              </div>
            </div>
          </section>

        </div>
      </div>

      <!-- ============================ load error ======================== -->
      <div t-else="" class="pbpd-empty">
        <span class="i" t-out="ic('alert',26)"/>
        <div class="t">Couldn't open this run</div>
        <div class="s">Go back and pick a pay run.</div>
        <button class="pbpd-btn ghost" t-on-click="backToRuns">Back to runs</button>
      </div>
    </div>
  </t>

</templates>
