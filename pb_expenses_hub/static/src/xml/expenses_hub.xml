<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ================================================ the Expenses hub
       NAV P2. The whole surface is the kit's shell. Section comments use `=`
       rules and never a doubled hyphen (W22/W72). -->
  <t t-name="pb_expenses_hub.PbExpensesHub">
    <HubShell config="config" action="props.action or {}"/>
  </t>

  <!-- ================================================ Expenses, Claims tab
       The native list inside the hub canvas; the wrapper is a definite-height
       flex column so the list scrolls inside itself (W20). -->
  <t t-name="pb_expenses_hub.PbClaimsLens">
    <div class="pbex-lens o_action">
      <View t-props="viewProps"/>
    </div>
  </t>

</templates>
