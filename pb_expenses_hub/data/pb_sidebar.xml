<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate="0" DELIBERATELY (W13), as every hub's own rail record is. -->
<odoo noupdate="0">

    <!-- OPERATE › Expenses (NAV P2, 2026-10-21) — after Workforce (30).

         Two permission lanes, read as an OR: the HR one and the expense
         approver one. The role lane (budget roles) is written by
         `pb_vendor_access` and asked for again by this module's install step.
         It claims the Trips board's own tag (the retired Workforce › Trips
         entry is inactive) and the two models behind the tabs. The icon is in
         the closed ICONS set of `pb_sidebar/static/src/js/pb_sidebar.js`. -->
    <record id="item_expenses" model="pb.sidebar.item">
        <field name="section_id" ref="pb_sidebar.sec_payrun"/>
        <field name="groups_id"
               eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_expense.group_hr_expense_team_approver'))]"/>
        <field name="name">Expenses</field>
        <field name="icon">wallet</field>
        <field name="sequence">35</field>
        <field name="action_xmlid">pb_expenses_hub.action_pb_expenses_hub</field>
        <field name="action_tag">pb_expenses_hub</field>
        <field name="match_action_tags">pb_expenses_hub,pb_trips</field>
        <field name="match_action_xmlids">pb_me_expense.pb_expense_claim_action</field>
        <field name="match_models">pb.business.trip,pb.expense.claim,hr.expense</field>
    </record>

</odoo>
