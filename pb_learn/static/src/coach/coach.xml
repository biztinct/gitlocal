<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- The launcher and the drawer.

     Note what is NOT here: no backdrop, no o_dialog, no focus trap. The screen
     behind the drawer stays readable and clickable, because the whole reason
     someone opens this is that they are stuck on that screen.

     The launcher is bottom-right, stacked ABOVE PayAI's pill and (until the
     deploy-time uninstall) the retired guided-tour module's
     FAB — see coach.scss. Those two are not modified and not hidden: a demo
     user gets all three, deliberately. -->
<t t-name="pb_learn.CoachHost">
    <!-- `data-place` is the subscription to tab changes (LEARN REFRESH
         step 1): reading `placeKey` here is what re-renders the helper when
         the hub on screen switches tab, drawer open or not. -->
    <div class="lrn-coachhost" t-on-click="onClick" t-att-data-place="placeKey">

        <!-- The Coach is on EVERY screen, so it cannot borrow the Journey's
             sprite: off the Journey the launcher rendered as a blank circle
             with no icon at all. Same symbols, injected wherever it mounts. -->
        <t t-call="pb_learn.IconSprite"/>

        <!-- THE ONE HELPER. The only floating control in the corner: PayAI's
             pill stands down when this module is installed and its chat is
             the drawer below (ONECHAT: one chat, called PayAI). `helper-orb`
             is the tour's last stop. -->
        <button class="lrn-fab" t-on-click="toggle" data-coach="helper-orb"
                t-att-class="{ open: state.open }"
                t-att-aria-expanded="state.open"
                aria-haspopup="dialog"
                t-att-title="state.open ? '' : launcherTitle"
                t-att-aria-label="state.open ? closeLabel : launcherLabel">
            <span class="lrn-fabcore" aria-hidden="true">
                <svg class="lrn-ic"><use t-attf-href="#lrn-i-#{state.open ? 'x' : 'sparkles'}"/></svg>
            </span>
            <span class="lrn-fablabel" t-if="!state.open" t-esc="launcherLabel"/>
            <kbd class="lrn-fabkey" t-if="!state.open" aria-hidden="true">?</kbd>
        </button>

        <!-- LEARN v3 — one moment card above the button: a milestone, the
             month-end nudge, or "first time on this screen". -->
        <div class="lrn-momenthost" t-if="state.moment and !state.open" t-out="momentHTML"/>

        <aside class="lrn-drawer" t-if="state.open" role="dialog"
               t-att-class="{ 'lrn-still': isStill, 'lrn-has-chat': !!chat }"
               t-att-aria-label="coachName">
            <header class="lrn-dhead">
                <span class="lrn-dtitle">
                    <span class="lrn-dmark" aria-hidden="true">
                        <svg class="lrn-ic"><use href="#lrn-i-sparkles"/></svg>
                    </span>
                    <span class="lrn-dname">
                        <b t-esc="coachName"/>
                        <small t-if="screenLabel" class="lrn-dplace" t-key="screenLabel"><t t-esc="onScreenText"/> <t t-esc="screenLabel"/></small>
                    </span>
                </span>
                <!-- Routed through the delegated handler on the root, like every
                     other control in this drawer. A direct t-on-click here did not
                     fire and cost three rounds to notice, while data-act has worked
                     from the first build — so use the path that is already proven
                     rather than the one that should work. -->
                <!-- "Explain this screen" stays in the HEADER (LEARNOS Phase 4):
                     it has to be reachable while an answer is already showing.
                     ONECHAT OC2: its answer lands in the one stream, like
                     everything else. -->
                <button t-if="covered" class="lrn-btn sm ghost lrn-hbtn" data-act="c-explain"
                        t-att-title="explainLabel" t-att-aria-label="explainLabel">
                    <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-scan-text"/></svg>
                </button>
                <button class="lrn-btn sm ghost lrn-langpill" data-act="c-lang">
                    <span t-esc="langLabel"/>
                </button>
                <!-- ONECHAT OC2 — More: read answers aloud, clear the
                     conversation, practice mode, use my voice. The menu is
                     built in coach.js so every control in it is a declared
                     data-act; arrows move through it, Escape closes it first. -->
                <span class="lrn-menuhost" t-on-keydown="onMenuKey">
                    <button class="lrn-btn sm ghost lrn-hbtn" data-act="c-more"
                            aria-haspopup="menu" t-att-aria-expanded="menu.open ? 'true' : 'false'"
                            t-att-aria-label="moreLabel" t-att-title="moreLabel">
                        <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-ellipsis"/></svg>
                    </button>
                    <t t-out="menuHTML"/>
                </span>
                <button class="lrn-btn sm ghost lrn-hbtn" data-act="c-close"
                        t-att-aria-label="closeLabel" t-att-title="closeLabel">
                    <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-x"/></svg>
                </button>
            </header>

            <!-- ONECHAT OC2 — ONE CHAT. No tab strip, no "Your next step".
                 PayAI's embedded chat draws the stream and the composer and
                 is handed this drawer's guide, context card and practice
                 doors through `helper`. The `lang` prop is what re-renders
                 it on a language flip (helper never changes identity). It is
                 mounted while the drawer is open and unmounted on close, so a
                 recording in progress is discarded with it. -->
            <t t-if="chat">
                <t t-component="chat.Component" helper="helper" lang="state.lang"
                   screen="state.screen || ''" place="placeKey" close="closeHelper"/>
            </t>
            <!-- No PayAI chat for this person: the same router, guide-only,
                 in a stream of this drawer's own. No microphone here (voice
                 needs the assistant's speech service). -->
            <t t-else="">
                <div class="lrn-dbody lrn-stream" t-out="bodyHTML" aria-live="polite"/>
                <form class="lrn-dask lrn-composer" t-on-submit="onSubmit">
                    <textarea t-ref="input" rows="1" data-coach="helper-composer"
                              t-att-value="state.question" t-on-input="onInput"
                              t-on-keydown="onComposerKey" t-att-disabled="state.busy"
                              t-att-placeholder="askPlaceholder" t-att-aria-label="askPlaceholder"/>
                    <button class="lrn-btn sm pri lrn-send" type="submit"
                            t-att-disabled="state.busy or !state.question.trim()"
                            t-att-aria-label="sendLabel" t-att-title="sendLabel">
                        <svg class="lrn-ic" aria-hidden="true"><use href="#lrn-i-send"/></svg>
                    </button>
                </form>
            </t>
        </aside>
    </div>
</t>

</templates>
