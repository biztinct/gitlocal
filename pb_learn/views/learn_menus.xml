<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_learn_root"
              name="Training"
              sequence="180"/>

    <menuitem id="menu_learn_journey"
              name="Guided Journey"
              parent="menu_learn_root"
              action="action_learn_journey"
              sequence="10"/>

    <!-- Tenant-admin: the override slots. -->
    <menuitem id="menu_learn_config"
              name="Configuration"
              parent="menu_learn_root"
              sequence="80"/>

    <menuitem id="menu_learn_override"
              name="Training wording"
              parent="menu_learn_config"
              action="action_learn_override"
              groups="pb_hr_payroll_base.group_payroll_super_admin,pb_learn.group_learn_author"
              sequence="10"/>

    <!-- Author-only: the measurement surfaces.

         This used to be "Content" and it used to open the station and lesson
         tables. Phase 1a moved the spine out of the database entirely, so
         there is nothing here to browse — the content is
         static/content/learn_content.json, authored in
         docs/tutorial_poc/author/. What is left is what a person can only
         learn from a running tenant: who got how far, where the Coach missed,
         and (opt-in) what they asked. -->
    <menuitem id="menu_learn_content"
              name="Measurement"
              parent="menu_learn_root"
              groups="pb_learn.group_learn_author"
              sequence="90"/>

    <menuitem id="menu_learn_progress"
              name="Learner progress"
              parent="menu_learn_content"
              action="action_learn_progress"
              sequence="30"/>

    <menuitem id="menu_learn_event"
              name="Learning events"
              parent="menu_learn_content"
              action="action_learn_event"
              sequence="40"/>

    <menuitem id="menu_learn_question"
              name="Stored questions"
              parent="menu_learn_content"
              action="action_learn_question"
              sequence="50"/>

</odoo>
