<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
          Retention for the opt-in question table (Phase D2).

          noupdate="1" so a tenant who widens or narrows the interval keeps
          their setting across upgrades. The WINDOW itself is not configurable
          from here on purpose: 180 days is the promise made in the consent
          prompt, and a promise a tenant can silently extend is not one the
          learner agreed to. Changing it is a code change with a content change
          beside it.

          The job is a hard delete. A retention policy that archives rows is
          not a retention policy.
        -->
        <record id="cron_learn_question_gc" model="ir.cron">
            <field name="name">Learn: delete stored questions past retention</field>
            <field name="model_id" ref="model_learn_question"/>
            <field name="state">code</field>
            <field name="code">model._gc_questions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
