<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <!-- WORKFLOW-2 P2b (D6): the three messages Expenses owns to the employee.

         noupdate="1", as every other mail template in this codebase is: a
         tenant that rewords one must not have it reverted by an upgrade.
         Outgoing debranding rides automatically (biz_mail_debrand).

         The words are NOT written here: subject and body come from
         `pb.expense.claim._pb_mail_subject` / `_pb_mail_body`, which use the
         module's code translations (.po) in the language the template renders
         in (the employee's, `_pb_mail_lang`). Every send passes an explicit
         `email_to` (R6); the field below documents who it is FOR. -->

    <record id="mail_template_claim_approved" model="mail.template">
        <field name="name">Expense claim: approved (to the employee)</field>
        <field name="model_id" ref="model_pb_expense_claim"/>
        <field name="email_to">{{ object._pb_employee_address() }}</field>
        <field name="lang">{{ object._pb_mail_lang() }}</field>
        <field name="subject">{{ object._pb_mail_subject('approved') }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html"><div><t t-out="object._pb_mail_body('approved')"/></div></field>
    </record>

    <record id="mail_template_claim_refused" model="mail.template">
        <field name="name">Expense claim: refused (to the employee)</field>
        <field name="model_id" ref="model_pb_expense_claim"/>
        <field name="email_to">{{ object._pb_employee_address() }}</field>
        <field name="lang">{{ object._pb_mail_lang() }}</field>
        <field name="subject">{{ object._pb_mail_subject('refused') }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html"><div><t t-out="object._pb_mail_body('refused')"/></div></field>
    </record>

    <record id="mail_template_claim_paid" model="mail.template">
        <field name="name">Expense claim: paid (to the employee)</field>
        <field name="model_id" ref="model_pb_expense_claim"/>
        <field name="email_to">{{ object._pb_employee_address() }}</field>
        <field name="lang">{{ object._pb_mail_lang() }}</field>
        <field name="subject">{{ object._pb_mail_subject('paid') }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html"><div><t t-out="object._pb_mail_body('paid')"/></div></field>
    </record>
</data>
</odoo>
