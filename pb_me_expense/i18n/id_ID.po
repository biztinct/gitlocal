#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Your expense claim %(ref)s for %(total)s (%(what)s) was approved."
msgstr "Klaim pengeluaran %(ref)s sebesar %(total)s (%(what)s) telah disetujui."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Finance pays it next. We will email you again when it has been paid."
msgstr "Bagian keuangan akan membayarnya berikutnya. Kami akan mengirim email lagi setelah dibayar."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Your claim was refused"
msgstr "Klaim Anda ditolak"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Your expense claim %(ref)s for %(total)s (%(what)s) was refused."
msgstr "Klaim pengeluaran %(ref)s sebesar %(total)s (%(what)s) ditolak."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "You can fix it and send it again from your claim."
msgstr "Anda dapat memperbaikinya dan mengirimkannya lagi dari klaim Anda."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "No reason was given."
msgstr "Tidak ada alasan yang diberikan."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Your claim was paid"
msgstr "Klaim Anda telah dibayar"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Your expense claim %(ref)s was paid: %(total)s on %(day)s."
msgstr "Klaim pengeluaran %(ref)s telah dibayar: %(total)s pada %(day)s."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Hello %s,"
msgstr "Halo %s,"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Hello,"
msgstr "Halo,"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "The reason given"
msgstr "Alasan yang diberikan"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Open your claim"
msgstr "Buka klaim Anda"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "The employee gets an email that their claim was approved, with a link to it."
msgstr "Karyawan menerima email bahwa klaimnya disetujui, dengan tautan ke klaim tersebut."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "The employee gets an email that their claim was refused, with the reason and a link to fix it."
msgstr "Karyawan menerima email bahwa klaimnya ditolak, beserta alasan dan tautan untuk memperbaikinya."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "The employee gets an email that their claim was paid, with the amount and the date."
msgstr "Karyawan menerima email bahwa klaimnya telah dibayar, beserta jumlah dan tanggalnya."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/me_expense.py:0
msgid "Refused — your turn"
msgstr "Ditolak — giliran Anda"

#. module: pb_me_expense
#: model:mail.template,name:pb_me_expense.mail_template_claim_approved
msgid "Expense claim: approved (to the employee)"
msgstr "Klaim pengeluaran: disetujui (ke karyawan)"

#. module: pb_me_expense
#: model:mail.template,name:pb_me_expense.mail_template_claim_refused
msgid "Expense claim: refused (to the employee)"
msgstr "Klaim pengeluaran: ditolak (ke karyawan)"

#. module: pb_me_expense
#: model:mail.template,name:pb_me_expense.mail_template_claim_paid
msgid "Expense claim: paid (to the employee)"
msgstr "Klaim pengeluaran: dibayar (ke karyawan)"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Your expense claim was sent back"
msgstr "Klaim pengeluaran Anda dikembalikan"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Your claim was sent back"
msgstr "Klaim Anda dikembalikan"

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Your expense claim %(ref)s for %(total)s (%(what)s) was sent back to you."
msgstr "Klaim pengeluaran %(ref)s sebesar %(total)s (%(what)s) dikembalikan kepada Anda."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "Change what is asked below, then send it again from your claim."
msgstr "Ubah sesuai yang diminta di bawah, lalu kirim lagi dari klaim Anda."

#. module: pb_me_expense
#. odoo-python
#: code:addons/pb_me_expense/models/expense_messages.py:0
msgid "When a claim is sent back, the employee gets an email with the reason and a link to fix it."
msgstr "Saat klaim dikembalikan, karyawan menerima email beserta alasan dan tautan untuk memperbaikinya."

#. module: pb_me_expense
#: model:mail.template,name:pb_me_expense.mail_template_claim_returned
msgid "Expense claim: sent back (to the employee)"
msgstr "Klaim pengeluaran: dikembalikan (ke karyawan)"

