msgid "Drafted by PayAI from %(file)s with %(model)s, for %(who)s. It is not published: read every lesson before you publish."
msgstr "PayAI đã soạn từ %(file)s bằng %(model)s, cho %(who)s. Khóa học chưa được công bố: hãy đọc mọi bài trước khi công bố."

#. module: pb_training_payai
#. odoo-python
#: code:addons/pb_training_payai/models/draft.py:0
msgid "Drafted by PayAI from %s. Read every lesson before you publish."
msgstr "PayAI đã soạn từ %s. Hãy đọc mọi bài trước khi công bố."

#. module: pb_training_payai
#: model:ir.model.fields,field_description:pb_training_payai.field_slide_channel__pb_draft_source_id
msgid "Drafted from"
