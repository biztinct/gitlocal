<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No base.group_user and no portal row anywhere: an employee reads their
         own notice and answers only through the /my/privacy routes, under
         sudo after the session check (ledger T-R11). HR reads; managers do
         not (the consent precedent). Multi-company: global rules. -->
    <record id="rule_pb_privacy_notice_company" model="ir.rule">
        <field name="name">Privacy notice: own companies</field>
        <field name="model_id" ref="model_pb_privacy_notice"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_pb_privacy_consent_company" model="ir.rule">
        <field name="name">Privacy answers: own companies</field>
        <field name="model_id" ref="model_pb_privacy_consent"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
