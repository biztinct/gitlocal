<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- WDGAP S6-B: the candidate drawer says when somebody already works
         here, and whether their current manager has been told (E4). -->
    <t t-inherit="pb_hiring.P1Overlays" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pbhr-cd-kv')]" position="inside">
            <t t-if="cand.pbhi">
                <span>Works here</span>
                <b><t t-esc="cand.pbhi.now or cand.pbhi.department"/> · <t t-if="cand.pbhi.told_on">Manager told <t t-esc="cand.pbhi.told_on"/></t><t t-elif="cand.pbhi.has_manager">Manager not told yet</t><t t-else="">No manager on their record</t></b>
            </t>
        </xpath>
    </t>
</templates>
