#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid ""
"%(who)s applied from inside the company. Their current manager is told only "
"when an offer is near."
msgstr ""
"%(who)s đã ứng tuyển từ trong công ty. Quản lý hiện tại của họ chỉ được báo "
"khi sắp có lời mời nhận việc."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid ""
"%(who)s is close to an offer for %(role)s. HR will talk to you about the "
"move and when it happens."
msgstr ""
"%(who)s sắp nhận lời mời cho vị trí %(role)s. Phòng nhân sự sẽ trao đổi với "
"bạn về việc chuyển vị trí và thời điểm."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/offer.py:0
msgid ""
"%(who)s moves to this role from %(when)s. They already work here, so no new "
"employee record, contract, login or joining checklist was made. Their job "
"change comes next."
msgstr ""
"%(who)s chuyển sang vị trí này từ %(when)s. Họ đã làm việc ở đây, nên không "
"tạo hồ sơ nhân viên, hợp đồng, tài khoản đăng nhập hay danh sách nhập môn "
"mới. Bước tiếp theo là thay đổi công việc của họ."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/staff_moves.py:0
msgid ""
"%(who)s moves to this role. No new employee record was made. Job change to "
"do: change their job on their employee record."
msgstr ""
"%(who)s chuyển sang vị trí này. Không tạo hồ sơ nhân viên mới. Việc cần "
"làm: thay đổi công việc trên hồ sơ nhân viên của họ."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/staff_moves.py:0
msgid ""
"%(who)s moves to this role. No new employee record was made. The job change "
"is open for you to check and send."
msgstr ""
"%(who)s chuyển sang vị trí này. Không tạo hồ sơ nhân viên mới. Thay đổi "
"công việc đã mở để bạn kiểm tra và gửi."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid "%(who)s withdrew their application."
msgstr "%(who)s đã rút đơn ứng tuyển."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/pb_me_home.py:0
msgid "%s may move to another role"
msgstr "%s có thể chuyển sang vị trí khác"

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/pb_me_home.py:0
msgid "%s people in your team may move to another role"
msgstr "%s người trong nhóm của bạn có thể chuyển sang vị trí khác"

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/pb_me_home.py:0
msgid "%s people in your team may move to another role."
msgstr "%s người trong nhóm của bạn có thể chuyển sang vị trí khác."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid "(no department)"
msgstr "(chưa có phòng ban)"

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid "(no job title)"
msgstr "(chưa có chức danh)"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"d-none\" data-pbhi-ask=\"\">Withdraw your application? The "
"hiring team will see that you withdrew it.</span>"
msgstr ""
"<span class=\"d-none\" data-pbhi-ask=\"\">Rút đơn ứng tuyển? Nhóm tuyển "
"dụng sẽ thấy bạn đã rút đơn.</span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid "<span class=\"pbhi-hint\">PDF or Word, up to 5 MB.</span>"
msgstr "<span class=\"pbhi-hint\">PDF hoặc Word, tối đa 5 MB.</span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"pbhi-label\">Why this role? <span class=\"pbhi-"
"opt\">optional</span></span>"
msgstr ""
"<span class=\"pbhi-label\">Vì sao bạn chọn vị trí này? <span "
"class=\"pbhi-opt\">không bắt buộc</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"pbhi-label\">Your CV <span class=\"pbhi-"
"opt\">optional</span></span>"
msgstr ""
"<span class=\"pbhi-label\">CV của bạn <span class=\"pbhi-opt\">không bắt "
"buộc</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"pbhi-step-n\">1</span><span><b>The hiring team looks at "
"it</b><span>The recruiter for this role gets your application straight "
"away.</span></span>"
msgstr ""
"<span class=\"pbhi-step-n\">1</span><span><b>Nhóm tuyển dụng xem "
"đơn</b><span>Chuyên viên tuyển dụng của vị trí này nhận đơn của bạn "
"ngay.</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"pbhi-step-n\">2</span><span><b>Conversations, if it "
"fits</b><span>The recruiter arranges any interviews with you "
"directly.</span></span>"
msgstr ""
"<span class=\"pbhi-step-n\">2</span><span><b>Trao đổi, nếu phù "
"hợp</b><span>Chuyên viên tuyển dụng sẽ trực tiếp sắp xếp phỏng vấn với "
"bạn.</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"pbhi-step-n\">3</span><span><b>An offer, then a "
"move</b><span>Your manager is told when an offer is near. Your job then "
"changes on your record.</span></span>"
msgstr ""
"<span class=\"pbhi-step-n\">3</span><span><b>Lời mời, rồi chuyển vị "
"trí</b><span>Quản lý của bạn được báo khi sắp có lời mời. Sau đó công việc "
"của bạn được thay đổi trên hồ sơ.</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.pbhi_promise
msgid ""
"<span>Only the hiring team for the role sees your application. Your manager "
"is told only when an offer is near.</span>"
msgstr ""
"<span>Chỉ nhóm tuyển dụng của vị trí đó thấy đơn của bạn. Quản lý của bạn "
"chỉ được báo khi sắp có lời mời nhận việc.</span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span>Your manager is on the hiring team for this role, so they will see "
"your application.</span>"
msgstr ""
"<span>Quản lý của bạn nằm trong nhóm tuyển dụng của vị trí này, nên họ sẽ "
"thấy đơn của bạn.</span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"A few lines for the hiring team: what you would bring, and what you want to "
"learn."
msgstr "Vài dòng cho nhóm tuyển dụng: bạn sẽ mang lại gì, và bạn muốn học gì."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/offer.py:0
msgid ""
"A move can be confirmed once the offer is signed. This one is “%s” — record "
"the signed copy first."
msgstr ""
"Chỉ xác nhận chuyển vị trí khi lời mời đã được ký. Lời mời này đang “%s”: "
"hãy lưu bản đã ký trước."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid "A move in your team"
msgstr "Một thay đổi vị trí trong nhóm của bạn"

#. module: pb_hiring_internal
#. odoo-javascript
#: code:addons/pb_hiring_internal/static/src/xml/staff_moves.xml:0
msgid ""
"A staff-only role never goes on the careers page. Choosing it for a role "
"already there takes the role off."
msgstr ""
"Vị trí chỉ dành cho nhân viên không bao giờ lên trang tuyển dụng. Chọn mục "
"này cho một vị trí đang đăng sẽ gỡ vị trí đó xuống."

#. module: pb_hiring_internal
#: model:ir.model,name:pb_hiring_internal.model_pb_hiring_posting
msgid "Advert"
msgstr "Tin tuyển dụng"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"An offer is being prepared. Your manager has now been told, as promised."
msgstr ""
"Lời mời nhận việc đang được chuẩn bị. Quản lý của bạn giờ đã được báo, như "
"đã hứa."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid "An offer is near, so %(manager)s, their current manager, was told."
msgstr ""
"Sắp có lời mời nhận việc, nên %(manager)s, quản lý hiện tại của họ, đã được "
"báo."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid ""
"An offer is near. %(who)s has no manager on their record, so nobody else was"
" told."
msgstr ""
"Sắp có lời mời nhận việc. %(who)s không có quản lý trên hồ sơ, nên không "
"báo cho ai khác."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/pb_me_home.py:0
msgid "An offer is near. HR will talk to you about the timing."
msgstr ""
"Sắp có lời mời nhận việc. Phòng nhân sự sẽ trao đổi với bạn về thời điểm."

