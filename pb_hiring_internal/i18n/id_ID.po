#. odoo-python
#: code:addons/pb_hiring_internal/models/offer.py:0
msgid ""
"%(who)s already works here, so no Before they join list was made. "
"%(manager)s, their new manager, was told."
msgstr ""
"%(who)s sudah bekerja di sini, jadi tidak dibuat daftar Sebelum bergabung. "
"%(manager)s, atasan baru mereka, sudah diberi tahu."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid ""
"%(who)s applied from inside the company. Their current manager is told only "
"when an offer is near."
msgstr ""
"%(who)s melamar dari dalam perusahaan. Atasan mereka saat ini baru diberi "
"tahu ketika penawaran sudah dekat."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/applicant.py:0
msgid ""
"%(who)s is close to an offer for %(role)s. HR will talk to you about the "
"move and when it happens."
msgstr ""
"%(who)s hampir menerima penawaran untuk posisi %(role)s. HR akan "
"membicarakan perpindahan ini dan waktunya dengan Anda."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/offer.py:0
msgid ""
"%(who)s is joining your team as %(job)s from %(when)s. They already work "
"here, so HR changes their job on their record."
msgstr ""
"%(who)s bergabung dengan tim Anda sebagai %(job)s mulai %(when)s. Mereka "
"sudah bekerja di sini, jadi HR mengubah jabatan di data mereka."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/offer.py:0
msgid ""
"%(who)s moves to this role from %(when)s. They already work here, so no new "
"employee record, contract, login or joining checklist was made. Their job "
"change comes next."
msgstr ""
"%(who)s pindah ke posisi ini mulai %(when)s. Mereka sudah bekerja di sini, "
"jadi tidak dibuat data karyawan, kontrak, akun masuk, atau daftar orientasi "
"baru. Selanjutnya adalah perubahan jabatan mereka."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/staff_moves.py:0
msgid ""
"%(who)s moves to this role. No new employee record was made. Job change to "
"do: change their job on their employee record."
msgstr ""
"%(who)s pindah ke posisi ini. Tidak ada data karyawan baru. Yang perlu "
"dilakukan: ubah jabatan di data karyawan mereka."

#. module: pb_hiring_internal
#. odoo-python
#: code:addons/pb_hiring_internal/models/staff_moves.py:0
msgid ""
"%(who)s moves to this role. No new employee record was made. The job change "
"is open for you to check and send."
msgstr ""
"%(who)s pindah ke posisi ini. Tidak ada data karyawan baru. Perubahan "
"jabatan sudah terbuka untuk Anda periksa dan kirim."

