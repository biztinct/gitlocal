"<span class=\"pbhi-label\">CV Anda <span "
"class=\"pbhi-opt\">opsional</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"pbhi-step-n\">1</span><span><b>The hiring team looks at "
"it</b><span>The recruiter for this role gets your application straight "
"away.</span></span>"
msgstr ""
"<span class=\"pbhi-step-n\">1</span><span><b>Tim perekrutan "
"meninjaunya</b><span>Perekrut untuk posisi ini langsung menerima lamaran "
"Anda.</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"pbhi-step-n\">2</span><span><b>Conversations, if it "
"fits</b><span>The recruiter arranges any interviews with you "
"directly.</span></span>"
msgstr ""
"<span class=\"pbhi-step-n\">2</span><span><b>Percakapan, jika "
"cocok</b><span>Perekrut mengatur wawancara langsung dengan "
"Anda.</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span class=\"pbhi-step-n\">3</span><span><b>An offer, then a "
"move</b><span>Your manager is told when an offer is near. Your job then "
"changes on your record.</span></span>"
msgstr ""
"<span class=\"pbhi-step-n\">3</span><span><b>Penawaran, lalu "
"pindah</b><span>Atasan Anda diberi tahu ketika penawaran sudah dekat. Lalu "
"jabatan Anda diubah di data Anda.</span></span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.pbhi_promise
msgid ""
"<span>Only the hiring team for the role sees your application. Your manager "
"is told only when an offer is near.</span>"
msgstr ""
"<span>Hanya tim perekrutan posisi tersebut yang melihat lamaran Anda. "
"Atasan Anda baru diberi tahu ketika penawaran sudah dekat.</span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
msgid ""
"<span>Your manager is on the hiring team for this role, so they will see "
"your application.</span>"
msgstr ""
"<span>Atasan Anda termasuk tim perekrutan posisi ini, jadi mereka akan "
"melihat lamaran Anda.</span>"

#. module: pb_hiring_internal
#: model_terms:ir.ui.view,arch_db:pb_hiring_internal.portal_my_job
