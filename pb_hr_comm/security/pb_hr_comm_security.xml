<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         THREE RUNGS, AND THE PERSON WHOSE NAME IS ON AN ANNOUNCEMENT IS NOT
         ON ANY OF THEM.

         That is the whole shape of the permissions here and it is worth
         saying out loud, because the obvious design is wrong. The person who
         looks after the Monday notice may be a plant manager or an office
         lead; they need to write and change their own announcement, and
         handing them a group would hand them every announcement in the
         company. The record rule carries them instead: "the posts I look
         after" is a domain, and a domain is exactly the right tool for a
         permission granted by a RECORD rather than by a group.

         So the ladder is for the HR side of it:

           * Announcements officer — the country HR team: writes, schedules
             and reads the announcements of the companies they can see.
           * Head of announcements — everything above in every company in the
             session, plus the one thing the officer cannot do: change an
             announcement inside the last two days before it goes out.
           * Announcements administrator — plus the switches and the library.

         NO `&` IN A PRIVILEGE NAME, EVER (R124). Odoo 19 builds the user
         form's access-rights arch by embedding privilege names into
         `<group string="...">` without escaping, and one ampersand makes
         opening ANY user from Settings crash — found live when the owner
         tried to change their own password.
         ================================================================== -->

    <record id="module_category_comm" model="ir.module.category">
        <field name="name">Announcements</field>
        <field name="sequence">59</field>
    </record>

    <!-- Odoo 19 pattern: `res.groups` has no `category_id`; a privilege
         record carries it instead. -->
    <record id="res_groups_privilege_comm" model="res.groups.privilege">
        <field name="name">Announcements</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_comm"/>
    </record>

    <record id="group_comm_user" model="res.groups">
        <field name="name">Announcements officer</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_comm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Write announcements, put them on the calendar and read every announcement in the companies they can see. This is the group the Announcements calendar is for.</field>
    </record>

    <record id="group_comm_manager" model="res.groups">
        <field name="name">Head of announcements</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_comm"/>
        <field name="implied_ids" eval="[(4, ref('group_comm_user'))]"/>
        <field name="comment">Everything above, plus changing an announcement inside the last two days before it goes out, agreeing one when sign-off is switched on, and cancelling anybody's.</field>
    </record>

    <record id="group_comm_admin" model="res.groups">
        <field name="name">Announcements administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_comm"/>
        <field name="implied_ids" eval="[(4, ref('group_comm_manager'))]"/>
        <!-- The two built-in administrator accounts and NOBODY ELSE. Every
             other person is added by a human, on purpose. -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Everything above, plus the template library, who announcements land on in each company, and the switches: whether announcements are emailed at all, whether they need a sign-off, and how late they may be changed.</field>
    </record>

</odoo>
