<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ==================================================================
         THE RULES THAT MAKE THE PERMISSIONS SAFE. Three things govern all of
         them and each one was learned the hard way somewhere in this
         codebase.

         1. SHIP THE PAIR, ALWAYS (R60/R65). `ir.rule` group rules are ORed
            over the rules that APPLY, so a narrow rule shipped alone is a
            NARROWING of anybody who holds both groups: a lifecycle manager
            who is also given an announcements group would hold exactly ONE
            applicable rule — the narrow one — and lose sight of everything
            else. Every "only my own" rule below therefore has a wide
            "everything in my companies" rule beside it for the announcements
            tiers, in the same file, and the two are never separated.

         2. A SEAT IS A READ **AND A WRITE** (ledger AM60, corrected in E3,
            R193). A published route asks somebody to agree an announcement
            who may hold no announcements permission at all. The engine
            re-checks that the decider can READ the record and then WRITES
            the record's own status AS THAT PERSON. A seat rule that grants
            only read produces the worst outcome there is: the route records
            the approval and the announcement does not move, with nothing on
            any screen to say why. The narrowing is the DOMAIN —
            `seat_user_ids` is written by the engine and holds only the
            people it asked about this one record — never the permission.
            Create and delete stay shut.

         3. THE RESPONSIBLE PERSON'S WRITE IS NARROWED BY A GUARD AND NOT BY
            A RULE. A record rule is a domain and cannot say "until Tuesday",
            so the rule grants write on the announcements somebody looks
            after and `pb.hr.comm.post.write` refuses a content change inside
            the last two days. A rule and a guard, because neither alone says
            the whole thing.

         `noupdate="1"` freezes these on a database that already has them, so
         any correction travels in a migration and by xmlid (R193).
         ================================================================== -->

    <!-- ======================== the announcement ======================== -->
    <record id="rule_post_company" model="ir.rule">
        <field name="name">Announcement: my companies</field>
        <field name="model_id" ref="model_pb_hr_comm_post"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_post_mine" model="ir.rule">
        <field name="name">Announcement: the ones I look after</field>
        <field name="model_id" ref="model_pb_hr_comm_post"/>
        <field name="domain_force">[('responsible_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_post_seat" model="ir.rule">
        <field name="name">Announcement: the ones a route asked me to decide</field>
        <field name="model_id" ref="model_pb_hr_comm_post"/>
        <field name="domain_force">[('seat_user_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- The wide half of the pair. -->
    <record id="rule_post_hr" model="ir.rule">
        <field name="name">Announcement: the HR team sees them all</field>
        <field name="model_id" ref="model_pb_hr_comm_post"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_comm_user')), (4, ref('group_comm_manager')), (4, ref('group_comm_admin'))]"/>
    </record>

    <!-- =========================== who got it =========================== -->
    <record id="rule_delivery_company" model="ir.rule">
        <field name="name">Who got it: my companies</field>
        <field name="model_id" ref="model_pb_hr_comm_delivery"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_delivery_mine" model="ir.rule">
        <field name="name">Who got it: on an announcement I look after</field>
        <field name="model_id" ref="model_pb_hr_comm_delivery"/>
        <field name="domain_force">[('post_id.responsible_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_delivery_hr" model="ir.rule">
        <field name="name">Who got it: the HR team sees them all</field>
        <field name="model_id" ref="model_pb_hr_comm_delivery"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_comm_user')), (4, ref('group_comm_manager')), (4, ref('group_comm_admin'))]"/>
    </record>

    <!-- =========================== the library =========================== -->
    <!-- A TEMPLATE WITH NO COMPANY BELONGS TO EVERYBODY, which is the whole
         reason the library exists: one HR team writing for four countries. -->
    <record id="rule_template_company" model="ir.rule">
        <field name="name">Template: my companies, or everybody's</field>
        <field name="model_id" ref="model_pb_hr_comm_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_default_company" model="ir.rule">
        <field name="name">Who looks after announcements: my companies</field>
        <field name="model_id" ref="model_pb_hr_comm_default"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</data>
</odoo>
