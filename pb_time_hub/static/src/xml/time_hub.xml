<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="pb_time_hub.PbTimeHub">
    <!-- position:relative — the WfDrawer scrim is absolute and belongs to THIS
         surface, not the viewport (it must not cover the rail or breadcrumb). -->
    <div class="pbim pbth">

      <!-- ================= header: title + shared context bar ============= -->
      <div class="pbth-head">
        <div class="pbth-row">
          <h1 class="pbth-title">Time</h1>
          <WfContextBar className="'pbth-ctx'"
                        features="{ department: true, week: true, person: true, search: true }"/>
        </div>

        <!-- lens tabs -->
        <div class="pbth-lens" role="tablist">
          <button t-foreach="lenses" t-as="l" t-key="l.key"
                  class="pbth-lens__tab" role="tab"
                  t-att-class="{ 'is-on': state.lens === l.key }"
                  t-att-aria-selected="state.lens === l.key"
                  t-on-click="() => this.setLens(l.key)">
            <span class="pbth-lens__ic" t-out="ic(l.icon, 14)"/>
            <span t-esc="l.label"/>
            <span class="pbth-lens__n" t-if="lensCount(l.key)" t-esc="lensCount(l.key)"/>
          </button>
        </div>

        <!-- exception ribbon (mockup A zone 4): what needs review, above the
             content, and gone entirely when there is nothing to review -->
        <WfRibbon t-if="ribbon" tone="ribbon.tone" text="ribbon.text"
                  actionLabel="'Review exceptions →'"
                  onAction="() => this.setLens('exceptions')"/>
      </div>

      <!-- ============================ lenses ============================= -->
      <div class="pbth-body">

        <!-- Week Grid — the Weekly Entry cockpit, embedded (W17) -->
        <div class="pbth-lensbody pbth-lensbody--grid" t-if="state.lens === 'grid'">
          <AttendanceWeekGrid t-key="'lens-grid'" embedded="true"/>
        </div>

        <!-- Exceptions — the Attendance Control board + composer, embedded.
             The nonce remounts it when the drawer hands over a seed. -->
        <div class="pbth-lensbody" t-elif="state.lens === 'exceptions'">
          <PbAttendanceFlow t-key="'lens-exc-' + state.excNonce"
                            embedded="true" initialView="'board'"
                            seed="state.seed"
                            onPerson="_h.onPerson" onChanged="_h.onChanged"/>
        </div>

        <!-- Import — the same component, opened on its import stepper -->
        <div class="pbth-lensbody" t-elif="state.lens === 'import'">
          <PbAttendanceFlow t-key="'lens-imp'" embedded="true" initialView="'import'"
                            onPerson="_h.onPerson"/>
        </div>
      </div>

      <!-- ======================= person drawer =========================== -->
      <WfDrawer t-if="wf.personId" title="drawerTitle" subtitle="drawerSubtitle"
                onClose="() => this.closePerson()">
        <t t-set="p" t-value="state.person"/>

        <div class="pbth-dr-load" t-if="!p">
          <span t-out="ic('loader', 22)"/><span>Loading…</span>
        </div>

        <t t-else="">
          <!-- who -->
          <div class="pbth-dr-who">
            <img class="pbth-av" t-att-src="p.employee.avatar_url" alt=""/>
            <div class="pbth-dr-who__txt">
              <div class="n" t-esc="p.employee.name"/>
              <div class="s" t-esc="drawerSubtitle"/>
            </div>
            <span class="pbth-pill pbth-pill--green" t-if="p.employee.on_shift_now">On shift</span>
          </div>

          <!-- week summary chips -->
          <div class="pbth-wksum">
            <span><i>Scheduled</i><b t-esc="fmt(p.totals.sched)"/></span>
            <span><i>Actual</i><b t-esc="fmt(p.totals.actual)"/></span>
            <span><i>Δ week</i><b t-attf-class="d-{{ deltaTone(p.totals.delta) }}"
                                  t-esc="fmtDelta(p.totals.delta)"/></span>
          </div>

          <!-- the named pain point: one person's week as a table -->
          <table class="pbth-dt">
            <thead>
              <tr><th>Day</th><th>Sched</th><th>Actual</th><th>Entered</th><th>Δ</th></tr>
            </thead>
            <tbody>
              <tr t-foreach="p.days" t-as="d" t-key="d.date"
                  t-att-class="{ 'is-today': d.is_today }">
                <td>
                  <span t-esc="d.label"/>
                  <span class="pbth-flag" t-if="d.flags.includes('trip')" title="Business trip">·T</span>
                  <span class="pbth-flag" t-if="d.flags.includes('holiday')" title="Public holiday">·H</span>
                </td>
                <td t-esc="fmt(d.sched, d.planned)"/>
                <td t-esc="fmt(d.actual, d.planned or d.actual)"/>
                <td>
                  <span t-attf-class="pbth-din {{ dayTone(d) }}"
                        t-esc="d.entered ? fmt(d.entered) : '—'"/>
                </td>
                <td t-attf-class="{{ deltaTone(d.delta) }}"
                    t-esc="d.planned ? fmtDelta(d.delta) : '—'"/>
              </tr>
            </tbody>
          </table>

          <!-- overtime + compliance chips -->
          <div class="pbth-chips">
            <span t-foreach="p.ot" t-as="o" t-key="o.type"
                  t-attf-class="pbth-pill pbth-pill--{{ o.tone }}">
              <t t-esc="o.label"/> · <t t-esc="fmt(o.hours)"/>h
            </span>
            <span class="pbth-pill pbth-pill--green" t-if="p.compliance">
              On time <t t-esc="p.compliance.pct"/>%
            </span>
            <span class="pbth-chips__empty" t-if="!p.ot.length and !p.compliance">
              No overtime or shift compliance recorded this week.
            </span>
          </div>

          <!-- every drawer is a door onwards, never a dead end (W5) -->
          <div class="pbth-dr-acts">
            <button class="pbth-btn pbth-btn--ghost" t-on-click="() => this.fileCorrection()">
              <span t-out="ic('fileText', 14)"/><span>File correction</span>
            </button>
            <button class="pbth-btn pbth-btn--out" t-on-click="() => this.openProfile()">
              <span t-out="ic('external', 14)"/><span>Full profile</span>
            </button>
          </div>
        </t>
      </WfDrawer>
    </div>
  </t>

</templates>
