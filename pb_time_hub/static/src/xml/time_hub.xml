<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="pb_time_hub.PbTimeHub">
    <!-- position:relative — the WfDrawer scrim is absolute and belongs to THIS
         surface, not the viewport (it must not cover the rail or breadcrumb). -->
    <div class="pbim pbth">

      <!-- ================= header: title + shared context bar ============= -->
      <div class="pbth-head">
        <div class="pbth-row">
          <h1 class="pbth-title">Time</h1>
          <WfContextBar className="'pbth-ctx'"
                        features="{ department: true, week: true, person: true, search: true }"/>
        </div>

        <!-- lens tabs -->
        <div class="pbth-lens" role="tablist">
          <button t-foreach="lenses" t-as="l" t-key="l.key"
                  class="pbth-lens__tab" role="tab"
                  t-att-class="{ 'is-on': state.lens === l.key }"
                  t-att-aria-selected="state.lens === l.key"
                  t-on-click="() => this.setLens(l.key)">
            <span class="pbth-lens__ic" t-out="ic(l.icon, 14)"/>
            <span t-esc="l.label"/>
            <span class="pbth-lens__n" t-if="lensCount(l.key)" t-esc="lensCount(l.key)"/>
          </button>
        </div>

        <!-- exception ribbon (mockup A zone 4): what needs review, above the
             content, and gone entirely when there is nothing to review -->
        <WfRibbon t-if="ribbon" tone="ribbon.tone" text="ribbon.text"
                  actionLabel="'Review exceptions →'"
                  onAction="() => this.setLens('exceptions')"/>
      </div>

      <!-- ============================ lenses ============================= -->
      <div class="pbth-body" t-att-class="{ 'pbth-body--fill': state.lens === 'grid' }">

        <!-- Timeline — the rebuilt Timecards read-model on pbim tones -->
        <div class="pbth-lensbody" t-if="state.lens === 'timeline'">
          <TimelineLens t-key="'lens-tl'"
                        departmentId="wf.departmentId" weekStart="wf.weekStart"
                        search="wf.search" onPerson="_h.onPerson"/>
        </div>

        <!-- Week Grid — the Weekly Entry cockpit, embedded (W17) -->
        <div class="pbth-lensbody pbth-lensbody--grid" t-elif="state.lens === 'grid'">
          <AttendanceWeekGrid t-key="'lens-grid'" embedded="true"
                              onPerson="_h.onPerson" onEscalate="_h.onEscalate"/>
        </div>

        <!-- Exceptions — the Attendance Control board + composer, embedded.
             The nonce remounts it when the drawer hands over a seed. -->
        <div class="pbth-lensbody" t-elif="state.lens === 'exceptions'">
          <PbAttendanceFlow t-key="'lens-exc-' + state.excNonce"
                            embedded="true" initialView="'board'"
                            seed="state.seed"
                            onPerson="_h.onPerson" onChanged="_h.onChanged"/>
        </div>

        <!-- Import — the same component, opened on its import stepper -->
        <div class="pbth-lensbody" t-elif="state.lens === 'import'">
          <PbAttendanceFlow t-key="'lens-imp'" embedded="true" initialView="'import'"
                            onPerson="_h.onPerson"/>
        </div>
      </div>

      <!-- ======================= person drawer =========================== -->
      <!-- The drawer BODY is the kit's shared panel (W6) — the same component
           the Today board mounts, so there is one copy of the person-week
           answer. Both actions stay HERE, in the host: filing a correction
           writes, and writes belong to event handlers (W21.1). -->
      <WfDrawer t-if="wf.personId and !state.drawerHidden"
                title="drawerTitle" subtitle="drawerSubtitle"
                onClose="() => this.closePerson()">
        <WfPersonWeek data="state.person" filing="state.filing"
                      onFileCorrection="_h.onFileCorrection"
                      onOpenProfile="_h.onOpenProfile"/>
      </WfDrawer>
    </div>
  </t>

  <!-- ==================================================== Timeline lens -->
  <t t-name="pb_time_hub.TimelineLens">
    <div class="pbtl">

      <div class="pbtl-load" t-if="state.loading and !state.data">
        <span t-out="ic('loader', 22)"/><span>Loading the week…</span>
      </div>

      <div class="pbtl-empty" t-elif="!rows.length">
        <span t-out="ic('activity', 28)"/>
        <div class="t">No one to show</div>
        <div class="s">Adjust the department, the week or the search above.</div>
      </div>

      <t t-else="">
        <!-- legend + the hour window the bars are measured against -->
        <div class="pbtl-legend">
          <span class="pbtl-axis"><t t-out="ic('clock', 12)"/><t t-esc="axisLabel"/></span>
          <span class="pbtl-key pbtl-key--indigo"><i/>Regular</span>
          <span t-foreach="legend" t-as="l" t-key="l.type"
                t-attf-class="pbtl-key pbtl-key--{{ l.tone }}">
            <i/><t t-esc="l.name"/>
            <b t-if="l.rate and l.rate !== '—'" t-esc="l.rate"/>
          </span>
        </div>

        <div class="pbtl-scroll">
          <table class="pbtl-tbl">
            <thead>
              <tr>
                <th class="pbtl-th-emp">Employee</th>
                <th t-foreach="days" t-as="d" t-key="d.date"
                    t-att-class="{ 'is-we': d.is_weekend, 'is-today': d.is_today }"
                    t-esc="d.full_label"/>
                <th class="pbtl-th-n">Reg</th>
                <th class="pbtl-th-n">OT</th>
                <th class="pbtl-th-n">Total</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="rows" t-as="r" t-key="r.id">
                <td class="pbtl-emp">
                  <!-- every avatar is a door to the person drawer (W5) -->
                  <button class="pbtl-who" t-on-click="() => this.openPerson(r.id)"
                          t-attf-title="Open {{ r.name }}'s week">
                    <img class="pbtl-av" t-att-src="r.avatar_url" alt=""/>
                    <span class="pbtl-who__txt">
                      <span class="n" t-esc="r.name"/>
                      <span class="s"><t t-esc="r.job_title"/><t t-if="r.job_title and r.department"> · </t><t t-esc="r.department"/></span>
                    </span>
                  </button>
                </td>

                <td t-foreach="days" t-as="d" t-key="d.date"
                    t-att-class="{ 'is-we': d.is_weekend, 'is-today': d.is_today }">
                  <t t-set="card" t-value="dayCard(r, d.date)"/>
                  <div class="pbtl-track">
                    <span t-foreach="card.entries" t-as="b" t-key="b_index"
                          t-attf-class="pbtl-bar pbtl-bar--{{ b.tone }} {{ b.is_active ? 'is-live' : '' }}"
                          t-attf-style="{{ barStyle(b) }}"
                          t-att-title="barTitle(r, d.date, b)">
                      <t t-if="b.bar_type === 'trip'"><t t-out="ic('plane', 11)"/></t>
                    </span>
                    <span class="pbtl-hrs" t-if="card.total" t-esc="fmtH(card.total)"/>
                  </div>
                </td>

                <td class="pbtl-n" t-esc="fmtH(r.total_regular)"/>
                <td class="pbtl-n">
                  <span t-attf-class="pbth-pill pbth-pill--{{ r.total_ot ? 'amber' : 'slate' }}"
                        t-esc="fmtH(r.total_ot)"/>
                </td>
                <td class="pbtl-n pbtl-n--tot" t-esc="fmtH(r.total_hours)"/>
              </tr>
            </tbody>
          </table>
        </div>
      </t>
    </div>
  </t>

</templates>
