<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         ITS OWN LADDER, GRANTED BY NAME.

         A budget says what a team is worth to the company, and a variance
         says whether its head is trusted with it. That is not something to
         hand to everybody who happens to hold an HR permission, so there
         are NO `implied_ids` from any lifecycle, people, pay or planning
         group in either direction.

         THREE TIERS, AND EACH ONE IS A DIFFERENT QUESTION:

           viewer   "what has MY function got, and how much of it is gone"
           manager  "I look after the budgets" — uploads, edits, expenses
           finance  "I look after the money" — every function, read-only

         Manager and finance both IMPLY viewer, so the board opens for them;
         what each SEES is the record rules below, and what each may CHANGE
         is the ACL.
         ================================================================== -->

    <record id="module_category_budget" model="ir.module.category">
        <field name="name">Budgets</field>
        <field name="sequence">58</field>
    </record>

    <!-- Odoo 19: `res.groups` has no `category_id`; a privilege carries it. -->
    <record id="res_groups_privilege_budget" model="res.groups.privilege">
        <field name="name">Budgets</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_budget"/>
    </record>

    <record id="group_budget_viewer" model="res.groups">
        <field name="name">Budget holder</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_budget"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">See the budget of the function you lead — what it was given, what it has spent, and how that compares with where the year is. Granted by name.</field>
    </record>

    <record id="group_budget_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_budget_viewer'))]"/>
        <field name="comment">See every budget in the companies you work in, and export them. Reads everything; changes nothing.</field>
    </record>

    <record id="group_budget_manager" model="res.groups">
        <field name="name">Budget team</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_budget"/>
        <field name="implied_ids" eval="[(4, ref('group_budget_finance'))]"/>
        <!-- The two built-in administrator accounts and NOBODY ELSE. Adding
             whoever happened to run the upgrade is the failure a ladder like
             this exists to prevent. -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Everything above, plus uploading a year's budget, entering what HR and the office spent, and re-reading the payroll figures.</field>
    </record>

<data noupdate="1">

    <!-- ==================================================================
         COMPANY. Global rules (no `groups`), ANDed with everything below.
         This is what makes country HR work: a budget row carries the
         company it belongs to, and the companies somebody has switched on
         decide whether they can see it at all.

         `wfp.budget.actual` had NO rule of any kind before this module —
         it also had no rows, no writer and no screen. Adding the company
         rule is therefore not a narrowing of anything that was working; it
         is the boundary the model always should have had.
         ================================================================== -->

    <record id="rule_budget_company" model="ir.rule">
        <field name="name">Budget: company</field>
        <field name="model_id" ref="pb_hr_workforce_planning.model_wfp_budget_actual"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_expense_company" model="ir.rule">
        <field name="name">Budget expense: company</field>
        <field name="model_id" ref="model_pb_budget_expense"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- ==================================================================
         THE PAIR (R60/R65). `ir.rule` group rules are ORed, but only over
         the rules that APPLY — so a narrow rule shipped ALONE is a
         narrowing, and here it would narrow somebody who has held this
         model since the workforce-planning module shipped.

         Today a workforce-planning user sees every budget row, because
         there are no group rules on the model at all. Adding only the
         function-head rule below would leave a person holding BOTH that
         group and this module's viewer group with exactly one applicable
         rule — the narrow one — and they would lose everything they had.

         So the wide rule for the workforce-planning tiers ships FIRST, in
         the same file, and this module never changes what they see.
         ================================================================== -->

    <record id="rule_budget_wfp_all" model="ir.rule">
        <field name="name">Budget: workforce planning sees all of it</field>
        <field name="model_id" ref="pb_hr_workforce_planning.model_wfp_budget_actual"/>
        <field name="groups" eval="[(4, ref('pb_hr_workforce_planning.group_wfp_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Finance and the budget team: everything, inside their companies. The
         company rule above is ANDed on top, so "everything" is never every
         company. Both tiers get their own rule rather than one rule naming
         two groups, so revoking one cannot silently widen the other. -->

    <record id="rule_budget_finance_all" model="ir.rule">
        <field name="name">Budget: finance sees all of it</field>
        <field name="model_id" ref="pb_hr_workforce_planning.model_wfp_budget_actual"/>
        <field name="groups" eval="[(4, ref('group_budget_finance'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_budget_manager_all" model="ir.rule">
        <field name="name">Budget: the budget team sees all of it</field>
        <field name="model_id" ref="pb_hr_workforce_planning.model_wfp_budget_actual"/>
        <field name="groups" eval="[(4, ref('group_budget_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- THE NARROW ONE. A function head sees the function they lead —
         "lead" meaning the top-level department's own manager — and any row
         they put there themselves. `pb_function_head_user_id` is a stored
         column precisely so this can be a plain indexed comparison rather
         than a walk up a tree at every read. -->

    <record id="rule_budget_viewer_own_function" model="ir.rule">
        <field name="name">Budget: my own function</field>
        <field name="model_id" ref="pb_hr_workforce_planning.model_wfp_budget_actual"/>
        <field name="groups" eval="[(4, ref('group_budget_viewer'))]"/>
        <field name="domain_force">['|', ('pb_function_head_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>

    <!-- The same three shapes for the expenses. -->

    <record id="rule_expense_finance_all" model="ir.rule">
        <field name="name">Budget expense: finance sees all of it</field>
        <field name="model_id" ref="model_pb_budget_expense"/>
        <field name="groups" eval="[(4, ref('group_budget_finance'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_expense_manager_all" model="ir.rule">
        <field name="name">Budget expense: the budget team sees all of it</field>
        <field name="model_id" ref="model_pb_budget_expense"/>
        <field name="groups" eval="[(4, ref('group_budget_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_expense_viewer_own_function" model="ir.rule">
        <field name="name">Budget expense: my own function</field>
        <field name="model_id" ref="model_pb_budget_expense"/>
        <field name="groups" eval="[(4, ref('group_budget_viewer'))]"/>
        <field name="domain_force">['|', ('function_head_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>

</data>
</odoo>
