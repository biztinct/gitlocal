<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         `<act_window>` and `<report>` shortcut tags are gone from the
         Odoo 19 data-file RNG; every action here is an explicit
         `<record model="ir.actions.act_window">`.

         This module ships NO menu and NO rail item. Its doors are the
         Budget lens on the Insights mission and the command palette, and
         the three plain views below are what a "see them all" chip opens
         when somebody wants a list rather than a board.
         ================================================================== -->

    <!-- ============================ expenses ============================ -->

    <record id="view_pb_budget_expense_list" model="ir.ui.view">
        <field name="name">pb.budget.expense.list</field>
        <field name="model">pb.budget.expense</field>
        <field name="arch" type="xml">
            <list string="What was spent">
                <field name="spend_date"/>
                <field name="name"/>
                <field name="budget_type"/>
                <field name="department_id"/>
                <field name="supplier"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pb_budget_expense_form" model="ir.ui.view">
        <field name="name">pb.budget.expense.form</field>
        <field name="model">pb.budget.expense</field>
        <field name="arch" type="xml">
            <form string="What was spent">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Leadership course for four team leads"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="spend_date"/>
                            <field name="budget_type"/>
                            <field name="department_id"/>
                            <field name="supplier"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="period_month" readonly="1"/>
                        </group>
                    </group>
                    <group string="Anything worth saying about it">
                        <field name="note" nolabel="1" placeholder="Why it was spent, what it covered, who asked for it."/>
                    </group>
                    <group string="Files">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pb_budget_expense_search" model="ir.ui.view">
        <field name="name">pb.budget.expense.search</field>
        <field name="model">pb.budget.expense</field>
        <field name="arch" type="xml">
            <search string="What was spent">
                <field name="name"/>
                <field name="supplier"/>
                <field name="department_id"/>
                <filter name="f_hr_ops" string="HR operations"
                        domain="[('budget_type', '=', 'hr_ops')]"/>
                <filter name="f_admin" string="Admin"
                        domain="[('budget_type', '=', 'admin')]"/>
                <separator/>
                <group>
                    <filter name="g_month" string="Month"
                            context="{'group_by': 'period_month'}"/>
                    <filter name="g_dept" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="g_type" string="Budget"
                            context="{'group_by': 'budget_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_budget_expense" model="ir.actions.act_window">
        <field name="name">What HR and the office spent</field>
        <field name="res_model">pb.budget.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pb_budget_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has been recorded yet</p>
            <p>The pay runs already say what people were paid. This is for
               everything else a budget covers — a training course, an agency
               fee, a leaving gift, a new coffee machine. Each one counts
               against its month.</p>
        </field>
    </record>

    <!-- ========================= the budget rows ========================= -->

    <record id="view_wfp_budget_actual_list" model="ir.ui.view">
        <field name="name">wfp.budget.actual.list.pb</field>
        <field name="model">wfp.budget.actual</field>
        <field name="arch" type="xml">
            <list string="Budgets" create="0">
                <field name="period_month"/>
                <field name="department_id"/>
                <field name="pb_function_id" optional="show"/>
                <field name="pb_budget_type"/>
                <field name="forecast_cost" sum="Budget"/>
                <field name="actual_cost" sum="Spent"/>
                <field name="variance_amount" sum="Left"/>
                <field name="pb_unbudgeted" optional="hide"/>
                <field name="pb_source" optional="show"/>
                <field name="pb_currency_id" optional="hide"/>
                <field name="pb_manual_rate" optional="hide"/>
                <field name="pb_actual_synced_on" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_wfp_budget_actual_form" model="ir.ui.view">
        <field name="name">wfp.budget.actual.form.pb</field>
        <field name="model">wfp.budget.actual</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <sheet>
                    <group>
                        <group string="Which budget">
                            <field name="period_month"/>
                            <field name="department_id"/>
                            <field name="pb_function_id" readonly="1"/>
                            <field name="pb_budget_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="The money">
                            <field name="pb_currency_id"/>
                            <field name="pb_manual_rate"/>
                            <field name="forecast_cost"/>
                            <field name="actual_cost" readonly="1"/>
                            <field name="variance_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="The people">
                            <field name="forecast_headcount"/>
                            <field name="actual_headcount" readonly="1"/>
                        </group>
                        <group string="Where it came from">
                            <field name="pb_source"/>
                            <field name="pb_unbudgeted" readonly="1"/>
                            <field name="pb_actual_synced_on" readonly="1"/>
                            <field name="pb_note"/>
                        </group>
                    </group>
                    <div class="text-muted" style="margin-top:8px;">
                        What has been spent is read from the approved pay runs
                        and from the expenses recorded against this month. It is
                        not typed in here.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wfp_budget_actual_search" model="ir.ui.view">
        <field name="name">wfp.budget.actual.search.pb</field>
        <field name="model">wfp.budget.actual</field>
        <field name="arch" type="xml">
            <search string="Budgets">
                <field name="department_id"/>
                <field name="pb_function_id"/>
                <filter name="f_manpower" string="People"
                        domain="[('pb_budget_type', '=', 'manpower')]"/>
                <filter name="f_hr_ops" string="HR operations"
                        domain="[('pb_budget_type', '=', 'hr_ops')]"/>
                <filter name="f_admin" string="Admin"
                        domain="[('pb_budget_type', '=', 'admin')]"/>
                <separator/>
                <filter name="f_unbudgeted" string="Nobody budgeted it"
                        domain="[('pb_unbudgeted', '=', True)]"/>
                <group>
                    <filter name="g_function" string="Function"
                            context="{'group_by': 'pb_function_id'}"/>
                    <filter name="g_month" string="Month"
                            context="{'group_by': 'period_month'}"/>
                    <filter name="g_type" string="Budget"
                            context="{'group_by': 'pb_budget_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_budget_rows" model="ir.actions.act_window">
        <field name="name">Budget rows</field>
        <field name="res_model">wfp.budget.actual</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wfp_budget_actual_search"/>
        <field name="context">{'search_default_f_manpower': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No budget has been set yet</p>
            <p>Open the Budget lens on Insights and use "Upload a budget" —
               it gives you a spreadsheet with the year across the top and
               every department down the side.</p>
        </field>
    </record>

    <!-- ============================ the upload ============================ -->

    <record id="view_pb_budget_upload_form" model="ir.ui.view">
        <field name="name">pb.budget.upload.wizard.form</field>
        <field name="model">pb.budget.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload a budget">
                <div class="text-muted" style="margin-bottom:12px;">
                    Take the template, fill in a number for each month you want
                    to set, and drop it back. Nothing is written until you press
                    Apply, and a month you leave empty is left exactly as it is.
                </div>
                <group>
                    <group>
                        <field name="fy"/>
                        <field name="budget_type"/>
                    </group>
                    <group>
                        <field name="template_file" filename="template_filename"
                               readonly="1" invisible="not template_file"/>
                        <field name="template_filename" invisible="1"/>
                    </group>
                </group>
                <group>
                    <field name="upload_file" filename="upload_filename"/>
                    <field name="upload_filename" invisible="1"/>
                </group>
                <group invisible="not summary">
                    <field name="summary" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_template" type="object" string="Get the template"/>
                    <button name="action_peek" type="object" string="Check the file"
                            class="btn-secondary" invisible="not upload_file"/>
                    <button name="action_apply" type="object" string="Apply it"
                            class="btn-primary" invisible="not upload_file"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pb_budget_upload" model="ir.actions.act_window">
        <field name="name">Upload a budget</field>
        <field name="res_model">pb.budget.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_pb_budget_upload_form"/>
    </record>

    <!-- ============================= the lens ============================= -->

    <!-- An `ir.actions.client` RECORD, never a bare tag: a bare tag reaches
         the shell with no action NAME and every breadcrumb returning through
         it reads "Unnamed". -->
    <record id="action_pb_budget_board" model="ir.actions.client">
        <field name="name">Budget</field>
        <field name="tag">pb_budget_board</field>
    </record>

</odoo>
