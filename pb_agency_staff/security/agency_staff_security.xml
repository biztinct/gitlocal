<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Agency staff are seen only in the companies the reader works in. -->
    <record id="rule_pb_agency_worker_company" model="ir.rule">
        <field name="name">Agency staff: my companies</field>
        <field name="model_id" ref="model_pb_agency_worker"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
