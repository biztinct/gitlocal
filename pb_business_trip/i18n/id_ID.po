#. module: pb_business_trip
#: model:mail.template,name:pb_business_trip.mail_template_trip_returned
msgid "Business trip: sent back (to the employee)"
msgstr "Perjalanan dinas: dikembalikan (ke karyawan)"

#. module: pb_business_trip
#: model:mail.template,subject:pb_business_trip.mail_template_trip_returned
msgid "Your business trip request was sent back"
msgstr "Permintaan perjalanan dinas Anda dikembalikan"

#. module: pb_business_trip
#: model:mail.template,body_html:pb_business_trip.mail_template_trip_returned
msgid ""
"<div style=\"margin:0;padding:24px 0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2430;font-size:15px;line-height:1.55;\">\n"
"          <div style=\"max-width:520px;margin:0 auto;\">\n"
"            <p style=\"margin:0 0 6px;font-size:13px;color:#6b6f80;\" t-out=\"object.name or ''\">TRIP/2026/0012</p>\n"
"            <h2 style=\"margin:0 0 16px;font-size:20px;font-weight:600;color:#1f2430;\">Your trip request was sent back</h2>\n"
"            <p style=\"margin:0 0 12px;\">Hello <t t-out=\"object.employee_id.name or ''\">Lan</t>,</p>\n"
"            <p style=\"margin:0 0 12px;\">\n"
"              Your trip to <strong t-out=\"object.destination_city or object.destination_country_id.name or ''\">Hanoi</strong>\n"
"              from <t t-out=\"object.date_from or ''\">2026-11-20</t>\n"
"              to <t t-out=\"object.date_to or ''\">2026-11-22</t>\n"
"              was sent back to you.\n"
"            </p>\n"
"            <div style=\"margin:4px 0 16px;padding:12px 14px;border-left:3px solid #5A4BB0;background:#f4f2fb;border-radius:6px;\">\n"
"              <div style=\"font-size:12px;color:#6b6f80;margin-bottom:2px;\">The reason given</div>\n"
"              <div t-out=\"object._pb_sent_back_note() or 'No reason was given.'\">Please add the hotel cost.</div>\n"
"            </div>\n"
"            <p style=\"margin:0 0 12px;\">Change what is needed, then send it again.</p>\n"
"            <p style=\"margin:20px 0 8px;\">\n"
"              <a t-att-href=\"object._pb_sent_back_url()\" style=\"display:inline-block;background:#5A4BB0;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:8px;font-weight:600;\">Open your trip</a>\n"
"            </p>\n"
"          </div>\n"
"        </div>\n"
"      "
msgstr ""
"<div style=\"margin:0;padding:24px 0;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2430;font-size:15px;line-height:1.55;\">\n"
"          <div style=\"max-width:520px;margin:0 auto;\">\n"
"            <p style=\"margin:0 0 6px;font-size:13px;color:#6b6f80;\" t-out=\"object.name or ''\">TRIP/2026/0012</p>\n"
"            <h2 style=\"margin:0 0 16px;font-size:20px;font-weight:600;color:#1f2430;\">Permintaan perjalanan Anda dikembalikan</h2>\n"
"            <p style=\"margin:0 0 12px;\">Halo <t t-out=\"object.employee_id.name or ''\">Lan</t>,</p>\n"
"            <p style=\"margin:0 0 12px;\">\n"
"              Perjalanan Anda ke <strong t-out=\"object.destination_city or object.destination_country_id.name or ''\">Hanoi</strong>\n"
"              dari <t t-out=\"object.date_from or ''\">2026-11-20</t>\n"
"              sampai <t t-out=\"object.date_to or ''\">2026-11-22</t>\n"
"              telah dikembalikan kepada Anda.\n"
"            </p>\n"
"            <div style=\"margin:4px 0 16px;padding:12px 14px;border-left:3px solid #5A4BB0;background:#f4f2fb;border-radius:6px;\">\n"
"              <div style=\"font-size:12px;color:#6b6f80;margin-bottom:2px;\">Alasan yang diberikan</div>\n"
"              <div t-out=\"object._pb_sent_back_note() or 'Tidak ada alasan yang diberikan.'\">Please add the hotel cost.</div>\n"
"            </div>\n"
"            <p style=\"margin:0 0 12px;\">Ubah yang diperlukan, lalu kirim lagi.</p>\n"
"            <p style=\"margin:20px 0 8px;\">\n"
"              <a t-att-href=\"object._pb_sent_back_url()\" style=\"display:inline-block;background:#5A4BB0;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:8px;font-weight:600;\">Buka perjalanan Anda</a>\n"
"            </p>\n"
"          </div>\n"
"        </div>\n"
"      "
