<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WOW record form: native arch, skinned by the VU Form Engine -->
    <record id="view_pb_business_trip_form" model="ir.ui.view">
        <field name="name">pb.business.trip.form</field>
        <field name="model">pb.business.trip</field>
        <field name="arch" type="xml">
            <form string="Business Trip">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="not can_submit"/>
                    <button name="action_manager_approve" string="Approve as Manager"
                            type="object" class="btn-primary"
                            invisible="not can_manager_approve"/>
                    <button name="action_finance_approve" string="Approve as Finance"
                            type="object" class="btn-primary"
                            invisible="not can_finance_approve"/>
                    <button name="action_hr_approve" string="Authorize"
                            type="object" class="btn-primary"
                            invisible="not can_hr_approve"/>
                    <button name="action_refuse_chain" string="Refuse" type="object"
                            invisible="not can_refuse"/>
                    <button name="action_reset_to_draft" string="Reset to Draft"
                            type="object" invisible="not can_reset"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="not can_cancel"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,manager_approved,finance_approved,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Refused" bg_color="text-bg-danger"
                            invisible="state != 'refused'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="destination_city" string="Destination"/>
                        <h1><field name="destination_city" placeholder="e.g. Đà Nẵng"/></h1>
                        <div class="text-muted">
                            <field name="date_from" class="oe_inline"/>
                            <span> – </span>
                            <field name="date_to" class="oe_inline"/>
                            <span> · </span>
                            <field name="duration_days" class="oe_inline"/>
                            <span> days</span>
                        </div>
                    </div>
                    <group>
                        <group string="Itinerary">
                            <field name="name" readonly="1"/>
                            <field name="employee_id"/>
                            <field name="manager_id"/>
                            <field name="destination_country_id"/>
                            <field name="purpose"/>
                        </group>
                        <group string="Money">
                            <field name="currency_id" invisible="1"/>
                            <field name="policy_id"/>
                            <field name="per_diem_rate"/>
                            <field name="per_diem_total"/>
                            <field name="advance_amount"/>
                            <field name="estimated_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Expense Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="category_id"/>
                                    <field name="description"/>
                                    <field name="amount"/>
                                    <field name="receipt_attachment_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval Trail" name="approval">
                            <field name="approval_widget_json" widget="biz_approval_stepper"
                                   nolabel="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" placeholder="Internal notes…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pb_business_trip_list" model="ir.ui.view">
        <field name="name">pb.business.trip.list</field>
        <field name="model">pb.business.trip</field>
        <field name="arch" type="xml">
            <list string="Business Trips">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="destination_city"/>
                <field name="destination_country_id" optional="hide"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="duration_days"/>
                <field name="per_diem_total"/>
                <field name="advance_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-info="state in ('submitted','manager_approved','finance_approved')"
                       decoration-danger="state == 'refused'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_pb_business_trip_search" model="ir.ui.view">
        <field name="name">pb.business.trip.search</field>
        <field name="model">pb.business.trip</field>
        <field name="arch" type="xml">
            <search string="Business Trips">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="destination_city"/>
                <filter name="my_trips" string="My Trips"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="pending" string="Awaiting Approval"
                        domain="[('state', 'in', ('submitted','manager_approved','finance_approved'))]"/>
                <filter name="authorized" string="Authorized"
                        domain="[('state', '=', 'approved')]"/>
                <group name="group_by">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_dept" string="Department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_business_trip" model="ir.actions.act_window">
        <field name="name">Business Trips</field>
        <field name="res_model">pb.business.trip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pb_business_trip_search"/>
        <field name="context">{'search_default_my_trips': 1}</field>
    </record>
</odoo>
