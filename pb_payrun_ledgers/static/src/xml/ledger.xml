<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- Section comments use `=` rules: a doubled hyphen inside an XML comment is
       a parse error that takes the whole file down (W22), and the same trap
       covers naming a CSS custom property, whose prefix is two hyphens (W72). -->
  <t t-name="pb_payrun_ledgers.Ledger">
    <div class="pbim pbim-page ppl-people pbl-ledger"
         t-att-class="{ 'pbl-ledger--hub': props.embedded }">
      <div t-if="!state.loaded" class="pbim-busy"><div class="pbim-spin"/><span>Loading…</span></div>

      <div t-else="" class="pbim-wrap">
        <!-- header: the hub owns the title, so embedded mode has none (W17) -->
        <div class="ppl-head" t-if="!props.embedded">
          <div>
            <h1 class="pbim-h1" t-esc="state.data.title"/>
            <p class="pbim-sub" t-esc="state.data.subtitle"/>
          </div>
        </div>

        <!-- ==== two descriptors, one lens ====
             Rendered only past one tab: a strip of one is a control that does
             nothing, and the single-descriptor lens (Settle) still routes its
             model through tabs[0]. -->
        <div class="pbl-tabs" t-if="tabs.length > 1" data-coach="lg-tabs">
          <button t-foreach="tabs" t-as="t" t-key="t.key"
                  class="pbl-tab"
                  t-att-class="{ 'is-on': state.tab === t.key }"
                  t-att-aria-current="state.tab === t.key ? 'true' : false"
                  t-on-click="() => this.setTab(t.key)">
            <span class="pbl-tab__ic" t-out="ic(t.icon or 'sigma', 14)"/>
            <span t-esc="t.label"/>
          </button>
          <span class="pbl-tabsub" t-esc="state.data.subtitle"/>
        </div>

        <!-- ==== the numbers ====
             Counts are one quiet line (grey at zero; a figure that can
             filter, does). The money totals this page exists to show stay
             as figures of their own below it. -->
        <div data-coach="lg-kpis">
          <t t-if="glance.length">
            <t t-call="pb_import_kit.QuietGlance">
              <t t-set="qGlance" t-value="glance"/>
              <t t-set="qGlanceOn" t-value="glanceOn"/>
            </t>
          </t>
          <div t-if="moneyKpis.length" class="ppl-kpis pbl-money">
            <t t-foreach="moneyKpis" t-as="k" t-key="k_index">
              <div t-attf-class="pbim-stat {{ k.tone === 'ok' ? 'ok' : '' }} {{ k.tone === 'err' ? 'err' : '' }}">
                <span t-attf-class="pbim-stat-ic {{ k.ic_tone or '' }}"><t t-out="ic(k.icon, 21)"/></span>
                <div class="pbim-stat-tx"><span t-attf-class="n {{ k.money ? 'money' : '' }}" t-esc="kpiVal(k)"/><span class="l" t-esc="k.label"/></div>
              </div>
            </t>
          </div>
        </div>

        <!-- ==== the steps (only where the records travel a route) ====
             Each record is at exactly one step. The counts follow every
             other filter that is on (R1); a step ticks its states in
             "Where it is", and pressing the lit step again lifts it. -->
        <t t-if="steps.length">
          <div data-coach="lg-steps">
          <t t-call="pb_import_kit.QuietSteps">
            <t t-set="qSteps" t-value="steps"/>
            <t t-set="qStepsLabel" t-value="stepsLabel"/>
            <t t-set="qStepPick" t-value="(k) => this.pickStep(k)"/>
          </t>
          </div>
        </t>

        <!-- ==== the shared filter panel (FILTER W6) ====
             Views, search, the left panel with a count beside every value,
             the applied filters as chips; the rows are its slot, a page at a
             time from the server. One anchor for three ledgers:
             data-coach="lg-facets" is drawn on the panel's bar. -->
        <PbFilterLayout kit="kit" coach="'lg-facets'" searchPlaceholder="searchPh">

        <!-- rows -->
        <div t-if="state.rows.length" class="ppl-roster" data-coach="lg-rows">
          <div t-foreach="state.rows" t-as="r" t-key="r.id" class="ppl-card pbl-card" t-on-click="() => this.openRow(r)">
            <div class="ppl-av" t-attf-style="background-image:url({{ r.avatar }})"><span t-if="!r.avatar" t-esc="r.initials"/></div>
            <div class="ppl-id">
              <div class="nm" t-esc="r.title"/>
              <div class="jb"><t t-esc="r.subtitle"/> <span t-if="r.code" class="pbl-code" t-esc="r.code"/></div>
              <div t-if="r.note" class="pbl-note" t-esc="r.note"/>
            </div>
            <div class="ppl-meta pbl-badges">
              <t t-foreach="r.badges or []" t-as="b" t-key="b_index">
                <span t-attf-class="pbim-badge {{ b.tone or 'muted' }}"><span class="d"/><t t-esc="b.label"/></span>
              </t>
            </div>
            <div class="pbl-metrics">
              <t t-foreach="r.metrics or []" t-as="m" t-key="m_index">
                <div t-attf-class="pbl-metric {{ m.tone or '' }} {{ m.strong ? 'strong' : '' }}">
                  <span class="v money" t-esc="metricVal(m)"/>
                  <span class="k" t-esc="m.label"/>
                </div>
              </t>
            </div>
            <div t-if="r.action" class="pbl-rowact" data-coach="lg-rowact">
              <button class="pbim-btn outline pbim-btn-sm" t-att-disabled="state.acting === r.id" t-on-click="(ev) => this.rowAction(r, ev)">
                <t t-out="ic(r.action.icon or 'download', 14)"/> <t t-esc="r.action.label"/>
              </button>
            </div>
          </div>
        </div>

        <!-- still loading the first page -->
        <div t-elif="!state.listLoaded" class="ppl-roster pbl-skel" aria-label="Loading">
          <div t-foreach="[1,2,3,4,5]" t-as="i" t-key="i" class="ppl-card pbl-card pbl-card--ghost"><span/></div>
        </div>

        <!-- nothing to list: say why, and the way back -->
        <div t-else="" class="pbim-panel pbl-empty">
          <span class="pbl-empty-ic"><t t-out="ic(kit.total ? 'search' : 'inbox', 26)"/></span>
          <b t-esc="emptyTitle"/>
          <p t-esc="emptyText"/>
          <button t-if="kit.total" type="button" class="pbim-btn primary pbim-btn-sm" t-on-click="showAll">
            <t t-out="ic('x', 14)"/> Show them all
          </button>
        </div>

        <!-- How many, the next page, and the escape (standalone only: in a
             hub, "Open full list" leaves the hub for a native list — the
             exact door the hub exists to close). -->
        <div class="ppl-foot" t-if="state.rows.length">
          Showing <b t-esc="fmtInt(state.rows.length)"/> of <b t-esc="fmtInt(state.rowsTotal)"/>
          <button t-if="hasMore" type="button" class="pbim-btn outline pbim-btn-sm"
                  t-att-disabled="state.loadingMore" t-on-click="loadMore">
            <t t-if="state.loadingMore">Loading…</t>
            <t t-else="">Show <t t-esc="nextPage"/> more</t>
          </button>
          <t t-if="state.data.list_action and !props.embedded"> · <button class="ppl-link" data-coach="lg-openfull" t-on-click="openFullList">Open full list →</button></t>
        </div>
        <div class="ppl-foot" t-elif="state.data.list_action and !props.embedded">
          <button class="ppl-link" data-coach="lg-openfull" t-on-click="openFullList">Open full list →</button>
        </div>
        </PbFilterLayout>
      </div>

      <!-- ==== the row's whole story, in place ====
           The kit's drawer (W6): 320px, absolute scrim inside THIS surface, ESC
           and the X both close. It belongs to the lens, not to the viewport —
           it must never cover the hub's command bar or its lens rail. -->
      <WfDrawer t-if="state.drawer" title="state.drawer.title"
                subtitle="state.drawer.subtitle" onClose="() => this.closeDrawer()">
        <div class="pbl-dr" data-coach="lg-drawer">
          <div t-if="state.drawerLoading and !state.drawer.sections.length" class="pbl-dr__load">
            <span t-out="ic('loader', 20)"/><span>Loading…</span>
          </div>
          <div t-foreach="state.drawer.sections" t-as="sec" t-key="sec.label" class="pbl-dr__sec">
            <div class="pbl-dr__h" t-esc="sec.label"/>
            <div t-foreach="sec.fields" t-as="f" t-key="f.label"
                 class="pbl-dr__kv" t-att-class="{ 'is-wrap': f.wrap }">
              <span class="k" t-esc="f.label"/>
              <!-- ONE class attribute: a static `class` and a `t-attf-class`
                   both compile to `class` and the last one written wins, so the
                   tone would silently replace the `v` (W23). -->
              <span t-attf-class="v {{ f.tone or '' }} {{ f.strong ? 'strong' : '' }}"
                    t-esc="detailVal(f)"/>
            </div>
          </div>
        </div>
      </WfDrawer>
    </div>
  </t>

</templates>
