msgstr "Perubahan bank belum diatur di situs ini, jadi detail ini tidak dapat dikirim."

#. module: pb_people_advanced
#. odoo-javascript
#: code:addons/pb_people_advanced/static/src/xml/onboard_wizard.xml:0
msgid "Nothing is paid into this account until a second person approves it."
msgstr "Tidak ada pembayaran ke rekening ini sampai orang kedua menyetujuinya."

