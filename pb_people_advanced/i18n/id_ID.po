#. odoo-javascript
#: code:addons/pb_people_advanced/models/people_wizards.py:0
#: code:addons/pb_people_advanced/static/src/js/onboard_wizard.js:0
msgid "Type the account number too, or leave the bank details empty."
msgstr "Ketik juga nomor rekeningnya, atau kosongkan detail bank."

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "The account number can only have digits (spaces and dashes are fine)."
msgstr "Nomor rekening hanya boleh berisi angka (spasi dan tanda hubung boleh)."

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "The account number must be 6 to 19 digits. This one has %s."
msgstr "Nomor rekening harus 6 sampai 19 digit. Nomor ini memiliki %s digit."

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "The bank details were not sent: %s Add them from the employee's side panel (Pay & tax › Bank)."
msgstr "Detail bank tidak dikirim: %s Tambahkan dari panel samping karyawan (Gaji & pajak › Bank)."

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "The bank details were not sent: bank changes are not set up on this site. Ask your administrator."
msgstr "Detail bank tidak dikirim: perubahan bank belum diatur di situs ini. Tanyakan administrator Anda."

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "the bank check refused them."
msgstr "pemeriksaan bank menolaknya."

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "The bank details were not sent. Add them from the employee's side panel (Pay & tax › Bank)."
msgstr "Detail bank tidak dikirim. Tambahkan dari panel samping karyawan (Gaji & pajak › Bank)."

#. module: pb_people_advanced
#. odoo-python
#. odoo-javascript
#: code:addons/pb_people_advanced/models/people_wizards.py:0
#: code:addons/pb_people_advanced/static/src/js/onboard_wizard.js:0
msgid "Bank details sent for approval"
msgstr "Detail bank dikirim untuk disetujui"

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "Bank details kept for HR to look at first: %s Open Compliance › Bank."
msgstr "Detail bank disimpan agar HR memeriksanya dulu: %s Buka Kepatuhan › Bank."

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "the bank check found a problem."
msgstr "pemeriksaan bank menemukan masalah."

#. module: pb_people_advanced
#. odoo-python
#: code:addons/pb_people_advanced/models/people_wizards.py:0
msgid "The bank details go with this request. When it is approved, they are sent to a second person for approval."
msgstr "Detail bank ikut dalam permintaan ini. Setelah disetujui, detail tersebut dikirim ke orang kedua untuk disetujui."

#. module: pb_people_advanced
#. odoo-python
#. odoo-javascript
#: code:addons/pb_people_advanced/models/newhire_approval.py:0
