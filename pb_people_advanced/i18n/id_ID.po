#. module: pb_people_advanced
#. odoo-javascript
#: code:addons/pb_people_advanced/static/src/js/onboard_wizard.js:0
msgid "Only digits (spaces and dashes are fine)."
msgstr "Hanya angka (spasi dan tanda hubung boleh)."

#. module: pb_people_advanced
#. odoo-javascript
#: code:addons/pb_people_advanced/static/src/js/onboard_wizard.js:0
msgid "6 to 19 digits. This one has %(n)s."
msgstr "6 sampai 19 digit. Nomor ini memiliki %(n)s."

#. module: pb_people_advanced
#. odoo-javascript
#: code:addons/pb_people_advanced/static/src/js/onboard_wizard.js:0
msgid "Name on the account"
msgstr "Nama pada rekening"

#. module: pb_people_advanced
#. odoo-javascript
#: code:addons/pb_people_advanced/static/src/xml/onboard_wizard.xml:0
msgid "Tax and insurance details can be completed later on the employee record."
msgstr "Detail pajak dan asuransi dapat dilengkapi nanti di data karyawan."

#. module: pb_people_advanced
#. odoo-javascript
#: code:addons/pb_people_advanced/static/src/xml/onboard_wizard.xml:0
