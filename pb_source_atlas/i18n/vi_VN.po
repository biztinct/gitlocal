#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:310
msgid "Feed · %s"
msgstr "Nguồn cấp · %s"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/hr_payslip_run.py:23
msgid "Where the numbers come from"
msgstr "Những con số đến từ đâu"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:833
msgid "Read off %(model)s · %(field)s for this employee."
msgstr "Đọc từ %(model)s · %(field)s của nhân viên này."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:865
msgid ""
"This is a contract component, and this contract carries no amount for it — so it came "
"through as zero."
msgstr ""
"Đây là một thành phần hợp đồng và hợp đồng này không có giá trị gì cho nó - vì vậy nó "
"được coi là bằng không."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:158
msgid ""
"The Source Atlas shows every employee's pay data for a whole run. It is open to "
"payroll officers and above."
msgstr ""
"Nguồn dữ liệu hiển thị dữ liệu lương của mọi nhân viên trong toàn bộ kỳ lương. Chỉ "
"chuyên viên tiền lương và cấp cao hơn được truy cập."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:620
msgid "Not tracked"
msgstr "Chưa theo dõi"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:718
msgid ""
"The value was recorded as coming from %(src)s on key '%(key)s', but the imported row "
"behind it is no longer on file."
msgstr ""
"Giá trị được ghi lại là đến từ %(src)s trên khóa '%(key)s', nhưng hàng đã nhập phía "
"sau nó không còn có trong tệp."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:744
msgid "Read from column '%(key)s' of the uploaded workbook, row %(row)s."
msgstr "Đọc từ cột '%(key)s' của sổ làm việc đã tải lên, hàng %(row)s."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:748
msgid "Delivered by %(conn)s on key '%(key)s' for this period."
msgstr "Được phân phối bởi %(conn)s trên khóa '%(key)s' trong giai đoạn này."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:810
msgid ""
"Read off this employee's own record. The exact field is no longer mapped, so it cannot"
" be named here."
msgstr ""
"Đọc hồ sơ riêng của nhân viên này. Trường chính xác không còn được ánh xạ nữa nên "
"không thể đặt tên ở đây."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:843
msgid "Contract"
msgstr "Hợp đồng"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:847
msgid "Recorded as a contract component, but this payslip has no contract attached."
msgstr ""
"Được ghi nhận là một thành phần của hợp đồng nhưng phiếu lương này không có hợp đồng "
"kèm theo."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:861
msgid "The amount agreed on this contract for %(name)s."
msgstr "Số tiền đã thỏa thuận trong hợp đồng này là %(name)s."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:167
msgid "That pay run no longer exists."
msgstr "Kỳ lương đó không còn tồn tại."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:293
msgid ""
"This pay run has no payslips yet, so there is nothing to trace. Run payroll for the "
"period and the Atlas fills in."
msgstr ""
"Kỳ lương này chưa có phiếu lương nên chưa có dữ liệu để truy vết. Hãy tính lương cho "
"kỳ này để Nguồn dữ liệu được cập nhật."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:425
msgid ""
"%(n)s of these payslips were computed before source tracking existed, so their values "
"carry no origin."
msgstr ""
"%(n)s của các phiếu lương này đã được tính toán trước khi tồn tại việc theo dõi nguồn,"
" do đó giá trị của chúng không có nguồn gốc."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:430
msgid ""
"%(n)s codes carry a source but no longer match a component on this scheme — they are "
"listed so nothing is hidden."
msgstr ""
"Mã %(n)s mang nguồn nhưng không còn khớp với thành phần trong sơ đồ này nữa — chúng "
"được liệt kê nên không có gì bị ẩn."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:435
msgid ""
"Some components have no pay role yet, so they are left out of the money totals. "
"Classify the scheme to include them."
msgstr ""
"Một số thành phần chưa được phân loại vai trò lương nên chưa được tính vào tổng tiền. "
"Hãy phân loại cấu hình để đưa chúng vào."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:572
msgid "That payslip is not part of this pay run."
msgstr "Phiếu lương đó không phải là một phần của kỳ lương này."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:576
msgid "Pick a component to trace."
msgstr "Chọn một thành phần để theo dõi."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:614
msgid ""
"This code carries a source but no longer matches a component on the scheme, so its "
"journey stops here."
msgstr ""
"Mã này mang một nguồn nhưng không còn khớp với một thành phần trên lược đồ, vì vậy "
"hành trình của nó dừng ở đây."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:623
msgid "Computed before source tracking existed"
msgstr "Được tính trước khi có tính năng theo dõi nguồn"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:624
msgid ""
"This payslip was computed before the system recorded where each value came from. "
"Recomputing the run captures it."
msgstr ""
"Phiếu lương này được tính trước khi hệ thống ghi nhận nguồn của từng giá trị. Hãy tính"
" lại kỳ lương để ghi nhận nguồn."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:668
msgid "Nothing fed this"
msgstr "Không có nguồn dữ liệu"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:669
msgid "No source carried a value, so the component's own default was used."
msgstr ""
"Không có nguồn nào mang giá trị nên giá trị mặc định của chính thành phần đó đã được "
"sử dụng."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:888
msgid ""
"This scheme has no net pay component, so the chain cannot be followed to the end."
msgstr ""
"Cấu hình này chưa có thành phần lương thực nhận nên không thể truy theo chuỗi đến "
"cuối."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:930
msgid ""
"This component does not reach net pay through any formula on this scheme — it is "
"carried for information."
msgstr ""
"Thành phần này không đi vào lương thực nhận qua bất kỳ công thức nào trong cấu hình; "
"nó chỉ dùng để tham khảo."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:960
msgid "The chain is longer than %(n)s hops and has been cut short here."
msgstr "Chuỗi có hơn %(n)s bước nên được rút gọn tại đây."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:652
msgid "Worked out here"
msgstr "Được tính tại đây"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:653
msgid "This component has no source of its own — this scheme's formula produces it."
msgstr ""
"Thành phần này không có nguồn riêng; công thức trong cấu hình tạo ra giá trị này."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:661
msgid "A fixed value on the scheme"
msgstr "Giá trị cố định trong cấu hình"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:662
msgid "The same number for every employee."
msgstr "Số lượng như nhau cho mọi nhân viên."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/pb_source_atlas.py:234
msgid "Ungrouped"
msgstr "Chưa phân nhóm"

