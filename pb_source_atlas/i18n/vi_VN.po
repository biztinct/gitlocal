#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:253
msgid "No %(lane)s rows are attached to this pay run, so the raw sheet is not included."
msgstr ""
"Không có hàng %(lane)s nào được đính kèm vào kỳ lương này, do đó, bảng tính thô không "
"được bao gồm."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:288
msgid ""
"The connected system's own rows are no longer on file for this run, so only the "
"imported values are exported."
msgstr ""
"Các hàng riêng của hệ thống được kết nối không còn có trong tệp cho lần chạy này nữa "
"nên chỉ các giá trị đã nhập mới được xuất."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:327
msgid "How to read this"
msgstr "Hướng dẫn đọc"

