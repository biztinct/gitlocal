msgid "Period"
msgstr "Giai đoạn"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:333
msgid "Source lane"
msgstr "Luồng nguồn"

#. module: pb_source_atlas
#. odoo-python
