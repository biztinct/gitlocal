msgid "Employees"
msgstr "Nhân viên"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:335
msgid "Components"
msgstr "Thành phần"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:336
msgid "Prepared"
msgstr "Ngày tạo"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:338
msgid "What each employee's component was worth in this run."
msgstr "Giá trị từng thành phần lương của mỗi nhân viên trong kỳ lương này."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:339
msgid ""
"The same grid, but each cell says where the value came from: the lane, the key it "
"arrived on, and why that source won."
msgstr ""
"Cùng một bảng dữ liệu, nhưng mỗi ô cho biết giá trị đến từ luồng nào, qua khóa nào và "
"vì sao nguồn đó được ưu tiên."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:57
msgid ""
"Spreadsheet export needs the 'xlsxwriter' library, which is not available on this "
"server."
msgstr ""
"Xuất bảng tính cần thư viện 'xlsxwriter', thư viện này không có sẵn trên máy chủ này."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:305
msgid "The %(type)s feed carries %(n)s keys; the first %(cap)s are exported."
msgstr "Nguồn cấp %(type)s có %(n)s khóa; %(cap)s khóa đầu tiên được xuất."

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:313
msgid "External id"
msgstr "ID bên ngoài"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:313
msgid "Pulled"
msgstr "Thời điểm lấy"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:313
msgid "State"
msgstr "Trạng thái"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:344
msgid "Note"
msgstr "Ghi chú"

#. module: pb_source_atlas
#. odoo-python
#: code:addons/pb_source_atlas/models/atlas_download.py:269
msgid "Workbook"
msgstr "Sổ tính"

#. module: pb_source_atlas
#. odoo-python
