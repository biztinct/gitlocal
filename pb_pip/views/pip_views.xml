<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Native arch, skinned by the shared form engine. The day-to-day
         surface is the PIP lens on the Lifecycle hub; these are the records
         behind it, reached from the board, from the command bar and from a
         plan's own chatter.

         `<act_window>` and `<report>` shortcut tags are gone from the Odoo 19
         data-file RNG — every action below is an explicit
         `<record model="ir.actions.act_window">`. -->

    <!-- ================================================================ -->
    <!--  Improvement plans                                               -->
    <!-- ================================================================ -->
    <record id="view_pb_pip_case_list" model="ir.ui.view">
        <field name="name">pb.pip.case.list</field>
        <field name="model">pb.pip.case</field>
        <field name="arch" type="xml">
            <list string="Improvement plans" create="0">
                <field name="employee_id"/>
                <field name="hr_owner_user_id" optional="show"/>
                <field name="requested_by_user_id" optional="hide"/>
                <field name="template_id" optional="hide"/>
                <field name="start_date" optional="show"/>
                <field name="end_date"/>
                <field name="objective_count" optional="show"/>
                <field name="at_risk_count" optional="show"/>
                <field name="checkins_done" optional="hide"/>
                <field name="checkins_planned" optional="hide"/>
                <field name="employee_ack" optional="show" widget="boolean"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'passed'"
                       decoration-info="state in ('requested', 'coaching')"
                       decoration-warning="state in ('active', 'evaluation')"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_pb_pip_case_form" model="ir.ui.view">
        <field name="name">pb.pip.case.form</field>
        <field name="model">pb.pip.case</field>
        <field name="arch" type="xml">
            <form string="Improvement plan">
                <header>
                    <button name="action_take_up" type="object"
                            string="Take it up" class="btn-primary"
                            invisible="state != 'requested'"/>
                    <button name="action_close_at_coaching" type="object"
                            string="Settled in coaching"
                            invisible="state != 'coaching'"
                            confirm="This closes the case with no formal plan. Nothing is written to their record and nothing is filed. Carry on?"/>
                    <button name="action_start_plan" type="object"
                            string="Start the plan" class="btn-primary"
                            invisible="state not in ('requested', 'coaching')"
                            confirm="This writes the plan down, puts the check-ins in the diary, files a letter with their documents and — if their own page is switched on — emails them. Carry on?"/>
                    <button name="action_evaluate" type="object"
                            string="Ask their manager" class="btn-primary"
                            invisible="state != 'active'"/>
                    <button name="action_start_exit" type="object"
                            string="Start their exit"
                            invisible="verdict != 'fail' or exit_case_id"
                            confirm="This opens their leaving checklist with the clearances on it. Nothing is sent to them. Carry on?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,coaching,active,evaluation,passed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Who">
                            <field name="employee_id"
                                   readonly="state != 'requested'"/>
                            <field name="requested_by_user_id" readonly="1"/>
                            <field name="hr_owner_user_id"/>
                            <field name="template_id"
                                   readonly="state not in ('requested', 'coaching')"/>
                        </group>
                        <group string="When">
                            <field name="weeks"
                                   readonly="state not in ('requested', 'coaching')"/>
                            <field name="checkin_freq"
                                   readonly="state not in ('requested', 'coaching')"/>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                            <field name="employee_ack" readonly="1"/>
                            <field name="ack_at" readonly="1"
                                   invisible="not ack_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Why it was asked for" name="reason">
                            <field name="reason_text" nolabel="1"
                                   readonly="state != 'requested'"
                                   placeholder="In the manager's own words."/>
                        </page>
                        <page string="The coaching note" name="coaching">
                            <field name="coaching_html" nolabel="1"/>
                        </page>
                        <page string="Objectives" name="objectives">
                            <field name="objective_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="metric"/>
                                    <field name="target" optional="show"/>
                                    <field name="weight" optional="hide"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'met'"
                                           decoration-warning="status == 'at_risk'"
                                           decoration-danger="status == 'not_met'"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Check-ins" name="checkins">
                            <field name="checkin_ids" readonly="1">
                                <list>
                                    <field name="scheduled_date"/>
                                    <field name="kind"/>
                                    <field name="owner_user_id"/>
                                    <field name="notes" optional="show"/>
                                    <field name="red_flag" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-danger="state == 'missed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="The decision" name="decision">
                            <group>
                                <group>
                                    <field name="verdict" readonly="1"/>
                                    <field name="final_rating"/>
                                    <field name="verdict_at" readonly="1"/>
                                    <field name="verdict_by" readonly="1"/>
                                </group>
                                <group>
                                    <field name="eval_request_id" readonly="1"/>
                                    <field name="letter_id" readonly="1"/>
                                    <field name="exit_case_id" readonly="1"/>
                                    <field name="closed_at" readonly="1"/>
                                </group>
                            </group>
                            <field name="outcome_note" nolabel="1"
                                   placeholder="What was decided, and why."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_pb_pip_case_search" model="ir.ui.view">
        <field name="name">pb.pip.case.search</field>
        <field name="model">pb.pip.case</field>
        <field name="arch" type="xml">
            <search string="Improvement plans">
                <field name="employee_id"/>
                <field name="hr_owner_user_id"/>
                <field name="requested_by_user_id"/>
                <filter name="f_open" string="Still open"
                        domain="[('state', 'in', ['requested', 'coaching', 'active', 'evaluation'])]"/>
                <filter name="f_running" string="Plan running"
                        domain="[('state', '=', 'active')]"/>
                <filter name="f_deciding" string="Waiting on a decision"
                        domain="[('state', '=', 'evaluation')]"/>
                <separator/>
                <filter name="f_not_ack" string="Not yet acknowledged"
                        domain="[('employee_ack', '=', False), ('state', 'in', ['active', 'evaluation'])]"/>
                <group>
                    <filter name="g_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="g_owner" string="HR owner"
                            context="{'group_by': 'hr_owner_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pb_pip_case" model="ir.actions.act_window">
        <field name="name">Improvement plans</field>
        <field name="res_model">pb.pip.case</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pb_pip_case_search"/>
        <field name="context">{'search_default_f_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing here, and that is good news</p>
            <p>An improvement plan starts when a manager asks HR to look at how
               somebody is getting on. Most of those end in a conversation and
               never become a plan at all.</p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!--  Templates                                                        -->
    <!-- ================================================================ -->
    <record id="view_pb_pip_template_list" model="ir.ui.view">
        <field name="name">pb.pip.template.list</field>
        <field name="model">pb.pip.template</field>
        <field name="arch" type="xml">
            <list string="Improvement plan templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_weeks"/>
                <field name="checkin_freq"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pb_pip_template_form" model="ir.ui.view">
        <field name="name">pb.pip.template.form</field>
        <field name="model">pb.pip.template</field>
        <field name="arch" type="xml">
            <form string="Improvement plan template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"
                                   placeholder="Delivery and quality — 6 weeks"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_weeks"/>
                            <field name="checkin_freq"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="The usual areas" name="lines">
                            <field name="focus_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Coaching note — starting text"
                              name="coaching">
                            <field name="coaching_body_html" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pb_pip_template" model="ir.actions.act_window">
        <field name="name">Improvement plan templates</field>
        <field name="res_model">pb.pip.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">A starting point, never a straitjacket</p>
            <p>A template says how long a plan usually runs, how often the
               check-ins land and what the coaching conversation opens with.
               Everything it produces is copied onto the plan, so editing one
               never rewrites a plan somebody is already working to.</p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!--  The manager's one door                                          -->
    <!-- ================================================================ -->
    <!-- An `ir.actions.client` RECORD and never a bare tag: a bare tag is
         synthesised with no action NAME, so anything returning through a
         breadcrumb lands on a crumb labelled "Unnamed". No group on the
         action — the SERVER answers whether this caller manages anybody
         (`pb.pip.request_options`), because "manages at least one person"
         is a fact about hr.employee.parent_id rather than a group. -->
    <record id="action_pb_pip_request" model="ir.actions.client">
        <field name="name">Ask HR about someone in my team</field>
        <field name="tag">pb_pip_request</field>
    </record>

    <!-- The Lifecycle hub's own client action already exists (P0). The PIP
         lens registers itself into that hub's lens registry from JavaScript;
         there is no second hub action and no new rail item. -->

</odoo>
