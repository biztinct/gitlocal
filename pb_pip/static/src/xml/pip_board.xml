<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ====================================================================
       The PIP lens.

       Section comments use `=` rules and never a doubled hyphen, because a
       doubled hyphen inside an XML comment is a parse error that takes every
       t-name in the file down with it (W22/R35).

       Loop variables are never named lt / gt / lte / gte / and / or / not /
       in: OWL reserves those as operators and the whole template dies with a
       compile error pointing at nothing useful (R1). The stage loop is `sg`,
       the objective loop is `ob`, the check-in loop is `ck`.

       `t-att-class` with a DICT is correct HERE and only here — this is an
       OWL template, where the dict form merges with the static class. In a
       server-side `<template>` (portal, reports) the same thing writes the
       Python repr into the attribute and drops the static class (R42).
       ==================================================================== -->
  <t t-name="pb_pip.PbPipBoard">
    <div class="pbim pbim-page pip"
         t-att-class="{ 'pip--embedded': props.embedded }">

      <div t-if="!state.loaded" class="pbim-busy">
        <div class="pbim-spin"/><span>Loading the plans…</span>
      </div>

      <div t-else="" class="pbim-wrap">

        <!-- ============ the reader is not in the group ============
             AN EXPLAINED REFUSAL AND NOT AN ACCESS DIALOG. The sentence is
             the server's, so it says the same thing whichever way somebody
             arrived, and nothing but the sentence crossed the wire. -->
        <div t-if="!state.allowed" class="pbim-panel pip-empty">
          <div class="pip-empty-ic"><t t-out="ic('lock',30)"/></div>
          <h2>This one is deliberately locked</h2>
          <p t-esc="state.why"/>
        </div>

        <t t-else="">

          <!-- ===================== header ===================== -->
          <div class="pip-head">
            <div class="pip-head-id" t-if="!props.embedded">
              <h1 class="pbim-h1">Growth plans</h1>
              <p class="pbim-sub">Coaching first, then a plan with dates on it —
                 and a decision somebody actually makes.</p>
            </div>
            <div class="pip-head-actions">
              <button class="pbim-btn ghost" t-on-click="refresh"
                      title="Read the board again">
                <t t-out="ic('refresh',15)"/>
              </button>
              <button class="pbim-btn ghost" t-on-click="toggleClosed">
                <t t-out="ic('history',15)"/>
                <t t-esc="state.closedView ? 'Open plans' : 'Closed plans'"/>
              </button>
              <button t-if="state.canWrite" class="pbim-btn ghost"
                      t-on-click="openAll">
                <t t-out="ic('list',15)"/> All plans
              </button>
              <button t-if="state.isHead" class="pbim-btn ghost"
                      t-on-click="openTemplates">
                <t t-out="ic('layers',15)"/> Templates
              </button>
              <button t-if="state.isHead" class="pbim-btn ghost"
                      t-on-click="openSettings"
                      title="Who can see what">
                <t t-out="ic('shield',15)"/> Who sees what
              </button>
              <button t-if="state.canWrite" class="pbim-btn primary"
                      t-on-click="runAutomation"
                      title="Flag the conversations that did not happen and the plans that have run past their end date">
                <t t-out="ic('zap',15)"/> Run today's checks
              </button>
            </div>
          </div>

          <!-- ============ the employee page, said out loud ============
               A feature that is switched off and does not say so is a
               feature somebody reports as broken (R54). This is the one
               setting on this board that changes what a PERSON sees, so it
               is stated where the people running the plans are. -->
          <div t-if="state.canWrite and !state.employeeView"
               class="pbim-panel pip-notice">
            <div class="pip-notice-ic"><t t-out="ic('eyeOff',20)"/></div>
            <div>
              <b>People cannot see their own plan at the moment</b>
              <p>Nothing is emailed to them when a plan starts and their own
                 page is closed, so the letter has to be given to them by hand
                 and the acknowledgement recorded some other way. The head of
                 HR can change this under "Who sees what".</p>
            </div>
          </div>

          <!-- ====================== the numbers ====================== -->
          <div class="pbim-stats pip-kpis">
            <div class="pbim-stat">
              <div class="pbim-stat-ic"><t t-out="ic('sunrise',21)"/></div>
              <div class="pbim-stat-tx">
                <div class="n" t-esc="state.kpis.open or 0"/>
                <div class="l">Open</div>
              </div>
            </div>
            <div class="pbim-stat">
              <div class="pbim-stat-ic"><t t-out="ic('smilePlus',21)"/></div>
              <div class="pbim-stat-tx">
                <div class="n" t-esc="state.kpis.coaching or 0"/>
                <div class="l">Still a conversation</div>
              </div>
            </div>
            <div class="pbim-stat">
              <div class="pbim-stat-ic"><t t-out="ic('activity',21)"/></div>
              <div class="pbim-stat-tx">
                <div class="n" t-esc="state.kpis.running or 0"/>
                <div class="l">Plans running</div>
              </div>
            </div>
            <div class="pbim-stat" t-att-class="{ warn: state.kpis.deciding }">
              <div class="pbim-stat-ic amber"><t t-out="ic('checkCircle',21)"/></div>
              <div class="pbim-stat-tx">
                <div class="n" t-esc="state.kpis.deciding or 0"/>
                <div class="l">Waiting on a decision</div>
              </div>
            </div>
            <div class="pbim-stat" t-att-class="{ err: state.kpis.at_risk }">
              <div class="pbim-stat-ic rose"><t t-out="ic('alert',21)"/></div>
              <div class="pbim-stat-tx">
                <div class="n" t-esc="state.kpis.at_risk or 0"/>
                <div class="l">Drifting or at risk</div>
              </div>
            </div>
          </div>

          <!-- ======================== filters ======================== -->
          <div class="pbim-panel pip-filters" t-if="state.rows.length">
            <div class="pip-filter-row">
              <div class="pip-search">
                <t t-out="ic('search',15)"/>
                <input type="text" t-att-value="state.q" t-on-input="onSearch"
                       placeholder="Search by name, job or team…"/>
              </div>
              <button t-if="hasFilters" class="pbim-btn ghost pbim-btn-sm"
                      t-on-click="clearFilters">
                <t t-out="ic('x',14)"/> Clear
              </button>
            </div>
            <div class="pip-filter-row">
              <div class="pbim-chips">
                <button t-foreach="state.states" t-as="sv" t-key="sv.id"
                        t-attf-class="pbim-fchip {{ state.stateFilter === sv.id ? 'on' : '' }}"
                        t-on-click="() => this.setState(sv.id)">
                  <span t-esc="sv.label"/>
                  <span class="c" t-esc="sv.count"/>
                </button>
                <button t-attf-class="pbim-fchip {{ state.driftingOnly ? 'on' : '' }}"
                        t-on-click="toggleDrifting">
                  <t t-out="ic('alert',13)"/> Needs somebody today
                </button>
              </div>
            </div>
            <div class="pip-filter-row" t-if="state.owners.length &gt; 1">
              <div class="pbim-chips">
                <button t-foreach="state.owners" t-as="ow" t-key="ow.id"
                        t-attf-class="pbim-fchip {{ state.owner === ow.id ? 'on' : '' }}"
                        t-on-click="() => this.setOwner(ow.id)">
                  <span t-esc="ow.label"/>
                  <span class="c" t-esc="ow.count"/>
                </button>
              </div>
            </div>
          </div>

          <!-- ================== nothing here yet ==================
               AND THAT IS GOOD NEWS, said out loud. An empty improvement-plan
               board is not a screen that has failed to load; it is a company
               where nobody is on one. -->
          <div t-if="!state.rows.length" class="pbim-panel pip-empty">
            <div class="pip-empty-ic"><t t-out="ic('sunrise',30)"/></div>
            <h2 t-esc="state.closedView ? 'Nothing has been closed yet' : 'Nobody is on a growth plan'"/>
            <p t-if="!state.closedView">This starts when a line manager asks HR
               to look at how somebody is getting on — there is a row in the
               command bar for it. The first thing that happens is a
               conversation and a written coaching note, not a letter, and most
               of them should end there. Nothing is written to anybody's record
               until somebody presses "Start the plan".</p>
            <p t-else="">Plans that have been completed, closed in coaching or
               closed because the person left will show up here.</p>
          </div>

          <!-- ============ the filters match nobody ============
               The whole sentence is ONE expression, because OWL collapses the
               newline between two t-esc nodes and the page then reads
               "There are2 plans" (R34). -->
          <div t-elif="!visibleRows.length" class="pbim-panel pip-empty">
            <div class="pip-empty-ic"><t t-out="ic('search',30)"/></div>
            <h2>Nothing matches that</h2>
            <p>
              <t t-esc="state.rows.length === 1
                        ? 'There is 1 plan on this board, but it does not fit the filters you have set.'
                        : 'There are ' + state.rows.length + ' plans on this board, but none of them fits the filters you have set.'"/>
            </p>
            <button class="pbim-btn primary" t-on-click="clearFilters">
              <t t-out="ic('x',15)"/> Clear the filters
            </button>
          </div>

          <!-- ======================= the plans ======================= -->
          <div t-else="" class="pip-grid">
            <div t-foreach="visibleRows" t-as="row" t-key="row.id"
                 class="pbim-panel pip-card"
                 t-att-class="{ 'is-drift': row.drifting, 'is-late': row.overdue }">

              <div class="pip-card-top" t-on-click="() => this.openCase(row.id)">
                <img class="pip-av" t-att-src="row.avatar" t-att-alt="row.employee"/>
                <div class="pip-who">
                  <div class="pip-name" t-esc="row.employee"/>
                  <div class="pip-job">
                    <t t-esc="row.job"/><t t-if="row.job and row.dept"> · </t><t t-esc="row.dept"/>
                  </div>
                </div>
                <div class="pip-when">
                  <div class="pip-when-d" t-esc="row.end_date ? day(row.end_date) : '—'"/>
                  <div class="pip-when-w" t-esc="row.when"/>
                </div>
              </div>

              <!-- ==== the stage rail: the hero of this board ==== -->
              <div class="pip-rail">
                <div t-foreach="stages" t-as="sg" t-key="sg"
                     t-attf-class="pip-stage pip-stage--{{ stageCls(row, sg) }}">
                  <span class="pip-stage-dot">
                    <t t-if="stageCls(row, sg) === 'done'"><t t-out="ic('check',11)"/></t>
                  </span>
                  <span class="pip-stage-l" t-esc="stageLabel(sg)"/>
                  <span class="pip-stage-n" t-esc="stageNote(row, sg)"/>
                </div>
              </div>

              <!-- ==== how far through, in TIME ====
                   Deliberately labelled as time and not as progress: "62% of
                   the way through" is a fact, "62% complete" is a judgement
                   nobody has made yet. -->
              <div class="pip-bar" t-if="row.state === 'active'">
                <div class="pip-bar-track">
                  <div class="pip-bar-fill"
                       t-attf-style="width: {{ row.elapsed }}%;"/>
                </div>
                <span class="pip-bar-l">
                  <t t-esc="row.elapsed"/>% of the time has gone
                </span>
              </div>

              <div class="pip-facts">
                <div class="pip-fact">
                  <span class="pip-fact-l">Where it is</span>
                  <span class="pip-fact-v" t-esc="row.state_label"/>
                </div>
                <div class="pip-fact">
                  <span class="pip-fact-l">HR owner</span>
                  <span class="pip-fact-v" t-esc="row.owner"/>
                </div>
                <div class="pip-fact">
                  <span class="pip-fact-l">Objectives</span>
                  <span t-if="row.at_risk" class="pip-fact-v warn">
                    <t t-esc="row.at_risk"/> of <t t-esc="row.objectives"/> at risk
                  </span>
                  <span t-elif="row.objectives" class="pip-fact-v">
                    <t t-esc="row.objectives"/> agreed
                  </span>
                  <span t-else="" class="pip-fact-v muted">None yet</span>
                </div>
                <div class="pip-fact">
                  <span class="pip-fact-l">Asked for by</span>
                  <span t-if="row.requested_by" class="pip-fact-v" t-esc="row.requested_by"/>
                  <span t-else="" class="pip-fact-v muted">HR</span>
                </div>
              </div>

              <div class="pip-chips">
                <span t-if="adherenceChip(row)"
                      t-attf-class="pbim-badge {{ adherenceChip(row).cls }} pip-sentence"
                      t-esc="adherenceChip(row).text"/>
                <span t-if="row.state === 'active' and state.employeeView and !row.ack"
                      class="pbim-badge warn pip-sentence">
                  They have not opened it yet
                </span>
                <span t-elif="row.ack" class="pbim-badge ok pip-sentence">
                  They have read it
                </span>
                <span t-if="row.overdue" class="pbim-badge err pip-sentence">
                  Past its end date and still open
                </span>
                <span t-if="row.state === 'evaluation' and row.eval_in"
                      class="pbim-badge info pip-sentence">
                  The manager has answered
                </span>
                <span t-elif="row.state === 'evaluation'"
                      class="pbim-badge info pip-sentence">
                  Waiting on their manager
                </span>
              </div>

              <div class="pip-card-act">
                <button class="pbim-btn ghost pbim-btn-sm"
                        t-on-click="() => this.openCase(row.id)">
                  Open it
                </button>
                <button t-if="state.canWrite and row.state === 'requested'"
                        class="pbim-btn primary pbim-btn-sm"
                        t-on-click="() => this.takeUp(row)">
                  <t t-out="ic('play',13)"/> Take it up
                </button>
                <button t-if="state.canWrite and row.state === 'coaching'"
                        class="pbim-btn primary pbim-btn-sm"
                        t-on-click="() => this.askStart(row)">
                  <t t-out="ic('fileText',13)"/> Start the plan
                </button>
                <button t-if="state.canWrite and row.state === 'coaching'"
                        class="pbim-btn ghost pbim-btn-sm"
                        t-on-click="() => this.closeAtCoaching(row)"
                        title="Close it here, with no formal plan and nothing filed">
                  <t t-out="ic('smile',13)"/> Settled in coaching
                </button>
                <button t-if="state.canWrite and row.state === 'active'"
                        class="pbim-btn primary pbim-btn-sm"
                        t-on-click="() => this.askManager(row)">
                  <t t-out="ic('send',13)"/> Ask their manager
                </button>
                <button t-if="state.canWrite and row.state === 'evaluation'"
                        class="pbim-btn primary pbim-btn-sm"
                        t-on-click="() => this.askDecide(row)">
                  <t t-out="ic('stamp',13)"/> Decide
                </button>
                <button t-if="state.canWrite and row.verdict === 'fail' and !row.exit_case_id"
                        class="pbim-btn ghost pbim-btn-sm"
                        t-on-click="() => this.startExit(row)">
                  <t t-out="ic('powerOff',13)"/> Start their exit
                </button>
              </div>
            </div>
          </div>

          <p t-if="state.capped" class="pip-capped">
            Showing the first <t t-esc="state.rows.length"/>. Narrow it down with
            a filter to see the rest.
          </p>

        </t>
      </div>

      <!-- ==================================================================
           THE DRAWER: one plan, whole.
           ================================================================== -->
      <div t-if="state.drawer" class="pip-scrim" t-on-click="closeDrawer">
        <div class="pip-drawer" t-on-click.stop="">
          <div class="pip-drawer-head">
            <img class="pip-av pip-av--lg" t-att-src="state.drawer.row.avatar"
                 t-att-alt="state.drawer.row.employee"/>
            <div>
              <h2 t-esc="state.drawer.row.employee"/>
              <p>
                <t t-esc="state.drawer.row.job"/>
                <t t-if="state.drawer.row.job and state.drawer.row.dept"> · </t>
                <t t-esc="state.drawer.row.dept"/>
              </p>
              <p class="pip-drawer-when">
                <t t-out="ic('sunrise',13)"/>
                <t t-esc="state.drawer.row.state_label"/> ·
                <t t-esc="state.drawer.row.when"/>
              </p>
            </div>
            <button class="pbim-btn ghost" t-on-click="closeDrawer">
              <t t-out="ic('x',16)"/>
            </button>
          </div>

          <!-- ==== why it was asked for ==== -->
          <t t-if="state.drawer.row.reason">
            <h3 class="pip-drawer-h3">What the manager said</h3>
            <p class="pip-quote" t-esc="state.drawer.row.reason"/>
          </t>

          <!-- ==== the coaching note ==== -->
          <h3 class="pip-drawer-h3">The coaching note</h3>
          <p class="pip-drawer-none" t-if="!state.canWrite">
            Read only.
          </p>
          <textarea t-if="state.canWrite and ['requested','coaching','active'].includes(state.drawer.row.state)"
                    class="pip-ta" rows="8"
                    t-att-value="state.drawer.coaching"
                    t-on-input="onCoaching"
                    placeholder="What was said, what they said was getting in the way, and what you agreed to try…"/>
          <div t-else="" class="pip-note" t-esc="state.drawer.coaching"/>
          <button t-if="state.canWrite and ['requested','coaching','active'].includes(state.drawer.row.state)"
                  class="pbim-btn ghost pbim-btn-sm pip-save"
                  t-on-click="saveCoaching">
            <t t-out="ic('save',13)"/> Save the note
          </button>

          <!-- ==== the objectives ==== -->
          <h3 class="pip-drawer-h3">
            What has to change
            <button t-if="state.canWrite and ['requested','coaching'].includes(state.drawer.row.state)"
                    class="pip-inline-btn"
                    t-on-click="() => this.askObjective(state.drawer.row)">
              <t t-out="ic('plus',12)"/> Add one
            </button>
          </h3>
          <div t-if="!state.drawer.objectives.length" class="pip-drawer-none">
            Nothing agreed yet. A plan cannot start without at least one
            objective, and each one needs a "what good looks like" beside it —
            otherwise nobody could pass or fail it on evidence.
          </div>
          <div t-foreach="state.drawer.objectives" t-as="ob" t-key="ob.id"
               t-attf-class="pip-obj pip-obj--{{ ob.status }}">
            <div class="pip-obj-h">
              <b t-esc="ob.name"/>
              <span t-attf-class="pbim-badge {{ ob.status === 'met' ? 'ok' : (ob.status === 'not_met' ? 'err' : (ob.status === 'at_risk' ? 'warn' : 'info')) }}"
                    t-esc="ob.status_label"/>
            </div>
            <p t-if="ob.metric" class="pip-obj-m" t-esc="ob.metric"/>
            <p t-if="ob.target" class="pip-obj-t">Target: <t t-esc="ob.target"/></p>
            <div class="pip-obj-act" t-if="state.canWrite">
              <button t-foreach="objStatuses" t-as="os" t-key="os.key"
                      t-attf-class="pip-pill {{ ob.status === os.key ? 'on' : '' }}"
                      t-on-click="() => this.setObjectiveStatus(ob, os.key)">
                <t t-esc="os.label"/>
              </button>
              <button t-if="['requested','coaching'].includes(state.drawer.row.state)"
                      class="pip-inline-btn pip-inline-btn--quiet"
                      t-on-click="() => this.removeObjective(ob)">
                <t t-out="ic('trash',12)"/>
              </button>
            </div>
          </div>

          <!-- ==== the conversations ==== -->
          <h3 class="pip-drawer-h3" t-if="state.drawer.checkins.length">
            The conversations
          </h3>
          <div t-foreach="state.drawer.checkins" t-as="ck" t-key="ck.id"
               class="pip-check" t-att-class="{ 'is-red': ck.red, 'is-missed': ck.state === 'missed' }">
            <div class="pip-check-l">
              <b t-esc="day(ck.date)"/>
              <span class="pip-check-o" t-esc="ck.owner"/>
              <span t-if="ck.state === 'done'" class="pbim-badge ok">held</span>
              <span t-elif="ck.state === 'missed'" class="pbim-badge err">did not happen</span>
              <span t-else="" class="pbim-badge info">planned</span>
              <span t-if="ck.red" class="pbim-badge err">flagged</span>
            </div>
            <p t-if="ck.red_note" class="pip-check-n" t-esc="ck.red_note"/>
            <p t-elif="ck.notes" class="pip-check-n" t-esc="ck.notes"/>
          </div>

          <!-- ==== what the manager said at the end ==== -->
          <t t-if="state.drawer.evaluation and state.drawer.evaluation.answered">
            <h3 class="pip-drawer-h3">What their manager said at the end</h3>
            <div t-foreach="state.drawer.evaluation.objectives" t-as="ev"
                 t-key="ev.id" class="pip-eval">
              <b t-esc="ev.name"/>
              <span class="pip-eval-s"><t t-esc="ev.score"/> out of 5</span>
            </div>
            <div t-foreach="state.drawer.evaluation.notes" t-as="nt"
                 t-key="nt_index" class="pip-eval-note">
              <span class="pip-eval-l" t-esc="nt.label"/>
              <p t-esc="nt.value"/>
            </div>
          </t>
          <div t-elif="state.drawer.eval_link" class="pip-drawer-none">
            Their manager has a private link and has not answered yet.
          </div>

          <!-- ==== how it ended ==== -->
          <t t-if="state.drawer.outcome_note">
            <h3 class="pip-drawer-h3">How it ended</h3>
            <p class="pip-quote" t-esc="state.drawer.outcome_note"/>
          </t>

          <div class="pip-drawer-act">
            <button class="pbim-btn ghost pbim-btn-sm"
                    t-on-click="() => this.openCaseRecord(state.drawer.row)">
              Open the record
            </button>
            <button t-if="state.drawer.row.letter_id" class="pbim-btn ghost pbim-btn-sm"
                    t-on-click="() => this.openLetter(state.drawer.row.letter_id)">
              <t t-out="ic('fileText',13)"/> The letter
            </button>
            <button class="pbim-btn ghost pbim-btn-sm"
                    t-on-click="() => this.openEmployee(state.drawer.row)">
              Their record
            </button>
          </div>
        </div>
      </div>

      <!-- ==================================================================
           ADDING AN OBJECTIVE.
           ================================================================== -->
      <div t-if="state.objecting" class="pbim-modal-scrim"
           t-on-click="cancelObjective">
        <div class="pbim-modal pip-modal" t-on-click.stop="">
          <h2>What has to change for <t t-esc="state.objecting.who"/>?</h2>
          <p class="pbim-sub">One thing at a time, written so that in six weeks
             it is obvious to both of you whether it happened.</p>

          <label class="pip-lbl">What has to change</label>
          <input type="text" class="pip-in"
                 t-att-value="state.objecting.name" t-on-input="onObjName"
                 placeholder="Picking up tickets when they land"/>

          <label class="pip-lbl">What good looks like</label>
          <textarea class="pip-ta" rows="3"
                    t-att-value="state.objecting.metric"
                    t-on-input="onObjMetric"
                    placeholder="Every ticket assigned to them is picked up within one working day, or handed back with a reason."/>

          <label class="pip-lbl">The number, if there is one</label>
          <input type="text" class="pip-in"
                 t-att-value="state.objecting.target" t-on-input="onObjTarget"
                 placeholder="Leave this empty if there honestly is not one"/>

          <p class="pip-hint" t-esc="objectiveHint"/>
          <div class="pip-modal-act">
            <button class="pbim-btn ghost" t-on-click="cancelObjective">Cancel</button>
            <button class="pbim-btn primary" t-att-disabled="!canSaveObjective"
                    t-on-click="saveObjective">
              <t t-out="ic('plus',15)"/> Add it
            </button>
          </div>
        </div>
      </div>

      <!-- ==================================================================
           STARTING THE PLAN — the moment this stops being private, so the
           dialog says exactly what the button will do before it is pressed.
           ================================================================== -->
      <div t-if="state.starting" class="pbim-modal-scrim" t-on-click="cancelStart">
        <div class="pbim-modal pip-modal" t-on-click.stop="">
          <h2>Starting <t t-esc="state.starting.who"/>'s plan</h2>

          <div t-if="state.starting.busy" class="pbim-busy">
            <div class="pbim-spin"/><span>Working out what this will do…</span>
          </div>
          <t t-elif="state.starting.preview">
            <div t-if="startBlocked" class="pip-blocked">
              <div class="pip-blocked-h">
                <t t-out="ic('lock',18)"/>
                <b>Not yet</b>
              </div>
              <ul>
                <li t-foreach="state.starting.preview.blocked" t-as="bk"
                    t-key="bk_index" t-esc="bk"/>
              </ul>
            </div>
            <div t-else="" class="pip-preview">
              <div class="pip-preview-h">
                <t t-out="ic('info',18)"/>
                <b>What pressing the button does</b>
              </div>
              <ul>
                <li t-foreach="state.starting.preview.lines" t-as="ln"
                    t-key="ln_index" t-esc="ln"/>
              </ul>
              <p>Up to here nothing has been written to their record. After
                 this, it has.</p>
            </div>
          </t>

          <div class="pip-modal-act">
            <button class="pbim-btn ghost" t-on-click="cancelStart">Not yet</button>
            <button class="pbim-btn primary" t-att-disabled="startBlocked"
                    t-on-click="confirmStart">
              <t t-out="ic('fileText',15)"/> Start the plan
            </button>
          </div>
        </div>
      </div>

      <!-- ==================================================================
           THE DECISION. Three steps, and the last one says exactly what the
           button will do before it is pressed.
           ================================================================== -->
      <div t-if="state.deciding" class="pbim-modal-scrim" t-on-click="cancelDecide">
        <div class="pbim-modal pip-modal pip-modal--wide" t-on-click.stop="">
          <h2>Deciding about <t t-esc="state.deciding.who"/></h2>

          <div class="pip-steps">
            <button t-attf-class="pip-step {{ state.deciding.step === 1 ? 'on' : '' }}"
                    t-on-click="() => this.decideStep(1)">
              <span class="pip-step-n">1</span> Go through each objective
            </button>
            <button t-attf-class="pip-step {{ state.deciding.step === 2 ? 'on' : '' }}"
                    t-on-click="() => this.decideStep(2)">
              <span class="pip-step-n">2</span> Write it down
            </button>
            <button t-attf-class="pip-step {{ state.deciding.step === 3 ? 'on' : '' }}"
                    t-att-disabled="!state.deciding.verdict">
              <span class="pip-step-n">3</span> Decide
            </button>
          </div>

          <!-- ============ step 1 ============ -->
          <div t-if="state.deciding.step === 1">
            <div t-if="state.deciding.busy" class="pbim-busy">
              <div class="pbim-spin"/><span>Reading the plan…</span>
            </div>
            <t t-else="">
              <p class="pbim-sub">What their manager said is beside each one.
                 Mark where it actually landed — this is what the record will
                 say in two years.</p>
              <div t-foreach="state.deciding.objectives" t-as="ob" t-key="ob.id"
                   class="pip-decide-obj">
                <div class="pip-obj-h">
                  <b t-esc="ob.name"/>
                  <span t-if="evalScore(ob.id)" class="pip-eval-s">
                    manager said <t t-esc="evalScore(ob.id)"/> out of 5
                  </span>
                </div>
                <p t-if="ob.metric" class="pip-obj-m" t-esc="ob.metric"/>
                <div class="pip-obj-act">
                  <button t-foreach="objStatuses" t-as="os" t-key="os.key"
                          t-attf-class="pip-pill {{ state.deciding.statuses[ob.id] === os.key ? 'on' : '' }}"
                          t-on-click="() => this.setObjectiveOutcome(ob.id, os.key)">
                    <t t-esc="os.label"/>
                  </button>
                </div>
              </div>
              <div t-if="state.deciding.evaluation and state.deciding.evaluation.notes.length"
                   class="pip-preview">
                <div t-foreach="state.deciding.evaluation.notes" t-as="nt"
                     t-key="nt_index" class="pip-eval-note">
                  <span class="pip-eval-l" t-esc="nt.label"/>
                  <p t-esc="nt.value"/>
                </div>
              </div>
            </t>
            <div class="pip-modal-act">
              <button class="pbim-btn ghost" t-on-click="cancelDecide">Cancel</button>
              <button class="pbim-btn primary" t-on-click="() => this.decideStep(2)">
                Next
              </button>
            </div>
          </div>

          <!-- ============ step 2 ============ -->
          <div t-if="state.deciding.step === 2">
            <p class="pbim-sub">Write this as you would say it to them, because
               you are about to.</p>
            <label class="pip-lbl">What was decided, and why</label>
            <textarea class="pip-ta" rows="5"
                      t-att-value="state.deciding.note"
                      t-on-input="onDecideNote"
                      placeholder="What changed, what did not, and what happens now…"/>
            <label class="pip-lbl">If they completed it, where did they end up?</label>
            <input type="number" min="1" max="5" class="pip-in pip-in--sm"
                   t-att-value="state.deciding.rating" t-on-input="onRating"/>
            <span class="pip-in-unit">out of 5 — this goes on their performance rating</span>

            <div class="pip-verdicts">
              <button class="pip-verdict pip-verdict--pass"
                      t-on-click="() => this.pickVerdict('pass')">
                <t t-out="ic('checkCircle',20)"/>
                <b>Completed successfully</b>
                <span>They come off the plan. Nothing is filed and nothing is
                      held against them.</span>
              </button>
              <button class="pip-verdict pip-verdict--fail"
                      t-on-click="() => this.pickVerdict('fail')">
                <t t-out="ic('minusCircle',20)"/>
                <b>Not completed</b>
                <span>Recorded, and the HR team is told. Nothing else starts.</span>
              </button>
            </div>
            <div class="pip-modal-act">
              <button class="pbim-btn ghost" t-on-click="() => this.decideStep(1)">
                Back
              </button>
            </div>
          </div>

          <!-- ============ step 3 ============ -->
          <div t-if="state.deciding.step === 3">
            <div t-if="state.deciding.busy" class="pbim-busy">
              <div class="pbim-spin"/><span>Working out what this will do…</span>
            </div>
            <div t-elif="state.deciding.preview" class="pip-preview">
              <div class="pip-preview-h">
                <t t-out="ic('info',18)"/>
                <b>What pressing the button does</b>
              </div>
              <ul>
                <li t-foreach="state.deciding.preview.lines" t-as="ln"
                    t-key="ln_index" t-esc="ln"/>
              </ul>
            </div>
            <div class="pip-modal-act">
              <button class="pbim-btn ghost" t-on-click="() => this.decideStep(2)">
                Back
              </button>
              <button class="pbim-btn primary" t-on-click="saveDecision">
                <t t-out="ic('stamp',15)"/>
                <t t-esc="state.deciding.preview ? state.deciding.preview.label : 'Confirm'"/>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================================================================
           WHO SEES WHAT. The two switches, in words, with what each one
           actually changes on somebody's screen.
           ================================================================== -->
      <div t-if="state.settings" class="pbim-modal-scrim" t-on-click="closeSettings">
        <div class="pbim-modal pip-modal" t-on-click.stop="">
          <h2>Who sees what</h2>
          <p class="pbim-sub">These two decide what people outside this group
             can see. Everything else here is already limited to the people in
             it — a lifecycle administrator cannot see this screen, and neither
             can a system administrator who has not been added by name.</p>

          <div class="pip-switch">
            <div class="pip-switch-tx">
              <b>The person can see their own plan</b>
              <p>They get an email when a plan starts, a page at
                 <code>/my/growth</code> with the objectives and the dates on
                 it, and a button to say they have read it. With this off,
                 nothing is emailed to them, the page is closed, and the letter
                 has to be given to them by hand.</p>
            </div>
            <button t-attf-class="pip-toggle {{ state.employeeView ? 'on' : '' }}"
                    t-on-click="() => this.setSwitch('employee_view', !state.employeeView)">
              <span class="pip-toggle-k"/>
            </button>
          </div>

          <div class="pip-switch">
            <div class="pip-switch-tx">
              <b>The manager who asked can see their own request</b>
              <p>Only the one they raised themselves, and only where it has got
                 to — never the objectives, the coaching note or anybody else's
                 plan. With this off, a manager sends the request and hears back
                 from HR by other means.</p>
            </div>
            <button t-attf-class="pip-toggle {{ state.managerSeesOwn ? 'on' : '' }}"
                    t-on-click="() => this.setSwitch('manager_sees_own', !state.managerSeesOwn)">
              <span class="pip-toggle-k"/>
            </button>
          </div>

          <div class="pip-modal-act">
            <button class="pbim-btn primary" t-on-click="closeSettings">Done</button>
          </div>
        </div>
      </div>

    </div>
  </t>

</templates>
