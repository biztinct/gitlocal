<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pb_form_studio_people.PremiumOrgPerson">
    <span class="pb-org-avatar" aria-hidden="true" t-esc="initials(employee.name)"/>
    <span class="pb-org-person-text">
      <strong t-esc="employee.name"/>
      <small t-if="employee.job_name" t-esc="employee.job_name"/>
    </span>
    <span t-if="employee.indirect_sub_count" class="pb-org-count" title="Direct and indirect reports" t-esc="reportsLabel(employee)"/>
  </t>
  <t t-name="pb_form_studio_people.PremiumOrgChart">
    <div class="pb-org-mini" aria-label="Organisation chart" t-att-aria-busy="state.loading ? 'true' : 'false'">
      <p t-if="state.loading" class="pb-org-note" role="status">Loading reporting line…</p>
      <div t-elif="state.error" class="pb-org-note" role="status">
        <span>The reporting line could not be loaded.</span>
        <button type="button" class="pb-org-more" t-on-click="load">Retry</button>
      </div>
      <t t-else="">
        <button t-if="state.more" type="button" class="pb-org-more" t-on-click="showManagers">Show full reporting line</button>
        <div class="pb-org-caption" t-if="state.managers.length">Reporting line</div>
        <ol class="pb-org-chain">
          <li t-foreach="state.managers" t-as="employee" t-key="employee.id">
            <button type="button" class="pb-org-person" t-att-data-employee-id="employee.id" t-on-click="() => this.openEmployee(employee.id)">
              <t t-call="pb_form_studio_people.PremiumOrgPerson"/>
              <span class="pb-org-chevron" aria-hidden="true">&#8250;</span>
            </button>
          </li>
          <li t-if="state.self" class="pb-org-current">
            <div class="pb-org-person" aria-current="true">
              <t t-set="employee" t-value="state.self"/>
              <t t-call="pb_form_studio_people.PremiumOrgPerson"/>
              <span class="pb-org-current-label">This employee</span>
            </div>
          </li>
        </ol>
        <section t-if="state.children.length" class="pb-org-reports" aria-label="Direct reports">
          <div class="pb-org-caption">Direct reports <span t-esc="state.children.length"/></div>
          <ul>
            <li t-foreach="state.children" t-as="employee" t-key="employee.id">
              <button type="button" class="pb-org-person" t-att-data-employee-id="employee.id" t-on-click="() => this.openEmployee(employee.id)">
                <t t-call="pb_form_studio_people.PremiumOrgPerson"/>
                <span class="pb-org-chevron" aria-hidden="true">&#8250;</span>
              </button>
            </li>
          </ul>
        </section>
        <p t-if="!state.managers.length and !state.children.length" class="pb-org-note">No manager or direct reports recorded.</p>
      </t>
    </div>
  </t>
</templates>
