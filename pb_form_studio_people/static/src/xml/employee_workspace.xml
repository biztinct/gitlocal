<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pb_form_studio_people.EmployeeWorkspace" t-inherit="pb_employee_vault.Employee360Drawer" t-inherit-mode="extension">
    <xpath expr="//aside[hasclass('pev-drawer')]" position="attributes">
      <attribute name="class" add="pb-workspace" separator=" "/>
      <attribute name="t-att-class">{ shown: state.shown, 'pb-workspace-expanded': state.expanded }</attribute>
      <attribute name="role">dialog</attribute><attribute name="aria-modal">true</attribute><attribute name="aria-label">Employee workspace</attribute>
    </xpath>
    <xpath expr="//div[hasclass('pev-head-side')]/button[@t-on-click='openFull']" position="before">
      <button type="button" class="pev-full" t-on-click="toggleWorkspace" t-att-aria-expanded="state.expanded"><t t-out="ic('external',14)"/> <t t-esc="workspaceExpandLabel"/></button>
    </xpath>
    <xpath expr="//div[hasclass('pev-head-side')]/button[@t-on-click='openFull']" position="replace"/>
    <xpath expr="//div[hasclass('pev-head-id')]" position="before">
      <button t-if="workspaceBackLabel" type="button" class="pb-workspace-back" t-on-click="workspaceBack"><span aria-hidden="true">&#8592;</span> <t t-esc="workspaceBackLabel"/></button>
    </xpath>
    <xpath expr="//div[hasclass('pev-tabs')]/button[contains(@t-on-click, &quot;'job'&quot;)]" position="replace">
      <button type="button" class="pev-tab" t-att-class="{on: state.tab === 'job'}" t-on-click="() => this.setTab('job')"><t t-out="ic('briefcase',15)"/> Job</button>
    </xpath>
    <xpath expr="//t[@t-if=&quot;['personal', 'job', 'pay'].includes(state.tab)&quot;]" position="before">
      <div t-if="state.tab === 'job'" class="pb-workspace-section">
        <PremiumRecordForm recordContext="workspaceRecordContext" onVersionChanged.bind="workspaceVersionChanged" resModel="'hr.employee'" resId="workspaceRecordId" section="'job'" title.translate="Job &amp; organisation" onReady.bind="workspaceJobReady" t-key="'job'" onSaved.bind="load"/>
      </div>
      <div t-if="state.tab === 'personal'" class="pb-workspace-section">
        <PremiumRecordForm recordContext="workspaceRecordContext" onVersionChanged.bind="workspaceVersionChanged" resModel="'hr.employee'" resId="workspaceRecordId" section="'personal'" title.translate="Personal details" onReady.bind="workspacePersonalReady" t-key="'personal'" onSaved.bind="load"/>
      </div>
    </xpath>
    <xpath expr="//div[hasclass('pev-tabs')]/button[contains(@t-on-click, &quot;'timeline'&quot;)]" position="before">
      <button type="button" class="pev-tab" t-att-class="{on: state.tab === 'resume'}" t-on-click="() => this.setTab('resume')"><t t-out="ic('award',15)"/> Résumé</button>
      <button type="button" class="pev-tab" t-att-class="{on: state.tab === 'settings'}" t-on-click="() => this.setTab('settings')"><t t-out="ic('settings',15)"/> Settings</button>
    </xpath>
    <xpath expr="//div[hasclass('pev-body')]" position="before">
      <div t-if="state.versionId" class="pb-version-notice">
        <span>Employment record: <strong t-esc="state.versionLabel"/>. Editable sections use this record; profile summaries show current information.</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="workspaceCurrentVersion">Return to current</button>
      </div>
    </xpath>
    <xpath expr="//div[hasclass('pev-body')]" position="inside">
      <div t-if="state.tab === 'pay'" class="pb-workspace-section">
        <PremiumRecordForm recordContext="workspaceRecordContext" onVersionChanged.bind="workspaceVersionChanged" resModel="'hr.employee'" resId="workspaceRecordId" section="'pay'" title.translate="Pay &amp; tax details" onReady.bind="workspacePayReady" t-key="'pay'" onSaved.bind="load"/>
      </div>
      <div t-if="state.tab === 'resume'" class="pb-workspace-section">
        <PremiumRecordForm recordContext="workspaceRecordContext" onVersionChanged.bind="workspaceVersionChanged" resModel="'hr.employee'" resId="workspaceRecordId" section="'resume'" title.translate="Experience &amp; skills" onReady.bind="workspaceResumeReady" t-key="'resume'" onSaved.bind="load"/>
      </div>
      <div t-if="state.tab === 'settings'" class="pb-workspace-section">
        <PremiumRecordForm recordContext="workspaceRecordContext" onVersionChanged.bind="workspaceVersionChanged" resModel="'hr.employee'" resId="workspaceRecordId" section="'settings'" title.translate="Employee settings" onReady.bind="workspaceSettingsReady" t-key="'settings'" onSaved.bind="load"/>
      </div>
      <div t-if="state.tab === 'documents'" class="pb-workspace-section">
        <PremiumRecordForm recordContext="workspaceRecordContext" onVersionChanged.bind="workspaceVersionChanged" resModel="'hr.employee'" resId="workspaceRecordId" section="'documents'" title.translate="Additional document files" onReady.bind="workspaceDocumentsReady" t-key="'documents'" onSaved.bind="load"/>
      </div>
    </xpath>
    <xpath expr="//div[hasclass('pev-more')][@t-if]" position="replace"/>
    <xpath expr="//div[@t-if='!groups(state.tab).length']" position="attributes">
      <attribute name="t-if">!groups(state.tab).length and (!recordForm or recordForm.state.error)</attribute>
    </xpath>
  </t>
</templates>
