<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pb_form_studio_people.EmployeeWorkspace" t-inherit="pb_employee_vault.Employee360Drawer" t-inherit-mode="extension">
    <xpath expr="//aside[hasclass('pev-drawer')]" position="attributes">
      <attribute name="class" add="pb-workspace" separator=" "/>
      <attribute name="t-att-class">{ shown: state.shown, 'pb-workspace-expanded': state.expanded }</attribute>
      <attribute name="role">dialog</attribute><attribute name="aria-modal">true</attribute><attribute name="aria-label">Employee workspace</attribute>
    </xpath>
    <xpath expr="//div[hasclass('pev-head-side')]/button[@t-on-click='openFull']" position="replace">
      <button type="button" class="pev-full" t-on-click="openFull" t-att-aria-expanded="state.expanded"><t t-out="ic('external',14)"/> <t t-esc="workspaceExpandLabel"/></button>
    </xpath>
    <xpath expr="//div[hasclass('pev-tabs')]/button[1]" position="before">
      <button type="button" class="pev-tab" t-att-class="{ on: state.tab === 'record' }" t-on-click="() => this.setTab('record')"><t t-out="ic('idCard',15)"/> Details</button>
    </xpath>
    <xpath expr="//div[hasclass('pev-tabs')]/button[contains(@t-on-click, &quot;'personal'&quot;)]" position="attributes"><attribute name="t-if">false</attribute></xpath>
    <xpath expr="//div[hasclass('pev-tabs')]/button[contains(@t-on-click, &quot;'job'&quot;)]" position="attributes"><attribute name="t-if">false</attribute></xpath>
    <xpath expr="//div[hasclass('pev-tabs')]/button[contains(@t-on-click, &quot;'company'&quot;)]" position="attributes"><attribute name="t-if">false</attribute></xpath>
    <xpath expr="//div[hasclass('pev-body')]" position="inside">
      <div class="pb-workspace-record" t-att-class="{ 'd-none': state.tab !== 'record' }">
        <PremiumRecordForm resModel="'hr.employee'" resId="workspaceRecordId" onReady.bind="workspaceReady" onSaved.bind="load"/>
      </div>
    </xpath>
    <xpath expr="//div[hasclass('pev-more')]" position="attributes"><attribute name="t-if">false</attribute></xpath>
  </t>
</templates>
